  // first unresolved op per pass, and with this much of the function
  // gated behind loop-carried stack state, each fix exposes another
  // sibling read the same way. A full scan of the resulting decode still
  // showed several hundred "<uninitialized>" annotations spanning the
  // rest of the function once any one op in this region is reached,
  // confirming the remaining surface is not a short tail. Reverted to the
  // last clean, converged state (through op 270) rather than continuing
  // an open-ended per-op patch with no evidenced stopping point.
  "(method 70 wvehicle)": [
    [2, "gp", "(pointer float)"],
    [4, "gp", "(pointer uint32)"],
    [8, "gp", "(pointer uint32)"],
    [22, "gp", "(pointer uint32)"],
    [29, "gp", "(pointer float)"],
    [44, "gp", "(pointer uint32)"],
    [51, "gp", "(pointer float)"],
    [63, "gp", "(pointer uint32)"],
    [66, "gp", "(pointer uint32)"],
    [69, "gp", "(pointer uint32)"],
    [161, "s4", "(pointer float)"],
    [180, "s4", "(pointer float)"],
    [200, "s4", "(pointer float)"],
    [211, "s4", "(pointer float)"],
    [215, "s4", "(pointer float)"],
    [217, "s4", "(pointer float)"],
    [234, "s5", "(pointer float)"],
    [256, "s5", "(pointer float)"],
    [270, "s5", "(pointer float)"]
  ],
  // update-engine-mix-state: a0 becomes info-array (update-engine-mix-state-
  // params' own raw uint32 field) plus a stride-24 index. 24 bytes is
  // vehicle-sound-engine-loop-info's own size, and the fields the body
  // reads off it (offset 12 min-rpm, offset 16 max-rpm) confirm the type;
  // it is then stored into an update-engine-loop-state-work's own info
  // field (offset 4), the last read of this particular value. Range covers
  // every use from the stride add through that store.
  // s2 walks self's second wvehicle-engine-mix-state argument's own "loops"
  // field the same way (method 223 wvehicle)'s own fix does: a uint32
  // sound-id at offset 0 (multiple reads and writes, passed to
  // new-sound-id/sound-stop) and an int8 at offset 4.
  "update-engine-mix-state": [
    [[30, 46], "a0", "vehicle-sound-engine-loop-info"],
    [65, "s2", "(pointer int8)"],
    [70, "s2", "(pointer uint32)"],
    [73, "s2", "(pointer uint32)"],
    [76, "s2", "(pointer uint32)"],
    [82, "s2", "(pointer uint32)"],
    [84, "s2", "(pointer int8)"],
    [86, "s2", "(pointer uint32)"],
    [89, "s2", "(pointer uint32)"],
    [92, "s2", "(pointer uint32)"],
    [94, "s2", "(pointer int8)"]
  ],
  // (method 223 wvehicle): a nested loop walks self's own two
  // wvehicle-engine-mix-state fields (stride 32, matching min/max-load's
  // own 32-byte size and 32-byte separation) and, within each, two 16-byte
  // sub-elements of the "loops" field (currently a flat uint8 x32
  // placeholder with no declared substructure). Each 16-byte element is
  // read as a uint32 sound-id at offset 0 (passed to sound-stop, the same
  // shape as every other sound-id field in this file) and written as an
  // int8 at offset 4; scoped per-op rather than reshaping the shared
  // wvehicle-engine-mix-state type, since no inspect method or string
  // reference names this element and the field's own declaration stays a
  // placeholder for whoever lands that type properly.
  "(method 223 wvehicle)": [
    [11, "s2", "(pointer uint32)"],
    [14, "s2", "(pointer uint32)"],
    [17, "s2", "(pointer uint32)"],
    [19, "s2", "(pointer int8)"]
  ],
  // (method 113 vehicle): op 19's store to the same raw offset already
  // resolves fine; the op 31 read needed the explicit cast, the same
  // pattern as the pad reads fixed in the wvehicle-sounds commit (raw 864,
  // declared 868, inside vehicle's pad-net-payload-gap, the layout hole
  // tracked on issue 328 and not opened here).
  "(method 113 vehicle)": [[31, "gp", "(pointer float)"]],

  ////////////////////////////////////////////////////////////////////////////
  // Inlined (rand-float-gen): mtc1 of a raw IEEE-754 bit pattern
  ////////////////////////////////////////////////////////////////////////////
  // jak1 math.gc:240 defines the macro as
  //   (+ -1.0 (the-as float (logior #x3f800000 (/ (rand-uint31-gen gen) 256))))
  // so every inlined use compiles to: rand-uint31-gen -> (sra .. 8) ->
  // (logior #x3f800000 ..) -> mtc1 -> add.s with -1.0. The GPR feeding that mtc1
  // holds a raw float bit pattern, but the decompiler's gpr->fpr rule copies the
  // GPR's GOAL type straight onto the FPR (types2/ForwardProp.cpp
  // types2_for_gpr_to_fpr, "for now, we'll just copy the type"), so the FPR is
  // typed uint and IR2/FormExpressionAnalysis.cpp update_from_stack_float_2
  // rejects the following add.s with
  //   "Floating point math attempted on invalid types: float and uint".
  // Fix shape is the same one jak1, jak2 and jak3 use for this macro, and the
  // same one jakx already uses for its own generate-rand-vector-on-sphere above:
  // cast the source GPR to float at the mtc1's own op index. Op indices were read
  // out of each object's own _ir2.asm at 3e3f3b6fe and iterated to a fixed point
  // (a function with several inlined uses only reports its first failure per run).
  //
  // docks-obs / ice-obs / atoll-obs / drome-obs: level-obs idle handlers that
  // seed a random start angle before their spin loop.
  "(code idle wind-rotor)": [[11, "v1", "float"]],
  "(code idle ice-flag)": [[9, "v1", "float"]],
  "(code idle atoll-dish)": [[11, "v1", "float"]],
  "(code idle atoll-rotor)": [[11, "v1", "float"]],
  "(code idle drome-tunnel-drum)": [[11, "v1", "float"]],
  // lobby-adventure-obs: the four trophy displays and the three world-map props,
  // identical bodies to the level-obs ones above.
  "(code idle menu-haven-trophy)": [[9, "v1", "float"]],
  "(code idle menu-kras-trophy)": [[9, "v1", "float"]],
  "(code idle menu-marauder-trophy)": [[9, "v1", "float"]],
  "(code idle menu-spargus-trophy)": [[9, "v1", "float"]],
  "(code idle wm-docks-crane)": [[9, "v1", "float"]],
  "(code idle wm-drome-wind-machine)": [[9, "v1", "float"]],
  "(code idle wm-kras-circular-tower)": [[9, "v1", "float"]],
  // same idiom in anonymous bodies the decompiler has not named yet
  "(anon-function 10 construction-obs-h)": [[16, "v1", "float"]],
  "(anon-function 12 kcross-obs)": [[9, "v1", "float"]],
  "(anon-function 26 kras-obs)": [[9, "v1", "float"]],
  "(anon-function 28 kras-obs)": [[9, "v1", "float"]],
  // mood: the weather updaters roll a random value per lamp/flame element, so
  // several inlined uses share one function.
  "(method 9 mood-control)": [
    [372, "v1", "float"],
    [391, "v1", "float"],
    [404, "v1", "float"],
    [417, "v1", "float"],
    [430, "v1", "float"],
    [443, "v1", "float"],
    [476, "v1", "float"],
    [561, "v1", "float"],
    [580, "v1", "float"],
    [593, "v1", "float"],
    [606, "v1", "float"],
    [619, "v1", "float"],
    [632, "v1", "float"],
    [662, "v1", "float"]
  ],
  "update-mood-electricity": [[23, "v1", "float"]],
  "update-mood-flames": [
    [35, "v1", "float"],
    [62, "v1", "float"],
    [83, "v1", "float"]
