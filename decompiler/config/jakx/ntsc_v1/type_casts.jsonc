  // the a2/a0 pointer-arithmetic chain, unlike v1-108's block where the
  // vector target and the cast offsets both sit at 16 with no conflict.
  "(method 10 visvol-edit-info)": [
    [[1, 703], "gp", "process-drawable"],
    [243, "s4", "(pointer float)"],
    [245, "s4", "(pointer float)"],
    [247, "s4", "(pointer float)"],
    [249, "s4", "(pointer float)"],
    [251, "s4", "(pointer float)"],
    [476, "v1", "(pointer float)"],
    [479, "v1", "(pointer float)"],
    [482, "v1", "(pointer float)"],
    [483, "v1", "(pointer float)"],
    [486, "v1", "(pointer float)"],
    [489, "v1", "(pointer float)"],
    [490, "v1", "(pointer float)"],
    [493, "v1", "(pointer float)"],
    [496, "v1", "(pointer float)"],
    [475, "a2", "(pointer int128)"],
    [530, "a2", "(pointer int128)"],
    [534, "v1", "(pointer float)"],
    [538, "v1", "(pointer float)"],
    [541, "v1", "(pointer float)"],
    [544, "v1", "(pointer float)"],
