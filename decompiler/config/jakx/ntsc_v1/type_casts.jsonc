  // on its own without a cast.
  "(method 7 process)": [
    [47, "v1", "connection"],
    [57, "v1", "connection"],
    [59, "v1", "connection"],
    [60, "v1", "connection"],
    [70, "v1", "connection"],
    [72, "v1", "connection"],
    [73, "v1", "connection"],
    [83, "v1", "connection"],
    [85, "v1", "connection"],
    // heap-walk loop past the connection-list: (relocate s4-0 offset) and
