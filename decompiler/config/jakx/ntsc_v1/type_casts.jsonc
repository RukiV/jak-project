    [28, "a0", "(pointer uint32)"]
  ],
  // shadow-vu1-patch-consts: v1 indexes *shadow-globals* by a two-level
  // shift (bucket-view index times 64, shadow-bucket-views' own
  // :size-assert; bucket index times 32, shadow-bucket's own 20-byte
  // :size-assert rounded up to a 16-byte-aligned stride), then reads a
  // word at +24 that the rest of the function (ops 9/14, floats at +72/
  // +92 off that same loaded value) uses as a pointer into a float-field
  // structure, not as a plain word itself. No field in shadow-bucket's
  // own table (all four "guessed by decompiler") lands on offset 24,
  // which falls in the aligned padding past its own declared extent
  // (ends at 20), so this casts the loaded value to a raw float pointer
  // (matching the +72/+92 float accesses that consume it) rather than
  // guessing a field name for the intermediate offset-24 read itself.
  "shadow-vu1-patch-consts": [
    [5, "v1", "(pointer (pointer float))"]
  ],
  // shadow-vu1-add-constants: t0 is math-camera's own perspective.uvec.x
  // (l.wu offset 176, a real float field per math-camera's own table),
  // but this function does not use it as a float value; it is
  // reinterpreted as a raw base address and walked by four large literal
  // byte offsets (780/796/812/908) that land well outside math-camera's
  // own extent, each read back as a full quadword (ops 22/26/30) or a
  // float (op 32) in its own right. shadow-vu1-init-buffer's own read of
  // the identical offset 176 (its own op 15) shows the same shape,
  // passed on as if it were itself a math-camera argument to
  // shadow-vu1-add-matrix; both functions treat this field as a raw
  // pointer rather than a float value. Cast to (pointer uint128) at the
  // point where the first literal offset is added, matching the quad
  // loads that consume the result, rather than guessing what structure
  // the four offsets index into.
  "shadow-vu1-add-constants": [
    [21, "t0", "(pointer uint128)"],
    [25, "t0", "(pointer uint128)"],
    [29, "t0", "(pointer uint128)"],
    [32, "t0", "(pointer float)"],
    // t1 (op 39, math-camera plus 304, landing on isometric.uvec, a real
    // float field) is quad-copied whole (op 40) rather than read as a
    // scalar float; the quad load needs (pointer uint128) the same as
    // the t0 walk above, not the field's own scalar float type.
    [40, "t1", "(pointer uint128)"],
    // Same shape again at op 73: t1 (op 72, math-camera plus 320, landing
    // on isometric.trans) quad-copied whole.
    [73, "t1", "(pointer uint128)"]
  ],
  // update-eyes and dirty-eyes: v1 is eye-control's own process field
  // (l.d offset 0, declared uint64 "handle" in its own table), then
  // split via the standard sllv/dsra32 handle->process idiom (low 32
  // bits dereferenced as the process pointer at op 16/17, high 32 bits
  // read back as the pid at op 19), matching the cloud-track precedent
  // ((method 10 race-state) above) that casts the raw loaded handle
  // value itself, letting both halves of the split resolve.
  // jak3's own update-eyes carries a matching pair of process-drawable
  // casts (its ops 23/29, register v1), but jakx's update-eyes has an
  // extra are-we-in-time-trial-mode? guard jak3's does not, shifting both
  // the op numbers and which register ends up holding the process
  // (jakx keeps it in s4, not v1, through this point); found by rerunning
  // this rung's own scoped decode rather than assumed from jak3's op
  // numbers directly. dirty-eyes carries the identical shape at the same
  // op.
  "update-eyes": [
    [[16, 20], "v1", "handle"],
    [[22, 36], "s4", "process-drawable"]
  ],
  "dirty-eyes": [
    [[16, 20], "v1", "handle"],
    [[22, 36], "s4", "process-drawable"]
  ],
  // free-eye-index: a2 is eye-control's own array-indexed pointer (eye
  // index times 80, eye's own inline stride, plus inner index times 4,
  // added onto the eye-control base), matching jak3's identical
  // free-eye-index type_casts entry (jak3 op 30, jakx op 29, otherwise
  // unchanged).
  "free-eye-index": [[29, "a2", "eye-control"]],
  // render-eyes-64/render-eyes-32: adopted from jak3's own type_casts
  // entries for these two functions wholesale (goal_src/jak3/engine/gfx/
  // foreground/eye.gc lands both in full); tried unverified per this
  // rung's own scoped decode rather than checked op-by-op given the
  // sheer count, since jakx's racing-HUD eye renderer is otherwise
  // untouched from jak3's own DMA-gif-packet/adgif-shader/vector4w
  // structure here.
  "render-eyes-64": [
    [[77, 82], "v1", "dma-gif-packet"],
    [[88, 93], "s0", "adgif-shader"],
    [[132, 164], "v1", "(inline-array vector4w)"],
    [[244, 274], "a1", "(inline-array vector4w)"],
    [[284, 292], "v1", "dma-gif-packet"],
    [[298, 303], "s0", "adgif-shader"],
    [[376, 406], "a1", "(inline-array vector4w)"],
    [[442, 450], "v1", "dma-gif-packet"],
    [[456, 461], "s0", "adgif-shader"],
    [[535, 562], "a1", "(inline-array vector4w)"],
    [[575, 580], "v1", "dma-gif-packet"],
    [[586, 591], "s0", "adgif-shader"],
    [[664, 694], "a1", "(inline-array vector4w)"],
    [[733, 738], "v1", "dma-gif-packet"],
    [[744, 749], "s0", "adgif-shader"],
    [[845, 874], "a1", "(inline-array vector4w)"],
    [[887, 892], "v1", "dma-gif-packet"],
    [[898, 903], "s0", "adgif-shader"],
    [[1003, 1029], "a1", "(inline-array vector4w)"],
    [180, "a0", "int"],
    [188, "a1", "int"],
    [310, "a0", "int"],
    [318, "a1", "int"],
    [468, "a0", "int"],
    [476, "a1", "int"],
    [598, "a0", "int"],
    [606, "a1", "int"],
    [756, "a0", "int"],
    [764, "a1", "int"],
    [910, "a0", "int"],
    [918, "a1", "int"]
  ],
  "render-eyes-32": [
    [[77, 82], "v1", "dma-gif-packet"],
    [[88, 93], "s0", "adgif-shader"],
    [[132, 164], "v1", "(inline-array vector4w)"],
    [[244, 274], "a1", "(inline-array vector4w)"],
    [[287, 292], "v1", "dma-gif-packet"],
    [[298, 303], "s0", "adgif-shader"],
    [[376, 406], "a1", "(inline-array vector4w)"],
    [[445, 450], "v1", "dma-gif-packet"],
    [[456, 461], "s0", "adgif-shader"],
    [[532, 562], "a1", "(inline-array vector4w)"],
    [[575, 580], "v1", "dma-gif-packet"],
    [[586, 591], "s0", "adgif-shader"],
    [[664, 694], "a1", "(inline-array vector4w)"],
    [[733, 738], "v1", "dma-gif-packet"],
    [[744, 749], "s0", "adgif-shader"],
    [[845, 874], "a1", "(inline-array vector4w)"],
    [[887, 892], "v1", "dma-gif-packet"],
    [[898, 903], "s0", "adgif-shader"],
    [[1000, 1029], "a1", "(inline-array vector4w)"],
    [180, "a0", "int"],
    [188, "a1", "int"],
    [910, "a0", "int"],
    [918, "a1", "int"],
    [310, "a0", "int"],
    [318, "a1", "int"],
    [468, "a0", "int"],
    [476, "a1", "int"],
    [598, "a0", "int"],
    [606, "a1", "int"],
    [756, "a0", "int"],
    [764, "a1", "int"]
  ],
  // hflip-zbuf-init: three raw GIF/DMA-tag construction blocks, the same
  // base-address idiom (method 8 collide-hash) and shadow-vu1-init-buffer
  // above already carry: a generic pointer resolves the trivial
  // zero-offset store on its own but needs an explicit element type for
  // any later offset. a3 (op 63) at +8/+12 (the second half of a GIF tag
  // pair); t0 (op 76) at +8 (a vif-tag pair); t2 (op 90) at +8/+16/+24
  // (a run of packed dma-tag words). v1 (op 61, the buffer's own current
  // dma-packet pointer) resolves the +8 load at op 135 as (pointer
  // uint64) on its own but shows plain dma-packet again for the +8 store
  // five ops later at op 140 with no intervening redefinition; cast to
  // match the load's own resolution.
  "hflip-zbuf-init": [
    [66, "a3", "(pointer uint32)"],
    [68, "a3", "(pointer uint32)"],
    [83, "t0", "(pointer uint64)"],
    [98, "t2", "(pointer uint64)"],
    [107, "t2", "(pointer uint64)"],
    [116, "t2", "(pointer uint64)"],
    [135, "v1", "(pointer uint64)"],
    [140, "v1", "(pointer uint64)"]
  ],
  // fx-copy-init (warp.gc): the identical raw GIF/DMA-tag construction
  // shape as hflip-zbuf-init above, same base-address idiom, different
  // register assignment (t2/t4 in place of hflip's t0/t2 for the two
  // quad-tag blocks, otherwise the same three-block plus closing-packet
  // structure).
  "fx-copy-init": [
    [66, "a3", "(pointer uint32)"],
    [68, "a3", "(pointer uint32)"],
    [83, "t2", "(pointer uint64)"],
    [101, "t4", "(pointer uint64)"],
    [110, "t4", "(pointer uint64)"],
    [119, "t4", "(pointer uint64)"],
    [138, "v1", "(pointer uint64)"],
    [143, "v1", "(pointer uint64)"]
  ],
  // (method 19 sparks-work): the same raw GIF/DMA-tag construction shape
  // as hflip-zbuf-init/fx-copy-init above, one block, same base-address
  // idiom.
  "(method 19 sparks-work)": [
    [100, "a0", "(pointer uint32)"],
    [102, "a0", "(pointer uint32)"]
  ],
  // shadow-vu0-upload and shadow-make-invert-buf: the identical raw DMA-
  // tag construction shape (method 8 collide-hash) and this rung's own
  // hflip-zbuf-init/fx-copy-init/(method 19 sparks-work) already carry,
  // one block each off a generic pointer.
  "shadow-vu0-upload": [
    [17, "a0", "(pointer uint64)"]
  ],
  "shadow-make-invert-buf": [
    [21, "v1", "(pointer uint32)"],
    [22, "v1", "(pointer uint32)"]
  ],
  // tie-near-end-buffer: two more raw DMA-tag blocks, same base-address
  // idiom.
  "tie-near-end-buffer": [
    [[51, 53], "a1", "(pointer uint32)"],
    [[60, 69], "a0", "(pointer uint32)"]
  ],
  // tie-near-init-engine: a long run of raw DMA/GIF-tag construction
  // blocks (this function's own body is almost entirely this idiom, now
  // that its extern activation lets it decompile at all), same base-
  // address idiom as everywhere else in this file; store width (s.w! vs
  // s.d!) picks uint32 vs uint64 at each block.
  "tie-near-init-engine": [
    [[44, 50], "a0", "(pointer uint32)"],
    [[67, 70], "a0", "(pointer uint32)"],
    [[76, 79], "a0", "(pointer uint32)"],
    [[86, 99], "a0", "(pointer uint32)"],
    [[111, 114], "a1", "(pointer uint32)"],
    [122, "a1", "(pointer uint64)"],
    [[129, 138], "a0", "(pointer uint64)"]
  ],
  // emerc-vu1-init-buffer: the identical raw DMA-tag construction shape
  // (method 8 collide-hash) already carries.
  "emerc-vu1-init-buffer": [
    [100, "v1", "(pointer uint32)"],
    [101, "v1", "(pointer uint32)"]
  ],
  // emerc-vu1-initialize-chain: gp/s5 are both dma-gif-packet (correctly
  // typed for the offset-0/8/12 dma-vif sub-fields, which resolve on
  // their own), but the gif tag's own two uint64 halves (offset 16/24)
  // get written as raw 32-bit words (the low/high halves of each 64-bit
  // GIF tag word) rather than through the named gif0/gif1 fields, so
  // those specific stores need the raw pointer width instead. s4/s5
  // (pointer, ops 50/65) walk further into the same packet's payload
  // area as bare vector floats (matching each block's own quad-copy!/
  // math-camera-field-copy pattern), and v1 (pointer, op 90) is a third,
  // final raw DMA-tag block back at the top-level gp base plus 176, the
  // same base-address idiom as everywhere else in this file.
  "emerc-vu1-initialize-chain": [
    [12, "gp", "(pointer uint32)"],
    [14, "gp", "(pointer uint32)"],
    [15, "gp", "(pointer uint32)"],
    [17, "gp", "(pointer uint32)"],
    [24, "s5", "(pointer uint64)"],
    [[58, 65], "s4", "(pointer float)"],
    [[79, 90], "s5", "(pointer float)"],
    [93, "v1", "(pointer uint32)"],
    [99, "v1", "(pointer uint32)"],
    // op 42/50: s5 is dma-gif-packet (correctly typed, :size-assert 32),
    // but +48/+112 here are raw byte offsets into the payload area past
    // the packet header, not further dma-gif-packet elements; cast to a
    // generic pointer at each (op 42 feeds quad-copy!, itself (function
    // pointer pointer int none); op 50 feeds the s4 float-vector walk
    // already cast below).
    [42, "s5", "pointer"],
    [50, "s5", "pointer"],
    // op 65: same shape once more, s5 advances by 128 into the payload
    // area for the third float-vector walk (the s5 range at 79-90
    // below).
    [65, "s5", "pointer"],
    // op 90: same shape again, gp (the top-level packet base) advances by
    // 176 for the final raw DMA-tag block (the v1 range at 93/99 above).
    [90, "gp", "pointer"]
  ],
  // etn-ints/etn-floats: byte-for-byte the same VU1 data-memory debug
  // dump idiom as etie-ints/etie-floats above (same base address, same
  // op numbers for etn-ints; etn-floats additionally prints each
  // register's symbolic name via etn-float-reg, shifting its own op
  // numbers but the same four-hex-then-four-float read shape).
  "etn-ints": [
    [17, "v1", "(pointer uint32)"],
    [21, "v1", "(pointer uint32)"]
  ],
  "etn-floats": [
    [22, "v1", "(pointer uint32)"],
    [27, "v1", "(pointer uint32)"],
    [32, "v1", "(pointer uint32)"],
    [37, "v1", "(pointer uint32)"],
    [49, "v1", "(pointer float)"],
    [54, "v1", "(pointer float)"],
    [59, "v1", "(pointer float)"],
    [64, "v1", "(pointer float)"]
  ],
  // etn-end-buffer: byte-for-byte the same raw DMA-tag blocks as
  // tie-near-end-buffer above (same op numbers, same shape).
  "etn-end-buffer": [
    [[51, 53], "a1", "(pointer uint32)"],
    [[60, 69], "a0", "(pointer uint32)"]
  ],
  // etn-init-engine: the same raw DMA/GIF-tag construction blocks as
  // tie-near-init-engine above, four blocks this time.
  "etn-init-engine": [
    [[85, 91], "a0", "(pointer uint32)"],
    [[106, 109], "a0", "(pointer uint32)"],
    [[115, 118], "a0", "(pointer uint32)"],
    [[125, 138], "a0", "(pointer uint32)"]
  ]
}
