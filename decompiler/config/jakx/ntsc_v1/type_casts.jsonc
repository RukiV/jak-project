  // debug leg: sampler pokes the EE timer0 bank directly by raw address; jak3's
  // (top-level-login sampler)/sampler-start/sampler-stop hints transplant with a
  // register match but op-number drift from jakx's added *sampler-above-range-count*
  // tracking (one extra top-level store, one extra stop-time reset not present in
  // jak3's sampler-stop, which never calls format), re-derived against jakx's own
  // disassembly rather than adopted verbatim
  "(top-level-login sampler)": [[15, "v1", "timer-bank"]],
  "sampler-start": [
    [1, "v1", "timer-bank"],
    [3, "v1", "timer-bank"],
    [6, "a0", "timer-bank"],
    [24, "a0", "timer-bank"]
  ],
  "sampler-stop": [
    [1, "v1", "timer-bank"],
    [12, "v1", "timer-bank"]
  ],
  // debug leg: (method 11 memory-usage-block)'s v1 accumulates one of a dozen
  // lui/ori level-memory-mode size constants across a branch merge, then
  // subtracts a borrow-info offset from it; the merge leaves v1 typed object,
  // matching jak3's own hint for the same subtract ([112, "v1", "int"] in its
  // config) but at jakx's own op number, which drifts from jak3's 112 to 78
  // because of a different branch layout ahead of the merge
  "(method 11 memory-usage-block)": [[78, "v1", "int"]],
  // debug leg: (anon-function 2 memory-usage) reads a process-drawable's root
  // (typed trsqv, too generic to have an offset-156 field) and needs it forced
  // down to collide-shape-moving before the following virtual call resolves;
  // matches jak3's own hint for the same load ([211, "v1", "collide-shape-moving"],
  // in its config) but jakx's op number drifts from jak3's 211 to 206
  "(anon-function 2 memory-usage)": [[206, "v1", "collide-shape-moving"]],
  // debug leg: collision-edit-get-max-prim and collision-edit-get-prim both read
  // a process-drawable's root (typed trsqv, too generic for an offset-156 field)
  // and need it forced to collide-shape; matches jak3's own hints for both
  // functions exactly ([11, "v1", "collide-shape"] in its config for each, same
  // op number, no drift)
  "collision-edit-get-max-prim": [[11, "v1", "collide-shape"]],
  "collision-edit-get-prim": [[11, "v1", "collide-shape"]],
  // debug leg: print-actual-collision hits the identical root-typed-as-trsqv
  // load twice, once at op 12 and again at op 182 in a second, separate branch
  // reaching the same field; jak3's config carries no hint for this function,
  // but the fix is the same class as its two siblings above, applied at both
  // sites
  // engine-quick-tier-6: a third, unrelated site in the same function. Op 83
  // reads raw offset 64 off a collide-shape-prim (v1, freshly narrowed from s5
  // at op 78 inside the prim-type==1 "mesh" branch, format string confirms
  // "(mesh ((la-collide-mesh ...") off a collide-shape-prim-mesh (raw 64 ->
  // declared 68, mesh-id, all-types.gc); the base collide-shape-prim has only
  // an untyped 16-byte "specific" union there, so the load needs v1 forced to
  // the mesh subtype at this one op. The loaded int32 is used as an array
  // index into *collision-editor-mesh-names* two ops later, matching mesh-id's
  // own type
  "print-actual-collision": [
    [12, "v1", "collide-shape"],
    [182, "v1", "collide-shape"],
    [83, "v1", "collide-shape-prim-mesh"]
  ],
  // debug leg: print-default-collision walks a raw (pointer process) list and
  // dereferences each entry to read offset 192, which is process-drawable's
  // node-list field (all-types.gc), not anything process itself declares; the
  // function repeats this same walk twice (a primary check at op 23 and a
  // near-identical fallback branch at op 27), each needing v1 forced to
  // process-drawable at its own op. No jak3 hint for this one either;
  // jakx-only, evidence is the field table
  // engine-quick-tier-6: tried extending this same class to ops 55, 66 and
  // 110 (the identical raw188/raw192/raw12 shape as the two sites above), and
  // each fix only unmasked the next one (op 55 -> op 66 -> op 111 -> op 138),
  // with at least four more independent sites past that point (ops 156 via
  // raw184, 270 and 280 via a1/v1, 378 via v1, each its own register and each
  // needing its own point cast). This function evidently repeats the same
  // per-prim-type debug print block (sphere/mesh/group) several times over
  // with the compiler re-deriving the process-drawable chain fresh each time
  // rather than caching it, so the cast count keeps growing with no end in
  // sight this rung. Held at the original single failure (op 55) rather than
  // chasing the tail; see the commit message and print-default-collision's
  // own landed stub note
  "print-default-collision": [
    [23, "v1", "process-drawable"],
    [27, "v1", "process-drawable"]
  ],
  // debug leg: (method 10 collision-edit-info)'s arg1 is declared object (the
  // method's own real signature, shared with draw-menu-shaped callers), but the
