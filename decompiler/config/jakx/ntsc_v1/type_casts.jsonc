  "collision-edit-get-max-prim": [[11, "v1", "collide-shape"]],
  "collision-edit-get-prim": [[11, "v1", "collide-shape"]],
  // debug leg: print-actual-collision hits the identical root-typed-as-trsqv
  // load twice, once at op 12 and again at op 182 in a second, separate branch
  // reaching the same field; jak3's config carries no hint for this function,
  // but the fix is the same class as its two siblings above, applied at both
  // sites
  "print-actual-collision": [
    [12, "v1", "collide-shape"],
    [182, "v1", "collide-shape"]
  ],
  // debug leg: print-default-collision walks a raw (pointer process) list and
  // dereferences each entry to read offset 192, which is process-drawable's
  // node-list field (all-types.gc), not anything process itself declares; the
  // function repeats this same walk twice (a primary check at op 23 and a
  // near-identical fallback branch at op 27), each needing v1 forced to
  // process-drawable at its own op. No jak3 hint for this one either;
  // jakx-only, evidence is the field table
  "print-default-collision": [
    [23, "v1", "process-drawable"],
    [27, "v1", "process-drawable"]
  ],
  // debug leg: (method 10 collision-edit-info)'s arg1 is declared object (the
  // method's own real signature, shared with draw-menu-shaped callers), but the
  // body immediately treats it as a process-drawable to read its root field
  // (offset 188) five separate times across the function body; gp holds this
  // value unchanged from op 1 (where it is first copied from a1) through its
  // last use at op 411, so one range cast covers all five reads instead of five
  // separate point casts. Op ranges are upper-bound-exclusive (proven on the
  // visvol-edit rung later this same wave); 412 here, not 411, so the range
  // actually reaches the last use
  "(method 10 collision-edit-info)": [[[1, 412], "gp", "process-drawable"]],
  // debug leg: visvol-edit splits a packed 64-bit handle (pid in the high
  // word, ppointer in the low word) into two 32-bit halves via sllv/dsra32,
  // then dereferences the low half as a raw pointer; matches jak3's own hint
  // for this exact function and both op ranges exactly, same op numbers, no
  // drift
  "visvol-edit": [
    [[17, 21], "v1", "handle"],
    [[22, 26], "v1", "handle"]
  ],
  // debug leg: (method 11 visvol-edit-info) reads a process-drawable's
  // node-list field (offset 192) three times (ops 9, 66) and root field
  // (offset 188, op 11) once, all off its raw arg1, declared object; one
  // range cast from op 9 through the last use at op 66 covers all three (the
  // upper bound is exclusive, so 67). No jak3 hint for this function;
  // jakx-only, evidence is the field table
  "(method 11 visvol-edit-info)": [[[9, 67], "a1", "process-drawable"]],
  // debug leg: (method 10 visvol-edit-info) repeats the same node-list read
  // through gp (a copy of arg1 taken at op 1) at least eighteen times across
  // the function body; gp holds the value unchanged from op 1 through its
  // last use at op 702, so one range cast covers the whole span. The range
  // upper bound is exclusive (verified empirically: [1, 702] still left op
  // 702 itself unresolved), hence 703 here
  "(method 10 visvol-edit-info)": [[[1, 703], "gp", "process-drawable"]],
  // (method 10 mem-manager): v1 is (+ arg1 -16), the block header immediately
  // before the freed user pointer (the standard free() layout). The decoder
  // cannot guess this on its own ("Could not figure out load: (l.bu v1)");
  // once cast, every subsequent v1 use (prev/next/tp/flavor/paras) resolves
  // against memblock's own real fields.
  "(method 10 mem-manager)": [[[1, 48], "v1", "memblock"]],
  // (method 9 mem-manager): a0 and s5 both carry the best-fit block found by
  // the search loop, seeded #f (op 5, s5 copied from a0 at op 23) and
  // reassigned to a real memblock inside the loop (op 18); the truthy branch
  // that rules out the #f case (op 24) narrows neither register's own type,
  // so both keep the '#f/memblock merge into the found-block path and fail
  // there ("add failed: '#f <value x 16>" on a0's own pointer arithmetic,
  // "Could not figure out load" on s5's own field read).
  "(method 9 mem-manager)": [[[46, 72], "s5", "memblock"], [[50, 64], "a0", "memblock"]],
  // (code part-tester-idle): s5 is an entity's own process, looked up
  // through entity-links and gated by a runtime (type? s5 process-drawable)
  // check already visible in the decode before reading raw offset 184 (the
  // typed-generically-as-process load fails, "Could not figure out load");
  // offset 184 raw is process-drawable's own root field (188 declared).
  "(code part-tester-idle)": [[[16, 22], "s5", "process-drawable"]],

  // task-scenes: (anon-function 10 task-scenes) has a "beq s7, s7" at op 10,
  // an always-true branch (s7 compared to itself), so the block it skips
  // (ops 11 to 14) is unreachable in this binary. The compiler still emitted
  // it, and it calls t9 while t9 holds a literal #f ("or t9, s7, r0" at op
  // 11), which fails type prop ("Called something that was not a function:
  // symbol" at op 13) and, unresolved, leaves the function's other use site
  // (a command-list data reference at the top level) printing the debug
  // placeholder "<lambda at L11>" instead of a valid embedded lambda.
  // task-scenes is declare-file (debug), so a debug-only branch collapsing
  // to a #f callee in the retail ntsc_v1 build (its target stripped) is
  // consistent with the file's own header; the a0 setup one op earlier
  // (l.wu (+ gp 504), the same mood-context offset clear-mood-context reads
  // at op 7) matches (function mood-context symbol)'s signature exactly, so
  // casting t9 at the call op to that type lets expression building
  // succeed without inventing a callee identity beyond what the dead code
  // already provides.
  "(anon-function 10 task-scenes)": [[13, "t9", "(function mood-context symbol)"]],

  // garage-turntable: the 'speed event case in both (event down) and
  // (event up) reads the event-message-block's first param (offset 16) and
  // immediately mtc1's it into self's speed field (offset 308), the
  // standard "event param holds a float" idiom; cast the ld result to
  // float so the following mtc1/swc1/mfc1 sequence type-checks as pure
  // float use instead of "FPR -> GPR applied to a uint".
  "(event down garage-turntable)": [[[18, 22], "v1", "float"]],
  "(event up garage-turntable)": [[[28, 32], "v1", "float"]],
  // (event idle garage-tool-arm)'s "set-dest-local" case reads the event
  // param (offset 16) and vf-loads straight from it at op 10 (lqc2 vf5,
  // 0(v1)); the param holds a vector pointer, same as the (+ self 412)
  // destination address one op earlier which types plain "vector".
  "(event idle garage-tool-arm)": [[[5, 11], "v1", "vector"]],
  // (anon-function 7 credits-obs) is passed to search-process-tree as the
  // callback (function process-tree object), so arg0 (a0) is a
  // process-tree, not the generic object the decompiler infers locally
  // from the raw (l.wu (+ a0 -4)) type-tag read.
  "(anon-function 7 credits-obs)": [[[0, 3], "a0", "process-tree"]],
  // (code running end-credits-character-viewer) is parked as asm
  // (hacks.jsonc, blocked by the undeclared traffic-object-spawn-params
  // struct), so no type_casts entry applies to it; the net-driver,
  // lobby-menu-manager and *net-drivers*/*credits-chars* type fixes it
  // needed on the way there are still live in all-types.gc and may help
  // other objects in the corpus.
  // (post idle peak-snowball): s4 is the quaternion+matrix compound stack
  // local (stack_structures.jsonc, quaternion at its own base, matrix 16
  // bytes further in); computing s4+64 to reach the matrix's fourth row
  // for a plain 16-byte quad write fails against the quaternion type's
  // own 16-byte bound, so cast the address arithmetic to a byte pointer
  // and the destination to vector for the write that follows.
  "(post idle peak-snowball)": [
    [197, "s4", "(pointer uint8)"],
    [[197, 202], "v1", "vector"],
    [190, "a0", "matrix"],
    [[203, 208], "a3", "matrix"],
    [213, "s4", "(pointer uint8)"],
    [[213, 215], "a0", "vector"],
    [219, "s4", "(pointer uint8)"],
    [219, "a1", "matrix"],
    [224, "s4", "(pointer uint8)"],
    [224, "a1", "(pointer uint8)"]
  ],
  // (method 17 peak-snowball): same s5+64 matrix-fourth-row shape as
  // (post idle peak-snowball) above.
  "(method 17 peak-snowball)": [
    [49, "s5", "(pointer uint8)"],
    [[49, 53], "v1", "vector"],
    [42, "a0", "matrix"],
    [[62, 67], "a3", "matrix"],
    [72, "s5", "(pointer uint8)"],
    [[72, 74], "a0", "vector"]
  ],
  // (method 71 peak-snowball): the same "a0 reloaded as best-other-tri
  // (collide-tri-result, offset 0's own narrowest alias) rather than the
  // outer collide-query" defect (method 71 construction-object) already
  // hits; cast a0 back to collide-query at each failing store op.
  "(method 71 peak-snowball)": [
    [47, "a0", "collide-query"],
    [49, "a0", "collide-query"],
    [50, "a0", "collide-query"],
    [51, "a0", "collide-query"],
    [53, "a0", "collide-query"],
    [55, "a0", "collide-query"],
    [56, "a0", "collide-query"],
    // rigid-body-object's own collide-shape field is declared the
    // generic collide-shape, but the call two ops later reaches for
    // method 62 (rbody-collision), only declared on the collide-shape-
    // moving subtype (collide-shape's own method-count-assert is 55,
    // well short of 62).
    [[68, 70], "a0", "collide-shape-moving"]
  ],
  "(code idle hirez-viewer)": [
    [[11, 13], "v1", "art-joint-anim"],
    [[32, 34], "v1", "art-joint-anim"]
  ],
  // activate-end-credits-proc: *end-credits-proc* is a handle-typed
  // global; storing an 8-byte handle into it needs the loaded symbol
  // value treated as a pointer to its own slot, not a bare handle value,
  // for the s.d! store to resolve.
  "activate-end-credits-proc": [[[34, 36], "a0", "(pointer handle)"]],
  // update-stuff: v1 and gp both hold resolved process handles (hirez-
  // viewer's process and turntable's process); both get their root
  // field (offset 184, the process-drawable convention) read twice to
  // copy quaternions between them, same shape as (method 80
  // construction-object)'s v+184 root reload.
  "update-stuff": [
    [[26, 34], "v1", "process-drawable"],
    [[28, 70], "gp", "process-drawable"]
  ],
  // etie-ints/etie-floats (debug segment VU1 register dumps, gated by
  // *debug-segment*): gp is set once per function to a raw VU1 data-memory
  // address (0x1100c000 base, matching the PS2 VU1 data-memory mapping; see
  // etie-init-consts/etie-init-engine for the same base class), then indexed
  // per debug-segment register slot (16-byte stride, matching the VU1
  // register file's own vi/vf layout) and dereferenced with l.wu. The
  // decompiler leaves the indexed address typed plain int (raw address
  // arithmetic, not a real pointer), so every load off it fails ("Could not
  // figure out load"). etie-ints reads one raw uint32 slot twice (once into
  // an arg register, once through the stack, both printed as the same word:
  // decimal then hex, matching a vi-register debug line). etie-floats reads
  // the same 4-word (16-byte) slot twice per vf register: once as raw uint32
  // (hex dump line) and again as float (the ~16,,8F float dump line), so the
  // same four addresses need two different pointee types depending on which
  // read consumes them. Casts target the load's own op (one past the daddu
  // that builds the address), matching the visvol-edit precedent above.
  "etie-ints": [
    [17, "v1", "(pointer uint32)"],
    [21, "v1", "(pointer uint32)"]
  ],
  "etie-floats": [
    [17, "v1", "(pointer uint32)"],
    [22, "v1", "(pointer uint32)"],
    [27, "v1", "(pointer uint32)"],
    [32, "v1", "(pointer uint32)"],
    [40, "v1", "(pointer float)"],
    [45, "v1", "(pointer float)"],
    [50, "v1", "(pointer float)"],
    [56, "v1", "(pointer float)"]
  ],
  // debug-merc-size-runtime (debug-foreground.gc): s1/s2 are the loop's own
  // merc-fragment/merc-fragment-control pointers (set at ops 8/7), but the
  // per-fragment loop increment (ops 116/118, matching debug-merc-fade-
  // runtime's own explicit (the-as int ...) wrap around the same asize-of
  // advance) has to demote the back-edge value to plain int, which merges
  // against the entry type at the loop header to plain object ("add
  // failed" at the increment itself; "Could not figure out load" at every
  // raw offset read of s1/s2 anywhere in the loop body, one at a time as
  // each successive error unmasks the next). Rather than chase each read
  // site individually (five rounds of this rung's own scoped decode found
  // new ones each time: ops 21/22/24, then 38, with more implied), this
  // casts s1/s2 back to their concrete types across the whole loop body,
  // one op after their own definitions through the op immediately before
  // the increment, matching debug-merc-fade-runtime's own working shape
  // where the loop variable is simply cast at every use instead.
  //
  // Two independent errors sit inside that same loop body regardless of
  // the s1/s2 widening: two separate adgif-shader "strip length" reads
  // (the "input size" check's own shader loop at ops 97/104, and a second,
  // separate copy for the "output size" check at ops 53/62), both register
  // v1, both the same shape as etie-ints/etie-floats above (a halfword
  // read 28 bytes into the current shader with no confidently named field,
  // cast to the raw width the load itself uses; the stride-80 walk cast to
  // adgif-shader, matching its own :size-assert, since merc-fp-header's
  // :size-assert of 16 does not collapse a +80 step).
  "debug-merc-size-runtime": [
    [[9, 116], "s1", "merc-fragment"],
    [[8, 118], "s2", "merc-fragment-control"],
    [116, "s1", "int"],
    [118, "s2", "int"],
    [97, "v1", "(pointer uint16)"],
    [104, "v1", "adgif-shader"],
    [53, "v1", "(pointer uint16)"],
    [62, "v1", "adgif-shader"],
    // A further pair once the above clear: the "TOO MANY MIPS" epilogue's
    // per-effect walk clears the VU0 scratchpad ready-flag at the fixed
    // base address 0x70000000 (lui v1, 28672), the same base-address idiom
    // (method 8 collide-hash) and collide-upload-vu0 already carry above,
    // and the stores off it need the same raw pointer cast.
    [139, "v1", "(pointer uint32)"],
    [141, "v1", "(pointer uint32)"]
  ],
  // debug-merc-highres-runtime (debug-foreground.gc): same shape as
  // debug-merc-size-runtime above, s1/s2 cast to their concrete types
  // across the whole loop body (one op after their own definitions at ops
  // 11/10 through the op before the increment at 215/217) rather than
  // chasing each read site (this rung's own scoped decode still found new
  // ones after five rounds of narrow single-op and short-range fixes).
  //
  // a0 is computed at op 146 as merc-fragment's own vertex-record area (s1
  // plus unsigned-four-count rounded up to a 16-byte boundary), then
  // indexed at 12-byte stride (ops 161/168) and read at +4/+5 (ops 162/
  // 169). 12 bytes is merc-vtx's own size-assert, and +4/+5 are exactly
  // its dst-0/dst-1 fields (the values the surrounding "has a hole at
  // address" scratch-buffer check is built from). Casting a0 to merc-vtx
  // across the read span (one op after the def through the last use at
  // 168) lets the indexed arithmetic collapse to plain field reads.
  //
  // debug-merc-highres-runtime also carries its own copy of the
  // adgif-shader "strip length" read and stride-80 walk from
  // debug-merc-size-runtime above (ops 101/111 here instead of 97/104,
  // register a0 instead of v1; same evidence, same fix).
  "debug-merc-highres-runtime": [
    [[147, 169], "a0", "merc-vtx"],
    // op 162's own load (a2, the dst-0 field, indexed off the same a0 base
    // as op 168's dst-1 one two ops later) still reports a stale "Failed
    // load" even though the a0 cast above already collapses it to
    // <merc-vtx + (value x 12)> and resolves it to uint on its own line;
    // op 169's identical shape does not carry the same stale error. Casting
    // a2 directly at its own op clears the leftover record without
    // changing the resolved type.
    [162, "a2", "merc-vtx"],
    // op 169's own dst-1 read carries the identical stale-error shape as
    // op 162's dst-0 one right above it.
    [169, "a3", "merc-vtx"],
    [[12, 215], "s1", "merc-fragment"],
    [[11, 217], "s2", "merc-fragment-control"],
    [215, "s1", "int"],
    [217, "s2", "int"],
    [101, "a0", "(pointer uint16)"],
    [111, "a0", "adgif-shader"],
    // debug-merc-highres-runtime's own "TOO MANY MIPS" epilogue carries the
    // same VU0 scratchpad ready-flag clear as debug-merc-size-runtime's
    // ops 139/141 above, at ops 238/240 here.
    [238, "v1", "(pointer uint32)"],
    [240, "v1", "(pointer uint32)"],
    // sv-144 (the "output size" quad-count accumulator) is declared from
    // its own initial 0 at op 67, defaulting to plain int. Its own
    // reassignment two ops later (op 76) multiplies strip-len (uint8, read
    // at op 69) by 3 through an unsigned multiply instruction, and the
    // decompiler renders the literal 3 with an explicit uint cast to match
    // (the-as uint 3), which then makes the whole sum uint under the GOAL
    // compiler's own arithmetic promotion rules; (mi) rejects the
    // int/uint mismatch even though the decompiler's own looser tracking
    // shows the same op as int-compatible ("<integer 0 + int>"). Casting
    // the strip-len read itself to int (same bits, uint8 values are never
    // negative) removes the need for the uint literal cast, keeping the
    // whole expression, and sv-144's own declared type, plain int.
    [69, "v1", "int"]
  ],
  // diag-frag-print: v1 is merc-fragment-fp-data's own return (correctly
  // typed merc-fp-header at op 247), but the debug print two ops later
  // reads raw offset 44, 28 bytes past the header's own :size-assert #x10
  // (into the adgif-shader array that follows it, per debug-merc-fade-
  // runtime's own &+ 16 precedent), masked to a byte for a bare "~x
  // VERTICES" hex dump. No field in adgif-shader's own table names this
  // offset with any confidence (28 bytes in lands mid gs-reg64, not a
  // documented boundary), so this casts the pointer to the raw word width
  // the load itself already uses rather than guessing a field name.
  // Once that clears, the same per-fragment loop increment as
  // debug-merc-highres-runtime above fails next: ops 255/256 advance s4
  // (merc-fragment) and s5 (merc-fragment-control) by their own asize-of
  // results, the identical "add failed" shape, same fix.
  //
  // A third, independent error follows: op 234 reads a full word at
  // merc-fp-header offset 12 (shader-cnt/kick-info-offset/kick-info-step/
  // hword-cnt, four packed uint8 fields, read together as one raw word for
  // a hex dump rather than through any single named field; ops 231-233
  // read offsets 0/4/8 the same way and already resolve cleanly as float,
  // since x-add/y-add/z-add are real named fields there). Cast to the raw
  // word width the load already uses, same class as op 248 above.
  //
  // Same s1/s2-class loop-header widening as the two functions above hits
  // s4/s5 here (the per-fragment loop increment at ops 255/256 demotes the
  // back-edge value to int, matching debug-merc-fade-runtime's own
  // (the-as int ...) wrap), so both are cast to their concrete types
  // across the whole loop body rather than chased read by read: s4 one op
  // after its own def (op 4) through the op before its own increment
  // (255); s5 the same, one op after op 3 through 256. s0 (a copy of s4
  // taken at op 17) gets its own narrower range, since op 173 rebinds it
  // to an unrelated computed pointer that already resolves cleanly on its
  // own (forcing merc-fragment there would fight that pointer's own
  // <merc-fragment + (value x 16)> arithmetic type), so its range stops at
  // 90, one past its own last raw read in the object-typed window (verified
  // directly against this worktree's own scoped decode: ops 26-29, 34-37,
  // 42-45, 50, 82, 84, 85, 88, 89; op 169, later still and past op 173's
  // rebind, resolves on its own without help). s0's later op 234 use above
  // is a distinct, later SSA generation, reassigned at op 220, so the two
  // entries do not overlap.
  // A further, nested copy of the same loop-carried-pointer class sits
  // past op 173, where s0 is rebound to a fresh pointer (v1, the fragment's
  // own vtx-record area, plus a rounded unsigned-four-count offset,
  // matching debug-merc-highres-runtime's a0-40 at its own op 146) that
  // walks a per-vertex dump loop advancing by 12 (merc-vtx's own
  // :size-assert) at op 208. op 173's own definition resolves fine on its
  // own (<merc-fragment + (value x 16)>), but by its very next read seven
  // ops later (op 181, no intervening redefinition) the type has already
  // fallen to plain int, the same loop-header merge shape as s1/s2/s4/s5
  // above; cast across the loop body, one op after the def through the op
  // before its own increment.
  "diag-frag-print": [
    [248, "v1", "(pointer uint32)"],
    // op 81 copies s4 to stack offset 48 (the "sv-48" HEADER/RGBAs walk
    // pointer); the wide s4 range below types it merc-fragment like every
    // other s4 copy, but sv-48's own advance two blocks later (op 102,
    // "+4", collapsing to &-> ... header mat1-cnt, an unrelated shape from
    // the s1/s4-class "add failed" fix) resolves to (pointer uint8) on its
    // own, and a lexical variable's set! must match its own let binding's
    // type, not merely be castable to it. This single-op override, more
    // specific than the range below, keeps sv-48's own declared type
    // (pointer uint8) so the later set! type-checks; sv-32 (op 80, the
    // adjacent copy used only through explicit (the-as uint ...) later)
    // is unaffected and stays merc-fragment.
    [81, "s4", "(pointer uint8)"],
    [[5, 81], "s4", "merc-fragment"],
    [[82, 255], "s4", "merc-fragment"],
    [[4, 256], "s5", "merc-fragment-control"],
    [255, "s4", "int"],
    [256, "s5", "int"],
    [234, "s0", "(pointer uint32)"],
    [[26, 90], "s0", "merc-fragment"],
    [[174, 208], "s0", "merc-fragment"],
    [208, "s0", "int"],
    // A separate, earlier vtx-dump loop (stack slot 48(sp) rather than a
    // register, an independent copy of the same "vtx ~2d: ~02x ~02x ~02x
    // ~02x" print seen at op 181 above but reached through a different
    // code path) carries the identical stale first-read shape: op 144's
    // own stack-load resolves object while the three others reading the
    // exact same slot moments later (ops 146/148/150) already resolve
    // merc-fragment on their own.
    // The four back-to-back stack reads of the same 48(sp) slot cascade:
    // fixing each one's stale error unmasks the exact same shape on the
    // next, one at a time (verified through four rounds of this rung's own
    // scoped decode), so all four are cast up front here.
    [145, "v1", "merc-fragment"],
    [147, "v1", "merc-fragment"],
    [149, "v1", "merc-fragment"],
    [151, "v1", "merc-fragment"],
    // op 153's own read of the same slot, immediately before advancing it
    // by 4 for the next loop iteration (op 154, "add failed: object
    // <integer 4>" until cast), carries the same stale shape.
    [154, "v1", "merc-fragment"],
    // An earlier, separate "RGBAs:" print loop over the same 48(sp) slot
    // advances it by 4 at its own op 101, register a0 this time; same
    // shape, same fix.
    [101, "a0", "merc-fragment"],
    // That loop's own raw byte stores (writing the literal 128/128/0/128
    // pattern into the same slot, two unrolled passes) need the identical
    // cast for the store side once the later reads above stop masking
    // them: v1 at ops 118/120/136/139, a0 at ops 123/131/134.
    [118, "v1", "merc-fragment"],
    [120, "v1", "merc-fragment"],
    [123, "a0", "merc-fragment"],
    [126, "v1", "merc-fragment"],
    [131, "a0", "merc-fragment"],
    [134, "a0", "merc-fragment"],
    [136, "v1", "merc-fragment"],
    [139, "v1", "merc-fragment"]
  ],
  // shadow-vu1-init-buffer: a0 is the dma-buffer's own data pointer
  // (l.wu offset 4, generic pointer with no element type), so the
  // zero-offset raw DMA tag store (op 20) resolves trivially but the
  // +8/+12 stores (ops 26/28, the second half of the same GIF tag pair)
