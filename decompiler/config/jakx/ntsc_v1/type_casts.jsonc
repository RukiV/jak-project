{
  // load-game-text-info (text-record-wall rung): arg1 is (pointer object), the
  // same signature jak3 carries, so the previously-loaded game-text-info it
  // points at comes back typed object and the language-id (machine 4) and
  // group-name (machine 8) reads off it cannot resolve. jak3 fixes exactly this
  // with two type_casts of its own on the same two derefs ("load-game-text-info":
  // [[34, "v1", "game-text-info"], [41, "v1", "game-text-info"]]); 66 and 73 are
  // the matching op indices in jakx's own body.
  "load-game-text-info": [
    [66, "v1", "game-text-info"],
    [73, "v1", "game-text-info"]
  ],
  // scene-player-init (scene lane): arg0 (object) is dispatched by rtype-of
  // into array/pair/else cases, jak3's own twin body doing the identical
  // (case (rtype-of arg0) ((array) (set! (-> self scene-list) (new 'process
  // 'boxed-array scene (-> (the-as (array scene) arg0) length))) ...)).
  // s5 (the coalesced copy of arg0 made at op 0) needs (array scene) only
  // across the array-case body (the length read at op 37 and the copy loop
  // through op 49); untouched outside that range so the pair/else cases
  // keep reading arg0 as plain object.
  // op 82 is the pair-case branch's own dynamic boxed-array constructor
  // call ((method-of-type array new) 'process array scene length), whose
  // return the compiler cannot resolve narrower than plain array on its
  // own; jak3's own twin body wraps the identical call expression with
  // (the-as (array scene) ...) before the set! into scene-list (goal_src/
  // jak3/engine/scene/scene.gc), so this rung casts the call's own
  // return (v0) the same way at its defining op.
  "scene-player-init": [
    [[32, 49], "s5", "(array scene)"],
    [82, "v0", "(array scene)"]
  ],
  // (method 9 scene-actor) (setup-manipy-for-scene!, activation-cluster
