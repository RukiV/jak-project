  "target-pilot-post": [
    [14, "v1", "process-drawable"],
    [20, "v1", "process-drawable"],
    [27, "v1", "process-drawable"]
  ],
  // next-continue: mirrors jak3's own next-continue (goal_src/jak3/engine/target/
