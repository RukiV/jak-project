{
  // display-nice-shot-to-view: gp is a hud-item read out of
  // *text-display-nice-shot* (an (array hud-item), offset 12, the same
  // array-data-start shape used throughout this band), but the actual
  // runtime object is a hud-item-string: ops 7, 15 and 22 all touch raw
  // offset 40, declared offset 44 via the +4 basic-tag trap, which is
  // hud-item-string's own text-id field (uint32), not hud-item-group's items
  // (declared 40, which raw 40 without the +4 trap would wrongly reach).
  // Confirmed by the comparison shape: op 10 reads a text-id out of the
  // L119 lookup table (label_types.jsonc, values 0x1322-0x1329) and op 11
  // compares it against this same offset-40 read, then both branches store
  // the newly picked text-id back to it (ops 15, 22) -- a last-shown-text-id
  // cache to avoid an immediate repeat, which only makes sense as text-id.
  // Cast starts one op after gp is set (op 2) through the last use (22).
  "display-nice-shot-to-view": [
    [[3, 23], "gp", "hud-item-string"]
  ],
  // spawn-hud-headset-talker: same shape as (method 64 driver-gtblitz) below
  // (net-world's own basic-typed field, byte read at machine offset 5,
  // declared offset 9 via the +4 basic-tag trap), but off task-info (offset
  // 1108) rather than task-node-info (offset 1112). Declared offset 9 is
  // still game-task-node-info's net-play-mode (uint8); task-info and
  // task-node-info read as the same concrete type at their respective call
  // sites, so this follows (method 64 driver-gtblitz)'s own recipe (a
  // per-callsite cast, not a deftype field retype, since net-world's own
  // fields are not uniformly one concrete type across every reader) rather
  // than introducing a second one.
  // (method 10 race-state): v1 is racer-state's own racer field (a handle,
  // op 16, ld raw offset 48), then manually split into pid/pointer halves
  // and dereferenced (ops 17, 20, 23), the same hand-rolled handle->process
  // shape the cloud-track entry below casts to type handle rather than
  // (pointer process): casting the raw loaded value itself lets both the
  // subu-s7 null check and the sllv/dsra32 split resolve.
  "(method 10 race-state)": [
    [[17, 24], "v1", "handle"]
  ],
  "spawn-hud-headset-talker": [
    [22, "v1", "game-task-node-info"]
  ],
  // (method 14 hud-effect-trigger-score-sound): identical shape to
  // spawn-hud-headset-talker above (net-world's task-info field, byte read
  // at machine offset 5, declared offset 9 via the +4 basic-tag trap,
  // game-task-node-info's own net-play-mode).
  "(method 14 hud-effect-trigger-score-sound)": [
    [6, "v1", "game-task-node-info"]
  ],
  // (method 13 hud-effect-emit-score-icon): same event-message-block param
  // shape as the hang-time/power-slide method 23 overrides above; here the
  // loaded param is stored straight through as a halfword with no
  // arithmetic, so no follow-up float cast is needed.
  "(method 13 hud-effect-emit-score-icon)": [
    [2, "t0", "event-message-block"]
  ],
  // (method 10 hud-effect-throb): s5 is this's own item field (hud-item).
  // Op 31 reads raw offset 48 (declared 52, +4 basic-tag trap), matching
  // hud-item-string's own font-flags field (uint16) exactly, then op 32
  // bit-tests it (andi ... 4). Op 35 immediately after reads raw offset 36
  // (declared 40), the same items-field shape used throughout this band, so
  // it needs hud-item-group instead.
  // (method 10 hud-effect-throb): s5 is this's own item field (hud-item).
  // Op 31 reads raw offset 48 (declared 52, +4 basic-tag trap), matching
  // hud-item-string's own font-flags field (uint16) exactly, then op 32
  // bit-tests it (andi ... 4). Op 35 reads raw offset 36 (declared 40),
  // giving s4 a pointer that ops 48/52/58 then read at raw offsets 0/48/32
  // respectively, matching hud-string's own text (offset-assert 0), alpha
  // (offset-assert 48, float) and pos (offset-assert 32, vector4w) fields
  // directly (hud-string is a plain structure, no +4 trap on its own
  // fields) -- so op 35 is hud-item-string's own string field too, not
  // hud-item-group's items.
  "(method 10 hud-effect-throb)": [
    [31, "s5", "hud-item-string"],
    [35, "s5", "hud-item-string"]
  ],
  // (method 9 hud-effect-throb): v1 (this's item field, aliased from s4)
  // reads and writes raw offset 40 (declared 44, +4 basic-tag trap) at ops
  // 115 and 121, matching hud-item-sprite's own real-scale-y (int16) field
  // exactly (the adjudicated proof for hud-item-sprite's own layout already
  // establishes this +4 shift for fields accessed through this narrower
  // type, not just its own newly declared ones).
  "(method 9 hud-effect-throb)": [
    [[115, 122], "v1", "hud-item-sprite"]
  ],
  // (method 14 hud-effect-font-effect): v1 is this's own item field
  // (hud-item). Ops 2 and 5 both read raw offset 36 (declared 40, +4
  // basic-tag trap), which coincides with hud-item-group's items field, but
  // the store shapes that follow (a2+56 a byte, v1+52 a float) only match
  // hud-string's own effect (declared 56, uint8) and time (declared 52,
  // float) fields, reached through hud-item-string's string field (also
  // declared 40, since both subtypes place their first added field right
  // after hud-item's own 40-byte span) rather than hud-item-group's items.
  "(method 14 hud-effect-font-effect)": [
    [2, "v1", "hud-item-string"],
    [5, "v1", "hud-item-string"]
  ],
  // (method 12 hud-effect-font-effect): v1 (aliased from a1, the function's
  // second arg) reads and writes raw offset 44 (declared 48, +4 basic-tag
  // trap) at ops 1 and 4, matching hud-item-string's own font-effect field
  // (uint8) exactly.
  "(method 12 hud-effect-font-effect)": [
    [[1, 5], "v1", "hud-item-string"]
  ],
  // (method 19 hud-headset-talker): this's own items array (gp+36) holds a
  // hud-item-group at index 0 (a0-10, read at op 37); casting a0 to
  // hud-item-group lets both op 38 and op 40 resolve raw offset 36 (declared
  // 40 via the +4 basic-tag trap) as its own items field. That nested items
  // array in turn holds two different concrete widgets: index 0 (s1, op 39,
  // the array's own "+12 data start" convention) is a hud-item-string, not
  // another hud-item-group -- ops 71 and 89 read raw offset 36 off it
  // (declared 40, hud-item-string's own string field, hud-string), then
  // dereference it and take +4 for the char data, matching
  // copy-charp<-charp's own callsite at op 80. Index 1 (s0, op 41, offset 16
  // = data-start 12 + one 4-byte stride) stays generic hud-item; nothing
  // reads a field past hud-item's own bounds off it. a0's range starts at op
  // 38 (the read itself; a0-10 is already fully computed by op 37, so
  // casting the register only from its first read forward does not disturb
  // op 37's own natural typing) through 41 to cover both reads (38 and 40).
  // s1's range starts at op 40 (one past its own compute at op 39) through
  // 120 to cover both offset-36 reads (71, 89) and the type-tag/passthrough
  // uses (117, 119), which do not care about the concrete subtype.
  // (method 14 hud-text-effect-sound): s5 is a hud-item (this's own item
  // field); op 17 reads raw offset 36 (declared 40, +4 basic-tag trap),
  // which is hud-item-group's items field on that type, but the immediate
  // next op reads raw offset 56 directly (no further shift) off the result,
  // matching hud-string's own :offset-assert 56 effect field exactly
  // (hud-string is a plain structure, no +4 trap on its own fields). That
  // only fits hud-item-string's own string field (declared 40, a pointer to
  // hud-string since the field is not :inline), not hud-item-group's items.
  // (method 14 hud-text-effect-sound): v1 is game-text-info-method-10's own
  // string return; op 68 adds 2 to it directly (skipping the length prefix
  // to reach char data, the standard GOAL string-data idiom), which needs a
  // pointer-arithmetic-compatible type rather than the bare string typespec.
  "(method 14 hud-text-effect-sound)": [
    [[17, 95], "s5", "hud-item-string"],
    [68, "v1", "(pointer uint8)"]
  ],
  "(method 19 hud-headset-talker)": [
    [[38, 41], "a0", "hud-item-group"],
    [[40, 120], "s1", "hud-item-string"]
  ],
  // spawn-hud-headset-talker-other, spawn-hud-headset-talker-race,
  // spawn-text-display-nice-shot: the same spawned-process type-narrowing
  // class proved on spawn-hud-results-medal-1 above, same op numbers (v0 set
  // at op 29, failing store at op 31), applied unchanged after confirming
  // each function's own ir2.asm shares that exact shape.
  // (method 26 hang-time-hud-single): *hang-time-hud-single* is
  // (array hud-item); its own index-0 element is a hud-item-group (matching
  // the sibling pattern already established in this file), and this
  // function re-reads it fresh from the global four times (ops 30, 36, 43,
  // 49), each time immediately followed by an offset-36 (declared 40) read
  // of its items field. Casting a0 to hud-item-group at each of the four
  // offset-36 read ops resolves them; the subsequent offset-12/16 reads
  // already resolve on their own once the items field itself is typed.
  // The item pulled out of that items array (a0-9/13/17/21, ops 32/38/45/51)
  // is stored to at raw offset 40 (declared 44 via the +4 basic-tag trap),
  // matching display-nice-shot-to-view's own text-id field on
  // hud-item-string, not hud-item-group.
  "(method 26 hang-time-hud-single)": [
    [31, "a0", "hud-item-group"],
    [33, "a0", "hud-item-string"],
    [37, "a0", "hud-item-group"],
    [39, "a0", "hud-item-string"],
    [44, "a0", "hud-item-group"],
    [46, "a0", "hud-item-string"],
    [50, "a0", "hud-item-group"],
    [52, "a0", "hud-item-string"]
  ],
  "spawn-hang-time-hud-single": [
    [[30, 32], "v0", "hang-time-hud-single"]
  ],
  "spawn-power-slide-hud-single": [
    [[30, 32], "v0", "power-slide-hud-single"]
  ],
  // (method 23 hud-item-hang-time-seconds), (method 23
  // hud-item-hang-time-tenths-seconds), (method 23 hud-item-power-slide-
  // distance), (method 23 hud-item-power-slide-distance-tenths): hud-item's
  // own method 23 is already declared (_type_ object object object object)
  // (all-types.gc, hud-item's :methods block); t0 (the fourth message arg)
  // is read with ld (a full doubleword) at offset 16 in each override, which
  // is exactly event-message-block's own param field (uint64 6,
  // offset-assert 16): the 'add-hang-time'/'add-distance' message's own
  // payload sits in param 0, boxed as a uint64 and reinterpreted as a float
  // via the immediately following mtc1 (which only consumes the lower 32
  // bits). Casting t0 to event-message-block at the read op resolves all
  // four identically-shaped overrides.
  // hud-item-hang-time-seconds and hud-item-hang-time-tenths-seconds add the
  // message payload to their own existing value (add.s), unlike the
  // power-slide-distance pair, which only stores it (no arithmetic, so no
  // second cast needed there): param's own declared type is uint64, so the
  // decompiler tracks the value moved into the float register (via mtc1) as
  // still uint-flavored, and the add fails ("Floating point math attempted
  // on invalid types: float and uint"). Casting v1 to float at the mtc1 op
  // itself (one past the event-message-block read) clears it.
  "(method 23 hud-item-hang-time-seconds)": [
    [4, "t0", "event-message-block"],
    [5, "v1", "float"]
  ],
  "(method 23 hud-item-hang-time-tenths-seconds)": [
    [4, "t0", "event-message-block"],
    [5, "v1", "float"]
  ],
  "(method 23 hud-item-power-slide-distance)": [
    [3, "t0", "event-message-block"]
  ],
  "(method 23 hud-item-power-slide-distance-tenths)": [
    [3, "t0", "event-message-block"]
  ],
  "spawn-hud-headset-talker-other": [
    [[30, 32], "v0", "hud-headset-talker-other"]
  ],
  "spawn-hud-headset-talker-race": [
    [[30, 32], "v0", "hud-headset-talker-race"]
  ],
  "spawn-text-display-nice-shot": [
    [[30, 32], "v0", "text-display-nice-shot"]
  ],
  // spawn-hud-results-medal-1, spawn-hud-results-grand-prix-totals,
  // spawn-hud-results-grand-prix: the spawned-process type-narrowing class the
  // hud-follow-through rung named but did not fix (0857cd5f7's commit body,
  // defect class 3). Each function allocates/activates/runs a concrete
  // in-game-hud marker subtype (hud-results-medal-1 etc, all zero-field
  // children of in-game-hud), then re-derives the running process through two
  // more field reads (offset 28, a (pointer process), then offset 32 off its
  // dereference) to reach the object whose inited-strings-count field
  // (declared offset-assert 6376 on in-game-hud, raw 6372 per the +4 basic-tag
  // convention) it zeroes. The decompiler only recovers the second read (op 29
  // in all three functions here) as generic process, not the concrete spawned
  // type, so the store at op 31 fails ("Failed store:
  // (s.w! (+ (the-as process v0-0) 6372) 0)"). Casting v0 to the function's
  // own concrete spawned type starting one op after the read that computes it
  // (30, so op 29's own load off v1 still resolves as generic process first)
  // through one past the failing store (32) resolves it; proved first on
  // spawn-hud-results-medal-1, then applied unchanged (same op numbers, same
  // shape, confirmed op by op against this worktree's own
  // hud-results-grand-prix_ir2.asm) to the other two, clearing all three of
  // this object's "Failed store" errors.
  "spawn-hud-results-medal-1": [
    [[30, 32], "v0", "hud-results-medal-1"]
  ],
  "spawn-hud-results-grand-prix-totals": [
    [[30, 32], "v0", "hud-results-grand-prix-totals"]
  ],
  "spawn-hud-results-grand-prix": [
    [[30, 32], "v0", "hud-results-grand-prix"]
  ],
  // init-level-bbox-from-map and (method 24 hud-map): both index
  // *race-map-info-array* with a shift-by-5 (multiply by 32, hud-classes_ir2.asm
  // op 71/100), matching race-map-info's own :size-assert now that it is 0x20
  // (see the type's own og:preserve-this note in all-types.gc). The decompiler
  // still leaves the indexed pointer typed as the synthetic
  // <(array race-map-info) + (value x 32)> rather than collapsing it to
  // race-map-info, so field reads off it fall back to raw untyped loads: most
  // land on the right primitive type by coincidence (tex-id's uint32, scale's
  // float) but the offset-0/offset-4 pointer fields (corner, tex-offset) never
  // recover a pointer type, so dereferencing them ("Could not figure out load")
  // or building the tex-id call chain ("Failed load") fails. Casting the
  // computed pointer to race-map-info at each site's own op range (starting one
  // op after the add that builds it, matching the set-menumap-target! recipe
  // above) forces the collapse.
  //
  // init-level-bbox-from-map: s4 is set at op 72 (daddu s4-0, v1-17, a0-10) and
  // last read at op 97 (the second (l.f (+ s4-0 12)) call); range runs to 98 to
  // cover that read.
  "init-level-bbox-from-map": [
    [[73, 98], "s4", "race-map-info"]
  ],
  // (method 24 hud-map): s5 is reused for two different purposes in this
  // function; it only becomes the race-map-info-array pointer at op 101 (daddu
  // s5-1, v1-23, a0-8), well after its earlier int use (race index, set at op
  // 77 and shifted at op 100), so the cast range starts after the add rather
  // than at the function's own s5 declaration. Last read is op 150 (the mode
  // field, l.w (+ s5-1 16)); range runs to 151 to cover it.
  "(method 24 hud-map)": [
    [[102, 151], "s5", "race-map-info"]
  ],
  // play-idle-frames! (method 10 idle-control): the second command-get-float call
  // reads (car (cdr (-> s4-0 param2))); a plain cdr access resolves generically as
  // object (correct, a pair's cdr can hold anything), but the code then takes its
  // own car via the same -2 offset. jak3's twin
  // (goal_src/jak3/engine/game/idle-control.gc:78) casts the cdr result to pair
  // explicitly before that access.
  "(method 10 idle-control)": [
    [35, "v1", "pair"]
  ],
  // print-collide-cache-tri-count: the tri-array index arithmetic (v1 * 64, stride
  // matching collide-cache-tri's own size) resolves to a symbolic offset-expression
  // type rather than plain collide-cache-tri, so the pat field read at +48 fails
  // ("Failed load", not a field-name-ambiguity class); cast back to the concrete
  // type before that read.
  "print-collide-cache-tri-count": [
    [9, "a1", "collide-cache-tri"]
  ],
  // (method 8 collide-hash): two scratchpad bitfield reads (VU0 scratchpad base
  // 0x70000000 plus a word index) resolve to a symbolic offset-expression type
  // rather than a plain pointer, matching the same class collide-upload-vu0's own
  // type_casts entry below fixes for the same base-address idiom.
  "(method 8 collide-hash)": [
    [32, "a0", "(pointer uint128)"],
    [48, "a1", "(pointer uint32)"],
    [60, "a1", "(pointer uint32)"],
    [71, "v1", "(pointer uint32)"]
  ],
  // pull-riders!, keyed by its canonical (method 44 collide-shape) form since
  // type_casts matches methods by that form, not their decompiled display name
  // (tried the display name first; it parsed without error but matched nothing).
  // The rider handle's process is
  // dereferenced generically as process (via the standard handle->process
  // sllv/lwu pair), then read at raw offset 184, which is process-drawable's own
  // root field (placed offset 188, +4 basic-tag adjusted), matching jak3's twin
  // (goal_src/jak3/engine/collide/collide-shape-rider.gc:315), which casts the
  // same handle's process to process-drawable before reading root.
  "(method 44 collide-shape)": [
    [25, "a0", "process-drawable"]
  ],
  // detect-riders! (method 35 collide-shape): the *collide-player-list* walk reads
  // param1 off a connectable node at offset 20 (same class as relocate's own
  // connection.param1 fix above), matching jak3's twin
  // (goal_src/jak3/engine/collide/collide-shape-rider.gc:175-176), which casts the
  // node to connection then the resulting param1 to collide-shape before reading
  // root-prim.
  // detect-riders! walks two separate connection lists with the same shape:
  // *collide-player-list* (ops 27/28) and *collide-hit-by-player-list* (ops 76/77).
  "(method 35 collide-shape)": [
    [27, "a0", "connection"],
    [28, "a0", "collide-shape"],
    [76, "a0", "connection"],
    [77, "a0", "collide-shape"]
  ],
  // on-platform-test (method 17 collide-shape-prim-mesh): a mesh-typed prim's own
  // on-platform-test still recurses into a sibling group's children, matching
  // jak3's collide-shape-prim-group overload (goal_src/jak3/engine/collide/
  // collide-shape-rider.gc:46), not the mesh-against-mesh guess tried first (offset
  // 64 also matches collide-shape-prim-mesh's own `mesh` field, but that type left
  // the load unresolved; collide-shape-prim-group's `num-children` at the same
  // offset is the one that actually resolves the whole function).
  "(method 17 collide-shape-prim-mesh)": [
    [7, "s2", "collide-shape-prim-group"]
  ],
  // relocate (method 7 process): the connection-list walk reads next1/prev1 off
  // connectable (both declared on connectable itself, offsets 8/12, resolve fine), then
  // reads param1/param2/param3 off the same node at offsets 20/24/28, which only exist
