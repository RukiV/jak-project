  // (the child inline-array, offset 68), both collide-shape-prim-group's own
  // fields, not collide-shape-prim's.
  "find-closest-solid-sphere-prim": [[[11, 15], "v1", "collide-shape-prim-group"]],
  // (method 62 des-plant): s4/a0 (the attacker resolved from attack-info's own
  // handle field) is type?-checked against process-nettable at op 16-19, then
  // dispatches method 22 at op 25, exactly process-nettable's own declared
  // slot 22 (its own trailing comment already names this call site: "truthy
  // gate on the attacker in nsd method 62").
  "(method 62 des-plant)": [[24, "a0", "process-nettable"]],
  // (enter explode des-plant): s6 (self) is properly des-plant at op 0 but
  // loses its type by op 86, deep in this large function's own exploder
  // handle-construction block (raw offset 300, exploder's own +4 basics
  // offset 304, already declared handle); reasserting self's type here
  // lets the sd/ld through it resolve.
  "(enter explode des-plant)": [[[86, 92], "s6", "des-plant"]],
  // (method 72 des-plant): s5 (root-prim, a generic collide-shape-prim)
  // reads raw offset 64 twice, exactly collide-shape-prim-mesh's own mesh
  // field (offset 64), copying 16 bytes starting at its own +44/+124 as
  // scratch (the mesh's own internal geometry pointers).
  // (method 72 des-plant): s5 (root-prim, a generic collide-shape-prim)
  // reads raw offset 64 twice as a base for further +44/+124 pointer math;
  // neither collide-shape-prim's own fields nor collide-shape-prim-mesh's
  // declared layout resolve a usable field there (raw 64 lands on
  // mesh-id, a plain int32, not a pointer), so this treats it as an
  // opaque scratch pointer rather than inventing a field.
  "(method 72 des-plant)": [[[8, 17], "s5", "(pointer uint32)"]],
  // (method 70 des-plant): gp (self) is properly des-plant at op 0 but
  // loses its type shortly after, deep in this function's own attack-vel/
  // spring-pos/spring-vel scratch math (raw offsets 332/348, the +4
  // basics offsets of spring-pos/spring-vel).
  "(method 70 des-plant)": [
    [[11, 43], "gp", "des-plant"],
    [[73, 174], "s5", "(pointer float)"],
    [119, "v1", "(pointer uint128)"],
    [148, "v1", "(pointer uint128)"]
  ],
  // raptor's five state (enter ...) handlers each read net-enemy-info's own
  // anim-info field (basic, offset 52) at a per-state byte offset (12/16/20,
  // all word-aligned), then dereference the result at +4 (net-enemy-anim-info's
  // own anim-idx field). Neither level resolves through anim-info's basic
  // typing, so both levels are cast as opaque word pointers: (pointer uint32)
  // for the l.wu outer read, (pointer int32) for the l.w inner read, matching
  // the l.w/l.wu instruction width per des-plant's own method-72 precedent.
  "(enter idle-wait raptor)": [
    [54, "v1", "(pointer uint32)"],
    [55, "v1", "(pointer int32)"]
  ],
  "(enter chase raptor)": [
    [33, "v1", "(pointer uint32)"],
    [34, "v1", "(pointer int32)"],
    [64, "a0", "(pointer uint32)"],
    [65, "a0", "(pointer uint32)"],
    [66, "a0", "(pointer uint128)"]
  ],
  "(enter reverse raptor)": [
    [54, "v1", "(pointer uint32)"],
    [55, "v1", "(pointer int32)"]
  ],
  // following-path reads the chain twice: once at op 54/55 (anim-idx, +4) and
  // again at op 62/63 (forward-vel, +8, also read via l.wu so cast uint32 to
  // match instruction width rather than the field's own float type).
  "(enter following-path raptor)": [
    [54, "v1", "(pointer uint32)"],
    [55, "v1", "(pointer int32)"],
    [62, "v1", "(pointer uint32)"],
    [63, "v1", "(pointer uint32)"]
  ],
  // (enter startup raptor)/(enter chase raptor) each read the anim-info
  // chain twice: once at anim-idx's own offset (op 27/33, resolved above),
  // and again through anim-info's own offset-16 slot straight into
  // forward-vel (its own offset 8, now declared (pointer vector)); since the
  // outer anim-info levels are still opaque word pointers, this second read
  // is cast the same way, with a third op casting the forward-vel result
  // itself to a quad pointer for the lqc2 copy that follows.
  "(enter startup raptor)": [
    [27, "v1", "(pointer uint32)"],
    [28, "v1", "(pointer int32)"],
    [58, "a0", "(pointer uint32)"],
    [59, "a0", "(pointer uint32)"],
    [60, "a0", "(pointer uint128)"]
  ],
  // (code startup raptor): gp (self) is properly raptor at op 0 but loses its
  // type deep in this function's own mem-buffer message-building block.
  "(code startup raptor)": [[[80, 105], "gp", "raptor"]],
  // (post chase raptor): a0 comes back from net-player's own method-212 typed
  // as the generic process (the method's own declared return type), then
  // immediately reads raw offset 184, process-focusable's own root (collide-
  // shape) field at its +4 basics offset 188; plain process has no such field.
  "(post chase raptor)": [[12, "a0", "process-focusable"]],
  // (method 65 raptor): s5 (arg0, declared object) reads raw offset 128 at
  // op 3, landing inside process's own connection-list field (declared
  // offset 128, an inline connectable, no +4 shift needed since this is arg0
  // itself, not a further-dereferenced value); process is the narrowest type
  // that has it. A second, unrelated read at op 18 (past the L127/L128
  // branch merge, where the process cast no longer holds) quad-loads s5
  // itself as a 16-byte value copied straight into a *launch-matrix* slot,
  // so that op is cast as an opaque quad pointer instead.
  "(method 65 raptor)": [
    [3, "s5", "process"],
    [18, "s5", "(pointer uint128)"]
  ],
  // engine-quick-tier-6: debug-set-camera-pos-rot! calls view-get-active-
  // camera-combiner twice and writes through the result both times.
  // view-get-active-camera-combiner is declared to return plain basic
  // (all-types.gc's own comment: "basic because camera-combiner parses
  // later" - camera-combiner's deftype is later in the same file, so the
  // extern cannot name it directly), and camera-combiner's own field table
  // confirms the shape: op 12 writes a vector at raw 140 (declared 144,
  // trans) and op 18 writes a matrix at raw 156 (declared 160,
  // inv-camera-rot), so both call results need forcing to camera-combiner
  // at their own point of use
  "debug-set-camera-pos-rot!": [
    [12, "v0", "camera-combiner"],
    [18, "v0", "camera-combiner"]
  ],
  // engine-quick-tier-6: cam-collision-record-save calls view-get-active-
  // camera twice and reads a quad-loaded vector field through each result.
  // view-get-active-camera is declared plain process (all-types.gc's own
  // comment: "really camera-master, but that type parses later; cast at use
  // sites"), and camera-master's own field table confirms both sites: op 29
  // reads raw 540 (declared 544, tpos-curr-adj, vector) and op 35 reads raw
  // 524 (declared 528, tpos-old-adj, vector), so both call results need
  // forcing to camera-master at their own point of use
  // engine-quick-tier-6: op 59's own view-get-active-camera call (a third
  // occurrence, reading raw offset 296, declared 300, string-push-z) looked
  // like the same class as the two casts below and was tried the same way;
  // it cascaded into fifteen new "Failed store" errors across the rest of
  // the function instead of resolving cleanly, the same unmasked-cascade
  // shape cam-line-dma hit above. Reverted; op 59's own error is held as
  // found rather than chased further this rung
  "cam-collision-record-save": [
    [29, "v0", "camera-master"],
    [35, "v0", "camera-master"]
  ],
  // engine-quick-tier-6: camera-slave-debug calls view-get-active-camera and
  // reads raw offset 144 (declared 148, camera-master's settings field,
  // cam-setting-data) off the result; same class and same fix as
  // cam-collision-record-save above, view-get-active-camera cast to
  // camera-master at its own point of use
  "camera-slave-debug": [
    [12, "v0", "camera-master"],
    [20, "v0", "camera-master"],
    [33, "v0", "camera-combiner"],
    [38, "v0", "camera-combiner"],
    [60, "v0", "camera-combiner"],
    [189, "v0", "camera-combiner"]
  ],
  // engine-quick-tier-6: camera-fov-frame reads a fixed VU-memory address
  // (416 + 0x70000000) as a 128-bit quad, the identical raw-offset-plus-
  // 0x70000000 shape cam-line-dma's own existing casts above already cover
  // (its own ops 32/36/45/50, all forced to vector); same fix here
  "camera-fov-frame": [
    [99, "a0", "vector"],
    [144, "a0", "vector"],
    [185, "a0", "vector"],
    [40, "a2", "cam-dbg-scratch"],
    [41, "a3", "cam-dbg-scratch"],
    [46, "a1", "cam-dbg-scratch"]
  ]
}
