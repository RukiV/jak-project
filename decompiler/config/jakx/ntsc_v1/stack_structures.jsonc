{
  // (method 14 hud-effect-emit-score-icon), hud-and-levels-misc rung: sp+16
  // is filled by two sequential swc1 float stores at +0/+4 (an item's own
  // position-x/position-y cast to float) then passed straight through to
  // create-points-icon-from-screen-pos as its vector2 arg; the raw stack
  // address's own type never resolved on its own ("Failed to guess stack
  // use for 16").
  "(method 14 hud-effect-emit-score-icon)": [[16, "vector2"]],
  // (method 10 race-state), hud-and-levels-misc rung: sp+16 is written at
  // offset 8 (a (pointer process), from-handle), 64 (the 'race-deactivate
  // message symbol) and 68 (num-params, zeroed), then passed to
  // send-event-function as its event-message-block arg; the raw stack
  // address's own type never resolved on its own ("Failed to guess stack
  // use for 16").
  "(method 10 race-state)": [[16, "event-message-block"]],
  // (method 9 plane-volume): sp+16 through sp+96 (stride 16, six slots) are each
  // zeroed by their own quad store before the plane-corner loop starts, then indexed
  // by veccross/vector-float*! results keyed off s3 (0-5), matching a six-corner
  // scratch array for the volume's polytope intersection points; sized to the exact
  // span zeroed, same shape as (method 136 vehicle)'s three-vector array below.
  // col-rend-draw: sp+16 is a full matrix, matching jak3's twin
  // (goal_src/jak3/engine/collide/collide-debug.gc:70), (new 'stack-no-clear
  // 'matrix) exactly: rvec (+0) copied from the camera matrix and renormalized,
  // uvec (+16) filled per-triangle by vector-3pt-cross!, fvec (+32) used for the
  // show-normals? debug vector average. A two-vector declaration only resolved the
  // first two fields and still failed on the fvec access at +32 ("add failed:
  // vector <integer 32>", a vector is not itself pointer-arithmetic-capable the way
  // a matrix's own field offsets are).
  "col-rend-draw": [
    [16, "matrix"]
  ],
  "(method 9 plane-volume)": [
    [16, "vector"],
    [32, "vector"],
    [48, "vector"],
    [64, "vector"],
    [80, "vector"],
    [96, "vector"],
    [112, "vector"],
    [128, "vector"]
  ],
  // (method 71 construction-object): rigid-body-object's own shared body,
  // fills a large stack block at sp+80 whose offsets, all traced against
  // this rung's own scoped decode, land exactly on collide-query's declared
  // fields: +88/+92 (ignore-process0/1, stores this and #f), +96
  // (ignore-pat-s32, 0x9000011), +100 (collide-with-s32, 1601), +208
  // (start-pos, a quad copy of rbody's own position), +224 (move-dist, a
  // vector-float*! of rbody's lin-velocity by the process clock's
  // seconds-per-frame), +268 (radius), +352 (action-mask, 1). No other
  // structure in the corpus matches all seven offsets at once.
  "(method 71 construction-object)": [[80, "collide-query"]],
  // (method 18 hud-item-group), net-hud rung: sp+16 is filled with four
  // sequential swc1 float stores at +0/+4/+8/+12 (position-x/position-y/
  // width/height cast to float) then passed straight through to
  // hud-item-method-18 as its vector arg; the raw stack address's own type
  // never resolved on its own ("add failed: <uninitialized> <integer 0>").
  "(method 18 hud-item-group)": [[16, "vector"]],
  // (method 136 vehicle), rigid-vehicle rung: sp+16 is a three-vector array.
  // Slot 0 is filled by a quad load/store of arg1 (now typed vector) and is
  // further written at +4; slot 2, reached by pointer arithmetic on the
  // array base (s5 + 32), feeds a veclength (lqc2/vmul at that address).
  // Slot 1 is never read or written. Neither the array's own type
  // ("Failed to guess stack use for 16") nor the s5+32 walk ("add failed:
  // vector <integer 32>") resolve without this hint.
  "(method 136 vehicle)": [[16, ["inline-array", "vector", 3]]],
  // player-wait-control-hook, rigid-vehicle rung: sp+16 is zeroed six words
  // wide by mem-set32! then written through with a float and a byte, whose
  // own type never resolves on its own ("Failed to guess stack use for
  // 16"); sized to match the exact word count zeroed rather than a named
  // struct this rung does not have evidence for.
  "player-wait-control-hook": [[16, ["array", "uint32", 6]]],
  // check-water-level-drop / check-water-level-drop-motion (water rung): both
  // build a scratch vector at sp+16, same shape as the sp-adjust-launch family.
  "check-water-level-drop": [[16, "vector"]],
  "check-water-level-drop-motion": [[16, "vector"]],
  // (method 11 flow-control): every access to sp+80 is a 16-byte quad transfer
  // already typed flow-section by the decompiler itself; only the slot's own type
  // was unresolved.
  "(method 11 flow-control)": [[80, "flow-section"], [128, "flow-section"]],
  // (method 10 flow-control): sp+48 is initialized to #f as a not-yet-computed
  // sentinel (op 34) then later reused for two consecutive vector reads (offsets 0
  // and 16), so the plain #f type the initializer left behind cannot carry the
  // later arithmetic.
  "(method 10 flow-control)": [[48, ["inline-array", "vector", 2]]],
  // (method 91 construction-object): the else branch computes a spawn-delta
  // via vector-!2(scratch, root.trans, entity.trans) then reads the result's
  // x/y/z back through raw lq/sq and l.f, so the slot type cannot be
  // guessed; matches the sp-adjust-launch family's own vector scratch shape.
  "(method 91 construction-object)": [[16, "vector"]],
  // (method 92 construction-object): quad-copies *construction-glow-template*
  // (a sprite-glow-data, per simple-sprite-system's own add! signature that
  // the tail call resolves to) into sp+16, then vector-matrix*!s a joint-
  // offset vector through node-list's own joint 0 bone transform into a
  // second scratch vector immediately after it at sp+80 (16 bytes, 64 past
  // the sprite-glow-data's own start).
  "(method 92 construction-object)": [
    [16, "sprite-glow-data"],
    [80, "vector"]
  ],
  // canyon-obs (event idle can-leaves-floor): builds a joint transform in a
  // stack slot with four raw lq/sq quad copies (a 64-byte node transform,
  // read from the sender's node-list cspace at op 43-49), same shape as the
  // sp-adjust-launch family below; the type is matrix by content, not by any
  // guessable store pattern.
  "(event idle can-leaves-floor)": [[16, "matrix"]],
  // spargus-obs: standard send-event-function stack scratch, same shape as
  // (method 25 level)/(method 10 cam-setting-data) above.
  "(exit idle spar-lighthouse-light)": [[16, "event-message-block"]],
