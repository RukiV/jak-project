  "(method 115 v-falcon)": [[16, "quaternion"], [32, "quaternion"]],
  "(method 115 v-leopard)": [[16, "quaternion"], [32, "quaternion"]],
  "(method 115 v-mongoose)": [[16, "quaternion"], [32, "quaternion"]],
  "(method 115 v-wolf)": [[16, "quaternion"], [32, "quaternion"]],
  "(method 115 v-wombat)": [[16, "quaternion"], [32, "quaternion"]],
  "(method 115 v-bear)": [[16, "quaternion"], [32, ["inline-array", "quaternion", 3]]],
  "(method 115 v-bobcat)": [[16, "quaternion"], [32, ["inline-array", "quaternion", 3]]],
  "(method 115 v-gila)": [[16, "quaternion"], [32, ["inline-array", "quaternion", 3]]],
  "(method 115 v-panther)": [[16, "quaternion"], [32, ["inline-array", "quaternion", 3]]],
  "(method 115 v-possum)": [[16, "quaternion"], [32, ["inline-array", "quaternion", 3]]],
  "(method 115 v-snake)": [[16, "quaternion"], [32, ["inline-array", "quaternion", 3]]],
  "(method 115 v-tiger)": [[16, "quaternion"], [32, ["inline-array", "quaternion", 2]]],
  "(method 115 wcar-base)": [[16, ["inline-array", "quaternion", 3]]],
  // texture-anim leg: the four interpolated matrices (rvec/uvec/fvec/trans quads
  // built via matrix-rotate-z!/matrix-scale!/matrix*!) live in stack slots the
  // decompiler cannot type-guess from lqc2/sqc2 alone; same slots jak3 hints
  "texture-anim-layer-draw": [
    [16, "matrix"],
    [80, "matrix"],
    [144, "matrix"],
    [208, "matrix"]
  ],
  // mem-buffer's level-bounding-box-method-9 builds a min/max corner pair on the
  // stack (s4-0 = sp+16) before feeding both halves to vector-min!/vector-max!; the
  // stores write x/y/z at s4-0+0/4/8 then s4-0+16/20/24, two adjacent 16-byte
  // vectors. A pair of separate [16,"vector"]/[32,"vector"] entries resolves the
  // reads (vector-min!/vector-max! take typed pointers fine) but leaves the second
  // half's stores unresolved: (s.f! (+ s4-0 16) ...) computes its address relative
  // to the named s4-0 local, 16 bytes past a type the decompiler declared exactly
  // 16 bytes wide, so it never matches the second absolute-offset hint. Declaring
  // the whole 32-byte span as one inline-array of 2 vectors fixes both: s4-0
  // becomes array-typed, the second half's stores render as (-> s4-0 1 x/y/z), and
  // this resolves the object's last marker (a stack-use guess failure at op 37);
  // scoped decode is zero-error.
  "(method 9 level-bounding-box)": [
    [16, ["inline-array", "vector", 2]]
  ],
  // (method 39 nav-mesh) and (method 41 nav-mesh), nav rung: both build a ping-pong
  // pair of vector-sized scratch buffers at sp+16/sp+32, then keep raw pointers to
  // whichever buffer is "current" at sp+48/sp+52 (a daddiu of each buffer's own
  // address, stack-stored right after). Both buffers are pointer-taken directly by
  // their own absolute offset (daddiu sp, 16 and daddiu sp, 32), never through
  // array-element arithmetic off a shared base, so a single inline-array hint only
  // resolves the first slot; the second still reads "Failed to guess stack use for
  // 32". Two independent vector entries resolve both, and the final indirect load
  // in each function ("Could not figure out load: (set! v1 (l.q v1))") clears too.
  "(method 39 nav-mesh)": [
    [16, "vector"],
    [32, "vector"]
  ],
  "(method 41 nav-mesh)": [
    [16, "vector"],
    [32, "vector"]
  ],
  // nav-mesh-editor debug-command family (nav rung): all four build an
  // event-message-block at sp+16 (process at +8, message symbol at +64,
  // param count at +68), then hand it to send-event-function; same shape as
  // (exit idle spar-lighthouse-light) above.
  "nav-mesh-editor-rotate-y": [[16, "event-message-block"]],
  "nav-mesh-editor-translate": [[16, "event-message-block"]],
  "nav-delete": [[16, "event-message-block"]],
  "nav-mesh-editor-new": [[16, "event-message-block"]],
  // nav-state family (nav rung, nav-control object): each builds a plain
  // vector scratch at sp+16 via a raw lq/sq quad copy, same shape as the
  // sp-adjust-launch family; verified directly in (method 37 nav-state) (op
  // 53 does daddu a0, v1(sp+16), a1=(-> this <field> 112) quad, sq into a0).
  "(method 37 nav-state)": [[16, "vector"]],
  "(method 32 nav-state)": [[16, "vector"]],
  "(method 34 nav-state)": [[16, "vector"]],
  "(method 24 nav-state)": [[16, "vector"]],
  "(method 11 nav-state)": [[16, "vector"]],
  "(method 53 nav-state)": [[16, "vector"]]
}
