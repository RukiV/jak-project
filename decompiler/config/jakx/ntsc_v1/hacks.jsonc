  // Sometimes the game might use format strings that are fetched dynamically,
  // for example using the game text lookup method
  // Add information about those format instructions here.
  // e.g. "function-name":[[op, argc], [op, argc], ...]
  // where "op" is the op number for the call to format.
  // (method 16 sabotage-sequence): the format string itself (s2) comes from
  // a game-text-info lookup a few ops earlier (op 61's own call target
  // signature is (function game-text-info object object string)), not a
  // literal, so the decompiler cannot count its own ~-directives; op 63's
  // own (set! a2 1) is the real arg count, one value.
  "dynamic_format_arg_counts": {
    "(method 16 sabotage-sequence)": [[66, 1]]
  },
