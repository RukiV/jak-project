    "(method 16 sparticle-launch-control)": [25, 35, 36, 48, 62, 65, 100, 102],
    // sprite family: jak3's seeds, to verify against the jakx CFG (#53 slice 3)
    "sprite-draw-distorters": [4, 5],
    "(method 10 simple-sprite-system)": [0],
    // foreground-emerc deliberately has no entry, matching jak3. Forcing every
    // branchy block to asm does resolve the CFG, but conversion then dies on a
