{
  ////////////////////////////
  // HACKS and ASM FUNCTIONS
  ////////////////////////////
  "types_with_bad_inspect_methods": ["game-task-event", "game-task-control"],
  // (method 82 rigid-body-object): the raw machine code reads two more
  // registers (a3, t0) than the currently-declared two-arg signature
  // provides, matching jak3's attack-handler (slot 50, +32 shift) at four
  // args, but construction-obs-h.gc's already-landed override tail-calls
  // this base with only two explicit args and method-of-type calls are
  // arity-checked at compile time, so the signature cannot widen without
  // touching that file in the same change (rigid-body-object rung, held
  // pending a coordinated fix; see this rung's report). With type analysis
  // left on, the leftover unresolved a3/t0 reads make the decompiler abort
  // this whole object once every other function's errors clear; skipping
  // analysis here keeps the rest of the object decoding.
  // (method 210 wvehicle), (method 211 wvehicle), (method 62 wvehicle) and
  // (method 216 wvehicle): a related cluster of debug/network telemetry
  // methods, most writing into a shared fixed scratchpad address
  // (0x70002000) at offsets past 500 bytes, arg1/arg2 typed "object"
  // throughout since neither this rung's own scoped decode nor a quick
  // corpus check turned up a declared type wide enough to cover the
  // observed offsets (528+ in method 210 alone). (method 62 wvehicle) also
  // reads a plain float off wvehicle's own self pointer at offset 720, a
  // field this rung's own scoped decode of wvehicle-physics.gc did not
  // otherwise need and wvehicle's own field list does not yet declare in
  // that region. Resolving the scratchpad buffer's real layout and
  // wvehicle's own field gap are both bigger derivations than this rung's
  // band covers (rigid-body-small-tier rung, held; see the report).
  // (method 212 wvehicle) forwards the same scratchpad constant into
  // (method 211 wvehicle) and is landed with a narrow type_casts.jsonc
  // entry instead, since its own failing ops are a single self-contained
  // quad copy, not part of the wider buffer-layout gap.
  // (method 249 wvehicle), (method 236 wvehicle) and (method 235 wvehicle):
  // the same class as the wvehicle debug/telemetry cluster above, each its
  // own multi-vector stack (and, for method 249, a second fixed scratchpad
  // region at 0x70003000 distinct from 0x70002000) whose full layout is a
  // bigger derivation than this rung's band covers (rigid-body-small-tier
  // rung, held; see the report).
  "no_type_analysis_functions_by_name": [
    "(method 82 rigid-body-object)",
    "(method 210 wvehicle)",
    "(method 211 wvehicle)",
    "(method 62 wvehicle)",
    "(method 216 wvehicle)",
    "(method 249 wvehicle)",
    "(method 236 wvehicle)",
    "(method 235 wvehicle)"
  ],
  // this limits the number of cases in a cond.  The first argument is the name of the function.
  // the second argument is the name of the first condition in the cond. Use print_cfg to find it out.
  // The third argument is the number of cases. If you set it too small it may fail to build the CFG.
  "cond_with_else_max_lengths": [
    ["(method 20 res-lump)", "b0", 2],
    ["(method 11 res-lump)", "b0", 1],
    ["(method 12 res-lump)", "b0", 1]
  ],
  // if a cond with an else case is being used a value in a place where it looks wrong
  // you can add the function name to this list and it will more aggressively reject this rewrite.
  "aggressively_reject_cond_to_value_rewrite": [
    "(method 10 res-lump)",
    "(method 11 res-lump)",
    "(method 12 res-lump)"
  ],
  // this provides a hint to the decompiler that these functions will have a lot of inline assembly.
  // currently it just leaves pcpyld as an asm op.
  "hint_inline_assembly_functions": [],
  "asm_functions_by_name": [
    // checking boxed type is different now - these make the cfg stuff sad
    "name=",
    // disabled to get decomp to work
    "water-anim-event-handler",
    // "(anon-function 55 task-control)" was a jak2 carryover: jakx's task-control has
    // anons 31/32/43 only (the borrow lambda is 43) and nothing here matched (#116)
    "(method 22 level)",
    "(method 11 medius-cache)",
    "(method 13 race-line)",
    "(method 11 collide-mesh)",
    // dma
    "symlink2",
    // ocean VU/asm family (jak3 parity; a later leg gives them mips2c)
    "init-ocean-far-regs",
    "draw-large-polygon-ocean",
    "render-ocean-quad",
    // ocean.o debug-segment PS2 memory benchmarks (jak3 parity)
    "test-to-from-spr",
    "test-from-spr",
    "test-to-spr",
    "test-seq-read",
    "test-worst-read",
    "test-seq-write",
    "test-worst-write",
    // actual asm
    "(method 17 bounding-box)",
    "quad-copy!",
    "sin-rad",
    "cos-rad",
    "atan-series-rad",
    "sign-float",
    "(method 9 matrix)",
    "quaternion->matrix-2",
    "vector-rotate-y-fast!",
    "(method 11 collide-mesh-cache)",
    "dma-count-until-done",
    // texture: jakx-only CFG failure (jak3's version decompiled; jakx codegen differs), parked as asm
    "(method 9 texture-page-dir)",
    // find-free-eye-index: jakx-only codegen difference from jak3's own clean
    // decompile (goal_src/jak3/engine/gfx/foreground/eye.gc:60), an
    // "Unsupported inline assembly instruction kind - [movz v1, v1, a0]"
    // conditional-relocate the decompiler cannot convert to atomic ops, the
    // same idiom this file's own mips2c_functions_by_name entries document
    // for the nav-engine pointer-relocation family; parked as asm rather than
    // mips2c since the rest of the function (index scan, level-index compare)
    // decompiles cleanly and mips2c_table.cpp carries no jakx registration to
    // land a live def-mips2c against.
    "find-free-eye-index",
    // net-mgr-dme: once the jakx (suspend) pattern matched (process_offset 56), these
    // reach cfg_builder and trip its irb assert; network code, parked for bring-up
    "get-host-by-name",
    "(anon-function 11 net-mgr-dme)",
    "get-current-room-name-and-info",
    // jak3 also asm-funcs this and hand-writes the GOAL replacement in texture.gc
    "adgif-shader<-texture!",
    // (method 11 garage-tool-arm): the whole body past the entry block is an
    // unconditional "beq r0, r0" straight to the epilogue, so the entity-init
    // block after it is unreachable in this binary; atomic-op conversion
    // fails inside that dead block regardless ("Variable could not be
    // constructed from register r0"), a step earlier than type prop, so no
    // type_casts entry can reach it. Parked as asm; the only live behavior
    // is the vmethod call in the entry block before the branch.
    "(method 11 garage-tool-arm)",
    // (method 52 garage-turntable): calls *lobby-menu-manager* method 190,
    // declared "(_type_) none" in all-types.gc, then calls method 111 on
    // its result after a #f-check, so 190's real return is some real object
    // type, not none; no jak3 twin exists for this network-lobby type and
    // no other call site in this band gives evidence for which type. Also
    // hits a separate "Failed to guess stack use for 80" error. Parked as
    // asm; retyping method 190's return without evidence would be a guess,
    // and lobby-menu-manager typing is its own campaign, out of this band's
    // scope.
    "(method 52 garage-turntable)",
    // (code running end-credits-character-viewer), internal name
    // (anon-function 6 credits-obs): asm_functions_by_name is consulted
    // before state-handler recognition renames the function, so the
    // internal name is the key that actually matches here, unlike
    // type_casts/stack_structures entries which are looked up after the
    // rename. A large (400+ op) function that decodes cleanly up through
    // spawning an AI vehicle for the credits camera; the remaining
    // blocker is traffic-object-spawn-params, a 104-byte struct
    // (mem-clear!'d then hand-filled field by field before vehicle-spawn)
    // that is not declared anywhere in all-types.gc and belongs to the
    // vehicle-spawn subsystem, not this band. Parked as asm; referenced
    // only through the state machinery (defstate's own :code slot),
    // never embedded inline as data, so parking is safe.
    "(anon-function 6 credits-obs)",
    // powerup-draw-method-53 (time-freeze-short-draw/long-draw/med-draw
    // overrides): raw, unconverted register dump; a1/a2 are declared
    // generic object per all-types.gc with no call-site evidence in this
    // band for their real types (no caller of this method decodes within
    // time-box-obs itself), so retyping them would be a guess. Parked as
    // asm; referenced only through the type's own vtable dispatch, never
    // embedded inline as data.
    "(method 53 time-freeze-short-draw)",
    "(method 53 time-freeze-long-draw)",
    "(method 53 time-freeze-med-draw)",
    // powerup-draw-method-54 (same three overrides): a large part-tracker/
    // debris-spawn handler; adding the missing _type_ arg0 (all-types.gc)
    // got it much further (op 5 to op 94) but it still fails on a 112-byte
    // stack structure and a process root-field read this band has no
    // further evidence for (a vehicle-handle uint64 -> handle retype was
    // tried and made no difference, reverted). Parked as asm.
    "(method 54 time-freeze-short-draw)",
    "(method 54 time-freeze-long-draw)",
    "(method 54 time-freeze-med-draw)",
    // net-powerup-method-50/52 (time-freeze-short override, inherited by
    // time-freeze-long/med): raw, unconverted; a1/a2 declared generic
    // object per all-types.gc (method 50) and method 52's declared single
    // process-tree arg does not account for the a2 register the body
    // actually reads, with no in-band call-site evidence for either.
    // Parked as asm.
    "(method 50 time-freeze-short)",
    "(method 52 time-freeze-short)",
    // kras-pump-break-proxy-method-61/62: both read at least one arg
    // beyond a widened (object object) guess before failing further in;
    // method 62 additionally regressed from a type-prop error to a full
    // CFG failure under a rigid-body-impact retype for its one declared
    // arg (tried and reverted, despite the arg's offset-48 float load
    // being an exact match for rigid-body-impact's own impulse field),
    // so something about this pair resists the type_casts/all-types.gc
    // route with the evidence available in this band. Parked as asm.
    "(method 61 kras-pump-break-proxy)",
    "(method 62 kras-pump-break-proxy)",
    // train-obs: six free functions with zero in-band call-site evidence
    // for their signatures (every caller also failed to decode, since
    // they cascade off the same unresolved chain), all left as bare
    // `function` externs in the pre-authored reservoir. Parked as asm
    // rather than guessed at.
    "train-car-init-by-other",
    "train-car-spawn",
    "position-train-car",
    "train-move",
    "cars-spawn",
    "play-horn",
    // (method 10 train): overrides deactivate; a2 loaded straight from a0
    // (this) with no resolvable field evidence for what it reads.
    "(method 10 train)",
    // (method 71 train): the quaternion-look-at!/quaternion->matrix
    // compound stack shape is declared (stack_structures.jsonc) but the
    // arithmetic itself still fails ("add failed: quaternion <integer
    // 64>"), the same class already fixed by hand for peak-obs but with
    // no in-band op-level evidence here for which casts to add without
    // risking the same silent-corruption failure mode already hit once
    // in this band (peak-obs's rbody-collision root cast).
    "(method 71 train)",
    // (method 66 train): full CFG failure, no error detail to act on.
    "(method 66 train)",
    // end-end-credits: reads *end-credits-proc* (handle) through a raw
    // doubleword load off its own symbol-slot address with no in-band
    // evidence for the surrounding stack shape.
    "end-end-credits",
    // title-control-init/title-control-spawn/draw-language-select: each
    // decodes to seemingly complete GOAL text ("may read a0" was the only
    // decode-time flag) but fails real compilation with a raw label leak
    // (an unresolved anon-function, e.g. L215 in title-control-init's
    // dma-get-named-buffer call) or return-type mismatches that trace back
    // to the same unresolved inner lambda; parked as asm.
    "title-control-init",
    "title-control-spawn",
    "draw-language-select",
    // desarena-obs: desarena-activate/deactivate never decoded at all
    // ("no type analysis"), no in-band call-site evidence (nothing in
    // this object calls them; they are level-hook functions referenced
    // from elsewhere, out of this band's scope).
    "desarena-activate",
    "desarena-deactivate",
    // palm-tree's own methods 11/52/54/55: all raw, unconverted register
    // dumps reading a1/uninitialized locals with no traceable source
    // (method 55: "add failed uninitialized integer 16" plus a stack-use
    // guess failure; method 54: raw l.q load; method 11 and 52: fully
    // unconverted). method 52 is called from (post idle palm-tree), which
    // still resolves fine against a parked method's decoder-generated
    // stub body.
    "(method 11 palm-tree)",
    "(method 52 palm-tree)",
    "(method 54 palm-tree)",
    "(method 55 palm-tree)",
    // palm-tree-a/b/c's own method 35 and 54 overrides (six total): the
    // same "may read a1 not set" pattern as the base type's method 54
    // (a1 is very likely a vector impact-velocity/direction argument, but
    // no in-band evidence pins the exact signature since every one of
    // these bodies reads it uninitialized rather than receiving it as a
    // declared param).
    "(method 35 palm-tree-a)",
    "(method 54 palm-tree-a)",
    "(method 35 palm-tree-b)",
    "(method 54 palm-tree-b)",
    "(method 35 palm-tree-c)",
    "(method 54 palm-tree-c)"
  ],
