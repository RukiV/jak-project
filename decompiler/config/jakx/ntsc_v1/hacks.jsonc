  // this limits the number of cases in a cond.  The first argument is the name of the function.
  // the second argument is the name of the first condition in the cond. Use print_cfg to find it out.
  // The third argument is the number of cases. If you set it too small it may fail to build the CFG.
  "cond_with_else_max_lengths": [
    ["(method 20 res-lump)", "b0", 2],
    ["(method 11 res-lump)", "b0", 1],
    ["(method 12 res-lump)", "b0", 1]
  ],
  // if a cond with an else case is being used a value in a place where it looks wrong
  // you can add the function name to this list and it will more aggressively reject this rewrite.
  "aggressively_reject_cond_to_value_rewrite": [
    "(method 10 res-lump)",
    "(method 11 res-lump)",
    "(method 12 res-lump)"
  ],
  // this provides a hint to the decompiler that these functions will have a lot of inline assembly.
  // currently it just leaves pcpyld as an asm op.
  "hint_inline_assembly_functions": [],
  "asm_functions_by_name": [
    // (method 10 rigid-body-queue): the per-frame physics tick, called from
    // rigid-body-queue-manager's idle :post. Inlines process<->handle
    // conversion three times (once per loop) via a raw "sllv reg, reg, r0"
    // triple the decompiler's macro matcher does not recognize (the exact
    // idiom already hand-folded elsewhere in this tree, see generic-obs.gc's
    // 'mirror case and rigid-body-debug.gc), which here also blocks the type
    // prop needed to resolve a downstream rigid-body-flag bitfield read
    // (offset 228, an undefined-enum raw uint16 with no landed bit constants
    // to fold against). Parked as asm rather than hand-folded like the
    // simpler rigid-body-queue methods in this same rung: this body needs a
    // process-drawable cast plus an unverified bitfield mask, out of this
    // rung's evidence.
    "(method 10 rigid-body-queue)",
    // plow rung (levels-other-tier-3): launch-nearby-players, do-launch and
    // (method 74 plow) each inline the same process<->handle sllv/dsra32
    // idiom as (method 10 rigid-body-queue) above, reading a ragdoll/attack-
    // handle field at a raw offset (4516 from a net-player pointer, 228 from
    // an unconfirmed net-entity pointer) past any type this rung could
    // declare that types2's own reverse_field_multi_lookup resolves
    // (decompiler/types2/ForwardProp.cpp's "Could not figure out load" is
    // thrown inside types2's own forward pass, before type_casts.jsonc ever
    // gets consulted; type_casts.jsonc entries only patch the post-hoc
    // conversion back to the old TypeState format, so no cast here can
    // change types2's own verdict). Every earlier part of each function
    // (the *net-players*/*active-net-non-spectators* walks, the method-49/22
    // dispatches, the vector-!2/quaternion-axis-angle! stack scratch) is
    // fixed via type_casts.jsonc/stack_structures.jsonc and left in place;
    // only this one recurring idiom is unfixable from config, so all three
    // functions are parked whole.
    "launch-nearby-players",
    "do-launch",
    "(method 74 plow)",
    // (method 11/13/15 rigid-body-queue): the same inlined handle<->process
    // triple as method 9 above, but here it breaks CFG resolution outright
    // ("CFG building failed", no expression tree at all) even after the
    // same object->process retype that let method 9 decode clean; measured
    // by reverting the asm-park and re-decoding, still red. Not on the
    // vehicle-manager boot chain this rung is landing (rigid-body-queue-
    // manager's idle :post only calls method 10); parked rather than
    // hand-written from the jak3 twin blind, since this rung has no
    // rendered jakx expression tree to check field offsets against.
    "(method 11 rigid-body-queue)",
    "(method 13 rigid-body-queue)",
    "(method 15 rigid-body-queue)",
    // checking boxed type is different now - these make the cfg stuff sad
    "name=",
    // disabled to get decomp to work
    "water-anim-event-handler",
    // explosion rung: both read cleanly narrowed root/vehicle/net-enemy/
    // attack-info fields for their FIRST few occurrences (fixed via
    // type_casts.jsonc, see the "explosion band" comment there), but each
    // repeats the same friendly-fire attack-info-plus-net-player-handle
    // idiom multiple times per function, and every config fix here shifts
    // every later op index in the same function, so chasing the next
    // occurrence kept landing the next type_casts entry on a stale op.
    // Parked as asm rather than churn indefinitely; each still compiles
    // and links, so explosion's own touch dispatch is not affected.
    "explosion-handle-touch-without-ccheck",
    "explosion-handle-touch-with-ccheck",
    // explosion's own explode state :event handler: everything up through
    // op 394 (the same friendly-fire attack-info-plus-net-player-handle
    // idiom as the two functions above, fixed the same way in
    // type_casts.jsonc) resolves cleanly, but the second attack-info's
    // attacker-velocity quad copy at op 395 (structurally identical to the
    // first attack-info's own copy at op 212, which resolves fine) hard-
    // regresses dozens of unrelated stores elsewhere in the function the
    // moment ANY cast (tried v1 and s2, tried (pointer uint128) and
    // vector) touches that op, independent of which register or type;
    // isolated by adding and removing one cast at a time. Same
    // asm-plus-named-extern shape as water-anim-event-handler
    // (goal_src/jakx/engine/common-obs/water-anim.gc), not the anonymous
    // asm_functions_by_name treatment above, because a defstate's :event
    // slot cannot hold a raw label the way a free function's decompile
    // fallback can: see explosion-explode-event-handler below.
    "(anon-function 3 explosion)",
    // raptor rung: four of its defstate slots ((code startup raptor),
