    // caller invariant), so the REF records the unconverted state and goal_src
    // hand-writes the PC version, exactly as jak3 does.
    "(method 9 curve-color-fast)": [0, 1],
    "evaluate-color-curve-fast": [0, 1],
    "sqlpipe-query": [21],
    "(method 9 editable-region)": [63],
    "find-nearest-entity": [7, 9],
