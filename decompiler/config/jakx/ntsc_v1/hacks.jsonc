    "moving-sphere-triangle-intersect",
    "collide-do-primitives",
    // collide-hash (jak2/jak3 set; not previously promised, found by a scoped decode)
    "(method 11 collide-hash)",
    "(method 12 collide-hash)",
    "fill-bg-using-box-new",
    "fill-bg-using-line-sphere-new",
    // collide-probe (jak1 set; CFG). Both are VU0 microcode launchers (collide-vu0-block);
    // the mips2c pass itself still rejects them on the pref/vcallms opcodes (unregistered,
    // matching main-collide's vitof12 gap), but the asm_functions_by_name entry alone lets
    // the rest of the object's plain GOAL decode independent of these two.
    "collide-probe-instance-tie",
    "collide-probe-node",
    // main-collide's own vitof12 gap named above, corrected: plain GOAL decode resolves
    // the VU0 sphere transform's first quadword read as (-> arg1 origin vector4h long)
    // instead of the flat (-> arg1 origin long 0) its jak3 twin uses (both are the same
    // byte offset; matrix4h's vector4h and long fields tie at offset 0 and the tie breaks
    // differently here), which goalc rejects as an unresolved symbol lookup on `long`.
    // Flagging it here (unlike collide-probe's pref/vcallms pair above) lets the mips2c
    // pass actually succeed on the vitof12/VU macro ops and auto-generate a def-mips2c
    // scaffold, but no jakx C++ mips2c port for it exists or is added by this change, so
    // the landed source keeps the declaration commented out (bones-mtx-calc precedent)
    // rather than shipping a def-mips2c with nothing behind it at kernel link.
    "instance-sphere-box-intersect?",
    // bones. Hand-scheduled PS2 assembly: six bare backward gotos, two back edges into a
    // single loop head, and real work in five branch delay slots. The CFG cannot be
    // resolved and no GOAL syntax expresses it. Config only, with no C++ implementation,
    // matching jak3, which carries the same entry and ships no bones.cpp.
    "bones-mtx-calc",
    // foreground
    "foreground-check-longest-edge-asm",
    "foreground-merc",
    // jak3 parity: hand-scheduled, shipped as mips2c there too
    "foreground-generic-merc",
    // generic-merc: the mercneric pipeline, jak3's exact set (#57)
    "generic-merc-init-asm",
    "mercneric-convert",
    "high-speed-reject",
    "generic-translucent",
    "generic-merc-query",
    "generic-merc-death",
    "generic-merc-execute-asm",
    "generic-merc-do-chain",
    // jakx generic-merc also carries jak1's three mercneric helpers (#57)
    "mercneric-bittable-asm",
    "mercneric-shader-asm",
    "mercneric-matrix-asm",
    // generic-effect: the support family the pipeline calls into, jak3's exact
    // set; generic-light-proc moved here from asm_functions_by_name (#57)
    "generic-light-proc",
    "generic-envmap-proc",
    "generic-prepare-dma-double",
    "generic-prepare-dma-single",
    "generic-warp-source-proc",
    "generic-warp-dest-proc",
    "generic-warp-dest",
    "generic-warp-envmap-dest",
    "generic-no-light-proc",
    // jakx generic-effect is a two-era hybrid: jak3's entry points above plus
    // jak1's whole hand-scheduled proc family below, treated as jak1 treats
    // them, mips2c. upload-vu0-program included per jak1 (its type prop fails
    // on the vu-function header load otherwise) (#57)
    "generic-debug-light-proc",
    "generic-none-dma-wait",
    "generic-copy-vtx-dclr-dtex",
    "generic-light",
    "generic-envmap-only-proc",
    "generic-no-light",
    "generic-no-light+envmap",
    "generic-no-light-dproc-only",
    "generic-no-light-dproc",
    "generic-interp-dproc",
    "generic-envmap-dproc",
    "generic-dma-from-spr",
    "upload-vu0-program",
    "foreground-draw-hud",
    // merc-blend-shape
    "blerc-a-fragment",
    "blerc-execute",
    // font: hand-optimized asm, same treatment as jak3's draw-string-asm
    "draw-string-asm-packed",
    "draw-string3d-asm",
    "get-string-length-asm",
    "draw-string-init-justify",
    // debug: line-clip, jak2/jak3 parity, unresolved at boot link before this leg (#174)
    "debug-line-clip?"
  ],
  "mips2c_jump_table_functions": {},
  // there are some missing textures. I don't know what the game actually does here.
  // the format for entries is [level, tpage, index]
  "missing_textures": [],
  // some object files have garbage pad data at the end which makes the decompiler
  // assume they must be different files, such as the art group for orb-cache-top.
  // this just suppresses a message.
  "expected_merged_objs": []
}
