    ["L8", "(pointer uint8)", 512],
    ["L7", "(pointer uint8)", 512],
    ["L6", "(pointer uint8)", 100],
    ["L5", "(pointer uint8)", 160],
    ["L4", "(pointer uint8)", 160],
