    ["L70", "(pointer uint32)", 256],
    ["L69", "(pointer uint32)", 256],
    ["L68", "(pointer uint32)", 256],
    ["L72", "(pointer uint32)", 12]
  ],
  "sprite": [["L52", "dma-packet"]],
  // sprite-glow L27 is the add-shader-to-dma carve-hole next-tag template (jak3 parity, #53 slice 3)
  "sprite-glow": [["L27", "dma-packet"]],
  "headset-h": [
    ["L8", "(pointer uint8)", 512],
    ["L7", "(pointer uint8)", 512],
    ["L6", "(pointer uint8)", 100],
    ["L5", "(pointer uint8)", 160],
    ["L4", "(pointer uint8)", 160],
    ["L3", "(pointer int8)", 4]
  ],
  "kras-part": [["L137", "(pointer rgba)", 8]],
  "gsound": [
    ["L356", "(array symbol)", true],
    ["L383", "(array array)", true]
  ],
  // collide-shape slice 4: send-shoves' static attack-info (mask word 0x689002 at
  // offset 88; jak3's same static was L372), m36's 4.096 x-nudge vector (jak3 L379)
  // and find-ground-point's +20480y start-pos vector
  "collide-shape": [
    ["L314", "attack-info"],
    ["L321", "vector"],
    ["L323", "vector"]
  ],
  "pad": [["L116", "(pointer uint8)", 256]],
  "main": [
    ["L564", "uint128", true],
    ["L572", "(pointer uint64)", 2]
  ],
  "font": [["L474", "(pointer uint64)", 1]]
}
