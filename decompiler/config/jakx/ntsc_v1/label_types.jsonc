  // daxter: *animation-adjust* position/offset vector (0.0, -200.3, 0.0, 1.0), address-taken directly
  "daxter": [["L222", "vector"]],
  // every wcar's method 100: seven static vector labels each, paired with the
  // (method 100 v-<car>) root-prim casts in type_casts.jsonc
  "wcar-bear": [["L102", "vector"], ["L101", "vector"], ["L100", "vector"], ["L99", "vector"], ["L98", "vector"], ["L97", "vector"], ["L96", "vector"]],
  "wcar-bobcat": [["L102", "vector"], ["L101", "vector"], ["L100", "vector"], ["L99", "vector"], ["L98", "vector"], ["L97", "vector"], ["L96", "vector"]],
  "wcar-cheetah": [["L101", "vector"], ["L100", "vector"], ["L99", "vector"], ["L98", "vector"], ["L97", "vector"], ["L96", "vector"], ["L95", "vector"]],
  "wcar-cougar": [["L101", "vector"], ["L100", "vector"], ["L99", "vector"], ["L98", "vector"], ["L97", "vector"], ["L96", "vector"], ["L95", "vector"]],
  "wcar-daxtermobile": [["L101", "vector"], ["L100", "vector"], ["L99", "vector"], ["L98", "vector"], ["L97", "vector"], ["L96", "vector"], ["L95", "vector"]],
  "wcar-drone": [["L36", "vector"], ["L35", "vector"], ["L34", "vector"], ["L33", "vector"], ["L32", "vector"], ["L31", "vector"], ["L30", "vector"]],
  "wcar-falcon": [["L101", "vector"], ["L100", "vector"], ["L99", "vector"], ["L98", "vector"], ["L97", "vector"], ["L96", "vector"], ["L95", "vector"]],
  "wcar-gila": [["L101", "vector"], ["L100", "vector"], ["L99", "vector"], ["L98", "vector"], ["L97", "vector"], ["L96", "vector"], ["L95", "vector"]],
  "wcar-leopard": [["L101", "vector"], ["L100", "vector"], ["L99", "vector"], ["L98", "vector"], ["L97", "vector"], ["L96", "vector"], ["L95", "vector"]],
  "wcar-mongoose": [["L104", "vector"], ["L103", "vector"], ["L102", "vector"], ["L101", "vector"], ["L100", "vector"], ["L99", "vector"], ["L98", "vector"]],
  "wcar-panther": [["L103", "vector"], ["L102", "vector"], ["L101", "vector"], ["L100", "vector"], ["L99", "vector"], ["L98", "vector"], ["L97", "vector"]],
  "wcar-possum": [["L103", "vector"], ["L102", "vector"], ["L101", "vector"], ["L100", "vector"], ["L99", "vector"], ["L98", "vector"], ["L97", "vector"]],
  "wcar-snake": [["L101", "vector"], ["L100", "vector"], ["L99", "vector"], ["L98", "vector"], ["L97", "vector"], ["L96", "vector"], ["L95", "vector"]],
  "wcar-tiger": [["L102", "vector"], ["L101", "vector"], ["L100", "vector"], ["L99", "vector"], ["L98", "vector"], ["L97", "vector"], ["L96", "vector"]],
  "wcar-wolf": [["L101", "vector"], ["L100", "vector"], ["L99", "vector"], ["L98", "vector"], ["L97", "vector"], ["L96", "vector"], ["L95", "vector"]],
  "wcar-wombat": [["L101", "vector"], ["L100", "vector"], ["L99", "vector"], ["L98", "vector"], ["L97", "vector"], ["L96", "vector"], ["L95", "vector"]],
  // coli-center-arch joint-exploder-tuning offset vectors: L18 is the marker the
  // census named, L17 is its immediate neighbor sharing the identical lqc2/vadd.xyz
  // shape one op later; typing only L18 just moves the same error onto L17
  "coliseum-obs": [["L18", "vector"], ["L17", "vector"]],
  // snow-dinobreak joint-exploder-tuning offset vectors: L16 is the census marker,
  // L15 its neighbor with the identical lqc2/vadd.xyz shape
  "snow-obs": [["L16", "vector"], ["L15", "vector"]],
  // level-bounding-box init: a min/max sentinel pair at offset 0/16 of a freshly
  // allocated level-bounding-box (l.q/s.q!, not lqc2, but 4-word with a trailing
  // 1.0 like every other vector literal here); L10 is the census marker, L9 is
  // the neighboring min half of the same pair. Resolves both label-use markers;
  // (method 9 level-bounding-box)'s separate stack-use marker (op 37) is now
  // fixed too (see stack_structures.jsonc's inline-array-of-2-vectors entry for
  // that method), so mem-buffer's scoped decode is zero-error. mem-buffer.gc is
  // still not landed: its sole content, level-bounding-box-method-9, needs the
  // level-bounding-box deftype in scope first, and the decompiler attributes
  // that deftype (plus methods 3/10/11) to mem-buffer-h, not mem-buffer -- a
  // real compile with (mi) fails "Type level-bounding-box is unknown" because
  // mem-buffer-h.gc is its own much larger stub (dozens of pre-existing type-
  // prop errors, out of scope for a single-marker fix) and has never landed
  // that deftype into goal_src. Signature-only for this rung.
  "mem-buffer": [["L10", "vector"], ["L9", "vector"]],
  // klever-skirtlight cloth-params: 22 words (0x58 bytes) matching cloth-params'
  // own size-assert exactly, stored as one element of the (array cloth-params)
  // at skeleton-group+112 alongside the identically-shaped L126/L124/L123/L122,
  // added here on the same evidence: each is 24 raw words between labels (96
  // bytes, cloth-params' 88-byte size-assert plus 8 bytes of the static
  // 16-byte alignment pad), field-for-field byte match against cloth-params
  // (mesh/gravity-constant/wind-constant/cloth-width/flags/tex-name x3/
  // cloth-thickness/initial-xform/drag/num-iterations+timestep-frequency),
  // and every one is stored into the same (array cloth-params) at
  // skeleton-group+112 (L126 at element offset 16, L124 at 20, L123 at 24,
  // L122 at 28, machine-adjacent to L127's element 0). L126 was the label-use
  // marker the census named; L124/L123/L122 are its siblings in the same
  // store sequence, same evidence class. Fixing all four lets the decompiler
  // reconstruct the whole thing as a real (static-cloth-params ...) macro call
  // rather than raw label stores, and the scoped decode is zero-error (the
  // remaining "failed to figure out what this is" comments in the file are all
  // defskelgroup top-level forms, the documented benign pattern). A real (mi)
  // build still fails, though, on a different and later blocker: the macro
  // expansion references klever-highres-ag, an art-group symbol nothing in
  // this compile provides (the same class of gap as an unarmed level's DGO
  // group, not a decompiler-config problem), so scene-actor.gc stays
  // signature-only this rung.
  "scene-actor": [
    ["L127", "cloth-params"],
    ["L126", "cloth-params"],
    ["L124", "cloth-params"],
    ["L123", "cloth-params"],
    ["L122", "cloth-params"]
  ],
  // *inv-init-table*: 8-element invinitdata array, matching jak3's own L178 entry
  // (decompiler/config/jak3/ntsc_v1/label_types.jsonc) and the landed hand-carry's
  // element count (goal_src/jakx/engine/gfx/generic/generic-merc.gc)
  "generic-merc": [["L178", "(inline-array invinitdata)", 8]],
  // *net-simple-destruct-indices*: 400-element int16 array, sized from the landed
  // hand-carry and the (>= *net-simple-destruct-ct* 400) bound in the same file
  // (goal_src/jakx/levels/common/net-simple-destruct.gc)
  "net-simple-destruct": [["L123", "(pointer int16)", 400]],
  // display-nice-shot-to-view's own lookup table: L119 is 8 sequential int16
  // text-ids (0x1322 through 0x1329, hud-widgets-4_ir2.asm raw words at L119),
  // indexed by (logand (rand-uint31-gen) 7), an 8-way random pick among
  // "nice shot" text variants.
  "hud-widgets-4": [["L119", "(pointer int16)", 8]],
  // intro-scenes2's top-level-login builds two new anonymous process types
  // (krasmale and a second one) via (new 'type type ...), each reading its
  // own packed method-count/size/flags argument through a far uint64 label
  // (L1142, L32-adjacent), the same class label_types.jsonc's scert-*-h
  // entries already document.
  "intro-scenes2": [["L1142", "uint64", true]],
  // top-level-login's muzzle-flash constructor call loads L920 as a full
  // doubleword (l.d) third arg; its two raw words (0x900120, 0x34) are exactly
  // muzzle-flash's own :flag-assert #x3400900120, the standard object-new
  // type-flags argument. uint64 matches the flag-assert's own width and the
  // type's glued-to field, the only other uint64 in muzzle-flash's deftype.
  "wvehicle-weapons": [["L920", "uint64"]],
  // *old-vector*: L166 is 4 raw zero words (16 bytes), exactly sizeof(vector)
  // (jakx's vector deftype, goal_src/jakx/kernel/gcommon.gc, is a plain
  // structure, not a basic, so no type tag word). top-level-login stores its
  // address into the symbol slot with a 32-bit sw, the same shape as the
  // already-landed single-instance statics (daxter's L222, foreground's L216),
  // not a pointer/array case, so no count is given.
  "wvehicle-states": [["L166", "vector"]],
  // *car-part-type-to-text-table*: top-level-login stores L1's raw address
  // (lui/ori, no allocation) into the symbol slot, the same unboxed-static
  // shape as wvehicle-weapons' L920 and wvehicle-states' L166 above. L1 runs
  // exactly 8 words (32 bytes) up to the next label with zero slack, which is
  // precisely 16 uint16 elements and no other stride divides it evenly with
  // no remainder. The 16 decoded halfwords read 1529, 1533, 1531, 1528, 1857,
  // 1530, 1534, 1532, 2754, 3401, 3769, 0, 0, 0, 0, 0: a tight band consistent
  // with text-table indices, matching the symbol's own name. No call site is
  // decoded yet to corroborate the read pattern, so the extern itself stays
  // typed `object` (goal_src, manual pointer casts at any future call site),
  // matching menumap-part's *menumap-firework-colors* treatment; this entry
  // only unblocks car-tables' top-level static recognition.
  // *car-upgrade-info*: L2 is a second raw address load in the same
  // top-level-login (lui/ori, no allocation), same shape as L1 above. Unlike
  // L1, its declared type (pointer car-upgrade-info-array) points at a plain
  // structure (not a basic), so a bare single-instance entry is correct, the
  // same pattern as wvehicle-states' L166 vector above: no array_size is
  // given because the pointed-to type IS the whole record, not an element
  // type. car-upgrade-info-array's own :size-assert (#x3c0, 960 bytes) is
  // 15 upgrade-info-array of 4 upgrade-info at a 16-byte stride, which
  // matches the machine code's own +16/+32/... pointer walk through the
  // record exactly (offline-test -f car-tables, this worktree's config).
  // goal_src landing is deferred: both fixes clear the top-level-killing
  // type-prop failure (car-tables_disasm.gc goes from an 8-line "not
  // converted to expressions" stub to ~1256 real lines), but a separate,
  // pre-existing defect remains underneath. The retail code walks
  // *car-upgrade-info* with raw pointer arithmetic (a0 = base + 16, +32,
  // ...) rather than array indexing, and the decompiler renders the
  // per-field byte stores as bare `(s.b! (+ a0-N 4) ...)`, which goalc
  // rejects ("Cannot do math on a (pointer car-upgrade-info-array)."), 240
  // occurrences across the 60 records. Tried and rejected: overriding the
  // walking variable's type via var_names.jsonc to (inline-array
  // upgrade-info) (this worktree's config, "(top-level-login car-tables)");
  // the retype only changes the let-binding's displayed type, the
  // downstream &-> calls still resolve against the original propagated
  // (pointer car-upgrade-info-array) type and recast back to it, so the
  // math error is unchanged. This needs either FormExpressionBuilder work
  // (base+constant*stride recognition cascading into inline-array
  // indexing) or ~120 individual per-record var_names overrides; out of
  // scope for a config-only rung.
  "car-tables": [["L1", "(pointer uint16)", 16], ["L2", "car-upgrade-info-array"]],

  // hud-cash: far-label uint64 flag doublewords reached via lui/ori/addu(fp),
  // same class as the scert-*-h wave above, feeding (type-new sym parent
  // flags) calls for hud-cash-stats/end-menu/cash-hud and the eight
  // no-new-field in-game-hud marker subtypes that share identical flag
  // words (L1055 covers all eight, confirmed by all eight sharing
  // :flag-assert #x21186018ec in all-types.gc's dead hud-cash blocks).
  // hud-follow-through rung, discovered via (mi) failing at "L1056 was
  // looked up as a global variable, but it does not exist."
  "hud-cash": [["L1053", "uint64", true], ["L1054", "uint64", true], ["L1055", "uint64", true], ["L1056", "uint64", true]],

  // hud-follow-through rung: same far-label uint64 flag-doubleword class as
  // hud-cash above, one entry per object; confirmed by (mi) failing on each
  // with "LXXXX was looked up as a global variable, but it does not exist"
  // and by the raw decode collapsing into un-transcribable "failed to figure
  // out what this is" soup instead of clean (deftype ...) sugar without it.
  // L1 is excluded everywhere it appears in this class of scan: it collides
  // with each object's own first function label rather than naming data
  // (proven by hud-cash's own L1 attempt: "there is a config entry for label
  // L1, but it's a function. Remove the config.").
  "hud-high-scores": [["L337", "uint64", true], ["L338", "uint64", true], ["L339", "uint64", true]],
  "hud-results-grand-prix": [["L871", "uint64", true]],
  "hud-results": [["L1482", "uint64", true], ["L1483", "uint64", true], ["L1484", "uint64", true], ["L1485", "uint64", true], ["L1486", "uint64", true], ["L1487", "uint64", true], ["L1488", "uint64", true], ["L1489", "uint64", true], ["L1490", "uint64", true]],
  "hud-widgets-2": [["L915", "uint64", true], ["L916", "uint64", true], ["L917", "uint64", true], ["L918", "uint64", true]],
  "hud-widgets": [["L446", "uint64", true], ["L447", "uint64", true], ["L448", "uint64", true], ["L449", "uint64", true], ["L450", "uint64", true], ["L451", "uint64", true], ["L452", "uint64", true], ["L453", "uint64", true], ["L454", "uint64", true], ["L455", "uint64", true]],
  "wvehicle-hud": [["L656", "uint64", true], ["L657", "uint64", true], ["L658", "uint64", true], ["L659", "uint64", true], ["L660", "uint64", true], ["L661", "uint64", true]],
  // garage-car-arm's (enter idle) sets a joint rotation constant: L110 is
  // {0.4, 0.4, 0.4, 1.0} (0x3ecccccd x3, 0x3f800000), stored via sq into the
  // joint list at (-> self node-list) + 188, the standard quaternion-sized
  // static-vector-into-cspace idiom seen elsewhere in this file. set-mult is
  // the same idiom factored into its own function; its constant L111 is the
  // identical {0.4, 0.4, 0.4, 1.0} value.
  "garage-obs": [["L110", "vector"], ["L111", "vector"]]
}
