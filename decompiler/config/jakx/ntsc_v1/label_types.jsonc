{
  "game-task": [
    ["L3", "(array game-task-node-info)"],
    ["L3009", "(array game-task-info)"],
    ["L2", "(array game-task-node-command)"]
  ],
  // debris do-collision: static collide-query scratch (jak3 decomps it as (new 'static 'collide-query))
  "debris": [["L73", "collide-query"]],
  // touch-tracker event: zeroed static vector scratch
  "generic-obs": [["L568", "attack-info"]],
  // ocean draw!/update-map: per-viewport ocean bucket pair, indexed by (-> viewport index)
  "ocean": [["L137", "(pointer bucket-id)", 2]],
  // the 19 seam/strip tables; jakx label order and element counts match jak3's
  // ocean-trans-tables block exactly (verified against the data word counts)
  "ocean-trans-tables": [
    ["L1", "(inline-array vector)", 4],
    ["L2", "(pointer float)", 160],
    ["L3", "(pointer float)", 100],
    ["L4", "(pointer float)", 72],
    ["L5", "(pointer float)", 72],
    ["L6", "(pointer float)", 72],
    ["L7", "(pointer float)", 72],
    ["L8", "(pointer float)", 44],
    ["L9", "(pointer float)", 44],
    ["L10", "(pointer float)", 44],
    ["L11", "(pointer float)", 44],
    ["L12", "(pointer float)", 40],
    ["L13", "(pointer float)", 40],
    ["L14", "(pointer float)", 40],
    ["L15", "(pointer float)", 40],
    ["L16", "(pointer float)", 28],
    ["L17", "(pointer float)", 28],
    ["L18", "(pointer float)", 28],
    ["L19", "(pointer float)", 28]
  ],
  // per-track ocean data: the typed statics the extern activation alone did not decode
  "jungle-ocean": [
    ["L1", "ocean-map"],
    ["L2", "ocean-mid-masks", true],
    ["L4", "ocean-mid-indices", true],
    ["L5", "ocean-trans-indices", true],
    ["L6", "ocean-near-indices", true]
  ],
  "havjung-ocean": [
    ["L1", "ocean-map"],
    ["L2", "ocean-mid-masks", true],
    ["L4", "ocean-mid-indices", true],
    ["L5", "ocean-trans-indices", true],
    ["L6", "ocean-near-indices", true]
  ],
  "foreground": [
    ["L215", "shadow-settings"], // *default-shadow-settings* static; jak3's same-named label was a bucket array
    ["L216", "vector"]
  ],
  // all-ones default color-mult/color-emissive vectors quad-copied into draw-control
  // by skeleton-group->draw-control; jak3's L463/L462 with the same content
  "process-drawable": [
    ["L472", "vector"],
    ["L471", "vector"]
  ],
  // entity leg: *camera-pos-0*/*camera-pos-1* zero-init vectors, *additional-spawners*
  // is a single-slot static handle table (8 bytes before the next label)
  "entity": [
    ["L448", "vector"],
    ["L449", "vector"],
    ["L450", "(pointer handle)", 1]
  ],
  "cam-states": [["L689", "uint64", true], ["L690", "uint64", true], ["L691", "uint64", true], ["L688", "uint64", true]],
  // loader: the spooler-block type-new packed (size, method-count) qword
  "loader": [["L1450", "uint64", true]],
  "tfrag-methods": [["L92", "(inline-array tfrag-init-data)", 12], ["L99", "(pointer bucket-id)", 12], ["L96", "(pointer bucket-id)", 12], ["L94", "(pointer bucket-id)", 12], ["L98", "(pointer bucket-id)", 12], ["L95", "(pointer bucket-id)", 12], ["L93", "(pointer bucket-id)", 12]],
  // tie leg: 13 category bucket arrays (6 draw-levels x 2 viewports each), decoded
  // from the patch-block order against jak3's category sequence
  "tie-methods": [
    ["L317", "(pointer bucket-id)", 12],
    ["L318", "(pointer bucket-id)", 12],
    ["L319", "(pointer bucket-id)", 12],
    ["L320", "(pointer bucket-id)", 12],
    ["L321", "(pointer bucket-id)", 12],
    ["L322", "(pointer bucket-id)", 12],
    ["L323", "(pointer bucket-id)", 12],
    ["L324", "(pointer bucket-id)", 12],
    ["L325", "(pointer bucket-id)", 12],
    ["L326", "(pointer bucket-id)", 12],
    ["L327", "(pointer bucket-id)", 12],
    ["L329", "(pointer bucket-id)", 12],
    ["L331", "(pointer bucket-id)", 12]
  ],
  // mood leg: the top-level type registrations load their flag qwords from labels
  "mood-funcs": [
    ["L52", "uint64", true],
    ["L53", "uint64", true]
  ],
  "mood-funcs2": [["L47", "uint64", true]],
  "shrubbery": [["L138", "uint64", true]],
  // sky leg: the four inline sky-vertex arrays (same label numbers as jak3 by
  // coincidence; sizes verified against the ir2 data segment)
  // texture-anim leg: the type-new packed (size, method-count) qword
  "texture-anim-tables": [["L150", "uint64", true], ["L151", "uint64", true], ["L152", "uint64", true], ["L163", "uint64", true]],
  // texture-anim leg: the pages table (32 uint8) and mip array (72 uint16),
  // sized from the ir2 data blocks (jak3's are 16 and 48)
  "texture-anim": [["L200", "(pointer uint8)", 32], ["L199", "(pointer uint16)", 72]],
  "sky-data": [
    ["L26", "(inline-array sky-vertex)", 12],
    ["L25", "(inline-array sky-vertex)", 12],
    ["L23", "(inline-array sky-vertex)", 648],
    ["L21", "(inline-array sky-vertex)", 144]
  ],
  "sky-tng": [
    ["L127", "vector"],
    ["L128", "vector"],
    ["L129", "vector"],
    ["L130", "uint64", true],
    ["L131", "uint64", true],
    ["L132", "uint64", true],
    ["L133", "uint64", true],
    ["L134", "uint64", true]
  ],
  "cam-states-dbg": [
    ["L59", "vector"],
    ["L60", "vector"]
  ],
  "level": [
    ["L981", "uint64", true],
    ["L983", "uint64", true]
  ],
  "ambient-h": [["L1", "(inline-array talker-speech-class)", 233]],
  "pat-h": [["L1", "(inline-array pat-mode-info)", 4]],
  // L4 is the full *bucket-map*: 1140 raw words = 2280 entries (19 draw slots x
  // 10 categories x 2 viewports x 6 modes). 462 was a jak3-count seed and is what
  // silently truncated the landed goal_src array.
  "foreground-h": [["L4", "(pointer bucket-id-16)", 2280]],
  "texture-anim-h": [["L1", "(pointer uint8)", 256]],
  "process-nettable-h": [["L13", "(pointer uint32)", 95]],
  "math": [
    ["L109", "(pointer float)", 32],
    ["L108", "(pointer float)", 32]
  ],
  "timer-h": [["L15", "(pointer uint32)", 12]],
  "game-task-h": [["L178", "(pointer text-id)", 24]],
  "profile": [["L3", "(inline-array profile-spec)", 13]],
  "task-control-h": [
    ["L971", "uint64", true],
    ["L973", "uint64", true],
    ["L977", "uint64", true],
    ["L979", "uint64", true],
    ["L978", "uint64", true],
    ["L972", "uint64", true],
