  "speech-torn": [["L1", "speech-info"], ["L4", "speech-info"], ["L18", "speech-info"], ["L37", "speech-info"], ["L80", "speech-info"], ["L89", "speech-info"], ["L104", "speech-info"], ["L124", "speech-info"], ["L154", "speech-info"], ["L176", "speech-info"], ["L184", "speech-info"], ["L188", "speech-info"], ["L210", "speech-info"], ["L244", "speech-info"], ["L308", "speech-info"], ["L330", "speech-info"], ["L376", "speech-info"], ["L410", "speech-info"]],
