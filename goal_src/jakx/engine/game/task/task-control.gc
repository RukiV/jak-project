;;-*-Lisp-*-
(in-package goal)

;; name: task-control.gc
;; name in dgo: task-control
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

;; og:preserve-this bring-up (#116 rung 4): update-task-masks below is the REDUCED
;; retail body: the borrow half is complete (it is the runtime writer that retires the
;; jungle and icelands borrow-info pre-bakes), while the mask arithmetic, the minimap
;; fade sweep, the open-node walk, the faction commands and the set-proto-vis! loop
;; are deferred to rung 5/6 and stubbed inline below with their own notes. The old
;; stub comment's "blocked on *minimap*" diagnosis was stale: the decomp blocker was
;; the empty game-task-node enum, retired at rung 0.

;; The borrow-eval lambda is hand-landed from (anon-function 43 task-control)'s
;; machine code (ops 0-34 of the ir2; jak2's landed task-control.gc lambda is the
;; shape template). Two jakx-specific facts from the asm: the stored value is the
;; WHOLE cddr tail written as one word into borrow-info[slot] (op 21 loads the tail,
;; op 30 stores it; jak2 instead writes two separate fields), and the slot arithmetic
;; is (sra raw 3) then (sll 2), i.e. slot = raw/8 with a 4-byte stride (ops 26-27).
;; Retail also loads the tuple's 3rd and 4th elements and discards them (ops 6-12,
;; dead loads); they are not transcribed.

(defun update-task-masks ((arg0 symbol))
  (if (= arg0 'none)
      (return 0)
      )
  (do-nothing *level*)
  ;; og:preserve-this rung-5 stub (#116): the retail mask recompute (features/items/
  ;; vehicles zeroing plus the secrets check) and the *minimap* fade sweep go here.
  (let ((borrow-eval (lambda ((arg0 pair))
                       (let ((tuple (car arg0)))
                         (while (not (null? arg0))
                           (let* ((host (car (the-as pair tuple)))
                                  (slot (/ (the-as int (car (cdr (the-as pair tuple)))) 8))
                                  (tail (cdr (cdr (the-as pair tuple))))
                                  (hostv (-> (the-as symbol host) value))
                                  (lli (if (type? hostv level-load-info)
                                           (the-as level-load-info hostv)
                                           )
                                       )
                                  )
                             (when lli
                               (if (-> lli borrow)
                                   (set! (-> lli borrow borrow-info slot) tail)
                                   )
                               )
                             )
                           (set! arg0 (cdr arg0))
                           (set! tuple (car arg0))
                           )
                         )
                       #f
                       )
                     )
        )
    (borrow-eval (-> *game-info* sub-task-list (game-task-node city-start-start) borrow))
    ;; og:preserve-this rung-5/6 stub (#116): the retail walk over every OPEN node's
    ;; borrow list goes here (plus eval-game-task-cmd! on closed nodes and the
    ;; when-open minimap countdown). With the task state machine unlanded no node is
    ;; ever open, so node 1's unconditional list above is the whole live set, which
    ;; is exactly where the jungle and icelands pairs ship.
    (dotimes (s4-3 (the-as int (-> *setting-control* user-current borrow-count)))
      (borrow-eval (-> *setting-control* user-current borrow s4-3))
      )
    )
  ;; og:preserve-this rung-5 stub (#116): the faction-command evaluation and the
  ;; debug-mask ORs go here.
  (add-borrow-levels *load-state*)
  ;; og:preserve-this rung-5 stub (#116): the set-proto-vis! loop over active levels
  ;; goes here; set-proto-vis! (level method 22) is a zero slot until its 3-line body
  ;; lands, and calling through it would be the kscheme goal-0 crash class.
  0
  )
