;; og:preserve-this hold (S-stage task-control rung): all ten stats-* functions
;; (stats-weapon-used, stats-player-died, stats-player-medal, stats-player-ranking,
;; stats-player-score, stats-player-end-mode, stats-player-time, stats-player-duration,
;; stats-player-vehicle, stats-player-cash) have unrecoverable arity in this decode.
;; Three (stats-player-medal, stats-player-duration, stats-player-vehicle) fail outright
;; ("function has no type analysis. Cannot decompile."); the other seven decode to a bare
;; "0" or "0 (none)" body with only their existing (object)/(object object) extern
;; signature to go on, which is not enough evidence to tell a real no-op from a truncated
;; decode. Their externs already exist (all-types.gc) and nothing calls them yet.
;; Retirement condition: a scoped decode against a config that resolves the three outright
;; failures, then re-derive real signatures for all ten from call-site evidence once one
;; exists.

(defun get-medal-reward-ignore-medal ((arg0 float))
  (let ((v1-0 (get-open-task-node-info))
        (a0-4 (if (and (= *game-mode* 'adventure) (logtest? (-> *game-info* secrets) 1))
                  1
                  0
                  )
              )
        )
    (when v1-0
      (cond
        ((logtest? (game-task-node-flag score-lower-is-better) (-> v1-0 flags))
         (cond
           ((>= (the-as float (-> v1-0 gold-array a0-4)) arg0)
            (return 3)
            )
           ((>= (the-as float (-> v1-0 silver-array a0-4)) arg0)
            (return 2)
            )
           ((>= (the-as float (-> v1-0 bronze-array a0-4)) arg0)
            (return 1)
            )
           (else
             (return 0)
             )
           )
         (the-as none 0)
         )
        (else
          (cond
            ((>= arg0 (the-as float (-> v1-0 gold-array a0-4)))
             (return 3)
             )
            ((>= arg0 (the-as float (-> v1-0 silver-array a0-4)))
             (return 2)
             )
            ((>= arg0 (the-as float (-> v1-0 bronze-array a0-4)))
             (return 1)
             )
            (else
              (return 0)
              )
            )
          (the-as none 0)
          )
        )
      (the-as none 0)
      )
    )
  0
  )

;; og:preserve-this hold (S-stage task-control rung): get-medal-reward decodes with only a
;; WARN ("Return type mismatch int vs object"), body otherwise present, but it is the sole
;; caller-side counterpart to get-medal-reward-ignore-medal above and report-score below is
;; its only caller in this file; holding with report-score so the two land together once
;; report-score's own arity issue clears. Retirement condition: land alongside report-score.

;; og:preserve-this hold (S-stage task-control rung): update-high-scores fails expression
;; building outright ("Floating point division attempted on invalid types at OP: [44]"), on
;; top of its own "Return type mismatch int vs object" WARN; its local-vars list carries
;; several untyped (array float)/(object) placeholders the decompiler could not resolve
;; (v1-1, f0-3, f0-8 etc.), so the arithmetic on them cannot be trusted even where it does
;; print. Retirement condition: a scoped decode against a config that resolves the
;; division's operand types (likely a stack_structures.jsonc entry for its own stack-array
;; local), then re-decode.

(define *last-medal* (the-as object 0))

;; og:preserve-this hold (S-stage task-control rung): report-score decodes with a WARN
;; ("Return type mismatch object vs int") but calls both get-medal-reward and
;; update-high-scores above, both themselves held; landing report-score first would either
;; call into their unlanded externs (no defun anywhere, a real e2-class risk since its own
;; calls are unguarded) or require landing all three at once. Holding all three together.
;; Retirement condition: resolve update-high-scores' expression-building failure, land
;; get-medal-reward and update-high-scores, then land report-score last.

(defun-debug task-node-dump ((arg0 symbol))
  (let ((gp-0 (-> *game-info* sub-task-list)))
    (dotimes (s5-0 (-> gp-0 length))
      (when (nonzero? s5-0)
        (-> gp-0 s5-0)
        (format
          #t
          "  ~-40S ~-8S~%"
          (game-task-node->string (the-as game-task-node s5-0))
          (if (task-node-closed? (the-as game-task-node s5-0))
              "closed"
              "open"
              )
          )
        )
      )
    )
  #f
  )

