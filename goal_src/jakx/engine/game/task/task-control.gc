  0
  )

;; og:preserve-this task-control rung: task-node-open? is moved ahead of task-open?
;; relative to the decode's own order (both decode clean, no body change) because
;; task-open? calls it and goalc compiles top-level forms in strict file order, unlike
;; retail's compiler; task-open? forward-referencing it as originally ordered fails
;; compilation ("No method or function named task-node-open? for type game-task-node").
(defun task-node-open? ((arg0 game-task-node))
  (let ((v1-1 (-> *game-info* sub-task-list)))
    (game-task-node-info-method-12 (-> v1-1 arg0))
    )
  )

(defun task-open? ((arg0 string))
