        (s4-0 0)
        )
    (while (< s4-0 (-> s5-0 length))
      (when (nonzero? s4-0)
        (let ((v1-4 (-> s5-0 s4-0)))
          (if (string= arg0 (-> v1-4 name))
              (return (task-node-open? (the-as game-task-node s4-0)))
              )
          )
        )
      (set! s4-0 (+ s4-0 1))
      )
    )
  (format 0 "ERROR: attempting to query open? of unknown task node ~A.~%" arg0)
  #f
  )

