    #t
    "#<game-task-node-info ~S ~S @ #x~X>"
    (-> this name)
    (cond
      ((logtest? (-> this flags) (game-task-node-flag closed))
       "closed"
       )
      ((game-task-node-info-method-12 this)
       "open"
       )
      (else
        "inactive"
        )
      )
    this
    )
  this
  )

;; og:preserve-this bring-up stub, R16 (#122): the boot crashes at
;; game-info.gc:150, (open! (-> *game-info* sub-task-list 1) 'event), dispatching
;; method 10 on game-task-node-info; task-control-h.gc:1250 declares the slot
;; ((open! (_type_ symbol) int)) but this rung's own scoped decode still fails on it
;; twice ("failed type prop at 12: add failed: <uninitialized> <value x 2>" and
;; "Failed to guess stack use for 16"), the machine code walking a countdown loop over
;; some fp-relative stack array whose element type and length the decompiler cannot
;; infer. A guard is impossible here: this is vtable dispatch on a method slot, not a
;; symbol reference, so there is no symbol to gate. jak3's twin
;; (goal_src/jak3/engine/game/task/task-control.gc:957) is not portable either: it
;; walks parent-node, on-close, on-open, manager, open?, and gem-count/skill-count,
;; none of which exist on jakx's game-task-node-info, a racing node carrying
;; gold/silver/bronze, ai-difficulty, and high-scores instead. A no-op stub is
;; faithful, not just convenient: jak3's own open! is itself a complete no-op when the
;; target node is already flagged closed (its entire body sits inside one (when (not
;; (logtest? (-> this flags) (game-task-node-flag closed))) ...), the when falling
;; straight through to a bare 0 return when the node is closed), sub-task-list element
;; 1 (city-start-start, game-task.gc:2202) is statically flagged closed in its own
;; static data, and every :when-open across jakx's entire static task list is #f, so
;; no jakx node reaches this method expecting the real body to run. This is the
;; dossier's top hazard: the real body changes the boot path game-info.gc:505/517
;; dispatches, so it stays a no-op until the stack-use wall clears. Retirement
;; condition: resolve the stack-use guess failure (likely a stack_structures.jsonc
;; entry for this method's fp-relative array) and land the real body.
(defmethod open! ((this game-task-node-info) (arg0 symbol))
  0
  )

