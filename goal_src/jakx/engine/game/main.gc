;; definition for function paused?
(defun paused? ()
  (or (= *master-mode* 'pause) (= *master-mode* 'progress) (= *master-mode* 'menu) (= *master-mode* 'freeze))
  )

;; definition for function movie?
(defun movie? ()
  (logtest? (-> *kernel-context* prevent-from-run) (process-mask movie))
  )

;; definition for function scene-select?
(defun scene-select? ()
  (and (>= (-> *game-info* demo-state) (the-as uint 100)) (< (-> *game-info* demo-state) (the-as uint 200)))
  )

;; definition for function demo?
(defun demo? ()
  (or (= *kernel-boot-message* 'demo) (= *kernel-boot-message* 'demo-shared))
  )

;; definition for function kiosk?
(defun kiosk? ()
  (= *kernel-boot-message* 'kiosk)
  )

;; definition for function beta?
(defun beta? ()
  (= *kernel-boot-message* 'beta)
  )

;; definition for symbol *last-master-mode*, type symbol
(define *last-master-mode* 'game)

;; og:preserve-this bring-up defines: these three globals belong to the unlanded
;; progress/lobby/menu legs. Unbound they read 0, and 0 is truthy in GOAL, so the
;; truthiness tests below misbranch: Start could never pause, and the 'progress
;; arm would deref pointer 0. #f is the retail-correct initial value for each;
;; their real homes re-define them when those legs land.
(define *progress-process* (the-as (pointer process) #f))
(define *lobby-menu-manager* (the-as basic #f))
(define *in-game-menu-process* (the-as (pointer process) #f))

;; definition for function set-master-mode
;; WARN: Return type mismatch int vs none.
(defun set-master-mode ((arg0 symbol))
  (when (!= arg0 *master-mode*)
    (set! *last-master-mode* *master-mode*)
    (set! *master-mode* arg0)
    (case *master-mode*
      (('pause)
       (when (not *lobby-menu-manager*)
         (if (not *debug-pause*)
             (logior! (-> *setting-control* user-default process-mask) (process-mask pause))
             )
         (logclear! (-> *setting-control* user-default process-mask) (process-mask freeze menu))
         (set! *pause-lock* #f)
         (sound-group-pause (the-as uint #xffffffff))
         (set! (-> *game-info* pause-start-time) (the-as uint (-> *display* real-clock frame-counter)))
         )
       )
      (('freeze)
       (logior! (-> *setting-control* user-default process-mask) (process-mask freeze))
       (logclear! (-> *setting-control* user-default process-mask) (process-mask pause menu))
       (sound-group-pause (the-as uint 17))
       (set! (-> *game-info* pause-start-time) (the-as uint (-> *display* real-clock frame-counter)))
       )
      (('menu)
       (logior! (-> *setting-control* user-default process-mask) (process-mask menu))
       (logclear! (-> *setting-control* user-default process-mask) (process-mask freeze pause progress))
       (sound-group-pause (the-as uint #xffffffff))
       (set! *pause-lock* #f)
       )
      (('progress)
       (when (and (not *lobby-menu-manager*) (or (not net-mgr) (= (-> (the-as (pointer uint8) *net-mgr*) 140) 4)))
         (if (not *debug-pause*)
             (logior! (-> *setting-control* user-default process-mask) (process-mask pause))
             )
         )
       (logclear! (-> *setting-control* user-default process-mask) (process-mask freeze menu))
       (sound-group-pause (the-as uint #xffffbfff))
       (set! *pause-lock* #f)
       (cond
         ((not *in-game-menu-process*)
          (in-game-menu-startup)
          (if (not *in-game-menu-process*)
              (set-master-mode 'game)
              )
          )
         (else
           (deactivate (-> *in-game-menu-process* 0))
           (set! *in-game-menu-process* (the-as (pointer process) #f))
           (set-master-mode 'game)
           )
         )
       (set! (-> *game-info* pause-start-time) (the-as uint (-> *display* real-clock frame-counter)))
       )
      (('game)
       (logclear! (-> *setting-control* user-default process-mask) (process-mask freeze pause menu))
       (let ((a0-41 (the-as uint #xffffffff)))
         (if *music-lock*
             (set! a0-41 (logxor a0-41 2))
             )
         (sound-group-continue a0-41)
         )
       (if (handle->process (-> *game-info* pause-menu))
           (send-event (-> *game-info* pause-menu process 0) 'die)
           )
       )
      )
    (setting-control-method-23 *setting-control*)
    )
  (if *debug-segment*
      (menu-respond-to-pause)
      )
  0
  (none)
  )

;; definition for function pause-allowed?
(defun pause-allowed? ()
  (not (or (< (-> *display* base-clock frame-counter) (the-as time-frame (-> *game-info* blackout-time)))
           (!= (-> *setting-control* user-current bg-a) 0.0)
           (!= (-> *setting-control* user-current bg-a-force) 0.0)
           (not (-> *setting-control* user-current allow-pause))
           (-> (the-as (pointer uint32) *setting-control*) 191)
           (handle->process (-> *game-info* auto-save-proc))
           (= *master-mode* 'freeze)
           (not (view-get-active-target))
           *master-exit*
           (not *common-text*)
           (not *debug-segment*)
           )
       )
  )

;; definition for function toggle-pause
(defun toggle-pause ()
  (local-vars (v1-112 object))
  (case *master-mode*
    (('game)
     (set-master-mode
       (cond
         ((and (logtest? (-> *cpad-list* cpads 0 valid) 128)
               (>= (-> *display* base-clock frame-counter) (the-as time-frame (-> *game-info* blackout-time)))
               (= (-> *setting-control* user-current bg-a) 0.0)
               (and (= (-> *setting-control* user-current bg-a-force) 0.0)
                    (< (seconds 1003) (-> *display* real-clock frame-counter))
                    )
               )
          (if (and (-> *setting-control* user-current allow-in-game-menu)
                   (not (-> (the-as (pointer uint32) *setting-control*) 191))
                   (not *in-game-menu-process*)
                   )
              'progress
              *master-mode*
              )
          )
         ((and (cpad-pressed? 0 select start) (cpad-hold? 0 l3) *debug-segment*)
          'menu
          )
         ((and (or (cpad-hold? 0 select) (cpad-hold? 0 r2))
               (and *debug-segment* (not (-> (the-as (pointer uint32) *setting-control*) 191)))
               )
          'pause
          )
         ((and (not *debug-segment*) (not (logtest? (-> *cpad-list* cpads 0 button0-abs 0) (pad-buttons start))))
          (if (pause-allowed?)
              'pause
              *master-mode*
              )
          )
         ((and (or (cpad-hold? 0 start) (cpad-hold? 1 start))
               (and (not (-> (the-as (pointer uint32) *setting-control*) 191))
                    (-> *setting-control* user-current allow-in-game-menu)
                    )
               )
          'progress
          )
         (else
           *master-mode*
           )
         )
       )
     )
    (('menu)
     (set-master-mode (cond
                        ((and *debug-segment* (cpad-hold? 0 l3) (cpad-pressed? 0 select start))
                         'menu
                         )
                        ((cpad-hold? 0 select r2)
                         (if *debug-segment*
                             'pause
                             *master-mode*
                             )
                         )
                        ((cpad-hold? 0 r3 r2 triangle circle)
                         'game
                         )
                        ((cpad-hold? 0 start)
                         'game
                         )
                        (else
                          *master-mode*
                          )
                        )
                      )
     (set! *pause-lock* #f)
     )
    (('pause)
     (set-master-mode (cond
                        ((and (cpad-pressed? 0 select start) (cpad-hold? 0 l3) *debug-segment*)
                         'menu
                         )
                        ((and (or (not *debug-segment*) (not *cheat-mode*)) (cpad-hold? 0 select))
                         'game
                         )
                        ((and *cheat-mode* (cpad-hold? 0 select r2))
                         'game
                         )
                        ((cpad-hold? 0 start)
                         'game
                         )
                        (else
                          *master-mode*
                          )
                        )
                      )
     (set! *pause-lock* (and *cheat-mode* (cpad-hold? 0 r2)))
     )
    (('freeze)
     (set-master-mode (if (and (cpad-pressed? 0 select start) (cpad-hold? 0 l3) *debug-segment*)
                          'menu
                          *master-mode*
                          )
                      )
     )
    (('progress)
     (when *debug-segment*
       (when (and *in-game-menu-process* (begin
                                           (let* ((v1-113 #t)
                                                  (a0-49 (-> *in-game-menu-process* 0 view))
                                                  (a0-55 (the-as pad-buttons (logand (-> *cpad-list*
                                                                                         cpads
                                                                                         (if a0-49
                                                                                             (-> a0-49 index)
                                                                                             -1
                                                                                             )
                                                                                         button0-abs
                                                                                         0
                                                                                         )
                                                                                     (pad-buttons start)
                                                                                     )
                                                                 )
                                                         )
                                                  )
                                             (cmove-#f-zero v1-112 a0-55 v1-113)
                                             )
                                           v1-112
                                           )
                  )
         (deactivate (-> *in-game-menu-process* 0))
         (set! *in-game-menu-process* (the-as (pointer process) #f))
         )
       (set-master-mode 'game)
       (set! *pause-lock* (and *cheat-mode* (cpad-hold? 0 r2)))
       )
     )
    )
  0
  )

;; definition for symbol *screen-filter-array*, type (array screen-filter)
(define *screen-filter-array* (new 'static 'boxed-array :type screen-filter
                                (new 'static 'screen-filter :draw? #f :bucket (bucket-id bucket795))
                                (new 'static 'screen-filter :draw? #f :bucket (bucket-id bucket795) :idx 1)
                                (new 'static 'screen-filter :draw? #f :bucket (bucket-id bucket795) :idx 2)
                                )
        )

;; definition for symbol *screen-filter*, type screen-filter
(define *screen-filter* (-> *screen-filter-array* 2))

