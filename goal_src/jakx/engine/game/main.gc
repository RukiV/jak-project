;; og:preserve-this bring-up video sync: the pc-settings system (pckernel) is not
;; landed, so nothing ever tells the C kernel the game resolution or letterbox
;; region and both sit at their 640x480 defaults, shrinking the frame to a small
;; centered patch. Mirror the pckernel update-to-os essentials each frame: read
;; the window size, fit a 4:3 box inside it (integer math: compare 3w vs 4h),
;; and push it as both the render resolution and the letterbox region. Retire
;; with the pckernel landing.
(defun jakx-video-sync ()
  (let ((dims (new 'stack-no-clear 'array 'int64 2)))
    (set! (-> dims 0) 0)
    (set! (-> dims 1) 0)
    (pc-get-window-size (&-> dims 0) (&-> dims 1))
    (let ((win-w (the int (-> dims 0)))
          (win-h (the int (-> dims 1)))
          )
      (when (and (> win-w 0) (> win-h 0))
        (let ((box-w win-w)
              (box-h win-h)
              )
          (cond
            ((> (* 3 win-w) (* 4 win-h))
             ;; window wider than 4:3, pillarbox
             (set! box-w (/ (* 4 win-h) 3))
             )
            ((< (* 3 win-w) (* 4 win-h))
             ;; window taller than 4:3, letterbox
             (set! box-h (/ (* 3 win-w) 4))
             )
            )
          (pc-set-game-resolution box-w box-h)
          (pc-set-letterbox box-w box-h)
          )
        )
      )
    )
  0
  (none)
  )

;; og:preserve-this PHASE-1 HAND-WRITTEN display-loop-main: the decompiled original
;; (preserved commented below) degrades to raw ops on the debug-profiling blocks. This
;; version keeps the original per-frame ORDER (verified against main_ir2.asm and jak3's
;; display-loop-main) with the profiling instrumentation dropped and the not-yet-landed
;; subsystems guarded: disc-error UI, screen filters, letterbox/blackout draws,
;; blit-displays, and the sound-position update (retail's ear-trans/camera-pos block;
;; swap-sound-buffers itself is landed and called direct). Restore pieces as their homes land.
(defun display-loop-main ((arg0 display))
  ;; og:preserve-this bring-up: pckernel stand-in, see jakx-video-sync above
  (jakx-video-sync)
  (blerc-execute)
  (blerc-init)
  (hud-string-draw-all (-> arg0 frames (-> arg0 on-screen) global-buf))
  (texscroll-execute)
  (ripple-execute)
  (region-execute)
  (execute-math-engine)
  (execute-cloth-engine)
  ;; walk *debug-hook* then run cheats (original order)
  (let ((s5-0 *debug-hook*))
    (while (not (null? s5-0))
      ;; og:preserve-this runtime-link guard: main-debug-hook is a defun-debug whose
      ;; home is not landed, so its list entry links as 0; skip unlinked entries
      (let ((s4-hook (car s5-0)))
        (if (nonzero? s4-hook)
            ((the-as (function none) s4-hook))
            )
        )
      (set! s5-0 (cdr s5-0))
      )
    )
  (main-cheats)
  ;; camera update inside the jakx view context bracket
  (view-push-context 0)
  (update-camera)
  ;; og:preserve-this bring-up: deferred camera warp onto the boot level; home is
  ;; cam-start.gc, runtime-link guarded like the other not-always-landed hooks
  (if (nonzero? jakx-cam-warp-tick)
      (jakx-cam-warp-tick)
      )
  (execute-cam-post-hook-engine)
  (view-pop-context)
  (temp-render-chat-messages)
  (*draw-hook*)
  (*menu-hook*)
  (load-level-text-files -1)
  ;; og:preserve-this phase-1 omissions: screen-filter-array draws, letterbox, blackout,
  ;; and disc-error UI (subsystems not landed; all visual-only)
  (when (nonzero? *blit-displays-work*)
    ;; (do-blit-displays *blit-displays-work* ...) restored when blit-displays lands
    0
    )
  (end-display arg0)
  (display-frame-finish arg0)
  (display-sync arg0)
  ;; ---- new frame begins here (display-sync called display-frame-start) ----
  ;; the particle frame step (retail placement); its bring-up lever retired at
  ;; #53 slice 4 once processing and drawing verified together
  (when (not (paused?))
    (execute-particle-local-space-engine 0)
    (process-particles)
    (execute-particle-local-space-engine 1)
    )
  (swap-sound-buffers)
  (update-jukebox-music)
  (str-play-kick)
  (level-update *level*)
  (if (nonzero? mc-run) (mc-run)) ;; og:preserve-this runtime-link guard: mc-screen not landed
  (auto-save-check)
  0
  (none)
  )

