;; definition for method 10 of type screen-filter
(defmethod screen-filter-method-10 ((this screen-filter)
                                   (arg0 vector)
                                   (arg1 vector)
                                   (arg2 float)
                                   (arg3 bucket-id)
                                   (arg4 int)
                                   (arg5 int)
                                   (arg6 symbol)
                                   )
  (set! (-> this draw?) #t)
  (set! (-> this color quad) (-> arg0 quad))
  (set! (-> this color-src quad) (-> arg0 quad))
  (set! (-> this color-dest quad) (-> arg1 quad))
  (set! (-> this extra x) arg2)
  (set! (-> this extra y) 0.0)
  (set! (-> this bucket) arg3)
  (set! (-> this depth) arg4)
  (set! (-> this ztest) (the-as uint arg5))
  (set! (-> this lock-vsync?) #f)
  (set! (-> this frames) (the-as int arg6))
  0
  (none)
  )

;; definition for method 11 of type screen-filter
;; WARN: Return type mismatch int vs none.
(defmethod screen-filter-method-11 ((this screen-filter))
  (set! (-> this draw?) #f)
  0
  (none)
  )

