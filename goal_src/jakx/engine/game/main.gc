;; definition for function display-loop
(defbehavior display-loop process ()
  (stack-size-set! (-> self main-thread) 512)
  (process-spawn-function
    process
    (lambda :behavior process
      ()
      (logclear! (-> self mask) (process-mask freeze pause menu progress entity))
      (until #f
        (when *debug-segment*
          'joints
          (let ((gp-0 (-> *display* frames (-> *display* on-screen) profile-array data 0))
                (v1-10 'joints)
                (s5-0 *profile-joints-color*)
                )
            (when (and *dproc* *debug-segment*)
              (let ((s4-0 (-> gp-0 data (-> gp-0 count))))
                (let ((s3-0 (-> gp-0 base-time)))
                  (set! (-> s4-0 name) v1-10)
                  (set! (-> s4-0 start-time) (the-as int (- (timer-count (the-as timer-bank #x10000800)) (the-as uint s3-0))))
                  )
                (set! (-> s4-0 depth) (the-as uint (-> gp-0 depth)))
                (set! (-> s4-0 color) s5-0)
                (set! (-> gp-0 segment (-> gp-0 depth)) s4-0)
                )
              (set! (-> gp-0 count) (min 2099 (+ (-> gp-0 count) 1)))
              (+! (-> gp-0 depth) 1)
              (set! (-> gp-0 max-depth) (max (-> gp-0 max-depth) (-> gp-0 depth)))
              )
            )
          0
          )
        (execute-math-engine)
        (when *debug-segment*
          (let ((gp-1 (-> *display* frames (-> *display* on-screen) profile-array data 0)))
            (when (and *dproc* *debug-segment*)
              (let* ((v1-34 (+ (-> gp-1 depth) -1))
                     (s5-1 (-> gp-1 segment v1-34))
                     (s4-1 (-> gp-1 base-time))
                     )
                (when (>= v1-34 0)
                  (set! (-> s5-1 end-time) (the-as int (- (timer-count (the-as timer-bank #x10000800)) (the-as uint s4-1))))
                  (+! (-> gp-1 depth) -1)
                  )
                )
              )
            )
          0
          )
        (suspend)
        )
      #f
      (none)
      )
    :name "matrix"
    :from *4k-dead-pool*
    :to *mid-pool*
    )
  (let ((gp-1 *display*))
    (viewport-array-method-9 *viewport-array* (the-as viewport 0))
    (set! *teleport* #t)
    (setting-control-method-24 *setting-control*) ;; og:preserve-this: dropped-arg emission fixed
    (init-time-of-day-context *time-of-day-context*)
    (display-sync gp-1)
    (display-frame-finish gp-1)
    (display-sync gp-1)
    (install-handler 3 vblank-handler)
    (free-nodes *touching-list*)
    (prepare *collide-rider-pool*)
    (update-actor-hash)
    (hud-string-init)
    (blerc-init)
    ;; og:preserve-this PC port, matching jak2 and jak3: the collide VU0 microcode
    ;; upload is dropped. VU0 does not exist on the PC port, and dma-send is a
    ;; deliberate (crash!) stub here exactly as it is in jak3 (dma.gc:27-35 here,
    ;; jak3/engine/dma/dma.gc:28-36), so this call faults the instant it runs:
    ;; (crash!) expands to (-> (the (pointer uint8) 0)) (goal-lib.gc:210-213), a read
    ;; of GOAL address 0. jak2 (engine/game/main.gc:1046-1050) and jak3
    ;; (engine/game/main.gc:1610-1615) both comment the call out outright.
    ;;
    ;; jakx instead carried it behind (when (nonzero? *collide-vif0-init*) ...),
    ;; written at b67f8f997 ("run the display loop headless", 2026-07-23) when
    ;; collide.gc had not landed and that symbol still read 0, so the guard was false
    ;; and the call inert. 9ada081d3 ("land collide", 2026-08-13) landed
    ;; *collide-vif0-init* as a real static boxed-array (collide.gc:11), which made
    ;; the guard true and armed the call. That is forge #219's SIG-E: "GOAL code:
    ;; dma+0x27 ... (reading <goal 0>)" in the "display" process (this defbehavior,
    ;; spawned :name "display" at main.gc:4770), landing right after
    ;; "(game-info::reset) boot".
    ;;
    ;; #unless PC_PORT rather than another value guard: PC_PORT is a compile-time
    ;; constant (#t, kernel/gcommon.gc:13), so the call is unreachable by
    ;; construction and no future landing can re-arm it the way a guard on a data
    ;; symbol's presence did. Same reader-conditional idiom this subsystem already
    ;; uses for the VU/VIF class (dma.gc:87 and dma.gc:126).
    (#unless PC_PORT
      (dma-send
        (the-as dma-bank #x10008000)
        (the-as uint (-> *collide-vif0-init* data))
        (the-as uint (/ (-> *collide-vif0-init* length) 4))
        )
      )
    (suspend)
    (set! (-> *setting-control* user-default bg-a) 0.0)
    (set! (-> gp-1 frames 0 start-time) (timer-count (the-as timer-bank #x10000800)))
    (set! (-> gp-1 frames 1 start-time) (timer-count (the-as timer-bank #x10000800)))
    (set! (-> gp-1 dog-ratio) 1.0)
    (while *run*
      (display-loop-main gp-1)
      (when *debug-segment*
        'actors
        (let ((s5-0 (-> *display* frames (-> *display* on-screen) profile-array data 0))
              (v1-30 'actors)
              (s4-0 *profile-actors-color*)
              )
          (when (and *dproc* *debug-segment*)
            (let ((s3-0 (-> s5-0 data (-> s5-0 count))))
              (let ((s2-0 (-> s5-0 base-time)))
                (set! (-> s3-0 name) v1-30)
                (set! (-> s3-0 start-time) (the-as int (- (timer-count (the-as timer-bank #x10000800)) (the-as uint s2-0))))
                )
              (set! (-> s3-0 depth) (the-as uint (-> s5-0 depth)))
              (set! (-> s3-0 color) s4-0)
              (set! (-> s5-0 segment (-> s5-0 depth)) s3-0)
              )
            (set! (-> s5-0 count) (min 2099 (+ (-> s5-0 count) 1)))
            (+! (-> s5-0 depth) 1)
            (set! (-> s5-0 max-depth) (max (-> s5-0 max-depth) (-> s5-0 depth)))
            )
          )
        0
        )
      (suspend)
      (when *debug-segment*
        (let ((s5-1 (-> *display* frames (-> *display* on-screen) profile-array data 0)))
          (when (and *dproc* *debug-segment*)
            (let* ((v1-54 (+ (-> s5-1 depth) -1))
                   (s4-1 (-> s5-1 segment v1-54))
                   (s3-1 (-> s5-1 base-time))
                   )
              (when (>= v1-54 0)
                (set! (-> s4-1 end-time) (the-as int (- (timer-count (the-as timer-bank #x10000800)) (the-as uint s3-1))))
                (+! (-> s5-1 depth) -1)
                )
              )
            )
          )
        0
        )
      )
    )
  (set! *dproc* #f)
  (format 0 "display is off #<#x~X>.~%" self)
  0
  )

;; definition for function on
(defun on ((arg0 symbol))
  (when (not *dproc*)
    (when (not arg0)
      (if (= (-> *level* level0 status) 'inactive)
          (bg 'halfpipe)
          )
      )
    (set! *run* #t)
    (set! *dproc* (ppointer->process (process-spawn-function
                                       process
                                       display-loop
                                       :name "display"
                                       :from *4k-dead-pool*
                                       :to *display-pool*
                                       :stack *kernel-dram-stack*
                                       )
                                     )
          )
    (cond
      ((or (level-get-with-status *level* 'loaded)
           (level-get-with-status *level* 'alive)
           (level-get-with-status *level* 'active)
           )
       (activate-levels! *level*)
       (when (not arg0)
         (let ((gp-1 (entity-by-type camera-start)))
           (when (and gp-1 (type? gp-1 entity-actor))
             (while (not (camera-teleport-to-entity gp-1))
               (suspend)
               )
             )
           )
         )
       (if (and (= *kernel-boot-message* 'art-group) *kernel-boot-art-group*)
           (anim-tester-add-object *kernel-boot-art-group*)
           )
       )
      (else
        (kill-by-name "display" *active-pool*)
        (set! *dproc* #f)
        )
      )
    )
  *dproc*
  )

;; definition for function off
;; WARN: Return type mismatch int vs none.
(defun off ()
  (let ((t9-0 stop)
        (a0-0 'debug)
        )
    0
    ;; og:preserve-this arity fix, R4 (#122): stop's second (int) argument added to
    ;; keep this pre-existing call site (b67f8f9971, predates the leg) compiling
    ;; against the corrected signature. main_ir2.asm op 2 (raw machine code, unaffected
    ;; by decompiler-config staleness) shows a1 = literal 0 at this exact call, so this
    ;; is decoded evidence, not a guess.
    (t9-0 a0-0 0)
    )
  (dotimes (gp-0 (-> *level* length))
    (let ((a0-2 (-> *level* level gp-0)))
      (if (= (-> a0-2 status) 'active)
          (deactivate a0-2)
          )
      )
    )
  (set! *run* #f)
  0
  (none)
  )

;; og:preserve-this bring-up-scoped landing (#171): only the camera-cheat branch of
;; the raw decomp (commented above at :2310-2449, *cheat-temp* index 4) is landed.
;; It is self-contained: its (when *cheat-mode* ...) gate is already satisfied since
;; *cheat-mode* defaults to #t (pad.gc:136), so the master cheat-mode-on sequence at
;; index 0 (:1709-1834) does not need to land to reach it. Every other cheat
;; (*cheat-temp* 0-3, the post-cheat-mode branches past :2454) stays commented.
;; Note: disengaging sets *cheat-mode* back to #f, which also closes this branch's
;; own gate, since the index-0 sequence that would set it back to non-#f is not
;; landed; re-arming after a disengage does not work yet. Retires when main-cheats
;; lands in full.
(defun main-cheats ()
  (when *cheat-mode*
    (when (nonzero? (-> *cpad-list* cpads 1 button0-rel 0))
      (let ((v1-192 (-> *cheat-temp* 4)))
        (cond
          ((zero? v1-192)
           (cond
             ((cpad-pressed? 1 triangle)
              (+! (-> *cheat-temp* 4) 1)
              )
             (else
               (set! (-> *cheat-temp* 4) 0)
               0
               )
             )
           )
          ((= v1-192 1)
           (cond
             ((cpad-pressed? 1 x)
              (+! (-> *cheat-temp* 4) 1)
              )
             (else
               (set! (-> *cheat-temp* 4) 0)
               0
               )
             )
           )
          ((= v1-192 2)
           (cond
             ((cpad-pressed? 1 circle)
              (+! (-> *cheat-temp* 4) 1)
              )
             (else
               (set! (-> *cheat-temp* 4) 0)
               0
               )
             )
           )
          ((= v1-192 3)
           (cond
             ((cpad-pressed? 1 square)
              (+! (-> *cheat-temp* 4) 1)
              )
             (else
               (set! (-> *cheat-temp* 4) 0)
               0
               )
             )
           )
          ((= v1-192 4)
           (cond
             ((cpad-pressed? 1 triangle)
              (+! (-> *cheat-temp* 4) 1)
              )
             (else
               (set! (-> *cheat-temp* 4) 0)
               0
               )
             )
           )
          ((= v1-192 5)
           (cond
             ((cpad-pressed? 1 x)
              (+! (-> *cheat-temp* 4) 1)
              )
             (else
               (set! (-> *cheat-temp* 4) 0)
               0
               )
             )
           )
          ((= v1-192 6)
           (cond
             ((cpad-pressed? 1 circle)
              (+! (-> *cheat-temp* 4) 1)
              )
             (else
               (set! (-> *cheat-temp* 4) 0)
               0
               )
             )
           )
          ((= v1-192 7)
           (cond
             ((cpad-pressed? 1 square)
              (logclear! (-> *cpad-list* cpads 0 button0-abs 0) (pad-buttons r1))
              (logclear! (-> *cpad-list* cpads 0 button0-rel 0) (pad-buttons r1))
              (set! *cheat-mode* (if (= *cheat-mode* 'camera)
                                     #f
                                     'camera
                                     )
                    )
              ;; og:preserve-this re-rendered: both make-sound-instance calls below
              ;; carry the raw decomp's literal 0 #f args, which fail typecheck
              ;; against the real (sound-info sound-id handle) signature; every other
              ;; landed call site in the tree already wraps them the same way (e.g.
              ;; jungle-obs.gc:110), so mirrored here. Sound index (314) and behavior
              ;; are unchanged.
              (cond
                (*cheat-mode*
                  (if (not *external-cam-mode*)
                      (external-cam-reset!)
                      )
                  (set! *external-cam-mode* 'pad-1)
                  (let ((v1-265 (make-sound-instance (-> *sound-info* 314) (new 'static 'sound-id) (the-as handle #f))))
                    (cond
                      (v1-265
                        (set! (-> v1-265 fo-power) 0.0)
                        (logior! (-> v1-265 flags) 328)
                        (-> v1-265 id)
                        )
                      (else
                        0
                        )
                      )
                    )
                  )
                (else
                  (set! *external-cam-mode* #f)
                  (let ((v1-269 (make-sound-instance (-> *sound-info* 314) (new 'static 'sound-id) (the-as handle #f))))
                    (cond
                      (v1-269
                        (set! (-> v1-269 fo-power) 0.0)
                        (logior! (-> v1-269 flags) 328)
                        (-> v1-269 id)
                        )
                      (else
                        0
                        )
                      )
                    )
                  )
                )
              (set! (-> *cheat-temp* 4) 0)
              0
              )
             (else
               (set! (-> *cheat-temp* 4) 0)
               0
               )
             )
           )
          )
        )
      )
    )
  0
  (none)
  )

