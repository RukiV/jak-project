;; definition for function end-display
;; WARN: Return type mismatch int vs none.
(defun end-display ((arg0 display))
  (let ((s5-0 (-> (if *debug-segment*
                      (-> arg0 frames (-> arg0 on-screen) debug-buf)
                      (-> arg0 frames (-> arg0 on-screen) global-buf)
                      )
                  base
                  )
              )
        )
    (when *debug-segment*
      'debug
      (let ((s4-0 (-> *display* frames (-> *display* on-screen) profile-array data 0))
            (v1-18 'debug)
            (s3-0 *profile-debug-color*)
            )
        (when (and *dproc* *debug-segment*)
          (let ((s2-0 (-> s4-0 data (-> s4-0 count))))
            (let ((s1-0 (-> s4-0 base-time)))
              (set! (-> s2-0 name) v1-18)
              (set! (-> s2-0 start-time) (the-as int (- (timer-count (the-as timer-bank #x10000800)) (the-as uint s1-0))))
              )
            (set! (-> s2-0 depth) (the-as uint (-> s4-0 depth)))
            (set! (-> s2-0 color) s3-0)
            (set! (-> s4-0 segment (-> s4-0 depth)) s2-0)
            )
          (set! (-> s4-0 count) (min 2099 (+ (-> s4-0 count) 1)))
          (+! (-> s4-0 depth) 1)
          (set! (-> s4-0 max-depth) (max (-> s4-0 max-depth) (-> s4-0 depth)))
          )
        )
      0
      )
    (with-dma-buffer-add-bucket ((s3-1 (if *debug-segment*
                                           (-> arg0 frames (-> arg0 on-screen) debug-buf)
                                           (-> arg0 frames (-> arg0 on-screen) global-buf)
                                           )
                                       )
                                 (bucket-id bucket794)
                                 )
      (when (and (nonzero? draw-string-xy) ;; og:preserve-this runtime-link guard: font.gc not landed
                 ;; og:preserve-this runtime-link guard (forge issue 376): *common-text* is
                 ;; (the-as game-text-info #f) and nothing in jakx assigns it yet, so the
                 ;; method-of-object dispatch below reads [#f - 4] as a type and crashes the
                 ;; display process whenever the game pauses (both crash faces on the issue).
                 ;; Retail ships this unguarded because text loading always assigns
                 ;; *common-text* before pause is reachable. Retire this guard when the
                 ;; text-loading chain that performs that assignment lands.
                 *common-text*
                 (= *master-mode* 'pause)
                 (and (!= *cheat-mode* 'camera) (or (zero? *screen-shot-work*) (= (-> *screen-shot-work* count) -1)))
                 )
        (let ((s2-1 draw-string-xy)
              (t9-1 (method-of-object *common-text* game-text-info-method-9))
              )
          2
          (s2-1
            (the-as string (t9-1 *common-text* 2 #f))
            s3-1
            0
            (if (< (-> *display* base-clock frame-counter) (the-as time-frame (-> *game-info* letterbox-time)))
                352
                320
                )
            (font-color red)
            (font-flags shadow kerning middle large)
            )
          )
        )
      (let ((s2-2 (the int (-> *font-context* origin y))))
        (cond
          ((or (!= (-> *setting-control* user-current letterbox) 0.0)
               (< (-> *display* base-clock frame-counter) (the-as time-frame (-> *game-info* letterbox-time)))
               )
           (+! s2-2 56)
           )
          ((and *display-profile* (not *display-capture-mode*))
           (+! s2-2 48)
           )
          )
        (when (and (nonzero? draw-string-xy) ;; og:preserve-this runtime-link guard: font.gc not landed
                   (or (zero? *screen-shot-work*) (= (-> *screen-shot-work* count) -1) (-> *screen-shot-work* debug-enable))
                   )
          (let* ((v1-74
                   (draw-string-xy
                     *stdcon0*
                     s3-1
                     (the int (-> *font-context* origin x))
                     s2-2
                     (font-color default)
                     (font-flags shadow kerning)
                     )
                   )
                 (a3-4 (+ s2-2 (the int (* 2.0 (-> v1-74 b)))))
                 )
            (draw-string-xy
              *stdcon1*
              s3-1
              (the int (-> *font-context* origin x))
              a3-4
              (font-color default)
              (font-flags shadow kerning)
              )
            )
          )
        )
      (if (or (not *debug-segment*) *display-capture-mode* (paused?))
          (set! *stdebug* *null*)
          (set! *stdebug* *stdcon1*)
          )
      (when *display-iop-info*
        (show-iop-info s3-1)
        (show-iop-memory s3-1)
        )
      (when *debug-reverb*
        (let ((s2-3 draw-string-xy))
          (let ((s1-1 format)
                (a0-27 (clear *temp-string*))
                (a1-6 "Reverb: ~0,,2f (~S)  Fade: ~0,,2f units/seconds~%")
                (a2-4 (-> *setting-control* user-current sound-reverb))
                (v1-92 (-> *setting-control* user-current sound-reverb-mode))
                )
            (s1-1
              a0-27
              a1-6
              a2-4
              (cond
                ((= v1-92 2)
                 "studio-a"
                 )
                ((= v1-92 5)
                 "hall"
                 )
                ((= v1-92 9)
                 "pipe"
                 )
                ((zero? v1-92)
                 "off"
                 )
                ((= v1-92 3)
                 "studio-b"
                 )
                ((= v1-92 1)
                 "room"
                 )
                ((= v1-92 7)
                 "echo"
                 )
                ((= v1-92 4)
                 "studio-c"
                 )
                ((= v1-92 8)
                 "delay"
                 )
                ((= v1-92 6)
                 "space"
                 )
                (else
                  "*unknown*"
                  )
                )
              (-> *setting-control* user-current sound-reverb-seek-speed)
              )
            )
          (s2-3 *temp-string* s3-1 0 380 (font-color default) (font-flags shadow kerning))
          )
        )
      (if *display-memcard-info*
          (show-mc-info s3-1)
          )
      )
    (set! *stdcon* (clear *stdcon0*))
    (when *debug-segment*
      (let ((s4-2 (-> *display* frames (-> *display* on-screen) profile-array data 0)))
        (when (and *dproc* *debug-segment*)
          (let* ((v1-117 (+ (-> s4-2 depth) -1))
                 (s3-2 (-> s4-2 segment v1-117))
                 (s2-4 (-> s4-2 base-time))
                 )
            (when (>= v1-117 0)
              (set! (-> s3-2 end-time) (the-as int (- (timer-count (the-as timer-bank #x10000800)) (the-as uint s2-4))))
              (+! (-> s4-2 depth) -1)
              )
            )
          )
        )
      0
      )
    (let ((v1-122 *dma-mem-usage*))
      (when (nonzero? v1-122)
        (set! (-> v1-122 length) (max 88 (-> v1-122 length)))
        (set! (-> v1-122 data 87 name) "debug")
        (+! (-> v1-122 data 87 count) 1)
        (+! (-> v1-122 data 87 used) (&-
                                       (-> (if *debug-segment*
                                               (-> arg0 frames (-> arg0 on-screen) debug-buf)
                                               (-> arg0 frames (-> arg0 on-screen) global-buf)
                                               )
                                           base
                                           )
                                       (the-as uint s5-0)
                                       )
            )
        (set! (-> v1-122 data 87 total) (-> v1-122 data 87 used))
        )
      )
    )
  0
  (none)
  )

;; definition of type disc-error-proc
(deftype disc-error-proc (process-drawable)
  ((error  basic)
   (bmask  uint32)
   )
  )

;; definition for method 3 of type disc-error-proc
(defmethod inspect ((this disc-error-proc))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type process-drawable inspect)))
    (t9-0 this)
    )
  (format #t "~2Terror: ~A~%" (-> this error))
  (format #t "~2Tbmask: ~D~%" (-> this bmask))
  (label cfg-4)
  this
  )

