   (game-info-pad2 int32 1)
   (level-opened                         uint8                          32      :offset-assert 1176) ;; guessed by decompiler
   (total-deaths                         int32                                  :offset-assert 1208)
   (continue-deaths                      int32                                  :offset-assert 1212)
   (task-deaths                          int32                                  :offset-assert 1216)
   (total-trys                           int32                                  :offset-assert 1220)
   (game-start-time                      uint64                                 :offset-assert 1224) ;; time-frame
   (continue-time                        uint64                                 :offset-assert 1232) ;; time-frame
   (death-time                           uint64                                 :offset-assert 1240) ;; time-frame
   (hit-time                             uint64                                 :offset-assert 1248) ;; time-frame
   (task-pickup-time                     uint64                                 :offset-assert 1256) ;; time-frame
   (stop-watch-start                     uint64                                 :offset-assert 1264) ;; time-frame
   (stop-watch-stop                      uint64                                 :offset-assert 1272) ;; time-frame
   (blackout-time                        uint64                                 :offset-assert 1280) ;; time-frame
   (letterbox-time                       uint64                                 :offset-assert 1288) ;; time-frame
   (hint-play-time                       uint64                                 :offset-assert 1296) ;; time-frame
   (display-text-time                    uint64                                 :offset-assert 1304) ;; time-frame
   (display-text-handle                  uint64                                 :offset-assert 1312) ;; handle
   (death-movie-tick                     int32                                  :offset-assert 1320)
   (want-auto-save                       symbol                                 :offset-assert 1324) ;; guessed by decompiler
   (auto-save-proc                       handle                                 :offset-assert 1328)
   (auto-save-status                     mc-status-code                         :offset-assert 1336) ;; guessed by decompiler
   (auto-save-card                       int32                                  :offset-assert 1340)
   (auto-save-which                      int32                                  :offset-assert 1344)
   (auto-save-count                      int32                                  :offset-assert 1348)
   (pov-camera-handle                    uint64                                 :offset-assert 1352) ;; handle
   (other-camera-handle                  uint64                                 :offset-assert 1360) ;; handle
   (controller                           handle                         2       :offset-assert 1368) ;; guessed by decompiler
   (bot-health                           float                          3       :offset-assert 1384) ;; guessed by decompiler
   (demo-state                           uint32                                 :offset-assert 1396)
   (distance                             float                                  :offset-assert 1400)
   (kiosk-timeout                        uint64                                 :offset-assert 1408) ;; time-frame
   (pause-start-time                     uint64                                 :offset-assert 1416) ;; time-frame
   ;; og:preserve-this best-times aliases pause-start-time's own upper 4 bytes (1420-1423 of
   ;; its 1416-1423 span), forced :offset rather than :offset-assert since deftype.cpp's
   ;; sequential-placement check has already consumed 1416-1423 for pause-start-time and
   ;; :overlay-at only aliases a field's OWN base offset (deftype.cpp:145,
   ;; offset_override = overlay_field.offset()), not an arbitrary byte inside it -- tried
   ;; first and rejected with "Field best-times was placed at 1416 but offset-assert was
   ;; set to 1420". pause-start-time itself must stay a real uint64: this file's own
   ;; main.gc:227,234,264 already assigns it (the-as uint (-> *display* real-clock
   ;; frame-counter)), so narrowing it would break landed, compiling code, not just this
   ;; decode. PROVEN from game-info_ir2.asm: top-level-login allocates (new 'global 'array
   ;; float 10) and stores the pointer with sw at +1420 (a 32-bit store, not the 64-bit sd a
   ;; genuine time-frame write would use), and reads it back with the same nonzero-guarded
   ;; lazy-init idiom used for perm-list/task-node-info at 1144 and 1168. (method 27
   ;; game-info) then treats the loaded pointer as a plain (array float): length read at +0
   ;; (l.w), data at +12, walked in two 20-byte (5-float) rows selected by a caller-supplied
   ;; row index, doing a ranked insertion of a caller-supplied float among each row's 5
   ;; entries -- the standard best-times/leaderboard shape, and it reads
   ;; *highscore-info-array* in the same body. No instruction in this object touches bytes
   ;; 1416-1419 at all, so pause-start-time's own low 4 bytes stay exactly as landed; only
   ;; the proven upper 4 bytes are declared here. Retirement condition: a decode of whatever
   ;; object calls (method 27 game-info) or constructs game-info's continue/race-position
   ;; system, which may name this field for real.
   (best-times                           (array float)                         :offset 1420) ;; guessed by decompiler
   (game-score                           (array float)                          :offset-assert 1424) ;; guessed by decompiler
   (goal                                 float                                  :offset-assert 1428)
   (miss                                 float                                  :offset-assert 1432)
   (miss-max                             float                                  :offset-assert 1436)
   (health-bar-vehicle                   float                                  :offset-assert 1440)
   (pause-menu                           handle                                 :offset-assert 1448)
   (current-vehicle                      uint8                                  :offset-assert 1456) ;; vehicle-type-u8
   (collision-damage-multiplier          float                                  :offset-assert 1460)
   (traction-multiplier                  float                                  :offset-assert 1464)
   (turbo-factor                         float                                  :offset-assert 1468)
   (turbo-disabled                       int8                                   :offset-assert 1472)
   (turbo-last-disabled                  int32                                  :offset-assert 1476)
   (fragile-vehicle                      basic                                  :offset-assert 1480)
   (music-data                           uint32                         4       :offset-assert 1484)
   (music-info                           uint32                                 :offset 1484)
   (jukebox-track                        uint8                                  :offset 1484) ;; update-jukebox-music's mod-21 track cursor, byte-cycled in the low byte of music-data[0]
   (playing-grand-prix?                  grand-prix                             :offset 1496)
   (grand-prix-index                     uint32                                 :offset-assert 1500)
   (collision-vs-rbody-damage-multiplier float                                  :offset-assert 1504)
   (global-speed-factor                  float                                  :offset-assert 1508)
   (this-race-grand-prix-score           uint32                        23      :offset-assert 1512)
   (cumulative-grand-prix-score          uint32                        23      :offset-assert 1604)
   (driver-info                          uint64                                 :offset-assert 1696)
   (driver-info2                         uint64                                 :offset 1696)
   (driver-unlock                        uint32                                 :offset 1696)
   (driver-award                         uint32                                 :offset 1700)
   )
  :method-count-assert 31
  :size-assert         #x6a8
  :flag-assert         #x1f000006a8
  (:methods
    (initialize! (_type_ symbol game-save string resetter-spec) _type_) ;; 9
    (game-info-method-10 () none) ;; 10 ;; (give (_type_ symbol float handle) float)
    (game-info-method-11 () none) ;; 11 ;; (task-complete? (_type_ game-task) symbol)
    (game-info-method-12 () none) ;; 12 ;; (subtask-index-by-name (_type_ string) int)
    (game-info-method-13 (_type_ object) none) ;; 13 ;; (actor-perm (_type_ actor-id) entity-perm)
    (game-info-method-14 (_type_ object) none) ;; 14 ;; (task-perm-by-index (_type_ int) entity-perm)
    (game-info-method-15 (_type_ object) none) ;; 15 ;; (copy-perms-from-level! (_type_ level) int)
    (game-info-method-16 (_type_ object) none) ;; 16 ;; (copy-perms-to-level! (_type_ level) int)
    ;; og:preserve-this signature fix, R3a (#122): game-info_ir2.asm (method 9 game-info)
    ;; op 830 and op 904, and (anon-function 14 game-info) op 37, all dispatch this slot
    ;; (vtable offset 84 = 16 + 4*17) with one int argument (the view index from
    ;; view-get-active-index). Its return value is stored through loosely and, at the
    ;; play-mode spawn site, flows into the same slot continue-name would otherwise
    ;; occupy (game-info_ir2.asm op 899-907), so the return is typed as the broader
    ;; object rather than int. The old zero-arg "debug-inspect (symbol)" guess does not
    ;; match either the arg count or the arg type; fixed the same way R2 fixed method 27.
    (game-info-method-17 (_type_ int) object) ;; 17
    ;; og:preserve-this signature fix, R3a (#122): game-info_ir2.asm (method 9 game-info)
    ;; op 65-69 dispatches this slot (vtable offset 88 = 16 + 4*18) with one string
    ;; argument (the caller's continue-name), and the call site casts the return back to
    ;; string and uses it as the validated continue name. The old zero-arg
    ;; "get-current-continue-forced ()" guess does not match the arg count; fixed the
    ;; same way R2 fixed method 27.
    (game-info-method-18 (_type_ string) string) ;; 18
    ;; og:preserve-this signature fix, net-start rung (issue 571): landed for real in
    ;; game-info.gc this rung. R5a's own decode of net-start.gc's listener-continue
    ;; (net-start_ir2.asm) proves the call shape directly: it dispatches this slot
    ;; (vtable offset 92 = 16 + 4*19) with a single string argument (the continue
    ;; name) and casts the return to string for its own "can't find continue ~A~%"
    ;; error path, while the true match value threaded through is a continue-point
    ;; pointer (matching the retained comment below and start-1's own call shape per
    ;; all-types.gc's R5a note). Replaces the reduced () none placeholder that
    ;; blocked start-1's own transcription (all-types.gc:48309-48317).
    (get-continue-by-name (_type_ string) continue-point) ;; 19
    (set-continue! (_type_ basic int) continue-point) ;; 20 ;; jakx: third arg is player index, jak3 had symbol
    (game-info-method-21 () none) ;; 21 ;; (game-info-method-21 (_type_) none)
    (game-info-method-22 (_type_ object object object) none) ;; 22 ;; (save-game (_type_ game-save string) game-save)
    ;; og:preserve-this signature fix, R3a (#122): game-info_ir2.asm (method 9
    ;; game-info) op 825, and (anon-function 14 game-info) op 31, both dispatch this
    ;; slot (vtable offset 108 = 16 + 4*23) with one game-save argument, matching the
    ;; existing "load-game" guess comment's arg count exactly; only the declared arg
    ;; count (previously 0) needed the fix. Note: the leg brief's R3 addendum named
    ;; "method 22" as the continue-validation slot and "methods 24 and 27" as
    ;; anon-function-14's vtable calls; direct machine-code slot arithmetic (validated
    ;; twice against set-continue!'s already-correct slot 20 and this method's own slot
    ;; 23) shows the actual slots exercised are 17, 18, 20 and 23, not 22/24. See the
    ;; R3a landing report for the full derivation; 22 and 24 are not dispatched anywhere
    ;; in this decode and are left untouched.
    (game-info-method-23 (_type_ game-save) game-save) ;; 23
    (game-info-method-24 () none) ;; 24 ;; (you-suck-stage (_type_ symbol int) int)
    (game-info-method-25 (_type_) none) ;; 25 ;; (you-suck-scale (_type_ symbol int) float)
    (game-info-method-26 (_type_) none) ;; 26 ;; (get-next-attack-id! (_type_) uint)
    ;; og:preserve-this arg types proven from game-info_ir2.asm op 0-6: a1 is multiplied by
    ;; 20 to select one of best-times' two 5-float rows (int), a2 is read with mtc1 as a
    ;; float and compared against 0.0 to short-circuit (float); v0 returns -1 or a row index
    ;; 0-4 (int). The trailing guess-comment's single-float "game-score" signature predates
    ;; this decode and dropped the row-index arg; both a1 and a2 come in flagged
    ;; <uninitialized> (caller-supplied), so the declared arg count was the reason
    ;; "Could not figure out load" fired on the offset-1420 read even after best-times
    ;; landed: with the old () signature the decompiler never bound a0 to game-info at all.
    (game-info-method-27 (_type_ int float) int) ;; 27 ;; (game-info-method-27 (_type_ int game-score float) int)
    (game-info-method-28 () none) ;; 28 ;; (get-game-score-ref (_type_ int) (pointer float))
    (game-info-method-29 (_type_) none) ;; 29 ;; (game-info-method-29 (_type_ int) int)
    (game-info-method-30 (_type_ object object) none) ;; 30 ;; (get-highscore-rank (_type_ int float) int)
    )
  )

;; og:preserve-this hand-written until game-info-h's top-level decompiles; the original
;; creates *game-info* the same way (static instance, mode 'debug).
(define-perm *game-info* game-info (new 'static 'game-info :mode 'debug))

;; og:preserve-this null-handle arming (issue 594): the static above zero-fills
;; player-info, and a zero handle is TRUTHY in GOAL, so handle->process's #f guard
;; passes and dereferences goal 0. The first victim was the debug menu's
;; construction-time dm-setting-vehicle-tuning callbacks, which killed every -debug
;; boot at default-menu's link-and-exec; the same zero also reaches the field's six
;; other landed readers (gsound.gc:748, generic-obs.gc:2956, settings.gc:1702, the
;; in-game-menu huds). jak3's twin arms its nullable static fields in the
;; initializer itself (jak3 game-info-h.gc:459 arms current-continue/last-continue);
;; jakx's nullables live inside the player-info inline array, which a static
;; initializer cannot reach, so they are armed here instead. Zero-guarded so a
;; re-link under define-perm (which preserves the live object) can never clobber a
;; real handle or continue pointer mid-session.
(dotimes (i 2)
  (if (zero? (the-as int (-> *game-info* player-info i vehicle)))
      (set! (-> *game-info* player-info i vehicle) (the-as handle #f))
      )
  (if (zero? (the-as int (-> *game-info* player-info i current-continue)))
      (set! (-> *game-info* player-info i current-continue) (the-as continue-point #f))
      )
  (if (zero? (the-as int (-> *game-info* player-info i last-continue)))
      (set! (-> *game-info* player-info i last-continue) (the-as continue-point #f))
      )
  )

;; og:preserve-this: the load-state family lives here (not in load-state.gc) so that
;; gsound.o, which compiles earlier and calls want-sound-banks, can see the method
;; declarations. jak3 keeps its load-state deftype in game-info-h.gc for the same reason.

(deftype level-buffer-state (structure)
  ((name          symbol  :offset-assert 0) ;; guessed by decompiler
   (display?      symbol  :offset-assert 4) ;; guessed by decompiler
   (force-vis?    symbol  :offset-assert 8) ;; guessed by decompiler
   (force-inside? symbol  :offset-assert 12) ;; guessed by decompiler
   (slot          int32   :offset-assert 16)
   (force-reload  basic   :offset-assert 20)
   )
  :allow-misaligned
  :method-count-assert 9
  :size-assert         #x18
  :flag-assert         #x900000018
  )

(deftype level-buffer-state-split (structure)
  ((name     basic     :offset-assert 0)
   (display? symbol 2 :offset-assert 4)
   )
  :pack-me
  :method-count-assert 9
  :size-assert         #xc
  :flag-assert         #x90000000c
  )

(deftype load-state (basic)
  ((want            level-buffer-state           18  :inline :offset-assert 4) ;; guessed by decompiler
   (want-exp        level-buffer-state           18  :inline :offset-assert 580) ;; guessed by decompiler
   (want-split      level-buffer-state-split     18  :inline :offset-assert 1156)
   (target          level-buffer-state           18  :inline :offset-assert 1372) ;; guessed by decompiler
   (want-sound      sound-bank-state             7  :inline :offset-assert 1948) ;; guessed by decompiler
   (target-sound    sound-bank-state             7  :inline :offset-assert 2060) ;; guessed by decompiler
   (vis-nick        symbol                           :offset-assert 2172) ;; guessed by decompiler
   (command-list    pair                             :offset-assert 2176) ;; guessed by decompiler
   (object-name     string                       256 :offset-assert 2180) ;; guessed by decompiler
   (object-status   basic                        256 :offset-assert 3204) ;; guessed by decompiler
   (update-callback (function load-state object)     :offset-assert 4228) ;; guessed by decompiler
   )
  :method-count-assert 27
  :size-assert         #x1088
  :flag-assert         #x1b00001088
  (:methods
    (new (symbol type) _type_) ;; 0 ;; (new (symbol type) _type_)
    (reset! (_type_) _type_) ;; 9
    (update! (_type_) int) ;; 10
    (want-levels (_type_ (pointer symbol)) int) ;; 11
    (want-sound-banks (_type_ (pointer symbol)) none) ;; 12
    (want-display-level (_type_ symbol symbol) int) ;; 13
    (load-state-method-14 (_type_ symbol symbol int) none) ;; 14 ;; (want-vis-level (_type_ symbol) none)
    (want-vis-level (_type_ symbol) none) ;; 15 ;; jak3 slot 14; jakx inserts a method at 14
    (want-force-vis (_type_ symbol symbol) int) ;; 16 ;; jak3 slot 15
    (want-force-inside (_type_ symbol symbol) none) ;; 17 ;; jak3 slot 16
    (execute-commands-up-to (_type_ float) none) ;; 18 ;; jak3 slot 17
    (backup-load-state-and-set-cmds (_type_ pair) int) ;; 19 ;; jak3 slot 18
    (load-state-method-20 (_type_) int) ;; 20 ;; (restore-load-state (_type_) int)
    (restore-load-state (_type_) int) ;; 21 ;; jak3 slot 20
    (add-borrow-levels (_type_) none) ;; 22 ;; jak3 slot 21
    ;; og:preserve-this arity correction (#192, vehicle leg survey L1, "the cheapest
    ;; unblock on the board"): all three were () none, zero declared arguments,
    ;; against bodies that read a0-a3 -- the exact AGENTS.md argument-count trap.
    ;; That is also why their own decompile in load-state.gc still fails ("failed
    ;; type prop", "Function may read a register that is not set") and is commented
    ;; out; the wrong arity is the signature of the failure, not a side effect of it.
    ;; Arities proven from the three call sites in net-world.gc's own decode
    ;; (...scratchpad\networld-decode\out\jakx\net-world_ir2.asm), by which argument
    ;; registers are set immediately before each jalr:
    ;;   method 23, vtable+108 (16 + 4*23): ops[209-215] (asm:11688-11696) and the
    ;;     two calls at ops[340-356]/[358-370] (asm:11989-12010, 12018-12034) all set
    ;;     a1, a2 AND a3 before the call -- 4 args (self + 3).
    ;;   method 24, vtable+112 (16 + 4*24): ops[400-412] (asm:12103-12122) sets only
    ;;     a1 and a2 before the call; a3 is untouched since the prior call -- 3 args
    ;;     (self + 2).
    ;;   method 26, vtable+120 (16 + 4*26): ops[371-396] (asm:12037-12090) sets a1,
    ;;     a2, and a3 (a3 materialized via the s7/s7+4 boolean idiom, i.e. a real
    ;;     #t/#f, not a leftover) before the call -- 4 args (self + 3).
    ;; Corroborated independently by load-state.gc's own commented-out decode
    ;; attempts (:1341-1344, :1579-1582, :1615-1617): method 23 and 26 each flag all
    ;; four registers a0-a3 as "may read a register that is not set"; method 24 flags
    ;; only a0-a2, no a3. Argument types are STRONG, not PROVEN: a1 is used
    ;; arithmetically as a small array index in every body (car-level-array-style
    ;; ((a1 + N) << 5) indexing); a2/a3 are tested for truthiness and stored raw into
    ;; word fields, and method 23's a2 is passed straight to car-type-from-level-name
    ;; (typed (function symbol vehicle-type) in that same commented decode), which
    ;; proves a2 symbol there specifically. Signatures only, per the vehicle leg
    ;; brief's own scoping of this item -- no bodies land in this commit.
    (load-state-method-23 (_type_ int symbol symbol) none) ;; 23
    (load-state-method-24 (_type_ int symbol) none) ;; 24
    (load-state-method-25 (_type_ symbol) none) ;; 25
    (load-state-method-26 (_type_ int symbol symbol) none) ;; 26
    )
  )

;; og:preserve-this issue 559/562: this type declared (new (symbol type) _type_) with no
;; defmethod new anywhere in goal_src, so slot 0 fell through to basic's C new_basic, which
;; returns a zeroed object instead of retail's initialized one (update-callback left as
;; whatever garbage object-new's allocation happened to contain, and none of reset!'s
;; per-field clearing run). Three live construction sites exist today (load-state.gc:679,
;; 1313, 1316), including the two module-level *load-state*/*backup-load-state* globals, so
;; every boot was already running on a zeroed load-state before this landed. Landed verbatim
;; from a fresh scoped decode of the game-info-h object (the file that declares this type's
;; own deftype, same as effect-control-h), jak3-parity byte-for-byte (jak3
;; game-info-h.gc:262-267). Unblocking the decode itself needed a companion fix, landed
;; alongside this in decompiler/config/jakx/all-types.gc: *lobby-adv-selected-cup* and
;; *lobby-adv-selected-level* were left unresolvable, which failed game-info-h's
;; top-level-login and suppressed the whole file's output, this method included.

;; definition for method 0 of type load-state
(defmethod new load-state ((allocation symbol) (type-to-make type))
  (let ((a0-1 (object-new allocation type-to-make (the-as int (-> type-to-make size)))))
    (set! (-> a0-1 update-callback) #f)
    (reset! a0-1)
    )
  )
