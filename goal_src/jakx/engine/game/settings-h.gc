(deftype cam-setting-state (structure)
  ((current  cam-setting-data  :inline)
   (target   cam-setting-data  :inline)
   (default  cam-setting-data  :inline)
   )
  )


(deftype engine-group (structure)
  ((engine       engine)
   (engine-pers  engine-pers)
   (engine-hi    engine)
   )
  )


(deftype setting-control (basic)
  ((user-current user-setting-data :inline :offset-assert 16)
   (user-target  user-setting-data :inline :offset-assert 800)
   (user-default user-setting-data :inline :offset-assert 1584)
   (cam-settings cam-setting-state           4 :inline      :offset-assert 2368)
   (engine       engine                    :offset-assert 7168) ;; guessed by decompiler
   (engine-pers  engine-pers               :offset-assert 7172) ;; guessed by decompiler
   (engine-hi    engine                    :offset-assert 7176) ;; guessed by decompiler
   (cam-engines  engine-group           4       :offset-assert 7180) ;; per-camera engine groups, indexed by camera id
   )
  :method-count-assert 25
  :size-assert         #x1c1c
  :flag-assert         #x1900001c1c
  (:methods
    (new (symbol type int) _type_) ;; 0
    (setting-control-method-9 (_type_ int process symbol object object object) connection) ;; 9 ;; (add-setting (_type_ process symbol object object object) connection); jakx puts the camera id first
    (setting-control-method-10 (_type_ int symbol time-frame symbol symbol float object) none) ;; 10 ;; (persist-with-delay (_type_ symbol time-frame symbol symbol float int) none); jakx: camera id first, then name/delay/param0-3
    (setting-control-method-11 (_type_ int process symbol object object object) connection) ;; 11 ;; (set-setting (_type_ process symbol object object object) connection); jakx puts the camera id first
    (setting-control-method-12 (_type_ int process object) none) ;; 12 ;; (remove-setting (_type_ process symbol) none); jakx puts the camera id first
    (setting-control-method-13 (_type_ engine-pers object object object object) none) ;; 13 ;; (kill-persister (_type_ engine-pers object) none)
    (setting-control-method-14 (_type_ symbol int symbol symbol float int) none) ;; 14 ;; (setting-control-method-14 (_type_ object) connectable)
    (setting-control-method-15 (_type_ object object object object object) connectable) ;; 15 ;; (get-setting (_type_ object) connectable)
    (setting-control-method-16 (_type_ process object) none) ;; 16 ;; remove-setting; arity from the m16 body in settings.gc (arg2 never read; the 4-arg decl orphaned a phantom a3 at every call site)
    (setting-control-method-17 (_type_ symbol object object object) connection) ;; 17 ;; (set-setting-by-param (_type_ symbol object object object) connection)
    (setting-control-method-18 (_type_ int object object) user-setting-data) ;; 18 ;; (apply-settings (_type_) user-setting-data); jakx: camera id first (cam-disconnect-by-key)
    (setting-control-method-19 (_type_ object) user-setting-data) ;; 19 ;; (update (_type_) user-setting-data)
    (setting-control-method-20 (_type_ object) connection) ;; 20
    (setting-control-method-21 (_type_ object) none) ;; 21
    (setting-control-method-22 (_type_ object object object object) none) ;; 22
    (setting-control-method-23 (_type_) none) ;; 23
    (setting-control-method-24 (_type_) none) ;; 24 ;; called by display-loop init
    )
  )


(defmethod new setting-control ((allocation symbol) (type-to-make type) (arg0 int))
  (let ((s4-0 (object-new allocation type-to-make (the-as int (-> type-to-make size)))))
    (set! (-> s4-0 engine) ((method-of-type engine new) allocation engine 'setting-control arg0 connection))
    (set! (-> s4-0 engine-hi) ((method-of-type engine new) allocation engine 'setting-control arg0 connection))
    (set! (-> s4-0 engine-pers)
          ((method-of-type engine-pers new) allocation engine-pers 'setting-control arg0 connection-pers)
          )
    (dotimes (s3-0 4)
      (let ((group (new 'global 'engine-group)))
        (set! (-> s4-0 cam-engines s3-0) group)
        (set! (-> group engine)
              ((method-of-type engine new) allocation engine 'setting-control arg0 connection)
              )
        (set! (-> group engine-hi)
              ((method-of-type engine new) allocation engine 'setting-control arg0 connection)
              )
        (set! (-> group engine-pers)
              ((method-of-type engine-pers new) allocation engine-pers 'setting-control arg0 connection-pers)
              )
        )
      )
    s4-0
    )
  )
