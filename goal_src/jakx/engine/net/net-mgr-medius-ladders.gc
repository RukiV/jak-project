  :flag-assert         #xb0000013c
  (:methods
    (net-player-ladder-stats-info-method-9 (_type_ object) none) ;; 9
    (net-player-ladder-stats-info-method-10 (_type_ object) none) ;; 10
    )
  )

;; og:preserve-this bring-up stub: (code init-state lobby-menu-manager)
;; (menu-road rung 2) dispatches this via method-of-type, so a declared
;; method with no defmethod anywhere would link the call to 0
;; (check_extern_defun's own e2 class, the declared-new-without-defmethod
;; defect issue 562 already names). Zero side effects until the real
;; per-stat body lands.
(defmethod net-player-ladder-stats-info-method-10 ((this net-player-ladder-stats-info) (arg0 object))
  (none)
  )

;; og:preserve-this bring-up stub: (code init-state lobby-menu-manager)
;; (menu-road rung 2) calls this with two explicit #t args and discards
