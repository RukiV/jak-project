;;-*-Lisp-*-
(in-package goal)

;; name: scert-2-h.gc
;; name in dgo: scert-2-h
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

;; og:preserve-this bring-up: this object's own decode is genuinely empty (its
;; _REF.gc is the standard "failed to figure out what this is: 0" no-op marker),
;; so it hosts a build-order relocation instead. rsa-key, net-address,
;; net-address-list and net-connection-info moved here from net-mgr-h.gc:
;; scert-5-h through scert-8-h need them :inline, and net-mgr-h.o (game.gd slot
;; 131) compiles after scert-5-h (slot 122), so the four had to move earlier.
;; medius-player-online-state lands here for the first time for the same
;; reason, needed :inline by scert-6-h through scert-8-h. All five are
;; all-types-only layout types with no game-registered home anywhere in the
;; corpus (confirmed by decode: no object other than net-mgr-h ever defined the
;; first four, and no object at all defines medius-player-online-state).
;; scert-2-h.gc is the latest already-landed scert-family header that still
;; precedes every consumer, chosen over scert-3-h/scert-4-h specifically
;; because those two objects have their own real decoded bodies still unlanded
;; (out of scope for this wave); appending here instead of there avoids a
;; future scert-3-h/scert-4-h landing overwriting this block when it copies a
;; fresh decode dump below its own DECOMP BEGINS marker. Transcribed verbatim
;; from decompiler/config/jakx/all-types.gc (the first four by way of
;; net-mgr-h.gc's own prior verbatim transcription), ordered so every :inline
;; field type is defined above its user: rsa-key and net-address have no deps,
;; net-address-list inlines net-address, net-connection-info inlines rsa-key +
;; net-address-list; medius-player-online-state has no deps of its own.

(deftype rsa-key (structure)
  ((key uint32 16 :offset-assert 0)
   )
  :pack-me
  :method-count-assert 9
  :size-assert         #x40
  :flag-assert         #x900000040
  )

(deftype net-address (structure)
  ((address-type int32      :offset-assert 0)
   (address      int8   16 :offset-assert 4)
   (port         uint32     :offset-assert 20)
   )
  :pack-me
  :method-count-assert 9
  :size-assert         #x18
  :flag-assert         #x900000018
  )

(deftype net-address-list (structure)
  ((a-address-list net-address 2 :inline :offset-assert 0)
   )
  :pack-me
  :method-count-assert 9
  :size-assert         #x30
  :flag-assert         #x900000030
  )

(deftype net-connection-info (structure)
  ((e-type        int32                    :offset-assert 0)
   (address-list  net-address-list :inline :offset-assert 4)
   (world-id      int32                    :offset-assert 52)
   (server-key    rsa-key          :inline :offset-assert 56)
   (a-session-key uint8          17      :offset-assert 120)
   (a-access-key  uint8          17      :offset-assert 137)
   )
  :pack-me
  :method-count-assert 9
  :size-assert         #x9a
  :flag-assert         #x90000009a
  )

(deftype medius-player-online-state (structure)
  ((connect-status        int32      :offset-assert 0)
   (medius-lobby-world-id int32      :offset-assert 4)
   (medius-game-world-id  int32      :offset-assert 8)
   (lobby-name            uint8 64 :offset-assert 12)
   (game-name             uint8 64 :offset-assert 76)
   )
  :pack-me
  :method-count-assert 9
  :size-assert         #x8c
  :flag-assert         #x90000008c
  )

;; og:preserve-this bring-up: rsa-keypair relocates here for the same reason
;; as the five above: scert-9-h needs it (medius-initialize-in-params and
;; medius-initialize-bare-in-params reference it as a plain, non-:inline
;; field), and it has no registered home anywhere in the corpus (confirmed by
;; decode: nothing else in goal_src mentions it). Transcribed verbatim from
;; decompiler/config/jakx/all-types.gc, a single live declaration with no
;; dead block to resurrect. No :pack-me in the source and none needed: it
;; embeds two rsa-key :inline (already available above) back to back with no
;; gap either way (0 and 64, rsa-key's own size is exactly 0x40).

(deftype rsa-keypair (structure)
  ((public-key  rsa-key :inline :offset-assert 0)
   (private-key rsa-key :inline :offset-assert 64)
   )
  :method-count-assert 9
  :size-assert         #x80
  :flag-assert         #x900000080
  )

;; og:preserve-this bring-up: net-audio-data-characteristics, net-video-data-
;; characteristics and net-stream-media-params duplicate here from their
;; genuine home, stream-media-h.gc (game.gd slot 357), for the same build-
;; order reason as the five above: scert-9-h needs net-stream-media-params
;; :inline (via medius-connect-in-params, itself genuinely registered to
;; scert-9-h, slot 126), which compiles long before stream-media-h.gc. Unlike
;; the five above, these three are not homeless: stream-media-h.gc already
;; carries a real landed copy for stream-media.gc's own extern (game.gd slot
;; 430). A second copy this early is a build-order duplication, not a
;; relocation: moving the originals out of stream-media-h.gc would touch a
;; file outside this wave and outside the scert family. GOAL rejects a type
;; redefined with a different :pack-me setting, so this copy stays byte-
;; identical to stream-media-h.gc's, which now also carries :pack-me on
;; net-audio-data-characteristics for the same reason medius-connect-in-
;; params needs it below: net-stream-media-params must embed at offset 156,
;; not the 160 default packing produces, proven by scoped decode against
;; scert-9-h's own compiled method 3 (see stream-media-h.gc's comment).
;; og:preserve-this issue 540 sweep: held out of the single-home checker
;; (scripts/check_type_singlehome.py ALLOWLIST), not merged. new_type
;; rewrites every custom method slot on every deftype execution of the
;; same interned type (issue 534), but neither this copy nor
;; stream-media-h.gc's hosts a defmethod for any of these three types, so
;; there is no vtable to wipe; this is purely the build-order duplication
;; the paragraph above already documents.

(deftype net-audio-data-characteristics (structure)
  ((n-channels-in         int32  :offset-assert 0)
   (n-bits-per-sample-in  int32  :offset-assert 4)
   (n-sample-rate-in      int32  :offset-assert 8)
   (n-channels-out        int32  :offset-assert 12)
   (n-bits-per-sample-out int32  :offset-assert 16)
   (n-sample-rate-out     int32  :offset-assert 20)
   )
  :pack-me
  :method-count-assert 9
  :size-assert         #x18
  :flag-assert         #x900000018
  )

(deftype net-video-data-characteristics (structure)
  ((xsize int32  :offset-assert 0)
   (ysize int32  :offset-assert 4)
   )
  :pack-me
  :method-count-assert 9
  :size-assert         #x8
  :flag-assert         #x900000008
  )

(deftype net-stream-media-params (structure)
  ((b-default-set                       int32                                  :offset-assert 0)
   (b-use-stream-media                  int32                                  :offset-assert 4)
   (num-channels                        uint32                                 :offset-assert 8)
   (max-incoming-audio-streams          uint32                                 :offset-assert 12)
   (record-no-data-timeout              uint32                                 :offset-assert 16)
   (send-buffer-size                    uint32                                 :offset-assert 20)
   (recv-buffer-size                    uint32                                 :offset-assert 24)
   (grid-type                           int32                                  :offset-assert 28)
   (audio-data-characteristics          net-audio-data-characteristics :inline :offset-assert 32)
   (pf-audio-record-callback            basic                                  :offset-assert 56)
   (p-audio-record-callback-data        basic                                  :offset-assert 60)
   (pf-audio-play-callback              basic                                  :offset-assert 64)
   (p-audio-play-callback-data          basic                                  :offset-assert 68)
   (video-data-characteristics          net-video-data-characteristics :inline :offset-assert 72)
   (pf-video-record-callback            basic                                  :offset-assert 80)
   (p-video-record-callback-data        basic                                  :offset-assert 84)
   (pf-video-play-callback              basic                                  :offset-assert 88)
   (p-video-play-callback-data          basic                                  :offset-assert 92)
   (pf-custom-video-record-callback     basic                                  :offset-assert 96)
   (p-custom-video-record-callback-data basic                                  :offset-assert 100)
   (pf-custom-video-play-callback       basic                                  :offset-assert 104)
   (p-custom-video-play-callback-data   basic                                  :offset-assert 108)
   )
  :pack-me
  :method-count-assert 9
  :size-assert         #x70
  :flag-assert         #x900000070
  ;; field p-audio-record-callback-data uses ~A with a signed load. field p-audio-play-callback-data uses ~A with a signed load. field p-video-record-callback-data uses ~A with a signed load. field p-video-play-callback-data uses ~A with a signed load. field p-custom-video-record-callback-data uses ~A with a signed load. field p-custom-video-play-callback-data uses ~A with a signed load.
  )
