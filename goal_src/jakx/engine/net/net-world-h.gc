;;-*-Lisp-*-
(in-package goal)

;; name: net-world-h.gc
;; name in dgo: net-world-h
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

(deftype green-room-stats (structure)
  ((intro-end-time        int32     :offset 0)
   (scheduled-finish-time int32     :offset 4)
   (scores                uint16 6 :offset 8)
   (laps                  uint8 6 :offset 20)
   )
  )

(deftype net-world-game-options (structure)
  ((advanced-options game-task-advanced-options :inline :offset 0)
   )
  )

;; empty uint64 wrapper, identical to all-types; defined here because the game build
;; compiles this file before any vehicle source that would otherwise carry it
(deftype vehicle-load-parts (uint64)
  ()
  )

(deftype net-world-staging-player (structure)
  ((vehicle-load-parts       vehicle-load-parts  :offset 0)
   (vehicle-tuning-info      uint32  :offset 8)
   (vehicle-selection        int8    :offset 12)
   (desired-driver-selection int8    :offset 13)
   (flags                    uint8   :offset 14)
   (team-id                  uint8   :offset 15)
   (player-num               int8    :offset 16)
   (base-color               uint32  :offset 20)
   (stripe-color             uint32  :offset 24)
   (skill-level              int32   :offset 28)
   )
  :allow-misaligned
  (:methods
    (net-world-staging-player-method-9 (_type_) none) ;; 9
    )
  )

(deftype net-world-state (structure)
  ((players            net-world-staging-player                24    :inline  :offset 0)
   (assigned-drivers   uint8                24      :offset 768)
   (game-creator-ip    uint32                         :offset 792)
   (game-creation-time uint32                         :offset 796)
   (game-start-time    int32                          :offset 800)
   (total-pause-time   int32                          :offset 804)
   (task-node-name     uint8                32      :offset 808)
   (player-ready-flags uint8                          :offset 840)
   (flags              int8                           :offset 841)
   (max-humans         int8                           :offset 842)
   (buddy-slots        int8                           :offset 843)
   (clan-slots         int8                           :offset 844)
   (ai-slots           int8                           :offset 845)
   (vehicle-class      int8                           :offset 846)
   (options            net-world-game-options :inline :offset 848)
   (clan-ids           uint32                2       :offset 856)
   (green-room-stats   green-room-stats       :inline :offset 864)
   (time-of-day        int8                           :offset 890)
   )
  )
(deftype net-world (process-nettable)
  ((net-state                  net-world-state :inline :offset 192)
   (is-late-join               basic                   :offset 1084)
   (need-start-load            basic                   :offset 1088)
   (current-garage-player      int32                   :offset 1092)
   (current-garage-spare-slot  int32                   :offset 1096)
   (cont                       basic                   :offset 1100)
   (task                       uint8                   :offset 1104)
   (task-node                  uint16                  :offset 1106)
   (task-info                  basic                   :offset 1108)
   (task-node-info             basic                   :offset 1112)
   (player-to-vehicle-slot-map int8         24      :offset 1116)
   (vehicle-slot-to-player-map uint8         6       :offset 1140)
   )
  :method-count-assert 87
  :size-assert         #x47a
  :flag-assert         #x5703f0047a
  ;; og:preserve-this networld rung: slots 42-44 install `state` objects (a
  ;; heap-built parent/code/trans/post/enter/event struct), not raw function
  ;; labels, per a scoped decode of this worktree's own net-world.o
  ;; (allowed_objects: [net-world]): `(method-set! net-world 42 gp-0)` then
  ;; `gp-0` gets its declared-offset-36 event and declared-offset-20 code
  ;; fields patched (net-world_ir2.asm:775-784); `(method-set! net-world 43
  ;; gp-1)` then gp-1's declared-offset-12 exit and declared-offset-20 code
  ;; fields (net-world_ir2.asm:785-794, code = anon-function 69, the
  ;; recovered title/attract handoff body); `(method-set! net-world 44
  ;; gp-2)` then gp-2's declared-offset-20 code field
  ;; (net-world_ir2.asm:795-800). Every slot from 45 on installs a bare
  ;; function label directly with no struct-build sequence, confirming they
  ;; stay plain methods. No retail name is recoverable for any of the three:
  ;; find_defstates only matches a top-level `(set! SYMBOL (new 'static
  ;; 'state ...))` form and produces no disagreement here (it ran clean, zero
  ;; matches, on this same scoped decode), because retail installs these
  ;; anonymously straight from method-set! with no named top-level symbol
  ;; anywhere in net-world.o. Named net-world-state-N per this campaign's own
  ;; convention for a slot with no recoverable retail name (light-trail-
  ;; tracker-state-15 precedent, 0f11ed85d). All three state bodies stay
  ;; held: state 43's :code (anon-function 69, the full title/attract
  ;; handoff already read out in the bootlad dossier) fails "Failed to guess
  ;; stack use for 96"; state 43's :exit (anon-function 68) is the only
  ;; handler that decodes clean, a trivial `'()`, not landable on its own
  ;; without :code; state 42's :event (anon-function 70) fails "Could not
  ;; figure out load: (set! v1 (l.d (+ gp 16)))"; state 42's :code
  ;; (anon-function 71) fails on the untyped extern *medius-enemy-clan-id*;
  ;; state 44's :code (anon-function 67) fails "Called a function, but we do
  ;; not know its type".
  (:state-methods
    net-world-state-42 ;; 42
    net-world-state-43 ;; 43
    net-world-state-44 ;; 44
    )
  (:methods
    (net-world-method-45 (_type_ object) none) ;; 45
    (net-world-method-46 (_type_ object) none) ;; 46
    (net-world-method-47 (_type_ object object object object) none) ;; 47
    (net-world-method-48 (_type_ object object) none) ;; 48
    (net-world-method-49 (_type_ object object) none) ;; 49
    (net-world-method-50 (_type_ object object) none) ;; 50
    (net-world-method-51 (_type_ object object) none) ;; 51
    (net-world-method-52 (_type_ object object) none) ;; 52
    (net-world-method-53 (_type_ object object object) none) ;; 53
    (net-world-method-54 (_type_) none) ;; 54
    (net-world-method-55 (_type_ object object object) none) ;; 55
    (net-world-method-56 (_type_ object object object object) none) ;; 56
    (net-world-method-57 (_type_ object) none) ;; 57
    (net-world-method-58 (_type_ object) none) ;; 58
    (net-world-method-59 (_type_ object) none) ;; 59
    (net-world-method-60 (_type_ object object) none) ;; 60
    (net-world-method-61 (_type_ object) none) ;; 61
    (net-world-method-62 (_type_ object object) none) ;; 62
    (net-world-method-63 (_type_) none) ;; 63
    ;; og:preserve-this signature fix, R1 of the retail-staging ladder (#192):
    ;; net-world_ir2.asm:4038-4071 (4 ops) dispatches this slot with one int argument
    ;; (a player-slot index) and returns the (>= vehicle-selection 0) test as a
    ;; boolean; landed alongside set-continue-point-from-task, which calls it.
    (net-world-method-64 (_type_ int) symbol) ;; 64
    (net-world-method-65 (_type_ object) none) ;; 65
    (net-world-method-66 (_type_ object) none) ;; 66
    (net-world-method-67 (_type_ object) none) ;; 67
    (net-world-method-68 (_type_ object) none) ;; 68
    (net-world-method-69 (_type_ object) none) ;; 69
    (net-world-method-70 (_type_) none) ;; 70
    (net-world-method-71 (_type_) none) ;; 71
    (net-world-method-72 (_type_) none) ;; 72
    (net-world-method-73 (_type_ object) none) ;; 73
    (net-world-method-74 (_type_ object) none) ;; 74
    (net-world-method-75 (_type_ object) none) ;; 75
    ;; og:preserve-this signature fix, R1 of the retail-staging ladder (#192):
    ;; net-world_ir2.asm:11286-12683 dispatches this slot with one symbol argument
    ;; (the display? gate the running state passes #f/#f/#t across its three-pass
    ;; sequence) and always returns 0/none (every path ends `(set! v0 0) (ret-none)`).
    ;; Landed for slots 0-5 only this rung; the car/driver arm (steps 7-8) is stubbed.
    (net-world-method-76 (_type_ symbol) none) ;; 76
    ;; og:preserve-this signature fix, R2 of the retail-staging ladder (#192):
    ;; net-world_ir2.asm:12956-13272 dispatches this slot with zero explicit
    ;; arguments (the decompiler's own clean OpenGOAL rendering never reads "this")
    ;; and returns a boolean (ok?, mirroring method 78's shape).
    (net-world-method-77 (_type_) symbol) ;; 77
    ;; og:preserve-this signature fix, R1 of the retail-staging ladder (#192):
    ;; net-world_ir2.asm:12684-12949 dispatches this slot with zero explicit arguments
    ;; and returns a boolean (ok?, whether every ocean-all want is already resident).
    (net-world-method-78 (_type_) symbol) ;; 78
    (net-world-method-79 (_type_) none) ;; 79
    (net-world-method-80 (_type_) none) ;; 80
    (net-world-method-81 () none) ;; 81
    (net-world-method-82 (_type_) none) ;; 82
    (net-world-method-83 (_type_ object) none) ;; 83
    (net-world-method-84 (_type_ object) none) ;; 84
    (net-world-method-85 (_type_ object) none) ;; 85
    (net-world-method-86 (_type_ object) none) ;; 86
    )
  )

;; og:preserve-this vehicle-spawn-chain rung (issue 571): lands only the two
;; pieces the spawn chain itself needs from this object's clean 1,339-line
;; decode. net-player-name, prebuilt-ai-vehicle and *prebuilt-ai-vehicles*
;; sit between the landed net-world block above and net-vehicle below in the
;; retail decode order but are untouched by this rung; *net-drivers* comes
;; right after net-vehicle's own static array. All three stay held:
;; *prebuilt-ai-vehicles* and *net-drivers* both decode to an unresolved
;; <static-data LN> blob (an unsized label the decompiler could not size),
;; and none of them are read anywhere on vehicle-spawn's call path.
;; definition of type net-vehicle
(deftype net-vehicle (structure)
  ((id          uint32)
   (name        symbol)
   (levname     symbol)
   (vt          uint8)
   (ct          int8)
   (tex-name    string)
   (sound-bank  symbol)
   (index       int8)
   (cup-mask    uint32)
   (id-variant  uint32)
   (ai-levels   (array symbol))
   )
  )

;; definition for symbol *net-vehicles*, type (array net-vehicle)
