;;-*-Lisp-*-
(in-package goal)

;; name: net-world-h.gc
;; name in dgo: net-world-h
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

(deftype green-room-stats (structure)
  ((intro-end-time        int32     :offset 0)
   (scheduled-finish-time int32     :offset 4)
   (scores                uint16 6 :offset 8)
   (laps                  uint8 6 :offset 20)
   )
  )

(deftype net-world-game-options (structure)
  ((advanced-options game-task-advanced-options :inline :offset 0)
   )
  )

;; empty uint64 wrapper, identical to all-types; defined here because the game build
;; compiles this file before any vehicle source that would otherwise carry it
(deftype vehicle-load-parts (uint64)
  ()
  )

(deftype net-world-staging-player (structure)
  ((vehicle-load-parts       vehicle-load-parts  :offset 0)
   (vehicle-tuning-info      uint32  :offset 8)
   (vehicle-selection        int8    :offset 12)
   (desired-driver-selection int8    :offset 13)
   (flags                    uint8   :offset 14)
   (team-id                  uint8   :offset 15)
   (player-num               int8    :offset 16)
   (base-color               uint32  :offset 20)
   (stripe-color             uint32  :offset 24)
   (skill-level              int32   :offset 28)
   )
  :allow-misaligned
  (:methods
    (net-world-staging-player-method-9 (_type_) none) ;; 9
    )
  )

(deftype net-world-state (structure)
  ((players            net-world-staging-player                24    :inline  :offset 0)
   (assigned-drivers   uint8                24      :offset 768)
   (game-creator-ip    uint32                         :offset 792)
   (game-creation-time uint32                         :offset 796)
   (game-start-time    int32                          :offset 800)
   (total-pause-time   int32                          :offset 804)
   (task-node-name     uint8                32      :offset 808)
   (player-ready-flags uint8                          :offset 840)
   (flags              int8                           :offset 841)
   (max-humans         int8                           :offset 842)
   (buddy-slots        int8                           :offset 843)
   (clan-slots         int8                           :offset 844)
   (ai-slots           int8                           :offset 845)
   (vehicle-class      int8                           :offset 846)
   (options            net-world-game-options :inline :offset 848)
   (clan-ids           uint32                2       :offset 856)
   (green-room-stats   green-room-stats       :inline :offset 864)
   (time-of-day        int8                           :offset 890)
   )
  )
(deftype net-world (process-nettable)
  ((net-state                  net-world-state :inline :offset 192)
   (is-late-join               basic                   :offset 1084)
   (need-start-load            basic                   :offset 1088)
   (current-garage-player      int32                   :offset 1092)
   (current-garage-spare-slot  int32                   :offset 1096)
   (cont                       basic                   :offset 1100)
   (task                       uint8                   :offset 1104)
   (task-node                  uint16                  :offset 1106)
   (task-info                  basic                   :offset 1108)
   (task-node-info             basic                   :offset 1112)
   (player-to-vehicle-slot-map uint8         24      :offset 1116)
   (vehicle-slot-to-player-map uint8         6       :offset 1140)
   )
  :method-count-assert 87
  :size-assert         #x47a
  :flag-assert         #x5703f0047a
