;; definition of type net-game-mgr-vehicle-info
(deftype net-game-mgr-vehicle-info (structure)
  ((all-vehicles          uint32  6)
   (local-vehicles        uint32  6)
   (ai-vehicles           uint32  6)
   (player-vehicles       uint32  6)
   (all-vehicle-count     int8)
   (local-vehicle-count   int8)
   (ai-vehicle-count      int8)
   (player-vehicle-count  int8)
   )
  )

;; definition for method 3 of type net-game-mgr-vehicle-info
(defmethod inspect ((this net-game-mgr-vehicle-info))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'net-game-mgr-vehicle-info)
  (format #t "~1Tall-vehicles[6] @ #x~X~%" (-> this all-vehicles))
  (format #t "~1Tlocal-vehicles[6] @ #x~X~%" (-> this local-vehicles))
  (format #t "~1Tai-vehicles[6] @ #x~X~%" (-> this ai-vehicles))
  (format #t "~1Tplayer-vehicles[6] @ #x~X~%" (-> this player-vehicles))
  (format #t "~1Tall-vehicle-count: ~D~%" (-> this all-vehicle-count))
  (format #t "~1Tlocal-vehicle-count: ~D~%" (-> this local-vehicle-count))
  (format #t "~1Tai-vehicle-count: ~D~%" (-> this ai-vehicle-count))
  (format #t "~1Tplayer-vehicle-count: ~D~%" (-> this player-vehicle-count))
  (label cfg-4)
  this
  )

;; definition of type net-game-mgr
(deftype net-game-mgr (process-nettable)
  ((scheduled-finish-time  int32)
   (scheduled-finish-mode  basic)
   (sorted-ct              int8)
   (human-ct               int8)
   (sorted-ids             int8    24)
   (intro-end-time         int32)
   (hud-player-indicators  uint64  2)
   (net-players            basic)
   (stats-hud              handle  2)
   (intro-handle           uint64  2)
   (cheats                 uint16  4)
   (state-time             uint64)
   )
  (:state-methods
    net-game-mgr-state-42
    )
  (:methods
    (net-game-mgr-method-43 () none)
    (net-game-mgr-method-44 () none)
    ;; issue 531 overturns the Lane B ruling above: a landed caller with the
    ;; orphan tell is not caller evidence, it IS the defect. Callee reads a1
    ;; as a truthy/falsy flag only; all 4 real call sites explicitly set a1
    ;; right before the dispatch to either #f or a symbol-typed field
    ;; (grand-prix / grand-prix-totals). The prior (_type_ object) attempt
    ;; failed only because the call sites were never re-landed to pass the
    ;; arg; this rung re-lands them.
    (net-game-mgr-method-45 (_type_ symbol) none)
    (net-game-mgr-method-46 () none)
    (net-game-mgr-method-47 (_type_) none)
    (net-game-mgr-method-48 () none)
    (net-game-mgr-method-49 (_type_) none)
    (net-game-mgr-method-50 () none)
    (net-game-mgr-method-51 (_type_) none)
    (net-game-mgr-method-52 (_type_ object) none)
    (net-game-mgr-method-53 (_type_ object) none)
    (net-game-mgr-method-54 (_type_ object object object) none)
    (net-game-mgr-method-55 () none)
    (net-game-mgr-method-56 (_type_) none)
    (net-game-mgr-method-57 (_type_) none)
    (net-game-mgr-method-58 (_type_) none)
    (net-game-mgr-method-59 () none)
    (net-game-mgr-method-60 (_type_) none)
    (net-game-mgr-method-61 (_type_ object) none)
    (net-game-mgr-method-62 (_type_ object) none)
    (net-game-mgr-method-63 () none)
    (net-game-mgr-method-64 () none)
    (net-game-mgr-method-65 (_type_ object) none)
    (net-game-mgr-method-66 (_type_ object) none)
    (net-game-mgr-method-67 (_type_ object) none)
    (net-game-mgr-method-68 (_type_) none)
    (net-game-mgr-method-69 (_type_ object) none)
    (net-game-mgr-method-70 (_type_) none)
    (net-game-mgr-method-71 () none)
    (net-game-mgr-method-72 (_type_ object object) none)
    (net-game-mgr-method-73 (_type_) none)
    (net-game-mgr-method-74 (_type_ object) none)
    (net-game-mgr-method-75 () none)
    (net-game-mgr-method-76 () none)
    (net-game-mgr-method-77 (_type_ object) none)
    (net-game-mgr-method-78 () none)
    (net-game-mgr-method-79 () none)
    )
  )

;; definition for method 3 of type net-game-mgr
(defmethod inspect ((this net-game-mgr))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type process-nettable inspect)))
    (t9-0 this)
    )
  (format #t "~2Tscheduled-finish-time: ~D~%" (-> this scheduled-finish-time))
  (format #t "~2Tscheduled-finish-mode: ~A~%" (-> this scheduled-finish-mode))
  (format #t "~2Tsorted-ct: ~D~%" (-> this sorted-ct))
  (format #t "~2Thuman-ct: ~D~%" (-> this human-ct))
  (format #t "~2Tsorted-ids[24] @ #x~X~%" (-> this sorted-ids))
  (format #t "~2Tintro-end-time: ~D~%" (-> this intro-end-time))
  (format #t "~2Thud-player-indicators[2] @ #x~X~%" (-> this hud-player-indicators))
  (format #t "~2Tnet-players: ~A~%" (-> this net-players))
  (format #t "~2Tstats-hud[2] @ #x~X~%" (-> this stats-hud))
  (format #t "~2Tintro-handle[2] @ #x~X~%" (-> this intro-handle))
  (format #t "~2Tcheats[4] @ #x~X~%" (-> this cheats))
  (format #t "~2Tstate-time: ~D~%" (-> this state-time))
  (label cfg-4)
  this
  )

;; definition for function net-game-mgr-init-remote
;; WARN: Return type mismatch int vs none.
(defbehavior net-game-mgr-init-remote net-game-mgr ((arg0 int))
  (process-nettable-method-34 self -1 (new 'static 'rgba :r #xff :g #xff))
  (process-nettable-method-35 self arg0)
  (process-nettable-method-36 self)
  0
  (none)
  )

;; definition for method 41 of type net-game-mgr
(defmethod process-nettable-method-41 ((this net-game-mgr) (arg0 int))
  (ppointer->process (process-spawn net-game-mgr :init net-game-mgr-init-remote arg0 :name "net-game-mgr"))
  )

;; definition for method 37 of type net-game-mgr
;; WARN: Return type mismatch int vs none.
(defmethod process-nettable-method-37 ((this net-game-mgr) (arg0 net-process-class-info))
  (set! (-> arg0 msg-map (-> arg0 msg-count)) 'game-finished)
  (+! (-> arg0 msg-count) 1)
  (set! (-> arg0 msg-map (-> arg0 msg-count)) 'disable-turbos)
  (+! (-> arg0 msg-count) 1)
  (set! (-> arg0 msg-map (-> arg0 msg-count)) 'set-intro-end-time)
  (+! (-> arg0 msg-count) 1)
  (set! (-> arg0 msg-map (-> arg0 msg-count)) 'game-aborted)
  (+! (-> arg0 msg-count) 1)
  (set! (-> arg0 msg-map (-> arg0 msg-count)) 'set-finish-time)
  (+! (-> arg0 msg-count) 1)
  (set! (-> arg0 msg-map (-> arg0 msg-count)) 'cheat)
  (+! (-> arg0 msg-count) 1)
  0
  (none)
  )

