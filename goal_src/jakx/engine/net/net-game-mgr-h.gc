(define *net-process-class-info-net-game-mgr* (new 'static 'net-process-class-info))

;; failed to figure out what this is:
(set! (-> *net-process-class-info-net-game-mgr* msg-map) (the-as (array symbol) *msg-map-net-game-mgr*))

;; failed to figure out what this is:
(write-msg-map-rec net-game-mgr *net-process-class-info-net-game-mgr*)

;; failed to figure out what this is:
(set! (-> *net-process-class-info-net-game-mgr* owner-type) net-game-mgr)

;; failed to figure out what this is:
(net-process-class-register *net-process-class-info-net-game-mgr*)

;; definition for method 40 of type net-game-mgr
(defmethod process-nettable-method-40 ((this net-game-mgr))
  *net-process-class-info-net-game-mgr*
  )

;; definition for symbol *net-game-mgr*, type net-game-mgr
(define *net-game-mgr* (the-as net-game-mgr #f))

;; definition for symbol *should-update-stats*, type object
(define *should-update-stats* (the-as object #f))

;; definition for symbol *stats-adjusted*, type object
(define *stats-adjusted* (the-as object #f))

;; og:preserve-this hud-results rung: current-finish-mode below reads all
;; five of hud-results.gc's own per-view "-proc" tracking globals as
;; truthy guards only (no field access), the same declare-before-define
;; class as *net-game-mgr* itself in hud-results-grand-prix.gc; hud-
;; results.gc (a COMMON/GAME-dgo level file) compiles after this ENGINE-
;; dgo file, so these need a forward extern here to reach current-finish-
;; mode's own compile ("*hud-results-medal-proc* does not exist" without
;; it), matching the object typing each one's own home file already
;; carries.
(define-extern *hud-results-medal-proc* object)
(define-extern *hud-results-view-0-proc* object)
(define-extern *hud-results-view-1-proc* object)
(define-extern *hud-results-team-view-0-proc* object)
(define-extern *hud-results-team-view-1-proc* object)

;; definition for function current-finish-mode
;; WARN: Return type mismatch object vs symbol.
(defun current-finish-mode ()
  (let ((v1-0 (view-get-active-index)))
    (the-as
      symbol
      (and *net-game-mgr*
           (or (-> *net-game-mgr* scheduled-finish-mode)
               (and (= (if *net-world*
                           (the-as int (-> (the-as game-task-node-info (-> *net-world* task-node-info)) net-play-mode))
                           18
                           )
                       0
                       )
                    (or (and (zero? v1-0) *hud-results-medal-proc*)
                        (and (zero? v1-0) *hud-results-view-0-proc*)
                        (and (= 1 v1-0) *hud-results-view-1-proc*)
                        (and (zero? v1-0) *hud-results-team-view-0-proc*)
                        (and (= 1 v1-0) *hud-results-team-view-1-proc*)
                        )
                    )
               )
           )
      )
    )
  )

