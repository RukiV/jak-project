;;-*-Lisp-*-
(in-package goal)

;; name: net-predict-h.gc
;; name in dgo: net-predict-h
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

(deftype net-predictor-simple-state (structure)
  ((time    int32)
   (pos     vector      :inline)
   (vel     vector      :inline)
   (rot     quaternion  :inline)
   (angvel  vector      :inline)
   )
  )


(deftype net-predictor-simple (structure)
  ((last-net           net-predictor-simple-state  :inline)
   (extrapolated       net-predictor-simple-state  :inline)
   (active             net-predictor-simple-state  :inline)
   (vel-scale          vector                      :inline)
   (angvel-scale       vector                      :inline)
   (min-delay          int32)
   (max-delay          int32)
   (pos-err-thresh     float)
   (rot-err-thresh     float)
   (pos-track-factor   float)
   (vel-track-factor   float)
   (max-extrapolation  int32)
   (error-snap         float)
   (flags              uint8)
   )
  (:methods
    (net-predictor-simple-method-9 (_type_ object object) none)
    (net-predictor-simple-method-10 (_type_ object) none)
    (net-predictor-simple-method-11 (_type_ object object) none)
    ;; og:preserve-this wvehicle-weapons-vein rung 6: return retyped none ->
    ;; symbol. v-yellow-guided-missile-method-80's own call is this
    ;; method's only caller anywhere in the landed corpus (a narrow blast
    ;; radius, unlike mem-buffer's or net-process-mgr's own shared-type
    ;; holds elsewhere in this rung), and it tests the result directly in
    ;; a (when ...) condition; a none-typed method cannot be used in a
    ;; condition at all (goalc's own "Cannot use none-typed variable in a
    ;; condition"), and process-nettable's own method-22/25 document the
    ;; same "truthy gate" convention for this shape.
    (net-predictor-simple-method-12 (_type_) symbol)
    (net-predictor-simple-method-13 (_type_) none)
    (net-predictor-simple-method-14 (_type_) none)
    (net-predictor-simple-method-15 (_type_) none)
    (net-predictor-simple-method-16 (_type_) none)
    (net-predictor-simple-method-17 (_type_) none)
    )
  )


(deftype net-predictor-sphcol (net-predictor-simple)
  ()
  )
