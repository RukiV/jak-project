;;-*-Lisp-*-
(in-package goal)

;; name: net-process-mgr-h.gc
;; name in dgo: net-process-mgr-h
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

(deftype net-process-mgr-machine (structure)
  ((state            uint8)
   (delay            int32)
   (acct-id          int32)
   (overall-score    int32)
   (clan-id          int32)
   (local-player-ct  int32)
   (cookie           int32)
   (reported-ping    int32)
   )
  :pack-me ;; the machines inline array sits at 152 (mod 16 = 8), so elements are 4-aligned
  )


(deftype net-process-mgr (process)
  ((local-machine-idx                 int32)
   (session-master-idx                int32)
   (machines                          net-process-mgr-machine  8  :inline)
   (last-allocated-local-id           int32)
   (last-allocated-global-id          int32)
   (have-send-pending-objects         basic)
   (snap-time-of-day                  basic)
   ;; og:preserve-this opaque 160-byte window: the seed said 10 entries but linked-list is
   ;; 8 bytes, so the element type is unproven; re-derive from net-process-mgr.o when the
   ;; net leg lands
   (owner-lists                       uint32                   40)
   (active-list                       linked-list              :inline)
   (cur-proc-valid                    basic)
   (cur-proc-id                       uint16)
   (cur-proc-owner-idx                int8)
   (cur-proc-type                     basic)
   (cur-proc-entity                   entity-links)
   (entity-creation-messages-enabled  basic)
   )
  (:methods
    ;; process owns slots 0..14 (method-count 15); the seed listed six phantom entries
    ;; 9..14 here, which appended after the parent and blew the retail count of 59 to 65.
    ;; Child methods start at 15.
    (net-process-mgr-method-15 () none)
    )
  (:state-methods
    net-process-mgr-state-16
    )
  (:methods
    (net-process-mgr-method-17 () none)
    (net-process-mgr-method-18 () none)
    (net-process-mgr-method-19 () none)
    (net-process-mgr-method-20 (_type_ object) none)
    (net-process-mgr-method-21 () none)
    (net-process-mgr-method-22 (_type_ object) none)
    (net-process-mgr-method-23 () none)
    (net-process-mgr-method-24 (_type_ object object object) none)
    (net-process-mgr-method-25 () none)
    (net-process-mgr-method-26 () none)
    (net-process-mgr-method-27 (_type_ object object object) none)
    (net-process-mgr-method-28 (_type_ object object object) none)
    (net-process-mgr-method-29 () none)
    (net-process-mgr-method-30 () none)
    (net-process-mgr-method-31 () none)
    (net-process-mgr-method-32 (_type_ object object) none)
    (net-process-mgr-method-33 () none)
    (net-process-mgr-method-34 () none)
    (net-process-mgr-method-35 () none)
    (net-process-mgr-method-36 (_type_ object object) none)
    (net-process-mgr-method-37 (_type_) none)
    (net-process-mgr-method-38 (_type_) none)
    (net-process-mgr-method-39 (_type_ object object object) none)
    (net-process-mgr-method-40 (_type_) none)
    (net-process-mgr-method-41 (_type_) none)
    (net-process-mgr-method-42 () none)
    (net-process-mgr-method-43 () none)
    (net-process-mgr-method-44 (_type_) none)
    (net-process-mgr-method-45 (_type_) none)
    (net-process-mgr-method-46 () none)
    (net-process-mgr-method-47 (_type_ object object) none)
    (net-process-mgr-method-48 (_type_) none)
    (net-process-mgr-method-49 (_type_ object object) none)
    (net-process-mgr-method-50 (_type_ object object object) none)
    (net-process-mgr-method-51 () none)
    (net-process-mgr-method-52 () none)
    (net-process-mgr-method-53 () none)
    (net-process-mgr-method-54 (_type_ object object) none)
    (net-process-mgr-method-55 (_type_ process-nettable int rgba) symbol) ;; local net-process-id allocation; sig from (method 34 process-nettable)'s call, truthy = allocated
    (net-process-mgr-method-56 (_type_ object object object) none)
    (net-process-mgr-method-57 (_type_ object) none)
    (net-process-mgr-method-58 (_type_ object) none)
    )
  )
