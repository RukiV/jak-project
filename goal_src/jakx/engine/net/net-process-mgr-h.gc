;;-*-Lisp-*-
(in-package goal)

;; name: net-process-mgr-h.gc
;; name in dgo: net-process-mgr-h
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

(deftype net-process-mgr-machine (structure)
  ((state            uint8)
   (delay            int32)
   (acct-id          int32)
   (overall-score    int32)
   (clan-id          int32)
   (local-player-ct  int32)
   (cookie           int32)
   (reported-ping    int32)
   )
  :pack-me ;; the machines inline array sits at 152 (mod 16 = 8), so elements are 4-aligned
  )


(deftype net-process-mgr (process)
  ((local-machine-idx                 int32)
   (session-master-idx                int32)
   (machines                          net-process-mgr-machine  8  :inline)
   (last-allocated-local-id           int32)
   (last-allocated-global-id          int32)
   (have-send-pending-objects         basic)
   (snap-time-of-day                  basic)
   ;; og:preserve-this opaque 160-byte window: the seed said 10 entries but linked-list is
   ;; 8 bytes, so the element type is unproven; re-derive from net-process-mgr.o when the
   ;; net leg lands
   (owner-lists                       uint32                   40)
   (active-list                       linked-list              :inline)
   (cur-proc-valid                    basic)
   (cur-proc-id                       uint16)
   (cur-proc-owner-idx                int8)
   (cur-proc-type                     basic)
   (cur-proc-entity                   entity-links)
   (entity-creation-messages-enabled  basic)
   )
  (:methods
    ;; process owns slots 0..14 (method-count 15); the seed listed six phantom entries
    ;; 9..14 here, which appended after the parent and blew the retail count of 59 to 65.
    ;; Child methods start at 15.
    (net-process-mgr-method-15 () none)
    )
  (:state-methods
    net-process-mgr-state-16
    )
  (:methods
    (net-process-mgr-method-17 () none)
    (net-process-mgr-method-18 () none)
    (net-process-mgr-method-19 () none)
    (net-process-mgr-method-20 (_type_ object) none)
    ;; og:preserve-this Lane B rung: a1 is used as an array index (sll a1
    ;; 5, i.e. a1*32) into a per-player stats block, with a2/a3/t0 stored
    ;; into that element as raw word values; a1 typed int on that
    ;; evidence, a2/a3/t0 left object (thin, only the store width is
    ;; known).
    (net-process-mgr-method-21 (_type_ int object object object) none)
    (net-process-mgr-method-22 (_type_ object) none)
    (net-process-mgr-method-23 () none)
    (net-process-mgr-method-24 (_type_ object object object) none)
    (net-process-mgr-method-25 (_type_ object object) none)
    (net-process-mgr-method-26 (_type_ object) none)
    (net-process-mgr-method-27 (_type_ object object object) none)
    (net-process-mgr-method-28 (_type_ object object object) none)
    (net-process-mgr-method-29 () none)
    (net-process-mgr-method-30 (_type_ object object object object) none)
    (net-process-mgr-method-31 (_type_ object object) none)
    (net-process-mgr-method-32 (_type_ object object) none)
    (net-process-mgr-method-33 (_type_ object) none)
    (net-process-mgr-method-34 (_type_ object) none)
    (net-process-mgr-method-35 () none)
    (net-process-mgr-method-36 (_type_ object object) none)
    (net-process-mgr-method-37 (_type_) none)
    (net-process-mgr-method-38 (_type_) none)
    (net-process-mgr-method-39 (_type_ object object object) none)
    (net-process-mgr-method-40 (_type_) none)
    (net-process-mgr-method-41 (_type_) none)
    (net-process-mgr-method-42 (_type_ object) none)
    (net-process-mgr-method-43 (_type_ object object object object) none)
    (net-process-mgr-method-44 (_type_) none)
    (net-process-mgr-method-45 (_type_) none)
    (net-process-mgr-method-46 (_type_ object) none)
    (net-process-mgr-method-47 (_type_ object object) none)
    (net-process-mgr-method-48 (_type_) none)
    (net-process-mgr-method-49 (_type_ object object) none)
    (net-process-mgr-method-50 (_type_ object object object) none)
    (net-process-mgr-method-51 () none)
    ;; issue 531 overturns the Lane B ruling above: a landed caller with the
    ;; orphan tell is not caller evidence, it IS the defect. Callee reads a1
    ;; and uses it in an integer subtract against two clock deltas,
    ;; returning the computed int; net-enemy.gc:804's discarded
    ;; (mem-buffer-method-33 arg1) result (declared uint) flows into a1 at
    ;; the call. The prior (_type_ object) attempt failed only because the
    ;; call site was never re-landed to pass the arg; this rung re-lands it.
    (net-process-mgr-method-52 (_type_ uint) int)
    (net-process-mgr-method-53 (_type_ object object object object) none)
    (net-process-mgr-method-54 (_type_ object object) none)
    (net-process-mgr-method-55 (_type_ process-nettable int rgba) symbol) ;; local net-process-id allocation; sig from (method 34 process-nettable)'s call, truthy = allocated
    (net-process-mgr-method-56 (_type_ object object object) none)
    (net-process-mgr-method-57 (_type_ object) none)
    (net-process-mgr-method-58 (_type_ object) none)
    )
  )

;; og:preserve-this handle-fns fast-follow: closes the (e2) extern-no-defun
;; risk PR 658 left open (wvehicle-weapons-vein rung 6, mine-b's own
;; process-nettable-method-15/17, wvehicle-weapons-proj.gc, are the landed
;; callers). write-process-as-handle decodes clean off this object's own
;; scoped decode once arg1 is narrowed to process-nettable
;; (type_casts.jsonc), the same +4 basic-tag net-id evidence (method 15
;; mine-a)'s own op 41 already established (machine 158 = declared 162).
;; The orphan-tell shape below is mem-buffer-method-19's own already-
;; accepted call form (mine-a-method-15/mine-b-method-15,
;; wvehicle-weapons-proj.gc), transcribed verbatim per the orphan-tell
;; corollary (issue 531), not reconstructed; its own body stays unlanded,
;; the deliberately parked mem-buffer zero-arg family.

;; definition for function write-process-as-handle
(defun write-process-as-handle ((arg0 mem-buffer) (arg1 process-nettable))
  (cond
    (arg1
      (let ((t9-0 (method-of-type mem-buffer mem-buffer-method-19)))
        (-> arg1 net-id)
        (t9-0)
        )
      )
    (else
      (let ((t9-1 (method-of-type mem-buffer mem-buffer-method-19)))
        #xffff
        (t9-1)
        )
      )
    )
  (none)
  )

;; og:preserve-this handle-fns fast-follow: the raw pid<<32|pointer triple
;; (nonzero?/l32-false-check/sllv-r0/pid-compare over arg1) is handle-
;; >process's own compiled expansion (gkernel-h.gc), the exact class PR
;; 658's own mine-a-method-15 note already documents (issue 531's own
;; ppointer->handle precedent, here the read-side handle->process);
;; substituted the real macro call rather than landed as the raw op
;; sequence goalc cannot compile (failed type prop at 6: "Could not figure
;; out load: (set! a0 (l.wu a0))"). The narrowing that follows (type?
;; against process-nettable, #f otherwise) is as-type's own compiled shape
;; (gcommon.gc), matching mine-a-method-15's own
;; (as-type (handle->process ...) process-nettable) precedent exactly.

;; definition for function write-handle
(defun write-handle ((arg0 mem-buffer) (arg1 uint))
  (write-process-as-handle arg0 (as-type (handle->process (the-as handle arg1)) process-nettable))
  (none)
  )

;; og:preserve-this handle-fns fast-follow: HELD, not landed. read-handle's
;; own body decodes clean up to its own op 11 ("Could not figure out load:
;; (set! v1 (l.wu (+ a0 28)))"), which is net-process-mgr-method-46's own
;; return flowing into a process->ppointer/handle->process-style field
;; read; net-process-mgr-method-46 is declared (_type_ object) none here
;; but evidently returns something process-shaped, the exact wall PR 658's
;; own mine-a-method-35 note already flagged ("the same defect class as
;; write-handle/read-handle above, but on a shared corpus type with a much
;; wider blast radius to retype", wvehicle-weapons-proj.gc). Its own body
;; is not landed anywhere in the corpus either (net-process-mgr.gc's own
;; bring-up-stub note: "the net leg" is future work, not this rung's
;; scope), so retyping the return here would be guessed from one call site
;; rather than proven; left held, matching that prior call.
