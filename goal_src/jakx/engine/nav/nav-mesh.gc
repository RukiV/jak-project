;; DECOMP BEGINS

;; nav-mesh tier: this rung's landing lifts the label_types fix on
;; *nav-mesh-id-hash* that unblocked the whole object's disasm.gc emission
;; (previously the entire object failed "top level function was not
;; converted to expressions" per issue 466); the functions below decode
;; with zero ir2.asm errors under the config fixes landed alongside this
;; commit and are transcribed verbatim. Held out of this landing: every
;; nav-mesh method whose slot number in this file's own :methods table does
;; not match its real decoded body (method 25 declared init-from-entity
;; decodes as new-nav-control's own body verbatim, format string and all;
;; method 26 declared handle-birth decodes as remove-nav-control's own
;; body; both proofs are self-identifying debug format strings, not
;; guesses) -- the same class of vtable-slot drift already documented for
;; nav-control and nav-mesh-editor in the jak3 twin map, unresolved here
;; and out of scope for a config-only rung. Also held: nav-ray-test (calls
;; the still-erroring advance-ray-to-nearest-poly-edge-or-dest!, method 18,
;; same drift-suspect table), get-nav-mesh and both id-hash-find-* (jakx-
;; original *nav-mesh-id-hash* subsystem, no jak2/jak3 twin to type against),
;; find-nearest-nav-mesh (its own nav-mesh-method-46 call resolves to vtable
;; byte offset 188, which is this table's slot 43 by the standard 16+4*N
;; method-table formula, not slot 46; same drift class), and every method
;; with its own CFG-building or type-prop failure.

;; *nav-mesh-work* decodes byte-identical to jak2's own static definition
;; (nav-mesh.gc:25-37), landed here as real content (not a provisional
;; extern) since debug-validate-nav-poly below reads it; goalc reads only
;; goal_src's own declarations, not the decompiler's all-types.gc, so
;; declaring the type there does not make the symbol exist here.
(define *nav-mesh-work* (new 'static 'nav-mesh-work
                          :vert0-table (new 'static 'array int8 4 0 1 2 3)
                          :vert1-table (new 'static 'array int8 4 1 2 3 0)
                          :edge-mask-table (new 'static 'array uint8 3 #x1 #x2 #x4)
                          :deg-to-rad 0.000095873795
                          :rad-to-deg 10430.379
                          :nav-poly-min-dist 204.8
                          :nav-poly-epsilon 40.96
                          :debug (new 'static 'nav-mesh-work-debug)
                          :work-struct-in-scratch 1
                          :mesh-struct-in-scratch 1
                          :polys-in-scratch 1
                          )
        )

;; og:preserve-this (e2 hazard, not created by this rung): goalc only reads
;; goal_src's own declarations, not the decompiler's all-types.gc, so the
;; already-active decompiler extern does not make this symbol callable here;
;; a provisional extern is needed to compile nav-mesh-connect-from-ent below,
;; matching the find-instance-by-name-level precedent (drawable.gc, PR for
;; issue 461). No defun exists anywhere in this corpus, so a call still
;; crashes if this path is hit at runtime. Retire this note once
;; nav-mesh-from-res-tag lands a real body.
(define-extern nav-mesh-from-res-tag (function entity symbol int nav-mesh))

(defun nav-mesh-connect-from-ent ((arg0 process-drawable))
  "Connect this process to the nav-mesh associate with the entity that spawned the process"
  (let ((s5-0 (nav-mesh-from-res-tag (-> arg0 entity) 'nav-mesh-actor 0)))
    (cond
      (s5-0
        (if (zero? (-> s5-0 user-list))
            (format 0 "nav-mesh-connect-from-ent: nav mesh not initialized!~%")
            )
        (if (add-connection (-> s5-0 user-list) arg0 nothing arg0 #f (-> arg0 root))
            #t
            )
        )
      (else
        (if (-> arg0 entity)
            (logior! (-> arg0 entity extra perm status) (entity-perm-status error))
            )
        #f
        )
      )
    )
  )

;; WARN: Return type mismatch int vs none.
(defun-debug connection-validate ((arg0 connection))
  (when (zero? arg0)
    (break!)
    0
    )
  (when (zero? (-> arg0 next1))
    (break!)
    0
    )
  (when (zero? (-> arg0 prev1))
    (break!)
    0
    )
  (when (-> arg0 next1)
    (when (!= arg0 (-> arg0 next1 prev1))
      (break!)
      0
      )
    )
  (when (-> arg0 prev1)
    (when (!= arg0 (-> arg0 prev1 next1))
      (break!)
      0
      )
    )
  0
  (none)
  )

(defun-debug connection-list-validate ((arg0 (inline-array connection)))
  (let ((gp-0 (the-as object (&-> arg0 3 param3))))
    (while gp-0
      (connection-validate (the-as connection gp-0))
      (set! gp-0 (-> (the-as connection gp-0) next1))
      )
    )
  #f
  )

