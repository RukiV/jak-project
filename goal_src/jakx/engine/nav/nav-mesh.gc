;; INFO: Used lq/sq
;; WARN: Return type mismatch float vs object.
(defun find-nav-mesh ((arg0 object) (arg1 vector) (arg2 float) (arg3 float) (arg4 float) (arg5 collide-cache))
  (set! (-> (the-as collide-query arg0) start-pos quad) (-> arg1 quad))
  (+! (-> (the-as collide-query arg0) start-pos y) arg2)
  (vector-reset! (-> (the-as collide-query arg0) move-dist))
  (set! (-> (the-as collide-query arg0) move-dist y) (- (+ arg2 arg3)))
  (let ((v1-2 (the-as collide-query arg0)))
    (set! (-> v1-2 radius) arg4)
    (set! (-> v1-2 collide-with) (collide-spec nav-mesh))
    (set! (-> v1-2 ignore-process0) #f)
    (set! (-> v1-2 ignore-process1) #f)
    (set! (-> v1-2 ignore-pat)
          (new 'static 'pat-surface :noentity #x1 :nojak #x1 :probe #x1 :noendlessfall #x1 :board #x1)
          )
    (set! (-> v1-2 action-mask) (collide-action solid))
    (set! (-> v1-2 best-other-prim) #f)
    )
  (let ((f0-6 (collide-cache-method-10 arg5 (the-as collide-query arg0))))
    (cond
      ((>= f0-6 0.0)
       (vector+float*!
         (-> (the-as collide-query arg0) rlength)
         (-> (the-as collide-query arg0) start-pos)
         (-> (the-as collide-query arg0) move-dist)
         f0-6
         )
       (-> (the-as collide-query arg0) best-other-prim local-sphere x)
       )
      (else
        (the-as float #f)
        )
      )
    )
  )

;; og:preserve-this bring-up stub (#108): retail's body is the jak2/jak3 shape,
;;   (let ((v1-0 (-> this nav-mesh))) (if (nonzero? v1-0) (init-from-entity v1-0 this)))
;; and neither half exists here yet: nav-mesh-h.gc carries only nav-mesh-flag, so the
;; nav-mesh type is still just the (declare-type nav-mesh basic) in res.gc and it has no
;; init-from-entity to call. The declaration in entity-h.gc alone does not fill the slot,
;; so without this defmethod method 27 of entity-nav-mesh stays 0, and the nav-mesh step
;; of level-update-after-load (level.gc:1800, the (= state elts) login state) calls
;; straight through it into GOAL address 0. That killed every boot that logged in a level
;; carrying a non-empty (-> bsp nav-meshes); jungles is the first one on the acceptance
;; path, which is why the crash landed immediately after "login jungles".
;; A no-op is the honest shape for now: the caller only needs the method to return so it
;; can advance (-> arg1 pos) and walk the rest of the array. Nav meshes stay uninitialized,
;; which costs nothing until AI navigation lands.
;; Retire together with the real nav-mesh-h.gc and nav-mesh.gc.
(defmethod initialize-nav-mesh! ((this entity-nav-mesh))
  "Initialize the nav-mesh in this entity. Bring-up stub, see the note above."
  0
  (none)
  )

;; og:preserve-this bring-up stub (#108): retail's body is again the jak2/jak3 shape,
;;   (let ((a0-1 (-> this nav-mesh))) (if (nonzero? a0-1) (handle-birth a0-1)))
;; and handle-birth is a nav-mesh method, so it is out of reach for the same reason
;; init-from-entity is above. birth! is method 22, declared on entity and defined in this
;; tree only for entity-actor and entity-camera (entity.gc:317, :343), so entity-nav-mesh
;; inherits a 0 slot. (method birth level) walks (-> this bsp nav-meshes) calling it bare
;; at level.gc:1943, which is retail's own shape, so the guard belongs here rather than at
;; that call site; entity.gc:601 guards the matching kill! walk instead because kill! has
;; no landed base defmethod to hang a stub on. Returning this is retail's return value and
;; the caller discards it.
;; Retire together with the real nav-mesh-h.gc and nav-mesh.gc.
(defmethod birth! ((this entity-nav-mesh))
  "Birth this entity's nav-mesh. Bring-up stub, see the note above."
  this
  )

;; definition for function find-first-containing-nav-mesh
(defun find-first-containing-nav-mesh ((arg0 vector) (arg1 float) (arg2 (pointer nav-poly)))
  (let ((sv-64 (new 'stack-no-clear 'nav-find-poly-parms)))
    (set! (-> sv-64 ignore) (the-as uint 7))
    (dotimes (s3-0 (-> *level* length))
      (let ((v1-5 (-> *level* level s3-0)))
        (when (= (-> v1-5 status) 'active)
          (let ((s2-0 (-> v1-5 bsp nav-meshes)))
            (when (nonzero? s2-0)
              (dotimes (s1-0 (-> s2-0 length))
                (let ((s0-0 (-> s2-0 s1-0 nav-mesh)))
                  (when s0-0
                    (vector-! (-> sv-64 point) arg0 (the-as vector (-> s0-0 bounds)))
                    (set! (-> sv-64 y-threshold) (fmax (-> s0-0 nearest-y-threshold) arg1))
                    (let ((v1-14 (nav-mesh-method-42 s0-0 (the-as nav-poly sv-64))))
                      (when v1-14
                        (if arg2
                            (set! (-> arg2 0) v1-14)
                            )
                        (return s0-0)
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  (the-as nav-mesh #f)
  )

