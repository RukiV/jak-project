;; definition of type selection-cache
;; moved ahead of its first use (raw decode order puts this deftype near
;; insert-selection-cache at the end of the file, but GOAL requires the
;; type declared before *mirror-mode* below references it as 'selection-
;; cache; content is unchanged from the decode, only its position moved).
(deftype selection-cache (structure)
  ((state           basic)
   (selection-type  basic)
   )
  )

;; definition for method 3 of type selection-cache
(defmethod inspect ((this selection-cache))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'selection-cache)
  (format #t "~1Tstate: ~A~%" (-> this state))
  (format #t "~1Tselection-type: ~A~%" (-> this selection-type))
  (label cfg-4)
  this
  )

;; definition for symbol *mirror-mode*, type selection-cache
(define *mirror-mode* (new 'static 'selection-cache :state (new 'static 'boxed-array :type menu-option-info
                                                             (new 'static 'menu-option-info)
                                                             (new 'static 'menu-option-info)
                                                             )
                                                    )
        )

;; failed to figure out what this is:
(set! (-> *mirror-mode* state) *mirror-mode-array*)

;; failed to figure out what this is:
(set! (-> *mirror-mode* selection-type) (the-as basic 0))

;; definition of type menu-range-info
;; four raw int32 words, no type tag, at each of the nine "-info" statics
;; below. Positional evidence across all nine instances: field 1 is always
;; the largest value and matches each field's own natural range ceiling (6
;; for num-players, 100 for the volume/brightness/contrast sliders), and
;; field 0 matches each control's natural default (1 local player, 25 for
;; brightness/contrast, 0 for the volume sliders); fields 2 and 3 are 0 in
;; every instance except ai-num-players-info (-1, a plausible "no minimum"
;; sentinel) and num-players-info (1, a plausible unit step). Field names
;; are this positional read (Support-grade, not Proof): no call site outside
;; this file's own top-level-login is landed yet to confirm the semantics.
(deftype menu-range-info (structure)
  ((default-val  int32)
   (max-val      int32)
   (min-val      int32)
   (step-val     int32)
   )
  )

;; definition for symbol *num-players-info*, type menu-range-info
(define *num-players-info* (new 'static 'menu-range-info :default-val 1 :max-val 6 :min-val 1 :step-val 1))

;; definition for symbol *ai-num-players-info*, type menu-range-info
(define *ai-num-players-info* (new 'static 'menu-range-info :max-val 2 :min-val -1))

