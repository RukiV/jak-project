;; definition for function get-extra-player-string
;; WARN: Return type mismatch (pointer uint8) vs object.
(defun get-extra-player-string ((arg0 int))
  (let ((v1-0 arg0))
    (cond
      ((zero? v1-0)
       *player-1-extra*
       )
      ((= v1-0 1)
       *player-2-extra*
       )
      ((= v1-0 2)
       *player-3-extra*
       )
      ((= v1-0 3)
       *player-4-extra*
       )
      ((= v1-0 4)
       *player-5-extra*
       )
      (else
        *player-6-extra*
        )
      )
    )
  )

;; definition for function set-index
(defun set-index ((arg0 (pointer (array menu-option-info))) (arg1 object))
  (local-vars (v0-0 symbol))
  (dotimes (s4-0 (length (-> arg0 0)))
    (when (= (-> arg0 0 s4-0 sym) arg1)
      (set! (-> arg0 1) (the-as (array menu-option-info) s4-0))
      (return #t)
      )
    )
  (return #f)
  v0-0
  )

;; definition for symbol *selection-cache-array*, type (inline-array selection-cache)
(define *selection-cache-array* (new 'static 'inline-array selection-cache 3
                                  (new 'static 'selection-cache)
                                  (new 'static 'selection-cache)
                                  (new 'static 'selection-cache)
                                  )
        )

;; definition for symbol *selection-cache-index*, type int
(define *selection-cache-index* 1)

;; definition for symbol *last-lobby-state*, type object
(define *last-lobby-state* (the-as object #f))

;; failed to figure out what this is:
(set! (-> *selection-cache-array* 0 state) (the-as basic 'game-type))

;; failed to figure out what this is:
(set! (-> *selection-cache-array* 0 selection-type) (the-as basic 'adventure))

;; definition for function insert-selection-cache
;; WARN: Return type mismatch int vs object.
(defun insert-selection-cache ((arg0 object) (arg1 object))
  (mod (+ *selection-cache-index* -1) 3)
  (dotimes (v1-3 3)
    (let ((a2-4 (mod (+ (- -1 v1-3) *selection-cache-index*) 3)))
      (if (< a2-4 0)
          (+! a2-4 3)
          )
      ;; raw offset arithmetic, not a named field chain: *lobby-menu-manager*
      ;; stays basic (landing its own type is a separate campaign, out of
      ;; this band's scope), and this decompiler's own field-name guess at
      ;; process offset 68 ("state") disagrees with its own process deftype
      ;; text (which puts "level" at 68 and "state" at 72); word[17]=byte 68
      ;; and word[0]=byte 0 of the result are the raw bytes the machine code
      ;; actually reads (l.wu +68 then l.wu +0), verified directly against
      ;; the disassembly rather than the decompiler's inferred field name.
      (when (and *lobby-menu-manager*
                 (= (-> *selection-cache-array* a2-4 state)
                    (the-as basic (-> (the-as (pointer uint32) (-> (the-as (pointer uint32) *lobby-menu-manager*) 17)) 0))
                    )
                 )
        (set! (-> *selection-cache-array* a2-4 state) (the-as basic arg0))
        (set! (-> *selection-cache-array* a2-4 selection-type) (the-as basic arg1))
        (return (the-as object #f))
        )
      )
    )
  (set! (-> *selection-cache-array* *selection-cache-index* state) (the-as basic arg0))
  (set! (-> *selection-cache-array* *selection-cache-index* selection-type) (the-as basic arg1))
  (let ((v0-0 (mod (+ *selection-cache-index* 1) 3)))
    (set! *selection-cache-index* v0-0)
    v0-0
    )
  )

;; base-menu-method-61 (dropdown-item): the row's event responder, transcribed
;; from the donor (menu2.gc:7913-8132, decode-clean past its stack-guess and
;; sllv markers, the same handle/ppointer idioms this campaign already
;; resolves). base-menu-event-handler's else arm (menu2-installs.gc:558-560)
;; routes every unmatched message here, but the only compiled method 61 was
;; base-menu's donor no-op, so 'selected / 'deselected / 'enabled / 'disabled
;; were silently swallowed and no row ever set its selected flag
;; (lane-crashdump-probe1 inspects, issue 759: find-first-selectable's
;; 'selected send landed in the no-op; all six rows selected: #f).
;;
;; Lives here rather than menu2-draw.gc because the 'selected arm calls
;; insert-selection-cache and reads *last-lobby-state*, both defined above in
;; this file and compiled after menu2-draw.o (game.gd rank), and a second
;; define-extern would trip the duplicate-declare hazard menu2-installs.gc's
;; own method-58 note documents. The manager-state read reuses the raw
;; word[17] expression insert-selection-cache's own comment above pins to the
;; disassembly (l.wu +68 then l.wu +0), not the decompiler's field-name guess.
(defmethod base-menu-method-61 ((this dropdown-item) (proc process) (argc int) (message symbol) (block event-message-block))
  (with-pp
    (case message
      (('selected)
       (cond
         ((-> this enabled)
          ;; notify the parent manager: selection changed to this row's type
          (let ((msg (new 'stack-no-clear 'event-message-block)))
            (set! (-> msg from) (process->ppointer pp))
            (set! (-> msg num-params) 2)
            (set! (-> msg message) 'menu-selection-event)
            (set! (-> msg param 0) (the-as uint 'changed))
            (set! (-> msg param 1) (the-as uint (-> (the-as dropdown-item-info (-> this info-ptr)) selection-type)))
            (send-event-function (ppointer->process (-> this parent)) msg)
            )
          (set! (-> this selected) (the-as basic #t))
          ;; find-first-selectable's (send-event child 'selected) carries zero
          ;; params, so param 0 is uninitialized stack; only take it when the
          ;; sender actually supplied one.
          (if (> argc 0)
              (set! (-> this prev-selection) (the-as int (-> block param 0)))
              )
          ;; the word[17] state read goes through *lobby-menu-manager*, which
          ;; is #f on every road without a live lobby manager (defined #f in
          ;; lobby-menu-manager-h.gc and main.gc, reset at manager death);
          ;; unguarded, the double-deref reads symbol-table junk and feeds it
          ;; to the cache (the glowfix1 boot's 500ms dispatch regime and its
          ;; downstream inspect crash). Guard with the same (and
          ;; *lobby-menu-manager* ...) idiom lobby-menu-manager-h.gc already
          ;; uses.
          (when *lobby-menu-manager*
            (let ((mgr-state (the-as object (-> (the-as (pointer uint32) (-> (the-as (pointer uint32) *lobby-menu-manager*) 17)) 0))))
              (when (= mgr-state *last-lobby-state*)
                (insert-selection-cache mgr-state (the-as object (-> (the-as dropdown-item-info (-> this info-ptr)) selection-type)))
                )
              (set! *last-lobby-state* mgr-state)
              )
            )
          (the-as object #t)
          )
         (else
           (the-as object #f)
           )
         )
       )
      (('deselected)
       (set! (-> this selected) #f)
       (the-as object #f)
       )
      (('enabled)
       (set! (-> this enabled) (the-as basic #t))
       (let ((msg (new 'stack-no-clear 'event-message-block)))
         (set! (-> msg from) (process->ppointer pp))
         (set! (-> msg num-params) 1)
         (set! (-> msg message) 'to-all-children)
         (set! (-> msg param 0) (the-as uint 'set-strings-enabled))
         (the-as object (send-event-function this msg))
         )
       )
      (('disabled)
       (set! (-> this enabled) #f)
       ;; if the disabled row held the selection, push the manager off it
       (when (-> this selected)
         (let ((msg (new 'stack-no-clear 'event-message-block)))
           (set! (-> msg from) (process->ppointer pp))
           (set! (-> msg num-params) 1)
           (set! (-> msg message) 'next)
           (set! (-> msg param 0) (the-as uint 0))
           (send-event-function (ppointer->process (-> this parent)) msg)
           )
         )
       (let ((msg (new 'stack-no-clear 'event-message-block)))
         (set! (-> msg from) (process->ppointer pp))
         (set! (-> msg num-params) 1)
         (set! (-> msg message) 'to-all-children)
         (set! (-> msg param 0) (the-as uint 'set-strings-disabled))
         (the-as object (send-event-function this msg))
         )
       )
      (('sym?)
       (the-as object (= (-> block param 0) (the-as uint (-> (the-as dropdown-item-info (-> this info-ptr)) selection-type))))
       )
      (else
        ((the-as (function dropdown-item process int symbol event-message-block object)
           (find-parent-method dropdown-item 61)
           )
         this
         proc
         argc
         message
         block
         )
        )
      )
    )
  )




