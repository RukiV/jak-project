;; definition of type vehicle-configuration
(deftype vehicle-configuration (structure)
  ((load-parts  uint64)
   (id          uint32)
   )
  )

;; definition for method 3 of type vehicle-configuration
(defmethod inspect ((this vehicle-configuration))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'vehicle-configuration)
  (format #t "~1Tload-parts: ~D~%" (-> this load-parts))
  (format #t "~1Tid: ~D~%" (-> this id))
  (label cfg-4)
  this
  )

