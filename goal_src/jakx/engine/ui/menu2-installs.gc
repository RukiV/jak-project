;; base-menu-init-by-other: real body, transcribed from the menu2-quartet
;; redecode. a0 is base-menu-info (op 38 stores it straight to self's own
;; info-ptr; the caller passes *background-menu-info*,
;; lobby-menu-manager.gc/lobby-menu-data.gc). Two divergences from the
;; blueprint that verified this redecode, resolved by inspecting the decode
;; itself rather than assumption: (a) width-array/height-array allocate via
;; (new 'process 'boxed-array int32 n), not 'array - the decoder resolved
;; this through the type's own allocator, so the donor's own text wins; (b)
;; the children-length reads below are against arg0 directly (the caller's
;; base-menu-info), not self info-ptr - same value by the register-alias
;; proof, kept as decoded. children stays bare basic on base-menu-info this
;; rung (see the deftype below): retail's own base-menu-info statics in
;; lobby-menu-data.gc store :children as arrays of structure references (the
;; menu tree's own child descriptors, not raw int32s), so retyping it here
;; would have required reshaping 29 already-landed static literals with
;; invented values - a follow-up (the children menu-tree typing rung), not
;; this one. The two .length reads below cast through (array int32) instead:
;; a boxed array's own length lives at a fixed offset (0) regardless of
;; element type, so any array cast reads it correctly without asserting
;; anything about what children's real elements are.
(defbehavior base-menu-init-by-other base-menu ((arg0 base-menu-info) (arg1 vector) (arg2 int))
  (rlet ((vf0 :class vf)
         (vf4 :class vf)
         (vf5 :class vf)
         (vf6 :class vf)
         )
    (init-vf0-vector)
    (set! (-> self mask) (process-mask pause menu))
    (set! (-> self child-handles) #f)
    (set! (-> self info-ptr) #f)
    (set! (-> self focused?) (the-as basic #t))
    (+! (-> self clock ref-count) -1)
    (+! (-> *display* real-clock ref-count) 1)
    (set! (-> self clock) (-> *display* real-clock))
    (set! (-> self pad) arg2)
    (set! (-> self extra-offset quad) (the-as uint128 0))
    (set! (-> self pos-x) (-> arg1 x))
    (set! (-> self pos-y) (-> arg1 y))
    (set! (-> self pos-z) (-> arg1 z))
    (matrix-identity! (-> self offset-matrix))
    (if (and arg0 (nonzero? arg0))
        (set! (-> self info-ptr) arg0)
        )
    (set! (-> self width) (-> self info-ptr width))
    (set! (-> self height) (-> self info-ptr height))
    (set! (-> self width-array) #f)
    (set! (-> self height-array) #f)
    (when (-> self info-ptr 3d-menu-type)
      (let ((s5-0
              (art-group-get-by-name *level* (the-as string (-> self info-ptr 3d-menu-type)) (the-as (pointer level) #f))
              )
            )
        (art-group-get-by-name *level* (the-as string (-> s5-0 data 0)) (&-> self level))
        (set! (-> self root) (new 'process 'trsqv))
        (initialize-skeleton self (the-as skeleton-group s5-0) (the-as pair 0))
        )
      (logior! (-> self skel status) (joint-control-status sync-math))
      (logior! (-> self draw status) (draw-control-status force-vu1))
      (init (-> self j-mod) self (the-as uint 3) (joint-mod-base-flags attached))
      (matrix->transformq (-> self j-mod transform) (math-camera-matrix))
      (when (-> self info-ptr trans-info)
        (let ((v1-41 (-> self root trans)))
          (let ((a0-14 (-> self root trans))
                (a1-9 (-> self info-ptr trans-info 3d-offset))
                )
            (.lvf vf4 (&-> a0-14 quad))
            (.lvf vf5 (&-> a1-9 quad))
            )
          (.mov.vf.w vf6 vf0)
          (.add.vf.xyz vf6 vf4 vf5)
          (.svf (&-> v1-41 quad) vf6)
          )
        (let ((v1-44 (-> self info-ptr trans-info enter-anim)))
          (when (!= v1-44 -1)
            (ja :group! (-> self draw art-group data v1-44) :num! min)
            (ja-post)
            )
          )
        )
      (when (-> self info-ptr joints)
        (let ((s5-3 (/ (length (-> self info-ptr joints)) 2)))
          (when (> s5-3 0)
            (set! (-> self width-array) (new 'process 'boxed-array int32 s5-3))
            (set! (-> self height-array) (new 'process 'boxed-array int32 s5-3))
            (let ((s5-4 0)
                  (s4-1 0)
                  )
              0
              0
              (while (< (+ s5-4 1) (length (-> self info-ptr joints)))
                (let* ((v1-60
                         (vector-!
                           (new 'stack-no-clear 'vector)
                           (-> self node-list data (-> self info-ptr joints s5-4) bone transform trans)
                           (-> self node-list data (-> self info-ptr joints (+ s5-4 1)) bone transform trans)
                           )
                         )
                       (f0-5 (vector-dot v1-60 (-> self node-list data (-> self info-ptr joints s5-4) bone transform uvec)))
                       )
                  (set! (-> self width-array s4-1)
                        (the int (vector-dot v1-60 (-> self node-list data (-> self info-ptr joints s5-4) bone transform rvec)))
                        )
                  (set! (-> self height-array s4-1) (the int f0-5))
                  )
                (+! s4-1 1)
                (+! s5-4 2)
                )
              )
            )
          )
        )
      )
    (when (-> self info-ptr 3d-menu-type)
      (when (-> self info-ptr joints)
        (let ((s5-5 (new 'stack-no-clear 'vector)))
          (new 'stack-no-clear 'vector)
          (let ((a1-33 (new 'stack-no-clear 'vector)))
            (set! (-> a1-33 quad) (-> self node-list data (-> self info-ptr joints 0) bone transform trans quad))
            (transform-point-vector! s5-5 a1-33)
            )
          (+! (-> s5-5 x) -1792.0)
          (+! (-> s5-5 y) -1840.0)
          (set! (-> self pos-x) (-> s5-5 x))
          (set! (-> self pos-y) (-> s5-5 y))
          (set! (-> self pos-z) (-> s5-5 z))
          )
        )
      )
    (when (-> arg0 children)
      (set! (-> self child-handles) (new 'process 'boxed-array handle (-> (the-as (array int32) (-> arg0 children)) length)))
      (dotimes (v1-86 (-> (the-as (array int32) (-> arg0 children)) length))
        (set! (-> self child-handles v1-86) (the-as handle #f))
        )
      (base-menu-method-58 self)
      )
    (base-menu-method-59 self)
    (set! (-> self event-hook) base-menu-event-handler)
    (when (-> self width-array)
      (dotimes (gp-1 (-> self width-array length))
        (send-event self 'width-height gp-1 (-> self width-array gp-1) (-> self height-array gp-1))
        )
      )
    (cond
      ((-> self info-ptr trans-info)
       (if (> (-> self info-ptr trans-info enter-delay) 0)
           (go (the-as (state base-menu) (method-of-object self base-menu-method-50)))
           (go-virtual base-menu-state-51)
           )
       )
      (else
        (go-virtual base-menu-state-51)
        )
      )
    )
  )

;; base-menu-method-58 ("child spawner"): real landing, issue 759, lobby
;; rung a1's own STEP 2. No compiled defmethod existed for this slot
;; anywhere before this rung - only the dead menu2.gc copy and the
;; deftype's own (:methods (base-menu-method-58 (_type_) none))
;; declaration - so the vtable slot was nullptr; base-menu-init-by-other's
;; own real landing just above calls (base-menu-method-58 self)
;; unconditionally in its own tail, which is why this defmethod sits here
;; rather than up with the rest of this rung's STEP audit slots (58 needs
;; base-menu-init-by-other's own symbol already defined to pass it to
;; run-function-in-process as a value, and this file's own compile order
;; only has that after the defbehavior above; see the pointer comment left
;; at the slot's old position). Transcribed from a fresh scratch scoped
;; decode of menu2 (allowed_objects ["menu2"], this rung's own run,
;; superseding the prior stub's citation of method-58-partial.gc's op 31
;; stall), reading the op-numbered register trace rather than the raw
;; arithmetic: op 31's own "(l.w (+ v1 -1))" (the previously-stalled
;; expression) resolves cleanly in this run as the standard symbol-value
;; load, i.e. (-> children[i] menu-type value); the two "Unsupported
;; inline assembly [sllv]" ops are the handle->process macro's own
;; live-check expansion and the process->handle macro's own handle-build
;; expansion, so both macros replace that raw arithmetic verbatim rather
;; than transcribing garbled shifts; the remaining "failed type prop at
;; 85" op is exactly (-> children length), unresolved only because
;; children is untyped raw basic at that op, and resolves once cast
;; explicitly below. No sub-expression anywhere in this body feeds a
;; debug print (the function has no print/format call at all); the prior
;; stub's citation of a debug-print stall traces to a different, earlier
;; decode attempt, not this one. children stays declared basic on
;; base-menu-info (its real element type varies per instance across the
;; corpus, lobby rung a1's own STEP 1 landing put dropdown-item-info under
;; the manager node and base-menu-info at the top), so it is cast locally
;; here to (array base-menu-info), the common base every real child
;; shares. Op 40's real branch (skip activate/run-function-in-process/
;; store entirely when get-process returns #f) is preserved as the outer
;; (when proc ...) guard; ops 66-75 (the null-guarded ppointer/pid read
;; that builds the stored handle word) are exactly process->handle's own
;; internal guard, so that macro call replaces them rather than
;; transcribing the raw offset-28/-1(v1) chain.
(defmethod base-menu-method-58 ((this base-menu))
  (let ((vec (new 'stack-no-clear 'vector))
        (children (the-as (array base-menu-info) (-> this info-ptr children)))
        )
    (set! (-> vec x) (-> this pos-x))
    (set! (-> vec y) (-> this pos-y))
    (set! (-> vec z) (-> this pos-z))
    (dotimes (i (-> children length))
      (when (not (handle->process (-> this child-handles i)))
        (let* ((child-type (the-as type (-> (-> children i) menu-type value)))
               (proc (get-process *default-dead-pool* child-type #x4000 1))
               )
          (when proc
            (activate proc this (symbol->string (-> child-type symbol)) (the-as pointer #x70004000))
            (let ((t9-0 run-function-in-process)
                  (a0-0 proc)
                  (a1-0 base-menu-init-by-other)
                  (a2-0 (-> children i))
                  (a3-0 vec)
                  (a4-0 (-> this pad))
                  )
              ((the-as (function object object object object object none) t9-0) a0-0 a1-0 a2-0 a3-0 a4-0)
              )
            (set! (-> this child-handles i) (process->handle proc))
            )
          )
        )
      )
    )
  (none)
  )

;; og:preserve-this inheritance hazard, issue 759, lobby rung a1's own
;; STEP audit: game.gd places menu2-h.o (rank 392, where jakx-logo-menu,
;; selection-menu-manager and dropdown-item's own deftype forms live)
;; before menu2-installs.o (rank 398, the real method-58 landing just
;; above), and every deftype compiles to an inline (new 'type ...) call
;; that runs as part of its own file's top-level (goalc/compiler/
;; compilation/Type.cpp's "this is new_type in kscheme.cpp" comment).
;; new_type's own loop (game/kernel/jakx/kscheme.cpp) copies the parent's
;; CURRENT method array into the child's own, one time, at that exact
;; moment - "child_slots[i] = parent_slots[i]" for i < parent_num_methods,
;; no live link back to the parent afterward. Since base-menu's own real
;; slot 58 (just above) does not exist yet when menu2-h.o's top-level
;; runs, all three subtypes copy a stale (nullptr) slot 58, and method-
;; set!/defmethod propagation is off on -boot builds, so nothing fixes
;; that copy later. dropdown-item and jakx-logo-menu's own info structs
;; never carry non-#f children in this rung's own landed data (base-menu-
;; init-by-other's own tail only calls method-58 inside
;; "(when (-> arg0 children) ...)"), so neither actually dispatches
;; through the stale slot today, but selection-menu-manager's own info
;; (the 'manager node, lobby-menu-data.gc's *base-menu-info* tree) does:
;; it is the one subtype this rung's own acceptance needs a working
;; method-58 on, to spawn its own six dropdown-item children. Moving
;; menu2-installs.o ahead of menu2-h.o in game.gd is not a clean fix -
;; menu2-installs.o's own patches need base-menu's type to already exist,
;; and base-menu's own deftype lives in the same menu2-h.o top-level as
;; the three subtypes, ahead of them; splitting that file is out of this
;; rung's scope. Filling the subtype slots explicitly instead, the same
;; idiom (method-of-type PARENT method-name) already used elsewhere in
;; this codebase (jak1/2/3's own crate/bouncer method 12 re-installs).
;; jakx-logo-menu and dropdown-item are filled too, defensively, against
;; a future rung landing non-#f children on either without rediscovering
;; this exact class.
(method-set! selection-menu-manager 58 (method-of-type base-menu base-menu-method-58))
(method-set! jakx-logo-menu 58 (method-of-type base-menu base-menu-method-58))
(method-set! dropdown-item 58 (method-of-type base-menu base-menu-method-58))

;; base-menu-method-50 ("wait-enter"): declared in menu2-h.gc as a plain
;; (:methods (base-menu-method-50 () none)) entry, not a named :state-methods
;; slot, even though its real content (menu2.gc:880-927, gp-3 in the dead text)
;; is a state object - menu2-h.gc's own round-12 citation (a697acd0a) worked
;; this out first and installed the sleep-code stub this replaces the same way:
;; method-set! on the raw method id, with an explicit (the-as (function none)
;; ...) cast around the constructed state, because method-set! checks its value
;; against the slot's declared (function none) typespec and a bare `state` does
;; not satisfy it. The decode's own (new 'static 'state :name ... :next ... :exit
;; ...) literal does not compile as written either: it keyword-inits :name/:next/
;; :exit, and jakx's own (deftype state ...) (goal_src/jakx/kernel/gkernel-h.gc)
;; declares only parent/code/trans/post/enter/event, six fields, with no :name or
;; :next at all (jak3's copy of the same deftype is identical - this is not a
;; jakx-only trim). So this uses state's own :methods (new ...) constructor
;; instead (the same positional form a697acd0a's stub already proved compiles),
;; with the decode's real :enter and :code lambdas transcribed verbatim in place
;; of that round's #f/sleep-code placeholders.
(method-set!
  base-menu
  50
  (the-as
    (function none)
    (new
      'global
      'state
      'wait-enter
      (lambda :behavior base-menu
        ()
        (until (>= (the-as uint (- (current-time) (the-as int (-> self menu-time))))
                   (-> self info-ptr trans-info enter-delay)
                   )
          (suspend)
          )
        (go-virtual base-menu-state-51)
        )
      (the-as (function object) #f)
      default-base-menu-post
      (lambda :behavior base-menu
        ()
        (set! (-> self menu-time) (the-as uint (current-time)))
        (let ((v1-4 (-> self info-ptr trans-info enter-anim)))
          (when (!= v1-4 -1)
            (let ((gp-0 (-> self skel root-channel 0)))
              (joint-control-channel-group-eval!
                gp-0
                (the-as art-joint-anim (-> self draw art-group data v1-4))
                num-func-identity
                )
              (set! (-> gp-0 frame-num) 0.0)
              )
            )
          )
        )
      (the-as (function process int symbol event-message-block object) base-menu-event-handler)
      )
    )
  )

;; base-menu-state-51 ("enter"): a real :state-methods slot (menu2-h.gc), so this
;; uses defstate directly, matching a697acd0a's own round-12 stub for the same
;; slot. menu2.gc's own decode (825-836, gp-1) sets :event and :post to real
;; values (landed below since the prior rung), but its own :code was the bare
;; label `L763` with no corresponding defun anywhere in that file - a
;; decompiler control-flow miss the menu2-quartet-landing rung's own read-only
;; blueprint investigation (2026-08-23) separately resolved by name
;; (anon-function 103, ir2 header 34939): the donor redecode this rung
;; transcribes from (base-menu-event-handler-plus-states.gc) still shows the
;; same bare L763 reference and so confirms the attribution rather than
;; supplying the body itself; the body below is transcribed from the
;; blueprint's own section 3 verbatim, including the trailing unreachable
;; (sleep-code) every branch above it go-virtuals past (that is what the
;; decode says, not a typo introduced here) and the ja-no-eval macro use the
;; blueprint's own note calls for (it emits exactly the bytes op 35's
;; art-element+32 frame-count read needs).
(defstate base-menu-state-51 (base-menu)
  :virtual #t
  :event (the-as (function process int symbol event-message-block object) base-menu-event-handler)
  :code (behavior ()
          (if (-> self info-ptr trans-info)
              (let ((v1-4 (-> self info-ptr trans-info enter-anim))
                    (f30-0 (-> self info-ptr trans-info anim-speed))
                    )
                (cond
                  ((= v1-4 -1)
                   (if (-> self info-ptr 3d-menu-type)
                       (go-virtual base-menu-state-52)
                       )
                   )
                  (else
                    (ja-no-eval :group! (the-as art-joint-anim (-> self draw art-group data v1-4))
                                :num! (seek! max f30-0)
                                :frame-num 0.0
                                )
                    (until (ja-done? 0)
                      (suspend)
                      (ja :num! (seek! max f30-0))
                      )
                    (go-virtual base-menu-state-52)
                    )
                  )
                )
              (go-virtual base-menu-state-52)
              )
          (sleep-code)
          )
  :post default-base-menu-post
  )

;; base-menu-state-52 ("running"): a real :state-methods slot. The decode
;; (menu2.gc:770-823, gp-0) is clean - :event, :code and :post all resolved with
;; real types, no ERROR/WARN on this block - so all three are transcribed
;; verbatim below, including the loop shape as decoded (the :code lambda's inner
;; `(until (< s5-0 0) ...)` only ever increments s5-0 on one branch and
;; decrements on the other; that is what the decode says, not a typo introduced
;; here).
(defstate base-menu-state-52 (base-menu)
  :virtual #t
  :event (the-as (function process int symbol event-message-block object) base-menu-event-handler)
  :code (lambda :behavior base-menu
          ()
          (until #f
            (when (-> self info-ptr trans-info)
              (let ((gp-0 (-> self info-ptr trans-info running-anim)))
                (-> self info-ptr trans-info anim-speed)
                (let ((s5-0 0))
                  (when (!= gp-0 -1)
                    (until (< s5-0 0)
                      (ja :group! (-> self draw art-group data gp-0) :num! (identity (the float s5-0)))
                      (cond
                        ((and (!= (-> self info-ptr trans-info running-anim) -1) (not (ja-max? 0)))
                         (+! s5-0 1)
                         )
                        (else
                          (if (ja-max? 0)
                              (send-event (ppointer->process (-> self parent)) 'menu-selection-event 'running-anim-finished gp-0)
                              )
                          (+! s5-0 -1)
                          )
                        )
                      (suspend)
                      )
                    )
                  )
                )
              )
            (suspend)
            )
          #f
          )
  :post default-base-menu-post
  )

;; base-menu-method-53 ("hide"): declared in menu2-h.gc as a plain :methods
;; entry (base-menu-method-53 () none), not a named :state-methods slot,
;; matching base-menu-method-50 above - method-set! on the raw method id with
;; the same (the-as (function none) ...) cast around a positionally-built
;; state object, since a bare `state` does not satisfy the (function none)
;; typespec. base-menu-event-handler's own 'hide arm (menu2-quartet-
;; blueprints.md section 4) dispatches here when the current state is not
;; already 'hide, so this was the menu2-quartet-landing rung's own "LANDING
;; HAZARD (the (e2) class)" (blueprint section 4): the slot was UNFILLED
;; before this rung, so the first 'hide message would have run a nullptr
;; function. :code and :enter are transcribed verbatim from the donor
;; (base-menu-event-handler-plus-states.gc, gp-2). :event is NOT transcribed
;; from the donor: the donor's own gp-2 sets it to the bare label `L749`,
;; another decompiler control-flow miss with no corresponding defun anywhere
;; in menu2.gc and nothing this rung's blueprint resolved (unlike L763 above).
;; Installing base-menu-event-handler here (the same generic dispatcher every
;; other slot in this family falls through to once its own special-cased
;; messages are handled) is a safe, honest fallback rather than a guess at
;; L749's real content; resolving L749 for real is a follow-up.
(method-set!
  base-menu
  53
  (the-as
    (function none)
    (new
      'global
      'state
      'hide
      (lambda :behavior base-menu
        ()
        (when (-> self info-ptr trans-info)
          (let ((gp-0 (-> self info-ptr trans-info exit-anim)))
            (-> self info-ptr trans-info anim-speed)
            (let ((s5-0 0))
              (when (!= gp-0 -1)
                (until (< s5-0 0)
                  (ja :group! (-> self draw art-group data gp-0) :num! (identity (the float s5-0)))
                  (let ((v1-15 (and (-> self hidden?) (>= 60 s5-0))))
                    (if v1-15
                        (+! s5-0 1)
                        (+! s5-0 -1)
                        )
                    )
                  (suspend)
                  )
                (go-virtual base-menu-state-52)
                )
              )
            )
          )
        (go-virtual base-menu-state-52)
        )
      (the-as (function object) #f)
      default-base-menu-post
      (lambda :behavior base-menu
        ()
        (let ((v0-0 #t))
          (set! (-> self hidden?) (the-as basic v0-0))
          v0-0
          )
        )
      (the-as (function process int symbol event-message-block object) base-menu-event-handler)
      )
    )
  )

;; base-menu-method-55 ("exit"): same plain :methods slot class as
;; base-menu-method-53 above, and the same "LANDING HAZARD" class - hide's own
;; own event-handler forwards here via (go-virtual method-55-state) once the
;; parent asks the widget to die (blueprint section 4, 'die arm). :event and
;; :enter are transcribed verbatim from the donor (gp-4): the 'dying?/'die
;; short-circuit wrapper (returns #t/#f directly rather than forwarding
;; through base-menu-event-handler for those two messages, falling through to
;; it for everything else) and the "tell every child to die" :enter. :code
;; WAS held at sleep-code: the donor's own gp-4 set it to the bare label
;; `L718`, a third decompiler control-flow miss in this same family (alongside
;; L749 below and the then-unresolved L763), with no corresponding defun
;; anywhere in menu2.gc and nothing in that rung's blueprint (which only
;; covered the four top-level functions plus L763) that resolved it.
;;
;; L718 is resolved (issue 802): a scoped decode of menu2, anon-function 95,
;; tonight, recovers the body cleanly enough to transcribe below. Its own
;; warnings - "ERROR: failed type prop at 44: Could not figure out load:
;; (set! a1 (l.wu (+ a1 32)))" and "WARN: Return type mismatch none vs
;; object" - both trace to the same spot: the art-element -> frames ->
;; num-frames dereference feeding the frame-count-minus-one seek target, the
;; same shape base-menu-state-51's own :code already carries for "enter"
;; (ja-no-eval / until ja-done?, transcribed the same way here for "exit").
;; The type-prop failure cascades through every register downstream,
;; including the trailing suspend loop the block above always falls into
;; afterward (every path through it - dead arm, sleep-code, or animation -
;; converges here): a raw self+16 -> +0 -> +32 -> +68 -> +0 pointer walk
;; ending in a compare to 'exit, which the decode types `none` end to end.
;; gkernel-h.gc's own process/process-tree fields in that byte range are
;; self-marked "guessed by decompiler" and disagree with this same decode's
;; own cleanly-typed resolution of a nearby offset earlier in this function
;; (next-state, not the header's prev-state, at self+76), so this rung does
;; not lean on them for a name it cannot verify - the walk below is left as
;; raw (the-as (pointer int32) ...) offset casts, not invented field names.
;; The structurally dead middle arm (reached only if exit-anim were -1,
;; which the enclosing check above already excludes) is transcribed
;; faithfully rather than dropped. L749 (base-menu-method-53's own :event,
;; above) is still held; resolving it is a separate follow-up.
(method-set!
  base-menu
  55
  (the-as
    (function none)
    (new
      'global
      'state
      'exit
      (lambda :behavior base-menu
        ()
        (when (-> self info-ptr trans-info)
          (when (!= (-> self info-ptr trans-info exit-anim) -1)
            (let ((v1-7 (-> self info-ptr trans-info exit-anim))
                  (f30-0 (-> self info-ptr trans-info anim-speed))
                  )
              (cond
                ((= v1-7 -1)
                 ;; unreachable: the enclosing (!= ... -1) check above
                 ;; already diverted the -1 case; transcribed faithfully
                 ;; per the decode, not dropped
                 (if (-> self info-ptr 3d-menu-type)
                     (go-virtual base-menu-state-56)
                     (sleep-code)
                     )
                 )
                (else
                  (ja-no-eval
                    :group! (the-as art-joint-anim (-> self draw art-group data v1-7))
                    :num! (seek! max f30-0)
                    :frame-num 0.0
                    )
                  (until (ja-done? 0)
                    (suspend)
                    (ja :num! (seek! max f30-0))
                    )
                  (go-virtual base-menu-state-56)
                  )
                )
              )
            )
          )
        ;; raw self+16 -> +0 -> +32 -> +68 -> +0 chain (see header): the
        ;; decode types every local here `none`, so this is offset casts
        ;; rather than named fields
        (while (let* ((a0-11 (-> (the-as (pointer int32) self) 4))
                      (a1-13 (if (nonzero? a0-11)
                                 (-> (the-as (pointer int32) a0-11) 8)
                                 0
                                 )
                             )
                      (a0-14 (-> (the-as (pointer int32) a1-13) 17))
                      )
                 (= (-> (the-as (pointer symbol) a0-14) 0) 'exit)
                 )
          (suspend)
          )
        (go-virtual base-menu-state-56)
        )
      (the-as (function object) #f)
      default-base-menu-post
      (lambda :behavior base-menu
        ()
        (when (-> self child-handles)
          (dotimes (gp-0 (-> self child-handles length))
            (send-event (handle->process (-> self child-handles gp-0)) 'die)
            )
          #f
          )
        )
      (the-as
        (function process int symbol event-message-block object)
        (lambda :behavior base-menu
          ((arg0 object) (arg1 object) (arg2 object))
          (local-vars (a3-0 none))
          (case arg2
            (('dying?)
             #t
             )
            (('die)
             #f
             )
            (else
              (base-menu-event-handler
                (the-as process arg0)
                (the-as int arg1)
                (the-as symbol arg2)
                (the-as event-message-block a3-0)
                )
              )
            )
          )
        )
      )
    )
  )

;; base-menu-method-56 ("die"): a real :state-methods slot (menu2-h.gc), not a
;; plain :methods entry like 53/55/57 - base-menu-event-handler's own 'die arm
;; (blueprint section 4) dispatches here directly. Transcribed verbatim from
;; the donor (gp-6): the same 'dying?/'die short-circuit :event and
;; "tell every child to die" :enter as base-menu-method-55 above (the donor
;; repeats this wrapper by value at both sites rather than sharing a named
;; function, so it is transcribed twice here too), and a clean, fully-typed
