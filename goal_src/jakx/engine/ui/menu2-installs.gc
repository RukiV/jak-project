;;-*-Lisp-*-
(in-package goal)

;; name: menu2-installs.gc
;; name in dgo: menu2-installs
;; dgos: GAME

;; menu2-landing rung round 15 (issue 699), part 2: the spawn-road subset of
;; goal_src/jakx/engine/ui/menu2.gc, compiled for real. That file (cleaned of its
;; 2,158 register-typing artifacts by the prior commit on this branch) stays dead
;; and unwired - it is not a member of any .gd, so nothing in it has ever compiled
;; as part of (mi) - because most of its ~14,000 lines either share base-menu-
;; family vtable slots with subtypes this rung does not touch, or are themselves
;; garbled decode (see each stub's own citation below). This file lands only what
;; lmm-make-background-menu's (goal_src/jakx/engine/ui/menu/lobby-menu-manager.gc)
;; spawn road actually reaches: base-menu-init-by-other, the init function all
;; five base-menu spawn sites pass, and the base-menu method/state family (slots
;; 50/51/52 - wait-enter/enter/running) that init function's own enter-state
;; dispatch walks into (menu2-h.gc's own round-12 citation, a697acd0a, worked out
;; that exact road first and stubbed these same three slots with sleep-code; this
;; file replaces that safety net with the decode's own content wherever the decode
;; has any).
;;
;; Part 1 of this same rung (game/kernel/jakx/klink.cpp) stopped jakx_work_v5's
;; raw copies from ever executing their own top-level as x86 (they carry retail
;; MIPS, not compiled GOAL). GAME.CGO's raw "menu2.o" (decompiler_out/jakx/
;; raw_obj/menu2-GAME.go, wired by game.gp's own defstep, game.gp:114) carries a
;; second copy of these same method-set!/defstate installs in its own top-level
;; (game.gp's round-10 link-order audit, game.gp:136-153) - that top-level no
;; longer runs at all after Part 1, so this file's own top-level (compiled and
;; linked the ordinary opengoal way) is the only thing that ever writes these
;; slots. game.gd places this file's row immediately after menu2-h.o and well
;; before menu2.o's own row for exactly that reason: menu2-h.o declares the
;; slots, this file fills them, and the raw copy further down is inert data by
;; construction, not a competing installer.
;;
;; menu2-quartet-landing rung (issue 699, 2026-08-23): a fresh, scoped redecode
;; (allowed_objects ["menu2"], :behavior base-menu applied to the three
;; functions below, base-menu-info.joints retyped to (array int8)) resolved the
;; s6/pp+248 info-ptr wall that kept the three stubs below bring-up-only, and
;; turned up a seventh method/state slot (57, "dummy") the original round-15
;; survey did not see. This rung's own STEP 2 landed 53/55/56/57 and
;; base-menu-state-51's real :code below; STEP 3 (this block) replaces the
;; three bring-up stubs below with their real bodies and updates their
;; decompiler/config/jakx/all-types.gc externs to match. The three functions
;; are ordered default-base-menu-post, base-menu-event-handler,
;; base-menu-init-by-other rather than the stubs' original order: each one
;; is a plain function reference (not a method), so within this one file a
;; later definition is not visible to an earlier one, and
;; base-menu-init-by-other's own tail sets event-hook to
;; base-menu-event-handler while base-menu-event-handler's own
;; 'force-box-update arm calls default-base-menu-post - default-base-menu-post
;; has to compile first, then base-menu-event-handler, then
;; base-menu-init-by-other.

;; *last-menu-action*: base-menu-event-handler's own 'menu-selection-event arm
;; writes it, but nothing compiled ever defined it - only dead menu2.gc's own
;; "(define *last-menu-action* (the-as object #f))" (menu2.gc:17-18) and
;; decompiler/config/jakx/all-types.gc's own forward-declared
;; "(define-extern *last-menu-action* object)" (not loaded by (mi), a
;; decompiler-config-only symbol table). The (e2) class this rung's own CARE
;; check watches for is a call through an undefined symbol linking to 0; this
;; is the variable-definition version of the same gap (menuboot12's own
;; *ghost-rec* precedent, lobby-net-startup.gc), closed here rather than left
;; for base-menu-event-handler's real landing to trip over. Transcribed
;; verbatim from menu2.gc's own definition.
(define *last-menu-action* (the-as object #f))

;; default-base-menu-post: real body, transcribed from the menu2-quartet
;; redecode. Return type object, not none: its only caller (anon-function 79
;; menu2-GAME) tail-returns it directly and that anon-function's own declared
;; type is "(function object :behavior map-menu)".
(defbehavior default-base-menu-post base-menu ()
  (rlet ((vf0 :class vf)
         (vf4 :class vf)
         (vf5 :class vf)
         (vf6 :class vf)
         )
    (init-vf0-vector)
    (let ((f30-0 (/ (-> self info-ptr scale-x) 10))
          (f28-0 (/ (-> self info-ptr scale-y) 10))
          (f26-0 0.1)
          )
      (cond
        ((logtest? (-> self info-ptr flags) 1)
         (when (nonzero? (-> self draw))
           (let ((v0-0 (the-as object (logior (-> self draw status) (draw-control-status no-draw)))))
             (set! (-> self draw status) (the-as draw-control-status v0-0))
             v0-0
             )
           )
         )
        (else
          (if (nonzero? (-> self draw))
              (logclear! (-> self draw status) (draw-control-status no-draw))
              )
          (when (-> self info-ptr 3d-menu-type)
            (matrix->transformq (-> self j-mod transform) (math-camera-matrix))
            (cond
              ((-> self info-ptr joints)
               (let ((gp-1 (new 'stack-no-clear 'vector))
                     (s5-1 (new 'stack-no-clear 'vector))
                     (s4-0 (new 'stack-no-clear 'vector))
                     )
                 (set! (-> s4-0 quad) (-> self node-list data (-> self info-ptr joints 0) bone transform trans quad))
                 (transform-point-vector! gp-1 s4-0)
                 (+! (-> gp-1 x) -1792.0)
                 (+! (-> gp-1 y) -1840.0)
                 (when (-> self info-ptr trans-info)
                   (let ((f0-7 (* (-> self info-ptr trans-info 3d-offset x) f30-0))
                         (f1-5 (* (-> self info-ptr trans-info 3d-offset y) f28-0))
                         (f2-1 (* (-> self info-ptr trans-info 3d-offset z) f26-0))
                         (s3-0 (new 'stack-no-clear 'vector))
                         )
                     (let ((f2-2 (+ f2-1 (* -4096.0 f30-0))))
                       (set-vector! s3-0 f0-7 f1-5 f2-2 1.0)
                       )
                     (when (as-type self dropdown-item)
                       (let ((s1-0 (the-as dropdown-trans-info (-> self info-ptr trans-info)))
                             (s2-1 (the-as dropdown-item self))
                             )
                         (cond
                           ((and (-> s1-0 selected-offset) (-> s2-1 selected))
                            (set! (-> s2-1 selected-offset x)
                                  (seek-ease (-> s2-1 selected-offset x) (* (-> s1-0 selected-offset x) f30-0) 60.0 -1024.0 40.0)
                                  )
                            (set! (-> s2-1 selected-offset y)
                                  (seek-ease (-> s2-1 selected-offset y) (* (-> s1-0 selected-offset y) f28-0) 60.0 -1024.0 40.0)
                                  )
                            (set! (-> s2-1 selected-offset z)
                                  (seek-ease (-> s2-1 selected-offset z) (* (-> s1-0 selected-offset z) f26-0) 60.0 -1024.0 40.0)
                                  )
                            )
                           (else
                             (set! (-> s2-1 selected-offset x) (seek-ease (-> s2-1 selected-offset x) 0.0 60.0 1024.0 40.0))
                             (set! (-> s2-1 selected-offset y) (seek-ease (-> s2-1 selected-offset y) 0.0 60.0 1024.0 40.0))
                             (set! (-> s2-1 selected-offset z) (seek-ease (-> s2-1 selected-offset z) 0.0 60.0 1024.0 40.0))
                             )
                           )
                         (let ((a0-18 s3-0))
                           (let ((v1-45 s3-0)
                                 (a1-13 (-> s2-1 selected-offset))
                                 )
                             (.lvf vf4 (&-> v1-45 quad))
                             (.lvf vf5 (&-> a1-13 quad))
                             )
                           (.mov.vf.w vf6 vf0)
                           (.add.vf.xyz vf6 vf4 vf5)
                           (.svf (&-> a0-18 quad) vf6)
                           )
                         )
                       (set! (-> s3-0 w) 1.0)
                       )
                     (vector-matrix*! s3-0 s3-0 (math-camera-matrix))
                     (set! (-> self j-mod transform trans quad) (-> s3-0 quad))
                     )
                   )
                 (set! (-> self j-mod transform scale x) f30-0)
                 (set! (-> self j-mod transform scale y) f28-0)
                 (set! (-> self j-mod transform scale z) f26-0)
                 (ja-post)
                 (send-event self 'force-position gp-1)
                 (let ((s3-1 0)
                       (s2-3 0)
                       )
                   (while (< s3-1 (length (-> self info-ptr joints)))
                     (set! (-> s4-0 quad) (-> self node-list data (-> self info-ptr joints s3-1) bone transform trans quad))
                     (transform-point-vector! gp-1 s4-0)
                     (+! (-> gp-1 x) -1792.0)
                     (+! (-> gp-1 y) -1840.0)
                     (set! (-> s4-0 quad) (-> self node-list data (-> self info-ptr joints (+ s3-1 1)) bone transform trans quad))
                     (transform-point-vector! s5-1 s4-0)
                     (+! (-> s5-1 x) -1792.0)
                     (+! (-> s5-1 y) -1840.0)
                     (send-event self 'box-2d s2-3 gp-1 s5-1)
                     (send-event self 'box s2-3 (-> self node-list data (-> self info-ptr joints s3-1) bone transform))
                     (+! s2-3 1)
                     (+! s3-1 2)
                     )
                   )
                 )
               )
              (else
                (set! (-> self j-mod transform scale x) f30-0)
                (set! (-> self j-mod transform scale y) f28-0)
                (set! (-> self j-mod transform scale z) f26-0)
                (ja-post)
                )
              )
            )
          (if (and *hide-menus* (nonzero? (-> self draw)))
              (logior! (-> self draw status) (draw-control-status no-draw))
              )
          (base-menu-method-60 self)
          )
        )
      )
    )
  )

;; base-menu-event-handler: real body, transcribed from the menu2-quartet
;; redecode - a flat 13-arm case on the message symbol with a copy-pasted
;; child-forwarding loop (ten instantiations, one per arm that forwards to
;; children; transcribed as decoded rather than hoisted into a shared
;; function). The 'force-die arm's own forward loop sets the forwarded
;; message to the literal 'to-all-children rather than 'force-die - a proven
;; retail copy-paste (the identical shape recurs at 'to-all-children's own
;; arm immediately below it), transcribed verbatim, not fixed. 'die and
;; 'hide dispatch to slots 55 and 53 via the same
;; (go (the-as (state base-menu) (method-of-object self base-menu-method-N)))
;; idiom base-menu-init-by-other's own tail below uses for slot 50 - both
;; slots were landed by this rung's own STEP 2, closing what the blueprint
;; called out as this landing's own hazard class (a 'die or 'hide message
;; reaching an unfilled slot before STEP 2 landed).
(defbehavior base-menu-event-handler base-menu ((arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (rlet ((vf0 :class vf)
         (vf4 :class vf)
         (vf5 :class vf)
         (vf6 :class vf)
         )
    (init-vf0-vector)
    (case arg2
      (('die)
       (go (the-as (state base-menu) (method-of-object self base-menu-method-55)))
       )
      (('force-die)
       (when (-> self child-handles)
         (dotimes (s3-1 (-> self child-handles length))
           (when (handle->process (-> self child-handles s3-1))
             (let ((a1-2 (new 'stack-no-clear 'event-message-block)))
               (set! (-> a1-2 from) (process->ppointer arg0))
               (set! (-> a1-2 num-params) arg1)
               (set! (-> a1-2 message) 'to-all-children)
               (set! (-> a1-2 param 0) (-> arg3 param 0))
               (set! (-> a1-2 param 1) (-> arg3 param 1))
               (set! (-> a1-2 param 2) (-> arg3 param 2))
               (set! (-> a1-2 param 3) (-> arg3 param 3))
               (set! (-> a1-2 param 4) (-> arg3 param 4))
               (set! (-> a1-2 param 5) (-> arg3 param 5))
               (send-event-function (handle->process (-> self child-handles s3-1)) a1-2)
               )
             )
           )
         )
       (go empty-state)
       )
      (('menu-selection-event)
       (when (not (and (-> self next-state) (let ((v1-33 (-> self next-state name)))
                                              (or (= v1-33 'exit) (= v1-33 'enter))
                                              )
                       )
                  )
         (set! *last-menu-action* (-> arg3 param 0))
         (let ((a1-4 (new 'stack-no-clear 'event-message-block)))
           (set! (-> a1-4 from) (process->ppointer arg0))
           (set! (-> a1-4 num-params) arg1)
           (set! (-> a1-4 message) arg2)
           (set! (-> a1-4 param 0) (-> arg3 param 0))
           (set! (-> a1-4 param 1) (-> arg3 param 1))
           (set! (-> a1-4 param 2) (-> arg3 param 2))
           (set! (-> a1-4 param 3) (-> arg3 param 3))
           (set! (-> a1-4 param 4) (-> arg3 param 4))
           (set! (-> a1-4 param 5) (-> arg3 param 5))
           (send-event-function (ppointer->process (-> self parent)) a1-4)
           )
         )
       )
      (('to-all-children)
       (when (-> self child-handles)
         (dotimes (s2-0 (-> self child-handles length))
           (when (handle->process (-> self child-handles s2-0))
             (let ((a1-6 (new 'stack-no-clear 'event-message-block)))
               (set! (-> a1-6 from) (process->ppointer arg0))
               (set! (-> a1-6 num-params) arg1)
               (set! (-> a1-6 message) 'to-all-children)
               (set! (-> a1-6 param 0) (-> arg3 param 0))
               (set! (-> a1-6 param 1) (-> arg3 param 1))
               (set! (-> a1-6 param 2) (-> arg3 param 2))
               (set! (-> a1-6 param 3) (-> arg3 param 3))
               (set! (-> a1-6 param 4) (-> arg3 param 4))
               (set! (-> a1-6 param 5) (-> arg3 param 5))
               (send-event-function (handle->process (-> self child-handles s2-0)) a1-6)
               )
             )
           )
         )
       (base-menu-method-61 self arg0 arg1 arg2 arg3)
       )
      (('draw)
       (when (-> self child-handles)
         (dotimes (s3-2 (-> self child-handles length))
           (when (handle->process (-> self child-handles s3-2))
             (let ((a1-9 (new 'stack-no-clear 'event-message-block)))
               (set! (-> a1-9 from) (process->ppointer arg0))
               (set! (-> a1-9 num-params) arg1)
               (set! (-> a1-9 message) 'draw)
               (set! (-> a1-9 param 0) (-> arg3 param 0))
               (set! (-> a1-9 param 1) (-> arg3 param 1))
               (set! (-> a1-9 param 2) (-> arg3 param 2))
               (set! (-> a1-9 param 3) (-> arg3 param 3))
               (set! (-> a1-9 param 4) (-> arg3 param 4))
               (set! (-> a1-9 param 5) (-> arg3 param 5))
               (send-event-function (handle->process (-> self child-handles s3-2)) a1-9)
               )
             )
           )
         )
       (base-menu-method-60 self)
       )
      (('lose-focus)
       (when (-> self child-handles)
         (dotimes (s2-1 (-> self child-handles length))
           (when (handle->process (-> self child-handles s2-1))
             (let ((a1-11 (new 'stack-no-clear 'event-message-block)))
               (set! (-> a1-11 from) (process->ppointer arg0))
               (set! (-> a1-11 num-params) arg1)
               (set! (-> a1-11 message) arg2)
               (set! (-> a1-11 param 0) (-> arg3 param 0))
               (set! (-> a1-11 param 1) (-> arg3 param 1))
               (set! (-> a1-11 param 2) (-> arg3 param 2))
               (set! (-> a1-11 param 3) (-> arg3 param 3))
               (set! (-> a1-11 param 4) (-> arg3 param 4))
               (set! (-> a1-11 param 5) (-> arg3 param 5))
               (send-event-function (handle->process (-> self child-handles s2-1)) a1-11)
               )
             )
           )
         )
       (set! (-> self focused?) #f)
       #f
       )
      (('in-focus)
       (when (-> self child-handles)
         (dotimes (s2-2 (-> self child-handles length))
           (when (handle->process (-> self child-handles s2-2))
             (let ((a1-13 (new 'stack-no-clear 'event-message-block)))
               (set! (-> a1-13 from) (process->ppointer arg0))
               (set! (-> a1-13 num-params) arg1)
               (set! (-> a1-13 message) arg2)
               (set! (-> a1-13 param 0) (-> arg3 param 0))
               (set! (-> a1-13 param 1) (-> arg3 param 1))
               (set! (-> a1-13 param 2) (-> arg3 param 2))
               (set! (-> a1-13 param 3) (-> arg3 param 3))
               (set! (-> a1-13 param 4) (-> arg3 param 4))
               (set! (-> a1-13 param 5) (-> arg3 param 5))
               (send-event-function (handle->process (-> self child-handles s2-2)) a1-13)
               )
             )
           )
         )
       (let ((v0-0 (the-as object #t)))
         (set! (-> self focused?) (the-as basic v0-0))
         v0-0
         )
       )
      (('force-position)
       (when (= (-> self info-ptr box-index) -1)
         (let ((v1-150 (the-as vector (-> arg3 param 0))))
           (set! (-> self pos-x) (-> v1-150 x))
           (set! (-> self pos-y) (-> v1-150 y))
           (set! (-> self pos-z) (-> v1-150 z))
           )
         )
       (when (-> self child-handles)
         (dotimes (s2-3 (-> self child-handles length))
           (when (handle->process (-> self child-handles s2-3))
             (let ((a1-15 (new 'stack-no-clear 'event-message-block)))
               (set! (-> a1-15 from) (process->ppointer arg0))
               (set! (-> a1-15 num-params) arg1)
               (set! (-> a1-15 message) arg2)
               (set! (-> a1-15 param 0) (-> arg3 param 0))
               (set! (-> a1-15 param 1) (-> arg3 param 1))
               (set! (-> a1-15 param 2) (-> arg3 param 2))
               (set! (-> a1-15 param 3) (-> arg3 param 3))
               (set! (-> a1-15 param 4) (-> arg3 param 4))
               (set! (-> a1-15 param 5) (-> arg3 param 5))
               (send-event-function (handle->process (-> self child-handles s2-3)) a1-15)
               )
             )
           )
         #f
         )
       )
      (('box)
       (when (= (-> arg3 param 0) (-> self info-ptr box-index))
         (let* ((a2-8 (-> self joint-mat))
                (a3-2 (the-as (pointer uint128) (-> arg3 param 1)))
                (v1-178 (-> a3-2 0))
                (a0-84 (-> a3-2 1))
                (a1-16 (-> a3-2 2))
                (a3-3 (-> a3-2 3))
                )
           (set! (-> a2-8 rvec quad) v1-178)
           (set! (-> a2-8 uvec quad) a0-84)
           (set! (-> a2-8 fvec quad) a1-16)
           (set! (-> a2-8 trans quad) a3-3)
           )
         (when (!= arg0 self)
           (let ((a1-17 (new 'stack-no-clear 'vector)))
             (let ((a0-85 (-> self info-ptr trans-info)))
               (if a0-85
                   (set! (-> a1-17 quad) (-> a0-85 3d-offset quad))
                   (set! (-> a1-17 quad) (the-as uint128 0))
                   )
               )
             (let ((a2-9 a1-17))
               (let ((v1-183 a1-17)
                     (a0-88 (-> self extra-offset))
                     )
                 (.lvf vf4 (&-> v1-183 quad))
                 (.lvf vf5 (&-> a0-88 quad))
                 )
               (.mov.vf.w vf6 vf0)
               (.add.vf.xyz vf6 vf4 vf5)
               (.svf (&-> a2-9 quad) vf6)
               )
             (vector-matrix*! (-> self joint-mat trans) a1-17 (-> self joint-mat))
             )
           )
         )
       (when (-> self child-handles)
         (dotimes (s2-4 (-> self child-handles length))
           (when (handle->process (-> self child-handles s2-4))
             (let ((a1-19 (new 'stack-no-clear 'event-message-block)))
               (set! (-> a1-19 from) (process->ppointer arg0))
               (set! (-> a1-19 num-params) arg1)
               (set! (-> a1-19 message) arg2)
               (set! (-> a1-19 param 0) (-> arg3 param 0))
               (set! (-> a1-19 param 1) (-> arg3 param 1))
               (set! (-> a1-19 param 2) (-> arg3 param 2))
               (set! (-> a1-19 param 3) (-> arg3 param 3))
               (set! (-> a1-19 param 4) (-> arg3 param 4))
               (set! (-> a1-19 param 5) (-> arg3 param 5))
               (send-event-function (handle->process (-> self child-handles s2-4)) a1-19)
               )
             )
           )
         #f
         )
       )
      (('width-height)
       (when (not (and (-> self info-ptr 3d-menu-type) (!= arg0 self)))
         (when (= (-> arg3 param 0) (-> self info-ptr box-index))
           (if (= (-> self info-ptr width) -1)
               (set! (-> self width) (the-as int (-> arg3 param 1)))
               )
           (if (= (-> self info-ptr height) -1)
               (set! (-> self height) (the-as int (-> arg3 param 2)))
               )
           )
         (when (-> self child-handles)
           (dotimes (s2-5 (-> self child-handles length))
             (when (handle->process (-> self child-handles s2-5))
               (let ((a1-21 (new 'stack-no-clear 'event-message-block)))
                 (set! (-> a1-21 from) (process->ppointer arg0))
                 (set! (-> a1-21 num-params) arg1)
                 (set! (-> a1-21 message) arg2)
                 (set! (-> a1-21 param 0) (-> arg3 param 0))
                 (set! (-> a1-21 param 1) (-> arg3 param 1))
                 (set! (-> a1-21 param 2) (-> arg3 param 2))
                 (set! (-> a1-21 param 3) (-> arg3 param 3))
                 (set! (-> a1-21 param 4) (-> arg3 param 4))
                 (set! (-> a1-21 param 5) (-> arg3 param 5))
                 (send-event-function (handle->process (-> self child-handles s2-5)) a1-21)
                 )
               )
             )
           #f
           )
         )
       )
      (('hide)
       (when (-> self child-handles)
         (dotimes (s2-6 (-> self child-handles length))
           (when (handle->process (-> self child-handles s2-6))
             (let ((a1-23 (new 'stack-no-clear 'event-message-block)))
               (set! (-> a1-23 from) (process->ppointer arg0))
               (set! (-> a1-23 num-params) arg1)
               (set! (-> a1-23 message) arg2)
               (set! (-> a1-23 param 0) (-> arg3 param 0))
               (set! (-> a1-23 param 1) (-> arg3 param 1))
               (set! (-> a1-23 param 2) (-> arg3 param 2))
               (set! (-> a1-23 param 3) (-> arg3 param 3))
               (set! (-> a1-23 param 4) (-> arg3 param 4))
               (set! (-> a1-23 param 5) (-> arg3 param 5))
               (send-event-function (handle->process (-> self child-handles s2-6)) a1-23)
               )
             )
           )
         )
       (set! (-> self hidden?) (the-as basic #t))
       (if (not (and (-> self next-state) (= (-> self next-state name) 'hide)))
           (go (the-as (state base-menu) (method-of-object self base-menu-method-53)))
           )
       )
      (('unhide)
       (when (-> self child-handles)
         (dotimes (s2-7 (-> self child-handles length))
