;;-*-Lisp-*-
(in-package goal)

;; name: menu2-fx.gc
;; name in dgo: menu2-fx
;; dgos: GAME

;; menu widget draw rung (issue 759, a2), slice 4: the prim-strip/dropdown
;; chrome the selector box and glow layers draw through - the shadow
;; trifans and additive glow passes issue 759's own comments cite as this
;; slice's acceptance elements. This file sits immediately after
;; menu2-draw.o (game.gd) for the same link-order reason that file's own
;; header documents: menu2-h.o's deftypes for the whole base-menu family
;; must already exist, and slice 1's own base-menu-method-59 installs (that
;; file) must already be in place for the spawn chain this slice's own
;; draws run against.
;;
;; Kept in its own file rather than menu2-draw.gc per this rung's own
;; parallel-safety constraint: another lane is actively landing that file
;; on the same base branch. Every landing below is scoped and cross-
;; checked against that file's own already-landed neighbors (read-only;
;; cited by name at each site that leans on one) rather than touching it.
;;
;; Every method below is transcribed from a fresh scoped redecode of
;; menu2-GAME (allowed_objects ["menu2"], this worktree's own decompiler/
;; config, scratch --proj-path per the standard recipe; the worktree's own
;; out/jakx/fr3/GAME.fr3 verified byte-identical before and after). The
;; same decompiler-only notation classes menu2-draw.gc's own header
;; documents apply here too (call!/ret-value rewrites, raw l.wu/s.w! reads
;; needing an int base, casts landing at the consuming op) and are not
;; re-explained per site.

;; definition for method 10 of type menu-prim-strip-client
;; og:preserve-this issue 759's own prim-engine landing, slice 4 step 2.
;; menu2-h.gc already declares this method's own second argument as a bare
;; "object" rather than prim-strip (prim-strip-menu-method-66's own four
;; call sites below all pass a client's own "strip" field here, itself
;; declared basic - see that method's own note on why neither field is
;; retyped), so this body casts it once at the point of use, the same
;; place every caller already reads it from. What follows is otherwise a
;; direct read of this slice's own scoped redecode (14 raw ops, no ERROR):
;; append one prim-vertex at data[num-verts] - pos takes the vector
;; argument's own full quad, col takes the color argument reinterpreted as
;; rgba (prim-vertex's own nokick/col overlay, prim-h.gc, puts col at the
;; same machine offset - 12 - the raw decode stores through), and stq's
;; x/y take the two float UV arguments - then bump num-verts.
(defmethod menu-prim-strip-client-method-10 ((this menu-prim-strip-client) (arg0 object) (arg1 vector) (arg2 object) (arg3 float) (arg4 float))
  (let* ((strip (the-as prim-strip arg0))
         (vtx (-> strip data (-> strip num-verts)))
         )
    (set! (-> vtx pos quad) (-> arg1 quad))
    (set! (-> vtx col) (the-as rgba arg2))
    (set! (-> vtx stq x) arg3)
    (set! (-> vtx stq y) arg4)
    (set! (-> strip num-verts) (+ (-> strip num-verts) 1))
    )
  0
  (none)
  )

;; definition for method 66 of type prim-strip-menu
;; og:preserve-this issue 759's own prim-engine landing, slice 4 step 2.
;; This slice's own scoped redecode (menu2-GAME_disasm.gc, 438 raw lines)
;; carries two ERRORs, both resolved by understanding rather than a config
;; cast:
;;  - "Could not figure out load: (set! v1 (l.w v1))" is p-client-array's
;;    own length read. p-client-array and colors are both left basic in
;;    menu2-h.gc: base-menu-method-59 (prim-strip-menu), already landed in
;;    menu2-draw.gc, allocates both as real (array menu-prim-strip-client)
;;    and (array rgba) through 'new but pokes the field with a raw offset
;;    store rather than retyping the shared header, and this method reads
;;    them back the same way - a raw pointer cast at each array-header and
;;    element access - rather than introducing a second, inconsistent
;;    typing of the same two fields.
;;  - "Failed to guess stack use for 80" is five stack-allocated vectors
;;    (the origin accumulator plus four per-corner transform temporaries,
;;    sp+80/96/112/128/144, each 16 bytes apart - the missing 80 bytes)
;;    that this rung's own trap checklist already names for exactly this
;;    shape: (new 'stack-no-clear 'vector). The function's own leading
;;    (new 'stack-no-clear 'event-message-block) is the same idiom and is
;;    genuinely dead in this function - reserved, never read again by
;;    anything the redecode recovers - kept for the same reason
;;    menu2-draw.gc's own header keeps its own decoder-left dead stores: a
;;    leftover the raw compile still reserves, not a change in behavior.
;;    The accumulator is never reset between iterations either (no store
;;    zeroes it before the per-client cond runs) and the redecode shows no
;;    site that would; two more float registers (f0-0/f0-1) are set to a
;;    literal 0.0 immediately before the loop and never read again by
;;    anything the redecode recovers, so they do not zero it - transcribed
;;    as observed, not fixed.
;;
;; Per client, per frame: looks up the client's own strip's texture, and
;; if it resolves, positions a screen-aligned quad sized from the
;; sprite-info array's own scale-x/scale-y (offset 28/32) times the
;; texture's own w/h (offset 4/6, both int16), anchored per that same
;; sprite-info entry's own flags bits (128/256/8 - no symbolic enum exists
;; for them anywhere in this tree, so they stay literal), then appends all
;; four corners (UV 0/0, 1/0, 0/1, 1/1) through
;; menu-prim-strip-client-method-10 above with the client's own colors
;; array entry. -> this joint-mat is the same 2D layout matrix base-menu's
;; own width-array/height-array fields already sit beside
;; (all-types.gc's own offset-assert 320).
(defmethod prim-strip-menu-method-66 ((this prim-strip-menu))
  (new 'stack-no-clear 'event-message-block)
  (let ((accum (new 'stack-no-clear 'vector))
        (corner-0 (new 'stack-no-clear 'vector))
        (corner-1 (new 'stack-no-clear 'vector))
        (corner-2 (new 'stack-no-clear 'vector))
        (corner-3 (new 'stack-no-clear 'vector))
        )
    (dotimes (i (l.w (-> this p-client-array)))
      (let* ((client (the-as menu-prim-strip-client
                       (l.wu (+ (the-as int (-> this p-client-array)) 12 (* i 4)))
                       )
                     )
             (strip (the-as prim-strip (-> client strip)))
             (tex (lookup-texture-by-id (-> strip tex-id)))
             )
        (when tex
          (let* ((color (l.wu (+ (the-as int (-> this colors)) 12 (* i 4))))
                 (sinfo (the-as sprite-info
                          (l.wu
                            (+
                              (the-as int (-> (the-as sprite-menu-info (-> this info-ptr)) sprites-info))
                              12
                              (* i 4)
                              )
                            )
                          )
                        )
                 (w-off (* -102.4 (the float (-> tex w)) (-> sinfo scale-x)))
                 (h-off (* -102.4 (the float (-> tex h)) (-> sinfo scale-y)))
                 (w-off-half (* 0.5 w-off))
                 (h-off-half (* 0.5 h-off))
                 )
            (cond
              ((logtest? (-> sinfo flags) 128)
               (-! (-> accum x) w-off-half)
               )
              ((logtest? (-> sinfo flags) 256)
               (-! (-> accum y) h-off-half)
               )
              ((logtest? (-> sinfo flags) 8)
               (-! (-> accum x) w-off-half)
               (-! (-> accum y) h-off-half)
               )
              )
            (set! (-> corner-0 quad) (-> accum quad))
            (vector-matrix*! corner-0 corner-0 (-> this joint-mat))
            (menu-prim-strip-client-method-10 client (-> client strip) corner-0 color 0.0 0.0)
            (set! (-> corner-1 quad) (-> accum quad))
            (+! (-> corner-1 x) w-off)
            (vector-matrix*! corner-1 corner-1 (-> this joint-mat))
            (menu-prim-strip-client-method-10 client (-> client strip) corner-1 color 1.0 0.0)
            (set! (-> corner-2 quad) (-> accum quad))
            (+! (-> corner-2 y) h-off)
            (vector-matrix*! corner-2 corner-2 (-> this joint-mat))
            (menu-prim-strip-client-method-10 client (-> client strip) corner-2 color 0.0 1.0)
            (set! (-> corner-3 quad) (-> accum quad))
            (+! (-> corner-3 x) w-off)
            (+! (-> corner-3 y) h-off)
            (vector-matrix*! corner-3 corner-3 (-> this joint-mat))
            (menu-prim-strip-client-method-10 client (-> client strip) corner-3 color 1.0 1.0)
            )
          )
        )
      )
    )
  0
  (none)
  )

;; definition for method 69 of type dropdown-item
;; og:preserve-this issue 759's own prim-engine landing, slice 4 step 3: the
;; selector highlight road (the purple bar), one of this slice's own named
;; acceptance elements. This slice's own scoped redecode (587 raw lines)
;; carries three ERRORs, all resolved by understanding rather than a
;; config cast:
;;  - "Could not figure out load: (set! s2 (l.wu (+ v1 112)))" is
;;    dropdown-item-info's own selection-box-color (offset-assert 112,
;;    already declared uint32 in menu2-h.gc) - a packed rgba the decoder
;;    cannot follow through the logand/logior byte-masking below without
;;    already knowing it is a color; retyping the read as rgba below (both
;;    the base color and the glow color it feeds) turns every raw shift
;;    into a plain r/g/b/a field access.
;;  - "Failed to guess stack use for 80" is five more stack-no-clear
;;    vectors (the selection-box-offset copy plus four per-corner
;;    transform temps), the exact shape prim-strip-menu-method-66 above
;;    already resolves the same way; this method's own leading (new
;;    'stack-no-clear 'event-message-block) is dead the same way that
;;    method's own is.
;;  - "Unsupported inline assembly instruction kind - [srl a0, a0, 24]" is
;;    the alpha channel's own extraction out of the packed color; every
;;    other channel's own extraction resolves to a plain shift pair the
;;    decoder does accept; this one degrades to raw asm only because it is
;;    the top byte (shift by 24, not a multiple the decoder's own pattern
;;    matcher recognizes here) - reading it as -> (the-as rgba ...) a
;;    sidesteps the instruction entirely.
;;
;; Per row: this dropdown-item's own selection-box-width/height
;; (dropdown-item-info, offset 68/72, -1 meaning "use the row's own
;; width/height" - base-menu's own fields, all-types.gc offset-assert
;; 304/308) size a quad at the info's own selection-box-offset (offset 96).
;; The box's own base color is the info's own selection-box-color with
;; every channel scaled by the row's first string's own alpha
;; (menu-string-array's own data 0 alpha field - the purple bar fades with
;; its own row's text), then a second color lerps that base color's own
;; r/g/b toward a fixed target (48/16/96, a magenta-leaning purple) by a
;; sine-driven pulse in [0, 1] (0.5 * (1 + (sin ...)), pp's own clock
;; frame-counter as the time source) while keeping the first color's own
;; alpha - the additive glow issue 759's own comments cite. All four
;; corners draw through p-client-selection (offset 560, the same
;; basic-left-untyped-cast-at-use-site convention prim-strip-menu-method-66
;; above already established) with the glow color, matching that method's
;; own corner layout (UV 0/0, 1/0, 0/1, 1/1) except the two size-driven
;; corners subtract width/height rather than adding a texture-derived
;; offset. Every magic float below (the frame-counter's own animation-speed
;; scalar and the degrees-to-rotation-unit scale trigonometry.gc's own sin
;; expects, "rotation units") is kept as its exact bit pattern via
;; (the-as float #xHEX) rather than a decimal literal, since a decimal
;; round-trip is not guaranteed bit-exact and this transcription does not
;; improve on the retail constant.
(defmethod dropdown-item-method-69 ((this dropdown-item))
  (with-pp
    (new 'stack-no-clear 'event-message-block)
    (let ((box-width (-> this width))
          (box-height (-> this height))
          (info (the-as dropdown-item-info (-> this info-ptr)))
          )
      (when (!= (-> info selection-box-width) -1)
        (set! box-width (-> info selection-box-width))
        )
      (when (!= (-> info selection-box-height) -1)
        (set! box-height (-> info selection-box-height))
        )
      (when (-> this strings)
        (let* ((raw-color (the-as rgba (-> info selection-box-color)))
               (text-alpha (-> this strings data 0 alpha))
               (base-color (new 'static 'rgba
                             :r (the int (* text-alpha (the float (-> raw-color r))))
                             :g (the int (* text-alpha (the float (-> raw-color g))))
                             :b (the int (* text-alpha (the float (-> raw-color b))))
                             :a (the int (* text-alpha (the float (-> raw-color a))))
                             )
                           )
               (anim-scaled (* (the-as float #x3b5a740e) (the float (-> pp clock frame-counter))))
               (anim-frac (- anim-scaled (the float (the int anim-scaled))))
               (pulse-phase (* (* 360.0 anim-frac) (the-as float #x43360b61)))
               (pulse (* 0.5 (+ 1.0 (sin pulse-phase))))
               (glow-color (new 'static 'rgba
                             :r (the int (+ (the float (-> base-color r)) (* pulse (- 48.0 (the float (-> base-color r))))))
                             :g (the int (+ (the float (-> base-color g)) (* pulse (- 16.0 (the float (-> base-color g))))))
                             :b (the int (+ (the float (-> base-color b)) (* pulse (- 96.0 (the float (-> base-color b))))))
                             :a (-> base-color a)
                             )
                           )
               (client (the-as menu-prim-strip-client (-> this p-client-selection)))
               (corner-0 (new 'stack-no-clear 'vector))
               (corner-1 (new 'stack-no-clear 'vector))
               (corner-2 (new 'stack-no-clear 'vector))
               (corner-3 (new 'stack-no-clear 'vector))
               )
          (set! (-> corner-0 quad) (-> info selection-box-offset quad))
          (vector-matrix*! corner-0 corner-0 (-> this joint-mat))
          (menu-prim-strip-client-method-10 client (-> client strip) corner-0 glow-color 0.0 0.0)
          (set! (-> corner-1 quad) (-> info selection-box-offset quad))
          (-! (-> corner-1 x) (the float box-width))
          (vector-matrix*! corner-1 corner-1 (-> this joint-mat))
          (menu-prim-strip-client-method-10 client (-> client strip) corner-1 glow-color 1.0 0.0)
          (set! (-> corner-2 quad) (-> info selection-box-offset quad))
          (-! (-> corner-2 y) (the float box-height))
          (vector-matrix*! corner-2 corner-2 (-> this joint-mat))
          (menu-prim-strip-client-method-10 client (-> client strip) corner-2 glow-color 0.0 1.0)
          (set! (-> corner-3 quad) (-> info selection-box-offset quad))
          (-! (-> corner-3 x) (the float box-width))
          (-! (-> corner-3 y) (the float box-height))
          (vector-matrix*! corner-3 corner-3 (-> this joint-mat))
          (menu-prim-strip-client-method-10 client (-> client strip) corner-3 glow-color 1.0 1.0)
          )
        )
      )
    )
  0
  (none)
  )

;; definition for method 60 of type prim-strip-menu
;; og:preserve-this issue 759's own prim-engine landing, slice 4 step 4:
;; the strip draw dispatcher. This slice's own scoped redecode (43 raw
;; lines, a single benign "Could not figure out load" on p-client-array's
;; own length - the same class every sibling method in this file already
;; resolves the same way) clears every client's own strip through
;; menu-clear-strip (already landed, menu2-draw.gc) before rebuilding all
;; of them through prim-strip-menu-method-66 above - this rung's own
;; dispatch graph names this exact fall-through chain ("base-menu-
;; method-60 (prim-strip-menu) -> prim-strip-menu-method-66 -> menu-clear-
;; strip"). *hide-menus* gates the whole rebuild (math.gc's own already-
;; landed global).
(defmethod base-menu-method-60 ((this prim-strip-menu))
  (when (and (-> this p-client-array) (not *hide-menus*))
    (dotimes (i (l.w (-> this p-client-array)))
      (menu-clear-strip
        (the-as int
          (-> (the-as menu-prim-strip-client
                (l.wu (+ (the-as int (-> this p-client-array)) 12 (* i 4)))
                )
              strip
              )
          )
        )
      )
    (prim-strip-menu-method-66 this)
    )
  (none)
  )

;; definition for method 65 of type sprite-menu
;; og:preserve-this issue 759's own prim-engine landing, slice 4 step 4:
;; the sprite draw dispatcher. This slice's own scoped redecode (136 raw
;; lines) carries one ERROR, the same "Could not figure out load" class
;; every other -array length read in this slice hits, resolved the same
;; way (a raw pointer read rather than a retype of sprite-menu's own
;; basic-left sprites field, matching base-menu-method-59 (sprite-menu)'s
;; own already-landed allocation in menu2-draw.gc).
;;
;; Per sprite: positions each hud-sprite from the info's own sprites-info
;; array entry's own offset-from-index (sprite-info, offset 38) - a
;; negative index means "absolute", placed directly at this menu's own
;; pos-x/pos-y plus the sprite-info's own offset; an in-range index means
;; "relative to another sprite in the same array" through the already-
;; landed set-as-offset-from! (hud.gc:1283), the exact offset depending on
;; that OTHER sprite's own offset-dir (2 = the sprite-info's own raw
;; offset; 0 = the other sprite's own texture width times its own
;; scale-x, matching set-as-offset-from!'s own x-only positional call; 1 =
;; the same for height/scale-y, y-only); an out-of-range index instead
;; formats a warning to *stdebug*, read from the object's own .asm data
;; (L946: "Warning: offset-index is greater than number of sprites for
;; menu!"). Every sprite's own color.w (a vector4w component, hud-h.gc)
;; then takes half this sprite-menu's own alpha, and pos.z takes a large
;; sort constant (#x99999) whenever this menu's own pos-z is nonzero -
;; both raw-offset writes, matching this slice's own convention for basic-
;; left arrays, since sprite-menu.sprites is not retyped for the same
;; reason prim-strip-menu.p-client-array is not (menu2-draw.gc's own
;; already-landed allocation pokes it the same way).
(defmethod sprite-menu-method-65 ((this sprite-menu))
  (dotimes (i (l.w (-> this sprites)))
    (let* ((sinfo (the-as sprite-info
                    (l.wu
                      (+
                        (the-as int (-> (the-as sprite-menu-info (-> this info-ptr)) sprites-info))
                        12
                        (* i 4)
                        )
                      )
                    )
                  )
           (offset-from-index (-> sinfo offset-from-index))
           (cur-sprite (the-as hud-sprite (+ (the-as int (-> this sprites)) 12 (* i 64))))
           )
      (cond
        ((< offset-from-index 0)
         (set-hud-piece-position!
           cur-sprite
           (the int (+ (-> sinfo offset x) (-> this pos-x)))
           (the int (+ (-> sinfo offset y) (-> this pos-y)))
           )
         )
        ((< (l.w (-> this sprites)) offset-from-index)
         (format *stdebug* "Warning: offset-index is greater than number of sprites for menu!")
         )
        (else
          (let* ((ref-sprite (the-as hud-sprite (+ (the-as int (-> this sprites)) 12 (* offset-from-index 64))))
                 (ref-info (the-as sprite-info
                             (l.wu
                               (+
                                 (the-as int (-> (the-as sprite-menu-info (-> this info-ptr)) sprites-info))
                                 12
                                 (* offset-from-index 4)
                                 )
                               )
                             )
                           )
                 )
            (cond
              ((= (-> ref-info offset-dir) 2)
               (set-as-offset-from! cur-sprite (-> ref-sprite pos) (the int (-> sinfo offset x)) (the int (-> sinfo offset y)))
               )
              ((zero? (-> ref-info offset-dir))
               (set-as-offset-from!
                 cur-sprite
                 (-> ref-sprite pos)
                 (* (-> ref-sprite tex w) (the int (-> ref-sprite scale-x)))
                 0
                 )
               )
              ((= (-> ref-info offset-dir) 1)
               (set-as-offset-from!
                 cur-sprite
                 (-> ref-sprite pos)
                 0
                 (* (-> ref-sprite tex h) (the int (-> ref-sprite scale-y)))
                 )
               )
              )
            )
          )
        )
      (set! (-> cur-sprite color w) (the int (* 0.5 (-> this alpha))))
      (when (!= (-> this pos-z) 0.0)
        (set! (-> cur-sprite pos z) (the-as int #x99999))
        )
      )
    )
  (none)
  )

;; definition for method 60 of type sprite-menu
;; og:preserve-this issue 759's own prim-engine landing, slice 4 step 4:
;; the sprite draw dispatcher's own tail. This slice's own scoped redecode
;; (44 raw lines to the first ERROR, the same p-client-array/sprites-
;; length "Could not figure out load" class every sibling method in this
;; file already resolves the same way) repositions every qualifying
;; sprite through sprite-menu-method-65 above - once per sprite, a genuine
;; retail redundancy (the whole array's own positions get recomputed on
;; every qualifying entry rather than once before the loop; transcribed as
;; observed) - then draws it through hud-sprite-method-9 (hud-h.gc,
;; already declared dma-buffer level -> none). A sprite only qualifies
;; when it has a texture (tid, offset 48) and a nonzero scale-x/width
;; (offset 36, the two fields overlay). Falls through to base-menu's own
;; no-op method-60 the same way base-menu-method-59 (prim-strip-menu)
;; already does (this file, above) - bucket792 (vu1-user-h.gc) is the
;; already-registered bucket text.gc's own "bucket791/792" citation names
;; for exactly this class of 2D HUD overlay.
(defmethod base-menu-method-60 ((this sprite-menu))
  (let* ((s4-0 (-> *display* frames (-> *display* on-screen) global-buf))
         (orig-base (-> s4-0 base))
         )
    (when (-> this sprites)
      (dotimes (i (l.w (-> this sprites)))
        (let ((cur-sprite (the-as hud-sprite (+ (the-as int (-> this sprites)) 12 (* i 64)))))
          (when (and (-> cur-sprite tid) (!= (-> cur-sprite scale-x) 0.0))
            (sprite-menu-method-65 this)
            (hud-sprite-method-9 cur-sprite s4-0 (-> this level))
            )
          )
        )
      )
    (let ((new-base (-> s4-0 base)))
      (when (!= orig-base new-base)
        (set! (-> (the-as dma-packet new-base) dma) (new 'static 'dma-tag :id (dma-tag-id next)))
        (set! (-> (the-as dma-packet new-base) vif0) (new 'static 'vif-tag))
        (set! (-> (the-as dma-packet new-base) vif1) (new 'static 'vif-tag))
        (set! (-> s4-0 base) (&+ new-base 16))
        (dma-bucket-insert-tag
          (-> *display* frames (-> *display* on-screen) bucket-group)
          (bucket-id bucket792)
          orig-base
          (the-as (pointer dma-tag) new-base)
          )
        )
      )
    )
  (none)
  )

;; issue 759's own prim-engine landing, slice 4 step 5: slot re-installs
;; for every method this slice defines, on every subtype whose own deftype
;; already ran (menu2-h.o, game.gd rank 392) before this file's own row
;; (rank 399.5, immediately after menu2-draw.o) gives those methods a
;; real body. Section E of this rung's own evidence tables states the
;; hazard directly: method_set only propagates a new method to already-
;; created child types when *enable-method-set* is raised (REPL/-debug
;; link only), so a -boot boot never copies a parent's freshly-defined
;; method down into a child's own vtable snapshot - the same reason the
;; a1 rung (menu2-installs.gc) reinstalled base-menu-method-58 on three
;; sibling types.
;;
;; Scoped to the live -boot road's own widget chain (this rung's own
;; widget inventory: dropdown-item is the only concrete instance ever
;; spawned along this hierarchy) rather than the whole type tree - sprite-
;; ptr-menu, index-sprite-list-menu and big-text-menu (siblings off
;; prim-strip-menu/sprite-menu) and item-list-selection/item-list-driver-
;; selection/item-num-selection/item-num-max-selection/string-list-
;; selection/games-list-selection/basic-list-selection (dropdown-item's
;; and string-menu's own further descendants) all still have their own
;; deftype ahead of this file too and are NOT covered here; none is
;; spawned by this rung's own widget inventory, and none is touched or
;; verified by this landing. Flagged, not silently skipped.
;;
;; Slot 60 is deliberately absent from this list: string-menu already
;; carries its own full override (menu2-draw.gc, base-menu-method-60
;; (string-menu)), and that file's own reinstall of dropdown-item's slot
;; 60 already points at it (menu2-draw.gc:2031, "(method-of-type
;; string-menu base-menu-method-60)") - the more-derived override string-
;; menu/dropdown-item should inherit. prim-strip-menu-method-60 above
;; still reaches dropdown-item correctly whenever string-menu's own
;; method-60 calls up to its own parent by name, since prim-strip-menu-
;; method-66's own call inside that parent body dispatches virtually
;; through the real (dropdown-item) object's own type tag, not the
;; parent's static parameter type - which is exactly why prim-strip-menu-
;; method-66 and sprite-menu-method-65 both need reinstalling here despite
;; never being called with an explicit subtype cast anywhere in this file.
