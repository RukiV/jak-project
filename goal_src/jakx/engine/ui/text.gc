;; this symbol anywhere in the corpus yet (jakx-only, no jak3 twin); this
;; file is the closest evidenced home (a font-color concern, and this
;; file already hosts text/font-rendering helpers) until the real object
;; lands. Return type matches decompiler/config/jakx/all-types.gc's own
;; declaration for this symbol (JakXTypeConsistency requires the two to
;; agree).
(defun pulse-new-font-color ()
  (none)
  )
