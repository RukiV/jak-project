        )
    (if (and (= (scf-get-territory) 1) (zero? (the-as uint sv-20)))
        (set! sv-20 11)
        )
    (if (and (= (scf-get-territory) 1) (= sv-20 8) (or (= *game-mode* 'lan) (= *game-mode* 'online)))
        (set! sv-20 11)
        )
    (when (or (string= "subtit" arg0) (and (or (= sv-16 #f)
                                               (!= (-> (the-as game-text-info sv-16) language-id) sv-20)
                                               (not (string= (-> (the-as game-text-info sv-16) group-name) arg0))
                                               )
