;; og:preserve-this text-record-wall rung, runtime note (NOT a hold; this body
;; is the real decode and it is landed): this function is called every frame
;; from display-loop-main as (load-level-text-files -1).
;; *level-text-file-load-flag* is #t at top level and nothing landed clears
;; it, so the call always reaches load-game-text-info.
;;
;; Retired 2026-08-24: this paragraph originally reported the gap as data, not
;; code (iso_data/jakx/TEXT's 24 files unstaged into out/jakx/iso, game.gp's
;; text defsteps commented out, decompiler/config/jakx's process_game_text
;; false), and traced a specific consequence from that absence (RPC_STR's
;; Find() failing the missing name, a "Game text heap overrun!" line every
;; frame, no crash). Commit 780ada63a (2026-08-19, five days before this note
;; was first written) already staged all 24 retail files into out/jakx/iso via
;; game.gp's own copy-text-files/group-list "text" entries (see that file's
;; own note at goal_src/jakx/game.gp:674-684 for why jakx copies the retail
;; bytes verbatim rather than using jak3's decompile/compile game_text.gp
;; round trip); this worktree's own out/jakx/iso carries all 24 .TXT files
;; today, and the overlord's ReadDirectory (game/overlord/jak3/iso_cd.cpp:
;; 491-505) enumerates that directory with no extension filter, so RPC_STR's
;; Find() should succeed rather than fail. Still unverified at runtime by this
;; rung, which does not boot: a rowtext1 acceptance boot on this same branch
;; drew zero menu text despite the assets being staged, but with a different,
;; confirmed cause (OpenGLRenderer.cpp's bucket791/792 registrations silently
;; dropping string-menu's own row-text DMA as SkipRenderer, fixed alongside
;; this note) - verify *common-text* itself is non-#f at the next boot before
;; trusting this asset-staging fix rather than re-deriving the old failure
;; mode from scratch.
;; definition for function load-level-text-files
;; WARN: Return type mismatch int vs none.
(defun load-level-text-files ((arg0 int))
  (if (or *level-text-file-load-flag* (>= arg0 0))
      (load-game-text-info "common" (&-> '*common-text* value) *common-text-heap*)
      )
  0
  (none)
  )

;; og:preserve-this text-record-wall rung (held): draw-debug-text-box and
;; hyphenate-word are unchanged by this rung and stay walled for reasons
;; unrelated to the record-field class.
;;   draw-debug-text-box  "function has no type analysis. Cannot decompile."
;;     with no all-types entry. Adding the entry the decompiler itself
;;     suggests, (function font-context none) (jak3 carries exactly that),
;;     was tried in scratch: it trades the missing-type error for "Failed to
;;     guess label use for L172 in draw-debug-text-box:3" and still emits an
;;     untyped body. Reverted.
;;   hyphenate-word       same missing-type error; a bare (define-extern
;;     hyphenate-word function) was tried in scratch and changed nothing, so
;;     there is no signature to land it against. Reverted.
;;
;; print-game-text itself is landed below (issue 759, a2 rung), but as a
;; hand-port from the jak2/jak3 twins rather than a decode of this object's
;; own machine code: this object's own copy still reports the same six real
;; errors, four of them unsupported inline assembly (sllv v1, v0, r0), so its
;; true field-for-field body stays unread. The print-game-text-work type and
;; its method 3 stay held for exactly that reason, independent of this note:
;; the type is declared by this object's own top level via (type-new
;; 'print-game-text-work structure ...), and jakx's own print-game-text body,
;; still unread, is the only consumer that would reveal its field layout. The
;; top-level (method-set! (the-as type print-game-text-work) 3 L183) and the
;; (define *print-game-text-work* <static-data L171>) that follow it are held
;; with the type for the same reason; the landed function below does not
;; consume print-game-text-work at all, since the jak2/jak3 twins it is
;; ported from never had that type.

;; print-game-text: hand-port from goal_src/jak2/engine/ui/text.gc and
;; goal_src/jak3/engine/ui/text.gc (issue 759, a2 rung), not a decode of this
;; object (see the held note above for why). The two twins are near-
;; identical to each other (jak3 only adds a max-x field and a set-context!
;; method on top of jak2's shape).
;;
;; Retired 2026-08-24 (issue 759, rowtext4 crash investigation): this note
;; used to go on to claim jakx's own font-context "matches jak2's shape
;; exactly." It does not, by a wide margin. jakx's real, decompiled
;; font-context (decompiler/config/jakx/all-types.gc:16826-16875, ground
;; truth for this object's own binary, method-count-assert 30 / size-assert
;; #xbb) carries ten fields jak2/jak3 never had (calc-origin, calc-mat,
;; meters-per-texel, scaled-width, scaled-height, ialpha, y-spacing,
;; effect-time, effect, effect-color) and four methods inserted before the
;; shared setter block that jak2/jak3 also never had
;; (font-context-method-9 through -12, all landed in
;; goal_src/jakx/engine/gfx/font.gc). Those four extra methods shift every
;; setter's own slot number by +4 against jak2/jak3's numbering: jak2/jak3's
;; slot 12 is set-w! (goal_src/jak2/engine/gfx/font-h.gc:131,
;; goal_src/jak3/engine/gfx/font-h.gc:131); jakx's own slot 12 is
;; font-context-method-12 (font-h.gc:156, all-types.gc:16857).
;;
;; That divergence does not retroactively break this hand-port: every
;; font-context access print-game-text makes below is either a field read by
;; name (origin, width, height, scale, flags, color, alpha, start-line - all
;; present under the same name in jakx's own header, so the compiler
;; resolves them against jakx's real, current offsets regardless of the ten
;; extra fields interspersed around them) or a plain call
;; (draw-string/get-string-length, resolved by name against jakx's own
;; header too). No slot number is hardcoded anywhere in this function. The
;; risk the old claim posed was purely a documentation one: a future
;; jak2/jak3 hand-port for this object that assumed positional/slot parity
;; instead - a raw method-table read, or a reused jak2/jak3 mips2c body that
;; encodes a slot number rather than a name - would silently dispatch into
;; whichever of jakx's four extra methods actually holds jak2/jak3's slot
;; number, not the intended one. Checked directly for this rung's own
;; rowtext4 crash (.claude/scratch-tools/logs/gk-rowtext4.err.log): no call
;; in font.gc, text.gc, or menu2-draw.gc dispatches a font-context method by
;; raw slot number or by a name jakx does not itself declare at that slot,
;; so this specific hand-port is not where that landmine was live; landing
;; it here so the next person touching font-context does not re-trust the
;; retired claim above.
;;
;; jak2's body is the one transcribed, verbatim except for two adaptations
;; forced by symbols jak2/jak3 have that jakx does not:
;;   - the inner "measure the wrapped height, don't draw" recursive call
;;     jak2 routes through (bucket-id progress) and jak3 through (bucket-id
;;     hud-draw-hud-alpha); jakx's bucket-id enum (vu1-user-h.gc) carries
;;     neither name (issue 675 retired hud-draw-hud-alpha to the bare
;;     bucket579 slot, progress never existed here at all). The value is
;;     inert on this call path regardless of which bucket-id is passed: the
;;     recursive call always passes arg2=#t, so its own (when (not arg2) ...)
;;     guard is false and the with-dma-buffer-add-bucket block that would
;;     read the argument never runs. (bucket-id debug-menu) is used since it
;;     is jakx's own real, live menu-text-adjacent bucket (vu1-user-h.gc:863).
;;   - the jak2 tail that guards draw-debug-text-box behind (#when PC_PORT
;;     (if (and *debug-segment* *display-text-box*) ...)) is dropped rather
;;     than transcribed: PC_PORT is (defglobalconstant PC_PORT #t) in jakx
;;     (gcommon.gc:13), so #when PC_PORT is never compiled away here the way
;;     it would be on a #f build, and *display-text-box* is not declared
;;     anywhere in this tree while draw-debug-text-box is itself held two
;;     paragraphs up; keeping the tail verbatim would not compile. No
;;     behavior is lost that this tree could already reach.
;; *game-text-line* is the one new global this hand-port needed; see its own
;; og:preserve-this note next to *game-text-word* above.
(defun print-game-text ((arg0 string) (arg1 font-context) (arg2 symbol) (arg3 int) (arg4 bucket-id))
  "Print text."
  (local-vars
    (sv-16 float)
    (sv-20 float)
    (sv-24 font-flags)
    (sv-28 font-color)
    (sv-32 (pointer uint8))
    (sv-36 float)
    (sv-40 float)
    (sv-44 float)
    (sv-48 float)
    (sv-52 float)
    (sv-56 float)
    (sv-64 int)
    (sv-72 uint)
    (sv-80 int)
    (sv-88 int)
    (sv-96 int)
    (sv-104 uint)
    (sv-108 symbol)
    (sv-112 int)
    (sv-120 int)
    )
  (cond
    ((< 0.1 (-> arg1 scale))
     (set! sv-16 (-> arg1 origin x))
     (set! sv-20 (-> arg1 origin y))
     (set! sv-24 (-> arg1 flags))
     (set! sv-28 (-> arg1 color))
     (when (logtest? (-> arg1 flags) (font-flags middle-vert))
       (logclear! (-> arg1 flags) (font-flags middle-vert))
       (+! (-> arg1 origin y)
           (the float (the int (* 0.5 (- (-> arg1 height) (print-game-text arg0 arg1 #t 44 (bucket-id debug-menu))))))
           )
       )
     (set! sv-32 (-> arg0 data))
     (set! sv-36 (-> arg1 origin x))
     (set! sv-40 (-> arg1 origin x))
     (set! sv-44 (+ (-> arg1 origin x) (-> arg1 width)))
     (set! sv-48 (+ (-> arg1 origin y) (-> arg1 height)))
     (set! sv-52 (-> (get-string-length " " arg1) length))
     (set! sv-56 (* (if (logtest? (-> arg1 flags) (font-flags large))
                        (the float arg3)
                        28.0
                        )
                    (-> arg1 scale)
                    )
           )
     (set! sv-64 0)
     (if (logtest? (-> arg1 flags) (font-flags middle))
         (+! (-> arg1 origin x) (/ (-> arg1 width) 2))
         )
     (set! sv-72 (-> sv-32 0))
     (set! sv-80 0)
     (set! sv-88 0)
     (set! sv-96 0)
     (set! sv-104 (-> sv-32 1))
     (set! sv-108 (the-as symbol #f))
     (set! sv-112 0)
     (set! sv-120 0)
     (set! (-> *game-text-line* data 0) (the-as uint 0))
     (while (and (not (and (zero? sv-72) (zero? sv-80) (zero? sv-88))) (>= sv-48 (-> arg1 origin y)))
       (set! sv-120 0)
       (set! sv-32 (&-> sv-32 1))
       (set! sv-104 (-> sv-32 0))
       (set! sv-32 (&-> sv-32 -1))
       (cond
         ((and (> sv-72 0) (< sv-72 (the-as uint 4)))
          (set! (-> *game-text-word* data sv-80) sv-72)
          (set! sv-80 (+ sv-80 1))
          (set! (-> *game-text-word* data sv-80) sv-104)
          (set! sv-80 (+ sv-80 1))
          (set! sv-32 (&-> sv-32 1))
          )
         ((= sv-72 32)
          (set! (-> *game-text-word* data sv-80) sv-72)
          (set! sv-80 (+ sv-80 1))
          (set! sv-108 #t)
          )
         ((zero? sv-72)
          (if (nonzero? sv-80)
              (set! sv-108 #t)
              )
          (set! sv-112 (+ sv-112 1))
          )
         ((and (= sv-72 92) (= sv-104 92))
          (set! sv-32 (&-> sv-32 1))
          (if (nonzero? sv-80)
              (set! sv-108 #t)
              )
          (set! sv-112 (+ sv-112 1))
          )
         ((and (= sv-72 95) (= sv-104 95))
          (set! sv-32 (&-> sv-32 1))
          (set! (-> *game-text-word* data sv-80) (the-as uint 32))
          (set! sv-80 (+ sv-80 1))
          )
         (else
           (set! (-> *game-text-word* data sv-80) sv-72)
           (set! sv-80 (+ sv-80 1))
           )
         )
       (when sv-108
         (set! (-> *game-text-word* data sv-80) (the-as uint 0))
         (let ((f30-1 sv-36))
           (set! sv-120 (the int (the-as float (-> (get-string-length *game-text-word* arg1) length))))
           (let ((f0-26 (+ f30-1 (the float sv-120))))
             (if (= (-> *game-text-word* data (+ sv-80 -1)) 32)
                 (set! f0-26 (- f0-26 (the-as float sv-52)))
                 )
             (cond
               ((< sv-44 f0-26)
                (set! sv-112 (+ sv-112 1))
                )
               (else
                 (copy-charp<-charp (&-> *game-text-line* data sv-88) (-> *game-text-word* data))
                 (set! sv-88 (+ sv-88 sv-80))
                 (set! sv-80 0)
                 (set! sv-36 (+ sv-36 (the float sv-120)))
                 (set! sv-108 (the-as symbol #f))
                 )
               )
             )
           )
         )
       (while (> sv-112 0)
         (let ((f30-2 (+ (-> arg1 origin y) sv-56)))
           (when (and (>= sv-96 (the-as int (-> arg1 start-line))) #t)
             (when (= (-> *game-text-line* data (+ sv-88 -1)) 32)
               (set! (-> *game-text-line* data (+ sv-88 -1)) (the-as uint 0))
               0
               )
             (if (nonzero? (-> *game-text-line* data 0))
                 (set! sv-64 (+ sv-64 1))
                 )
             (when (not arg2)
               (with-dma-buffer-add-bucket ((s2-1 (-> *display* frames (-> *display* on-screen) global-buf))
                                            arg4
                                            )
                 (draw-string *game-text-line* s2-1 arg1)
                 ;; jak2's own font-work types last-color font-color
                 ;; (font-h.gc:299), a clean font-color <- font-color copy;
                 ;; jakx's own font-work types the same field uint8
                 ;; (goal_src/jakx/engine/gfx/font-h.gc:471), so the copy
                 ;; needs an explicit cast here to keep this port's own
                 ;; struct storage honest rather than retyping landed data.
                 (set! (-> arg1 color) (the-as font-color (-> *font-work* last-color)))
                 )
               )
             (set! (-> arg1 origin y) f30-2)
             )
           )
         (set! sv-96 (+ sv-96 1))
         (set! (-> *game-text-line* data 0) (the-as uint 0))
         (set! sv-88 0)
         (set! sv-112 (+ sv-112 -1))
         (set! sv-36 sv-40)
         (when sv-108
           (copy-charp<-charp (&-> *game-text-line* data sv-88) (-> *game-text-word* data))
           (set! sv-88 (+ sv-88 sv-80))
           (set! sv-80 0)
           (set! sv-108 (the-as symbol #f))
           (set! sv-36 (+ sv-36 (the float sv-120)))
           )
         )
       (when (nonzero? sv-72)
         (set! sv-32 (&-> sv-32 1))
         (set! sv-72 (-> sv-32 0))
         )
       )
     (set! (-> arg1 origin x) sv-16)
     (set! (-> arg1 origin y) sv-20)
     (set! (-> arg1 flags) sv-24)
     (set! (-> arg1 color) sv-28)
     (if (> sv-64 0)
         (* sv-56 (the float sv-64))
         0.0
         )
     )
    (else
      0.0
      )
    )
  )

;; definition for function disable-level-text-file-loading
;; WARN: Return type mismatch int vs none.
(defun disable-level-text-file-loading ()
  (set! *level-text-file-load-flag* #f)
  0
  (none)
  )

;; definition for function enable-level-text-file-loading
;; WARN: Return type mismatch int vs none.
(defun enable-level-text-file-loading ()
  (set! *level-text-file-load-flag* #t)
  0
  (none)
  )

;; og:preserve-this bring-up stub: lobby-default-post (menu-road rung 2,
