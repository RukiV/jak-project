;;-*-Lisp-*-
(in-package goal)

;; name: gui-h.gc
;; name in dgo: gui-h
;; dgos: ENGINE, GAME

;; +++gui-action
(defenum gui-action
  :type uint8
  :bitfield #f
  (none 0)
  (queue 1)
  (play 2)
  (playing 3)
  (stop 4)
  (stopping 5)
  (abort 6)
  (hide 7)
  (hidden 8)
  (fade 9)
  )
;; ---gui-action

;; +++gui-status
(defenum gui-status
  :type uint8 ;; not sure
  :bitfield #f
  (unknown 0)
  (pending 1)
  (ready 2)
  (active 3)
  (hide 4)
  (stop 5)
  )
;; ---gui-status

;; +++gui-channel
(defenum gui-channel
  :type uint8
  :bitfield #f
  (none 0)
  (art-load 16)
  (art-load-next 17)
  (background 18)
  (jak 19)
  (daxter 20)
  (sig 21)
  (ashelin 22)
  (beast 23)
  (jak-effect-1 24)
  (pecker 25)
  (jak-effect-2 26)
  (gun 27)
  (hal 28)
  (speech 29)
  (guard 30)
  (jak-mode 31)
  (alert 32)
  (citizen 33)
  (bbush 34)
  (rider 35)
  (task 36)
  (voice 47)
  (movie 64)
  (blackout 65)
  (query 66)
  (message 67)
  (notice 68)
  (subtitle 69)
  (supertitle 70)
  (notice-low 71)
  (resetter 72)
  (progress 73)
  (freeze 74)
  (subtitle-pc 78) ;; custom
  (screen 79)
  (hud-upper-right 80)
  (hud-upper-left 81)
  (hud-lower-right 82)
  (hud-lower-left 83)
  (hud-lower-left-1 84)
  (hud-lower-left-2 85)
  (hud-center-right 86)
  (hud-center-left 87)
  (hud-middle-right 88)
  (hud-middle-left 89)
  (hud-upper-center 90)
  (hud-upper-center-2 91)
  (hud-lower-center 92)
  (hud-auto-save 93)
  (hud-auto-save-message 94)
  (hud 95)
  (hud-mp-vehicle-main-0 96)
  (hud-mp-vehicle-main-1 97)
  (hud-mp-player-indicators-0 98)
  (hud-mp-player-indicators-1 99)
  (hud-mp-race-0 100)
  (hud-mp-race-1 101)
  (hud-mp-race-2 102)
  (hud-mp-race-3 103)
  (max 112)
  )
;; ---gui-channel

;; +++gui-connection-flags
(defenum gui-connection-flags
  :type uint8
  :bitfield #t
  (gcf0 0)
  (gcf1 1)
  (fo-curve 2)
  (fo-min 3)
  (fo-max 4)
  (volume 5)
  )
;; ---gui-connection-flags

;; DECOMP BEGINS

(deftype gui-connection (connection)
  ((priority    float                 :overlay-at param0)
   (action      gui-action            :overlay-at param1)
   (channel     gui-channel           :offset  21)
   (anim-part   uint8                 :offset  22)
   (flags       gui-connection-flags  :offset  23)
   (name        string                :overlay-at param2)
   (id          sound-id              :overlay-at param3)
   (handle      handle                :overlay-at next0)
   (time-stamp  time-frame            :overlay-at next1)
   (hold-time   time-frame)
   (fo-min      float)
   (fo-max      float)
   (fo-power    float)
   (fade        uint8)
   (volume      float)
   (qw-pad      int8                  4)
   )
  )


;; type gui-control is defined here, but it is unknown to the decompiler

;; og:preserve-this gui-control single-homed here (issue 534): new_type
;; (game/kernel/jakx/kscheme.cpp:1049) unconditionally rewrites every method
;; slot on every deftype execution of the same interned type object, parent
;; methods for inherited slots and literal 0 for custom slots. This type used
;; to be deftyped identically in three objects, linking in DGO order gui-h.o
;; (index 100), loader.o (248, home of the defmethods below), cam-states.o
;; (467); cam-states' copy, linking last, blanked every custom method slot
;; loader.o had just filled, making every landed gui-control method
;; undispatchable at runtime. The "byte-identical across all three copies"
;; convention this note used to describe was the bug, not a safeguard
;; against one; this file (earliest in DGO order, matching jak3's own
;; single-homed gui-h.gc) is now the sole deftype execution for gui-control.
;; The field layout matches all-types (verified byte-for-byte against the
;; live instance per findings.md) so the JakXTypeConsistency gate agrees.
;; cam-states.gc calls only m9 and m16 on this type; loader.gc still hosts
;; the defmethod bodies for the constructor and methods 9, 11, 12, 14, 15,
;; 16, 17, 19 and 25; generic-obs's sound-on-path needs m9/m17/m20 here.
;;
;; og:preserve-this gui-control keystone lane (issue 522): method 0's own raw decode
;; reads a2 (an int) and passes it straight through to (method-of-type engine new)'s
;; own count arg, matching jak3's twin constructor exactly ((defmethod new gui-control
;; ((allocation symbol) (type-to-make type) (arg0 int)) ...)); the 2-arg declaration
;; here dropped it (AGENTS.md's most-repeated defect class), which the raw asm exposed
;; as "Function may read a register that is not set: a2" until widened. The retail
;; top-level's own `(new 'global 'gui-control 64)` call site (loader.gc, its own
;; scoped decode) confirms the literal value the sole in-tree caller passes.
(deftype gui-control (basic)
  ((engine             engine)
   (update-time        time-frame)
   (connections        gui-connection  32  :inline)
   (spool-connections  gui-connection  4   :inline)
   (ids                sound-id        112)
   (times              time-frame      112)
   (cmd                pair            112)
   (group              uint8           112)
   )
  (:methods
    (new (symbol type int) _type_)
    (gui-control-method-9 (_type_ process int int string float int) uint) ;; add-request
    (gui-control-method-10 () none)
    (gui-control-method-11 (_type_ gui-connection) none) ;; stop-str
    (gui-control-method-12 (_type_ process gui-channel gui-action string int float sound-id) sound-id)
    (gui-control-method-13 () none)
    ;; og:preserve-this return type retyped sound-id (was none): scene
    ;; lane (issue 502), (code wait scene-player)'s own call site feeds
    ;; the result straight into gui-control-method-17's own uint arg
    ;; (the-as uint a1-30); matches this file's own all-types.gc twin,
    ;; which already carried the hint comment identifying this method as
    ;; lookup-gui-connection-id returning sound-id (JakXTypeConsistency
    ;; enforces goal_src == all-types, so the declared type here must
    ;; match that hint exactly, not just be call-site-compatible).
    (gui-control-method-14 (_type_ string object object) sound-id)
    ;; og:preserve-this return type retyped gui-connection (was none):
    ;; scene lane (issue 502); this file's own all-types.gc twin already
    ;; carries the hint comment identifying this method as
    ;; lookup-gui-connection returning gui-connection (jak3's own twin
    ;; call, goal_src/jak3/engine/scene/scene.gc). (code play-anim
    ;; scene-player)'s own call site casts and truthiness-tests the
    ;; result as gui-connection/none, which a none return cannot support
    ;; ("Cannot use none-typed variable in a condition").
    ;;
    ;; og:preserve-this arg count widened 3 -> 4 (gui-control keystone lane,
    ;; issue 522): the raw decode reads a 4th register (t0, an id filter
    ;; compared against each candidate's own id field) that the 3-arg
    ;; declaration left unset ("Function may read a register that is not
    ;; set: t0"); jak3's own twin, lookup-gui-connection, carries the
    ;; identical 4th arg typed sound-id. Kept as the loose object/object
    ;; types already declared for args 1-2 (those decode clean as-is;
    ;; widening only the genuinely missing one, not re-guessing the rest).
    (gui-control-method-15 (_type_ object object string sound-id) gui-connection)
    ;; og:preserve-this sixth arg retyped (function gui-connection symbol)
    ;; (was plain basic, matching the old all-types shape): the raw decode
    ;; calls it directly at op 51 of method 16's own body (jalr through a
    ;; value read straight from the arg register), and casting it to basic
    ;; left an unresolved "Called something that was not a function: basic"
    ;; failure; every other call site passing a real basic there was never
    ;; possible, only (the-as (function gui-connection symbol) #f) literals
    ;; (cam-states.gc's slow-mo call, cam-vehicle-crash :trans), so the
    ;; retype is a pure signature widening.
    (gui-control-method-16 (_type_ int uint int int string (function gui-connection symbol) process) int) ;; set-action!
    (gui-control-method-17 (_type_ uint) uint) ;; get-status
    ;; og:preserve-this arg count and return type widened () none ->
    ;; (gui-channel) symbol (gui-control completion lane, issue 531):
    ;; loader.gc's own method 19 body dispatches this method inside a (not
    ;; ...) condition, which the compiler rejects outright for a none-typed
    ;; callee ("Cannot use none-typed variable in a condition"), the same
    ;; tell loader.gc's own method 17 landing note already names for the
    ;; identical class. The raw asm settles both the count and the type:
    ;; method 19's own vtable read at op 6 (slot 88) is followed by op 7
    ;; ("or a1, s4, r0"), setting a1 to arg0 (the gui-channel) before the
    ;; jalr, not a no-arg call; jak3's own twin (gui-control-method-18,
    ;; still unnamed in jakx) carries the identical one-arg, symbol-return
    ;; shape per this file's own all-types.gc hint comment. The method's own
    ;; body stays unlanded; only the declaration widens so method 19
    ;; compiles honestly.
    (gui-control-method-18 (_type_ gui-channel) symbol)
    ;; og:preserve-this arg count widened () -> (gui-channel gui-connection),
    ;; return type widened none -> symbol (gui-control keystone lane, issue
    ;; 522): gui-control-method-19 is dispatched via method-of-object from
    ;; both loader.gc's own method 16 and method 17 bodies, and both raw
    ;; call sites set a1 to a byte read off the found connection's own
    ;; channel field (offset 21) and a2 to the connection itself before the
    ;; jalr, not zero args as the previously declared "() none" signature
    ;; implied and as the decompiler's own pretty-print showed (a channel
    ;; read as a dead statement immediately before a zero-arg call is the
    ;; decompiler's tell for an argument it could not associate with the
    ;; indirect call, because the call's own declared type only expected
    ;; zero args). Retyped to (_type_ gui-channel gui-connection) symbol,
    ;; matching this file's own all-types.gc hint comment (jak3's
    ;; handle-command-list) and both jakx call sites' actual register
    ;; evidence; loader.gc's own method 16 body is corrected to pass the two
    ;; arguments for real rather than transcribing the decompiler's
    ;; dead-statement artifact. loader.gc's own og:preserve-this note near
    ;; its method 19 defmethod carries the evidence for that method's own
    ;; body (methods 18 and 24 dispatch).
    (gui-control-method-19 (_type_ gui-channel gui-connection) symbol)
    ;; og:preserve-this arg count widened 6 -> 7 (gui-control completion
    ;; lane, issue 531): all three jakx call sites (ambient.gc's talker-
    ;; init, cam-states.gc's cam-vehicle-crash :enter, coliseum-obs-female-
    ;; statue.gc's coli-break-object-init-by-other) carry a bare #t
    ;; statement immediately before this method's own dispatch, the same
    ;; dead-statement tell as method 19's own arg-count defect above; a
    ;; fresh scoped decode of this object's own method 20 confirms it from
    ;; the callee side too ("Bad register dependency on t3", plus the raw
    ;; asm's own op 5, "or s1, t3, r0", reading a 7th register right after
    ;; arg5/t2 at op 4 with no declared slot for it). The body branches on
    ;; that 7th argument directly (op 18, "beq s7, s1, L283", i.e. (if
    ;; t3-0 ...)): when truthy it runs the exact jak3-twin body (the
    ;; existing 6-arg logic, "(if arg1 (logior! flags gcf1))"); when false
    ;; it unconditionally sets a bitfield flag jak3 has no twin for
    ;; (gui-connection-flags value 0x40, bit 6, not yet named in this
    ;; file's enum). Every current call site passes #t here (the orphan is
    ;; always the literal symbol, not a computed value), so the false arm
    ;; is currently dead from every landed caller; the type still needs the
    ;; slot; jak3's own twin config comment (all-types.gc's held block)
    ;; matches the old 6-arg shape exactly, the copied-from-twin trap this
    ;; issue names. The method's own body stays unlanded (still erroring,
    ;; missing only the gui-connection-flags bit); only the declaration and
    ;; its three callers widen so the type is honest and the compiled calls
    ;; stop dropping the argument.
    (gui-control-method-20 (_type_ uint symbol int int int float symbol) object) ;; sound-params-set!
    (gui-control-method-21 () none)
    (gui-control-method-22 () none)
    (gui-control-method-23 () none)
    ;; og:preserve-this arg count and return type widened () none ->
    ;; (gui-channel gui-channel symbol gui-connection) symbol (gui-control
    ;; completion lane, issue 531): loader.gc's own method 19 body
    ;; dispatches this method four times, each inside a (not ...) condition,
    ;; which the compiler rejects for a none-typed callee, the same "Cannot
    ;; use none-typed variable in a condition" tell as method 18 above. The
    ;; raw asm settles the shape: all four call sites read the vtable slot
    ;; at offset 112, then set a1 to arg0 (the outer gui-channel), a2 to a
    ;; per-branch channel value, a3 to the cmd-list entry's own cdr (the
    ;; action payload split out in method 19's own loop body), and t0 to
    ;; arg1 (the gui-connection); jak3's own twin (handle-command) carries
    ;; the identical four-arg, symbol-return shape per this file's own
    ;; all-types.gc hint comment, and jak3's own handle-command-list body
    ;; calls it with the exact same argument shape at each of its own three
    ;; case branches plus its else arm. The old () none declaration's own
    ;; decode failed immediately, at op 5 ("add failed: int <uninitialized>",
    ;; the same dropped-argument tell as every other fix in this note); with
    ;; the widened declaration in place, a fresh scoped decode of this
    ;; method's own body now goes fully clean with no further config
    ;; needed, matching jak3's own handle-command structurally and calling
    ;; only already-landed methods (11, 15, 16, 17). Flagged for a
    ;; follow-up rung to land: only the declaration widens here, method
    ;; 24's own body is not landed by this note.
    (gui-control-method-24 (_type_ gui-channel gui-channel symbol gui-connection) symbol)
    (gui-control-method-25 (_type_ gui-connection object) none) ;; channel-id-set!
    )
  )
(define-extern *gui-control* gui-control)
