;;-*-Lisp-*-
(in-package goal)

;; name: gui-h.gc
;; name in dgo: gui-h
;; dgos: ENGINE, GAME

;; +++gui-action
(defenum gui-action
  :type uint8
  :bitfield #f
  (none 0)
  (queue 1)
  (play 2)
  (playing 3)
  (stop 4)
  (stopping 5)
  (abort 6)
  (hide 7)
  (hidden 8)
  (fade 9)
  )
;; ---gui-action

;; +++gui-status
(defenum gui-status
  :type uint8 ;; not sure
  :bitfield #f
  (unknown 0)
  (pending 1)
  (ready 2)
  (active 3)
  (hide 4)
  (stop 5)
  )
;; ---gui-status

;; +++gui-channel
(defenum gui-channel
  :type uint8
  :bitfield #f
  (none 0)
  (art-load 16)
  (art-load-next 17)
  (background 18)
  (jak 19)
  (daxter 20)
  (sig 21)
  (ashelin 22)
  (beast 23)
  (jak-effect-1 24)
  (pecker 25)
  (jak-effect-2 26)
  (gun 27)
  (hal 28)
  (speech 29)
  (guard 30)
  (jak-mode 31)
  (alert 32)
  (citizen 33)
  (bbush 34)
  (rider 35)
  (task 36)
  (voice 47)
  (movie 64)
  (blackout 65)
  (query 66)
  (message 67)
  (notice 68)
  (subtitle 69)
  (supertitle 70)
  (notice-low 71)
  (resetter 72)
  (progress 73)
  (freeze 74)
  (subtitle-pc 78) ;; custom
  (screen 79)
  (hud-upper-right 80)
  (hud-upper-left 81)
  (hud-lower-right 82)
  (hud-lower-left 83)
  (hud-lower-left-1 84)
  (hud-lower-left-2 85)
  (hud-center-right 86)
  (hud-center-left 87)
  (hud-middle-right 88)
  (hud-middle-left 89)
  (hud-upper-center 90)
  (hud-upper-center-2 91)
  (hud-lower-center 92)
  (hud-auto-save 93)
  (hud-auto-save-message 94)
  (hud 95)
  (hud-mp-vehicle-main-0 96)
  (hud-mp-vehicle-main-1 97)
  (hud-mp-player-indicators-0 98)
  (hud-mp-player-indicators-1 99)
  (hud-mp-race-0 100)
  (hud-mp-race-1 101)
  (hud-mp-race-2 102)
  (hud-mp-race-3 103)
  (max 112)
  )
;; ---gui-channel

;; +++gui-connection-flags
(defenum gui-connection-flags
  :type uint8
  :bitfield #t
  (gcf0 0)
  (gcf1 1)
  (fo-curve 2)
  (fo-min 3)
  (fo-max 4)
  (volume 5)
  )
;; ---gui-connection-flags

;; DECOMP BEGINS

(deftype gui-connection (connection)
  ((priority    float                 :overlay-at param0)
   (action      gui-action            :overlay-at param1)
   (channel     gui-channel           :offset  21)
   (anim-part   uint8                 :offset  22)
   (flags       gui-connection-flags  :offset  23)
   (name        string                :overlay-at param2)
   (id          sound-id              :overlay-at param3)
   (handle      handle                :overlay-at next0)
   (time-stamp  time-frame            :overlay-at next1)
   (hold-time   time-frame)
   (fo-min      float)
   (fo-max      float)
   (fo-power    float)
   (fade        uint8)
   (volume      float)
   (qw-pad      int8                  4)
   )
  )


;; type gui-control is defined here, but it is unknown to the decompiler

;; og:preserve-this gui-control carries the full reconstructed field layout, matching
;; all-types (verified byte-for-byte against the live instance per findings.md) so the
;; JakXTypeConsistency gate agrees; the same shape lives in cam-states.gc, which builds
;; later and redefines it identically. generic-obs's sound-on-path needs m9/m17/m20 here.
(deftype gui-control (basic)
  ((engine             engine)
   (update-time        time-frame)
   (connections        gui-connection  32  :inline)
   (spool-connections  gui-connection  4   :inline)
   (ids                sound-id        112)
   (times              time-frame      112)
   (cmd                pair            112)
   (group              uint8           112)
   )
  (:methods
    (new (symbol type) _type_)
    (gui-control-method-9 (_type_ process int int string float int) uint) ;; add-request
    (gui-control-method-10 () none)
    (gui-control-method-11 (_type_ gui-connection) none)
    (gui-control-method-12 (_type_ process gui-channel gui-action string int float sound-id) sound-id)
    (gui-control-method-13 () none)
    (gui-control-method-14 (_type_ string object object) none)
    (gui-control-method-15 (_type_ object object string) none)
    (gui-control-method-16 (_type_ int uint int int string (function gui-connection symbol) process) int) ;; set-action!
    (gui-control-method-17 (_type_ uint) uint) ;; get-status
    (gui-control-method-18 () none)
    (gui-control-method-19 () none)
    (gui-control-method-20 (_type_ uint symbol int int int float) object) ;; sound-params-set!
    (gui-control-method-21 () none)
    (gui-control-method-22 () none)
    (gui-control-method-23 () none)
    (gui-control-method-24 () none)
    (gui-control-method-25 (_type_ gui-connection object) none)
    )
  )
(define-extern *gui-control* gui-control)
