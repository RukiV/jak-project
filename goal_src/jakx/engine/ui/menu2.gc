(defmethod relocate ((this sprite-menu) (offset int))
  (when (-> this sprites)
    (if (nonzero? (-> this sprites))
        (&+! (-> this sprites) offset)
        )
    )
  (when (-> this width-array)
    (if (nonzero? (-> this width-array))
        (&+! (-> this width-array) offset)
        )
    (if (nonzero? (-> this height-array))
        (&+! (-> this height-array) offset)
        )
    )
  (call-parent-method this offset)
  )

