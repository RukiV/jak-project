              ((-> self info-ptr trans-info)
               (cond
                 ((= (-> self info-ptr trans-info enter-anim) -1)
                  (when (let* ((ti (the-as dropdown-trans-info (-> self info-ptr trans-info)))
                                (elapsed-secs
                                  (* 0.0033333334
                                     (the float (- (-> self clock frame-counter) (the-as time-frame (-> self menu-time))))
                                     )
