              (set! (-> s4-1 height) (/ (the float (-> this height)) METERS_PER_TEXEL))
              (set! (-> s4-1 scale) (-> this strings data s3-1 scale))
              (set! (-> s4-1 flags) (the-as font-flags (-> this strings data s3-1 flags)))
              (set! (-> s4-1 color) (-> this strings data s3-1 color))
              (set! (-> s4-1 alpha) (-> this strings data s3-1 alpha))
