;;-*-Lisp-*-
(in-package goal)

;; name: text-h.gc
;; name in dgo: text-h
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

(deftype game-text (structure)
  ((id    text-id)
   (text  string)
   )
  :pack-me
  )


(deftype game-text-info (basic)
  ((length       int32)
   (language-id  int32)
   (group-name   string)
   (dic-index    uint32)
   (dic-data     uint32)
   (text         uint32)
   (text-data    uint32)
   )
  (:methods
    ;; og:preserve-this net-hud rung: return type retyped none -> string. Both
    ;; hud-item-string-method-25 (already landed, this same corpus) and
    ;; hud-item-string-method-9 (net-hud.gc) treat its call result as a string,
    ;; the former with an explicit (the-as string ...) cast and the latter
    ;; passing it straight into strlen at a +4 char-data offset; the return-type
    ;; mismatch was already recorded as a suggestion in all-types.gc's own
    ;; comment for this method but never applied. Scoped decode, net-hud_ir2.asm,
    ;; this rung.
    (game-text-info-method-9 (_type_ object object) string)
    (game-text-info-method-10 (_type_ object object) none)
    (game-text-info-method-11 (_type_ object) none)
    (game-text-info-method-12 (_type_ object object) none)
    )
  )


(define *text-group-names* (new 'static 'boxed-array :type string "common"))

(define *common-text-heap* (new 'global 'kheap))

(define *common-text* (the-as game-text-info #f))
