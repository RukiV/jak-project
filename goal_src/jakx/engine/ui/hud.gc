;; og:preserve-this hud-4 rung: hud-corners-method-9 gains its real 5-arg
;; shape (see hud-h.gc's own :methods comment) and lands from the resulting
;; clean decode. hud-corners's own data field retyped uint64 4 -> int32 8 in
;; hud-h.gc (same rung, same evidence): every access to it anywhere in this
;; corpus, here and at hud-sprite-method-9's own reads below, is a 32-bit
;; sw/lw of one half of a uint64 element, never a genuine 64-bit sd/ld;
;; casting the raw self pointer per-op does not work here because self is
;; never reassigned across the whole function, so a type_casts.jsonc cast on
;; it retypes every other use of self for its entire lifetime and regresses
;; the earlier data[0] writes.
;; definition for method 9 of type hud-corners
(defmethod hud-corners-method-9 ((this hud-corners) (arg0 vector4w) (arg1 float) (arg2 hud-sprite-flags) (arg3 float) (arg4 float))
  (cond
    ((= arg1 0.0)
     (let ((v1-2 (the int (* 16.0 (-> *video-params* relative-x-scale) arg3)))
           (a0-2 (the int (* 16.0 arg4)))
           (a2-1 (-> this data))
           (a1-1 (&-> this data 6))
           )
       (cond
         ((logtest? arg2 (hud-sprite-flags hsf2))
          (set! (-> a2-1 0) (- (* (+ (-> arg0 x) 1792) 16) v1-2))
          (set! (-> a2-1 1) (* (+ (-> arg0 y) 1840) 16))
          )
         ((logtest? arg2 (hud-sprite-flags hsf3))
          (set! (-> a2-1 0) (- (* (+ (-> arg0 x) 1792) 16) (/ v1-2 2)))
          (set! (-> a2-1 1) (- (* (+ (-> arg0 y) 1840) 16) (/ a0-2 2)))
          )
         (else
           (set! (-> a2-1 0) (* (+ (-> arg0 x) 1792) 16))
           (set! (-> a2-1 1) (* (+ (-> arg0 y) 1840) 16))
           )
         )
       (set! (-> a1-1 0) (+ (-> a2-1 0) v1-2))
       (set! (-> a1-1 1) (+ (-> a2-1 1) a0-2))
       )
     )
    (else
      (let* ((f30-0 (sin arg1))
             (f0-8 (cos arg1))
             (a0-5 (the int (* 16.0 (-> *video-params* relative-x-scale) arg3 f0-8)))
             (v1-9 (the int (* -16.0 arg3 f30-0)))
             (a1-4 (the int (* 16.0 (-> *video-params* relative-x-scale) arg4 f30-0)))
             (a2-3 (the int (* 16.0 arg4 f0-8)))
             )
        (-> this data)
        (&-> this data 2)
        (&-> this data 4)
        (&-> this data 6)
        (cond
          ((logtest? arg2 (hud-sprite-flags hsf2))
           (set! (-> this data 2) (* (+ (-> arg0 x) 1792) 16))
           (set! (-> this data 3) (* (+ (-> arg0 y) 1840) 16))
           (set! (-> this data 0) (- (-> this data 2) a0-5))
           (set! (-> this data 1) (- (-> this data 3) v1-9))
           (set! (-> this data 4) (+ (- (-> this data 2) a0-5) a1-4))
           (set! (-> this data 5) (+ (- (-> this data 3) v1-9) a2-3))
           (set! (-> this data 6) (+ (-> this data 2) a1-4))
           (set! (-> this data 7) (+ (-> this data 3) a2-3))
           )
          ((logtest? arg2 (hud-sprite-flags hsf3))
           (set! (-> this data 0) (- (* (+ (-> arg0 x) 1792) 16) (/ (+ a0-5 a1-4) 2)))
           (set! (-> this data 1) (- (* (+ (-> arg0 y) 1840) 16) (/ (+ v1-9 a2-3) 2)))
           (set! (-> this data 2) (+ (-> this data 0) a0-5))
           (set! (-> this data 3) (+ (-> this data 1) v1-9))
           (set! (-> this data 4) (+ (-> this data 0) a1-4))
           (set! (-> this data 5) (+ (-> this data 1) a2-3))
           (set! (-> this data 6) (+ (-> this data 0) a0-5 a1-4))
           (set! (-> this data 7) (+ (-> this data 1) v1-9 a2-3))
           )
          (else
            (set! (-> this data 0) (* (+ (-> arg0 x) 1792) 16))
            (set! (-> this data 1) (* (+ (-> arg0 y) 1840) 16))
            (set! (-> this data 2) (+ (-> this data 0) a0-5))
            (set! (-> this data 3) (+ (-> this data 1) v1-9))
            (set! (-> this data 4) (+ (-> this data 0) a1-4))
            (set! (-> this data 5) (+ (-> this data 1) a2-3))
            (set! (-> this data 6) (+ (-> this data 0) a0-5 a1-4))
            (set! (-> this data 7) (+ (-> this data 1) v1-9 a2-3))
            )
          )
        )
      )
    )
  0
  (none)
  )

;; og:preserve-this hud rung: hud-sprite-add held as-is: its own body
;; (hud_ir2.asm, L72) reads zero argument registers and unconditionally
;; returns #f, and no call site anywhere in this corpus was found (grepped
;; every _ir2.asm). Declared with zero args purely because the body proves
;; none are read; this is a guess by absence of evidence, not a derived
;; signature, landed verbatim from the clean decode regardless.
(defun hud-sprite-add ()
  #f
  )

;; og:preserve-this hud-4 rung: (method 9/10/11/12 hud-box) all land from
;; their clean decode once hud-h.gc's own :methods block retyped arg0 from
;; object to dma-buffer (same rung, same evidence class as
;; hud-sprite-method-9's own earlier retype: raw offset 4, dma-buffer's own
;; base field, resolves once arg0 is dma-buffer). type_casts.jsonc entries
;; carve the destination-side raw pointer writes into box-tmpl/box2-tmpl the
;; same way (method 24 hud) and hud-sprite-method-9 needed. (method 9) alone
;; has a fifth corner block (box-tmpl closes its own line-strip loop; the
;; other three templates do not). No landed caller reaches any of the four
;; in this corpus yet, but each is a clean, self-contained dma-buffer
;; writer with no further unfilled dispatch.
;; definition for method 9 of type hud-box
(defmethod hud-box-method-9 ((this hud-box) (arg0 dma-buffer))
  (dma-buffer-add-gs-set arg0
                         (test-1 (new 'static 'gs-test :ate #x1 :afail #x3 :zte #x1 :ztst (gs-ztest always)))
                         (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1))
                         )
  (let ((t1-0 *hud-sprite-work*)
        (v1-3 (-> arg0 base))
        (a2-8 (* (+ (the int (-> this box min x)) 1792) 16))
        (t0-0 (* (+ (the int (-> this box max x)) 1792) 16))
        (a3-13 (* (+ (the int (-> this box min y)) 1840) 16))
        )
    (let ((t2-2 (* (+ (the int (-> this box max y)) 1840) 16)))
      (set! (-> (the-as (pointer uint128) v1-3) 0) (-> t1-0 box-tmpl dma-vif quad))
      (set! (-> (the-as (pointer uint128) v1-3) 1) (-> t1-0 box-tmpl quad 1))
      (set! (-> (the-as (pointer uint128) v1-3) 2) (-> this color quad))
      (let ((a0-2 (the-as (pointer int32) (&+ v1-3 48))))
        (set! (-> a0-2 0) a2-8)
        (set! (-> a0-2 1) a3-13)
        (set! (-> a0-2 2) #xffffff)
        (set! (-> a0-2 3) 0)
        )
      (let ((a0-3 (the-as (pointer int32) (&+ v1-3 64))))
        (set! (-> a0-3 0) t0-0)
        (set! (-> a0-3 1) a3-13)
        (set! (-> a0-3 2) #xffffff)
        (set! (-> a0-3 3) 0)
        )
      (let ((a0-4 (the-as (pointer int32) (&+ v1-3 80))))
        (set! (-> a0-4 0) t0-0)
        (set! (-> a0-4 1) t2-2)
        (set! (-> a0-4 2) #xffffff)
        (set! (-> a0-4 3) 0)
        )
      (let ((a0-5 (the-as (pointer int32) (&+ v1-3 96))))
        (set! (-> a0-5 0) a2-8)
        (set! (-> a0-5 1) t2-2)
        (set! (-> a0-5 2) #xffffff)
        (set! (-> a0-5 3) 0)
        )
      )
    (let ((v1-4 (&-> (the-as (pointer int32) v1-3) 28)))
      (set! (-> v1-4 0) a2-8)
      (set! (-> v1-4 1) a3-13)
      (set! (-> v1-4 2) #xffffff)
      (set! (-> v1-4 3) 0)
      )
    )
  (&+! (-> arg0 base) 128)
  0
  (none)
  )

;; definition for method 10 of type hud-box
(defmethod hud-box-method-10 ((this hud-box) (arg0 dma-buffer))
  (dma-buffer-add-gs-set arg0
                         (test-1 (new 'static 'gs-test :ate #x1 :afail #x3 :zte #x1 :ztst (gs-ztest always)))
                         (alpha-1 (new 'static 'gs-alpha :a #x2 :d #x1))
                         )
  (let ((t0-0 *hud-sprite-work*)
