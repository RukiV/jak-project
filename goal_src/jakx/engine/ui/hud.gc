;;-*-Lisp-*-
(in-package goal)

;; name: hud.gc
;; name in dgo: hud
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

;; og:preserve-this hud rung: runtime-link visibility fix, matching the
;; kill-current-talker precedent (ambient-h.gc) and in-game-menu-hud.gc's own
;; copies of some of these. hud-method-25 below calls all six by name;
;; hud.gc (ENGINE) compiles well before any of their owning level files, so
;; the real compiler needs these externs even though decompiler/config/jakx/
;; all-types.gc already carries matching declarations for decode purposes.
;; in-game-menu-on?, grand-prix-totals-on? and high-scores-on? already have
;; landed bodies (in-game-menu-hud2.gc, hud-results-grand-prix.gc,
;; hud-high-scores.gc); current-finish-mode, end-game-menu-on? and
;; cash-stats-on? do not yet, so hud-method-25 guards those three calls with
;; (nonzero? ...) before calling them.
(define-extern current-finish-mode (function symbol))
(define-extern in-game-menu-on? (function object))
(define-extern end-game-menu-on? (function object))
(define-extern grand-prix-totals-on? (function object))
(define-extern cash-stats-on? (function object))
(define-extern high-scores-on? (function object))

;; definition of type hud-string-record
(deftype hud-string-record (structure)
  ((str   hud-string)
   (next  hud-string-record)
   )
  )

;; definition for method 3 of type hud-string-record
(defmethod inspect ((this hud-string-record))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'hud-string-record)
  (format #t "~1Tstr: #<hud-string @ #x~X>~%" (-> this str))
  (format #t "~1Tnext: #<hud-string-record @ #x~X>~%" (-> this next))
  (label cfg-4)
  this
  )

;; definition for symbol *hud-string-array*, type (pointer hud-string-record)
(define *hud-string-array* (the-as (pointer hud-string-record) (malloc 'global 768)))

;; definition for symbol *hud-string-used-list*, type (pointer (pointer hud-string-record))
(define *hud-string-used-list* (the-as (pointer (pointer hud-string-record)) (malloc 'global 8)))

;; definition for symbol *hud-string-free-list*, type hud-string-record
(define *hud-string-free-list* (the-as hud-string-record #f))

;; definition for symbol *font-hud-context*, type font-context
(define *font-hud-context* (new
                             'global
                             'font-context
                             *font-default-matrix*
                             0
                             0
                             8396850.0
                             (font-color default)
                             (font-flags shadow kerning)
                             )
        )

;; hud-string-add and hud-string-init both index *hud-string-used-list* as
;; [view][effect]; these two per-view sub-arrays back that second level.
(set! (-> *hud-string-used-list* 0) (the-as (pointer hud-string-record) (malloc 'global 12)))
(set! (-> *hud-string-used-list* 1) (the-as (pointer hud-string-record) (malloc 'global 12)))

;; og:preserve-this bring-up stubs: jakx-only HUD string pool, not needed headless.
(defun hud-string-init ()
  0
  )

;; definition for function hud-string-add
;; WARN: Return type mismatch object vs hud-string-record.
(defun hud-string-add ((arg0 hud-string))
  (let ((gp-0 (the-as object *hud-string-free-list*)))
    (the-as
      hud-string-record
      (cond
        ((the-as hud-string-record gp-0)
         (let ((s5-0 (cond
                       ((logtest? (-> arg0 flags) 512)
                        0
                        )
                       ((zero? (-> arg0 effect))
                        2
                        )
                       (else
                         1
                         )
                       )
                     )
               )
           (set! *hud-string-free-list* (-> (the-as hud-string-record gp-0) next))
           (set! (-> (the-as hud-string-record gp-0) str) arg0)
           (set! (-> (the-as hud-string-record gp-0) str text-length) (length (-> arg0 text)))
           (set! (-> (the-as hud-string-record gp-0) next) (-> *hud-string-used-list* (view-get-active-index) s5-0))
           (set! (-> *hud-string-used-list* (view-get-active-index) s5-0) (the-as hud-string-record gp-0))
           )
         gp-0
         )
        (else
          (format *stdebug* "Out of hud-string-records!!!!~%")
          )
        )
      )
    )
  )

;; og:preserve-this hud-4 rung: (method 9 hud-string) still held, but for a
;; narrower reason than before. Its raw decode (hud_ir2.asm) is now a clean
;; single expression-build failure at op 0, "add failed: object <integer
;; 28>": (+ arg0 28), where arg0 is declared object. Every sibling writer
;; this rung landed (hud-sprite-method-9, hud-corners-method-9, hud-box-
;; method-9/10/11/12) had a real caller supplying concrete argument types
;; (hud-sprite-method-9's own dma-buffer/level pair, or hud-corners-method-9's
;; vector4w/float/hud-sprite-flags/float/float call site inside this rung's
;; own hud-sprite-method-9 landing) to retype the declared arg from object to
;; something real; this method's only caller in this corpus is
;; hud-string-draw-all, itself held below with no landed body, so there is no
;; call site anywhere to read a real type from, and the field offsets it
;; writes (4, 12, 28..40, 140, 144, 168, 176, 180, 181, 182) do not match any
;; type already declared in this corpus. Guessing a shape here would be
;; exactly the "guess presented as a finding" AGENTS.md rules out. Retire
;; when hud-string-draw-all is landed for real and a genuine call site
;; appears.

(defun hud-string-draw-all ((arg0 dma-buffer))
  0
  )

;; definition of type hud-sprite-work
(deftype hud-sprite-work (structure)
  ((adgif-tmpl         dma-gif-packet :inline)
   (draw-tmpl          dma-gif-packet :inline)
   (draw-no-tex-tmpl   dma-gif-packet :inline)
   (sprite-tmpl        dma-gif-packet :inline)
   (sprite-no-tex-tmpl dma-gif-packet :inline)
   (box-tmpl           dma-gif-packet :inline)
   (box2-tmpl          dma-gif-packet :inline)
   (mask-tmpl          dma-gif-packet :inline)
   (line-tmpl          dma-gif-packet :inline)
   (scan-tmpl          dma-gif-packet :inline)
   (line-color         uint64) ;; gs-rgbaq
   (scan-colors        vector4w 32 :inline)
   (scanline           uint32)
   )
  )

;; definition for method 3 of type hud-sprite-work
(defmethod inspect ((this hud-sprite-work))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'hud-sprite-work)
  (format #t "~1Tadgif-tmpl: #<dma-gif-packet @ #x~X>~%" (-> this adgif-tmpl))
  (format #t "~1Tdraw-tmpl: #<dma-gif-packet @ #x~X>~%" (-> this draw-tmpl))
  (format #t "~1Tdraw-no-tex-tmpl: #<dma-gif-packet @ #x~X>~%" (-> this draw-no-tex-tmpl))
  (format #t "~1Tsprite-tmpl: #<dma-gif-packet @ #x~X>~%" (-> this sprite-tmpl))
  (format #t "~1Tsprite-no-tex-tmpl: #<dma-gif-packet @ #x~X>~%" (-> this sprite-no-tex-tmpl))
  (format #t "~1Tbox-tmpl: #<dma-gif-packet @ #x~X>~%" (-> this box-tmpl))
  (format #t "~1Tbox2-tmpl: #<dma-gif-packet @ #x~X>~%" (-> this box2-tmpl))
  (format #t "~1Tmask-tmpl: #<dma-gif-packet @ #x~X>~%" (-> this mask-tmpl))
  (format #t "~1Tline-tmpl: #<dma-gif-packet @ #x~X>~%" (-> this line-tmpl))
  (format #t "~1Tscan-tmpl: #<dma-gif-packet @ #x~X>~%" (-> this scan-tmpl))
  (format #t "~1Tline-color: ~D~%" (-> this line-color))
  (format #t "~1Tscan-colors[32] @ #x~X~%" (-> this scan-colors))
  (format #t "~1Tscanline: ~D~%" (-> this scanline))
  (label cfg-4)
  this
  )

