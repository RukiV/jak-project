;; og:preserve-this hud rung: (method 9 hud-corners) held. Its raw decode
;; (hud_ir2.asm) fails type prop on a raw byte read (l.w s5) and leaves t0/t1
;; unresolved; this rung did not carve the type_casts.jsonc entries needed.
;; No landed caller in this corpus reaches it. Retire alongside
;; (method 9 hud-sprite) below, which needs the same class of fix.

;; og:preserve-this hud rung: hud-sprite-add held as-is: its own body
;; (hud_ir2.asm, L72) reads zero argument registers and unconditionally
;; returns #f, and no call site anywhere in this corpus was found (grepped
;; every _ir2.asm). Declared with zero args purely because the body proves
;; none are read; this is a guess by absence of evidence, not a derived
;; signature, landed verbatim from the clean decode regardless.
(defun hud-sprite-add ()
  #f
  )

;; og:preserve-this hud rung: (method 10/11/12 hud-box) held, same
;; unresolved-offset-arithmetic class as (method 9 hud-corners) above; no
;; landed caller in this corpus reaches any of the four hud-box methods.

;; definition for method 7 of type hud
;; WARN: Return type mismatch process vs hud.
(defmethod relocate ((this hud) (offset int))
  (dotimes (v1-0 45)
    (when (-> this strings v1-0 text)
      (if (-> this strings v1-0 text)
          (&+! (-> this strings v1-0 text) offset)
          )
      )
    )
  (the-as hud ((method-of-type process relocate) this offset))
  )

;; og:preserve-this hud rung: (method 24 hud) held even though its own decode
;; is clean (hud_ir2.asm, seven type_casts.jsonc entries added this rung
;; resolved every raw dma-packet write in its own body). It dispatches
;; (hud-sprite-method-9 a0-2 s4-0 s2-0) on every sprite it draws, and
;; (method 9 hud-sprite)'s own decode still has roughly seventy raw
;; dma-packet/gif-tag writes across several hud-sprite-work templates
;; (box-tmpl, box2-tmpl, mask-tmpl, scan-tmpl) unresolved by this rung's
;; type_casts.jsonc work. Landing (method 24 hud) without (method 9
;; hud-sprite) filled would leave the base hud type's own vtable slot 24
;; jumping into a real dispatch onto an unfilled slot 9 of hud-sprite the
;; first time a nonzero-scale, textured sprite is drawn; several subtype
;; overrides of method 24 exist already (hud-classes, hud-high-scores,
;; hud-results-grand-prix, hud-widgets-2/3/powerhang, in-game-menu-hud/hud2,
;; net-hud) so this may never be reached in practice by a bare hud instance,
;; but that has not been proven, so this rung holds it. Retire once (method 9
;; hud-sprite) is landed.

;; definition for symbol *debug-hud-disable*, type symbol
(define *debug-hud-disable* #f)

;; definition for method 25 of type hud
;; ERROR: Function may read a register that is not set: a1
;; ERROR: Function may read a register that is not set: a2
;; ERROR: Function may read a register that is not set: a3
;; ERROR: Function may read a register that is not set: t0
;; og:preserve-this hud rung: runtime-link visibility fix, matching the
;; hud-high-scores.gc precedent (its own high-scores-on? guards the same two
;; symbols the same way). current-finish-mode, end-game-menu-on? and
;; cash-stats-on? are all called by name below but none has a landed body
;; anywhere in jakx goal_src yet (current-finish-mode is net-race/results
;; territory; end-game-menu-on? and cash-stats-on? both home to hud-cash.gc,
;; still an empty stub); every hud-method-17..23 slot this method's own
;; (and (hud-method-N this) ...) guards read is landed to unconditionally
;; return #t, so without this guard these three calls are reached on the
;; very next hud-in :trans tick after hud-init-by-other runs, jumping
;; through zero. Retires once hud-cash.gc and the finish-mode owner land
;; real bodies.
(defmethod hud-method-25 ((this hud))
  (local-vars (a1-0 none) (a2-0 none) (a3-0 none) (t0-0 none))
  (not (or (and (hud-method-17 this) (!= (-> *setting-control* user-current letterbox) 0.0))
           (and (hud-method-19 this) (in-game-menu-on?))
           (and (hud-method-22 this) (nonzero? current-finish-mode) (current-finish-mode))
           (and (hud-method-18
                  this
                  (the-as process a1-0)
                  (the-as int a2-0)
                  (the-as symbol a3-0)
                  (the-as event-message-block t0-0)
                  )
                (or *debug-hud-disable* (and (nonzero? end-game-menu-on?) (end-game-menu-on?)))
                )
           (and (hud-method-23 this) (grand-prix-totals-on?))
           (and (hud-method-20 this) (nonzero? cash-stats-on?) (cash-stats-on?))
           (and (hud-method-21 this) (high-scores-on?))
           )
       )
  )

;; definition for method 18 of type hud
;; WARN: Return type mismatch symbol vs object.
(defmethod hud-method-18 ((this hud) (arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  #t
  )

;; definition for method 17 of type hud
;; WARN: Return type mismatch symbol vs none.
(defmethod hud-method-17 ((this hud))
  #t
  (none)
  )

;; definition for method 19 of type hud
;; WARN: Return type mismatch symbol vs none.
(defmethod hud-method-19 ((this hud))
  #t
  (none)
  )

;; definition for method 21 of type hud
;; WARN: Return type mismatch symbol vs none.
(defmethod hud-method-21 ((this hud))
  #t
  (none)
  )

;; definition for method 20 of type hud
;; WARN: Return type mismatch symbol vs none.
(defmethod hud-method-20 ((this hud))
  #t
  (none)
  )

;; definition for method 22 of type hud
;; WARN: Return type mismatch symbol vs none.
(defmethod hud-method-22 ((this hud))
  #t
  (none)
  )

;; definition for method 23 of type hud
;; WARN: Return type mismatch symbol vs none.
(defmethod hud-method-23 ((this hud))
  #t
  (none)
  )

;; definition for method 26 of type hud
;; WARN: Return type mismatch int vs none.
(defmethod hud-method-26 ((this hud))
  0
  (none)
  )

;; definition for method 27 of type hud
;; WARN: Return type mismatch symbol vs none.
(defmethod hud-method-27 ((this hud) (arg0 object) (arg1 object) (arg2 object) (arg3 object))
  (none)
  )

;; og:preserve-this hud rung: hud-create-icon held. Its raw decode
;; (hud_ir2.asm) still fails type prop on (l.wu (+ a0 192)) against the
;; spawned manipy's ppointer-dereferenced process (op 33) and fails to guess
;; the static label use for L145 (its own manipy-init argument literal, op
;; 22). No caller anywhere in this corpus was found for hud-create-icon
;; (grepped every _ir2.asm), so it is dead code as far as this rung can tell;
;; held rather than spending further budget on unreached code. Its own
;; extern signature ((function hud int int (pointer manipy) :behavior hud))
;; is landed in decompiler/config/jakx/all-types.gc so any future caller
;; type-checks correctly.

;; definition for method 29 of type hud
;; WARN: Return type mismatch int vs none.
(defmethod hud-method-29 ((this hud) (arg0 int) (arg1 int))
  (when (not (-> this strings arg0 text))
    (set! (-> this strings arg0 text) (new 'process 'string arg1 (the-as string #f)))
    (set! (-> this strings arg0 width) 100.0)
    (set! (-> this strings arg0 height) 100.0)
    )
  0
  (none)
  )

;; og:preserve-this hud rung: hud-post held even though its own decode is
;; clean (hud_ir2.asm, no errors once hud-handler/hud-post/hud-create-icon
;; were given real signatures this rung). Its body unconditionally calls
;; (hud-method-24 self) outside the screenshot-in-progress guard, and
;; (method 24 hud) is itself held above pending (method 9 hud-sprite). Wiring
;; hud-post into the hud-in state's :post slot without (method 24 hud) filled
;; would be exactly the runtime-jump-to-an-unfilled-slot class this rung is
;; explicitly trying to avoid, so hud-in's :post field is left unset below
;; rather than wired to this function. Retire this hold in lockstep with
;; (method 24 hud) and (method 9 hud-sprite).

;; definition for function hud-handler
;; WARN: Return type mismatch int vs object.
(defbehavior hud-handler hud ((arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (-> *perf-stats* data 55)
  0
  (case arg2
    (('hide-and-die)
     (go empty-state)
     )
    (else
      (hud-method-27 self arg0 arg1 arg2 arg3)
      )
    )
  (-> *perf-stats* data 55)
  0
  )

(defstate hud-hidden (hud)
  :virtual #t
  :event hud-handler
  :trans (behavior ()
    (if (hud-method-25 self)
        (go-virtual hud-in)
        )
    )
  :code sleep-code
  )

;; og:preserve-this hud rung: :post omitted from this state on purpose. The
;; clean decode (hud_ir2.asm) wires (-> gp-1 post) to hud-post, but hud-post
;; is held above pending (method 24 hud) and (method 9 hud-sprite); every
;; other field below is landed verbatim from the decode. Retire together with
;; the hud-post hold above.
(defstate hud-in (hud)
  :virtual #t
  :event hud-handler
  :enter (behavior ()
    '()
    )
  :exit (behavior ()
    '()
    )
  :trans (behavior ()
    (if (not (hud-method-25 self))
        (go-virtual hud-hidden)
        )
    )
  :code sleep-code
  )

;; definition for function hud-init-by-other
(defbehavior hud-init-by-other hud ()
  (add-connection *hud-engine* self #f self (-> self type symbol) #f)
  (set! (-> self mask) (process-mask menu))
  (+! (-> self clock ref-count) -1)
  (+! (-> *display* real-clock ref-count) 1)
  (set! (-> self clock) (-> *display* real-clock))
  (set! (-> self flags) (hud-flags))
  (set! (-> self last-hide-time) (the-as uint (current-time)))
  (set! (-> self offset) 1.0)
  (dotimes (v1-16 45)
    (set! (-> self strings v1-16 text) #f)
    (set! (-> self strings v1-16 scale) 0.0)
    (set! (-> self strings v1-16 color) (font-color white))
    (set! (-> self strings v1-16 alpha) 1.0)
    (set! (-> self strings v1-16 flags) (the-as uint 35))
    (set! (-> self strings v1-16 pos x) 0)
    (set! (-> self strings v1-16 pos z) #xfffffff)
    (set! (-> self strings v1-16 pos w) 0)
    (set! (-> self strings v1-16 time) 0.0)
    (set! (-> self strings v1-16 effect) (the-as uint 0))
    )
  (dotimes (v1-19 50)
    (let ((a0-23 (&+ (the-as (pointer int32) (-> self sprites 0 color)) (* v1-19 64))))
      (set! (-> a0-23 0) 128)
      (set! (-> a0-23 1) 128)
      (set! (-> a0-23 2) 128)
      (set! (-> a0-23 3) 128)
      )
    (set! (-> self sprites v1-19 pos z) #xffffff)
    (set! (-> self sprites v1-19 pos w) 0)
    (set! (-> self sprites v1-19 scale-x) 0.0)
    (set! (-> self sprites v1-19 scale-y) 0.0)
    (set! (-> self sprites v1-19 angle) 0.0)
    (set! (-> self sprites v1-19 flags) (hud-sprite-flags))
    (set! (-> self sprites v1-19 tex) #f)
    )
  (dotimes (v1-22 2)
    (set! (-> self icons v1-22 icon) (the-as (pointer manipy) #f))
    (set! (-> self icons v1-22 pos z) 1024)
    (set! (-> self icons v1-22 scale-x) 1.0)
    (set! (-> self icons v1-22 scale-y) 1.0)
    )
  (hud-method-26 self)
  (set! (-> self event-hook) (-> (method-of-type hud hud-in) event))
  (go-virtual hud-in)
  )

;; definition for function set-hud-piece-position!
;; WARN: Return type mismatch int vs none.
(defun set-hud-piece-position! ((arg0 hud-sprite) (arg1 int) (arg2 int))
  (set! (-> arg0 pos x) arg1)
  (set! (-> arg0 pos y) arg2)
  0
  (none)
  )

;; definition for function set-as-offset-from!
;; WARN: Return type mismatch int vs none.
(defun set-as-offset-from! ((arg0 hud-sprite) (arg1 vector4w) (arg2 int) (arg3 int))
  (set! (-> arg0 pos x) (+ (-> arg1 x) (the int (* (the float arg2) (-> *video-params* relative-x-scale)))))
  (set! (-> arg0 pos y) (+ (-> arg1 y) arg3))
  0
  (none)
  )
