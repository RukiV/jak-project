;; definition for method 2 of type connection-minimap
(defmethod print ((this connection-minimap))
  (format
    #t
    "#<connection-minimap ~16S #x~4X ~A @ #x~X>"
    (-> this class name)
    (-> this flags)
    (handle->process (-> this handle))
    this
    )
  this
  )

