          (set! (-> (the-as connection-minimap v0-0) edge-ry) -131072)
          )
        (set! (-> v0-0 update-time) (the-as time-frame (process->handle arg0)))
        (set! arg3 (cond
                     (arg3
                       (empty)
                       arg3
                       )
                     (else
                       (-> v1-7 default-position)
                       )
                     )
              )
        (set! (-> v0-0 param 0) arg3)
        (set! (-> v0-0 param 2) 5)
        (set! (-> (the-as connection-minimap v0-0) node) (the-as uint arg4))
