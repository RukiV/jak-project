    (while s4-0
      (let ((a3-0 s4-0))
        (format #t "~2T~3D: ~`connection-minimap`P~%" s5-0 a3-0)
        )
      (+! s5-0 1)
      (set! s4-0 (-> s4-0 next))
      )
    )
  this
