;;-*-Lisp-*-
(in-package goal)

;; name: hud-h.gc
;; name in dgo: hud-h
;; dgos: ENGINE, GAME

;; +++hud-sprite-flags
(defenum hud-sprite-flags
  :type uint16
  :bitfield #t
  (hsf0 0)
  (hsf1 1)
  (hsf2 2)
  (hsf3 3)
  (hsf4 4)
  (hsf5 5)
  (hsf6 6)
  (hsf7 7)
  (hsf8 8)
  (hsf9 9)
  (hsf10 10)
  (hsf11 11)
  (hsf12 12)
  (hsf13 13)
  (hsf14 14)
  (hsf15 15)
  )
;; ---hud-sprite-flags

;; +++hud-flags
(defenum hud-flags
  :type uint32
  :bitfield #t
  (disable 0)
  (should-die 1)
  (show 2)
  )
;; ---hud-flags

;; DECOMP BEGINS

;; definition of type hud-string
(deftype hud-string (structure)
  ((text          string)
   (scale         float)
   (width         float)
   (height        float)
   (color         font-color)
   (flags         uint16)
   (pos           vector4w  :inline)
   (alpha         float)
   (time          float)
   (effect        uint8)
   (effect-color  uint8)
   (text-length   int32)
   )
  (:methods
    (hud-string-method-9 (_type_ object) none)
    )
  )

;; definition for method 3 of type hud-string
(defmethod inspect ((this hud-string))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'hud-string)
  (format #t "~1Ttext: ~A~%" (-> this text))
  (format #t "~1Tscale: ~f~%" (-> this scale))
  (format #t "~1Twidth: ~f~%" (-> this width))
  (format #t "~1Theight: ~f~%" (-> this height))
  (format #t "~1Tcolor: ~D~%" (-> this color))
  (format #t "~1Tflags: ~D~%" (-> this flags))
  (format #t "~1Tpos: #<vector4w @ #x~X>~%" (-> this pos))
  (format #t "~1Talpha: ~f~%" (-> this alpha))
  (format #t "~1Ttime: ~f~%" (-> this time))
  (format #t "~1Teffect: ~D~%" (-> this effect))
  (format #t "~1Teffect-color: ~D~%" (-> this effect-color))
  (format #t "~1Ttext-length: ~D~%" (-> this text-length))
  (label cfg-4)
  this
  )

;; definition of type hud-corners
;; og:preserve-this hud-4 rung: data retyped uint64 4 -> int32 8 (same 32-byte
;; size). Every access anywhere in this corpus, inside (method 9 hud-corners)
;; itself and at (method 9 hud-sprite)'s own external reads, is a 32-bit
;; sw/lw of one half of a uint64 element; no sd/ld (genuine 64-bit) access to
;; this field exists anywhere landed. Casting the raw offset pointers
;; per-access (the type_casts.jsonc route used elsewhere in this rung) does
;; not work here because self (gp) is never reassigned across the whole
;; function, so a per-op cast on it retypes every other use of gp for its
;; entire lifetime, regressing the earlier a2/a1 alias stores; retyping the
;; field itself is the only fix that does not do that.
(deftype hud-corners (structure)
  ((data  int32  8)
   )
  (:methods
    ;; og:preserve-this hud-4 rung: gains its real 5-arg shape. hud-sprite's
    ;; own call site (hud.gc, (method 9 hud-sprite)) passes this.pos
    ;; (vector4w), this.angle (float) and this.flags (hud-sprite-flags) as
    ;; arg0..arg2, then computes two more floats (the texture's scaled width
    ;; and height) right before the call and leaves them as dangling
    ;; expressions in the raw decode; this method's own body reads those same
    ;; two values back out of t0/t1 (mtc1 from a fifth and sixth argument
    ;; register, the GOAL convention for extra float args past a3), and its
    ;; raw offset-0/offset-4 reads of arg0 only resolve once arg0 is
    ;; vector4w, matching the call site.
    (hud-corners-method-9 (_type_ vector4w float hud-sprite-flags float float) none)
    )
  )

;; definition for method 3 of type hud-corners
(defmethod inspect ((this hud-corners))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'hud-corners)
  (format #t "~1Tdata[4] @ #x~X~%" (-> this data))
  (label cfg-4)
  this
  )

;; definition of type hud-sprite
(deftype hud-sprite (structure)
  ((pos       vector4w    :inline)
   (offset-x  float       :overlay-at (-> pos data 0))
   (offset-y  float       :overlay-at (-> pos data 1))
   (color     vector4w    :inline)
   (flags     hud-sprite-flags)
   (scale-x   float)
   (width     float       :overlay-at scale-x)
   (scale-y   float)
   (height    float       :overlay-at scale-y)
   (angle     float)
   (tex       texture)
   (tid       texture-id  :overlay-at tex)
   )
  (:methods
    ;; og:preserve-this hud rung: retyped object object -> dma-buffer level.
    ;; (method 24 hud) calls this slot with a1=dma-buffer (its own s4, reused
    ;; from the dma-buffer used for its own packet writes) and a2=level (its
    ;; own s2, (-> this level)); the method's own body then reads arg0
    ;; (l.wu (+ arg0 4)), dma-buffer's own base field at machine offset 4,
    ;; confirming arg0 is dma-buffer. Matches the sibling hud-sprite-method-10
    ;; slot's own trailing comment shape (dma-buffer level ...).
    (hud-sprite-method-9 (_type_ dma-buffer level) none)
    (hud-sprite-method-10 () none)
    )
  )

;; definition for method 3 of type hud-sprite
(defmethod inspect ((this hud-sprite))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'hud-sprite)
  (format #t "~1Tpos: #<vector4w @ #x~X>~%" (-> this pos))
  (format #t "~1Toffset-x: ~f~%" (-> this offset-x))
  (format #t "~1Toffset-y: ~f~%" (-> this offset-y))
  (format #t "~1Tcolor: #<vector4w @ #x~X>~%" (-> this color))
  (format #t "~1Tflags: ~D~%" (-> this flags))
  (format #t "~1Tscale-x: ~f~%" (-> this scale-x))
  (format #t "~1Twidth: ~f~%" (-> this scale-x))
  (format #t "~1Tscale-y: ~f~%" (-> this scale-y))
  (format #t "~1Theight: ~f~%" (-> this scale-y))
  (format #t "~1Tangle: ~f~%" (-> this angle))
  (format #t "~1Ttex: ~A~%" (-> this tex))
  (format #t "~1Ttid: ~D~%" (-> this tex))
  (label cfg-4)
  this
  )

;; definition of type hud-box
(deftype hud-box (structure)
  ((box    bounding-box2  :inline)
   (min    vector2        :inline :overlay-at (-> box min))
   (max    vector2        :inline :overlay-at (-> box max))
   (color  vector4w       :inline)
   )
  (:methods
    ;; og:preserve-this hud-4 rung: retyped object -> dma-buffer, same
    ;; evidence class as hud-sprite-method-9's own earlier retype. Each raw
    ;; decode opens with (l.wu (+ arg0 4)), the same machine offset (declared
    ;; offset 8, dma-buffer's own base field) hud-sprite-method-9 reads
    ;; through its own dma-buffer arg, and every method's own body is the
    ;; same dma-tag/gif-tag/register-write packet shape already landed for
    ;; (method 24 hud) and hud-sprite-method-9. jak3's own trailing config
    ;; comment names these draw-box-prim-only/draw-box-alpha-1/2/3, all
    ;; taking a dma-buffer, corroborating without being the sole evidence.
    (hud-box-method-9 (_type_ dma-buffer) none)
    (hud-box-method-10 (_type_ dma-buffer) none)
    (hud-box-method-11 (_type_ dma-buffer) none)
    (hud-box-method-12 (_type_ dma-buffer) none)
    )
  )

;; definition for method 3 of type hud-box
(defmethod inspect ((this hud-box))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'hud-box)
  (format #t "~1Tbox: #<bounding-box2 @ #x~X>~%" (-> this box))
  (format #t "~1Tmin: #<vector2 @ #x~X>~%" (-> this box))
  (format #t "~1Tmax: #<vector2 @ #x~X>~%" (-> this box max))
  (format #t "~1Tcolor: #<vector4w @ #x~X>~%" (-> this color))
  (label cfg-4)
  this
  )

;; definition of type hud-icon
(deftype hud-icon (structure)
  ((icon     (pointer manipy))
   (pos      vector4w  :inline)
   (scale-x  float)
   (scale-y  float)
   )
  )

;; definition for method 3 of type hud-icon
(defmethod inspect ((this hud-icon))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'hud-icon)
  (format #t "~1Ticon: #x~X~%" (-> this icon))
  (format #t "~1Tpos: #<vector4w @ #x~X>~%" (-> this pos))
  (format #t "~1Tscale-x: ~f~%" (-> this scale-x))
  (format #t "~1Tscale-y: ~f~%" (-> this scale-y))
  (label cfg-4)
  this
  )

;; definition of type hud
(deftype hud (process)
  ((trigger-time    uint64)
   (last-hide-time  uint64)
   (offset          float)
   (flags           hud-flags)
   (strings         hud-string  45 :inline)
   (sprites         hud-sprite  50 :inline)
   (icons           hud-icon    2 :inline)
   (num-strings     int32)
   (num-sprites     int32)
   (gui-id          sound-id)
   )
  (:state-methods
    hud-hidden
    hud-in
    )
  (:methods
    ;; og:preserve-this hud-high-scores rung: gains _type_, synced from this
    ;; method's own trailing config comment in decompiler/config/jakx/
    ;; all-types.gc, same defect class as hud-method-22/23 below (a bare ()
    ;; decoded every high-scores-list/hud-background-family override as a
    ;; self-less (defmethod NAME () ...) GOALC's defmethod macro rejects,
    ;; blocking (method 21 high-scores-list)'s compile in
    ;; hud-high-scores.gc). jak3's own hud type (goal_src/jak3/engine/ui/
    ;; hud-h.gc) names this slot init-callback with the identical (_type_)
    ;; arg list at the same unshifted method index, corroborating the arg
    ;; count without adopting the jak3 name.
    (hud-method-17 (_type_) none)
    ;; og:preserve-this hud-high-scores rung: gains its args and object
    ;; return, synced from this method's own trailing config comment, same
    ;; defect class as hud-method-17 above. jak3's hud type names this slot
    ;; event-callback with the identical (_type_ process int symbol
    ;; event-message-block) arg list and object return at the same unshifted
    ;; method index.
    (hud-method-18 (_type_ process int symbol event-message-block) object)
    ;; og:preserve-this hud-high-scores rung: gains _type_, same reason and
    ;; evidence class as hud-method-17 above; hud-method-19/20/21 share the
    ;; same self-referential trailing comment shape and the same jak3
    ;; unshifted-index corroboration.
    (hud-method-19 (_type_) none)
    (hud-method-20 (_type_) none)
    (hud-method-21 (_type_) none)
    ;; og:preserve-this hud-static-literals rung: gains _type_, synced from
    ;; this method's own trailing config comment in decompiler/config/jakx/
    ;; all-types.gc. hud-results-grand-prix and its two siblings
    ;; (hud-results-grand-prix.gc) override this slot with a bare-() body
    ;; that never reads self; the bare () declaration made the decompiler
    ;; pretty-print a self-less (defmethod NAME () ...) form GOALC's real
    ;; defmethod macro rejects.
    (hud-method-22 (_type_) none)
    ;; og:preserve-this hud-static-literals rung: gains _type_, same reason
    ;; and evidence class as hud-method-22 above (hud-results-grand-prix-
    ;; totals's own override, hud-results-grand-prix.gc).
    (hud-method-23 (_type_) none)
    (hud-method-24 (_type_) none)
    ;; og:preserve-this hud rung: retyped none -> symbol. hud.gc's own
    ;; :trans handlers for both hud-hidden and hud-in use this method's
    ;; result directly as an (if ...) condition (hud_ir2.asm), and its own
    ;; body computes (not (or ...)), a genuine boolean, not none; a fresh
    ;; compile of the landed :trans handlers rejects "Cannot use none-typed
    ;; variable in a condition" against the old declaration.
    (hud-method-25 (_type_) symbol)
    ;; og:preserve-this net-hud rung: in-game-hud-method-26 (net-hud.gc) overrides
    ;; this slot reading only self (gp) to touch its own instance fields; the old
    ;; () signature left self untyped and the override's chain of field accesses
    ;; failed type prop. Scoped decode, net-hud_ir2.asm, this rung.
    (hud-method-26 (_type_) none)
    ;; og:preserve-this net-hud rung: in-game-hud-method-27 (net-hud.gc) overrides
    ;; this slot receiving self plus 4 extra args (s1/s5/s4/s3/s2 = a0..t0 on
    ;; entry), broadcasting them unchanged to each real-items element's own
    ;; method-23 and to its items field's method-11; basic-manager-method-9 also
    ;; calls this slot on *current-hud* with 3 concrete args (0, 'enter, #f). Scoped
    ;; decode, net-hud_ir2.asm, this rung.
    (hud-method-27 (_type_ object object object object) none)
    (hud-method-28 () none)
    ;; og:preserve-this hud rung: retyped object object -> int int. hud.gc's
    ;; own body (hud_ir2.asm, L22) uses arg0 directly as a strings-array index
    ;; (`(sll arg0 6)`, matching hud-string's own 64-byte stride), and
    ;; hud-item-string-method-28's call site (net-hud.gc) passes
    ;; (-> *current-hud* num-strings) (an int32 field) and the literal 128 for
    ;; the two args, confirming both are int, not the previously landed
    ;; provisional object object.
    (hud-method-29 (_type_ int int) none)
    )
  )

;; definition for method 3 of type hud
(defmethod inspect ((this hud))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type process inspect)))
    (t9-0 this)
    )
  (format #t "~2Ttrigger-time: ~D~%" (-> this trigger-time))
  (format #t "~2Tlast-hide-time: ~D~%" (-> this last-hide-time))
  (format #t "~2Toffset: ~f~%" (-> this offset))
  (format #t "~2Tflags: ~D~%" (-> this flags))
  (format #t "~2Tstrings[45] @ #x~X~%" (-> this strings))
  (format #t "~2Tsprites[50] @ #x~X~%" (-> this sprites))
  (format #t "~2Ticons[2] @ #x~X~%" (-> this icons))
  (format #t "~2Tnum-strings: ~D~%" (-> this num-strings))
  (format #t "~2Tnum-sprites: ~D~%" (-> this num-sprites))
  (format #t "~2Tgui-id: ~D~%" (-> this gui-id))
  (label cfg-4)
  this
  )

;; definition of type hud-map
(deftype hud-map (hud)
  ((x  float)
   (y  float)
   )
  )

;; definition for method 3 of type hud-map
(defmethod inspect ((this hud-map))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type hud inspect)))
    (t9-0 this)
    )
  (format #t "~2Tx: ~f~%" (-> this x))
  (format #t "~2Ty: ~f~%" (-> this y))
  (label cfg-4)
  this
  )

