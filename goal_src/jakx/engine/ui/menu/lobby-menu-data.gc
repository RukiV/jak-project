;;-*-Lisp-*-
(in-package goal)

;; name: lobby-menu-data.gc
;; name in dgo: lobby-menu-data
;; dgos: MENU2

;; DECOMP BEGINS

;; lobby rung 3: net-driver has no landed home anywhere in the corpus yet
;; but *net-drivers* (below) needs it as a real type to compile; forward-
;; declared verbatim from decompiler/config/jakx/all-types.gc's own
;; net-driver deftype, the same cross-file forward-declare idiom rung 2's
;; own landing used for net-player-ladder-stats-info/medius-cached-info-
;; player.
(deftype net-driver (structure)
  ((id            uint32  :offset-assert 0)
   (levname       basic   :offset-assert 4)
   (dt            uint8   :offset-assert 8)
   (tex-name      basic   :offset-assert 12)
   (picture-part1 uint32  :offset-assert 16)
   (picture-part2 uint32  :offset-assert 20)
   (icon-part1    uint32  :offset-assert 24)
   (icon-part2    uint32  :offset-assert 28)
   (base-color    uint32  :offset-assert 32)
   (stripe-color  uint32  :offset-assert 36)
   (ai-car-levels basic   :offset-assert 40)
   (driver-name   basic   :offset-assert 44)
   (sex           int8    :offset-assert 48)
   (height        int8    :offset-assert 49)
   (weight        int16   :offset-assert 50)
   (eyes          basic   :offset-assert 52)
   (age           int8    :offset-assert 56)
   (helmet-scale  float   :offset-assert 60)
   (no-ai         basic   :offset-assert 64)
   )
  :method-count-assert 9
  :size-assert         #x44
  :flag-assert         #x900000044
  )

;; lobby rung 3: *net-drivers* is read-only referenced by this file's own
;; get-net-driver-idx-by-type/get-net-driver-by-type but its own real
;; static data lands elsewhere in the corpus (still unlanded); forward-
;; declared here with the type already resolved for this rung's own
;; decode (decompiler/config/jakx/all-types.gc), the same cross-file
;; forward-declare idiom lobby-menu-manager.gc's own rung 2 landing used.
(define-extern *net-drivers* (array net-driver))

;; definition for symbol *background-menu-info*, type base-menu-info
;; lobby rung a1 (issue 759): transcribed by hand from the same scoped
;; decode as *base-menu-info* above (see that citation for the label-hint
;; experiment result and the all-types.gc offset cross-check method). This
;; tree is one level deep only: a single plain 'base-menu child (L1545),
;; no name-symbol, :children #f. Its own :trans-info field is declared
;; plain animation-info (not transition-info) by base-menu-info's deftype,
;; so only the animation-info-shaped prefix of the raw word dump is
;; printed here, matching this file's own established precedent for the
;; same field/type pairing (*logo-menu-info*/*logo-subtitle-menu-info*
;; above print their animation-info trans-info the same truncated way even
;; though more raw bytes follow at those labels).
(define *background-menu-info* (new 'static 'base-menu-info
                                 :menu-type 'base-menu
                                 :children (new 'static 'boxed-array :type base-menu-info
                                   (new 'static 'base-menu-info
                                     :menu-type 'base-menu
                                     :children #f
                                     :name-symbol #f
                                     :3d-menu-type "skel-side-walls"
                                     :trans-info (new 'static 'animation-info
                                       :enter-anim 3
                                       :exit-anim -1
                                       :running-anim -1
                                       :anim-speed 5.0
                                       :enter-delay 0
                                       :3d-offset (new 'static 'vector :data (new 'static 'array float 4 0.0 0.0 -4096.0 1.0))
                                       )
                                     :joint-index -1
                                     :joint-index-2 -1
                                     :box-index -1
                                     :joints (new 'static 'boxed-array :type int8 0)
                                     :width -1
                                     :height -1
                                     :scale-y 0.94
                                     :scale-x 0.94
                                     )
                                   )
                                 :name-symbol #f
                                 :3d-menu-type #f
                                 :trans-info #f
                                 :joint-index -1
                                 :joint-index-2 -1
                                 :box-index -1
                                 :joints #f
                                 :width -1
                                 :height -1
                                 :scale-y 1.0
                                 :scale-x 1.0
                                 )
        )

