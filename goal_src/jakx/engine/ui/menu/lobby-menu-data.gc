;; definition for symbol *base-menu-info*, type object
(define *base-menu-info* (the-as object #f))

;; definition for symbol *base-menu-info*, type object
;; lobby rung a1 (issue 759): the shipped children tree, transcribed by hand
;; from a scratch scoped decode of lobby-menu-data (allowed_objects
;; ["lobby-menu-data"]) since label_types.jsonc hints do not reach nested
;; boxed-array elements (proven this rung: hinting L1506 as base-menu-info
;; left the printed :children placeholder unchanged). Field-to-word mapping
;; is cross-checked against decompiler/config/jakx/all-types.gc's own
;; offset-assert layouts for base-menu-info/sprite-menu-info/string-menu-
;; info/dropdown-item-info/animation-info/transition-info/dropdown-trans-
;; info (all already landed with offsets there), not guessed from alignment
;; alone. *base-menu-info* -> children[0] = L1506, a base-menu-info naming
;; :menu-type 'selection-menu-manager (a real deftype, menu2-h.gc) and
;; :name-symbol 'manager, whose own :children[0..5] = L1531/L1527/L1523/
;; L1519/L1515/L1511, six dropdown-item-info entries naming :menu-type
;; 'dropdown-item (a real deftype, menu2-h.gc) with :selection-type
;; 'adventure/'single-event/'customize/'profile/'options/'secrets in that
;; array order, matching the mission's six-entry tree exactly. Per-item
;; :3d-offset.y forms an exact 4096-unit arithmetic stack (2048.0,
;; -2048.0, -6144.0, -10240.0, -14336.0, -18432.0) confirming the field
;; mapping. :strings-info's string-info :id differs per item (1578/1888/
;; 1527/3013/49/4918, the string-menu-info sub-array's own text/localization
;; id) and is the only field carrying real per-item content beyond the
;; label/position; the remaining leaf fields are byte-identical across all
;; six and printed verbatim from the raw word dump. All fields are printed
;; explicitly (none omitted for being zero-valued) since no existing landed
;; instance of these particular sub-types establishes this file's omission
;; convention for them.
(define *base-menu-info*
  (the-as object (new 'static 'base-menu-info
                   :menu-type 'base-menu
                   :children (new 'static 'boxed-array :type base-menu-info
                     (new 'static 'base-menu-info
