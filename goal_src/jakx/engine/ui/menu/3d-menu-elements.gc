;; definition for symbol *garage-cinema*, type garage-cinema
(define *garage-cinema* (the-as garage-cinema #f))

;; definition for method 10 of type garage-cinema
(defmethod deactivate ((this garage-cinema))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (set! *garage-cinema* #f)
  (call-parent-method this)
  (none)
  )

;; definition for method 7 of type garage-cinema
(defmethod relocate ((this garage-cinema) (offset int))
  (set! *garage-cinema* this)
  (if *garage-cinema*
      (set! *garage-cinema* (&+ *garage-cinema* offset))
      )
  (call-parent-method this offset)
  )

