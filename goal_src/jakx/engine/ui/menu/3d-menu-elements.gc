;; definition of type interface-cam
(deftype interface-cam (process-drawable)
  ()
  (:state-methods
    idle
    enter
    exit
    )
  (:methods
    (interface-cam-method-53 (_type_) none)
    (interface-cam-method-54 (_type_) none)
    )
  )

;; definition for method 3 of type interface-cam
(defmethod inspect ((this interface-cam))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type process-drawable inspect)))
    (t9-0 this)
    )
  (label cfg-4)
  this
  )

;; definition for symbol *interface-cam*, type object
(define *interface-cam* (the-as object #f))

;; failed to figure out what this is:
(defskelgroup skel-interface-cam interface-cam interface-cam-lod0-jg interface-cam-idle-ja
              ((interface-cam-lod0-mg (meters 999999)))
              :bounds (static-spherem 0 0 0 4000)
              )

;; failed to figure out what this is:
(defstate enter (interface-cam)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('die)
       (go-virtual exit)
       )
      )
    )
  :enter (behavior ()
    (format #t "3d-object entered enter state~%")
    )
  :trans (behavior ()
    (interface-cam-method-53 self)
    )
  :code (behavior ()
    (go-virtual idle)
    )
  :post ja-post
  )

;; failed to figure out what this is:
(defstate idle (interface-cam)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('die)
       (go-virtual exit)
       )
      )
    )
  :trans (behavior ()
    (interface-cam-method-53 self)
    )
  :code (behavior ()
    (until #f
      (suspend)
      )
    #f
    )
  :post ja-post
  )

;; failed to figure out what this is:
(defstate exit (interface-cam)
  :virtual #t
  :enter (behavior ()
    (format #t "3d-object dying~%")
    )
  :trans (behavior ()
    (interface-cam-method-53 self)
    )
  :code (behavior ()
    '()
    )
  :post ja-post
  )

;; definition for method 53 of type interface-cam
;; INFO: Used lq/sq
;; WARN: Return type mismatch int vs none.
(defmethod interface-cam-method-53 ((this interface-cam))
  (let ((a0-2 (entity-by-name "hanginglamp-part-9")))
    (when a0-2
      (let ((v1-2 (-> a0-2 trans quad)))
        (set! (-> this root trans quad) v1-2)
        )
      )
    )
  0
  (none)
  )

;; definition for method 54 of type interface-cam
;; WARN: Return type mismatch int vs none.
(defmethod interface-cam-method-54 ((this interface-cam))
  (initialize-skeleton
    this
    (the-as skeleton-group (art-group-get-by-name *level* "skel-interface-cam" (the-as (pointer level) #f)))
    (the-as pair 0)
    )
  (set! *interface-cam* this)
  0
  (none)
  )

;; menu-camera rung: interface-cam-init-by-other's own "a1 uninitialized"
;; wall (the jakx-menu-pair band's hold, same suspected class as palm-
;; tree's methods elsewhere in this corpus) does not survive a fresh scoped
;; decode against activate-bar's own real call site. activate-bar (below)
;; is the only caller anywhere in this corpus, and its op 21 explicitly
;; zeroes the register that becomes this function's own a1 ((set! a3-2 #f),
;; forwarded through run-function-in-process's pass-through) - a real #f,
;; not garbage. arg0 is a vector, not the entity the original provisional
;; type guessed: op 0 saves it into gp untouched until op 19's own
;; quadword load (l.q gp), copied straight into (-> self root trans quad)
;; at op 20 (the one op the decompiler's own let-insertion still can't
;; fold on its own - a bare register-to-register lq with no field context;
;; every other op below sugars clean once the type is fixed, confirmed
;; against this rung's own scoped decode of the retyped signature).
;; Retyped in decompiler/config/jakx/all-types.gc to (function vector
;; entity object :behavior interface-cam) and dropped from hacks.jsonc's
;; own no_type_analysis_functions_by_name; garage-cinema-init-by-other
;; keeps its own separate hold (no caller anywhere in this corpus yet, so
;; its single-arg entity shape stays unverified by this rung's evidence).
;;
;; definition for function interface-cam-init-by-other
;; WARN: Return type mismatch none vs object.
(defbehavior interface-cam-init-by-other interface-cam ((arg0 vector) (arg1 entity))
  (process-entity-set! self arg1)
  (set! (-> self level) (level-get *level* 'menu2))
  (set! (-> self root) (new 'process 'trsqv))
  (set! (-> self root trans quad) (-> arg0 quad))
  (interface-cam-method-54 self)
  (go-virtual enter)
  )

;; menu-camera rung: activate-bar decodes clean off the same scoped decode
;; but for one op: [0]'s own (lui/ori/daddu v1, L216, fp) computes the
;; address of a static vector constant (x=0.0 y=0.0 z=40960.0 w=1.0,
;; 3d-menu-elements_ir2.asm) into v1, then v1 is overwritten by op 3
;; without ever being read anywhere - the only reference to L216 in this
;; whole object. Dropped as provably dead: no store anywhere touches the
;; stack memory backing gp-0 through either path, so this omission cannot
;; change what gp-0 holds. interface-cam-method-53 is a no-op on the
;; menu2 path: entity-by-name scans only levels whose status is 'active,
;; and hanginglamp-part-9 lives in rustyh (9 occurrences in raw_obj/
;; rustyh.go, zero anywhere in menu2), which is not resident here.
;; Retail's own activate-bar body has no store to the stack vector at all
;; (25 instructions, only the four prologue saves), so retail also leaves
;; the interface-cam model at stack garbage on the menu2 road where
;; hanginglamp-part-9 is absent; this affects only the drawn
;; skel-interface-cam model, never the camera, because update-lobby-camera
;; discards the node-list bones it computes from *interface-cam* and takes
;; the pose from the cam-string entity (issue 724).
;;
;; definition for function activate-bar
;; WARN: Return type mismatch (pointer process) vs object.
(defun activate-bar ()
  (let ((gp-0 (new 'stack-no-clear 'vector))
        (s5-0 (get-process *default-dead-pool* interface-cam #x4000 1))
        )
    (when s5-0
      (let ((t9-1 (method-of-type interface-cam activate)))
        (t9-1 (the-as interface-cam s5-0) *entity-pool* "interface-cam" (the-as pointer #x70004000))
        )
      ;; og:preserve-this restore the entity argument the decompiler elided:
      ;; run-function-in-process forwards this call's fourth value verbatim
      ;; into interface-cam-init-by-other's arg1 through the catch-frame
      ;; param block, and retail's own (set! a3-2 #f) before the call is
      ;; dropped as dead by the decompiler's model, so the raw decode's
      ;; 3-arg cast leaves arg1 as whatever activate -> change-parent last
      ;; left in that register (measured live: the process itself, which
      ;; process-entity-set! stores and setup-lods!'s res-lump-float then
      ;; walks as a res-lump, faulting in lookup-tag-idx's tag load at
      ;; res+0x435). With entity #f every downstream res lookup takes
      ;; lookup-tag-idx's (not this) early return and yields its declared
      ;; default, the retail branch. Same explicit-trailing-entity shape as
      ;; cam-master.gc's cam-slave spawns. No retirement: this is the
      ;; retail call shape.
      (let ((t9-2 run-function-in-process)
            (a0-2 s5-0)
            (a1-2 interface-cam-init-by-other)
            (a3-2 (the-as entity #f))
            )
        ((the-as (function object object object object none) t9-2) a0-2 a1-2 gp-0 a3-2)
        )
      (-> s5-0 ppointer)
      )
    )
  )

;; definition for method 10 of type interface-cam
(defmethod deactivate ((this interface-cam))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (set! *interface-cam* (the-as object #f))
  (call-parent-method this)
  (none)
  )

;; definition for method 7 of type interface-cam
(defmethod relocate ((this interface-cam) (offset int))
  (set! *interface-cam* this)
  (if *interface-cam*
      (set! *interface-cam* (+ (the-as uint *interface-cam*) offset))
      )
  (call-parent-method this offset)
  )

