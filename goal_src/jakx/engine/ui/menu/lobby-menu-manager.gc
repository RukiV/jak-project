;; definition for function lmm-make-background-menu
;; og:preserve-this the unset-t0 read this banner used to flag is resolved
;; below; lmm-make-logo-menu's first spawn explains it in full (issue 744).
(defun lmm-make-background-menu ((arg0 lobby-menu-manager))
  (when (not (handle->process (-> arg0 menu-handle-background)))
    (let* ((s5-0 (get-process *default-dead-pool* base-menu #x4000 1))
           (v1-5 (when s5-0
                   (let ((s4-0 (method-of-type process activate)))
                     (s4-0 s5-0 arg0 (symbol->string (-> base-menu symbol)) (the-as pointer #x70004000))
                     )
                   (run-now-in-process
                     s5-0
                     base-menu-init-by-other
                     *background-menu-info*
                     (new 'static 'vector :data (new 'static 'array float 4 0.0 0.0 0.0 1.0))
                     0
                     )
                   (-> s5-0 ppointer)
                   )
                 )
           )
      (when v1-5
        (set! (-> arg0 menu-handle-background) (process->handle (-> v1-5 0)))
        (change-to-last-brother (-> v1-5 0))
        )
      )
    )
  0
  )

;; definition for function lmm-make-logo-menu
;; og:preserve-this the unset-t0 read this banner used to flag is resolved
;; below (issue #744).
(defun lmm-make-logo-menu ((arg0 lobby-menu-manager))
  (when (and (not (handle->process (-> arg0 menu-handle-logo-subtitle)))
             (not (handle->process (-> arg0 menu-handle-logo-main)))
             )
    (let* ((s5-0 (get-process *default-dead-pool* jakx-logo-menu #x4000 1))
           (v1-9 (when s5-0
                   (let ((s4-0 (method-of-type process activate)))
                     (s4-0 s5-0 arg0 (symbol->string (-> jakx-logo-menu symbol)) (the-as pointer #x70004000))
                     )
                   ;; og:preserve-this run-now-in-process forwards this
                   ;; trailing argument verbatim into base-menu-init-by-
                   ;; other's arg2, the menu's own pad index (menu2-
                   ;; installs.gc stores it at (-> self pad)); the
                   ;; decompiler dropped retail's own zeroing of that
                   ;; register as dead, so the raw decode read garbage out
                   ;; of an unset t0 here and at the sibling call below.
                   ;; Explicit 0 is the retail value (pad 0), same
                   ;; dropped-argument class as activate-bar's own #743 fix.
                   ;; Issue #744.
                   (run-now-in-process
                     s5-0
                     base-menu-init-by-other
                     *logo-menu-info*
                     (new 'static 'vector :data (new 'static 'array float 4 0.0 0.0 0.0 1.0))
                     0
                     )
                   (-> s5-0 ppointer)
                   )
                 )
           )
      (when v1-9
        (set! (-> arg0 menu-handle-logo-main) (process->handle (-> v1-9 0)))
        (change-to-last-brother (-> v1-9 0))
        )
      )
    (when (zero? (scf-get-territory))
      (let* ((s5-1 (get-process *default-dead-pool* jakx-logo-menu #x4000 1))
             (v1-14 (when s5-1
                      (let ((s4-1 (method-of-type process activate)))
                        (s4-1 s5-1 arg0 (symbol->string (-> jakx-logo-menu symbol)) (the-as pointer #x70004000))
                        )
                      (run-now-in-process
                        s5-1
                        base-menu-init-by-other
                        *logo-subtitle-menu-info*
                        (new 'static 'vector :data (new 'static 'array float 4 0.0 0.0 0.0 1.0))
                        0
                        )
                      (-> s5-1 ppointer)
                      )
                    )
             )
        (when v1-14
          (set! (-> arg0 menu-handle-logo-subtitle) (process->handle (-> v1-14 0)))
          (change-to-last-brother (-> v1-14 0))
          )
        )
      )
    ;; og:preserve-this (issue 762): retyped this call site's own cast from
    ;; int to string, matching fmv-player-run-texture's own arg0 retype
    ;; (fmv-player-h.gc) -- "logo" is already a string literal, the int cast
    ;; was only ever hiding that from the old (int process-tree) stub
    ;; signature. This is the real login-logo trigger: *fmv-player* not yet
    ;; live, or live under some other name, (re)spawns the texture-mode
    ;; player below.
    (if (or (not *fmv-player*) (not (string= "logo.ipu" *fmv-m2v-name*)))
        (fmv-player-run-texture "logo" *default-pool*)
        )
    )
  0
  )

;; definition for function kill-logo-menu
(defbehavior kill-logo-menu lobby-menu-manager ((arg0 lobby-menu-manager))
  (send-event (handle->process (-> arg0 menu-handle-logo-subtitle)) 'die)
  (send-event (handle->process (-> arg0 menu-handle-logo-main)) 'die)
  0
  )

;; failed to figure out what this is:
(defstate init-state (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('die-fast)
       (go-virtual die-fast)
       )
      )
    )
  :enter (behavior ()
    (local-vars (a3-0 none) (t0-0 none))
    (set! (-> self profile-ticks) (the-as uint (+ *pending-op-serial* 1)))
    (set-blackout-frames 0)
    (setting-control-method-17 *setting-control* 'title-control-scene 'render a3-0 t0-0)
    (lmm-make-background-menu self)
    (logand! (-> *game-info* secrets) -16385)
    )
  :code (behavior ()
    (local-vars (sp-0 none))
    (if (!= *game-mode* 'adventure)
        (jukebox-onoff #t)
        )
    (screen-filter-method-11 *screen-filter*)
    (screen-filter-method-11 (-> *screen-filter-array* 0))
    (until #f
      (let ((v1-8 (new 'stack-no-clear 'array 'pointer 2)))
        (when (dma-try-alloc #x80040 #x80040 'fmv-player 0 (&-> v1-8 0) (&-> v1-8 1) #f)
          (suspend)
          (suspend)
          (goto cfg-7)
          )
        )
      (suspend)
      0
      )
    #f
    (label cfg-7)
    (dma-dump)
    (let ((a1-1 (the-as (pointer symbol) (+ (the-as uint sp-0) 32))))
      (set! (-> a1-1 0) 'menu1)
      (want-sound-banks *load-state* a1-1)
      )
    (when (and *net-mgr* *should-update-stats* (nonzero? (-> *net-mgr* lobby-state connect-handle)))
      ((method-of-type net-player-ladder-stats-info net-player-ladder-stats-info-method-10)
       (the-as net-player-ladder-stats-info *net-player-ladder-stats-info*)
       (-> (the-as medius-cached-info-player *medius-my-player*) ladder-stats)
       )
      (medius-start-account-stats-update #t #t)
      )
    (apply-clan-deltas)
    (when (activate-bar)
      (setting-control-method-11 *setting-control* (view-get-active-index) self 'mode-name 'cam-lobby 0 0)
      (setting-control-method-11 *setting-control* (view-get-active-index) self 'interp-time 'abs 0 0)
      )
    (let ((gp-2 *lobby-reset-mode*))
      (set! *lobby-reset-mode* #f)
      (when gp-2
        (set! (-> self local-players) *lobby-local-players*)
        (when *net-world*
          (set! (-> *num-players-info* min-val) (-> *net-world* net-state max-humans))
          (set! (-> *ai-num-players-info* min-val) (-> *net-world* net-state ai-slots))
          (let ((v1-41 (-> *net-world* net-state vehicle-class)))
            (set! (-> *vehicle-class* selection-type) (the-as basic (cond
                                                                      ((zero? v1-41)
                                                                       0
                                                                       )
                                                                      ((= v1-41 1)
                                                                       1
                                                                       )
                                                                      (else
                                                                        2
                                                                        )
                                                                      )
                                                              )
                  )
            )
          )
        (set! (-> self game-connection-type) (the-as uint *lobby-menu-manager-game-connection-type*))
        (if *net-mgr*
            (net-mgr-notify-connect self 15)
            )
        )
      (format 0 "***************** ~S~%" gp-2)
      (case gp-2
        (('results 'quit)
         (when (= *game-mode* 'adventure)
           (setting-control-method-14 *setting-control* 'bg-a-force 30 'bg-a-force 'abs 1.0 0)
           (setting-control-method-14 *setting-control* 'bg-a-speed 300 'bg-a-speed 'abs 1000.0 0)
           (setting-control-method-15 *setting-control* self 'bg-a 'abs #x3f800000 0)
           )
         (cond
           ((zero? (-> self game-connection-type))
            (cond
              ((= *game-mode* 'adventure)
               (cond
                 ((or (kiosk?) (demo?))
                  (go-virtual adventure-init)
                  )
                 ((-> *game-info* playing-grand-prix?)
                  (go-virtual lobby-menu-manager-state-155)
                  )
                 (else
                   (go-virtual lobby-menu-manager-state-149)
                   )
                 )
               )
              (else
                (let ((t9-24 auto-save-command)
                      (a0-26 'auto-save)
                      (a1-12 0)
                      (a2-7 *profile-slot*)
                      (a3-6 *default-pool*)
                      (t0-6 #f)
                      )
                  (t9-24 a0-26 a1-12 a2-7 a3-6 t0-6)
                  )
                (set! *lobby-body-parts-return-state-name* 'choose-event-menu)
                (go-virtual lobby-menu-manager-state-143)
                )
              )
            )
           (else
             (let ((t9-26 auto-save-command)
                   (a0-27 'auto-save)
                   (a1-13 0)
                   (a2-8 *profile-slot*)
                   (a3-7 *default-pool*)
                   (t0-7 #f)
                   )
               (t9-26 a0-27 a1-13 a2-8 a3-7 t0-7)
               )
             (cond
               ((= gp-2 'results)
                (set! *lobby-body-parts-return-state-name* 'ready-room-state)
                (go-virtual lobby-menu-manager-state-143)
                )
               ((= gp-2 'quit)
                (format 0 "going to host-join-menu~%")
                (go-virtual host-join-menu)
                )
               )
             )
           )
         )
        (('net-game-disconnected)
         (set! (-> *lobby-generic-error-text-ids* 0) 1603)
         (set! (-> *lobby-generic-error-bottom-text-ids* 0) 1601)
         (set! (-> *lobby-generic-error-bottom-text-ids2* 0) 1712)
         (set! (-> *lobby-generic-error-bottom-text-ids3* 0) 1712)
         (set! (-> *lobby-generic-error-bottom-text-ids4* 0) 1712)
         (set! (-> *lobby-generic-error-bottom-text-ids5* 0) 1712)
         (enter-state
           *lobby-generic-confirmation*
           (lambda :behavior lobby-menu-manager () (go-virtual lobby-menu-manager-state-56))
           #f
           #t
           #f
           #f
           )
         (go-virtual lobby-generic-error-menu)
         )
        (('lobby-anti-cheat)
         (go-virtual lobby-menu-manager-state-92)
         )
        (('lobby-dirty-cd)
         (send-event *net-mgr* 'leave-lobby)
         (set! (-> *lobby-generic-error-text-ids* 0) 1603)
         (set! (-> *lobby-generic-error-bottom-text-ids* 0) 1601)
         (set! (-> *lobby-generic-error-bottom-text-ids2* 0) 1712)
         (set! (-> *lobby-generic-error-bottom-text-ids3* 0) 1712)
         (set! (-> *lobby-generic-error-bottom-text-ids4* 0) 1712)
         (set! (-> *lobby-generic-error-bottom-text-ids5* 0) 1712)
         (enter-state
           *lobby-generic-confirmation*
           (lambda :behavior lobby-menu-manager () (go-virtual lobby-menu-manager-state-55))
           #f
           #t
           #f
           #f
           )
         (go-virtual lobby-generic-error-menu)
         )
        (('lobby-no-cd)
         (send-event *net-mgr* 'leave-lobby)
         (set! (-> *lobby-generic-error-text-ids* 0) 1603)
         (set! (-> *lobby-generic-error-bottom-text-ids* 0) 1601)
         (set! (-> *lobby-generic-error-bottom-text-ids2* 0) 1712)
         (set! (-> *lobby-generic-error-bottom-text-ids3* 0) 1712)
         (set! (-> *lobby-generic-error-bottom-text-ids4* 0) 1712)
         (set! (-> *lobby-generic-error-bottom-text-ids5* 0) 1712)
         (enter-state
           *lobby-generic-confirmation*
           (lambda :behavior lobby-menu-manager () (go-virtual lobby-menu-manager-state-55))
           #f
           #t
           #f
           #f
           )
         (go-virtual lobby-generic-error-menu)
         )
        (('booted)
         (set! (-> *lobby-generic-error-text-ids* 0) 3026)
         (set! (-> *lobby-generic-error-bottom-text-ids* 0) 1601)
         (set! (-> *lobby-generic-error-bottom-text-ids2* 0) 1712)
         (set! (-> *lobby-generic-error-bottom-text-ids3* 0) 1712)
         (set! (-> *lobby-generic-error-bottom-text-ids4* 0) 1712)
