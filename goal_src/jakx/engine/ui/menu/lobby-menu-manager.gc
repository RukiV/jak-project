             (set! (-> self game-connection-type) (the-as uint 0))
             (set! (-> self local-players) 1)
             (set! *lobby-local-players* (-> self local-players))
             (set! *game-mode* 'adventure)
             (set! (-> self vehicle-selected) (the-as uint -1))
             (when (lobby-menu-manager-method-183 self #f #f)
               (kill-logo-menu self)
               (go-virtual adventure-init)
