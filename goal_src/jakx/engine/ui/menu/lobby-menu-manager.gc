  (set! *lobby-menu-manager* self)
  (go-virtual init-state)
  )

;; definition for function lobby-start
(defun lobby-start ()
  (lobby-level-set! 0 'menu2 'display)
  (if (not *lobby-menu-manager*)
      (process-spawn lobby-menu-manager :name "lobby-menu-manager" :to *display-pool*)
      )
  0
  )

