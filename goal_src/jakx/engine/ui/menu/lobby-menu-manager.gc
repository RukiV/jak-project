  0
  )

;; definition for method 10 of type lobby-menu-manager
(defmethod deactivate ((this lobby-menu-manager))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (set! *lobby-menu-manager* #f)
  (send-event (handle->process (-> this vehicle-handle)) 'go 'die)
  (dma-release 'fmv-player)
  (jukebox-onoff #f)
  ((method-of-type process deactivate) this)
  (none)
  )

;; definition for function update-lobby-camera
;; INFO: Used lq/sq
;; WARN: Return type mismatch int vs none.
(defun update-lobby-camera ((arg0 camera-slave))
  (local-vars (a1-6 structure))
  (rlet ((vf0 :class vf)
         (vf4 :class vf)
         (vf5 :class vf)
         (vf6 :class vf)
         )
    (init-vf0-vector)
    (when (and *lobby-menu-manager* *interface-cam*)
      (-> (the-as process-drawable *interface-cam*) node-list data 4)
      (-> (the-as process-drawable *interface-cam*) node-list data 5)
      (let ((s4-0 (new 'stack-no-clear 'matrix)))
        (new 'stack-no-clear 'vector)
        (let ((s3-0 (new 'stack-no-clear 'vector))
              (s5-0 (entity-by-name (-> (the-as lobby-menu-manager *lobby-menu-manager*) cam-string)))
              )
          (when s5-0
            (set! (-> s3-0 quad) (the-as uint128 0))
            (cond
              (*garage-cinema*
                (new 'stack-no-clear 'vector)
                (let ((s2-0 (new 'stack-no-clear 'quaternion)))
                  (matrix-copy! s4-0 (-> *garage-cinema* node-list data 4 bone transform))
                  (matrix->quaternion s2-0 s4-0)
                  (quaternion-rotate-y! s2-0 s2-0 32768.0)
                  (quaternion->matrix s4-0 s2-0)
                  )
                (set! (-> s3-0 quad) (-> *garage-cinema* node-list data 4 bone transform trans quad))
                )
              ((begin
                 (cam-slave-get-rot (the-as entity-actor s5-0) s4-0)
                 (set! a1-6 (res-lump-struct s5-0 'trans-offset structure))
                 a1-6
                 )
               (let ((v1-17 s3-0))
                 (.lvf vf4 (&-> (-> s5-0 trans) quad))
                 (.lvf vf5 (&-> (the-as vector a1-6) quad))
                 (.mov.vf.w vf6 vf0)
                 (.add.vf.xyz vf6 vf4 vf5)
                 (.svf (&-> v1-17 quad) vf6)
                 )
               )
              (else
                (set! (-> s3-0 quad) (-> s5-0 trans quad))
                )
              )
            (cond
              ((-> (the-as lobby-menu-manager *lobby-menu-manager*) interpolate-camera?)
               (let ((s1-0 (new 'stack-no-clear 'quaternion)))
                 (let ((s2-1 (new 'stack-no-clear 'quaternion)))
                   (vector-smooth-seek! (-> arg0 trans) s3-0 (* real-camera-seek-time (seconds-per-frame)))
                   (matrix->quaternion s2-1 s4-0)
                   (matrix->quaternion s1-0 (-> arg0 tracking inv-mat))
                   (quaternion-smooth-seek! s1-0 s1-0 s2-1 (* real-camera-seek-time (seconds-per-frame)))
                   )
                 (quaternion->matrix (-> arg0 tracking inv-mat) s1-0)
                 )
               )
              (else
                (set! (-> arg0 trans quad) (-> s3-0 quad))
                (set! (-> arg0 tracking inv-mat rvec quad) (-> s4-0 rvec quad))
                (set! (-> arg0 tracking inv-mat uvec quad) (-> s4-0 uvec quad))
                (set! (-> arg0 tracking inv-mat fvec quad) (-> s4-0 fvec quad))
                (set! (-> (the-as lobby-menu-manager *lobby-menu-manager*) interpolate-camera?) (the-as basic #t))
                )
              )
            (cond
              ((-> (the-as lobby-menu-manager *lobby-menu-manager*) override-fov)
               (format *stdebug* "OVERRIDE FOV: ~F~%" (* 0.005493164 (-> arg0 fov)))
               (format *stdebug* "fov seek ~f~%" (* real-camera-seek-time (seconds-per-frame)))
               (seek!
                 (-> arg0 fov)
                 (+ (if (= (-> *setting-control* user-default aspect-ratio) 'aspect16x9)
                        14563.556
                        11650.845
                        )
                    (res-lump-float s5-0 'fov-offset)
                    )
                 (* 182.04445 (* real-camera-seek-time (seconds-per-frame)))
                 )
               )
              ((= (-> *setting-control* user-default aspect-ratio) 'aspect16x9)
               (set! (-> arg0 fov) 14563.556)
               )
              (else
                (set! (-> arg0 fov) 11650.845)
                )
              )
            )
          )
        )
      (when (not (-> arg0 enter-has-run))
        (set! (-> arg0 saved-pt quad) (-> arg0 trans quad))
        (set! (-> arg0 blend-from-type) (camera-blend-from-type unknown-1))
        (set! (-> arg0 blend-to-type) 0)
        0
        )
      )
    (none)
    )
  )

;; failed to figure out what this is:
(defstate cam-lobby (camera-slave)
  :event cam-standard-event-handler
  :enter (behavior ()
    (when (not (-> self enter-has-run))
      (set! (-> self saved-pt quad) (-> self trans quad))
      (set! (-> self blend-from-type) (camera-blend-from-type unknown-1))
      (set! (-> self blend-to-type) 0)
      0
      )
    )
  :code (behavior ()
    (until #f
      (update-lobby-camera self)
      (suspend)
      )
    #f
    )
  )

;; definition for function text-id-for-vehicle-type
;; WARN: Return type mismatch int vs object.
(defun text-id-for-vehicle-type ((arg0 object) (arg1 object))
  (dotimes (v1-0 (-> *net-vehicles* length))
    (if (= (-> *net-vehicles* v1-0 vt) arg0)
        (return (the-as object (if arg1
                                   (-> *net-vehicles* v1-0 id-variant)
                                   (-> *net-vehicles* v1-0 id)
                                   )
                        )
                )
        )
    )
  0
  )

;; definition for function text-id-class-for-vehicle-type
;; WARN: Return type mismatch int vs object.
(defun text-id-class-for-vehicle-type ((arg0 object))
  (dotimes (v1-0 (-> *net-vehicles* length))
    (when (= (-> *net-vehicles* v1-0 vt) arg0)
      (let ((v1-4 (-> *net-vehicles* v1-0 cup-mask)))
        (return (the-as object (cond
                                 ((logtest? v1-4 512)
                                  4030
                                  )
                                 ((logtest? v1-4 256)
                                  4029
                                  )
                                 ((logtest? v1-4 128)
                                  4028
                                  )
                                 (else
                                   4033
                                   )
                                 )
                        )
                )
        )
      )
    )
  4033
  )

;; menu-road rung 3 post-boot audit (issue 699): a -debug acceptance boot
;; crashed with gk's own "attempting to run nullptr function!" trap, pp =
;; lobby-menu-manager, inside the go/enter-state dispatch machinery
;; (stack carrying gstate.gc's own enter-state, which calls a state's own
;; :code field completely unconditionally, no #f guard the way :enter/
;; :trans get one). Root cause: pre-game-type-menu and waiting-for-cd
;; (both landed in lobby-net-startup.gc, menu-road rung 3) go-virtual
;; into three numbered lobby-menu-manager state slots on their own normal,
;; unconditional-on-a-fresh-boot control flow (54, 55, and 140); none of
;; the three had ever been installed by any defstate or method-set!
;; anywhere in the corpus, so the type system's own :state-methods
;; declaration reserves and types the slot (satisfying go-hook's own
;; compile-time "incomplete type" check) but its runtime vtable entry is
;; never written, leaving it at whatever the type's own initial method
;; table fill is -- raw 0, not #f, since state dispatch only tests
;; against #f and 0 slips through as "callable." These three minimal
;; inert stubs close exactly the slots the confirmed critical path
;; reaches; the other ~30 states menu-road rung 3's own PARTIAL cut
;; documented (slots 51-75 minus these two, 92, 121, 195) are not on this
;; boot's own path and stay uninstalled.
(defstate lobby-menu-manager-state-54 (lobby-menu-manager)
  :virtual #t
  :code sleep-code
  )

(defstate lobby-menu-manager-state-55 (lobby-menu-manager)
  :virtual #t
  :code sleep-code
  )

