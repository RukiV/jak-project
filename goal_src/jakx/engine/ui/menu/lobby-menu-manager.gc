             )
            (('customize)
             (when (lobby-menu-manager-method-183 self #f #f)
               (kill-logo-menu self)
               (go-virtual lobby-menu-manager-state-97)
               #t
               )
             )
            (('options)
             (when (lobby-menu-manager-method-183 self #f #f)
               (lobby-menu-manager-method-182 self *options-menu-info* 0)
               (kill-logo-menu self)
               (go-virtual options-menu)
               #t
               )
             )
            (('secrets)
             (when (lobby-menu-manager-method-183 self #f #f)
               (kill-logo-menu self)
               (go-virtual lobby-menu-manager-state-26)
               )
             )
            (('profile)
             (if (lobby-menu-manager-method-183 self #f #f)
                 (go-virtual new-load-save-profile)
                 )
             )
            (('multiplayer)
             (set! *game-mode* 'online)
             (set! (-> *num-players-info* default-val) 2)
             (set! (-> *num-players-info* max-val) 6)
             (set! (-> self game-connection-type) (the-as uint 2))
