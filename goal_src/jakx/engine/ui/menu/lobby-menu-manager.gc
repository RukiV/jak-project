    (set! (-> self garage-lights-target) 0.0)
    (set! (-> self psp-mode-run?) #f)
    (set! *game-mode* #f)
    (restore-selection-index)
    )
  :trans (behavior ()
    (lmm-make-logo-menu self)
    (if (not (handle->process (-> self vehicle-handle)))
        (set! (-> self vehicle-selected)
              (-> *game-info* player-info (-> self current-local-player) last-selected-vehicle)
              )
        )
    )
  :code (behavior ()
    (if (= (-> self prev-state name) 'adventure-cup)
        (adventure-map-fade-out #f)
        )
    (copy-string<-string (-> self cam-string) "camera-6")
    (sleep-code)
    )
  :post lobby-default-post
  )

