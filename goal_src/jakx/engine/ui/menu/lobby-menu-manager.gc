(defbehavior lobby-default-post lobby-menu-manager ()
  (pulse-new-font-color)
  (update-camera)
  (seek! (-> self garage-lights) (-> self garage-lights-target) 0.06)
  (set-garage-switched! (-> self garage-lights))
