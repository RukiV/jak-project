(defstate new-load-profile (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('menu-selection-event)
       (case (-> block param 0)
         (('changed)
          #f
          )
         (('cancel)
          #f
          )
         (('accept)
          (case (-> block param 1)
            (('new-profile)
             (set! (-> self profile-new-save) (the-as basic #t))
             (if (lobby-menu-manager-method-183 self #f #f)
                 (go-virtual enter-profile-name)
                 )
             )
            (('load-profile)
             (set! (-> self split-selection-prev-state) (the-as basic 'load-profile))
             (when (lobby-menu-manager-method-183 self #f #f)
               (cond
                 ((zero? (-> *progress-save-info* handle))
                  (let ((v1-13 154)
                        (a0-9 *profile-errors-continue*)
                        )
                    (s.w! (+ (the-as int a0-9) 12) v1-13)
                    )
                  (let ((v1-14 156)
                        (a0-10 *profile-errors-continue*)
                        )
                    (s.w! (+ (the-as int a0-10) 16) v1-14)
                    )
                  (let ((v1-15 158)
                        (a0-11 *profile-errors-continue*)
                        )
                    (s.w! (+ (the-as int a0-11) 20) v1-15)
                    )
                  (go-virtual no-card)
                  )
                 ((zero? (-> *progress-save-info* formatted))
                  (let ((v1-20 155)
                        (a0-12 *profile-errors-continue*)
                        )
                    (s.w! (+ (the-as int a0-12) 12) v1-20)
                    )
                  (let ((v1-21 156)
                        (a0-13 *profile-errors-continue*)
                        )
                    (s.w! (+ (the-as int a0-13) 16) v1-21)
                    )
                  (let ((v1-22 158)
                        (a0-14 *profile-errors-continue*)
                        )
                    (s.w! (+ (the-as int a0-14) 20) v1-22)
                    )
                  (go-virtual no-card)
                  )
                 ((zero? (-> *progress-save-info* inited))
                  (let ((v1-27 157)
                        (a0-15 *profile-errors-continue*)
                        )
                    (s.w! (+ (the-as int a0-15) 12) v1-27)
                    )
                  (let ((v1-28 156)
                        (a0-16 *profile-errors-continue*)
                        )
                    (s.w! (+ (the-as int a0-16) 16) v1-28)
                    )
                  (let ((v1-29 158)
                        (a0-17 *profile-errors-continue*)
                        )
                    (s.w! (+ (the-as int a0-17) 20) v1-29)
                    )
                  (go-virtual no-card)
                  )
                 (else
                   (go-virtual load-profile)
                   )
                 )
               )
             )
            )
          )
         (else
           #f
           )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (set! (-> self profile-save-mode) #f)
    (lobby-menu-manager-method-183 self #t #f)
    (dotimes (i (+ (-> self in-focus-index) 1))
      (let ((proc (handle->process (-> self menu-handles i))))
        (when (and proc (= (-> (the-as base-menu proc) info-ptr) *menu-new-load-profile*))
          (return #f)
          )
        )
      )
    (lobby-menu-manager-method-183 self #t #f)
    (lobby-menu-manager-method-182 self *menu-new-load-profile* 0)
    )
  :exit (behavior ()
    (kill-logo-menu self)
    )
  :trans (behavior ()
    (lmm-make-logo-menu self)
    (mc-get-slot-info 0 *progress-save-info*)
    )
  :code sleep-code
  :post lobby-default-post
  )

;; definition for symbol *menu-new-load-save-profile*, type object
;; issue 699 rung 3b: the same "New Profile"/"Load Profile" side-bar as
;; *menu-new-load-profile* above, reached instead from game-type-menu's own
;; 'profile branch (already landed, lobby-menu-manager.gc). Top-level
;; fields only; :children stays the decoder's own one-level-deep base-
;; menu-info/structure placeholder (a real, non-#f pointer, not chased to
;; the leaf level this rung - see this file's own header note).
(define *menu-new-load-save-profile*
  (the-as object (new 'static 'base-menu-info
                   :menu-type 'base-menu
                   :children (new 'static 'boxed-array :type structure (new 'static 'structure))
                   :name-symbol #f
                   :3d-menu-type #f
                   :trans-info #f
                   :joint-index -1
                   :joint-index-2 -1
                   :box-index -1
                   :joints #f
                   :width -1
                   :height -1
                   :scale-y 1.0
                   :scale-x 1.0
                   )
                 )
  )

(defstate new-load-save-profile (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('menu-selection-event)
       (case (-> block param 0)
         (('changed)
          #f
          )
         (('cancel)
          (if (lobby-menu-manager-method-183 self #f #f)
              (go-virtual pre-game-type-menu)
              )
          )
         (('accept)
          (case (-> block param 1)
            (('new-profile)
             (set! (-> self profile-new-save) (the-as basic #t))
             (if (lobby-menu-manager-method-183 self #f #f)
                 (go-virtual enter-profile-name)
                 )
             )
            (('load-profile)
             (set! (-> self split-selection-prev-state) (the-as basic 'load-profile))
             (when (lobby-menu-manager-method-183 self #f #f)
               (cond
                 ((zero? (-> *progress-save-info* handle))
                  (let ((v1-17 154)
                        (a0-11 *profile-errors-continue*)
                        )
                    (s.w! (+ (the-as int a0-11) 12) v1-17)
                    )
                  (let ((v1-18 156)
                        (a0-12 *profile-errors-continue*)
                        )
                    (s.w! (+ (the-as int a0-12) 16) v1-18)
                    )
                  (let ((v1-19 158)
                        (a0-13 *profile-errors-continue*)
                        )
                    (s.w! (+ (the-as int a0-13) 20) v1-19)
                    )
                  (go-virtual no-card)
                  )
                 ((zero? (-> *progress-save-info* formatted))
                  (let ((v1-24 155)
                        (a0-14 *profile-errors-continue*)
                        )
                    (s.w! (+ (the-as int a0-14) 12) v1-24)
                    )
                  (let ((v1-25 156)
                        (a0-15 *profile-errors-continue*)
                        )
                    (s.w! (+ (the-as int a0-15) 16) v1-25)
                    )
                  (let ((v1-26 157)
                        (a0-16 *profile-errors-continue*)
                        )
                    (s.w! (+ (the-as int a0-16) 20) v1-26)
                    )
                  (go-virtual no-card)
                  )
                 ((zero? (-> *progress-save-info* inited))
                  (let ((v1-31 157)
                        (a0-17 *profile-errors-continue*)
                        )
                    (s.w! (+ (the-as int a0-17) 12) v1-31)
                    )
                  (let ((v1-32 156)
                        (a0-18 *profile-errors-continue*)
                        )
                    (s.w! (+ (the-as int a0-18) 16) v1-32)
                    )
                  (let ((v1-33 158)
                        (a0-19 *profile-errors-continue*)
                        )
                    (s.w! (+ (the-as int a0-19) 20) v1-33)
                    )
                  (go-virtual no-card)
                  )
                 (else
                   (go-virtual load-profile)
                   )
                 )
               )
             )
            (('save-profile)
             (set! (-> self split-selection-prev-state) (the-as basic 'select-save-profile))
             (set! (-> self profile-new-save) #f)
             (when (lobby-menu-manager-method-183 self #f #f)
               (cond
                 ((zero? (-> *progress-save-info* handle))
                  (let ((v1-43 154)
                        (a0-23 *profile-errors-continue*)
                        )
                    (s.w! (+ (the-as int a0-23) 12) v1-43)
                    )
                  (let ((v1-44 156)
                        (a0-24 *profile-errors-continue*)
                        )
                    (s.w! (+ (the-as int a0-24) 16) v1-44)
                    )
                  (let ((v1-45 158)
                        (a0-25 *profile-errors-continue*)
                        )
                    (s.w! (+ (the-as int a0-25) 20) v1-45)
                    )
                  (go-virtual no-card)
                  )
                 ((zero? (-> *progress-save-info* formatted))
                  (go-virtual want-format)
                  )
                 ((zero? (-> *progress-save-info* inited))
                  (go-virtual want-create-file)
                  )
                 (else
                   (go-virtual select-save-profile)
                   )
                 )
               )
             )
            (('highscore)
             (go-virtual local-highscore-table)
             )
            )
          )
         (else
           #f
           )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (set! (-> self profile-save-mode) #f)
    (lobby-menu-manager-method-183 self #t #f)
    (dotimes (i (+ (-> self in-focus-index) 1))
      (let ((proc (handle->process (-> self menu-handles i))))
        (when (and proc (= (-> (the-as base-menu proc) info-ptr) *menu-new-load-save-profile*))
          (return #f)
          )
        )
      )
    (lobby-menu-manager-method-183 self #t #f)
    (lobby-menu-manager-method-182 self *menu-new-load-save-profile* 0)
    )
  :exit (behavior ()
    (if (!= (-> self next-state name) 'pre-game-type-menu)
        (kill-logo-menu self)
        )
    )
  :trans (behavior ()
    (mc-get-slot-info 0 *progress-save-info*)
    (lmm-make-logo-menu self)
    )
  :code sleep-code
  :post lobby-default-post
  )

;; definition for symbol *menu-boot-memorycard*, type object
;; issue 699 rung 3b: the rare-path yes/no prompt boot-memory-card's own
;; :code below spawns only when no card has been detected for 300 frames.
;; Top-level fields only; :children (a profile-yes-no-string, TIER 2, held)
;; stays the decoder's own one-level-deep placeholder - see this file's own
;; header note.
(define *menu-boot-memorycard*
  (the-as object (new 'static 'base-menu-info
                   :menu-type 'base-menu
                   :children (new 'static 'boxed-array :type structure (new 'static 'structure))
                   :name-symbol #f
                   :3d-menu-type #f
                   :trans-info #f
                   :joint-index -1
                   :joint-index-2 -1
                   :box-index -1
                   :joints #f
                   :width -1
                   :height -1
                   :scale-y 1.0
                   :scale-x 1.0
                   )
                 )
  )

;; boot-memory-card (140): retail's own memory-card status gate.
;; lobby-net-startup.gc's own pre-game-type-menu go-virtuals here
;; unconditionally on a fresh cold boot with no *debug-segment*, so this is
;; the retirement target the old bring-up bridge in lobby-menu-manager.gc
;; named (issue 699 rung 3b, issue 759); see that file's own retirement
;; note. :code's own scan-then-spawn guard sits inside a cond TEST rather
;; than at the top of the whole function, so an early function-wide
;; (return ...) would skip the rest of the cond incorrectly; kept as the
;; explicit goto/label pair this file's own inspect methods already use for
;; the same "early exit with a value, not from the whole function" need.
(defstate boot-memory-card (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('menu-selection-event)
       (case (-> block param 0)
         (('changed)
          #f
          )
         (('cancel)
          #f
          )
         (('accept)
          (case (-> block param 1)
            (('yes)
             (go-virtual new-load-profile)
             )
            (('no)
             (go-virtual boot-memory-card)
             )
            )
          )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (lobby-menu-manager-method-183 self #t #f)
    )
  :trans (behavior ()
    (mc-get-slot-info 0 *progress-save-info*)
    (cond
      ((zero? (-> *progress-save-info* handle))
       (let ((v1-3 154)
             (a0-1 *profile-yes-no*)
             )
         (s.w! (+ (the-as int a0-1) 12) v1-3)
         )
       (let ((v1-4 156)
             (a0-2 *profile-yes-no*)
             )
         (s.w! (+ (the-as int a0-2) 16) v1-4)
         )
       (let ((v1-5 152)
             (a0-3 *profile-yes-no*)
             )
         (s.w! (+ (the-as int a0-3) 20) v1-5)
         )
       (let ((v0-1 152)
             (v1-6 *profile-yes-no*)
             )
         (s.w! (+ (the-as int v1-6) 20) v0-1)
         )
       )
      ((and (< (-> *progress-save-info* mem-actual) (-> *progress-save-info* mem-required))
            (zero? (-> *progress-save-info* inited))
            )
       (let ((v1-11 153)
             (a0-9 *profile-yes-no*)
             )
         (s.w! (+ (the-as int a0-9) 12) v1-11)
         )
       (let ((v1-12 156)
             (a0-10 *profile-yes-no*)
             )
         (s.w! (+ (the-as int a0-10) 16) v1-12)
         )
       (let ((v1-13 152)
             (a0-11 *profile-yes-no*)
             )
         (s.w! (+ (the-as int a0-11) 20) v1-13)
         )
       (let ((v0-3 152)
             (v1-14 *profile-yes-no*)
             )
         (s.w! (+ (the-as int v1-14) 20) v0-3)
         )
       )
      )
    )
  :code (behavior ()
    (let ((start (-> self clock frame-counter)))
      (until (begin
               (suspend)
               (>= (- (-> self clock frame-counter) start) 300)
               )
        (empty)
        )
      )
    (cond
      ((and (zero? (-> *progress-save-info* handle))
            (let ((shown? #f))
              (dotimes (i (+ (-> self in-focus-index) 1))
                (let ((proc (handle->process (-> self menu-handles i))))
                  (when (and proc (= (-> (the-as base-menu proc) info-ptr) *menu-boot-memorycard*))
                    (set! shown? #t)
                    (goto cfg-bmc-scan-a)
                    )
                  )
                )
              (label cfg-bmc-scan-a)
              (not shown?)
              )
            )
       (lobby-menu-manager-method-183 self #t #f)
       (lobby-menu-manager-method-182 self *menu-boot-memorycard* 0)
       )
      ((zero? (-> *progress-save-info* formatted))
       (go-virtual new-load-profile)
       )
      ((and (< (-> *progress-save-info* mem-actual) (-> *progress-save-info* mem-required))
            (nonzero? (-> *progress-save-info* inited))
            )
       (let ((shown? #f))
         (dotimes (i (+ (-> self in-focus-index) 1))
           (let ((proc (handle->process (-> self menu-handles i))))
             (when (and proc (= (-> (the-as base-menu proc) info-ptr) *menu-boot-memorycard*))
               (set! shown? #t)
               (goto cfg-bmc-scan-b)
               )
             )
           )
         (label cfg-bmc-scan-b)
         (unless shown?
           (lobby-menu-manager-method-183 self #t #f)
           (lobby-menu-manager-method-182 self *menu-boot-memorycard* 0)
           )
         )
       )
      (else
        (go-virtual new-load-profile)
        )
      )
    (until (begin (suspend) #f)
      (empty)
      )
    (none)
    )
  :post lobby-default-post
  )

;; TIER 2 (issue 699's own "memory-card screens", held): none of these
;; thirteen decode clean past their own :event/:trans's calls into go-
;; profile-state/memcard-continue (this decode's own "function has no type
;; analysis. Cannot decompile", the same cannot-decompile class as menu-
;; clear-strip - a real defun each, not attempted this rung), and the
;; widget classes they spawn (dropdown-profile, title-load-save-profile,
;; profile-error-string, profile-yes-no-string, profile-loading-string)
;; carry their own further type-prop errors on top. None had ever been
;; installed by any defstate or method-set! anywhere in the corpus before
;; this rung (same "raw 0 slips through the #f-only dispatch guard" class
;; issue 699's own road audit already documents for ~30 other slots on this
;; type), so parking them here is a strict improvement over the prior
;; state (crash -> park), not a new hazard, and sits off this rung's own
;; cold-boot acceptance path (TIER 1 above). Retires per state as each
;; state's own real body lands in a follow-up rung.
(defstate load-profile (lobby-menu-manager)
  :virtual #t
  :code sleep-code
  )

(defstate loading-profile (lobby-menu-manager)
