                       :scale-x 1.0
                       )
                     )
                   :name-symbol #f
                   :3d-menu-type #f
                   :trans-info #f
                   :joint-index -1
                   :joint-index-2 -1
                   :box-index -1
                   :joints #f
                   :width -1
