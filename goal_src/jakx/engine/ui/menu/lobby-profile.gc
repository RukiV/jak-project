                         :enter-delay 15
                         :3d-offset (new 'static 'vector :data (new 'static 'array float 4 0.0 -8192.0 0.0 1.0))
                         )
                       :joint-index -1
                       :joint-index-2 -1
                       :box-index -1
                       :joints (new 'static 'boxed-array :type int8 7 8)
                       :width -1
