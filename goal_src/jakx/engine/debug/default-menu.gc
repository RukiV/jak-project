        arg0
        '(menu
           "Game"
           (function
             "New Game"
             #f
             ,(lambda ()
                (initialize! *game-info* 'game (the-as game-save #f) (the-as string #f) (the-as resetter-spec #f))
                )
             )
           (function
             "New Life"
             #f
             ,(lambda ()
                (initialize! *game-info* 'dead (the-as game-save #f) (the-as string #f) (the-as resetter-spec #f))
                )
             )
           ;; og:preserve-this two bare-label lambdas (L525, L519) held rather
           ;; than reconstructed: jak3's own twin (same two menu entries)
           ;; depends on *target*, a global symbol that does not exist
           ;; anywhere in jakx (target-pos takes an explicit player index
           ;; instead, "jak3-parity sig" per all-types.gc, a genuine
           ;; split-screen API divergence). No body evidence survives to
           ;; reconstruct jakx's own replacement mechanism; pressing either
           ;; item is a silent no-op rather than the retail behavior.
           (function "Kill Target" #f ,(lambda () (none)))
           (function "Hit Target" #f ,(lambda () (none)))
           (function
             "Reset Game"
             #f
             ,(lambda ()
                (set! (-> *game-info* mode) 'debug)
                (initialize! *game-info* 'game (the-as game-save #f) (the-as string #f) (the-as resetter-spec #f))
                )
             )
           (function "Reset Actors" #f ,(lambda () (reset-actors 'debug)))
           (function "Save Game" #f ,(lambda () (let ((t9-0 auto-save-command)
                                                      (a0-0 'save)
                                                      (a1-0 0)
                                                      (a2-0 0)
                                                      (a3-0 *default-pool*)
                                                      (t0-0 #f)
                                                      )
                                                  (t9-0 a0-0 a1-0 a2-0 a3-0 t0-0)
                                                  )
                                             )
                     )
           (function "Load Game" #f ,(lambda () (let ((t9-0 auto-save-command)
                                                      (a0-0 'restore)
                                                      (a1-0 0)
                                                      (a2-0 0)
                                                      (a3-0 *default-pool*)
                                                      (t0-0 #f)
