           (function "Reset Actors" #f ,(lambda () (reset-actors 'debug)))
           ;; og:preserve-this two bare-label lambdas (L389, L387), hand-
           ;; written verbatim from jak3's own landed twin (identical
           ;; valid?-guarded traffic-start/traffic-kill function-var calls,
           ;; both already carried as provisional call-site-only externs in
           ;; all-types.gc)
           (function "Traffic Start" #f ,(lambda () (let ((gp-0 traffic-start))
                                                      (if (valid? gp-0 function "" #t 0)
                                                          (gp-0)
                                                          )
                                                      )
                                                 )
                     )
           (function "Traffic Kill" #f ,(lambda () (let ((gp-0 traffic-kill))
                                                     (if (valid? gp-0 function "" #t 0)
                                                         (gp-0)
