           (function "Get All Vehicles Parts" #f ,(lambda () (none)))
           (function "Get All Tasks" #f ,(lambda () (none)))
           (function "Get All Venues" #f ,(lambda ()
                                            (let* ((v1-1 (-> *task-level-info* length))
                                                   (a0-0 0)
                                                   (a1-2 (-> *task-level-info* a0-0))
                                                   )
                                              (while (< a0-0 v1-1)
                                                (logior! (-> a1-2 flags) 1)
                                                (+! a0-0 1)
                                                (set! a1-2 (-> *task-level-info* a0-0))
                                                )
                                              )
                                            #f
                                            )
                     )
