                                                  )
                                             )
                     )
           (function "Manager Complete" #f ,(lambda () (script-eval '(send-event *task-manager* 'complete))))
           (flag "Target" #f ,(lambda ((arg0 object) (arg1 debug-menu-msg))
                                (when (= arg1 (debug-menu-msg press))
                                  (if (view-get-active-target)
                                      (stop 'debug 0)
                                      (start 'debug (the-as basic #f) 0)
                                      )
