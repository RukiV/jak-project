;; og:preserve-this held (register-soup decode): the fresh decode fails to
;; convert this function to expressions ("failed type prop at 14: Could not
;; figure out load: (set! a0 (l.wu v1))"), leaving a raw register dump
;; (game-info-method-17 called through method-of-type, a listener-continue
;; call) rather than a resolvable bare label. No landed jakx twin offset or
;; symbol anchors a port. Held as a type-correct stub (see
;; test/offline/config/jakx/config.jsonc skip_compile_functions for the
;; matching raw-decode compile skip); the current-continue display menu item
;; that calls it reports nothing rather than the retail behavior.
(defun dm-current-continue ((arg0 string) (arg1 debug-menu-msg))
  #f
  )

