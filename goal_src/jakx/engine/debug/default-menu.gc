;; og:preserve-this debug-segment guard (runtime-falsified, tip smoke): same
;; class as *debug-menu-context* above; see editable-player.gc's
;; *editable-menu-context* note for the full C++ citation.
;;
;; definition for symbol *popup-menu-context*, type debug-menu-context
(define *popup-menu-context* (when *debug-segment* (new 'debug 'debug-menu-context)))

;; definition for function popup-menu-context-make-default-menus
(defun popup-menu-context-make-default-menus ((arg0 debug-menu-context))
  (debug-menu-make-from-template
    arg0
    '(main-menu
       "Popup"
       (flag "Cam 1" pad-1 dm-cam-externalize)
       (flag "Turbo Cam" *camera-turbo-free* dm-boolean-toggle-pick-func)
       (flag "Target" #f ,(lambda ((arg0 object) (arg1 debug-menu-msg))
                            (when (= arg1 (debug-menu-msg press))
                              (if (view-get-active-target)
                                  (stop 'debug 0)
                                  (start 'debug (the-as basic #f) 0)
                                  )
                              )
                            (view-get-active-target)
                            )
             )
       (flag "Suppress vehicle respawn" *suppress-vehicle-respawn* dm-boolean-toggle-pick-func)
       (flag "Turbo + Invulnerable" *debug-player-vehicle-unkillable* dm-boolean-toggle-pick-func)
       (menu
         "Mode"
         (function "normal" #f ,(lambda () (send-event (view-get-active-target) 'change-mode 'normal)))
         (function "racer" #f ,(lambda ()
                                 (if (not (view-get-active-target))
                                     (start 'debug (the-as basic #f) 0)
                                     )
                                 (send-event (view-get-active-target) 'change-mode 'racer #f)
                                 )
                   )
         (function "flut" #f ,(lambda ()
                                (if (not (view-get-active-target))
                                    (start 'debug (the-as basic #f) 0)
                                    )
                                (send-event (view-get-active-target) 'change-mode 'flut #f)
                                )
                   )
         (function "indax" #f ,(lambda ()
                                 (if (not (view-get-active-target))
                                     (start 'debug (the-as basic #f) 0)
                                     )
                                 (send-event (view-get-active-target) 'change-mode 'indax #f)
                                 )
                   )
         (function "invisible" #f ,(lambda ()
                                     (if (not (view-get-active-target))
                                         (start 'debug (the-as basic #f) 0)
                                         )
                                     (logior! (-> *game-info* features) 2048)
                                     (logior! (-> *game-info* debug-features) 2048)
                                     (send-event (view-get-active-target) 'change-mode 'invisible #f)
                                     )
                   )
         )
       (flag "Game" #f ,(lambda ((arg0 object) (arg1 debug-menu-msg))
                          (when (= arg1 (debug-menu-msg press))
                            (let ((v1-3 (-> *game-info* mode)))
                              (set! (-> *game-info* mode) (cond
                                                            ((= v1-3 'play)
                                                             'debug
                                                             )
                                                            ((= v1-3 'debug)
                                                             'play
                                                             )
                                                            (else
                                                              (-> *game-info* mode)
                                                              )
                                                            )
                                    )
                              )
                            )
                          (= (-> *game-info* mode) 'play)
                          )
             )
       (function "Clean" #f ,(lambda ()
                               (if (time-of-day-setup #f)
                                   (time-of-day-setup #t)
                                   )
                               (play-clean #f)
                               )
                 )
       (flag "Stats" *stats-target* dm-boolean-toggle-pick-func)
       (function "Reset" #f ,(lambda () (reset-actors 'debug)))
       (function
         "Start"
         #f
         ,(lambda () (start 'play (-> *game-info* player-info (view-get-active-index) current-continue) 0))
         )
       (function
         "Editor"
         #f
         ,(lambda ()
            (kill-by-type editable-player *active-pool*)
            (process-spawn editable-player :init editable-player-init #f :name "editable-player" :to *entity-pool*)
            (set-master-mode 'game)
            )
         )
       )
    )
  arg0
  )

;; og:preserve-this debug-segment guard (runtime-falsified, tip smoke): both
;; calls below build their whole menu tree by allocating debug-menu and
;; debug-menu-item-* objects on the 'debug kheap (same class as the two
;; context constructions above; see editable-player.gc's
;; *editable-menu-context* note for the full C++ citation), unconditionally
;; and regardless of arg0's own value, so guarding just the two contexts
;; above is not enough on its own; skipped entirely on a non-debug boot.
(when *debug-segment*
  ;; failed to figure out what this is:
  (debug-menu-context-make-default-menus *debug-menu-context*)

  ;; failed to figure out what this is:
  (popup-menu-context-make-default-menus *popup-menu-context*)
  )

;; definition for function menu-respond-to-pause
(defun menu-respond-to-pause ()
  (case *master-mode*
    (('menu)
     (cond
       ((and (cpad-hold? 0 l3) (cpad-hold? 0 select))
        (debug-menu-context-send-msg *popup-menu-context* (debug-menu-msg activate) (debug-menu-dest activation))
        (debug-menu-context-send-msg *debug-menu-context* (debug-menu-msg deactivate) (debug-menu-dest activation))
        (debug-menu-context-send-msg *editable-menu-context* (debug-menu-msg deactivate) (debug-menu-dest activation))
        )
       ((and (cpad-hold? 1 start) *editable*)
        (debug-menu-context-send-msg *editable-menu-context* (debug-menu-msg activate) (debug-menu-dest activation))
        (debug-menu-context-send-msg *debug-menu-context* (debug-menu-msg deactivate) (debug-menu-dest activation))
        (debug-menu-context-send-msg *popup-menu-context* (debug-menu-msg deactivate) (debug-menu-dest activation))
        )
       ((and (cpad-hold? 0 l3) (cpad-hold? 0 start))
        (debug-menu-context-send-msg *debug-menu-context* (debug-menu-msg activate) (debug-menu-dest activation))
        (debug-menu-context-send-msg *popup-menu-context* (debug-menu-msg deactivate) (debug-menu-dest activation))
        (debug-menu-context-send-msg *editable-menu-context* (debug-menu-msg deactivate) (debug-menu-dest activation))
        )
       )
     )
    (else
      (debug-menu-context-send-msg *debug-menu-context* (debug-menu-msg deactivate) (debug-menu-dest activation))
      (debug-menu-context-send-msg *popup-menu-context* (debug-menu-msg deactivate) (debug-menu-dest activation))
      (debug-menu-context-send-msg *editable-menu-context* (debug-menu-msg deactivate) (debug-menu-dest activation))
      )
    )
  #f
  )

;; definition for function *menu-hook*
;; og:preserve-this debug-segment guard (runtime-falsified, tip smoke): this
;; hook runs every frame regardless of debug-segment (main.gc's own
;; (*menu-hook*) call carries no guard of its own), and
;; debug-menus-handler's own body dereferences its argument unconditionally
;; ((-> arg0 is-active), goal_src/jakx/engine/debug/menu.gc:1659), so calling
;; it with either context now possibly #f (see this file's own
;; *debug-menu-context*/*popup-menu-context* guards above) needs a truthiness
;; check here rather than inside debug-menus-handler itself, which is
;; unowned by this rung and shared with jak3's identical twin.
(defun *menu-hook* ()
  (when *debug-menu-context*
    (debug-menus-handler *debug-menu-context*)
    )
  (when *popup-menu-context*
    (debug-menus-handler *popup-menu-context*)
    )
  )

