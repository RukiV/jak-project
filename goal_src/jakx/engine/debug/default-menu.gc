           (function "Print Load State" #f ,(lambda ()
                                              (dotimes (gp-0 19)
                                                (let ((s5-0 (-> *level* level gp-0)))
                                                  (if (!= (-> s5-0 status) 'inactive)
                                                      (format
                                                        #t
                                                        "~Tlevel ~2D ~16S ~16S bits #b~18,'0B ~A~%"
                                                        gp-0
                                                        (-> s5-0 name)
                                                        (if (nonzero? (-> s5-0 info))
                                                            (level-memory-mode->string (-> s5-0 info memory-mode))
                                                            )
                                                        (-> s5-0 memory-mask)
                                                        (-> s5-0 status)
                                                        )
                                                      )
                                                  )
                                                )
                                              #t
                                              )
                     )
