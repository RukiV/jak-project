;; test/offline/config/jakx/config.jsonc skip_compile_functions for the
;; matching raw-decode compile skip); the anim-tester speed menu item that
;; calls it reports its fallback rather than the retail behavior.
(defun dm-subdiv-int ((arg0 symbol) (arg1 debug-menu-msg) (arg2 int) (arg3 int))
  arg3
  )

