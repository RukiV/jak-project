                                    (send-event (view-get-active-target) 'change-mode 'flut #f)
                                    )
                       )
             (function "mech" #f ,(lambda ()
                                    (if (not (view-get-active-target))
                                        (start 'debug (the-as basic #f) 0)
                                        )
                                    (send-event (view-get-active-target) 'change-mode 'mech #f)
                                    )
                       )
             (function "indax" #f ,(lambda ()
                                     (if (not (view-get-active-target))
                                         (start 'debug (the-as basic #f) 0)
                                         )
                                     (send-event (view-get-active-target) 'change-mode 'indax #f #f)
                                     )
                       )
             (function "invisible" #f ,(lambda ()
                                         (if (not (view-get-active-target))
                                             (start 'debug (the-as basic #f) 0)
                                             )
                                         (logior! (-> *game-info* features) 2048)
                                         (logior! (-> *game-info* debug-features) 2048)
                                         (send-event (view-get-active-target) 'change-mode 'invisible #f)
                                         )
                       )
             )
           (flag "Target Stats" *stats-target* dm-boolean-toggle-pick-func)
           (flag "Disable Bot" *disable-bot* dm-boolean-toggle-pick-func)
           (flag "Slow Frame Rate" *slow-frame-rate* dm-boolean-toggle-pick-func)
