;; og:preserve-this dropped the jak3 #when PC_PORT pc-filter-debug-string? gate
;; (#174): that filter hook does not exist anywhere in jakx (grepped the tree,
;; no hits), and jakx has no PC-settings subsystem yet (same gap the sparticle-
;; launcher.gc:1502 og-note already documents for a sibling PC-only cull). The
;; text always draws when enabled instead of being distance-filtered.
(defun-debug add-debug-text-3d ((enable symbol) (bucket bucket-id) (text string) (pos vector) (color font-color) (offset vector2h))
  "Draw debug text."
  (when (and enable (not *display-capture-mode*))
    (cond
      (*debug-draw-pauseable*
        (let ((v1-4 (get-debug-text-3d)))
          (when v1-4
            (set! (-> v1-4 flags) 0)
            (set! (-> v1-4 bucket) (the-as int32 bucket))
            (vector-copy! (-> v1-4 pos) pos)
            (cond
              (offset
                (set! (-> v1-4 offset x) (-> offset x))
                (set! (-> v1-4 offset y) (-> offset y))
                )
              (else
                (set! (-> v1-4 offset x) 0)
                (set! (-> v1-4 offset y) 0)
                0
                )
              )
            (set! (-> v1-4 color) (the-as uint8 color))
            (let ((a0-6 0)
                  (a1-2 (-> text data))
                  (v1-6 (-> v1-4 str data))
                  )
              (while (and (nonzero? (-> a1-2 0)) (< a0-6 79))
                (set! (-> v1-6 0) (-> a1-2 0))
                (set! a1-2 (&-> a1-2 1))
                (set! v1-6 (&-> v1-6 1))
                (+! a0-6 1)
                )
              (set! (-> v1-6 0) (the-as uint 0))
              )
            0
            )
          )
        )
      (else
        (internal-draw-debug-text-3d bucket text pos color (cond
                                                             (offset
                                                               (empty)
                                                               offset
                                                               )
                                                             (else
                                                               (new 'static 'vector2h)
                                                               )
                                                             )
                                     )
        )
      )
    )
  #f
  )

