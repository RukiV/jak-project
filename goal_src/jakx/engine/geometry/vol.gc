;;-*-Lisp-*-
(in-package goal)

;; name: vol.gc
;; name in dgo: vol
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

;; definition for function plane-volume-intersect-dist
(defun plane-volume-intersect-dist ((arg0 vector) (arg1 vector) (arg2 vector))
  (let ((f0-1 (vector-dot arg1 arg0))
        (f1-1 (vector-dot arg2 arg0))
        )
    (if (< 0.00001 (fabs f1-1))
        (/ (- (-> arg0 w) f0-1) f1-1)
        409600000.0
        )
    )
  )

;; og:preserve-this method 9 of type plane-volume is deferred, not landed. The
;; decompiler's own fallback body is not valid GOAL (local-vars typed object/int
;; throughout, the same non-compiling shape as output-race-mesh's deferred body).
;; Progress made this rung: the six-then-eight-slot polytope-corner scratch array at
;; sp+16 through sp+128 (stack_structures.jsonc) resolved every "Failed to guess
;; stack use" error, but expression building still fails past that point with
;; "Floating point division attempted on invalid types" at a (/ 1.0 (the float
;; s0-0)) whose operand types the raw annotations already show correctly (a1: float,
;; s0: int, f1 after cvt.s.w: float); this looks like an expression-builder defect
;; past pure stack typing, not fixable with the levers this rung has evidence for.
;; Retire this note once the division site resolves or a decompiler fix lands.
;;   (defmethod plane-volume-method-9 ((this plane-volume) (arg0 symbol) (arg1 vector-array) (arg2 vector-array))
;;     ...
