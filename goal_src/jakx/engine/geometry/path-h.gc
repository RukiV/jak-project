;;-*-Lisp-*-
(in-package goal)

;; name: path-h.gc
;; name in dgo: path-h
;; dgos: ENGINE, GAME

;; +++path-control-flag
(defenum path-control-flag
  :bitfield #t
  :type uint32
  (display 0)
  (draw-line 1) ;; TODO - only seen it used to control debug drawing so far
  (draw-point 2) ;; TODO - only seen it used to control debug drawing so far
  (draw-text 3) ;; TODO - only seen it used to control debug drawing so far
  (not-found 4)
  )
;; ---path-control-flag


;; DECOMP BEGINS

(defun get-knot-name ((arg0 symbol))
  (case arg0
    (('path)
     'path-k
     )
    (('flow)
     'flow-k
     )
    (('intro)
     'intro-k
     )
    (('pathshort)
     'pathshort-k
     )
    (('patha)
     'patha-k
     )
    (('pathb)
     'pathb-k
     )
    (else
      (format
        0
        "WARNING: curve-control is being asked to look up an unknown name '~A', it will have to do so by string.~%"
        arg0
        )
      (let ((s5-0 string->symbol))
        (format (clear *temp-string*) "~A-k" arg0)
        (s5-0 *temp-string*)
        )
      )
    )
  )

(defun get-distmap-name ((arg0 symbol))
  (case arg0
    (('path)
     'path-distmap
     )
    (('intro)
     'intro-distmap
     )
    (else
      #f
      )
    )
  )

(deftype path-control (basic)
  "The path-control is a reference a path data, which is just a list of points.
Although it contains a `curve`, the knot part is not populated, so it's just treated as
a bunch of line segments from the control points.
The child class curve-control does fill out the knot data and is a proper b-spline.
These path-controls are typically allocated on a process heap."
  ((flags       path-control-flag)
   (name        symbol)
   (process     process-drawable)
   (distmap     uint32)
   (curve       curve   :inline)
   (num-cverts  int32   :overlay-at (-> curve num-cverts))
   (cverts      uint32  :overlay-at (-> curve cverts))
   )
  (:methods
    (new (symbol type process symbol float entity symbol) _type_)
    ;; og:preserve-this renamed from path-control-method-9: path.gc's own ir2
    ;; decodes this identically for path-control and curve-control alike
    ;; (add-debug-text-3d / add-debug-line / add-debug-x gated on
    ;; *display-path-marks*), matching jak3's debug-draw body one for one.
    (debug-draw (_type_) none)
    ;; og:preserve-this jakx slot verified at the collide-shape.o
    ;; shove-to-closest-point-on-path call site (a1=stack vector out, a2=float index,
    ;; a3='interp), matching jak3's get-point-in-path! signature
    (get-point-in-path! (_type_ vector float symbol) vector)
    ;; og:preserve-this renamed from path-control-method-11: path.gc's ir2
    ;; stores arg0 with s.q! (a full vector quadword), matching jak3's
    ;; get-random-point body exactly.
    (get-random-point (_type_ vector) vector)
    ;; og:preserve-this jakx slot verified against path.gc's ir2 (both
    ;; path-control and curve-control variants read arg0/arg1/arg2 as
    ;; vector/float/float and forward into method 32), matching jak3's
    ;; path-control-method-12 signature.
    (path-control-method-12 (_type_ vector float float) vector)
    (path-control-method-13 (_type_ vector float) vector)
    ;; og:preserve-this renamed from path-control-method-14: path.gc's ir2
    ;; reads a3 (the symbol arg) on the path-control variant ("Function may
    ;; read a register that is not set: a3" against the old 2-arg
    ;; declaration), matching jak3's get-point-at-percent-along-path! sig.
    (get-point-at-percent-along-path! (_type_ vector float symbol) vector)
    ;; og:preserve-this jakx slot verified against path.gc's ir2 (both
    ;; variants read this/arg0/arg1/arg2 as vector/float/float and forward
    ;; via method-of-object), matching jak3's path-control-method-15 sig.
    (path-control-method-15 (_type_ vector float float) vector)
    ;; og:preserve-this renamed from path-control-method-16: path.gc's ir2
    ;; shows the path-control variant forwarding to method 13 with a scaled
    ;; float arg1 ("Function may read a register that is not set: a2"
    ;; against the old 1-arg declaration), matching jak3's
    ;; displacement-between-points-at-percent-normalized! sig.
    (displacement-between-points-at-percent-normalized! (_type_ vector float) vector)
    (get-num-segments (_type_) float)
    ;; og:preserve-this jakx slot renamed from path-control-method-18: movie-
    ;; path-method-16 (movie-path.gc) converts its gpr->fpr result straight
    ;; to a float divisor, matching all-types.gc's own trailing signature
    ;; comment for this slot ("failed type prop... Floating point division
    ;; attempted on invalid types" against the stale () none declaration)
    (total-distance (_type_) float)
    (get-num-verts (_type_) int)
    (segement-duration->path-duration (_type_ float) float)
    (average-segment-length (_type_ float) float)
    (path-control-method-22 (_type_ vector) float)
    (path-control-method-23 (_type_ vector) float)
    (path-control-method-24 (_type_ vector) float)
    (path-control-method-25 (_type_ vector) float)
    ;; og:preserve-this jakx slot verified against path.gc's ir2 (arg0/arg1
    ;; are read via gpr->fpr immediately on entry, no field deref), matching
    ;; jak3's path-control-method-26 float/float sig, not the stale
    ;; object/object one.
    (path-control-method-26 (_type_ float float) float)
    ;; og:preserve-this jakx slot verified against path.gc's ir2 (arg0 is
    ;; read/written as a full vector; op 56's l.f load against the old
    ;; object-typed arg0 is what produced "failed type prop"), matching
    ;; jak3's vector/vector sig. jak3 keeps this name generic too.
    (path-control-method-27 (_type_ vector) vector)
    ;; og:preserve-this jakx slot verified against path.gc's ir2 (arg0/arg1
    ;; vector, arg2 symbol, return float via a division), matching jak3's
    ;; path-control-method-28 sig.
    (path-control-method-28 (_type_ vector vector symbol) float)
    (path-control-method-29 (_type_ vector int float) float)
    ;; og:preserve-this jakx-only slot, no jak3 twin: path.gc's ir2 shows this
    ;; reads only `this`, walks method 14 (get-point-at-percent-along-path!)
    ;; across 129 evenly spaced curve samples to build an arc-length table,
    ;; normalizes it, then inverts it into distmap (the raw offset-12/
    ;; declared-offset-16 float array, +4 basic-tag trap) so distmap maps
    ;; distance-fraction back to curve parameter; called unconditionally from
    ;; `new path-control`/`new curve-control` below now that path.gc lands it.
    (path-control-method-30 (_type_) none)
    (should-display-marks? (_type_) symbol)
    ;; og:preserve-this renamed from path-control-method-32: path.gc's ir2
    ;; matches jak3's displacement-between-two-points! body one for one for
    ;; the path-control variant (vector-reset!/vector-!/vector-float*!
    ;; sequence inlined as raw VU ops); the curve-control override at this
    ;; same slot uses curve-evaluate! instead, matching jak3's curve-control
    ;; override of the same virtual slot.
    (displacement-between-two-points! (_type_ vector float float) vector)
    )
  )


(set! (-> path-control method-table 9) nothing)

(deftype curve-control (path-control)
  "A curve-control is like a path control, but it has both control points and knot points."
  ()
  (:methods
    (new (symbol type process symbol res-lump symbol float) _type_)
    ;; og:preserve-this jakx-only slot, no jak3 twin: path.gc's ir2 shows this
    ;; reads this/arg0 (vector)/arg2 (float) but never touches arg1,
    ;; forwarding (this arg0 (/ arg2 (the float (+ (-> this curve num-cverts)
    ;; -1)))) into method 34 (curve-evaluate!-based displacement), then
    ;; vector-normalize!s arg0 -- the same wrapper shape as slot 13's
    ;; curve-control override of displacement-between-two-points-normalized!
    ;; (which forwards into slot 16), duplicated here against slot 34 instead
    ;; of slot 16. Movie-path.gc's own call site passes (rot path-pos 1.0), so
    ;; arg1 is declared float to match the caller even though this body never
    ;; reads it.
    (curve-control-method-33 (_type_ vector float float) none)
    ;; og:preserve-this jakx-only slot, no jak3 twin: path.gc's ir2 for this
    ;; slot is a verbatim duplicate of the curve-control override of slot 32
    ;; (displacement-between-two-points!, curve-evaluate!-based), compiled as
    ;; a second, separately addressed copy rather than a shared vtable entry.
    (curve-control-method-34 (_type_ vector float float) vector)
    )
  )


;; ERROR: Stack slot load at 64 mismatch: defined as size 4, got size 16
;; ERROR: Stack slot load at 64 mismatch: defined as size 4, got size 16
;; WARN: Return type mismatch object vs path-control.
(defmethod new path-control ((allocation symbol)
                           (type-to-make type)
                           (arg0 process)
                           (arg1 symbol)
                           (arg2 float)
                           (arg3 entity)
                           (arg4 symbol)
                           )
  (let ((sv-64 arg2)
        (s4-0 arg3)
        (sv-48 arg4)
        )
    (if (not s4-0)
        (set! s4-0 (-> arg0 entity))
        )
    (when (= arg1 'path)
      ;; og:preserve-this bring-up guard: entity-actor-lookup's body is in the
      ;; unlanded actor-link leg, so the symbol reads 0. Skip the path-actor
      ;; redirect until it lands (paths then come from the entity itself).
      (when (nonzero? entity-actor-lookup)
        (let ((v0-0 (entity-actor-lookup s4-0 'path-actor 0)))
          (if v0-0
              (set! s4-0 v0-0)
              )
          )
        )
      )
    (let ((s5-0 (the-as object 0)))
      (let* ((s2-0 #f)
             (sv-16 (new 'static 'res-tag))
             (sv-80 (res-lump-data s4-0 arg1 pointer :tag-ptr (& sv-16) :time sv-64))
             )
        (cond
          (sv-80
            (set! s5-0 (object-new allocation type-to-make (the-as int (-> type-to-make size))))
            (set! (-> (the-as path-control s5-0) distmap) (the-as uint #f))
            (cond
              ((nonzero? (the-as path-control s5-0))
               (set! (-> (the-as path-control s5-0) process) (the-as process-drawable arg0))
               (set! (-> (the-as path-control s5-0) name) arg1)
               (set! (-> (the-as path-control s5-0) curve cverts) (the-as (inline-array vector) sv-80))
               (set! (-> (the-as path-control s5-0) curve num-cverts) (the-as int (-> sv-16 elt-count)))
               (cond
                 ((= arg1 'path)
                  (set! s2-0 'path-distmap)
                  )
                 ((= arg1 'path-intro)
                  (set! s2-0 'path-intro-distmap)
                  )
                 )
               ;; og:preserve-this decomp fix: degraded tag-ptr slot (16-byte write-back
               ;; through an 8-byte int slot); static res-tag per the jak3 idiom
               (let* ((sv-32 (new 'static 'res-tag))
                      (v0-3 (res-lump-data s4-0 s2-0 pointer :tag-ptr (& sv-32)))
                      )
                 (when v0-3
                   (set! (-> (the-as path-control s5-0) distmap) (the-as uint v0-3))
                   ;; og:preserve-this bring-up guard retired: path.gc now lands method 30
                   ;; (distmap fill), so the slot is called unconditionally again.
                   ((method-of-object (the-as path-control s5-0) path-control-method-30) (the-as path-control s5-0))
                   )
                 )
               )
              (else
                (go process-drawable-art-error "memory")
                )
              )
            )
          (else
            (when (not sv-48)
              (set! s5-0 (object-new allocation type-to-make (the-as int (-> type-to-make size))))
              (set! (-> (the-as path-control s5-0) distmap) (the-as uint #f))
              (cond
                ((nonzero? (the-as path-control s5-0))
                 (logior! (-> (the-as path-control s5-0) flags) (path-control-flag not-found))
                 (set! (-> (the-as path-control s5-0) process) (the-as process-drawable arg0))
                 (set! (-> (the-as path-control s5-0) name) arg1)
                 (set! (-> (the-as path-control s5-0) curve cverts) (the-as (inline-array vector) #f))
                 (set! (-> (the-as path-control s5-0) curve num-cverts) 0)
                 0
                 )
                (else
                  (go process-drawable-art-error "memory")
                  )
                )
              )
            )
          )
        )
      (the-as path-control s5-0)
      )
    )
  )

(defmethod should-display-marks? ((this path-control))
  (and *display-path-marks* (logtest? (-> this flags) (path-control-flag display)))
  )

(defmethod get-num-segments ((this path-control))
  (the float (+ (-> this curve num-cverts) -1))
  )

(defmethod get-num-verts ((this path-control))
  (-> this curve num-cverts)
  )

(defmethod segement-duration->path-duration ((this path-control) (arg0 float))
  (* arg0 (get-num-segments this))
  )

(defmethod average-segment-length ((this path-control) (arg0 float))
  (/ arg0 (get-num-segments this))
  )

;; ERROR: Stack slot load at 80 mismatch: defined as size 4, got size 16
;; ERROR: Stack slot load at 80 mismatch: defined as size 4, got size 16
;; WARN: Return type mismatch object vs curve-control.
(defmethod new curve-control ((allocation symbol)
                            (type-to-make type)
                            (arg0 process)
                            (arg1 symbol)
                            (arg2 res-lump)
                            (arg3 symbol)
                            (arg4 float)
                            )
  (local-vars (r0-0 uint128) (v1-17 uint128))
  (let ((sv-64 arg3)
        (sv-80 arg4)
        )
    (if (not arg2)
        (set! arg2 (-> arg0 entity))
        )
    (when (= arg1 'path)
      ;; og:preserve-this bring-up guard: see the path-control new note above
      (when (nonzero? entity-actor-lookup)
        (let ((v0-0 (entity-actor-lookup arg2 'path-actor 0)))
          (if v0-0
              (set! arg2 v0-0)
              )
          )
        )
      )
    (let ((s5-0 (the-as object 0)))
      (let* ((s4-0 (get-distmap-name arg1))
             (sv-112 (get-knot-name arg1))
             (sv-16 (new 'static 'res-tag))
             (sv-96 (res-lump-data arg2 arg1 pointer :tag-ptr (& sv-16) :time sv-80))
             )
        (cond
          (sv-96
            (set! s5-0 (object-new allocation type-to-make (the-as int (-> type-to-make size))))
            (set! (-> (the-as curve-control s5-0) distmap) (the-as uint #f))
            (cond
              ((nonzero? (the-as curve-control s5-0))
               (set! (-> (the-as curve-control s5-0) process) (the-as process-drawable arg0))
               (set! (-> (the-as curve-control s5-0) name) arg1)
               (set! (-> (the-as curve-control s5-0) curve cverts) (the-as (inline-array vector) sv-96))
               (set! (-> (the-as curve-control s5-0) curve num-cverts) (the-as int (-> sv-16 elt-count)))
               ;; og:preserve-this decomp fix: degraded tag-ptr slot; static res-tag plus
               ;; the elt-count field read replacing the pcpyud upper-dword dance
               (let* ((sv-32 (new 'static 'res-tag))
                      (v0-5 (res-lump-data arg2 sv-112 pointer :tag-ptr (& sv-32)))
                      )
                 (when v0-5
                   (set! (-> (the-as curve-control s5-0) curve knots) (the-as (pointer float) v0-5))
                   (set! (-> (the-as curve-control s5-0) curve num-knots) (the-as int (-> sv-32 elt-count)))
                   )
                 )
               ;; og:preserve-this decomp fix: degraded tag-ptr slot; static res-tag
               (let* ((sv-48 (new 'static 'res-tag))
                      (v0-6 (res-lump-data arg2 s4-0 pointer :tag-ptr (& sv-48)))
                      )
                 (when v0-6
                   (set! (-> (the-as curve-control s5-0) distmap) (the-as uint v0-6))
                   ;; og:preserve-this bring-up guard retired: see the path-control site above
                   ((method-of-object (the-as curve-control s5-0) path-control-method-30) (the-as curve-control s5-0))
                   )
                 )
               )
              (else
                (go process-drawable-art-error "memory")
                )
              )
            )
          (else
            (when (not sv-64)
              (set! s5-0 (object-new allocation type-to-make (the-as int (-> type-to-make size))))
              (set! (-> (the-as curve-control s5-0) distmap) (the-as uint #f))
              (cond
                ((nonzero? (the-as curve-control s5-0))
                 (logior! (-> (the-as curve-control s5-0) flags) (path-control-flag not-found))
                 (set! (-> (the-as curve-control s5-0) process) (the-as process-drawable arg0))
                 (set! (-> (the-as curve-control s5-0) name) arg1)
                 (set! (-> (the-as curve-control s5-0) curve cverts) (the-as (inline-array vector) #f))
                 (set! (-> (the-as curve-control s5-0) curve num-cverts) 0)
                 0
                 )
                (else
                  (go process-drawable-art-error "memory")
                  )
                )
              )
            )
          )
        )
      (the-as curve-control s5-0)
      )
    )
  )
