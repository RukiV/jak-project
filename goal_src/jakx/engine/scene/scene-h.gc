;;-*-Lisp-*-
(in-package goal)

;; name: scene-h.gc
;; name in dgo: scene-h
;; dgos: ENGINE, GAME

;; +++scene-flags
(defenum scene-flags
  :bitfield #t
  :type uint32
  (scf0 0)
  (scf1 1)
  (scf2 2)
  (scf3 3)
  (scf4 4)
  (scf5 5)
  (scf6 6)
  (scf7 7)
  (scf8 8)
  (scf9 9)
  (scf10 10)
  (scf11 11)
  (scf12 12)
  (scf13 13)
  (scf14 14)
  (scf15 15)
  )
;; ---scene-flags

;; forward declare: scene-actor's method 9 (setup-manipy-for-scene!) takes
;; a scene-player arg, but scene-player itself is not deftype'd until below.
(declare-type scene-player process-drawable)

;; og:preserve-this forward declare: scene lane (issue 502). (code play-
;; anim scene-player)'s own body reads *rigid-body-queue-manager*, but
;; rigid-body-queue.gc (which defines it) compiles after scene.gc in this
;; worktree's own build order, unlike jak3's twin body (goal_src/jak3/
;; engine/scene/scene.gc), whose own build order apparently has it the
;; other way and needs no forward declare at all.
(declare-type rigid-body-queue-manager process)
(define-extern *rigid-body-queue-manager* rigid-body-queue-manager)

;; og:preserve-this forward declare: scene lane (issue 502). (code play-
;; anim scene-player)'s own body calls task-node-open! on the scene's own
;; scene-task field; game-task-h.gc (which would otherwise declare this
;; free function) carries no define-extern for it at all yet, matching
;; this worktree's own decompiler config entry (decompiler/config/jakx/
;; all-types.gc), which already carries the real signature.
(define-extern task-node-open! (function game-task-node symbol int))

;; DECOMP BEGINS

(deftype scene-actor (basic)
  ((name                 string)
   (level                symbol)
   (art-group            string)
   (prefix               string)
   (draw-frames          pair)
   (scissor-frames       pair)
   (shadow-frames        pair)
   (cloth-reset-frames   pair)
   (cloth-commands       pair)
   (camera               int16)
   (light-index          uint8)
   (shadow-mask          uint8)
   (shadow-values        uint32)
   (flags                uint32)
   (command-list         pair)
   (shadow-flags         int32)
   (shadow-volume-joint  basic)
   (draw-seg             uint64)
   (no-draw-seg          uint64)
   (last-frame           float)
   (process              handle)
   )
  (:methods
    (setup-manipy-for-scene! (_type_ scene-player) (pointer process))
    )
  )


(deftype scene (art-group)
  ((scene-flags       scene-flags)
   (mask-to-clear     process-mask)
   (entity            string)
   (art-group         string)
   (anim              string)
   (parts             int32)
   (command-list      pair)
   (cut-list          pair)
   (wait-max-time     time-frame)
   (wait-air-time     time-frame)
   (wait-ground-time  time-frame)
   (actor             (array scene-actor))
   (load-point        basic)
   (end-point         basic)
   (borrow            pair)
   (sfx-volume        float)
   (ambient-volume    float)
   (music-volume      float)
   (music-delay       float)
   (scene-task        uint16)
   (on-running        pair)
   (on-complete       pair)
   ;; og:preserve-this vehicles retyped (array symbol) (was basic, then
   ;; briefly (array uint32) before this fix): scene lane (issue 502).
   ;; (enter wait scene-player)'s own dotimes bound check reads (->
   ;; vehicles length) and the loop body indexes (-> vehicles data gp)
   ;; with a 4-byte stride (dsll gp 2) and an unsigned 4-byte load (lwu),
   ;; matching either a uint32 or symbol element (both are 4-byte
   ;; unsigned); that same call site immediately re-casts the read value
   ;; with (the-as symbol ...), and the static scene tables in
   ;; intro-scenes2.gc construct this exact field with (new 'static
   ;; 'boxed-array :type symbol '(mongl)) (a vehicle-name symbol list),
   ;; which is what forced the correction: (array uint32) fails to
   ;; typecheck against that literal ("(array symbol) when expecting
   ;; (array uint32)"). No jak3 twin (scene has no vehicles/ipu fields
   ;; there at all, jakx-original).
   (vehicles          (array symbol))
   (ipu               basic)
   )
  (:methods
    (init-spool-by-scene! (_type_ spool-anim) spool-anim)
    (load-scene (_type_) scene)
    )
  )


(deftype scene-player (process-drawable)
  ((scene-list            (array scene))
   (scene                 scene)
   (scene-index           int32)
   (anim                  spool-anim)
   (next-anim             spool-anim)
   (camera                handle)
   (main-entity           entity-actor)
   (wait                  symbol)
   (old-target-pos        transformq  :inline)
   (pre-cut-frame         basic)
   (preload-continue      string)
   (preload-sound         basic)
   (dma-max               uint32)
   (gui-id                sound-id)
   (aborted?              symbol)
   (scene-start-time      time-frame)
   (targ-speed            float)
   (cur-speed             float)
   (speed-change-time     time-frame)
   (speed-press-time      time-frame)
   (speed-change-speed    float)
   (subtitle-change-time  time-frame)
   (user-sound            sound-id    4)
   (last-frame            float)
   (end-point             basic)
   (blackout-end          basic)
   (new-trans-hook        (function none))
   (cur-trans-hook        (function none))
   (user-data             uint64)
   )
  (:state-methods
    (wait symbol)
    release
    play-anim
    )
  (:methods
    (scene-player-method-53 (_type_ string symbol) none)
    (scene-player-method-54 (_type_ scene symbol) scene)
    (scene-player-method-55 (_type_ float float) none)
    )
  )


(define *scene-player* (the-as (pointer scene-player) #f))

(define *debug-menu-scene-play* #f)

(defmethod load-scene ((this scene))
  (let ((v1-1 (-> *level* loading-level)))
    (if v1-1
        (set-loaded-art (-> v1-1 art-group) this)
        )
    )
  this
  )
