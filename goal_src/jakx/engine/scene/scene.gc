            (cond
              ((or (string= (-> this name) "jak-highres")
                   (string= (-> this name) "jak-highres-prison")
                   (string= (-> this name) "darkjak-highres")
                   )
               'jakb
               )
              ((string= (-> this name) "jakc-highres")
