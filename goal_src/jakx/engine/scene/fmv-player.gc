;; og:preserve-this
;; movie-texture-anim-init (issue 762): port workaround. Retail's
;; real body (fmv-player.asm L230, this rung's scoped decode)
;; is (texture-anim-override-size-init self) followed by zeroing
;; *fmv-work*+48, fmv-work's own dma-addr field (all-types.gc's landed
;; fmv-work deftype, offset-assert 48) that movie-texture-anim-func (held,
;; below) also reads. That second half is dropped here: *fmv-work* is
;; still only a provisional object-typed extern (all-types.gc, "call-site
;; evidence only") that no landed code allocates, so the store was a
;; null write through guarded address 0x30 that crashed the MENU2 DGO
;; link the moment texture-anim's init-textures! walk dispatched this
;; function as *menu-movie-texture-anim-array* entry 0's :init-func-id
;; (issue 762). The field is PS2-DMA-only with no PC consumer, the same
;; rationale that already holds movie-texture-anim-func below. Only
;; (texture-anim-override-size-init arg0) survives, since it is the
;; PC-relevant half: it sizes the iscreen-video-dest destination texture
;; TextureAnimator actually publishes into. Retires alongside a landed
;; *fmv-work* allocation with a real PS2-DMA consumer, which this port does
;; not need since TextureAnimator's handle_fmv_frame already replaces it.
(defun movie-texture-anim-init ((arg0 texture-anim))
  (texture-anim-override-size-init arg0)
  0
  )

;; og:preserve-this HELD (issue 762): movie-texture-anim-func
;; (fmv-player.asm/ir2.asm L226-L229, ops 0-21, this rung's scoped decode) is
;; a raw PS2 GIF/DMA-tag emitter with no PC counterpart -- it reads *fmv-
;; work*+48 (the same dma-addr flag movie-texture-anim-init clears above) to
;; decide whether to zero the caller's buffer word for *movie-texture-anim-
;; array* specifically (ops 3-6), then unconditionally packs a tag word
;; (#x50000000 logior ((num-layers << 33) >> 1), an EOP+PRE-flagged qword
;; count) into the caller dma-buffer's own tag slot and advances its cursor
;; 16 bytes (ops 7-16); the *movie-texture-anim-array*-mismatch fallback
;; (ops 18-21) just pokes a bare 2 into the buffer instead. TextureAnimator's
;; own C++ path (handle_fmv_frame) publishes decoded MJV frames directly and
;; never walks a DMA chain for this array, so there is nothing on the PC
;; side for this function to drive. Left as a bare :func-id symbol reference
;; above (the same shape car-texture-anim-layer-func uses in
;; texture-anim-tables.gc); retires alongside a real PS2-DMA-chain consumer,
;; which does not exist on this port.

;; fmv-player-run-texture (issue 762) is landed for real below, after
;; fmv-player-init-by-other -- process-spawn needs its :init callee already
;; defined in this file (GOAL does not hoist forward references to same-file
;; globals), the same constraint that already places fmv-player-run itself
;; after init-by-other rather than up here. Its own og:preserve-this banner
;; is there. The bring-up stub that used to live here (issue 551,
;; extern-no-defun class) retired the moment the real body landed: the live
;; call site (scene.gc:1195, (enter wait scene-player)'s (when (-> self
;; scene ipu) ...) branch) now runs the real port instead of returning #f.

;; ============================================================================
;; L2 FMV frame path (issue 569): the TBP allocation, the fullscreen quad, and a
;; REPL probe that emits one code-87 (fmv-frame) record for a given elapsed-ms.
;; This is the C++-reader landing; the real fmv-player process (init-by-other,
;; playing/die states, clock, pad-skip) is L3's. See TextureAnimator.cpp's
;; handle_fmv_frame and MjvVideoReader.{h,cpp} for the runtime side.
;; ============================================================================

;; og:preserve-this
;; The sentinel tbp doubles as the fmv-frame record's dest field and the quad's
;; tex0.tbp0 -- both sides must name the same value. An early design draft used a
;; fixed constant (#x10000): wrong and unsafe, since gs-tex0's tbp0 is a 14-bit
;; field on both sides (gs.gc:634, common/dma/gs.h:270) and truncates #x10000 to 0
;; the instant it packs into a real adgif, while TexturePool::m_textures is a fixed
;; 32768-entry array with no bounds check in move_existing_to_vram
;; (TexturePool.h:376, TexturePool.cpp:94-97) -- 65536 would be an out-of-bounds
;; write the moment force-to-gpu publishes it. allocate-blocks (the cloud-clut
;; precedent at texture-anim.gc:3113) gives a real, unique VRAM key instead; the L1
;; spike measured it deterministic at 896 across two boot sessions (issue 569
;; comment).
(define *fmv-tbp* (the-as uint 0))

(defun fmv-get-tbp ()
  "Lazily allocate the FMV sentinel tbp on first use (needs *level* loaded, so
   this cannot run at file-load time)."
  (when (zero? *fmv-tbp*)
    (set! *fmv-tbp*
          (the-as uint (allocate-blocks (-> *level* level-default texture-page-dir 9 page) 128))
          )
    )
  *fmv-tbp*
  )

;; og:preserve-this
;; Fullscreen quad sampling the FMV sentinel tbp. Copies draw-color-bars'
;; (blit-displays.gc:809-857) proven DMA shape with two deliberate divergences: a
;; hand-built tex0 via dma-buffer-add-gs-set instead of adgif-shader<-texture-simple!
;; (there is no retail texture/adgif for FMV content to hijack -- both ends of this
;; pipeline are authored), and tcc=0 (JPEG carries no alpha; stb_image writes 255,
;; and tcc=0 keeps that out of the blender). bucket794 is draw-color-bars' own
;; bucket; tw/th/tbw are set for GS-register completeness but proven NOT to affect
;; sampling on this renderer -- DirectRenderer only reads tbp0/psm/tcc/tfx off tex0
;; and normalizes UV by the bound GL texture's real size, not by tw/th (L1 spike,
;; issue 569 comment). 640x448 needs no power-of-two padding for the same reason.
;;
;; issue 569 follow-up (white-lines/off-center fix): the second vertex's screen
;; XYZ (the &+ 96 block below) must be the same full-screen bottom-right corner
;; draw-color-bars uses -- #x9000/#x8d00, i.e. vertex1's (-256,-208) plus the
;; display's own 512x416 half-extents (208.0/256.0 recur as the direct-render
;; screen bound in draw-raw-image's blit-displays.gc:900-901 and as the
;; mouse-cursor clamp in pad.gc:779-780; 416 recurs as credits-obs.gc:433's
;; set-height!). It was previously vertex1 plus the VIDEO's own raw pixel
;; dimensions (#x9800/#x8f00 = (-256+640, -208+448)) instead of the display's
;; (512,416) -- a 640x448-in-screen-units quad drawn against a 512x416 internal
;; render target. UV stays the full (0,0)-(640,448) texel range regardless (the
;; &+ 80 block): GS interpolates it linearly across whatever screen extent the
;; quad has, so the fix is scaling the whole 640x448 frame down to fill the
;; correct 512x416 quad, not cropping it. Confirmed by frame-dumping THX.MJV's
;; JPEG payload directly (all 450 frames, top/bottom 16/4 rows) with zero
;; brightness anomalies, ruling out the transcoder/decoded-pixel path.
;;
;; og:preserve-this
;; issue 775 (FMV letterbox): the full-frame Y extent above is only correct for
;; aspect16x9. Retail does not scale the whole 640x448 frame into a fixed
;; screen rectangle the way this port's X pair does -- it letterboxes at
;; display time via zoom-mode (4 at aspect4x3, 0 at aspect16x9), written from
;; the aspect setting, per the fmv-player.o disassembly recorded on issue 775.
;; The exact band arithmetic lives in the console executable's compressed C
;; library and was not recoverable from that disassembly, so the factor was
;; measured instead: a PCSX2 4:3 native capture of the intro measures the
;; picture band at 0.753 +/- 0.002 of the frame height with symmetric bars top
;; and bottom, i.e. the geometric 0.75 (336 of 448 lines, 56-line bars each
;; side). quad-y0/quad-y1 reproduce that band by narrowing the Y extent alone:
;; #x7640/#x89c0 is 2048 minus/plus 156, times 16, the same fixed-point
;; convention #x7300/#x8d00 already uses for the full-frame case. The
;; anamorphic 16:9 path is untouched and stays full-frame, matching retail's
;; zoom-mode 0. X (#x7000/#x9000) and the whole UV block are unaffected
;; either way: retail scales the full 640x448 frame into whichever band it
;; draws, it never crops, so cropping here would be wrong.
(defun fmv-draw-quad ()
  (let* ((tbp (fmv-get-tbp))
         (aspect-16x9? (= (get-aspect-ratio) 'aspect16x9))
         (quad-y0 (cond (aspect-16x9? #x7300) (else #x7640)))
         (quad-y1 (cond (aspect-16x9? #x8d00) (else #x89c0)))
         )
    (with-dma-buffer-add-bucket ((buf (-> *display* frames (-> *display* on-screen) global-buf))
                                 (bucket-id bucket794)
                                 )
      (dma-buffer-add-gs-set buf
        (test-1 (new 'static 'gs-test :ate #x1 :afail #x3 :zte #x1 :ztst (gs-ztest always)))
        (alpha-1 (new 'static 'gs-alpha))
        (tex0-1 (new 'static 'gs-tex0 :tbp0 tbp :tbw 10 :psm (gs-psm ct32) :tw 10 :th 9 :tcc 0))
        (tex1-1 (new 'static 'gs-tex1 :mmag #x1 :mmin #x1))
        (clamp-1 (new 'static 'gs-clamp :wms (gs-tex-wrap-mode clamp) :wmt (gs-tex-wrap-mode clamp)))
        (texflush 0)
        )
      (let ((v1-8 (the-as object (-> buf base))))
        (set! (-> (the-as (pointer uint128) v1-8)) (-> *blit-displays-work* sprite-slow-tmpl dma-vif quad))
        (set! (-> (the-as (inline-array vector4w) v1-8) 1 quad) (-> *blit-displays-work* sprite-slow-tmpl quad 1))
        (set! (-> (the-as (inline-array vector4w) v1-8) 2 quad) (-> *blit-displays-work* color quad))
        (let ((a1-1 (the-as object (&+ (the-as pointer v1-8) 48))))
          (set! (-> (the-as (pointer int32) a1-1)) 0)
          (set! (-> (the-as (inline-array vector4w) a1-1) 0 y) 0)
          (set! (-> (the-as (inline-array vector4w) a1-1) 0 z) 0)
          (set! (-> (the-as (inline-array vector4w) a1-1) 0 w) 0)
          )
        (let ((a0-10 (the-as object (&+ (the-as pointer v1-8) 64))))
          (set! (-> (the-as (pointer int32) a0-10)) #x7000)
          (set! (-> (the-as (inline-array vector4w) a0-10) 0 y) quad-y0)
          (set! (-> (the-as (inline-array vector4w) a0-10) 0 z) 0)
          (set! (-> (the-as (inline-array vector4w) a0-10) 0 w) 0)
          )
        (let ((a0-11 (the-as object (&+ (the-as pointer v1-8) 80))))
          (set! (-> (the-as (pointer int32) a0-11)) (* 640 16))
          (set! (-> (the-as (inline-array vector4w) a0-11) 0 y) (* 448 16))
          (set! (-> (the-as (inline-array vector4w) a0-11) 0 z) 0)
          (set! (-> (the-as (inline-array vector4w) a0-11) 0 w) 0)
          )
        (let ((v1-9 (the-as object (&+ (the-as pointer v1-8) 96))))
          (set! (-> (the-as (pointer int32) v1-9)) #x9000)
          (set! (-> (the-as (inline-array vector4w) v1-9) 0 y) quad-y1)
          (set! (-> (the-as (inline-array vector4w) v1-9) 0 z) 0)
          (set! (-> (the-as (inline-array vector4w) v1-9) 0 w) 0)
          )
        )
      (&+! (-> buf base) 112)
      )
    )
  (none)
  )

;; og:preserve-this
;; L2 REPL probe (issue 569): emits one texture-anim-pc-fmv-frame record (code 87)
;; with the given elapsed-ms, driving C++'s handle_fmv_frame to decode and publish
;; that frame of THX.MJV at the FMV sentinel tbp. One-shot: the uploaded texture
;; stays resident in TextureAnimator's VramEntry/TexturePool until the next
;; upload, so a single call is enough to change what fmv-draw-quad samples -- no
;; per-frame re-emission needed. Wrapped exactly like the L1 spike's proven upload
;; shape: tex-lcom-sky-pre is the TextureUploadHandler bucket that consumes
;; pc-port codes; bucket794 (fmv-draw-quad's bucket) is a plain DirectRenderer
;; with nothing listening for them.
;;
;; Parameter is int, not uint: GOAL's top-level typechecker rejects a bare integer
;; literal (always typed int) as a uint argument with no implicit widening, and the
;; whole point of this probe is to be callable from the REPL as (fmv-debug-show-ms
;; 7500) per fmv-design.md 5f. Cast to uint only where the record field needs it.
;;
;; L3 (issue 569) keeps this standalone rather than folding it into the playing
;; state: playing computes its own elapsed-ms from the real clock and emits its
;; own record inline (same shape, different source of truth), so this stays a
;; general "poke an arbitrary elapsed-ms at the sentinel tbp" REPL lever, useful
;; for the other 42 movies later or for probing a frame without a live process.
(defun fmv-debug-show-ms ((elapsed-ms int))
  (let ((tbp (fmv-get-tbp)))
    (with-dma-buffer-add-bucket ((buf (-> *display* frames (-> *display* on-screen) global-buf))
                                 (bucket-id tex-lcom-sky-pre)
                                 )
      (pc-texture-anim-flag start-anim-array buf)
      (pc-texture-anim-flag fmv-frame buf :qwc 1)
      (let ((rec (the texture-anim-pc-fmv-frame (-> buf base))))
        (set! (-> rec elapsed-ms) (the uint elapsed-ms))
        (set! (-> rec dest) tbp)
        (set! (-> rec width) 640)
        (set! (-> rec height) 448)
        (set! (-> rec movie-id) 0)
        (set! (-> rec stop) 0)
        )
      (&+! (-> buf base) 16)
      (pc-texture-anim-flag finish-anim-array buf)
      )
    )
  (none)
  )

;; ============================================================================
;; L3 fmv-player process (issue 569): init-by-other, the playing/die states, the
;; playback clock, and the pad-skip check. This section used to carry R7's rule
;; (fmv-design.md): "this must never set *fmv-player* or touch scene.gc -- both
;; stay reserved for the later milestone that wires the retail call site at
;; scene.gc:1195." The jakx-fmv-boot-movies rung (issue 569/729) IS that later
;; milestone for the *fmv-player* half: fmv-player-run above now sets it for
;; real, so title-obs's (while *fmv-player* (suspend)) waits actually wait and
;; actually stop. scene.gc itself is untouched by this rung and stays reserved.
;; ============================================================================

;; og:preserve-this
;; FMV playback duration cap (design R4), retiring the single FMV-THX-DURATION-
;; MS constant this replaced. The old constant's own comment attributed a
;; 25 fps figure to "the transcode's own sequence header" -- wrong: the
;; jakx-fmv-boot-movies rung read the real MPEG-2 sequence header bytes
;; directly (iso_data/jakx/STR/{THX,INTRO}.M2V, startcode 000001B3, the 4-bit
;; frame_rate_code field after the 12+12-bit width/height and 4-bit aspect)
;; and both report frame_rate_code=0x4 (30000/1001, 29.97 fps). The 25 fps
;; figure was ffprobe's avg_frame_rate estimate, a heuristic fallback ffprobe
;; uses on a raw elementary stream with no container-level duration, and it
;; visibly disagrees with ffprobe's own r_frame_rate=30000/1001 (tbr, which
;; DOES match the real header) -- confirming avg_frame_rate was always the
;; wrong of the two, not a genuinely ambiguous pair of candidates.
;;
;; duration_ms = frame_count * 1000 * fps_den / fps_num, integer-truncated;
;; frame_count is a direct picture_start_code (000001 00) count, cross-checked
;; against `ffprobe -count_frames`:
;;   THX.M2V:   450  frames -> 450  * 1000 * 1001 / 30000 = 15015 ms exactly
;;   INTRO.M2V: 7274 frames -> 7274 * 1000 * 1001 / 30000 = 242709 ms (true
;;     value 242709.1333..., truncated; the lost fraction is under 1 ms, far
;;     inside one frame's 33.37 ms, and MjvVideoReader clamps any elapsed-ms
;;     past the last frame to the measured-black final frame regardless).
;; introb and the other 41 *m2v-info* movies have no jakx-fmv-boot-movies
;; measurement (out of this rung's scope); FMV-DEFAULT-DURATION-MS keeps the
;; old constant's own conservative value for them pending a later rung.
(defconstant FMV-THX-DURATION-MS 15015)
(defconstant FMV-INTRO-DURATION-MS 242709)
(defconstant FMV-DEFAULT-DURATION-MS 18500)
;; og:preserve-this (issue 762): 285 frames at 30000/1001 fps (LOGO.MJV's own container
;; header, gen_mjv.py's transcode of iso_data/jakx/STR/LOGO.IPU): 285 * 1001 * 1000 /
;; 30000 = 9509.5, truncated. There is no *m2v-info* entry to read this from -- the
;; burning-X login movie is not a disc M2V (fmv-player-run-texture's own og:preserve-this
;; banner below has the full argument evidence), so unlike FMV-THX-DURATION-MS and
;; FMV-INTRO-DURATION-MS above this is not a decoded retail value, it is computed from
;; the transcoded container's own frame count and rate.
(defconstant FMV-LOGO-DURATION-MS 9509)

;; og:preserve-this (issue 762): a PC-port-invented fmv-mode value, not
;; decoded -- retail's own fmv-mode field only ever holds 1 (normal) or 2
;; (commentary), since retail has no texture-destination FMV concept at all.
;; Selects playing's own texture-mode branch (below) for the login-logo
;; path fmv-player-run-texture spawns; fmv-player-init-by-other's own
;; og:preserve-this banner (further down this file) has the full argument
;; evidence this value's plumbing rests on. Placed here, ahead of playing's
;; own defstate, since defconstant needs to be seen before its first use in
;; this file's own top-to-bottom compile order, same as the three durations
;; immediately above.
(defconstant FMV-MODE-TEXTURE 0)

;; og:preserve-this per-movie duration lookup, keyed by the gui-id "movie
;; index" fmv-player-run sets at spawn (m2v-info-index-by-name's own array
;; position, fmv-player-h.gc's static order: "intro" is position 0, "thx" is
;; position 42). Hardcoding those two positions here rather than re-deriving
;; them by name every call is safe: *m2v-info* is a fixed static array, its
;; order cannot change at runtime. 43 (issue 762) is not an *m2v-info*
;; position at all: it is the LOGO movie-id fmv-player-run-texture sets on
;; gui-id directly (this file's own og:preserve-this note on that function),
;; so it is checked the same way as the other two hardcoded indices.
(defun fmv-duration-for-movie ((movie-idx uint))
  (cond
    ((= movie-idx (the uint 42)) FMV-THX-DURATION-MS)
    ((= movie-idx (the uint 0)) FMV-INTRO-DURATION-MS)
    ((= movie-idx (the uint 43)) FMV-LOGO-DURATION-MS)
    (else FMV-DEFAULT-DURATION-MS)
    )
  )

;; og:preserve-this
;; fmv-player's deftype (fmv-player-h.gc:43-58, mirrored at
;; decompiler/config/jakx/all-types.gc:41035-41053) declares no (:state-methods)
;; and its :method-count-assert is exactly 20 -- process's own methods plus
;; fmv-player-method-15..19, nothing more. Retail never virtualized these two
;; states: adding (:state-methods playing die) to the deftype would grow the
;; method count past what all-types.gc asserts and redden JakXTypeConsistency,
;; and the jakx-behavior-state-typing finding is that jakx ships zero
;; (:state-methods) declarations tree-wide, so a bare process type is the norm
;; here, not a gap. playing/die are therefore plain (non-virtual) defstates
;; entered with (go ...), the same shape camera-combiner (camera-h.gc:478, also
;; no :state-methods) uses for cam-combiner-active -- not go-virtual, which
;; would need a virtual method slot this type does not declare.
;;
;; Non-virtual (go ...) resolves its target as an ordinary global symbol at
;; compile time (unlike go-virtual's runtime method-of-object lookup), so
;; unlike credits-obs' virtual running/die pair, these three definitions
;; cannot share that pair's file order: die must land before playing (playing
;; calls (go die)), and playing must land before fmv-player-init-by-other
;; (which calls (go playing)). Landed in that dependency order below, not in
;; the init/playing/die reading order the design doc lists them in.

;; og:preserve-this
;; FMV debug-text clobber (issue 569's white-lines closure). The frame upload
;; at the sentinel TBP (fmv-get-tbp, shared by fmv-draw-quad and both states
;; below) lands in the same VRAM the font tpage samples, so the three
;; *display-camera-info* debug lines (targ pos / cam pos / string info,
;; cam-update.gc:553-591) render as solid bars for the duration of playback --
;; the video itself is correct since the quad fix. *display-camera-info* is
;; the single flag gating all three print sites (main-h.gc:5883, no per-line
;; gate exists), so blank it for exactly the playing state's lifetime instead
;; of touching the print sites: playing saves the caller's setting and clears
;; it the instant :code starts, die restores it. die is the only (go die)
;; target from playing -- both the pad-skip and the duration-timeout exits
;; route through it -- so it is the single place the restore needs to live.
(define *fmv-saved-display-camera-info* #f)

;; og:preserve-this
;; Boot-movie audio (issue 760): retail's fmv-player playing state feeds the
;; movie's VAG stream through gui-control instead of DMA'ing it itself --
;; the port bodies for both landed states below go through the same three
;; calls retail does (gui-control-method-9 to queue, gui-control-method-17
;; to poll ready, gui-control-method-16 to play/stop), all landed at
;; loader.gc:373/873/488. Channel 34 is proven numerically from the scoped
;; decode's own arg register at the add-request call, not from gui-h.gc's
;; gui-channel enum: that enum is a jak3 copy (34 there is bbush, a talker
;; channel with no plausible relation to a boot movie), so the literal is
;; used bare with this note rather than a symbolic name the evidence does
;; not support. gui-control-method-20 (volume) is retail's fourth call on
;; this path but stays unlanded: its own body is still blocked on a missing
;; gui-connection-flags bit (gui-h.gc's own og:preserve-this note on the
;; method); skipped here rather than silently dropped, so this port plays
;; at whatever volume gui-control-method-9's own default leaves the
;; connection at.
;;
;; subtitle-change-time (fmv-player-h.gc:74) carries the queued sound-id
;; between playing's :code and die's :code below -- confirmed dead
;; everywhere else in this file, and grepped tree-wide for fmv-player's own
;; copy of the field (only scene-player's same-named, different-type field
;; turns up elsewhere, scene.gc/scene-h.gc, unrelated). Reusing it keeps
;; this rung to fmv-player.gc alone: no field-type change, so no
;; all-types.gc edit and no JakXTypeConsistency exposure. gui-id keeps its
;; existing job (the movie index into *m2v-info*, fmv-player-run's own
;; og:preserve-this note above); the two fields do not collide.
;;
;; Sync policy: retail blocks the whole state on gui-control-method-17
;; reading ready (ntsc's own disc-streaming latency) before the first frame
;; ever draws. This port's video is driven by the same :code and starts its
;; clock at init-by-other, already running before gui-control has had any
;; chance to report ready, so blocking here would desync video from its own
;; elapsed-ms rather than protect anything -- there is no disc seek on this
;; path, gui-control's own queue is the only latency source. Folded instead
;; into the existing per-frame loop as a one-shot latch (audio-latched
;; below): queue at state entry, and once a frame observes ready, issue the
;; play action and re-stamp start-time so elapsed-ms (and the video it
;; drives) restarts from zero in step with the audio that is about to
;; start. This is retail-faithful in the sense that it uses retail's own
;; three calls and retail's own ready-poll condition, but trades retail's
;; blocked first frame for a visible one-time restart instead of a startup
;; stall; the alternative considered was a fixed audio-start delay (skip
;; the first N ms of video so a queued sound-id is reliably ready by then)
;; -- rejected because N is not measured for this port's queue latency and
;; would either race on a slow frame or waste real playback time on a fast
;; one, where the latch reacts to the actual status instead of a guess.
;;
;; Every gui-control call below is gated on (nonzero? *gui-control*), the
;; same guard every other landed call site in the tree uses (loader.gc:284's
;; own note names it the standing idiom). *gui-control* is armed
;; unconditionally at boot once loader.o's top-level runs (loader.gc:334,
;; ahead of fmv-player-run's own callers in the title-state boot sequence),
;; so the guard is not waiting out a real bring-up gap here the way
;; generic-obs.gc's own copy still is (gui.gc unlanded) -- it is defensive
;; symmetry with the rest of the tree, not a load-bearing gate.
(define *fmv-saved-jukebox-onoff* #f)

;; og:preserve-this
;; Menu jukebox silencing (issue 760): retail calls (jukebox-onoff #f) on
;; state entry to stop the menu's background music track for the duration
;; of the movie (gsound.gc:1838, landed). Saved and restored here rather
;; than hardcoded off-then-on, since (jukebox-onoff #f) is itself a real
;; state change now that the menu jukebox plays for real (it stops the
;; current track and records *last-music-position*) -- restoring the
;; caller's prior setting through jukebox-onoff again (not a bare set!)
;; also re-arms *jukebox-time* if it was on, the same "was it running"
;; semantics *fmv-saved-display-camera-info* uses just above for the
;; debug-text flag.

;; og:preserve-this
;; Emits one stop=1 record so handle_fmv_frame closes the C++ reader, then
;; falls off the end of :code -- the credits-obs self-termination shape
;; (credits-obs.gc:668-674, confirmed at design 5d): a :code behavior returning
;; naturally kills the process with no self-deactivate needed. No draw call
;; here, so this is also the frame FMV output stops appearing. width/height are
;; moot: handle_fmv_frame checks stop before it ever reads them (design 3c
;; step 2); movie-id is carried through anyway for record-shape symmetry with
;; playing's own emission. Restoring *display-camera-info* here first (see the
;; debug-text-clobber note above playing's :code) undoes the overlay blank for
;; both of playing's exits, since both route through this state. Clearing
;; *fmv-player* here (fmv-boot-movies rung, retiring the R7 "never set
;; *fmv-player*" rule above) is what lets title-obs's (while *fmv-player*
;; (suspend)) waits actually stop waiting once the movie ends.
(defstate die (fmv-player)
  :code (behavior ()
    ;; og:preserve-this (issue 807's telemetry): the exact retail site that
    ;; arms black across this transition on the cold-boot road is unproven
    ;; -- the mechanism inventory names fmv-fade-out and the render-off
    ;; window around the title-control scene as the retail-faithful
    ;; candidates, and either would replace this arm outright once its own
    ;; reachability here is confirmed. Until then this is an authored,
    ;; bounded cover: telemetry showed bg-a and bg-a-force sitting at 0.0
    ;; for the whole movie-to-menu span (no arm fires today), so the birth
    ;; cascade after "Displaying level menu2" -- actors and particles
    ;; birthing over the following second or two -- plays out uncovered.
    ;; (seconds 2) bounds the measured sub-second load plus that cascade
    ;; with margin and self-heals if the already-landed reveal gate
    ;; (title-obs.gc:488-499) is ever skipped, since blackout-time is a
    ;; frame-counter deadline, not a latch. Placed at the head of die's
    ;; :code so it fires uniformly for the natural-duration exit, the
    ;; pad-skip exit (both routed through playing's single (go die) above)
    ;; and the 'go-die event, all three of which land here. Gated off
    ;; FMV-MODE-TEXTURE: the login-logo texture-mode player (issue 762) has
    ;; no birth cascade to cover and must never black the screen.
    (when (!= (-> self fmv-mode) FMV-MODE-TEXTURE)
      (set-blackout-frames (seconds 2))
      )
    (set! *display-camera-info* *fmv-saved-display-camera-info*)
    (set! *fmv-player* (the-as fmv-player #f))
    (jukebox-onoff *fmv-saved-jukebox-onoff*)
    (when (nonzero? *gui-control*)
      (gui-control-method-16
        *gui-control*
        4
        (the-as uint (-> self subtitle-change-time))
        0
        0
        (the-as string #f)
        (the-as (function gui-connection symbol) #f)
        (the-as process #f)
        )
      )
    (let ((tbp (fmv-get-tbp)))
      (with-dma-buffer-add-bucket ((buf (-> *display* frames (-> *display* on-screen) global-buf))
                                   (bucket-id tex-lcom-sky-pre)
                                   )
        (pc-texture-anim-flag start-anim-array buf)
        (pc-texture-anim-flag fmv-frame buf :qwc 1)
        (let ((rec (the texture-anim-pc-fmv-frame (-> buf base))))
          (set! (-> rec elapsed-ms) 0)
          (set! (-> rec dest) tbp)
          (set! (-> rec width) 640)
          (set! (-> rec height) 448)
          (set! (-> rec movie-id) (-> self gui-id))
          (set! (-> rec stop) 1)
          )
        (&+! (-> buf base) 16)
        (pc-texture-anim-flag finish-anim-array buf)
        )
      )
    )
  )

;; og:preserve-this
;; elapsed-ms is derived from (current-time), never stored: start-time (set
;; once, at init-by-other) is the only clock state fmv-player keeps, matching
;; the retail field's own semantics (fmv-player-h.gc:48). (current-time) reads
;; -> PP clock frame-counter, which counts real elapsed time in 1/300ths of a
;; second regardless of achieved framerate (TICKS_PER_SECOND, gkernel-h.gc:109,
;; and the frame-counter doc comment above it) -- not a 60Hz-assumed frame
;; count, which is the trap fmv-design.md 5d warns against. ms = ticks *
;; 1000/300, reduced to ticks * 10/3; recomputed fresh from the exact tick
;; delta every frame rather than accumulated, so integer-division truncation
;; can't drift.
(defstate playing (fmv-player)
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('go-die)
       (go die)
       )
      )
    )
  :code (behavior ()
    (set! *fmv-saved-display-camera-info* *display-camera-info*)
    (set! *display-camera-info* #f)
    (set! *fmv-saved-jukebox-onoff* *jukebox-onoff*)
    (jukebox-onoff #f)
    ;; og:preserve-this (issue 762): the login-logo texture-mode path has no
    ;; audio track (LOGO.IPU is silent), so the gui-control queue above --
    ;; and the poll-then-play latch in the loop below -- both stay gated on
    ;; fmv-mode, the audio rung's own additions otherwise untouched.
    (when (and (nonzero? *gui-control*) (!= (-> self fmv-mode) FMV-MODE-TEXTURE))
      (set! (-> self subtitle-change-time)
            (the-as uint64
              (gui-control-method-9
                *gui-control*
                self
                34
                1
                (the-as string (-> *m2v-info* (the int (-> self gui-id)) sound))
                -99.0
                0
                )
              )
            )
      )
    (let ((audio-latched (= (-> self fmv-mode) FMV-MODE-TEXTURE)))
      (until #f
        (when (and (not audio-latched)
                   (nonzero? *gui-control*)
                   (= (gui-control-method-17 *gui-control* (the-as uint (-> self subtitle-change-time))) 2)
                   )
          (gui-control-method-16
            *gui-control*
            2
            (the-as uint (-> self subtitle-change-time))
            0
            0
            (the-as string #f)
            (the-as (function gui-connection symbol) #f)
            (the-as process #f)
            )
          (set! (-> self start-time) (the-as uint (current-time)))
          (set! audio-latched #t)
          )
        (let* ((elapsed-ticks (- (current-time) (the-as time-frame (-> self start-time))))
               (elapsed-ms (the int (/ (* elapsed-ticks 10) 3)))
               )
          (cond
            ;; og:preserve-this (issue 762): the duration half of this arm is gated off
            ;; FMV-MODE-TEXTURE -- see the texture-mode branch's own og:preserve-this note
            ;; below for why. Pad-skip stays live for both modes; only the automatic
            ;; die-on-duration exit is fullscreen-only.
            ((or (cpad-pressed? 0 triangle circle x)
                 (and (!= (-> self fmv-mode) FMV-MODE-TEXTURE)
                      (> elapsed-ms (fmv-duration-for-movie (-> self gui-id)))
                      )
                 )
             (go die)
             )
            ;; og:preserve-this texture-mode branch (issue 762): the login-logo
            ;; emitter, gated on no fullscreen fmv-player being live.
            ;; TextureAnimator owns a single MjvVideoReader (m_fmv,
            ;; TextureAnimator.cpp) keyed off the frame's own movie-id -- a
            ;; fullscreen boot movie and this texture-mode player emitting in
            ;; the same tick would thrash that one reader open/closed between
            ;; LOGO.MJV and whatever fullscreen movie is live, corrupting
            ;; both. Both fmv-player-run and fmv-player-run-texture publish
            ;; *fmv-player* to their own newly-spawned process (fmv-player-
            ;; run-texture's own og:preserve-this banner above), and both
            ;; kill-by-type any existing fmv-player process before spawning,
            ;; so at most one process is ever actually live -- *fmv-player*
            ;; is never a genuinely different process than self while self is
            ;; in playing. This check is therefore defensive insurance
            ;; against the brief window mid-transition (a respawn's own
            ;; kill-by-type has run but *fmv-player* has not yet been
            ;; reassigned to the new process) rather than a load-bearing
            ;; invariant, and explicitly excludes self so it cannot gate
            ;; itself off permanently the instant fmv-player-run-texture
            ;; publishes *fmv-player* as this very process. Skipping the
            ;; emit (rather than dying) lets the logo pick back up the next
            ;; tick once the fullscreen movie finishes.
            ((and (= (-> self fmv-mode) FMV-MODE-TEXTURE)
                  *fmv-player*
                  (not (eq? *fmv-player* self))
                  (!= (-> *fmv-player* fmv-mode) FMV-MODE-TEXTURE)
                  )
             (suspend)
             )
            ;; og:preserve-this texture-mode loop (issue 762): retail's login logo burns
            ;; forever, but this port's elapsed-ms free-runs off (current-time) and
            ;; MjvVideoReader (TextureAnimator.cpp) clamps any elapsed-ms past the movie's
            ;; last frame to that frame rather than wrapping -- an unmodified emit here
            ;; decodes LOGO.MJV once (~9.5 s, 285 frames measured on this rung's own boot)
            ;; and then holds the final frame forever. The die-on-elapsed-ms arm above is
            ;; already gated off FMV-MODE-TEXTURE for the same reason: fullscreen movies
            ;; keep their real run-once/die-on-duration exit, but the login logo has no
            ;; retail-authored end to die on. Wrapping the value actually sent to C++ with
            ;; fmv-duration-for-movie -- the one duration lookup this file already carries,
            ;; rather than a LOGO-specific constant this file has no decoded evidence for --
            ;; is what makes the emitted elapsed-ms loop instead of climb past the clamp.
            ((= (-> self fmv-mode) FMV-MODE-TEXTURE)
             (with-dma-buffer-add-bucket ((buf (-> *display* frames (-> *display* on-screen) global-buf))
                                          (bucket-id tex-lcom-sky-pre)
                                          )
               (pc-texture-anim-flag start-anim-array buf)
               (pc-texture-anim-flag fmv-frame buf :qwc 1)
               (let ((rec (the texture-anim-pc-fmv-frame (-> buf base))))
                 (set! (-> rec elapsed-ms)
                       (the uint (mod elapsed-ms (fmv-duration-for-movie (-> self gui-id)))))
                 (set! (-> rec dest) (-> self texture-base-page))
                 (set! (-> rec width) 128)
                 (set! (-> rec height) 128)
                 (set! (-> rec movie-id) 43)
                 (set! (-> rec stop) 0)
                 )
               (&+! (-> buf base) 16)
               (pc-texture-anim-flag finish-anim-array buf)
               )
             ;; no fmv-draw-quad here: the destination texture is sampled by
             ;; the normal texture-anim draw pass (movie-texture-anim-func's
             ;; :func-id slot, held above), not by a dedicated fullscreen quad.
             (suspend)
             )
            (else
              (let ((tbp (fmv-get-tbp)))
                (with-dma-buffer-add-bucket ((buf (-> *display* frames (-> *display* on-screen) global-buf))
                                             (bucket-id tex-lcom-sky-pre)
                                             )
                  (pc-texture-anim-flag start-anim-array buf)
                  (pc-texture-anim-flag fmv-frame buf :qwc 1)
                  (let ((rec (the texture-anim-pc-fmv-frame (-> buf base))))
                    (set! (-> rec elapsed-ms) (the uint elapsed-ms))
                    (set! (-> rec dest) tbp)
                    (set! (-> rec width) 640)
                    (set! (-> rec height) 448)
                    (set! (-> rec movie-id) (-> self gui-id))
                    (set! (-> rec stop) 0)
                    )
                  (&+! (-> buf base) 16)
                  (pc-texture-anim-flag finish-anim-array buf)
                  )
                )
              (fmv-draw-quad)
              (suspend)
              )
            )
          )
        )
      )
    )
  )

;; og:preserve-this fmv-player-init-by-other's real 4-argument shape (issue
;; 762): fmv-player-run's own og:preserve-this note below used to flag this
;; as a HELD discrepancy -- both of fmv-player-run's own decoded call sites
;; pass run-function-in-process FOUR extra args (#t, 0, 10, and either 2 or
;; 1), while this function landed zero-arg. This rung's own scoped decode of
;; the sibling fmv-player-run-texture (fmv-player_ir2.asm ops 83-90) gives
;; the missing field-layout evidence: it reads the destination texture's own
;; dest/width array fields (index 0) right before its own process-spawn,
;; the same two values a 4-arg init-by-other would need for a non-fullscreen
;; destination. arg0 (retail's #t/#f "state selector") has no decoded effect
;; on either call site's own behavior recovered by this rung -- accepted for
;; arity but not consumed here, same as movie-texture-anim-init's own unused
;; texture-anim arg0 elsewhere in this file. arg1 0 selects the FULLSCREEN
;; sentinel path (fmv-get-tbp) rather than literal tbp 0, which stays a
;; reserved VRAM key GS itself cannot address (gs.gc:634) -- keeping today's
;; fullscreen behavior byte-for-byte: fmv-player-run below still passes
;; literal 0 for arg1, so (fmv-get-tbp) is still what texture-base-page
;; resolves to on that path, same as before this rung. arg3 selects
;; fmv-mode; retail's own two values (1 normal, 2 commentary) are what
;; fmv-player-run passes below, and FMV-MODE-TEXTURE (a PC-port-invented
;; third value, not decoded -- retail has no texture-destination FMV concept
;; at all) is what fmv-player-run-texture passes for the login-logo path,
;; read by playing's own new texture-mode branch below. FMV-MODE-TEXTURE
;; itself is defined near the top of this file, alongside the FMV-*-
;; DURATION-MS constants, ahead of playing's own use of it.
(defbehavior fmv-player-init-by-other fmv-player ((arg0 symbol) (arg1 int) (arg2 int) (arg3 int))
  (set! (-> self texture-base-page) (if (zero? arg1) (fmv-get-tbp) (the-as uint arg1)))
  (set! (-> self texture-width) (the-as uint arg2))
  (set! (-> self start-time) (the-as uint (current-time)))
  (set! (-> self fmv-mode) (the-as uint8 arg3))
  (go playing)
  )

;; og:preserve-this fmv-boot-movies rung (issue 569/729): fmv-player-run's
;; real retail body still cannot land whole -- this rung's own scoped decode
;; (allowed_objects: ["fmv-player"], scratch proj-path, reverted) confirms the
;; prior rung's account: most of the function is FMVLEV-level texture-page
;; resolution and aspect-ratio-dependent matrix setup writing into *fmv-work*
;; at offset 84 before running out of field-layout evidence for that global,
;; plus disc-path string construction (demo?/scf-get-territory-gated
;; "~S.m2v"/"~S.pal" formatting via *fmv-snd-name*/*fmv-m2v-name*) that has no
;; PC-port counterpart now that MJV containers replace disc M2V streaming --
;; squarely the no-M2V-decoder-exists FMV-road scope, not a call this rung
;; could land whole.
;;
;; The op-level evidence for the parts this port DOES port is direct, though
;; (same scoped decode, fmv-player_ir2.asm):
;;   ops 0-6:     (kill-by-type fmv-player *active-pool*) verbatim, first thing
;;                the function does -- ported as-is below.
;;   ops 141-168: the *m2v-info* lookup loop compares arg0 against each
;;                entry's SOUND field first (machine offset +4 off the boxed
;;                entry pointer, placed offset 8) via nocase-string=, then
;;                falls back to the NAME field (machine +0, placed +4) if that
;;                misses -- ported below as the (or ... ...) in
;;                m2v-info-index-by-name. Every landed caller (title-obs.gc's
;;                target-intro/target-introb) passes a name-matching string
;;                ("thx"/"intro"/"introb"), so the sound-field branch never
;;                actually matches for any call this rung can exercise, but
;;                it is real retail behavior, not invented, and costs nothing
;;                to keep.
;;   ops 253-277/293-317: get-process/activate/run-function-in-process against
;;                *default-dead-pool*, stack size #x4000, tag "fmv-player",
;;                stack top *dram-stack*+#x3800 -- exactly process-spawn's own
;;                macro expansion (gstate.gc:33-53), landed below as
;;                (process-spawn fmv-player :init fmv-player-init-by-other
;;                :name "fmv-player" :to arg1).
;;
;; HELD discrepancy RESOLVED (issue 762): both call sites at ops 270-277 and
;; 310-317 pass run-function-in-process FOUR extra args (#t, 0, 10, and
;; either 2 or 1 depending on which branch), meaning retail's real
;; fmv-player-init-by-other takes at least 4 parameters -- fixed above with
;; the field-layout evidence this rung's own scoped decode of the sibling
;; fmv-player-run-texture supplied (see init-by-other's own og:preserve-this
;; banner). The literal args below ((#t 0 10 1)) are the values common to
;; both of this function's own decoded call sites (the prior rung's own
;; account above), using the shared 1 rather than the branch-specific 2 --
;; this port has no evidence distinguishing which caller wants which, and 1
;; ("normal") is the safer default until a rung lands the branch this decode
;; does not port. process-spawn needs its :init callee already defined in
;; this file (GOAL does not hoist forward references to same-file globals),
;; which is also why this function lands here, after init-by-other, rather
;; than near fmv-player-run-texture above.
;;
;; Also not replicated: ops 139-147, a pre-loop check that re-parents an
;; already-live *fmv-player* into arg1's pool and returns early instead of
;; spawning a new one. Unreachable by every landed caller (each already
;; suspends on (while *fmv-player* (suspend)) until die above clears it, so
;; *fmv-player* is always #f by the time the next fmv-player-run call runs);
;; omitted rather than ported blind.
;;
;; og:preserve-this (issue 569): fmv-player-run makes no DMA reservation in
;; retail -- this rung's own scoped decode (fmv-player_ir2.asm) shows no
;; dma-try-alloc call anywhere inside the function. The 'fmv-player DMA tag
;; belongs to lobby-menu-manager.gc's own IPU logo path instead: it reserves
;; the tag itself (dma-try-alloc 'fmv-player, :356 and :838) and releases it
;; itself (dma-release 'fmv-player, :767, :835, :2550), never fmv-player-run.
;; A prior version of this port added a per-call dma-try-alloc/suspend-until-
;; success loop here anyway, on the mistaken assumption the tag needed
;; reserving before every spawn; it leaked, because nothing here or in die
;; ever releases it and title-obs.gc:1151-1159 calls fmv-player-run twice
;; back to back with no release between the two calls. Observed live:
;; fmvboot-plain-1.log shows THX playing cleanly to completion (exactly 450
;; "[fmv] decode frame N" lines, 0 through 449) and then the boot stalling
;; forever -- no second "decode frame 0", no menu2 level load, *fmv-player*
;; reading #f at attach, 315 idle Kernel dispatch lines and no crash -- the
;; target's :code spinning inside the leaked reservation's wait loop on the
;; "intro" call, since the "thx" call's own reservation was never released.
;; The L3 THX spike played from a bare process-spawn with no reservation of
;; any kind, and on PC the MJV frames arrive through TextureAnimator's own
;; handle_fmv_frame, which needs no DMA reservation at all -- this is not a
;; retail behavior a PC-port body needs to reconstruct. The kill-by-type-
;; then-process-spawn shape below is still title-control-spawn's own proven
;; shape (title-obs.gc:200-211) for a singleton title-adjacent process.
;;
;; The "movie index" carried in gui-id (fmv-mode is already claimed, set to 1
;; by init-by-other above) is m2v-info-index-by-name's array position -- NOT
;; the :name-mate :idx field (game-info.gc:575-581 shows :idx is a UI
;; "currently selected" flag reset to 0 on every entry then set to 1 on entry
;; 0 alone, unrelated to identity, and confirmed unrelated by this rung's own
;; decode: the lookup loop indexes *m2v-info* by a plain incrementing
;; counter, never reads :idx at all). gui-id is read back by playing/die
;; above when they emit the frame record's movie-id, and by TextureAnimator's
;; own movie-id -> MJV-basename table (jakx-fmv-boot-movies rung 2, same
;; array order).
(defun m2v-info-index-by-name ((name string))
  "Array position of the *m2v-info* entry whose :sound or :name matches
   (retail's own lookup order, ops 141-168), or -1."
  (let ((found -1))
    (dotimes (i (-> *m2v-info* length))
      (when (and (= found -1)
                 (or (nocase-string= name (the-as string (-> *m2v-info* i sound)))
                     (nocase-string= name (the-as string (-> *m2v-info* i name)))
                     )
                 )
        (set! found i)
        )
      )
    found
    )
  )

(defun fmv-player-run ((arg0 string) (arg1 process-tree) (arg2 symbol))
  (kill-by-type fmv-player *active-pool*)
  (let ((movie-idx (m2v-info-index-by-name arg0)))
    (when (>= movie-idx 0)
      ;; process-spawn's own value (gstate.gc:33-53) is (the (pointer fmv-player)
      ;; (-> new-proc ppointer)) -- a pointer TO the process-tree slot holding the
      ;; process, not the process itself; (-> new-proc 0) is the deref every landed
      ;; caller uses (lobby-menu-manager.gc's lmm-make-logo-menu: (process->handle
      ;; (-> v1-9 0)) off the same ppointer-typed local). gui-id is set before
      ;; *fmv-player* is published: run-now-in-process (inside process-spawn) runs
      ;; fmv-player-init-by-other synchronously, and init-by-other's own (go playing)
      ;; only schedules playing's :code for the next kernel dispatch rather than
      ;; running it inline (go's doc comment, gstate.gc:8-11) -- neither init-by-
      ;; other nor playing reads gui-id before that next dispatch, so the ordering
      ;; here is not a race, but publishing gui-id first keeps it that way even if
      ;; something is added later that reads *fmv-player* the instant it goes
      ;; non-#f.
      (let ((new-proc (process-spawn fmv-player
                         :init fmv-player-init-by-other
                         :name "fmv-player"
                         :to arg1
                         #t
                         0
                         10
                         1
                         )
                       )
            )
        (when new-proc
          (let ((proc (-> new-proc 0)))
            (set! (-> proc gui-id) (the uint movie-idx))
            (set! *fmv-player* proc)
            )
          )
        )
      )
    )
  #t
  )

;; og:preserve-this fmv-player-run-texture (issue 762): the PC-port body for
;; scene.gc:1195's (enter wait scene-player) call site, replacing the #f
;; bring-up stub this rung retires. Not a verbatim retail transcription:
;; retail's own real body (this rung's scoped decode, fmv-player_ir2.asm ops
;; 0-91, the first time this function's body has been recovered at all)
;; branches on *scene-player*/*record-fma-pal* to choose a ".ppu" vs ".ipu"
;; format suffix and re-parents an already-live *fmv-player* into arg1's pool
;; instead of respawning (ops 15-22); this port keeps only the shape every
;; landed caller (the login-logo path) actually needs -- arg0 is always a
;; movie-name string formatted to "<name>.ipu" (ops 27-58's L5 branch, the
;; one lobby-menu-manager.gc's own read site checks), and no caller today has
;; a live *fmv-player* to re-parent.
;;
;; Ops 0-6 (kill-by-type fmv-player *active-pool*) and ops 6-10
;; (lookup-texture-by-name "iscreen-video-dest" #f #f) are ported verbatim
;; below -- both already-landed calls, matching this rung's own
;; *menu-movie-texture-anim-array* wiring (fmv-player.gc's own top-level,
;; earlier in this file) for the same destination name. Ops 13-14 read the
;; resolved texture's own dest/width fields (raw offsets 10 and 26, four
;; bytes short of all-types.gc's own offset-assert for both -- this rung
;; does not have evidence to resolve that discrepancy further, so the
;; field-name access below goes through the already-landed texture deftype
;; instead of the raw offsets, per this rung's own instructions); those two
;; values are what feed the process-spawn below, replacing today's hardcoded
;; sentinel-tbp/640 fullscreen defaults for this non-fullscreen destination.
;; Ops 76-90's run-function-in-process is process-spawn's own macro
;; expansion (gstate.gc:33-53), same shape as fmv-player-run above; state
;; selector #t and fmv-mode FMV-MODE-TEXTURE are this port's own choices
;; (arg0 has no decoded effect per fmv-player-init-by-other's own
;; og:preserve-this banner, and FMV-MODE-TEXTURE is invented for this port,
;; not decoded -- see that same banner). *fmv-player* IS published here
;; (below), unlike the fullscreen-only claim an earlier draft of this
;; comment made: lobby-menu-manager.gc's own already-landed call site
;; (lmm-make-logo-menu) guards its own call on *fmv-player* going non-#f, the
;; same contract fmv-player-run's callers already rely on. kill-by-type at
;; the top of this function (and of fmv-player-run) means at most one
;; fmv-player process -- fullscreen or texture-mode -- is ever actually
;; live, so *fmv-player* names whichever one is current regardless of mode;
;; playing's own texture-mode branch (below) still checks fmv-mode on
;; whatever *fmv-player* currently is before emitting, defensive insurance
;; against the brief transition window around a respawn rather than a load-
;; bearing invariant this rung has evidence two processes ever violate.
(defun fmv-player-run-texture ((arg0 string) (arg1 process-tree))
  (kill-by-type fmv-player *active-pool*)
  (let ((tex (lookup-texture-by-name "iscreen-video-dest" (the-as string #f) (the-as (pointer texture-page) #f))))
    (when tex
      (format (clear *fmv-m2v-name*) "~S.ipu" arg0)
      ;; og:preserve-this (issue 762): *fmv-player* is published here, unlike
      ;; the og:preserve-this banner above's earlier claim that it stays
      ;; fullscreen-only. lobby-menu-manager.gc's own already-landed call
      ;; site (lmm-make-logo-menu) guards its call on
      ;; (or (not *fmv-player*) (not (string= "logo.ipu" *fmv-m2v-name*))) --
      ;; a guard that only does its job (spawn once, not every frame this
      ;; runs) if *fmv-player* actually goes non-#f once this succeeds, the
      ;; same contract fmv-player-run's own callers already rely on.
      (let ((new-proc (process-spawn fmv-player
                         :init fmv-player-init-by-other
                         :name "fmv-player"
                         :to arg1
                         #t
                         (the int (-> tex dest 0))
                         (the int (-> tex width 0))
                         FMV-MODE-TEXTURE
                         )
                       )
            )
        (when new-proc
          ;; og:preserve-this (issue 762): gui-id 43 mirrors fmv-player-run's own
          ;; (set! (-> proc gui-id) (the uint movie-idx)) above -- gui-id is the
          ;; "movie index" playing/die and TextureAnimator's own movie-id -> MJV-
          ;; basename table read back (fmv-duration-for-movie's own og:preserve-this
          ;; note, this file). 43 is not an *m2v-info* array position (this path
          ;; never looks *m2v-info* up by name), it is the LOGO entry TextureAnimator
          ;; reserves by convention (TextureAnimator.cpp's fmv_movie_basename); left
          ;; unset, gui-id stayed at fmv-player's own zero-initialized default (movie
          ;; index 0, "INTRO"), so duration and mirroring both keyed off the wrong
          ;; movie.
          (let ((proc (-> new-proc 0)))
            (set! (-> proc gui-id) (the uint 43))
            (set! *fmv-player* proc)
            )
          )
        )
      )
    )
  #t
  )
