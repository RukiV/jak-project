;;-*-Lisp-*-
(in-package goal)

;; name: fmv-player.gc
;; name in dgo: fmv-player
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

;; ============================================================================
;; Menu movie texture-anim arrays (issue 762): the burning-X login warning is
;; *menu-movie-texture-anim-array* going undefined at menu2's level login --
;; both arrays are retail top-level statics with no goal_src home until now
;; (retail fmv-player.o's top-level, this rung's own scoped decode,
;; allowed_objects: ["fmv-player"], scratch proj-path: labels L259/L260 for
;; *movie-texture-anim-array*, L265/L266/L272/L276 for
;; *menu-movie-texture-anim-array*). Both target the movie destination
;; texture "iscreen-video-dest": *menu-movie-texture-anim-array* array-data 0
;; is the raw movie frame itself (0 layers; fmv-player-run-texture publishes
;; into it via TextureAnimator), and *movie-texture-anim-array*'s single
;; entry composites two decorative layers ("iscreen-video-scan" and
;; "iscreen-video-noise") over that same destination -- a CRT scanline/static
;; overlay, not the video content. The other two *menu-movie-texture-anim-
;; array* entries (environment-interface-screen-02, world-water) are
;; unrelated menu2 background effects that happen to share retail's array;
;; transcribed verbatim alongside the movie entry since splitting the array
;; would not match retail's static shape. end-st-rot 6881280.0 on
;; *movie-texture-anim-array*'s noise layer is not a decode error: it is an
;; exact multiple of 65536 (105 full turns), so it wraps to the same angle as
;; 0 while still giving the interpolation a large, never-repeating-within-
;; one-cycle rotation count; kept as decoded.
;; ============================================================================
(define *movie-texture-anim-array*
  (new 'static 'texture-anim-array :type texture-anim
    (new 'static 'texture-anim
      :num-layers #x2
      :func-id 'movie-texture-anim-func
      :init-func-id 'movie-texture-anim-init
      :mip-func-id 'texture-anim-draw-mips
      :time-func #f
      :tex #f
      :tex-name "iscreen-video-dest"
      :extra (new 'static 'vector :data (new 'static 'array float 4 256.0 128.0 1.0 0.0))
      :color (new 'static 'rgba :a #x80)
      :frame-delta 300.0
      :frame-mod 150.0
      :test #x31001
      :alpha #x44
      :data (new 'static 'array texture-anim-layer 2
        (new 'static 'texture-anim-layer
          :func-id 'default-texture-anim-layer-func
          :init-func #f
          :tex #f
          :end-time 150.0
          :tex-name "iscreen-video-scan"
          :test (new 'static 'gs-test :ate #x1 :afail #x3 :zte #x1 :ztst (gs-ztest always))
          :alpha (new 'static 'gs-alpha :b #x2 :d #x1)
          :start-color (new 'static 'vector :data (new 'static 'array float 4 1.0 1.0 1.0 1.0))
          :start-scale (new 'static 'vector2 :data (new 'static 'array float 2 1.0 1.0))
          :start-offset (new 'static 'vector2 :data (new 'static 'array float 2 0.5 0.5))
          :start-st-scale (new 'static 'vector2 :data (new 'static 'array float 2 1.0 -1.0))
          :start-st-offset (new 'static 'vector2 :data (new 'static 'array float 2 0.5 0.0))
          :start-qs (new 'static 'vector :data (new 'static 'array float 4 1.0 1.0 1.0 1.0))
          :end-color (new 'static 'vector :data (new 'static 'array float 4 1.0 1.0 1.0 1.0))
          :end-scale (new 'static 'vector2 :data (new 'static 'array float 2 1.0 1.0))
          :end-offset (new 'static 'vector2 :data (new 'static 'array float 2 0.5 0.5))
          :end-st-scale (new 'static 'vector2 :data (new 'static 'array float 2 1.0 -1.0))
          :end-st-offset (new 'static 'vector2 :data (new 'static 'array float 2 0.5 1.0))
          :end-qs (new 'static 'vector :data (new 'static 'array float 4 1.0 1.0 1.0 1.0))
          )
        (new 'static 'texture-anim-layer
          :func-id 'default-texture-anim-layer-func
          :init-func #f
          :tex #f
          :end-time 150.0
          :tex-name "iscreen-video-noise"
          :test (new 'static 'gs-test :ate #x1 :afail #x1 :zte #x1 :ztst (gs-ztest always))
          :alpha (new 'static 'gs-alpha :b #x2 :d #x1)
          :start-color (new 'static 'vector :data (new 'static 'array float 4 1.0 1.0 1.0 1.0))
          :start-scale (new 'static 'vector2 :data (new 'static 'array float 2 1.0 1.0))
          :start-offset (new 'static 'vector2 :data (new 'static 'array float 2 0.5 0.5))
          :start-st-scale (new 'static 'vector2 :data (new 'static 'array float 2 4.0 2.0))
          :start-st-offset (new 'static 'vector2 :data (new 'static 'array float 2 8.0 0.0))
          :start-qs (new 'static 'vector :data (new 'static 'array float 4 1.0 1.0 1.0 1.0))
          :end-color (new 'static 'vector :data (new 'static 'array float 4 1.0 1.0 1.0 1.0))
          :end-scale (new 'static 'vector2 :data (new 'static 'array float 2 1.0 1.0))
          :end-offset (new 'static 'vector2 :data (new 'static 'array float 2 0.5 0.5))
          :end-st-scale (new 'static 'vector2 :data (new 'static 'array float 2 4.0 2.0))
          :end-st-offset (new 'static 'vector2 :data (new 'static 'array float 2 0.0 8.0))
          :end-qs (new 'static 'vector :data (new 'static 'array float 4 1.0 1.0 1.0 1.0))
          :end-st-rot 6881280.0
          )
        )
      )
    )
  )

