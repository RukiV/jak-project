;;-*-Lisp-*-
(in-package goal)

;; name: fmv-player.gc
;; name in dgo: fmv-player
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

;; og:preserve-this bring-up stub: fmv-player-run-texture is a declaration-
;; side extern with no defun anywhere (the extern-no-defun class, issue 551).
;; The live call site is scene.gc:1195, inside (enter wait scene-player)'s
;; (when (-> self scene ipu) ...) branch; 12 landed tsk-scenes in
;; task-scenes.gc carry a non-#f :ipu, so any of them reaching that line
;; jumped straight to address 0 and killed gk. This is NOT retail's body:
;; retail's fmv-player.o defines roughly 20 functions and none of them are
;; landed here. Returning #f disarms the landmine without claiming FMV
;; playback works; retires when the real FMV landing (issue 569) lands the
;; actual body.
(defun fmv-player-run-texture ((arg0 int) (arg1 process-tree))
  #f
  )

;; ============================================================================
;; L2 FMV frame path (issue 569): the TBP allocation, the fullscreen quad, and a
;; REPL probe that emits one code-87 (fmv-frame) record for a given elapsed-ms.
;; This is the C++-reader landing; the real fmv-player process (init-by-other,
;; playing/die states, clock, pad-skip) is L3's. See TextureAnimator.cpp's
;; handle_fmv_frame and MjvVideoReader.{h,cpp} for the runtime side.
;; ============================================================================

;; og:preserve-this
;; The sentinel tbp doubles as the fmv-frame record's dest field and the quad's
;; tex0.tbp0 -- both sides must name the same value. An early design draft used a
;; fixed constant (#x10000): wrong and unsafe, since gs-tex0's tbp0 is a 14-bit
;; field on both sides (gs.gc:634, common/dma/gs.h:270) and truncates #x10000 to 0
;; the instant it packs into a real adgif, while TexturePool::m_textures is a fixed
;; 32768-entry array with no bounds check in move_existing_to_vram
;; (TexturePool.h:376, TexturePool.cpp:94-97) -- 65536 would be an out-of-bounds
;; write the moment force-to-gpu publishes it. allocate-blocks (the cloud-clut
;; precedent at texture-anim.gc:3113) gives a real, unique VRAM key instead; the L1
;; spike measured it deterministic at 896 across two boot sessions (issue 569
;; comment).
(define *fmv-tbp* (the-as uint 0))

(defun fmv-get-tbp ()
  "Lazily allocate the FMV sentinel tbp on first use (needs *level* loaded, so
   this cannot run at file-load time)."
  (when (zero? *fmv-tbp*)
    (set! *fmv-tbp*
          (the-as uint (allocate-blocks (-> *level* level-default texture-page-dir 9 page) 128))
          )
    )
  *fmv-tbp*
  )

;; og:preserve-this
;; Fullscreen quad sampling the FMV sentinel tbp. Copies draw-color-bars'
;; (blit-displays.gc:809-857) proven DMA shape with two deliberate divergences: a
;; hand-built tex0 via dma-buffer-add-gs-set instead of adgif-shader<-texture-simple!
;; (there is no retail texture/adgif for FMV content to hijack -- both ends of this
;; pipeline are authored), and tcc=0 (JPEG carries no alpha; stb_image writes 255,
;; and tcc=0 keeps that out of the blender). bucket794 is draw-color-bars' own
;; bucket; tw/th/tbw are set for GS-register completeness but proven NOT to affect
;; sampling on this renderer -- DirectRenderer only reads tbp0/psm/tcc/tfx off tex0
;; and normalizes UV by the bound GL texture's real size, not by tw/th (L1 spike,
;; issue 569 comment). 640x448 needs no power-of-two padding for the same reason.
;;
;; issue 569 follow-up (white-lines/off-center fix): the second vertex's screen
;; XYZ (the &+ 96 block below) must be the same full-screen bottom-right corner
;; draw-color-bars uses -- #x9000/#x8d00, i.e. vertex1's (-256,-208) plus the
;; display's own 512x416 half-extents (208.0/256.0 recur as the direct-render
;; screen bound in draw-raw-image's blit-displays.gc:900-901 and as the
;; mouse-cursor clamp in pad.gc:779-780; 416 recurs as credits-obs.gc:433's
;; set-height!). It was previously vertex1 plus the VIDEO's own raw pixel
;; dimensions (#x9800/#x8f00 = (-256+640, -208+448)) instead of the display's
;; (512,416) -- a 640x448-in-screen-units quad drawn against a 512x416 internal
;; render target. UV stays the full (0,0)-(640,448) texel range regardless (the
;; &+ 80 block): GS interpolates it linearly across whatever screen extent the
;; quad has, so the fix is scaling the whole 640x448 frame down to fill the
;; correct 512x416 quad, not cropping it. Confirmed by frame-dumping THX.MJV's
;; JPEG payload directly (all 450 frames, top/bottom 16/4 rows) with zero
;; brightness anomalies, ruling out the transcoder/decoded-pixel path.
(defun fmv-draw-quad ()
  (let ((tbp (fmv-get-tbp)))
    (with-dma-buffer-add-bucket ((buf (-> *display* frames (-> *display* on-screen) global-buf))
                                 (bucket-id bucket794)
                                 )
      (dma-buffer-add-gs-set buf
        (test-1 (new 'static 'gs-test :ate #x1 :afail #x3 :zte #x1 :ztst (gs-ztest always)))
        (alpha-1 (new 'static 'gs-alpha))
        (tex0-1 (new 'static 'gs-tex0 :tbp0 tbp :tbw 10 :psm (gs-psm ct32) :tw 10 :th 9 :tcc 0))
        (tex1-1 (new 'static 'gs-tex1 :mmag #x1 :mmin #x1))
        (clamp-1 (new 'static 'gs-clamp :wms (gs-tex-wrap-mode clamp) :wmt (gs-tex-wrap-mode clamp)))
        (texflush 0)
        )
      (let ((v1-8 (the-as object (-> buf base))))
        (set! (-> (the-as (pointer uint128) v1-8)) (-> *blit-displays-work* sprite-slow-tmpl dma-vif quad))
        (set! (-> (the-as (inline-array vector4w) v1-8) 1 quad) (-> *blit-displays-work* sprite-slow-tmpl quad 1))
        (set! (-> (the-as (inline-array vector4w) v1-8) 2 quad) (-> *blit-displays-work* color quad))
        (let ((a1-1 (the-as object (&+ (the-as pointer v1-8) 48))))
          (set! (-> (the-as (pointer int32) a1-1)) 0)
          (set! (-> (the-as (inline-array vector4w) a1-1) 0 y) 0)
          (set! (-> (the-as (inline-array vector4w) a1-1) 0 z) 0)
          (set! (-> (the-as (inline-array vector4w) a1-1) 0 w) 0)
          )
        (let ((a0-10 (the-as object (&+ (the-as pointer v1-8) 64))))
          (set! (-> (the-as (pointer int32) a0-10)) #x7000)
          (set! (-> (the-as (inline-array vector4w) a0-10) 0 y) #x7300)
          (set! (-> (the-as (inline-array vector4w) a0-10) 0 z) 0)
          (set! (-> (the-as (inline-array vector4w) a0-10) 0 w) 0)
          )
        (let ((a0-11 (the-as object (&+ (the-as pointer v1-8) 80))))
          (set! (-> (the-as (pointer int32) a0-11)) (* 640 16))
          (set! (-> (the-as (inline-array vector4w) a0-11) 0 y) (* 448 16))
          (set! (-> (the-as (inline-array vector4w) a0-11) 0 z) 0)
          (set! (-> (the-as (inline-array vector4w) a0-11) 0 w) 0)
          )
        (let ((v1-9 (the-as object (&+ (the-as pointer v1-8) 96))))
          (set! (-> (the-as (pointer int32) v1-9)) #x9000)
          (set! (-> (the-as (inline-array vector4w) v1-9) 0 y) #x8d00)
          (set! (-> (the-as (inline-array vector4w) v1-9) 0 z) 0)
          (set! (-> (the-as (inline-array vector4w) v1-9) 0 w) 0)
          )
        )
      (&+! (-> buf base) 112)
      )
    )
  (none)
  )

;; og:preserve-this
;; L2 REPL probe (issue 569): emits one texture-anim-pc-fmv-frame record (code 87)
;; with the given elapsed-ms, driving C++'s handle_fmv_frame to decode and publish
;; that frame of THX.MJV at the FMV sentinel tbp. One-shot: the uploaded texture
;; stays resident in TextureAnimator's VramEntry/TexturePool until the next
;; upload, so a single call is enough to change what fmv-draw-quad samples -- no
;; per-frame re-emission needed. Wrapped exactly like the L1 spike's proven upload
;; shape: tex-lcom-sky-pre is the TextureUploadHandler bucket that consumes
;; pc-port codes; bucket794 (fmv-draw-quad's bucket) is a plain DirectRenderer
;; with nothing listening for them.
;;
;; Parameter is int, not uint: GOAL's top-level typechecker rejects a bare integer
;; literal (always typed int) as a uint argument with no implicit widening, and the
;; whole point of this probe is to be callable from the REPL as (fmv-debug-show-ms
;; 7500) per fmv-design.md 5f. Cast to uint only where the record field needs it.
;;
;; L3 (issue 569) keeps this standalone rather than folding it into the playing
;; state: playing computes its own elapsed-ms from the real clock and emits its
;; own record inline (same shape, different source of truth), so this stays a
;; general "poke an arbitrary elapsed-ms at the sentinel tbp" REPL lever, useful
;; for the other 42 movies later or for probing a frame without a live process.
(defun fmv-debug-show-ms ((elapsed-ms int))
  (let ((tbp (fmv-get-tbp)))
    (with-dma-buffer-add-bucket ((buf (-> *display* frames (-> *display* on-screen) global-buf))
                                 (bucket-id tex-lcom-sky-pre)
                                 )
      (pc-texture-anim-flag start-anim-array buf)
      (pc-texture-anim-flag fmv-frame buf :qwc 1)
      (let ((rec (the texture-anim-pc-fmv-frame (-> buf base))))
        (set! (-> rec elapsed-ms) (the uint elapsed-ms))
        (set! (-> rec dest) tbp)
        (set! (-> rec width) 640)
        (set! (-> rec height) 448)
        (set! (-> rec movie-id) 0)
        (set! (-> rec stop) 0)
        )
      (&+! (-> buf base) 16)
      (pc-texture-anim-flag finish-anim-array buf)
      )
    )
  (none)
  )

;; ============================================================================
;; L3 fmv-player process (issue 569): init-by-other, the playing/die states, the
;; playback clock, and the pad-skip check. This section used to carry R7's rule
;; (fmv-design.md): "this must never set *fmv-player* or touch scene.gc -- both
;; stay reserved for the later milestone that wires the retail call site at
;; scene.gc:1195." The jakx-fmv-boot-movies rung (issue 569/729) IS that later
;; milestone for the *fmv-player* half: fmv-player-run above now sets it for
;; real, so title-obs's (while *fmv-player* (suspend)) waits actually wait and
;; actually stop. scene.gc itself is untouched by this rung and stays reserved.
;; ============================================================================

;; og:preserve-this
;; FMV playback duration cap (design R4), retiring the single FMV-THX-DURATION-
;; MS constant this replaced. The old constant's own comment attributed a
;; 25 fps figure to "the transcode's own sequence header" -- wrong: the
;; jakx-fmv-boot-movies rung read the real MPEG-2 sequence header bytes
;; directly (iso_data/jakx/STR/{THX,INTRO}.M2V, startcode 000001B3, the 4-bit
;; frame_rate_code field after the 12+12-bit width/height and 4-bit aspect)
;; and both report frame_rate_code=0x4 (30000/1001, 29.97 fps). The 25 fps
;; figure was ffprobe's avg_frame_rate estimate, a heuristic fallback ffprobe
;; uses on a raw elementary stream with no container-level duration, and it
;; visibly disagrees with ffprobe's own r_frame_rate=30000/1001 (tbr, which
;; DOES match the real header) -- confirming avg_frame_rate was always the
;; wrong of the two, not a genuinely ambiguous pair of candidates.
;;
;; duration_ms = frame_count * 1000 * fps_den / fps_num, integer-truncated;
;; frame_count is a direct picture_start_code (000001 00) count, cross-checked
;; against `ffprobe -count_frames`:
;;   THX.M2V:   450  frames -> 450  * 1000 * 1001 / 30000 = 15015 ms exactly
;;   INTRO.M2V: 7274 frames -> 7274 * 1000 * 1001 / 30000 = 242709 ms (true
;;     value 242709.1333..., truncated; the lost fraction is under 1 ms, far
;;     inside one frame's 33.37 ms, and MjvVideoReader clamps any elapsed-ms
;;     past the last frame to the measured-black final frame regardless).
;; introb and the other 41 *m2v-info* movies have no jakx-fmv-boot-movies
;; measurement (out of this rung's scope); FMV-DEFAULT-DURATION-MS keeps the
;; old constant's own conservative value for them pending a later rung.
(defconstant FMV-THX-DURATION-MS 15015)
(defconstant FMV-INTRO-DURATION-MS 242709)
(defconstant FMV-DEFAULT-DURATION-MS 18500)

;; og:preserve-this per-movie duration lookup, keyed by the gui-id "movie
;; index" fmv-player-run sets at spawn (m2v-info-index-by-name's own array
;; position, fmv-player-h.gc's static order: "intro" is position 0, "thx" is
;; position 42). Hardcoding those two positions here rather than re-deriving
;; them by name every call is safe: *m2v-info* is a fixed static array, its
;; order cannot change at runtime.
(defun fmv-duration-for-movie ((movie-idx uint))
  (cond
    ((= movie-idx (the uint 42)) FMV-THX-DURATION-MS)
    ((= movie-idx (the uint 0)) FMV-INTRO-DURATION-MS)
    (else FMV-DEFAULT-DURATION-MS)
    )
  )

;; og:preserve-this
;; fmv-player's deftype (fmv-player-h.gc:43-58, mirrored at
;; decompiler/config/jakx/all-types.gc:41035-41053) declares no (:state-methods)
;; and its :method-count-assert is exactly 20 -- process's own methods plus
;; fmv-player-method-15..19, nothing more. Retail never virtualized these two
;; states: adding (:state-methods playing die) to the deftype would grow the
;; method count past what all-types.gc asserts and redden JakXTypeConsistency,
;; and the jakx-behavior-state-typing finding is that jakx ships zero
;; (:state-methods) declarations tree-wide, so a bare process type is the norm
;; here, not a gap. playing/die are therefore plain (non-virtual) defstates
;; entered with (go ...), the same shape camera-combiner (camera-h.gc:478, also
;; no :state-methods) uses for cam-combiner-active -- not go-virtual, which
;; would need a virtual method slot this type does not declare.
;;
;; Non-virtual (go ...) resolves its target as an ordinary global symbol at
;; compile time (unlike go-virtual's runtime method-of-object lookup), so
;; unlike credits-obs' virtual running/die pair, these three definitions
;; cannot share that pair's file order: die must land before playing (playing
;; calls (go die)), and playing must land before fmv-player-init-by-other
;; (which calls (go playing)). Landed in that dependency order below, not in
;; the init/playing/die reading order the design doc lists them in.

;; og:preserve-this
;; FMV debug-text clobber (issue 569's white-lines closure). The frame upload
;; at the sentinel TBP (fmv-get-tbp, shared by fmv-draw-quad and both states
;; below) lands in the same VRAM the font tpage samples, so the three
;; *display-camera-info* debug lines (targ pos / cam pos / string info,
;; cam-update.gc:553-591) render as solid bars for the duration of playback --
;; the video itself is correct since the quad fix. *display-camera-info* is
;; the single flag gating all three print sites (main-h.gc:5883, no per-line
;; gate exists), so blank it for exactly the playing state's lifetime instead
;; of touching the print sites: playing saves the caller's setting and clears
;; it the instant :code starts, die restores it. die is the only (go die)
;; target from playing -- both the pad-skip and the duration-timeout exits
;; route through it -- so it is the single place the restore needs to live.
(define *fmv-saved-display-camera-info* #f)

;; og:preserve-this
;; Emits one stop=1 record so handle_fmv_frame closes the C++ reader, then
;; falls off the end of :code -- the credits-obs self-termination shape
;; (credits-obs.gc:668-674, confirmed at design 5d): a :code behavior returning
;; naturally kills the process with no self-deactivate needed. No draw call
;; here, so this is also the frame FMV output stops appearing. width/height are
;; moot: handle_fmv_frame checks stop before it ever reads them (design 3c
;; step 2); movie-id is carried through anyway for record-shape symmetry with
;; playing's own emission. Restoring *display-camera-info* here first (see the
;; debug-text-clobber note above playing's :code) undoes the overlay blank for
;; both of playing's exits, since both route through this state. Clearing
;; *fmv-player* here (fmv-boot-movies rung, retiring the R7 "never set
;; *fmv-player*" rule above) is what lets title-obs's (while *fmv-player*
;; (suspend)) waits actually stop waiting once the movie ends.
(defstate die (fmv-player)
  :code (behavior ()
    (set! *display-camera-info* *fmv-saved-display-camera-info*)
    (set! *fmv-player* (the-as fmv-player #f))
    (let ((tbp (fmv-get-tbp)))
      (with-dma-buffer-add-bucket ((buf (-> *display* frames (-> *display* on-screen) global-buf))
                                   (bucket-id tex-lcom-sky-pre)
                                   )
        (pc-texture-anim-flag start-anim-array buf)
        (pc-texture-anim-flag fmv-frame buf :qwc 1)
        (let ((rec (the texture-anim-pc-fmv-frame (-> buf base))))
          (set! (-> rec elapsed-ms) 0)
          (set! (-> rec dest) tbp)
          (set! (-> rec width) 640)
          (set! (-> rec height) 448)
          (set! (-> rec movie-id) (-> self gui-id))
          (set! (-> rec stop) 1)
          )
        (&+! (-> buf base) 16)
        (pc-texture-anim-flag finish-anim-array buf)
        )
      )
    )
  )

;; og:preserve-this
;; elapsed-ms is derived from (current-time), never stored: start-time (set
;; once, at init-by-other) is the only clock state fmv-player keeps, matching
;; the retail field's own semantics (fmv-player-h.gc:48). (current-time) reads
;; -> PP clock frame-counter, which counts real elapsed time in 1/300ths of a
;; second regardless of achieved framerate (TICKS_PER_SECOND, gkernel-h.gc:109,
;; and the frame-counter doc comment above it) -- not a 60Hz-assumed frame
;; count, which is the trap fmv-design.md 5d warns against. ms = ticks *
;; 1000/300, reduced to ticks * 10/3; recomputed fresh from the exact tick
;; delta every frame rather than accumulated, so integer-division truncation
;; can't drift.
(defstate playing (fmv-player)
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('go-die)
       (go die)
       )
      )
    )
  :code (behavior ()
    (set! *fmv-saved-display-camera-info* *display-camera-info*)
    (set! *display-camera-info* #f)
    (until #f
      (let* ((elapsed-ticks (- (current-time) (the-as time-frame (-> self start-time))))
             (elapsed-ms (the int (/ (* elapsed-ticks 10) 3)))
             )
        (cond
          ((or (cpad-pressed? 0 triangle circle x) (> elapsed-ms (fmv-duration-for-movie (-> self gui-id))))
           (go die)
           )
          (else
            (let ((tbp (fmv-get-tbp)))
              (with-dma-buffer-add-bucket ((buf (-> *display* frames (-> *display* on-screen) global-buf))
                                           (bucket-id tex-lcom-sky-pre)
                                           )
                (pc-texture-anim-flag start-anim-array buf)
                (pc-texture-anim-flag fmv-frame buf :qwc 1)
                (let ((rec (the texture-anim-pc-fmv-frame (-> buf base))))
                  (set! (-> rec elapsed-ms) (the uint elapsed-ms))
                  (set! (-> rec dest) tbp)
                  (set! (-> rec width) 640)
                  (set! (-> rec height) 448)
                  (set! (-> rec movie-id) (-> self gui-id))
                  (set! (-> rec stop) 0)
                  )
                (&+! (-> buf base) 16)
                (pc-texture-anim-flag finish-anim-array buf)
                )
              )
            (fmv-draw-quad)
            (suspend)
            )
          )
        )
      )
    )
  )

;; definition for function fmv-player-init-by-other
(defbehavior fmv-player-init-by-other fmv-player ()
  (set! (-> self texture-base-page) (fmv-get-tbp))
  (set! (-> self texture-width) 640)
  (set! (-> self start-time) (the-as uint (current-time)))
  (set! (-> self fmv-mode) 1)
  (go playing)
  )

;; og:preserve-this fmv-boot-movies rung (issue 569/729): fmv-player-run's
;; real retail body still cannot land whole -- this rung's own scoped decode
;; (allowed_objects: ["fmv-player"], scratch proj-path, reverted) confirms the
;; prior rung's account: most of the function is FMVLEV-level texture-page
;; resolution and aspect-ratio-dependent matrix setup writing into *fmv-work*
;; at offset 84 before running out of field-layout evidence for that global,
;; plus disc-path string construction (demo?/scf-get-territory-gated
;; "~S.m2v"/"~S.pal" formatting via *fmv-snd-name*/*fmv-m2v-name*) that has no
;; PC-port counterpart now that MJV containers replace disc M2V streaming --
;; squarely the no-M2V-decoder-exists FMV-road scope, not a call this rung
;; could land whole.
;;
;; The op-level evidence for the parts this port DOES port is direct, though
;; (same scoped decode, fmv-player_ir2.asm):
;;   ops 0-6:     (kill-by-type fmv-player *active-pool*) verbatim, first thing
;;                the function does -- ported as-is below.
;;   ops 141-168: the *m2v-info* lookup loop compares arg0 against each
;;                entry's SOUND field first (machine offset +4 off the boxed
;;                entry pointer, placed offset 8) via nocase-string=, then
;;                falls back to the NAME field (machine +0, placed +4) if that
;;                misses -- ported below as the (or ... ...) in
;;                m2v-info-index-by-name. Every landed caller (title-obs.gc's
;;                target-intro/target-introb) passes a name-matching string
;;                ("thx"/"intro"/"introb"), so the sound-field branch never
;;                actually matches for any call this rung can exercise, but
;;                it is real retail behavior, not invented, and costs nothing
;;                to keep.
;;   ops 253-277/293-317: get-process/activate/run-function-in-process against
;;                *default-dead-pool*, stack size #x4000, tag "fmv-player",
;;                stack top *dram-stack*+#x3800 -- exactly process-spawn's own
;;                macro expansion (gstate.gc:33-53), landed below as
;;                (process-spawn fmv-player :init fmv-player-init-by-other
;;                :name "fmv-player" :to arg1).
;;
;; HELD discrepancy, not fixed by this rung: both call sites at ops 270-277
;; and 310-317 pass run-function-in-process FOUR extra args (#t, 0, 10, and
;; either 2 or 1 depending on which branch), meaning retail's real
;; fmv-player-init-by-other takes at least 4 parameters. The init-by-other
;; landed just above (a genuine retail decode, not hand-authored -- no
;; og:preserve-this header, zero args) takes zero -- a defect in the rung
;; that landed it, surfaced by this scoped decode, not introduced here.
;; Fixing it needs field-layout evidence for what those 4 values initialize
;; that this rung does not have; flagged for a follow-up rather than
;; silently patched. This body calls the zero-arg init-by-other as currently
;; landed, since that is the only callable contract that exists in this tree
;; today. process-spawn needs its :init callee already defined in this file
;; (GOAL does not hoist forward references to same-file globals), which is
;; also why this function lands here, after init-by-other, rather than near
;; fmv-player-run-texture above.
;;
;; Also not replicated: ops 139-147, a pre-loop check that re-parents an
;; already-live *fmv-player* into arg1's pool and returns early instead of
;; spawning a new one. Unreachable by every landed caller (each already
;; suspends on (while *fmv-player* (suspend)) until die above clears it, so
;; *fmv-player* is always #f by the time the next fmv-player-run call runs);
;; omitted rather than ported blind.
;;
;; og:preserve-this (issue 569): fmv-player-run makes no DMA reservation in
;; retail -- this rung's own scoped decode (fmv-player_ir2.asm) shows no
;; dma-try-alloc call anywhere inside the function. The 'fmv-player DMA tag
;; belongs to lobby-menu-manager.gc's own IPU logo path instead: it reserves
;; the tag itself (dma-try-alloc 'fmv-player, :356 and :838) and releases it
;; itself (dma-release 'fmv-player, :767, :835, :2550), never fmv-player-run.
;; A prior version of this port added a per-call dma-try-alloc/suspend-until-
;; success loop here anyway, on the mistaken assumption the tag needed
;; reserving before every spawn; it leaked, because nothing here or in die
;; ever releases it and title-obs.gc:1151-1159 calls fmv-player-run twice
;; back to back with no release between the two calls. Observed live:
;; fmvboot-plain-1.log shows THX playing cleanly to completion (exactly 450
;; "[fmv] decode frame N" lines, 0 through 449) and then the boot stalling
;; forever -- no second "decode frame 0", no menu2 level load, *fmv-player*
;; reading #f at attach, 315 idle Kernel dispatch lines and no crash -- the
;; target's :code spinning inside the leaked reservation's wait loop on the
;; "intro" call, since the "thx" call's own reservation was never released.
;; The L3 THX spike played from a bare process-spawn with no reservation of
;; any kind, and on PC the MJV frames arrive through TextureAnimator's own
;; handle_fmv_frame, which needs no DMA reservation at all -- this is not a
;; retail behavior a PC-port body needs to reconstruct. The kill-by-type-
;; then-process-spawn shape below is still title-control-spawn's own proven
;; shape (title-obs.gc:200-211) for a singleton title-adjacent process.
;;
;; The "movie index" carried in gui-id (fmv-mode is already claimed, set to 1
;; by init-by-other above) is m2v-info-index-by-name's array position -- NOT
;; the :name-mate :idx field (game-info.gc:575-581 shows :idx is a UI
;; "currently selected" flag reset to 0 on every entry then set to 1 on entry
;; 0 alone, unrelated to identity, and confirmed unrelated by this rung's own
;; decode: the lookup loop indexes *m2v-info* by a plain incrementing
;; counter, never reads :idx at all). gui-id is read back by playing/die
;; above when they emit the frame record's movie-id, and by TextureAnimator's
;; own movie-id -> MJV-basename table (jakx-fmv-boot-movies rung 2, same
;; array order).
(defun m2v-info-index-by-name ((name string))
  "Array position of the *m2v-info* entry whose :sound or :name matches
   (retail's own lookup order, ops 141-168), or -1."
  (let ((found -1))
    (dotimes (i (-> *m2v-info* length))
      (when (and (= found -1)
                 (or (nocase-string= name (the-as string (-> *m2v-info* i sound)))
                     (nocase-string= name (the-as string (-> *m2v-info* i name)))
                     )
                 )
        (set! found i)
        )
      )
    found
    )
  )

(defun fmv-player-run ((arg0 string) (arg1 process-tree) (arg2 symbol))
  (kill-by-type fmv-player *active-pool*)
  (let ((movie-idx (m2v-info-index-by-name arg0)))
    (when (>= movie-idx 0)
      ;; process-spawn's own value (gstate.gc:33-53) is (the (pointer fmv-player)
      ;; (-> new-proc ppointer)) -- a pointer TO the process-tree slot holding the
      ;; process, not the process itself; (-> new-proc 0) is the deref every landed
      ;; caller uses (lobby-menu-manager.gc's lmm-make-logo-menu: (process->handle
      ;; (-> v1-9 0)) off the same ppointer-typed local). gui-id is set before
      ;; *fmv-player* is published: run-now-in-process (inside process-spawn) runs
      ;; fmv-player-init-by-other synchronously, and init-by-other's own (go playing)
      ;; only schedules playing's :code for the next kernel dispatch rather than
      ;; running it inline (go's doc comment, gstate.gc:8-11) -- neither init-by-
      ;; other nor playing reads gui-id before that next dispatch, so the ordering
      ;; here is not a race, but publishing gui-id first keeps it that way even if
      ;; something is added later that reads *fmv-player* the instant it goes
      ;; non-#f.
      (let ((new-proc (process-spawn fmv-player :init fmv-player-init-by-other :name "fmv-player" :to arg1)))
        (when new-proc
          (let ((proc (-> new-proc 0)))
            (set! (-> proc gui-id) (the uint movie-idx))
            (set! *fmv-player* proc)
            )
          )
        )
      )
    )
  #t
  )
