;; definition for function part-water-splash-callback
;; WARN: Return type mismatch int vs none.
;; og:preserve-this gpr->fpr replaced with a direct (the-as float ...) bit
;; reinterpret: the compiler's own gpr->fpr only accepts a compile-time-immediate
;; int (it compiled fine on a literal elsewhere in this rung's own work, e.g.
;; construction-obs-h), not a general runtime expression like this field read.
;; the-as performs the identical raw reinterpret without that restriction.
(defun part-water-splash-callback ((arg0 part-tracker))
  (let ((f1-0 (-> arg0 root trans y))
        (f0-0 (the-as number (the-as float (-> arg0 userdata))))
        )
    (set! (-> *part-id-table* 157 init-specs 16 initial-valuef) f1-0)
    (set! (-> *part-id-table* 157 init-specs 1 initial-valuef) (* 12.0 (the-as float f0-0)))
    )
  0
  (none)
  )

;; definition for function splash-spawn
;; INFO: Used lq/sq
;; WARN: Return type mismatch int vs none.
(defun splash-spawn ((arg0 float) (arg1 vector) (arg2 int))
  (set! (-> *launch-matrix* trans quad) (-> arg1 quad))
  (set! (-> *part-tracker-params-default* group) (if (zero? arg2)
                                                     (-> *part-group-id-table* 27)
                                                     (-> *part-group-id-table* 26)
                                                     )
        )
  (vector-reset! (-> *part-tracker-params-default* local-offset))
  (set! (-> *part-tracker-params-default* duration) (the-as uint 0))
  (set! (-> *part-tracker-params-default* callback)
        (the-as (function part-tracker vector) part-water-splash-callback)
        )
  (set! (-> *part-tracker-params-default* userdata) (the-as uint arg0))
  (set! (-> *part-tracker-params-default* target) #f)
  (set! (-> *part-tracker-params-default* mat-joint) *launch-matrix*)
  (set! (-> *part-tracker-params-default* local-space-param) 0)
  (set! (-> *part-tracker-params-default* local-space-callback) #f)
  (set! (-> *part-tracker-params-default* subsampler-num) 1.0)
  *part-tracker-params-default*
  (if (logtest? (-> (if (zero? arg2)
                        (-> *part-group-id-table* 27)
                        (-> *part-group-id-table* 26)
                        )
                    flags
                    )
                (sp-group-flag sp13)
                )
      (process-spawn
        part-tracker-subsampler
        :init part-tracker-subsampler-init
        *part-tracker-params-default*
        :name "part-tracker-subsampler"
        :to *entity-pool*
        :unk 0
        )
      (process-spawn
        part-tracker
        :init part-tracker-init
        *part-tracker-params-default*
        :name "part-tracker"
        :to *entity-pool*
        :unk 0
        )
      )
  0
  (none)
  )

;; definition for function rings-water-spawn
;; INFO: Used lq/sq
;; WARN: Return type mismatch int vs none.
(defun rings-water-spawn ((arg0 float) (arg1 vector) (arg2 vector) (arg3 float) (arg4 float))
  (let* ((v1-0 arg2)
         (f30-0 (sqrtf (+ (* (-> v1-0 x) (-> v1-0 x)) (* (-> v1-0 z) (-> v1-0 z)))))
         )
    (set! (-> *part-id-table* 139 init-specs 4 initial-valuef) (+ 24576.0 arg0))
    (set! (-> *part-id-table* 139 init-specs 19 initial-valuef) (+ 49152.0 arg0))
    (set! (-> *part-id-table* 139 init-specs 1 initial-valuef) (* 0.0000036621095 f30-0))
    (set! (-> *part-id-table* 139 init-specs 2 initial-valuef) (/ f30-0 10))
    (set! (-> *part-id-table* 139 init-specs 13 initial-valuef) 0.7111111)
    (set! (-> *part-id-table* 139 init-specs 3 initial-valuef) arg3)
    (set! (-> *part-id-table* 139 init-specs 5 initial-valuef) arg3)
    (launch-particles :system *sp-particle-system-3d* (-> *part-id-table* 139) arg1)
    (set! (-> *part-id-table* 142 init-specs 1 initial-valuef) (* 0.000004150391 f30-0))
    (set! (-> *part-id-table* 142 init-specs 16 initial-valuef) arg0)
    (launch-particles :system *sp-particle-system-3d* (-> *part-id-table* 142) arg1)
    (when (< f30-0 4096.0)
      (set! (-> *part-id-table* 138 init-specs 2 random-rangef) arg4)
      (launch-particles :system *sp-particle-system-3d* (-> *part-id-table* 138) arg1)
      )
    )
  0
  (none)
  )


;; og:preserve-this find-water-1 and find-water-2 declared as externs, called
;; by find-water-with-spheres below: both stay unlanded (see the note above
;; find-water-with-spheres for the full status of this rung's remaining
;; markers), so the call sites need a symbol to resolve against even with no
;; body provided yet.
(define-extern find-water-1 (function water-sphere water-info water-info symbol))
(define-extern find-water-2 (function (inline-array water-sphere) int water-info water-info process-drawable water-info))

;; og:preserve-this water-info<-region, find-water-1, find-water-2,
;; find-water-simple and (method 52 collide-shape) (water-info-init!) all
;; stay unlanded past this point. water-info<-region walks a resource-tag
;; property list (car/cdr chains resolved as far as pair casts reach, but
;; the property count is not fully known and each one needs its own chain
;; of casts, diminishing returns for this rung); find-water-1 and find-water-2
;; both read a fixed address (0x70000000) whose symbol this rung could not
;; identify with confidence; find-water-simple never converts to expressions
;; at all (a genuine CFG wall, same class as water-anim-event-handler);
;; method 52 of collide-shape (water-info-init!) depends on find-water-1 and
;; find-water-2 plus an anonymous 480-byte all-zero static scratch buffer
;; (water_ir2.asm label L102) this rung did not confidently type or name.
;; WARN: Return type mismatch int vs object.
(defun find-water-with-spheres ((arg0 (inline-array water-sphere)) (arg1 int) (arg2 water-info))
  (let ((s3-0 (new 'stack-no-clear 'water-info)))
    (if (not arg2)
        (set! arg2 (new 'static 'water-info))
        )
    (if (find-water-1 (the-as water-sphere (+ (the-as uint arg0) (* (+ arg1 -1) 16))) arg2 s3-0)
        (find-water-2 arg0 arg1 arg2 s3-0 (the-as process-drawable #f))
        )
    )
  0
  )
