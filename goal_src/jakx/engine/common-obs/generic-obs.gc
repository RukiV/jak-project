      (vector-normalize! s2-0 (-> this root scale x))
      (vector-normalize! s3-0 (-> this root scale y))
      (let ((v1-8 (-> this strip data)))
        (let ((a0-8 s4-0))
          (let ((a1-5 (-> this root trans))
                (a2-0 s2-0)
                )
            (.lvf vf4 (&-> a1-5 quad))
            (.lvf vf5 (&-> a2-0 quad))
            )
          (.mov.vf.w vf6 vf0)
          (.add.vf.xyz vf6 vf4 vf5)
          (.svf (&-> a0-8 quad) vf6)
          )
        (let ((a2-1 s4-0))
          (let ((a0-9 s4-0)
                (a1-6 s3-0)
                )
            (.lvf vf4 (&-> a0-9 quad))
            (.lvf vf5 (&-> a1-6 quad))
            )
          (.mov.vf.w vf6 vf0)
          (.add.vf.xyz vf6 vf4 vf5)
          (.svf (&-> a2-1 quad) vf6)
          )
        (set! (-> v1-8 0 pos quad) (-> s4-0 quad))
        (set! (-> v1-8 0 stq z) 0.0)
        (set! (-> v1-8 0 stq x) 0.0)
        (set! (-> v1-8 0 stq y) 0.0)
        (set! (-> v1-8 0 col) s5-0)
