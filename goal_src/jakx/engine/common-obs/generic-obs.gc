  (set! (-> self root trans quad) (-> arg0 quad))
  (set! (-> self duration) (the-as uint arg2))
  (set! (-> self target) (the-as handle #f))
  (set! (-> self event) #f)
  (set! (-> self callback) #f)
  (set! (-> self run-function)
        (lambda :behavior touch-tracker
          ()
          (not (time-elapsed? (-> self state-time) (the-as time-frame (-> self duration))))
          )
        )
  (set! (-> self event-hook) (-> (method-of-object self active) event))
  (go-virtual active)
