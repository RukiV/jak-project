;;-*-Lisp-*-
(in-package goal)

;; name: generic-obs.gc
;; name in dgo: generic-obs
;; dgos: ENGINE, GAME

;; the debug actor editor (spartacus-editor.o) is not landed; its global is only
;; ever read behind *debug-segment* / nonzero? gates here.
(define-extern *spartacus-editor* object)

;; defined in entity.gc, which builds after this file
(define-extern process-entity-status! (function process entity-perm-status symbol entity-perm-status))
(define-extern process-entity-set! (function process entity entity))
(define-extern process-drawable-from-entity! (function process-drawable entity-actor none))

;; defined in collide-shape.gc, which is still a stub (jak3's generic-obs carries the same extern)
(define-extern cshape-reaction-default (function control-info collide-query vector vector collide-status))

(define-extern make-sound-instance (function sound-info sound-id handle sound-instance)) ;; gsound.gc

;; DECOMP BEGINS

;; og:preserve-this bring-up state: parked processes sleep here instead of dying.
;; Going empty-state (whose code returns) deactivates the process, the entity
;; loses it, and the actor birth loop re-births it every frame; marking the perm
;; dead instead trips the kill path. A live sleeping process is the quiet option.
;; Delete together with the park guards when the part-group legs land.
(defstate bring-up-parked (process)
  :code sleep-code
  )

(define *part-tracker-params-default* (new 'static 'part-tracker-init-params))

(define *part-tracker-subsampler-params-default* (new 'static 'part-tracker-init-params))

(defskelgroup skel-spotlight spotlight -1 -1 ((-1 (meters 999999))) :bounds (static-spherem 0 0 0 10))

;; og:preserve-this permanent racer-art skelgroup (#192, #193 root-cause doc section
;; 2.5(b)): jakx-racer-spawn's donor art was skel-jungle-clay-jar-a, a defskelgroup
;; living in jungle-obs.gc, which ships only in jungle-family DGOs (jgx.gd et al, no
;; permanent DGO). On any non-jungle boot that symbol is never assigned, and the
;; symbol table is zero-filled (kmalloc(kglobalheap, ..., KMALLOC_MEMSET,
;; "symbol-table"), game/kernel/jakx/kscheme.cpp:1550), so it reads back as integer 0,
;; not #f -- the crash's real root cause, see entity.gc's spawn guard. ice-flag-ag is
;; the only ice-resident art with a complete jg/mg/ja triple (art-elts.gc:546-548):
;; ice-flag-lod0-jg, ice-flag-lod0-mg, ice-flag-idle-ja. Landed here, beside
;; skel-spotlight, the existing precedent for a hand-written skelgroup in a permanent
;; object (generic-obs.o, game.gd slot 299, compiles before entity.o at 329, so
;; entity.gc's family dispatch below needs no forward-declare for this symbol) so the
;; descriptor itself is never the null this bug is about. The bounds radius is
;; placeholder-tuned, sized by eye against the jungle jar's own (static-spherem 0 4 0
;; 8) for a smaller prop rather than measured from the actual mesh; retune once the
;; model has been seen on screen. Residency of the art itself still has to hold at
;; spawn time: ice-flag-ag ships in ICB (the "iceb-start" want set) and ICA
;; ("ice-icea-1"'s), both covered by the currently armed ice continues.
(defskelgroup skel-ice-flag ice-flag ice-flag-lod0-jg ice-flag-idle-ja
              ((ice-flag-lod0-mg (meters 999999)))
              :bounds (static-spherem 0 1 0 3)
              )

;; og:preserve-this permanent car-art skelgroup (M1 vehicle-leg rung 2): jakx-
;; vehicle-spawn's donor art is the falcon chassis, JAKVL.DGO's own body panel
;; (leg brief M1: "a single configured falcon (6 panels + one wheel)"), landed
;; here beside skel-spotlight rather than in wcar-skel.gc (still a 9-line stub,
;; sub-leg F body work, out of this rung's scope) for the same reason skel-ice-
;; flag landed beside skel-spotlight on the racer-lifecycle branch: a permanent
;; object (generic-obs.o, build order 299) that compiles before entity.o (329),
;; so jakx-vehicle-spawn needs no forward-declare for this symbol.
;;
;; Transcribed verbatim from a scoped scratch decode of wcar-skel.o this rung
;; (allowed_objects: wcar-skel, wcar-skel-template, wcar, wcar-mongoose,
;; wcar-falcon; GAME.fr3 checked unaffected before and after, 2,111,127 B /
;; 2026-08-10 16:14), output wcar-skel_disasm.gc:249-255. The joint indices (1,
;; 6, and the three mg entries 2/3/4) are the decoder's own resolved values, not
;; named symbols: wcar-skel.o was "never captured" before this rung (leg brief
;; §2.2, zero types/externs on record) and no def-art-elt table anywhere in
;; this tree names falcon-chassis's individual elements, unlike car-interior
;; and antenna-all in the same output, which the decoder did resolve to names.
;; Numeric indices are a normal, load-bearing defskelgroup form elsewhere in
;; this same output (skel-v-snake, skel-v-snake-wheel), not a placeholder.
;;
;; This is only the chassis, one of the falcon's six panels; the doors, hood,
;; fenders, roof and trunk panels are separate art-groups in the same DGO
;; (jakvl.gd) that retail's own composition machinery (wcar-skel.gc, still
;; unlanded) joint-mods onto it. A parked chassis-only spawn is the M1 floor,
;; not the dressed car; retires once wcar-skel.gc lands the real composition.
(defskelgroup skel-falcon-chassis falcon-chassis 1 6
              ((2 (meters 20)) (3 (meters 40)) (4 (meters 999999)))
              :bounds (static-spherem 0 0 0 6)
              :shadow 5
              :origin-joint-index 3
              :shadow-joint-index 3
              )

;; WARN: Return type mismatch object vs (pointer sparticle-launch-group).
(defun entity-lookup-part-group ((arg0 entity-actor) (arg1 (pointer string)) (arg2 symbol))
  (with-pp
    (let ((gp-0 (the-as object #f)))
      ;; og:preserve-this decomp fix: sv-16 degraded to an int slot; the tag-ptr
      ;; write-back stores a 16-byte res-tag through it (8-byte stack overrun plus a
      ;; misaligned movaps hazard). jak3 generic-obs.gc:88 uses the static res-tag.
      (let* ((sv-16 (new 'static 'res-tag))
             (s4-0 (the-as object (res-lump-data arg0 arg2 pointer :tag-ptr (& sv-16)))))
        (if (and (or (not *debug-segment*)
                     (not *spartacus-editor*)
                     (and (nonzero? *spartacus-editor*)
                          (begin
                            (let ((a1-2 (new 'stack-no-clear 'event-message-block)))
                              (set! (-> a1-2 from) (process->ppointer pp))
                              (set! (-> a1-2 num-params) 1)
                              (set! (-> a1-2 message) 'get-type)
                              (set! (-> a1-2 param 0) (the-as uint arg0))
                              (set! s4-0 (send-event-function (the-as process-tree *spartacus-editor*) a1-2))
                              )
                            (not s4-0)
                            )
                          )
                     )
                 (not s4-0)
                 )
            (begin
              ;; og:preserve-this bring-up guard: retail goes process-drawable-art-error here,
              ;; but jakx part-spawner / part-tracker are plain process children (root at 144)
              ;; while art-error's enter reads process-drawable offsets (root at 188) -- on
              ;; these types that lands in unrelated float bits and segfaults the PC runtime.
              ;; Until the per-level defpart data lands, a missing part group is expected, so
              ;; park in bring-up-parked (see its doc block above for why neither empty-state
              ;; nor a dead perm works). Restore the retail go once the part-group legs land.
              (format 0 "WARNING: ~A: part group lookup failed, parking (bring-up)~%" arg0)
              (go bring-up-parked)
              )
            )
        (let ((s3-1 (-> (the-as (pointer sparticle-launch-group) s4-0) 0)))
          (cond
            ((part-group-pointer? (the-as pointer s3-1))
             (set! gp-0 (-> (the-as (pointer sparticle-launch-group) s4-0) 0))
             )
            ;; og:preserve-this bring-up hardening (#61): retail tests (-> s3-1 type)
            ;; raw (jak3 generic-obs.gc:99), safe only because retail part-group res
            ;; entries are always valid. With the per-level defpart data unlanded,
            ;; entries can hold garbage, and the raw type read followed a wild pointer
            ;; and killed the kernel (crash rip bracketed to this function via the
            ;; runtime symbol map; the report blamed script/junglebirds through the
            ;; #58 tie). valid? range-checks before any deref, so garbage falls to
            ;; the parking else below. Restore the raw test with the defpart legs.
            ((valid? s3-1 string (the-as string #f) #f 0)
             (if arg1
                 (set! (-> arg1 0) (the-as string s3-1))
                 )
             (set! gp-0 (lookup-part-group-pointer-by-name (the-as string s3-1)))
             (if (the-as (pointer object) gp-0)
                 (set! (-> (the-as (pointer sparticle-launch-group) s4-0) 0) (the-as sparticle-launch-group gp-0))
                 )
             )
            (else
              ;; og:preserve-this bring-up guard: same art-error layout hazard as above
              (format 0 "WARNING: ~A: bad part group entry, parking (bring-up)~%" arg0)
              (go bring-up-parked)
              )
            )
          )
        )
      (the-as (pointer sparticle-launch-group) gp-0)
      )
    )
  )

;; WARN: Return type mismatch int vs none.
(defbehavior clone-anim-once process-drawable ((arg0 handle) (arg1 symbol) (arg2 string))
  (logclear! (-> self skel status) (joint-control-status valid-spooled-frame))
  (let ((gp-0 (handle->process arg0)))
    (if gp-0
        (joint-control-copy! (-> self skel) (-> (the-as process-drawable gp-0) skel))
        )
    (cond
      ((and gp-0 (joint-control-remap!
                   (-> self skel)
                   (-> self draw art-group)
                   (-> (the-as process-drawable gp-0) draw art-group)
                   '()
                   0
                   arg2
                   )
            )
       (when arg1
         (let ((a0-7 (as-type (-> self root) collide-shape)))
           (if a0-7
               (move-to-point! (the-as collide-shape a0-7) (-> (the-as process-drawable gp-0) root trans))
               (set! (-> self root trans quad) (-> (the-as process-drawable gp-0) root trans quad))
               )
           )
         (quaternion-copy!
           (the-as quaternion (-> self root rot))
           (the-as quaternion (-> (the-as process-drawable gp-0) root rot))
           )
         )
       (if (logtest? (-> (the-as process-drawable gp-0) skel status) (joint-control-status valid-spooled-frame))
           (logior! (-> self skel status) (joint-control-status valid-spooled-frame))
           )
       (logclear! (-> self draw status) (draw-control-status no-draw no-draw-temp uninited))
       (if (or (zero? (-> self skel active-channels)) (not (-> self skel root-channel 0 frame-group)))
           (logior! (-> self draw status) (draw-control-status no-draw-temp))
           )
       (let ((v1-38 (as-type self manipy)))
         (if (and v1-38 (not (-> (the-as manipy v1-38) draw?)))
             (logior! (-> self draw status) (draw-control-status no-draw-temp))
             )
         )
       (update-anim-data (-> self skel))
       (do-joint-math (-> self draw) (-> self node-list) (-> self skel))
       (let ((a0-22 (-> self skel effect)))
         (if a0-22
             (effect-control-method-9 a0-22)
             )
         )
       (if (logtest? (-> self skel status) (joint-control-status blend-shape blend-shape-valid))
           (merc-blend-shape self)
           )
       (if (logtest? (-> self skel status) (joint-control-status eye-anim-valid eye-anim))
           (merc-eye-anim self)
           )
       (cloth-post)
       )
      (else
        (set! (-> self skel active-channels) (the-as uint 0))
        (logior! (-> self draw status) (draw-control-status no-draw))
        (ja-post)
        )
      )
    )
  0
  (none)
  )

;; WARN: Return type mismatch int vs none.
(defbehavior clone-anim process-drawable ((arg0 handle) (arg1 symbol) (arg2 string))
  (ja-post)
  (while (handle->process arg0)
    (clone-anim-once arg0 #t arg2)
    (suspend)
    )
  (logclear! (-> self skel status) (joint-control-status valid-spooled-frame))
  0
  (none)
  )

(defstate die (process-hidden)
  :virtual #t
  :code nothing
  )

(defmethod init-from-entity! ((this process-hidden) (arg0 entity-actor))
  "Copy defaults from the entity."
  (process-entity-status! this (entity-perm-status dead) #t)
  (go (method-of-object this die))
  )

(deftype target-start (process-hidden)
  ()
  )

(deftype camera-start (process-hidden)
  ()
  )

(deftype cam-slope (process-hidden)
  ()
  )

;; WARN: Return type mismatch int vs none.
(defbehavior manipy-post manipy ()
  ((-> self cur-post-hook))
  (when (and (>= (-> self shadow-volume-joint) 0) (-> self draw shadow-ctrl))
    (let ((a2-0 (-> self node-list data (-> self shadow-volume-joint)))
          (a3-0 (-> self draw shadow-ctrl))
          )
      (format *stdcon* "shadow-volume for ~A ~A~%" a2-0 a3-0)
      )
    )
  0
  (none)
  )

