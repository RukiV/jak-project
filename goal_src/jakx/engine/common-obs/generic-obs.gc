            (-> self path-pos)
            'interp
            (t9-1)
            )
          )
        (when (nonzero? (-> path-control method-table 16))
          (let ((t9-2 (method-of-object (-> self path) path-control-method-16)))
            (-> self last-velocity)
            (-> self path-pos)
            (t9-2)
            )
          )
        (let ((f0-3 (+ (-> self path-pos) (* (-> self path-speed) (seconds-per-frame)))))
          (set! (-> self path-pos) f0-3)
          (set! (-> self path-pos) (- f0-3 (* (the float (the int (/ f0-3 1.0))) 1.0)))
          )
        )
      ;; og:preserve-this bring-up guard: sparticle-launch-control's spawn (slot 16)
      ;; failed to decompile in sparticle-launcher.gc, so the slot reads 0 -- guard
      ;; the SLOT. Particles resume from live spawners when that method lands. The
      ;; (nonzero? (-> self part)) half is needed too now that the init guard above can
      ;; leave part at 0, so slot 16 landing before slot 14 cannot hand spawn a zero.
      (if (nonzero? (-> self part)) ;; lever retired at #53 slice 4
          (spawn (-> self part) (-> self root trans))
          )
      ;; slot 9 (update!) is live since slice 5; the slot test stays as cheap dead-code
      ;; hygiene, and the construction that would feed these fields is re-parked above
      ;; (the m0 phantom), so sound/sound-extra read 0 and the inner whens no-op.
      (when (nonzero? (-> ambient-sound method-table 9)) ;; slot 9 = update!
        (when (nonzero? (-> self sound))
          (update-trans! (-> self sound) (-> self root trans))
          (update! (-> self sound))
          )
        (when (nonzero? (-> self sound-extra))
          (update-trans! (-> self sound-extra) (-> self root trans))
          (update! (-> self sound-extra))
          )
        )
      )
    )
  :code sleep-code
  )

(defmethod init-from-entity! ((this part-spawner) (arg0 entity-actor))
  (with-pp
    (rlet ((vf0 :class vf)
           (vf4 :class vf)
           (vf5 :class vf)
           (vf6 :class vf)
           )
      (init-vf0-vector)
      ;; og:preserve-this bring-up guard: retail jakx sets 16 here (generic-obs
      ;; disasm:2203). The bring-up park below suspends in bring-up-parked rather
      ;; than running the retail path, so keep jak3's part-spawner value, which is
      ;; also 64 (jak3 generic-obs.gc:1978), as suspend headroom. Restore to 16
      ;; once the part-group legs land.
      (stack-size-set! (-> this main-thread) 64)
      ;; og:preserve-this bring-up guard (park early): retail allocates trsqv, two
      ;; ambient-sounds and an optional curve-control on the entity-sized heap and
      ;; only then resolves the part group. With the level part groups unlanded,
      ;; every jungle spawner fails the lookup, and the allocations first overflow
      ;; the small retail heap (the failed tail allocation returns a garbage
      ;; pointer whose stop! dispatch later DEP-faults in deactivate). Resolve the
      ;; group FIRST and park sleeping before touching the heap. The park then
      ;; reaches deactivate with part/sound/sound-extra still zero, since process
      ;; activate mem-set32!s the entire child-field area (gkernel.gc:2077), so
      ;; deactivate's nonzero? tests are already safe. Delete together with the
      ;; other part-group park guards when the part-group legs land.
      (let ((sv-96 "#f"))
        (when (not (entity-lookup-part-group arg0 (& sv-96) 'art-name))
          (format 0 "WARNING: part-spawner ~A: part group ~S not found, parking early (bring-up)~%" (-> this name) sv-96)
          (go bring-up-parked)
          )
        )
      (logior! (-> this mask) (process-mask ambient))
      (+! (-> this clock ref-count) -1)
      (+! (-> *display* part-clock ref-count) 1)
      (set! (-> this clock) (-> *display* part-clock))
      (set! (-> this root) (new 'process 'trsqv))
      (set! (-> this root trans quad) (-> arg0 extra trans quad))
      (quaternion-copy! (the-as quaternion (-> this root rot)) (-> arg0 quat))
      (vector-identity! (-> this root scale))
      (let ((f0-0 (the-as object (res-lump-float arg0 'matrix-scale :default 1.0))))
        (when (and *debug-segment* *spartacus-editor* (nonzero? *spartacus-editor*))
          (let ((a1-5 (new 'stack-no-clear 'event-message-block)))
            (set! (-> a1-5 from) (process->ppointer pp))
            (set! (-> a1-5 num-params) 1)
            (set! (-> a1-5 message) 'get-scale)
            (set! (-> a1-5 param 0) (the-as uint arg0))
            ;; og:preserve-this hand-cast: raw gpr->fpr in the decomp; the event result is the float scale
            (set! f0-0 (the-as float (send-event-function (the-as process-tree *spartacus-editor*) a1-5)))
            )
          )
        (vector-float*! (-> this root scale) (-> this root scale) (the-as float f0-0))
        )
      (set! (-> this radius) 12288.0)
      (set! (-> this enable)
            (not (and (-> this entity) (logtest? (-> this entity extra perm status) (entity-perm-status subtask-complete)))
                 )
            )
      ;; og:preserve-this bring-up re-park (slice 5): gsound landed and slot 9 went
      ;; live, but constructing these ambient-sounds exposed a real defect in the
      ;; hand-carried (new ambient-sound) for the entity-actor path: its object-new
      ;; executes with a NULL type and size 0 (allocation-trace-verified on
      ;; rampsplash-part-26), returning a phantom object at heap-cur+4 that never
      ;; advances the heap. After the retail post-init shrink, the phantom's memory is
      ;; reused, and the active-state update!/update-trans! dispatch through its garbage
      ;; type tag is an intermittent boot crash (2 in 3). Park the construction, not the
      ;; update block, until the m0 phantom is diagnosed; sound/sound-extra stay 0 and
      ;; every consumer already nonzero?-tests them. See issue #34 slice-5 notes.
      (when #f ;; was: (nonzero? (-> ambient-sound method-table 9))
        (set! (-> this sound) (new 'process 'ambient-sound (-> this entity) (-> this root trans) 0.0))
        (set! (-> this sound-extra) (new 'process 'ambient-sound (-> this entity) (-> this root trans) 1.0))
        )
      (when (res-lump-data arg0 'path pointer)
        (set! (-> this path) (new 'process 'curve-control this 'path (the-as res-lump #f) #f -1000000000.0))
        (logior! (-> this path flags) (path-control-flag display draw-line draw-point draw-text))
        (set! (-> this path-speed) (res-lump-float arg0 'speed :default 1.0))
        )
      (let ((v1-50 (res-lump-struct arg0 'trans-offset structure)))
        (when v1-50
          (let ((a0-31 (-> this root trans)))
            (.lvf vf4 (&-> (-> this root trans) quad))
            (.lvf vf5 (&-> (the-as vector v1-50) quad))
            (.mov.vf.w vf6 vf0)
            (.add.vf.xyz vf6 vf4 vf5)
            (.svf (&-> a0-31 quad) vf6)
            )
          )
        )
      (let ((s4-0 (the-as object (res-lump-struct arg0 'rot-offset structure))))
        (when (the-as structure s4-0)
          (if (< 0.0 (-> (the-as (pointer degrees) s4-0) 0))
              (quaternion-rotate-local-x!
                (the-as quaternion (-> this root rot))
                (the-as quaternion (-> this root rot))
                (-> (the-as (pointer degrees) s4-0) 0)
                )
              )
          (if (< 0.0 (-> (the-as (pointer degrees) s4-0) 1))
              (quaternion-rotate-local-y!
                (the-as quaternion (-> this root rot))
                (the-as quaternion (-> this root rot))
                (-> (the-as (pointer degrees) s4-0) 1)
                )
              )
          (if (< 0.0 (-> (the-as (pointer degrees) s4-0) 2))
              (quaternion-rotate-local-z!
                (the-as quaternion (-> this root rot))
                (the-as quaternion (-> this root rot))
                (-> (the-as (pointer degrees) s4-0) 2)
                )
              )
          )
        )
      (let ((sv-96 "#f"))
        (set! (-> this mode) (entity-lookup-part-group arg0 (& sv-96) 'art-name))
        (when (-> this mode)
          (let ((s5-1 (-> this mode 0)))
            (when (and (nonzero? s5-1) (= (-> s5-1 type) sparticle-launch-group))
              (cond
                ((logtest? (-> s5-1 flags) (sp-group-flag sp8))
                 (break!)
                 0
                 )
                ((logtest? (-> s5-1 flags) (sp-group-flag sp9))
                 (process-entity-status! this (entity-perm-status dead) #t)
                 (deactivate this)
                 )
                (else
                  ;; og:preserve-this bring-up guard: create-launch-control ends in an
                  ;; unconditional (initialize <control> <group> <proc>) call, and
                  ;; sparticle-launch-control's initialize (slot 14) is still commented
                  ;; out in sparticle-launcher.gc, so that slot reads 0 and the call is a
                  ;; jump to address 0. Guard the SLOT, not the object. Before
                  ;; jungle-part/jungle-part2 landed nothing reached here: every jungle
                  ;; spawner failed the group lookup and took the park above, and
                  ;; time-of-day's three create-launch-control calls are guarded on their
                  ;; part-group-id-table entries being unset. With the groups resolving
                  ;; this is live, so leave part at 0 and still go active: the trans only
                  ;; spawns behind the slot-16 guard below and deactivate already tests
                  ;; (nonzero? (-> this part)). Delete when initialize lands.
                  (set! (-> this part) (create-launch-control s5-1 this)) ;; lever retired at #53 slice 4
                  (when (logtest? (-> s5-1 flags) (sp-group-flag sp10))
                    (process-entity-status! this (entity-perm-status subtask-complete) #t)
                    (set! (-> this enable) #f)
                    )
                  (go (method-of-object this active))
                  )
                )
              )
            )
          )
        (begin
          ;; og:preserve-this bring-up guard: same art-error layout hazard (part-spawner
          ;; is a plain process child); park instead until the part-group legs land
          (format 0 "WARNING: part-spawner ~A: part group ~S not found, parking (bring-up)~%" (-> this name) sv-96)
          (go bring-up-parked)
          )
        )
      )
    )
  )

(defstate active (touch-tracker)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (local-vars (v0-0 object))
    (case message
      (('touched)
       (let ((v1-1 (ppointer->process (-> self parent))))
         (when (!= v1-1 proc)
           (cond
             ((= (-> self event) 'attack)
              (send-event
                proc
                (-> self event)
                :from v1-1
                #f
                (static-attack-info ((mode (-> self event-mode)) (id (new-attack-id))))
                )
              )
             ((-> self event)
              (send-event proc (-> self event) :from v1-1)
              )
             (else
               (let ((t0-5 (new 'stack-no-clear 'event-message-block)))
                 (set! (-> t0-5 from) (process->ppointer proc))
                 (set! (-> t0-5 num-params) argc)
                 (set! (-> t0-5 message) message)
                 (set! (-> t0-5 param 0) (-> block param 0))
                 (set! (-> t0-5 param 1) (-> block param 1))
                 (set! (-> t0-5 param 2) (-> block param 2))
                 (set! (-> t0-5 param 3) (-> block param 3))
                 (set! (-> t0-5 param 4) (-> block param 4))
                 (set! (-> t0-5 param 5) (-> block param 5))
                 (send-event-function v1-1 t0-5)
                 )
               )
             )
           )
         )
       )
      (('target)
       (set! v0-0 (process->handle (the-as process (-> block param 0))))
       (set! (-> self target) (the-as handle v0-0))
       v0-0
       )
      (('event)
       (set! (-> self event) (the-as symbol (-> block param 0)))
       (set! v0-0 (-> block param 1))
       (set! (-> self event-mode) (the-as symbol v0-0))
       v0-0
       )
      (('exit)
       (set! v0-0 (-> block param 0))
       (set! (-> self run-function) (the-as (function object) v0-0))
       v0-0
       )
      (('eval)
       ((the-as (function touch-tracker object) (-> block param 0)) self)
       )
      (('function)
       (set! v0-0 (-> block param 0))
       (set! (-> self callback) (the-as (function touch-tracker none) v0-0))
       v0-0
       )
      )
    )
  :code (behavior ()
    (set-time! (-> self state-time))
    (while ((-> self run-function))
      (let ((a0-4 (as-type (handle->process (-> self target)) process-drawable)))
        (when a0-4
          (let ((a0-6 (as-type (-> (the-as process-drawable a0-4) root) collide-shape)))
            (if a0-6
                (set! (-> (the-as collide-shape (-> self root)) trans quad)
                      (-> (the-as collide-shape a0-6) root-prim prim-core world-sphere quad)
                      )
                )
            )
          )
        )
      (if (-> self callback)
          ((-> self callback) self)
          )
      (update-transforms (the-as collide-shape (-> self root)))
      (let ((a1-3 (new 'stack-no-clear 'overlaps-others-params)))
        (set! (-> a1-3 options) (overlaps-others-options oo1))
        (set! (-> a1-3 collide-with-filter) (the-as collide-spec -1))
        (set! (-> a1-3 tlist) *touching-list*)
        (find-overlapping-shapes (the-as collide-shape (-> self root)) a1-3)
        )
      (suspend)
      )
    (let ((v1-21 (-> (the-as collide-shape (-> self root)) root-prim)))
      (set! (-> v1-21 prim-core collide-as) (collide-spec))
      (set! (-> v1-21 prim-core collide-with) (collide-spec))
      )
    0
    (suspend)
    0
    )
  )

;; WARN: Return type mismatch object vs none.
(defbehavior touch-tracker-init touch-tracker ((arg0 vector) (arg1 float) (arg2 time-frame))
  (let ((s4-0 (new 'process 'collide-shape-moving self (collide-list-enum hit-by-player))))
    (set! (-> s4-0 dynam) (copy *standard-dynamics* 'process))
    (set! (-> s4-0 reaction) cshape-reaction-default)
    (set! (-> s4-0 no-reaction)
          (the-as (function collide-shape-moving collide-query vector vector object) nothing)
          )
    (let ((v1-6 (new 'process 'collide-shape-prim-sphere s4-0 (the-as uint 0))))
      (set! (-> v1-6 prim-core collide-as) (collide-spec jak enemy))
      (set! (-> v1-6 prim-core collide-with)
            (collide-spec
              crate
              civilian
              enemy
              obstacle
              vehicle-sphere
              hit-by-player-list
              hit-by-others-list
              collectable
              pusher
              )
            )
      (set-vector! (-> v1-6 local-sphere) 0.0 0.0 0.0 arg1)
      (set! (-> s4-0 total-prims) (the-as uint 1))
      (set! (-> s4-0 root-prim) v1-6)
      )
    (set! (-> s4-0 nav-radius) (* 0.75 (-> s4-0 root-prim local-sphere w)))
    (let ((v1-9 (-> s4-0 root-prim)))
      (set! (-> s4-0 backup-collide-as) (-> v1-9 prim-core collide-as))
      (set! (-> s4-0 backup-collide-with) (-> v1-9 prim-core collide-with))
