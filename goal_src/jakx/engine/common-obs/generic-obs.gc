          (else
            (setting-control-method-16 *setting-control* self 'sound-reverb-seek-speed)
            (setting-control-method-16 *setting-control* self 'sound-reverb)
            (setting-control-method-16 *setting-control* self 'sound-reverb-mode)
            )
          )
        )
      )
    )
  :code sleep-code
  )

(defstate active (external-camera-controller)
  :virtual #t
  :trans (behavior ()
    (set-zero! *camera-smush-control*)
    )
  :code (behavior ()
    (process-entity-status! self (entity-perm-status no-kill) #t)
    (setting-control-method-15 *setting-control* self 'calm #t 0 0)
    (while (not (process-grab? (view-get-active-target) #f))
      (suspend)
      )
    (setting-control-method-11 *setting-control* (view-get-active-index) self 'mode-name 'cam-fixed 0 0)
    (setting-control-method-11 *setting-control* (view-get-active-index) self 'interp-time 'abs #x43e10000 0)
    (let* ((gp-3 *setting-control*)
           (s5-2 (method-of-object gp-3 setting-control-method-11))
           (s4-0 (view-get-active-index))
           (s3-0 self)
           (a3-4 'entity-name)
           )
      (s5-2 gp-3 s4-0 s3-0 a3-4 (res-lump-struct (-> self entity) 'camera-name structure) 0 0)
      (suspend-for (the-as time-frame (-> self pause-time))
        )
      (when (-> self blur)
        (let* ((a0-8 *setting-control*)
               (t9-11 (method-of-object a0-8 setting-control-method-15))
               (a2-6 'blur-a)
               )
          (set! a3-4 'abs)
          (t9-11 a0-8 self a2-6 a3-4 #x3f000000 0)
          )
        )
      (setting-control-method-16 *setting-control* self 'mode-name)
      (setting-control-method-16 *setting-control* self 'entity-name)
      (setting-control-method-16 *setting-control* self 'interp-time)
      (suspend-for (seconds 0.5)
        )
      (while (not (process-release? (view-get-active-target)))
        (suspend)
        )
      (setting-control-method-16 *setting-control* self 'interp-time)
      (suspend-for (seconds 0.5)
        )
      (setting-control-method-16 *setting-control* self 'blur-a)
      )
    (process-entity-status! self (entity-perm-status no-kill) #f)
    )
  )

(defbehavior external-camera-controller-init-by-other external-camera-controller ((arg0 entity) (arg1 time-frame) (arg2 symbol))
  (process-entity-set! self arg0)
  (set! (-> self pause-time) (the-as uint arg1))
  (set! (-> self blur) arg2)
  (go-virtual active)
  )

(deftype crate (process-hidden)
  ()
  )
