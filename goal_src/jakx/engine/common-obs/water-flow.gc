  )

;; definition for method 7 of type flow-control
(defmethod relocate ((this flow-control) (offset int))
  (if (nonzero? (-> this sections))
      (&+! (-> this sections) offset)
      )
  (if (nonzero? (-> this path))
      (&+! (-> this path) offset)
      )
  (call-parent-method this offset)
  )

