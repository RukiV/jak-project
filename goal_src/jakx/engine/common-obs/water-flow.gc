;; failed to figure out what this is:
(defstate idle (water-flow)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('water-info)
       (let ((v1-1 (-> block param 0)))
         (flow-control-method-13 (-> self flow) (the-as water-info v1-1) (the-as vector (+ v1-1 0)))
         )
       )
      (('touch-water)
       (let ((gp-0 (-> self flow))
             (a1-7 (as-type proc process-focusable))
             )
         (if (and (nonzero? gp-0) (and a1-7 (< 0.0 (-> gp-0 speed))))
             (flow-control-method-11 gp-0 (the-as process-focusable a1-7))
             )
         )
       )
      )
    )
  :code sleep-code
  :post (behavior ()
    (flow-control-method-9 (-> self flow))
    )
  )

;; definition for method 11 of type water-flow
;; INFO: Used lq/sq
(defmethod init-from-entity! ((this water-flow) (arg0 entity-actor))
  (set! (-> this root) (new 'process 'trsqv))
  (logior! (-> this mask) (process-mask actor-pause))
  (set! (-> this root trans quad) (-> arg0 extra trans quad))
  (quaternion-copy! (the-as quaternion (-> this root rot)) (-> arg0 quat))
  (vector-identity! (-> this root scale))
  (set! (-> this flow) (new 'process 'flow-control this (the-as res-lump #f)))
  (go (method-of-object this idle))
  )
