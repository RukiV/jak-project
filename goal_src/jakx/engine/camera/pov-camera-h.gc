;;-*-Lisp-*-
(in-package goal)

;; name: pov-camera-h.gc
;; name in dgo: pov-camera-h
;; dgos: ENGINE, GAME

;; +++pov-camera-flag
(defenum pov-camera-flag
  :bitfield #t
  :type int32
  (notify-of-abort 0)
  (allow-abort 1)
  (inherit-orientation 2)
  (pcf3 3)
  )
;; ---pov-camera-flag

;; og:preserve-this forward declarations matching jak3's own pov-camera-h.gc
;; (goal_src/jak3/engine/camera/pov-camera-h.gc:19-22): pov-camera.gc's own
;; pov-camera-start-playing state spawns othercam via process-spawn, whose
;; macro expansion references othercam-init-by-other by name before this
;; file's own defbehavior for it is compiled (othercam-init-by-other is
;; defined at the end of pov-camera.gc, after every state that can spawn
;; it); without the forward declaration goalc rejects it with "was looked
;; up as a global variable, but it does not exist" (this rung's own (mi)
;; build). othercam itself is a process subtype defined in a still-
;; unlanded file (goal_src/jak3/engine/common-obs/generic-obs-h.gc's own
;; twin), hence the declare-type.
(declare-type pov-camera process-drawable)
(declare-type othercam process)
(define-extern pov-camera-init-by-other (function vector skeleton-group string pov-camera-flag process-drawable pair none :behavior pov-camera))
(define-extern othercam-init-by-other (function pov-camera int symbol symbol none :behavior othercam))

;; DECOMP BEGINS

;; definition of type pov-camera
(deftype pov-camera (process-drawable)
  ((flags                pov-camera-flag)
   (debounce-start-time  time-frame)
   (notify-handle        handle)
   (anim-name            string)
   (command-list         pair)
   (mask-to-clear        process-mask)
   (music-volume-movie   float)
   (sfx-volume-movie     float)
   )
  (:state-methods
    pov-camera-abort
    pov-camera-done-playing
    pov-camera-playing
    pov-camera-start-playing
    pov-camera-startup
    )
  (:methods
    (pov-camera-method-55 (_type_) none)
    (pov-camera-method-56 () symbol)
    (pov-camera-method-57 (_type_) none)
    (pov-camera-method-58 () none)
    (pov-camera-method-59 () symbol)
    )
  )

;; definition for method 3 of type pov-camera
(defmethod inspect ((this pov-camera))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type process-drawable inspect)))
    (t9-0 this)
    )
  (format #t "~2Tflags: ~D~%" (-> this flags))
  (format #t "~2Tdebounce-start-time: ~D~%" (-> this debounce-start-time))
  (format #t "~2Tnotify-handle: ~D~%" (-> this notify-handle))
  (format #t "~2Tanim-name: ~A~%" (-> this anim-name))
  (format #t "~2Tcommand-list: ~A~%" (-> this command-list))
  (format #t "~2Tmask-to-clear: ~D~%" (-> this mask-to-clear))
  (format #t "~2Tmusic-volume-movie: ~f~%" (-> this music-volume-movie))
  (format #t "~2Tsfx-volume-movie: ~f~%" (-> this sfx-volume-movie))
  (label cfg-4)
  this
  )

