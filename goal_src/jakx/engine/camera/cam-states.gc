(in-package goal)

;; name: cam-states.gc
;; name in dgo: cam-states
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

;; og:preserve-this bring-up minimal net types: the full net-mgr/net-player homes are
;; unlanded; cam-states reads a handful of fields and calls net-player m49. Move these
;; to their real headers when the net files land.
(declare-type net-mgr process)
(declare-type net-player process)
(declare-type hud-slowmo process)
;; og:preserve-this bring-up shim retired: the real vehicle deftype lands in
;; vehicle-h.gc this rung (feat/jakx-vehicle-types), built before cam-states.o
;; (gd# 366 vs 467), so it is what resolves here now. Both shim fields
;; carried over: cam-target-handle keeps its name and offset (752, confirmed
;; unchanged); vehicle-flags-264 turned out to be rigid-body-object's own
;; inherited "flags" field (264 is inside rigid-body-object's own 256-288
;; span, not a new field of vehicle), so its two call sites below now read
;; -> flags instead. wvehicle's own forward declaration retires too:
;; wvehicle-h.o (gd# 373) also precedes cam-states.o.

(deftype net-mgr-game-state (structure)
  ((connect-handle     basic  :offset 0)
   (local-machine-idx  int32  :offset 4)
   (session-master-idx int32  :offset 8)
   (host-idx           int32  :offset 12)
   (connected-bitfield int32  :offset 16)
   (time               int32  :offset 20)
   (first-time-host    basic  :offset 24)
   (locked             basic  :offset 28)
   (kicked             basic  :offset 32)
   (sm-eligible        basic  :offset 36)
   )
  :pack-me
  )

