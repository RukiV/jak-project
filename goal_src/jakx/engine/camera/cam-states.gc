;; INFO: Used lq/sq
;; WARN: Return type mismatch int vs target-camera.
(defun choose-target-camera ((arg0 process-focusable) (arg1 process-focusable))
  (rlet ((acc :class vf)
         (Q :class vf)
         (vf0 :class vf)
         (vf1 :class vf)
         (vf2 :class vf)
         (vf3 :class vf)
         )
    (init-vf0-vector)
    (let ((s4-0 (new 'stack-no-clear 'vector)))
      (set! (-> (the-as vector (-> s4-0 data)) quad) (-> (get-trans arg0 0) quad))
      (set! (-> (&+ s4-0 16) quad) (-> (get-trans arg1 0) quad))
      (set! (-> *target-camera-runtime* need-new-cam) #f)
      (let ((a0-3 (-> arg0 node-list data 0 bone transform fvec))
            (v1-10 (vector-! (new 'stack-no-clear 'vector) (&+ s4-0 16) (the-as vector (-> s4-0 data))))
            )
        (let ((a1-4 v1-10))
          (let ((f0-0 1.0))
            (.lvf vf1 (&-> a1-4 quad))
            (.mul.vf.xyz vf2 vf1 vf1)
            (let ((a2-2 f0-0))
              (.mov vf3 a2-2)
              )
            )
          (.mul.x.vf.w acc vf0 vf2)
          (.add.mul.y.vf.w acc vf0 vf2 acc)
          (.add.mul.z.vf.w vf2 vf0 vf2 acc)
          (.isqrt.vf Q vf3 vf2 :fsf #b0 :ftf #b11)
          (.wait.vf)
          (.mul.vf.xyz vf1 vf1 Q)
          (.nop.vf)
          (.nop.vf)
          (.nop.vf)
          (.svf (&-> a1-4 quad) vf1)
          )
        (when (< (vector-dot a0-3 v1-10) 0.0)
          (format #t "BEHIND SHOOTER~%")
          (dotimes (s3-2 (-> *target-camera-array* length))
            (let ((a0-6 (-> *target-camera-array* s3-2)))
              (when (logtest? (-> a0-6 flags) 1)
                (let ((f0-3 (target-camera-method-10 a0-6 arg0 arg1 (the-as vector (-> s4-0 data)) (&+ s4-0 16))))
                  (cond
                    ((< 0.001 f0-3)
                     (return (the-as target-camera (- s3-2)))
                     )
                    ((< f0-3 -0.001)
                     (set! (-> *target-camera-runtime* mirror) (the-as basic #t))
                     (return (the-as target-camera (- s3-2)))
                     )
                    (else
                      )
                    )
                  )
                )
              )
            )
          )
        )
      (dotimes (s3-3 (-> *target-camera-array* length))
        (let ((f0-4 (target-camera-method-10
                      (-> *target-camera-array* s3-3)
                      arg0
                      arg1
                      (the-as vector (-> s4-0 data))
                      (&+ s4-0 16)
                      )
                    )
              )
          (cond
            ((< 0.001 f0-4)
             (return (the-as target-camera s3-3))
             )
            ((< f0-4 -0.001)
             (set! (-> *target-camera-runtime* mirror) (the-as basic #t))
             (return (the-as target-camera s3-3))
             )
            (else
              )
            )
          )
        )
      )
    (the-as target-camera #f)
    )
  )

;; definition for function camera-go-target
(defun camera-go-target ((arg0 handle))
  (with-pp
    (set! (-> *target-camera-runtime* shot) arg0)
    (setting-control-method-11 *setting-control* (view-get-active-index) pp 'interp-time 'abs #x42b40000 0)
    (setting-control-method-11 *setting-control* (view-get-active-index) pp 'mode-name 'cam-vehicle-shot 0 0)
    (setting-control-method-15 *setting-control* pp 'blur-a 'abs #x3f000000 0)
    0
    )
  )

;; definition for function cam-akira-mode-enter
;; WARN: Return type mismatch symbol vs object.
;; WARN: .subu (32-bit) used on a vehicle at idx 121. This probably should be a handle.
(defbehavior cam-akira-mode-enter camera-slave ()
  (when (not (-> *target-camera-runtime* active))
    (set! (-> *target-camera-runtime* active) (the-as basic #t))
    (set! (-> *target-camera-runtime* num-camera-changes) 0)
    (when (not (-> self enter-has-run))
      (set! (-> self blend-from-type) (camera-blend-from-type unknown-1))
      (set! (-> self blend-to-type) 0)
      0
      )
    (when (-> (the-as camera-master (view-get-active-camera)) focus handle)
      (send-event (handle->process (-> (the-as camera-master (view-get-active-camera)) focus handle)) 'set 'force-lod 0)
      (send-event (handle->process (-> *target-camera-runtime* shot)) 'set 'force-lod 0)
      (let ((v1-30 (as-type (handle->process (-> (the-as camera-master (view-get-active-camera)) focus handle)) vehicle)))
        (when v1-30
          (let ((a1-5 (new 'stack-no-clear 'event-message-block)))
            (set! (-> a1-5 from) (process->ppointer self))
            (set! (-> a1-5 num-params) 2)
            (set! (-> a1-5 message) 'look-at)
            (set! (-> a1-5 param 0) (the-as uint (handle->process (-> *target-camera-runtime* shot))))
            (set! (-> a1-5 param 1) (the-as uint 3000))
            (let ((t9-6 send-event-function)
                  (v1-31 (the-as object (-> (the-as vehicle v1-30) cam-target-handle)))
                  )
              (t9-6
                (the-as process-tree
                  (and (nonzero? (l32-false-check (the-as vehicle v1-31)))
                       (let ((a2-6 (-> (the-as (pointer process) (-> (the-as handle v1-31) process)) 0)))
                         (if (= (sar (the-as int v1-31) 32) (-> a2-6 pid))
                             a2-6
                             )
                         )
                       )
                  )
                a1-5
                )
              )
            )
          )
        )
      )
    (set! (-> *target-camera-runtime* need-new-cam) (the-as basic #t))
    (set! (-> *target-camera-runtime* prefix) (the-as basic #t))
    (set! (-> *target-camera-runtime* state-time) (the-as uint (-> *display* real-clock frame-counter)))
    (let ((v0-0 #t))
      (set! *explosion-effect-suppress* v0-0)
      v0-0
      )
    )
  )

;; failed to figure out what this is:
(defstate cam-vehicle-shot (camera-slave)
  :enter cam-akira-mode-enter
  :exit (behavior ()
    (let* ((gp-0 *setting-control*)
           (s5-0 (method-of-object gp-0 setting-control-method-12))
           (a1-0 (view-get-active-index))
           (a2-0 self)
           (a3-0 'interp-time)
           )
      (s5-0 gp-0 a1-0 a2-0 a3-0)
      (set! *explosion-effect-suppress* #f)
      (let ((v1-5 (as-type (handle->process (-> (the-as camera-master (view-get-active-camera)) focus handle)) vehicle)))
        (when v1-5
          (let ((a1-3 (new 'stack-no-clear 'event-message-block)))
            (set! (-> a1-3 from) (process->ppointer self))
            (set! (-> a1-3 num-params) 2)
            (set! (-> a1-3 message) 'look-at)
            (set! (-> a1-3 param 0) (the-as uint #f))
            (set! (-> a1-3 param 1) (the-as uint 0))
            (let ((t9-4 send-event-function)
                  (v1-6 (the-as object (-> (the-as vehicle v1-5) cam-target-handle)))
                  )
              (t9-4
                (the-as process-tree
                  (and (nonzero? (l32-false-check (the-as vehicle v1-6)))
                       (let ((a2-2 (-> (the-as (pointer process) (-> (the-as handle v1-6) process)) 0)))
                         (if (= (sar (the-as int v1-6) 32) (-> a2-2 pid))
                             a2-2
                             )
                         )
                       )
                  )
                a1-3
                )
              )
            )
          )
        )
      (send-event
        (vehicle-handle->net-player (-> (the-as camera-master (view-get-active-camera)) focus handle))
        'target-cam-stop
        (not (handle->process (-> *target-camera-runtime* vehicle-release-timer)))
        )
      (set! (-> *target-camera-runtime* active) #f)
      (set! (-> *target-camera-runtime* shot) (the-as handle #f))
      (set! (-> *target-camera-runtime* cur-cam-idx) -127)
      (if (handle->process (-> *target-camera-runtime* vehicle-release-timer))
          (setting-control-method-14 *setting-control* 'letterbox 10 'letterbox 'abs 0.9 0)
          (setting-control-method-16 *setting-control* self 'letterbox)
          )
      )
    (target-time-go-normal)
    )
  :trans (behavior ()
    (when (= (-> *net-mgr* game-type) 4)
      (when (and (cpad-pressed? (view-get-active-index) x)
                 (< (the-as time-frame (+ (-> *target-camera-runtime* state-time) 300))
                    (-> *display* real-clock frame-counter)
                    )
                 )
        (format #t "Akira cam: Abort due to cpad X~%")
        (send-event
          (vehicle-handle->net-player (-> (the-as camera-master (view-get-active-camera)) focus handle))
          'target-cam-stop
          (not (handle->process (-> *target-camera-runtime* vehicle-release-timer)))
          )
        (set! (-> *target-camera-runtime* active) #f)
        (set! (-> *target-camera-runtime* shot) (the-as handle #f))
        )
      )
    (format *stdebug* "GO ~d~%" (-> *target-camera-runtime* cur-cam-idx))
    (let ((gp-1 (as-type (handle->process (-> (the-as camera-master (view-get-active-camera)) focus handle)) wvehicle))
          (v1-32 (as-type (handle->process (-> *target-camera-runtime* shot)) wvehicle))
          )
      (cond
        ((not (and gp-1 v1-32))
         (format #t "Akira cam: Abort due no shooter or target~%")
         (send-event
           (vehicle-handle->net-player (-> (the-as camera-master (view-get-active-camera)) focus handle))
           'target-cam-stop
           (not (handle->process (-> *target-camera-runtime* vehicle-release-timer)))
           )
         (set! (-> *target-camera-runtime* active) #f)
         (set! (-> *target-camera-runtime* shot) (the-as handle #f))
         (go empty-state)
         )
        ((logtest? (-> (the-as vehicle gp-1) flags) 8)
         (send-event
           (vehicle-handle->net-player (-> (the-as camera-master (view-get-active-camera)) focus handle))
           'target-cam-stop
           (not (handle->process (-> *target-camera-runtime* vehicle-release-timer)))
           )
         (set! (-> *target-camera-runtime* active) #f)
         (set! (-> *target-camera-runtime* shot) (the-as handle #f))
         (go empty-state)
         )
        (else
          )
        )
      )
    )
  :code (behavior ()
    (let ((v1-1 (make-sound-instance (-> *sound-info* 434) (new 'static 'sound-id) (the-as handle #f))))
      (cond
        (v1-1
          (logior! (-> v1-1 flags) 320)
          (-> v1-1 id)
          )
        (else
          0
          )
        )
      )
    (target-time-go-slow 0.5 #t)
    (let ((s4-0 #f)
          (gp-0 (choose-victor-prefix-camera))
          (s5-0 (new 'stack-no-clear 'vector))
          )
      (set! (-> s5-0 quad)
            (the-as
              uint128
              (the-as
                (pointer uint128)
                (-> (the-as
                      (pointer uint128)
                      (-> (the-as process-drawable (handle->process (-> *target-camera-runtime* shot))) root trans)
                      )
                    0
                    )
                )
              )
            )
      90.0
      (cond
        (gp-0
          (if (zero? (-> *viewport-array* mode))
              (setting-control-method-15 *setting-control* self 'letterbox 'abs #x3f666666 0)
              )
          (crash-camera-method-14 gp-0 (the-as crash-camera s4-0))
          (suspend-for (seconds 0.6)
            (target-time-go-slow (lerp-clamp 0.5 0.1 (* 0.013333334 (the float (- (current-time) time)))) #f)
            (setting-control-method-11
              *setting-control*
              (view-get-active-index)
              self
              'interp-time
              'abs
              (* 90.0 *target-time-speed*)
              0
              )
            (if (crash-camera-method-15 gp-0)
                (goto cfg-31)
                )
            (crash-camera-method-12 gp-0 self s5-0)
            )
          (crash-camera-method-12 gp-0 self s5-0)
          )
        (else
          (send-event
            (vehicle-handle->net-player (-> (the-as camera-master (view-get-active-camera)) focus handle))
            'target-cam-stop
            (not (handle->process (-> *target-camera-runtime* vehicle-release-timer)))
            )
          (set! (-> *target-camera-runtime* active) #f)
          (set! (-> *target-camera-runtime* shot) (the-as handle #f))
          (let ((a0-23 *text-display-nice-shot-proc*))
            (if a0-23
                (send-event a0-23 'kill-hud-instant)
                )
            )
          (go empty-state)
          )
        )
      )
    (label cfg-31)
    (set! (-> *target-camera-runtime* prefix) #f)
    (set! (-> *target-camera-runtime* interp) 0.01)
    (set! (-> *target-camera-runtime* interp-from-trans quad) (-> (view-get-active-math-camera) trans quad))
    (matrix->quaternion
      (-> *target-camera-runtime* interp-from-quat)
      (-> (view-get-active-math-camera) inv-camera-rot)
      )
    (suspend)
    (suspend-for (seconds 0.04)
      (seek! (-> *target-camera-runtime* interp) 1.0 (* 25.0 (seconds-per-frame)))
      )
    (suspend-for (seconds 0.5)
      (target-time-go-slow (lerp-clamp 0.1 1.0 (* 0.006666667 (the float (- (current-time) time)))) #f)
      )
    (set! (-> *target-camera-runtime* vehicle-release-timer)
          (process->handle (ppointer->process (process-spawn
                                                vehicle-AI-control-timer
                                                (-> (the-as camera-master (view-get-active-camera)) focus handle)
                                                (+ (- (- 300 (if *net-world*
                                                                 (-> *net-world* net-state total-pause-time)
                                                                 0
                                                                 )
                                                         )
                                                      (if *net-world*
                                                          (-> *net-world* net-state game-start-time)
                                                          0
                                                          )
                                                      )
                                                   (if *net-mgr*
                                                       (-> *net-mgr* game-state time)
                                                       0
                                                       )
                                                   )
                                                #x43160000
                                                :name "vehicle-AI-control-timer"
                                                :to (ppointer->process (-> self parent))
                                                )
                                              )
                           )
          )
    (format #t "Akira cam: all done!~%")
    (send-event
      (vehicle-handle->net-player (-> (the-as camera-master (view-get-active-camera)) focus handle))
      'target-cam-stop
      (not (handle->process (-> *target-camera-runtime* vehicle-release-timer)))
      )
    (set! (-> *target-camera-runtime* active) #f)
    (set! (-> *target-camera-runtime* shot) (the-as handle #f))
    )
  :post (behavior ()
    (local-vars (s4-2 target-camera))
    (let ((gp-0 (as-type (handle->process (-> (the-as camera-master (view-get-active-camera)) focus handle)) wvehicle))
          (s5-1 (as-type (handle->process (-> *target-camera-runtime* shot)) wvehicle))
          )
      (when (and gp-0 s5-1 (not (-> *target-camera-runtime* prefix)))
        (when (or (-> *target-camera-runtime* need-new-cam)
                  (< (+ (- (current-time) (-> self clock old-frame-counter)) (seconds 0.1))
                     (- (- (- (if *net-mgr*
                                  (-> *net-mgr* game-state time)
                                  0
                                  )
                              (if *net-world*
                                  (-> *net-world* net-state game-start-time)
                                  0
                                  )
                              )
                           (if *net-world*
                               (-> *net-world* net-state total-pause-time)
                               0
                               )
                           )
                        (-> *target-camera-runtime* last-good-los)
                        )
                     )
                  (= (-> *target-camera-runtime* cur-cam-idx) -127)
                  )
          (cond
            ((>= (-> *target-camera-runtime* num-camera-changes) 2)
             (format #t "Akira cam: aborting due to thrash~%")
             (send-event
               (vehicle-handle->net-player (-> (the-as camera-master (view-get-active-camera)) focus handle))
               'target-cam-stop
               (not (handle->process (-> *target-camera-runtime* vehicle-release-timer)))
               )
             (set! (-> *target-camera-runtime* active) #f)
             (set! (-> *target-camera-runtime* shot) (the-as handle #f))
             (go empty-state)
             )
            ((begin
               (+! (-> *target-camera-runtime* num-camera-changes) 1)
               (set! s4-2 (choose-target-camera (the-as process-focusable gp-0) (the-as process-focusable s5-1)))
               (format #t "chosen akira cam: ~d~%" s4-2)
               (not s4-2)
               )
             (format #t "Akira cam: unable to choose angle~%")
             (send-event
               (vehicle-handle->net-player (-> (the-as camera-master (view-get-active-camera)) focus handle))
               'target-cam-stop
               (not (handle->process (-> *target-camera-runtime* vehicle-release-timer)))
               )
             (set! (-> *target-camera-runtime* active) #f)
             (set! (-> *target-camera-runtime* shot) (the-as handle #f))
             (go empty-state)
             )
            ((>= (the-as int s4-2) 0)
             (set! (-> *target-camera-runtime* cur-cam-idx) (the-as int s4-2))
             )
            ((< (the-as int s4-2) 0)
             (set! (-> *target-camera-runtime* cur-cam-idx) (the-as int s4-2))
             (- (the-as int s4-2))
             )
            (else
              (format #t "Akira cam: can't happen~%")
              (send-event
                (vehicle-handle->net-player (-> (the-as camera-master (view-get-active-camera)) focus handle))
                'target-cam-stop
                (not (handle->process (-> *target-camera-runtime* vehicle-release-timer)))
                )
              (set! (-> *target-camera-runtime* active) #f)
              (set! (-> *target-camera-runtime* shot) (the-as handle #f))
              (go empty-state)
              )
            )
          (set! (-> *target-camera-runtime* last-good-los) (- (- (if *net-mgr*
                                                                     (-> *net-mgr* game-state time)
                                                                     0
                                                                     )
                                                                 (if *net-world*
                                                                     (-> *net-world* net-state game-start-time)
                                                                     0
                                                                     )
                                                                 )
                                                              (if *net-world*
                                                                  (-> *net-world* net-state total-pause-time)
                                                                  0
                                                                  )
                                                              )
                )
          )
        (when (!= (-> *target-camera-runtime* cur-cam-idx) -127)
          (let ((v1-73 (abs (-> *target-camera-runtime* cur-cam-idx))))
            (target-camera-method-9
              (-> *target-camera-array* v1-73)
              self
              (the-as process-focusable gp-0)
              (the-as process-focusable s5-1)
              )
            )
          (target-cam-runtime-push *target-camera-runtime* self)
          )
        (if (target-camera-test-los
              (-> self trans)
              (the-as process-focusable gp-0)
              (the-as process-focusable s5-1)
              2048.0
              )
            (set! (-> *target-camera-runtime* last-good-los) (- (- (if *net-mgr*
                                                                       (-> *net-mgr* game-state time)
                                                                       0
                                                                       )
                                                                   (if *net-world*
                                                                       (-> *net-world* net-state game-start-time)
                                                                       0
                                                                       )
                                                                   )
                                                                (if *net-world*
                                                                    (-> *net-world* net-state total-pause-time)
                                                                    0
                                                                    )
                                                                )
                  )
            )
        )
      )
    )
  )
