;;-*-Lisp-*-
(in-package goal)

;; name: cam-start.gc
;; name in dgo: cam-start
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

(defun cam-stop ()
  (kill-by-name "camera-master" *active-pool*)
  (kill-by-name "camera-slave" *active-pool*)
  (kill-by-name "camera-combiner" *active-pool*)
  (view-set-active-camera (the-as basic #f))
  (view-set-active-camera-combiner (the-as basic #f))
  #f
  )

(defun cam-start ((arg0 symbol))
  (cam-stop)
  (view-set-active-camera-combiner (the-as basic (ppointer->process (process-spawn
                                                                      camera-combiner
                                                                      :init cam-combiner-init
                                                                      :name "camera-combiner"
                                                                      :from *camera-dead-pool*
                                                                      :to *camera-pool*
                                                                      )
                                                                    )
                                           )
                                   )
  (view-set-active-camera (the-as basic (ppointer->process (process-spawn
                                                             camera-master
                                                             :init cam-master-init
                                                             :name "camera-master"
                                                             :from *camera-master-dead-pool*
                                                             :to *camera-pool*
                                                             )
                                                           )
                                  )
                          )
  0
  (none)
  )

;; og:preserve-this bring-up camera warp: nothing sends the camera-combiner
;; 'start-tracking through a real game flow yet (no target/entity chain), so after
;; the ring's boot settle the combiner trans freezes at the origin and cam-update
;; copies it over the math-camera every frame, frustum-culling the whole level away
;; (brdroom sits ~400 m out). A one-shot warp at play time gets undone by the ring's
;; settle (the master's early 'set-slave / 'start-tracking pulls the combiner back
;; toward the origin-parked slave), so play arms a warp that display-loop-main
;; re-applies every frame for ~10 s (combiner + current slave + view-0 math-camera),
;; then releases. Retire with the real camera start chain.
(define *jakx-cam-warp-level* (the level #f))
(define *jakx-cam-warp-frames* 0)
;; w > 0 marks the target valid; xyz = warp position
(define *jakx-cam-warp-target* (new 'static 'vector))
;; orientation override, decoded from a continue point's packed camera-rot. The pad
;; fallback re-derives the view from *save-camera-inv-rot* every frame (cam-update.gc
;; move-camera-from-pad), so the tick seeds both it and the math-camera while pinned.
(define *jakx-cam-warp-rot* (new 'static 'matrix))
(define *jakx-cam-warp-rot-valid* #f)

(defun jakx-cam-warp-to-level ((lev level))
  "og:preserve-this bring-up helper: arm the per-frame camera warp for the level
(see the comment above). Prefers the densest cluster in the level's actor table
(the camera lands amid birthable entities; a track's all-actor centroid is
mid-ring air and its BVH leaves are rim scenery), then the level bsphere, then
the extracted brdroom glb bounds center."
  (let ((bs (-> lev bsp bsphere)))
    (format 0 "cam-warp: armed for ~A bsphere <~m ~m ~m r ~m>~%"
            (-> lev name) (-> bs x) (-> bs y) (-> bs z) (-> bs w))
    )
  (set! (-> *jakx-cam-warp-target* w) 0.0)
  (let ((acts (-> lev bsp actors)))
    (when (nonzero? (the-as int acts))
      (let ((n (min 128 (-> acts length)))
            (best-i -1)
            (best-count 0)
            )
        ;; densest actor: most neighbors within 50m (204800 units)
        (dotimes (i n)
          (let ((count 0)
                (ci (-> acts data i bsphere))
                )
            (dotimes (k n)
              (let* ((ck (-> acts data k bsphere))
                     (dx (- (-> ck x) (-> ci x)))
                     (dz (- (-> ck z) (-> ci z)))
                     )
                (if (< (+ (* dx dx) (* dz dz)) (* 204800.0 204800.0))
                    (+! count 1)
                    )
                )
              )
            (when (> count best-count)
              (set! best-count count)
              (set! best-i i)
              )
            )
          )
        (when (>= best-i 0)
          (let ((cb (-> acts data best-i bsphere)))
            (set! (-> *jakx-cam-warp-target* x) (-> cb x))
            ;; 10m lift so the view is not inside a prop
            (set! (-> *jakx-cam-warp-target* y) (+ (-> cb y) 40960.0))
            (set! (-> *jakx-cam-warp-target* z) (-> cb z))
            (set! (-> *jakx-cam-warp-target* w) 1.0)
            (format 0 "cam-warp: actor-cluster target <~m ~m ~m> (~D neighbors)~%"
                    (-> *jakx-cam-warp-target* x)
                    (-> *jakx-cam-warp-target* y)
                    (-> *jakx-cam-warp-target* z)
                    best-count
                    )
            )
          )
        )
      )
    )
  (set! *jakx-cam-warp-level* lev)
  (set! *jakx-cam-warp-frames* 600)
  0
  (none)
  )

(defun jakx-cam-warp-to-continue ((cp continue-point))
  "og:preserve-this bring-up helper: arm the camera warp at a continue point's
camera-trans with its packed camera-rot orientation (the retail start-line
framing) instead of deriving a target from level geometry. Decode matches jak3
move-camera!: nine row-major int16s at 1/32767 scale. Retire with the real
camera start chain alongside the level warp."
  (let ((lev (level-get *level* (-> cp level))))
    (cond
      (lev
        (set! (-> *jakx-cam-warp-target* x) (-> cp camera-trans x))
        (set! (-> *jakx-cam-warp-target* y) (-> cp camera-trans y))
        (set! (-> *jakx-cam-warp-target* z) (-> cp camera-trans z))
        (set! (-> *jakx-cam-warp-target* w) 1.0)
        (let ((m *jakx-cam-warp-rot*))
          (matrix-identity! m)
          (set! (-> m rvec x) (* 0.00003051851 (-> cp camera-rot 0)))
          (set! (-> m rvec y) (* 0.00003051851 (-> cp camera-rot 1)))
          (set! (-> m rvec z) (* 0.00003051851 (-> cp camera-rot 2)))
          (set! (-> m uvec x) (* 0.00003051851 (-> cp camera-rot 3)))
          (set! (-> m uvec y) (* 0.00003051851 (-> cp camera-rot 4)))
          (set! (-> m uvec z) (* 0.00003051851 (-> cp camera-rot 5)))
          (set! (-> m fvec x) (* 0.00003051851 (-> cp camera-rot 6)))
          (set! (-> m fvec y) (* 0.00003051851 (-> cp camera-rot 7)))
          (set! (-> m fvec z) (* 0.00003051851 (-> cp camera-rot 8)))
          )
        (set! *jakx-cam-warp-rot-valid* #t)
        (set! *jakx-cam-warp-level* lev)
        (set! *jakx-cam-warp-frames* 600)
        (format 0 "cam-warp: continue ~S target <~m ~m ~m>~%"
                (-> cp name)
                (-> cp camera-trans x)
                (-> cp camera-trans y)
                (-> cp camera-trans z)
                )
        )
      (else
        (format 0 "cam-warp: continue ~S level ~A not loaded, warp not armed~%"
                (-> cp name)
                (-> cp level)
                )
        )
      )
    )
  0
  (none)
  )

;; og:preserve-this bring-up helper (#152): the camera-combiner/slave/math-camera
;; write set below used to live inline in jakx-cam-warp-tick (this file). The racer
;; chase camera (level.gc) needs to pin the same four destinations every frame to a
;; computed chase position instead of a fixed warp target, so this is factored out
;; rather than duplicated. Both callers pass #f for rot when they have no valid
;; orientation yet (jakx-cam-warp-tick before the continue-point rot decodes;
;; nothing else currently does), in which case only position is pinned. Retires
;; with the real camera start chain, same as jakx-cam-warp-tick.
(defun jakx-cam-pin-view! ((pos vector) (rot matrix))
  "Write pos into the camera-combiner, camera-master's slave, and view-0 math-
camera trans; write rot (if non-#f) into the math-camera's inv-camera-rot and
*save-camera-inv-rot* so the pad fallback keeps the orientation after release."
  (let ((cc (the-as camera-combiner (view-get-active-camera-combiner))))
    (when (and (nonzero? cc) cc)
      (set! (-> cc trans x) (-> pos x))
      (set! (-> cc trans y) (-> pos y))
      (set! (-> cc trans z) (-> pos z))
      )
    )
  (let ((cam (the-as camera-master (view-get-active-camera))))
    (when (and (nonzero? cam) cam (nonzero? (-> cam slave)))
      (let ((slave (-> cam slave 0)))
        (when (nonzero? (the-as int slave))
          (set! (-> slave trans x) (-> pos x))
          (set! (-> slave trans y) (-> pos y))
          (set! (-> slave trans z) (-> pos z))
          )
        )
      )
    )
  (let ((mc (view-get-math-camera 0)))
    (when (nonzero? (the-as int mc))
      (set! (-> mc trans x) (-> pos x))
      (set! (-> mc trans y) (-> pos y))
      (set! (-> mc trans z) (-> pos z))
      (if rot
          (matrix-copy! (-> mc inv-camera-rot) rot)
          )
      )
    )
  ;; the pad fallback rebuilds the view from *save-camera-inv-rot* each frame, so
  ;; seeding it here is what makes an orientation survive a combiner release
  (if rot
      (matrix-copy! *save-camera-inv-rot* rot)
      )
  0
  (none)
  )

(defun jakx-cam-warp-tick ()
  "og:preserve-this bring-up helper: while armed, pin the camera ring onto the
warp target each frame so the ring's boot settle cannot drag it back to the
origin; release after the counter runs out."
  (when (and *jakx-cam-warp-level* (> *jakx-cam-warp-frames* 0))
    (set! *jakx-cam-warp-frames* (- *jakx-cam-warp-frames* 1))
    (let ((bs (-> *jakx-cam-warp-level* bsp bsphere))
          (warp (new 'stack-no-clear 'vector))
          )
      ;; drawable-tree bspheres carry the real level bounds even when the bsp
      ;; header bsphere is zeroed (garage, brdroom, junglea all zero it). But a
      ;; track's bounds CENTER is empty air (junglea: zero verts within 100m of
      ;; it), so descend the first tree's BVH to its first leaf cluster: that
      ;; bsphere sits ON geometry for interiors and exteriors alike. Note the
      ;; continue-point trans is NOT a usable fallback: garage's continue sits
      ;; ~1km from the geometry.
      (let ((tree-bs (the-as vector #f))
            (leaf-lift 0.0)
            )
        (let ((trees (-> *jakx-cam-warp-level* bsp drawable-trees)))
          (when (nonzero? (the-as int trees))
            (dotimes (i (-> trees length))
              (let ((tree (-> trees trees i)))
                (when (and (not tree-bs) (< 0.0 (-> tree bsphere w)) (> (-> tree length) 0))
                  ;; start from the MIDDLE root child, then first-child descent:
                  ;; the first leaf of a track BVH tends to be interior detail
                  ;; (junglea: a stone tunnel wall at point-blank range), while
                  ;; a mid-list branch lands in more representative geometry.
                  ;; The stride-32 pick only applies to draw-node arrays.
                  (let* ((dia (the-as drawable-inline-array (-> tree data 0)))
                         (dr (the-as drawable (&+ (the-as pointer dia) 32)))
                         )
                    (when (and (= (-> dr type) draw-node) (> (the int (-> dia length)) 1))
                      (set! dr (the-as drawable
                                       (&+ (the-as pointer dia)
                                           (+ 32 (* 32 (/ (+ -1 (the int (-> dia length))) 2)))
                                           )
                               )
                            )
                      )
                    (dotimes (d 8)
                      (when (and dr (= (-> dr type) draw-node))
                        (set! dr (-> (the-as draw-node dr) child))
                        )
                      )
                    (cond
                      ((and dr (< 0.0 (-> dr bsphere w)))
                       (set! tree-bs (-> dr bsphere))
                       ;; hover half the cluster radius above its center so the
                       ;; camera is not embedded in the surface (higher lifts
                       ;; can clear the local geometry entirely into empty sky)
                       (set! leaf-lift (* 0.5 (-> dr bsphere w)))
                       )
                      (else
                        (set! tree-bs (-> tree bsphere))
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        ;; prefer the actor-cluster target computed at arm time: the camera
        ;; lands amid the actual birthable entities instead of an arbitrary
        ;; BVH leaf (a track's leaf clusters sit on rim scenery; junglea's
        ;; puts the release point ~570m from the nearest entity cluster)
        (let ((ent-bs (the-as vector #f)))
          (if (< 0.0 (-> *jakx-cam-warp-target* w))
              (set! ent-bs *jakx-cam-warp-target*)
              )
          (cond
            (ent-bs
              (set! (-> warp x) (-> ent-bs x))
              (set! (-> warp y) (-> ent-bs y))
              (set! (-> warp z) (-> ent-bs z))
              )
            ((< 0.0 (-> bs w))
             (set! (-> warp x) (-> bs x))
             (set! (-> warp y) (-> bs y))
             (set! (-> warp z) (-> bs z))
             )
            (tree-bs
              (set! (-> warp x) (-> tree-bs x))
              (set! (-> warp y) (+ (-> tree-bs y) leaf-lift))
              (set! (-> warp z) (-> tree-bs z))
              )
            (else
              ;; extracted brdroom glb bounds center, the original bring-up target
              (set! (-> warp x) -1457697.0)
              (set! (-> warp y) 435999.0)
              (set! (-> warp z) -602753.0)
              )
            )
          )
        )
      (jakx-cam-pin-view! warp (if *jakx-cam-warp-rot-valid*
                                   *jakx-cam-warp-rot*
                                   (the-as matrix #f)
                                   )
                          )
      ;; at the end of the pin window the ring has settled ('set-slave storms are
      ;; boot-time only), so retire the combiner: killing it and clearing the view
      ;; slots drops update-camera into its no-combiner pad fallback
      ;; (move-camera-from-pad), the verified-good path that flies the math-camera
      ;; directly off the pad and never resets it. The combiner branch is not
      ;; usable yet: it blends through an uninitialized stack matrix on this
      ;; bring-up, so it never produces a valid view even with a correct trans.
      (when (zero? *jakx-cam-warp-frames*)
        (kill-by-name "camera-combiner" *active-pool*)
        (dotimes (i 2)
          (view-push-context i)
          (view-set-active-camera-combiner (the-as basic #f))
          (view-pop-context)
          )
        (format 0 "cam-warp: released at <~m ~m ~m>, combiner retired~%"
                (-> warp x) (-> warp y) (-> warp z))
        (set! *jakx-cam-warp-level* (the level #f))
        ;; the seed itself stays in *save-camera-inv-rot*; only the pin ends here
        (set! *jakx-cam-warp-rot-valid* #f)
        )
      )
    )
  0
  (none)
  )

;; og:preserve-this bring-up gate: the retail top-level runs cam-start once per view
;; (view-push-context i / cam-start / view-pop-context, i = 0..1). Defaults ON since
;; the state machinery landed (gstate enter-state) and the ring runs clean: master +
;; both slaves (cam-free-floating / cam-fixed) + combiner all reach :code and survive
;; a full 40 s headless boot (~2550 frames). Set #f to boot with the ring dormant.
(define *jakx-cam-start* #t)

(defun jakx-cam-start-now ()
  (dotimes (i 2)
    (view-push-context i)
    (cam-start #f)
    (view-pop-context)
    )
  0
  )

(if *jakx-cam-start*
    (jakx-cam-start-now)
    )
