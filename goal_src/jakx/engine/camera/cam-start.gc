;;-*-Lisp-*-
(in-package goal)

;; name: cam-start.gc
;; name in dgo: cam-start
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

(defun cam-stop ()
  (kill-by-name "camera-master" *active-pool*)
  (kill-by-name "camera-slave" *active-pool*)
  (kill-by-name "camera-combiner" *active-pool*)
  (view-set-active-camera (the-as basic #f))
  (view-set-active-camera-combiner (the-as basic #f))
  #f
  )

(defun cam-start ((arg0 symbol))
  (cam-stop)
  (view-set-active-camera-combiner (the-as basic (ppointer->process (process-spawn
                                                                      camera-combiner
                                                                      :init cam-combiner-init
                                                                      :name "camera-combiner"
                                                                      :from *camera-dead-pool*
                                                                      :to *camera-pool*
                                                                      )
                                                                    )
                                           )
                                   )
  (view-set-active-camera (the-as basic (ppointer->process (process-spawn
                                                             camera-master
                                                             :init cam-master-init
                                                             :name "camera-master"
                                                             :from *camera-master-dead-pool*
                                                             :to *camera-pool*
                                                             )
                                                           )
                                  )
                          )
  0
  (none)
  )

;; og:preserve-this bring-up camera warp: nothing sends the camera-combiner
;; 'start-tracking through a real game flow yet (no target/entity chain), so after
;; the ring's boot settle the combiner trans freezes at the origin and cam-update
;; copies it over the math-camera every frame, frustum-culling the whole level away
;; (brdroom sits ~400 m out). A one-shot warp at play time used to get undone by the
;; ring's settle (the master's early 'set-slave / 'start-tracking pulls the combiner
;; back toward the origin-parked slave); issue 724 found the real fix is not
;; refighting that settle every frame but outlasting it: write the target into the
;; combiner once via the landed debug-set-camera-pos-rot! and hold 'cam-fixed as the
;; mode-name setting (jakx-cam-warp-tick below), so cam-fixed's own :code
;; (cam-states.gc:213-215) is what survives the settle, not a per-frame reapply.
;; Retire with the real camera start chain.
(define *jakx-cam-warp-level* (the level #f))
(define *jakx-cam-warp-frames* 0)
;; w > 0 marks the target valid; xyz = warp position
(define *jakx-cam-warp-target* (new 'static 'vector))
;; orientation override, decoded from a continue point's packed camera-rot; written
;; into the camera-combiner once via debug-set-camera-pos-rot! (cam-debug.gc:3147-
;; 3155) when the pin arms (see jakx-cam-warp-tick below). cam-fixed's own :code
;; (cam-states.gc:213-215) then holds both position and orientation, so nothing here
;; needs a per-frame *save-camera-inv-rot* reseed the way the retired combiner-kill
;; workaround did (issue 724).
(define *jakx-cam-warp-rot* (new 'static 'matrix))
(define *jakx-cam-warp-rot-valid* #f)
;; latches once jakx-cam-warp-tick has fired the one-shot combiner write for the
;; current arm cycle, so the pin does not refight itself every frame; reset to #f by
;; both arm entry points below (issue 724 rung 1).
(define *jakx-cam-warp-pinned* #f)

(defun jakx-cam-warp-to-level ((lev level))
  "og:preserve-this bring-up helper: arm the per-frame camera warp for the level
(see the comment above). Prefers the densest cluster in the level's actor table
(the camera lands amid birthable entities; a track's all-actor centroid is
mid-ring air and its BVH leaves are rim scenery), then the level bsphere, then
the extracted brdroom glb bounds center."
  (let ((bs (-> lev bsp bsphere)))
    (format 0 "cam-warp: armed for ~A bsphere <~m ~m ~m r ~m>~%"
            (-> lev name) (-> bs x) (-> bs y) (-> bs z) (-> bs w))
    )
  (set! (-> *jakx-cam-warp-target* w) 0.0)
  (let ((acts (-> lev bsp actors)))
    (when (nonzero? (the-as int acts))
      (let ((n (min 128 (-> acts length)))
            (best-i -1)
            (best-count 0)
            )
        ;; densest actor: most neighbors within 50m (204800 units)
        (dotimes (i n)
          (let ((count 0)
                (ci (-> acts data i bsphere))
                )
            (dotimes (k n)
              (let* ((ck (-> acts data k bsphere))
                     (dx (- (-> ck x) (-> ci x)))
                     (dz (- (-> ck z) (-> ci z)))
                     )
                (if (< (+ (* dx dx) (* dz dz)) (* 204800.0 204800.0))
                    (+! count 1)
                    )
                )
              )
            (when (> count best-count)
              (set! best-count count)
              (set! best-i i)
              )
            )
          )
        (when (>= best-i 0)
          (let ((cb (-> acts data best-i bsphere)))
            (set! (-> *jakx-cam-warp-target* x) (-> cb x))
            ;; 10m lift so the view is not inside a prop
            (set! (-> *jakx-cam-warp-target* y) (+ (-> cb y) 40960.0))
            (set! (-> *jakx-cam-warp-target* z) (-> cb z))
            (set! (-> *jakx-cam-warp-target* w) 1.0)
            (format 0 "cam-warp: actor-cluster target <~m ~m ~m> (~D neighbors)~%"
                    (-> *jakx-cam-warp-target* x)
                    (-> *jakx-cam-warp-target* y)
                    (-> *jakx-cam-warp-target* z)
                    best-count
                    )
            )
          )
        )
      )
    )
  (set! *jakx-cam-warp-level* lev)
  (set! *jakx-cam-warp-frames* 600)
  (set! *jakx-cam-warp-pinned* #f)
  0
  (none)
  )

(defun jakx-cam-warp-to-continue ((cp continue-point))
  "og:preserve-this bring-up helper: arm the camera warp at a continue point's
camera-trans with its packed camera-rot orientation (the retail start-line
framing) instead of deriving a target from level geometry. Decode matches jak3
move-camera!: nine row-major int16s at 1/32767 scale. Retire with the real
camera start chain alongside the level warp."
  (let ((lev (level-get *level* (-> cp level))))
    (cond
      (lev
        (set! (-> *jakx-cam-warp-target* x) (-> cp camera-trans x))
        (set! (-> *jakx-cam-warp-target* y) (-> cp camera-trans y))
        (set! (-> *jakx-cam-warp-target* z) (-> cp camera-trans z))
        (set! (-> *jakx-cam-warp-target* w) 1.0)
        (let ((m *jakx-cam-warp-rot*))
          (matrix-identity! m)
          (set! (-> m rvec x) (* 0.00003051851 (-> cp camera-rot 0)))
          (set! (-> m rvec y) (* 0.00003051851 (-> cp camera-rot 1)))
          (set! (-> m rvec z) (* 0.00003051851 (-> cp camera-rot 2)))
          (set! (-> m uvec x) (* 0.00003051851 (-> cp camera-rot 3)))
          (set! (-> m uvec y) (* 0.00003051851 (-> cp camera-rot 4)))
          (set! (-> m uvec z) (* 0.00003051851 (-> cp camera-rot 5)))
          (set! (-> m fvec x) (* 0.00003051851 (-> cp camera-rot 6)))
          (set! (-> m fvec y) (* 0.00003051851 (-> cp camera-rot 7)))
          (set! (-> m fvec z) (* 0.00003051851 (-> cp camera-rot 8)))
          )
        (set! *jakx-cam-warp-rot-valid* #t)
        (set! *jakx-cam-warp-level* lev)
        (set! *jakx-cam-warp-frames* 600)
        (set! *jakx-cam-warp-pinned* #f)
        (format 0 "cam-warp: continue ~S target <~m ~m ~m>~%"
                (-> cp name)
                (-> cp camera-trans x)
                (-> cp camera-trans y)
                (-> cp camera-trans z)
                )
        )
      (else
        (format 0 "cam-warp: continue ~S level ~A not loaded, warp not armed~%"
                (-> cp name)
                (-> cp level)
                )
        )
      )
    )
  0
  (none)
  )

;; og:preserve-this bring-up helper (#152): the camera-combiner/slave/math-camera
;; write set below used to live inline in jakx-cam-warp-tick (this file), and until
;; issue 724 that tick was still its per-frame caller. The racer chase camera
;; (level.gc) needs to pin the same four destinations every frame to a computed
;; chase position instead of a fixed warp target, so this stayed factored out
;; rather than duplicated; jakx-cam-warp-tick is no longer a caller (issue 724
;; replaced its per-frame pin with a one-shot debug-set-camera-pos-rot! write into
;; the combiner, cam-debug.gc:3147-3155), leaving level.gc's racer tick as the sole
;; remaining caller, which still passes #f for rot when it has no valid orientation.
;; Retires with the real camera start chain.
(defun jakx-cam-pin-view! ((pos vector) (rot matrix))
  "Write pos into the camera-combiner, camera-master's slave, and view-0 math-
camera trans; write rot (if non-#f) into the math-camera's inv-camera-rot and
*save-camera-inv-rot* so the pad fallback keeps the orientation after release."
  (let ((cc (the-as camera-combiner (view-get-active-camera-combiner))))
    (when (and (nonzero? cc) cc)
      (set! (-> cc trans x) (-> pos x))
      (set! (-> cc trans y) (-> pos y))
      (set! (-> cc trans z) (-> pos z))
      )
    )
  (let ((cam (the-as camera-master (view-get-active-camera))))
    (when (and (nonzero? cam) cam (nonzero? (-> cam slave)))
      (let ((slave (-> cam slave 0)))
        (when (nonzero? (the-as int slave))
          (set! (-> slave trans x) (-> pos x))
          (set! (-> slave trans y) (-> pos y))
          (set! (-> slave trans z) (-> pos z))
          )
        )
      )
    )
  (let ((mc (view-get-math-camera 0)))
    (when (nonzero? (the-as int mc))
      (set! (-> mc trans x) (-> pos x))
      (set! (-> mc trans y) (-> pos y))
      (set! (-> mc trans z) (-> pos z))
      (if rot
          (matrix-copy! (-> mc inv-camera-rot) rot)
          )
      )
    )
  ;; the pad fallback rebuilds the view from *save-camera-inv-rot* each frame, so
  ;; seeding it here is what makes an orientation survive a combiner release
  (if rot
      (matrix-copy! *save-camera-inv-rot* rot)
      )
  0
  (none)
  )

;; og:preserve-this issue 745: debug-set-camera-pos-rot! (cam-debug.gc:3147-
;; 3155) lives in a (declare-file (debug)) file (cam-debug.gc:67), so it is
;; only symbol 0 outside a -debug boot: gk's -boot mode sets DebugSegment = 0
;; and never links debug segments (kmachine.cpp:140-145), so the retail
;; smoke's call dispatched to goal 0 (crash: pp "display", [rsp+0]
;; cam-start+0x102b inside jakx-cam-warp-tick), while every -debug acceptance
;; boot linked the symbol and passed, which is what split the green
;; acceptance boots from the red smokes. Guarding the call with nonzero?
;; instead of landing a real callee would silently drop the warp pin in
;; every retail-mode boot, and the smoke's slides gate depends on the warp
;; actually landing, so this mirrors debug-set-camera-pos-rot!'s body
;; verbatim as a main-segment definition instead. Retire when a checker
;; exists for the debug-segment call class (a main-segment defun reaching a
;; (declare-file (debug)) symbol), or when the pin moves onto a retail
;; main-segment primitive.
(defun jakx-cam-set-pos-rot! ((pos vector) (rot matrix))
  (when (and (view-get-active-camera) (view-get-active-camera-combiner))
    (set! (-> (the-as camera-combiner (view-get-active-camera-combiner)) trans quad) (-> pos quad))
    (matrix-copy! (-> (the-as camera-combiner (view-get-active-camera-combiner)) inv-camera-rot) rot)
    (setting-control-method-22 *setting-control* 'mode-name 'cam-fixed 0 0)
    (cam-master-activate-slave #t)
    )
  pos
  )

(defun jakx-cam-warp-tick ()
  "og:preserve-this bring-up helper: while armed, write the warp target into the
camera-combiner once (jakx-cam-set-pos-rot! above, which mirrors debug-set-
camera-pos-rot!'s body, cam-debug.gc:3147-3155, on the main segment so a
-boot smoke can reach it, issue 745) and hold 'cam-fixed as the mode-name
setting so cam-fixed's own :code (cam-states.gc:213-215) keeps the ring there
instead of a per-frame reapply; release the hold after the counter runs out
(issue 724).

setting-control-method-22 (settings.gc:1354-1357) is add-connection on engine-hi,
so the mode-name change lands on the NEXT settings pump, one frame after this tick
fires the write. debug-set-camera-pos-rot!'s own immediate cam-master-activate-
slave call therefore respawns into whatever mode was active before this tick (not
yet 'cam-fixed); the pump's own entity-or-mode-changed re-spawn one frame later is
what actually lands the held cam-fixed slave. Harmless for a hold: the combiner's
trans is already correct by then (this tick set it directly, and the interim
slave's own :code would only be able to move it away for that single frame).

og:preserve-this hardening (crash: cam-start+0xca8 reading a stale view field,
value 0x14001627, repro (jakx-goto-level 'junglew \"jungle-wide-start\") from a
parked post-boot state): the combiner used to trust *jakx-cam-warp-level* for
the whole 600-frame pin window with no re-check after arming. jakx-goto-level's
residency gate (level.gc) only proves the target is resident at ARM time, for
the single level-name it was given; jakx-want-driver-tick's own family
recompute (level.gc) reads the camera position to pick its want-window, and
that position has not moved yet the first time the driver re-arms (the warp
only pins it on ITS OWN next tick, a separate call site), so the recompute can
fire against the still-stale pre-jump position and evict the just-armed level
within a handful of frames. deactivate (level.gc) then drops the level's
status from 'active/'alive back to 'loaded without freeing or renaming the
struct, so the struct stays truthy while the heap region its bsp/
drawable-trees point into is free to be overwritten by whatever loads into
that slot next. Every tick now re-resolves the target by name and requires
status 'active or 'alive -- the two statuses deactivate demotes away from --
before touching -> bsp; anything else retires the combiner cleanly instead of
reading through it."
  (when (and *jakx-cam-warp-level* (> *jakx-cam-warp-frames* 0))
    (let ((warp-lev (level-get *level* (-> *jakx-cam-warp-level* name))))
      (when (not (and warp-lev
                       (= warp-lev *jakx-cam-warp-level*)
                       (or (= (-> warp-lev status) 'active) (= (-> warp-lev status) 'alive))
                       )
                 )
        (format 0 "cam-warp: target ~A no longer resident (status ~A), releasing hold~%"
                (-> *jakx-cam-warp-level* name)
                (if warp-lev (-> warp-lev status) 'no-slot)
                )
        ;; og:preserve-this issue 724: releasing means dropping the 'cam-fixed hold,
        ;; not killing the combiner or the view slots -- the combiner stays alive and
        ;; the settings pump's own entity-or-mode-changed re-spawn (settings.gc:2022-
        ;; 2028) falls back to cam-free-floating the same way dm-cam-mode-default
        ;; does (default-menu.gc:211-217).
        (setting-control-method-21 *setting-control* 'mode-name)
        (set! *jakx-cam-warp-level* (the level #f))
        (set! *jakx-cam-warp-frames* 0)
        (set! *jakx-cam-warp-rot-valid* #f)
        (set! *jakx-cam-warp-pinned* #f)
        ;; og:preserve-this want-driver re-arm (follow-up rung, level.gc
        ;; jakx-goto-level): the goto that armed this warp deliberately left the
        ;; driver off rather than re-arm it against the pre-jump camera position;
        ;; this is one of its two exit paths (the other is the frame-exhaustion
        ;; release below), and both must re-arm it or the driver is left off for
        ;; good the moment a target dies mid-warp.
        (set! *jakx-want-driver* #t)
        (format 0 "cam-warp: want-driver re-armed (target lost)~%")
        (return 0)
        )
      )
    (set! *jakx-cam-warp-frames* (- *jakx-cam-warp-frames* 1))
    (let ((bs (-> *jakx-cam-warp-level* bsp bsphere))
          (warp (new 'stack-no-clear 'vector))
          )
      ;; drawable-tree bspheres carry the real level bounds even when the bsp
      ;; header bsphere is zeroed (garage, brdroom, junglea all zero it). But a
      ;; track's bounds CENTER is empty air (junglea: zero verts within 100m of
      ;; it), so descend the first tree's BVH to its first leaf cluster: that
      ;; bsphere sits ON geometry for interiors and exteriors alike. Note the
      ;; continue-point trans is NOT a usable fallback: garage's continue sits
      ;; ~1km from the geometry.
      (let ((tree-bs (the-as vector #f))
            (leaf-lift 0.0)
            )
        (let ((trees (-> *jakx-cam-warp-level* bsp drawable-trees)))
          (when (nonzero? (the-as int trees))
            (dotimes (i (-> trees length))
              (let ((tree (-> trees trees i)))
                (when (and (not tree-bs) (< 0.0 (-> tree bsphere w)) (> (-> tree length) 0))
                  ;; start from the MIDDLE root child, then first-child descent:
                  ;; the first leaf of a track BVH tends to be interior detail
                  ;; (junglea: a stone tunnel wall at point-blank range), while
                  ;; a mid-list branch lands in more representative geometry.
                  ;; The stride-32 pick only applies to draw-node arrays.
                  (let* ((dia (the-as drawable-inline-array (-> tree data 0)))
                         (dr (the-as drawable (&+ (the-as pointer dia) 32)))
                         )
                    (when (and (= (-> dr type) draw-node) (> (the int (-> dia length)) 1))
                      (set! dr (the-as drawable
                                       (&+ (the-as pointer dia)
                                           (+ 32 (* 32 (/ (+ -1 (the int (-> dia length))) 2)))
                                           )
                               )
                            )
                      )
                    (dotimes (d 8)
                      (when (and dr (= (-> dr type) draw-node))
                        (set! dr (-> (the-as draw-node dr) child))
                        )
                      )
                    (cond
                      ((and dr (< 0.0 (-> dr bsphere w)))
                       (set! tree-bs (-> dr bsphere))
                       ;; hover half the cluster radius above its center so the
                       ;; camera is not embedded in the surface (higher lifts
                       ;; can clear the local geometry entirely into empty sky)
                       (set! leaf-lift (* 0.5 (-> dr bsphere w)))
                       )
                      (else
                        (set! tree-bs (-> tree bsphere))
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        ;; prefer the actor-cluster target computed at arm time: the camera
        ;; lands amid the actual birthable entities instead of an arbitrary
        ;; BVH leaf (a track's leaf clusters sit on rim scenery; junglea's
        ;; puts the release point ~570m from the nearest entity cluster)
        (let ((ent-bs (the-as vector #f)))
          (if (< 0.0 (-> *jakx-cam-warp-target* w))
              (set! ent-bs *jakx-cam-warp-target*)
              )
          (cond
            (ent-bs
              (set! (-> warp x) (-> ent-bs x))
              (set! (-> warp y) (-> ent-bs y))
              (set! (-> warp z) (-> ent-bs z))
              )
            ((< 0.0 (-> bs w))
             (set! (-> warp x) (-> bs x))
             (set! (-> warp y) (-> bs y))
             (set! (-> warp z) (-> bs z))
             )
            (tree-bs
              (set! (-> warp x) (-> tree-bs x))
              (set! (-> warp y) (+ (-> tree-bs y) leaf-lift))
              (set! (-> warp z) (-> tree-bs z))
              )
            (else
              ;; extracted brdroom glb bounds center, the original bring-up target
              (set! (-> warp x) -1457697.0)
              (set! (-> warp y) 435999.0)
              (set! (-> warp z) -602753.0)
              )
            )
          )
        )
      ;; og:preserve-this issue 724: the pin write is one-shot, not per-frame. The
      ;; investigation falsified the old "combiner blends through an uninitialized
      ;; stack matrix" theory that justified killing the combiner every release; the
      ;; real mechanism was frame ordering (update-camera, main.gc:3078, consumes
      ;; the combiner before this tick, main.gc:3081, writes it, so a same-frame
      ;; combiner write cannot show up until next frame) plus write ownership (the
      ;; combiner branch overwrites the math-camera from the combiner every frame,
      ;; cam-update.gc:521-531). Once the combiner holds the right trans, that
      ;; branch keeps propagating it on its own, and cam-combiner's own :code
      ;; (cam-combiner.gc:236) keeps re-deriving the combiner's trans from the
      ;; active slave, which for 'cam-fixed just replays its saved-pt
      ;; (cam-states.gc:213-218) -- so once armed, nothing here needs to fight the
      ;; ring again. jakx-cam-set-pos-rot! above (issue 745) is what performs
      ;; this write plus the mode-name arm now: it mirrors debug-set-camera-
      ;; pos-rot! (cam-debug.gc:3147-3155) verbatim, the landed retail
      ;; primitive that inspired it, but on the main segment, because
      ;; cam-debug.gc is (declare-file (debug)) and a -boot smoke never
      ;; links the debug segment (kmachine.cpp:140-145).
      (when (not *jakx-cam-warp-pinned*)
        (let ((cc (the-as camera-combiner (view-get-active-camera-combiner))))
          (when (and (nonzero? cc) cc)
            (jakx-cam-set-pos-rot! warp
                                    (if *jakx-cam-warp-rot-valid*
                                        *jakx-cam-warp-rot*
                                        (-> cc inv-camera-rot)
                                        )
                                    )
            )
          )
        (set! *jakx-cam-warp-pinned* #t)
        )
      ;; at the end of the pin window release the 'cam-fixed hold instead of
      ;; retiring the combiner: dropping the mode-name setting (mirroring dm-cam-
      ;; mode-default, default-menu.gc:211-217) lets the settings pump's own
      ;; entity-or-mode-changed re-spawn (settings.gc:2022-2028) fall back to
      ;; cam-free-floating on its own, with the combiner and master both still
      ;; alive for rung 2's free-flight lever (issue 724).
      (when (zero? *jakx-cam-warp-frames*)
        (setting-control-method-21 *setting-control* 'mode-name)
        (format 0 "cam-warp: released at <~m ~m ~m>, hold released~%"
                (-> warp x) (-> warp y) (-> warp z))
        (set! *jakx-cam-warp-level* (the level #f))
        (set! *jakx-cam-warp-rot-valid* #f)
        (set! *jakx-cam-warp-pinned* #f)
        ;; og:preserve-this want-driver re-arm (follow-up rung, level.gc
        ;; jakx-goto-level): the other of the two exit paths that must re-arm the
        ;; driver (see the dead-target retire above for the other). The camera has
        ;; just spent this whole tick pinned at `warp`, so the driver's first
        ;; recompute (jakx-want-driver-tick, level.gc) now scores the actual
        ;; destination instead of the pre-jump position.
        (set! *jakx-want-driver* #t)
        (format 0 "cam-warp: want-driver re-armed (released)~%")
        )
      )
    )
  0
  (none)
  )

;; og:preserve-this bring-up gate: the retail top-level runs cam-start once per view
;; (view-push-context i / cam-start / view-pop-context, i = 0..1). Defaults ON since
;; the state machinery landed (gstate enter-state) and the ring runs clean: master +
;; both slaves (cam-free-floating / cam-fixed) + combiner all reach :code and survive
;; a full 40 s headless boot (~2550 frames). Set #f to boot with the ring dormant.
(define *jakx-cam-start* #t)

(defun jakx-cam-start-now ()
  (dotimes (i 2)
    (view-push-context i)
    (cam-start #f)
    (view-pop-context)
    )
  0
  )

(if *jakx-cam-start*
    (jakx-cam-start-now)
    )
