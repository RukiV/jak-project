;; definition for method 8 of type collide-hash
;; INFO: Used lq/sq
;; og:preserve-this both (ash 1 (logand a0-11 31)) sites hand-cast a0-11 to int:
;; the decompiler's own scratchpad-pointer type_casts fix (decompiler/config/jakx/
;; ntsc_v1/type_casts.jsonc, "(method 8 collide-hash)") resolves the two
;; (pointer uint32) derefs cleanly but leaves the bit-index (item id, declared
;; uint) printed straight into logand, which goalc rejects as ash's exponent arg
;; (expects int). Same byte-identical semantics, only the printed type differs.
(defmethod mem-usage ((this collide-hash) (usage memory-usage-block) (flags int))
  (set! (-> usage length) (max 51 (-> usage length)))
  (set! (-> usage data 50 name) "collision")
  (+! (-> usage data 50 count) 1)
  (let ((v1-8 (+ (* (-> this num-items) 8) 96 (* (-> this num-buckets) 4))))
    (+! (-> usage data 50 used) v1-8)
    (+! (-> usage data 50 total) (logand -16 (+ v1-8 15)))
    )
  (dotimes (v1-12 (the-as int (-> this qwc-id-bits)))
    (set! (-> (the-as (pointer uint128) (+ (* v1-12 16) #x70000000)) 0) (the-as uint128 0))
    )
  (dotimes (s3-0 (the-as int (-> this num-items)))
    (let* ((a0-11 (-> this item-array s3-0 id))
           (v1-17 (shr a0-11 5))
           )
      (when (not (logtest? (-> (the-as (pointer uint32) (+ (* v1-17 4) #x70000000)) 0) (ash 1 (logand (the-as int a0-11) 31))))
        (logior! (-> (the-as (pointer uint32) (+ (* v1-17 4) #x70000000)) 0) (ash 1 (logand (the-as int a0-11) 31)))
        (if (= (-> this item-array s3-0 collidable type) collide-hash-fragment)
            (mem-usage (-> this item-array s3-0 collidable) usage flags)
            )
        )
      )
    )
  this
  )

;; definition for method 8 of type collide-hash-fragment
(defmethod mem-usage ((this collide-hash-fragment) (usage memory-usage-block) (flags int))
  (cond
    ((logtest? flags 1)
     (set! (-> usage length) (max 58 (-> usage length)))
     (set! (-> usage data 55 name) "prototype-fragment")
     (+! (-> usage data 55 count) 1)
     (set! (-> usage data 56 name) "prototype-poly")
     (+! (-> usage data 56 count) (-> this stats num-polys))
     (set! (-> usage data 57 name) "prototype-vertex")
     (+! (-> usage data 57 count) (-> this stats num-verts))
     (let ((a3-0 (+ (-> this num-indices) 112 (* (-> this num-buckets) 4)))
           (a2-6 (* (-> this stats num-polys) 4))
           (v1-16 (* (the-as uint 6) (-> this stats num-verts)))
           )
       (+! (-> usage data 55 used) a3-0)
       (+! (-> usage data 55 total) (- (logand -16 (+ v1-16 15 a2-6 a3-0)) (the-as int (+ a2-6 v1-16))))
       (+! (-> usage data 56 used) a2-6)
       (+! (-> usage data 56 total) a2-6)
       (+! (-> usage data 57 used) v1-16)
       (+! (-> usage data 57 total) v1-16)
       )
     )
    (else
      (set! (-> usage length) (max 54 (-> usage length)))
      (set! (-> usage data 51 name) "collision-fragment")
      (+! (-> usage data 51 count) 1)
      (set! (-> usage data 52 name) "collision-poly")
      (+! (-> usage data 52 count) (-> this stats num-polys))
      (set! (-> usage data 53 name) "collision-vertex")
      (+! (-> usage data 53 count) (-> this stats num-verts))
      (let ((a3-8 (+ (-> this num-indices) 112 (* (-> this num-buckets) 4)))
            (a2-16 (* (-> this stats num-polys) 4))
            (v1-33 (* (the-as uint 6) (-> this stats num-verts)))
            )
        (+! (-> usage data 51 used) a3-8)
        (+! (-> usage data 51 total) (- (logand -16 (+ v1-33 15 a2-16 a3-8)) (the-as int (+ a2-16 v1-33))))
        (+! (-> usage data 52 used) a2-16)
        (+! (-> usage data 52 total) a2-16)
        (+! (-> usage data 53 used) v1-33)
        (+! (-> usage data 53 total) v1-33)
        )
      )
    )
  this
  )

;; definition for method 8 of type collide-hash-fragment-array
(defmethod mem-usage ((this collide-hash-fragment-array) (usage memory-usage-block) (flags int))
  (set! (-> usage length) (max 55 (-> usage length)))
  (set! (-> usage data 54 name) "prototype-collision")
  (+! (-> usage data 54 count) 1)
  (let ((v1-6 (asize-of this)))
    (+! (-> usage data 54 used) v1-6)
    (+! (-> usage data 54 total) (logand -16 (+ v1-6 15)))
    )
  (dotimes (s3-0 (-> this length))
    (mem-usage (-> this fragments s3-0) usage flags)
    )
  this
  )
