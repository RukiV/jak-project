;;-*-Lisp-*-
(in-package goal)

;; name: entity-h.gc
;; name in dgo: entity-h
;; dgos: ENGINE, GAME

;; +++entity-perm-status
(defenum entity-perm-status
  :bitfield #t
  :type uint16
  (bit-0 0) ;; blocks birth
  (error 1)
  (dead 2)
  (no-kill 3)
  (bit-4 4)
  (bit-5 5)
  (subtask-complete 6)
  (special 7)
  (complete 8)
  (bit-9 9)
  (bit-10 10)
  (save 11)
  (bit-12 12)
  (bit-13 13)
  (bit-14 14)
  (bit-15 15)
  )
;; ---entity-perm-status

(declare-type race-mesh basic)
(declare-type nav-poly structure)

;; DECOMP BEGINS

(define *generate-actor-vis* #f)

(define *generate-actor-vis-start* #f)

(define *generate-actor-vis-output* #f)

(deftype entity-perm (structure)
  "Entity information that gets persisted in the save file."
  ((user-object  object   2)
   (user-uint64  uint64     :overlay-at (-> user-object 0))
   (user-float   float    2 :overlay-at (-> user-object 0))
   (user-int32   int32    2 :overlay-at (-> user-object 0))
   (user-uint32  uint32   2 :overlay-at (-> user-object 0))
   (user-int16   int16    4 :overlay-at (-> user-object 0))
   (user-uint16  uint16   4 :overlay-at (-> user-object 0))
   (user-int8    int8     8 :overlay-at (-> user-object 0))
   (user-uint8   uint8    8 :overlay-at (-> user-object 0))
   (status       entity-perm-status)
   (dummy        uint8    1)
   (task         game-task)
   (aid          actor-id)
   (quad         uint128    :overlay-at (-> user-object 0))
   )
  (:methods
    (update (_type_ symbol entity-perm-status) _type_)
    )
  )


(deftype entity-links (structure)
  "A linked list of entities with some extra data about their current status."
  ((prev-link  entity-links)
   (next-link  entity-links)
   (entity     entity)
   (process    process)
   (level      level)
   (vis-id     int32)
   (kill-mask  task-mask)
   (vis-dist   meters)
   (trans      vector              :inline)
   (perm       entity-perm         :inline)
   (status     entity-perm-status  :overlay-at (-> perm status))
   (aid        uint32              :overlay-at (-> perm aid))
   (task       game-task           :overlay-at (-> perm task))
   )
  (:methods
    (birth? (_type_ vector) symbol)
    )
  )


(deftype entity-perm-array (inline-array-class)
  ((data  entity-perm  :inline :dynamic)
   )
  )


(set! (-> entity-perm-array heap-base) (the-as uint 16))

(deftype entity-links-array (inline-array-class)
  "An array of [[entity-links]].
Levels store a reference to this which holds all the entities in the level."
  ((data  entity-links  :inline :dynamic)
   )
  )


(set! (-> entity-links-array heap-base) (the-as uint 64))

(deftype entity (res-lump)
  "Entities are mainly used to place objects in a level.

As a child of [[res-lump]], they store various types of metadata
in [[res-tag]]s (such as name, curve data, volume data, etc.)
that gets accessed by the accompanying process."
  ((trans    vector  :inline)
   (aid      uint32)
   (unknown  uint32)
   )
  (:methods
    (birth! (_type_) _type_)
    (kill! (_type_) _type_)
    (add-to-level! (_type_ level-group level actor-id) none) ;; 24
    (remove-from-level! (_type_ level-group) _type_) ;; 25
    (get-level (_type_) level)
    )
  )

(deftype entity-camera (entity)
  ((connect  quaternion  :inline)
   )
  )

(deftype entity-nav-mesh (entity)
  ((nav-mesh  nav-mesh)
   )
  (:methods
    (initialize-nav-mesh! (_type_) none)
    (debug-draw (_type_) none)
    )
  )

(deftype entity-race-mesh (entity)
  ((race-mesh  race-mesh)
   )
  (:methods
    (entity-race-mesh-method-27 () none)
    (entity-race-mesh-method-28 () none)
    )
  )

(deftype entity-actor (entity)
  "Child class of [[entity]] used to spawn [[process-drawable]] actors."
  ;; jakx: every entity-actor field sits one slot later than jak3 (+4) because jakx's
  ;; entity grew the unknown name-cache slot at 52. kill-mask shifts with the rest to 56;
  ;; overlaying it at unknown (52) would corrupt the entity-by-name cache. Order and
  ;; offsets must match all-types exactly: JakXTypeConsistency compares field by field.
  ((kill-mask  task-mask   :offset  56)
   (etype      type        :offset  60)
   (task       game-task   :offset  64)
   (vis-id     int16       :offset  66)
   (quat       quaternion  :inline :offset  80)
   )
  (:methods
    (next-actor (_type_) entity-actor)
    (prev-actor (_type_) entity-actor)
    (debug-print (_type_ symbol type) none)
    (toggle-status (_type_ entity-perm-status symbol) none)
    (get-simple-travel-vector (_type_ vector vector vector object float) nav-mesh)
    (project-point-to-nav-mesh (_type_ vector vector nav-poly float) nav-poly)
    )
  )

(deftype actor-reference (structure)
  ((actor  entity-actor)
   (id     uint32)
   )
  :pack-me
  )


(deftype actor-group (inline-array-class)
  ;; jakx delta vs jak3: inline actor-reference entries at offset 12, an anomaly
  ;; against the shared inline-array-class base (whose _data sits at 16 in both
  ;; games, as jak3's actor-group keeps it); birth's fixup loop pins it, reading
  ;; actor at 12+i*8 and id at 16+i*8
  ((data  actor-reference  :dynamic :inline :offset 12)
   )
  )


(set! (-> actor-group heap-base) (the-as uint 8))

(deftype entity-info (basic)
  ((ptype      object)
   (pool       symbol)
   (heap-size  int32)
   )
  )


(deftype actor-bank (basic)
  ((pause-dist  float)
   (birth-dist  float)
   (birth-max   int32)
   )
  )


(define *ACTOR-bank* (new 'static 'actor-bank :pause-dist 204800.0 :birth-dist 901120.0 :birth-max 10))

;; og:preserve-this: entity-birth-no-kill is a forward declaration, not a
;; decoded symbol. script.gc's 'alive script-form command (the script
;; family lane) activates two calls to this function, which jak3 lands as
;; a real defun in entity.gc, (entity) process; jakx's own entity.gc has
;; no defun for it yet.
;; RUNTIME HAZARD: entity-birth-no-kill links as zero until a real body
;; lands. script.gc's 'alive script command crashes if invoked.
(define-extern entity-birth-no-kill (function entity process))

;; og:preserve-this: birth-pickup-at-point is a forward declaration, not a
;; decoded symbol. script.gc's 'birth-pickup script-form command (the
;; script family lane) activates a call to this function; jakx has no
;; collectables.gc landed at all yet (jak3 defines it there), and jakx's
;; own process-drawable.gc already references this same symbol from an
;; asm-parked body ("parked: unknown symbols (birth-pickup-at-point,
;; fuel-cell)"), confirming this is a pre-existing corpus-wide gap, not
;; something this rung introduces. Signature adopted from
;; decompiler/config/jakx/all-types.gc's own comment, itself adopted from
;; jak1/jak2/jak3's identical signature.
;; RUNTIME HAZARD: birth-pickup-at-point links as zero until a real body
;; lands (in collectables.gc, per jak3). script.gc's 'birth-pickup script
;; command crashes if invoked.
(define-extern birth-pickup-at-point (function vector pickup-type float symbol process-tree fact-info (pointer process) :behavior process))
