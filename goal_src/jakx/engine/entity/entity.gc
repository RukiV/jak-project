;;-*-Lisp-*-
(in-package goal)

;; name: entity.gc
;; name in dgo: entity
;; dgos: ENGINE, GAME

;; og:preserve-this externs for symbols whose home objects are unlanded stubs:
;; entity-info-lookup lives in entity-table.o and birth-viewer in viewer.o; both
;; call sites below carry runtime-link guards until those objects land.
(define-extern entity-info-lookup (function type entity-info))
(define-extern birth-viewer (function process entity-actor object))

;; DECOMP BEGINS

;; og:preserve-this partial landing (rungs 5 + 6b): the birth chain is live from
;; clean machine output (entity-by-aid, add-to-level!, remove-from-level!, the
;; birth!/kill! family, init-entity, entity-deactivate-handler, birth and
;; deactivate-entities on bsp-header), plus actors-update (the per-frame
;; birth!/kill! driver, called from real-main-draw-hook) and the
;; additional-spawner/vis-predicate surface. Still pending: the debug tooling
;; (draw-actor-marks, entity-speed-test, process-status-bits and friends).
;; jakx caches the entity name in the `unknown` slot where jak3 did a
;; res-lump lookup.

(define *spawn-actors* #t)

;; og:preserve-this bring-up: #f until relocate.gc lands. The dead-pool compactor
;; relocates process heaps, and the relocate overrides for the newly-landed
;; process types (part-spawner, part-tracker, manipy, lightning-tracker) live in
;; the still-stubbed relocate.gc -- without them, compaction leaves stale
;; part/sound pointers and deactivate later dispatches through garbage (the
;; attract-camera DEP crash). Restore #t with the relocate.gc landing.
(define *compact-actors* #f)

;; og:preserve-this restored to the retail default #t in the #41 follow-up pass:
;; births gate on vis-bits, which carry real per-leaf occlusion since the vis leg
;; (PR 144). The bring-up's distance-only interim (#f) is over; if actor spawning
;; ever needs the old behavior for debugging, flip in the REPL, do not commit #f.
(define *vis-actors* #t)

(defun process-entity-set! ((arg0 process) (arg1 entity))
  (set! (-> arg0 entity) (the-as entity-actor arg1))
  (if arg1
      (set! (-> arg0 level) (-> arg1 extra level))
      (set! (-> arg0 level) (-> *level* level-default))
      )
  arg1
  )

;; WARN: Return type mismatch process-drawable vs none.
(defun process-drawable-from-entity! ((arg0 process-drawable) (arg1 entity-actor))
  (logior! (-> arg0 mask) (process-mask actor-pause))
  (set! (-> arg0 root trans quad) (-> arg1 extra trans quad))
  (quaternion-copy! (the-as quaternion (-> arg0 root rot)) (-> arg1 quat))
  (vector-identity! (-> arg0 root scale))
  (none)
  )

(define *additional-spawner-count* 0)

(define *additional-spawners* (new 'static 'array handle 1 (new 'static 'handle)))

;; og:preserve-this jakx-only subsystem, no jak3 counterpart: a one-slot registry
;; of spawner processes whose distance also satisfies the actor birth check
;; (vis-dist-additional-ok?). Nothing registers into it until the race legs land.
(defun register-additional-spawner ((arg0 process))
  (when (>= *additional-spawner-count* 1)
    (break!)
    0
    )
  (set! (-> *additional-spawners* *additional-spawner-count*) (process->handle arg0))
  (let ((v0-0 (+ *additional-spawner-count* 1)))
    (set! *additional-spawner-count* v0-0)
    v0-0
    )
  )

(defun unregister-spawner-at-index ((arg0 int))
  (when (!= arg0 -1)
    (dotimes (v1-1 (- *additional-spawner-count* (+ arg0 1)))
      (set! (-> *additional-spawners* (+ v1-1 arg0)) (-> *additional-spawners* (+ arg0 1 v1-1)))
      )
    (set! *additional-spawner-count* (+ *additional-spawner-count* -1))
    )
  (none)
  )

;; og:preserve-this bring-up racer spawn extern (#152): skel-jungle-clay-jar-a is
;; jgx-resident (jungle-obs.gc, dgos HAVJUNGW/HAVTOURW/HJX/JGX/JUNGLEW), which
;; compiles well after this file (game.gd's own file list finishes before game.gp
;; even reaches jgx.gd, an independent level DGO). Same forward-decl shape as the
;; view.gc/logic-target.gc R4 precedent (#122). manipy and manipy-init need no such
;; extern: generic-obs.gc compiles earlier in game.gd (build order 299) than this
;; file (329). skel-ice-flag (generic-obs.gc, same build-order reasoning) needs no
;; extern either. Retires with the real vehicle chain (#152 names the tiers), same
;; as the racer levers in level.gc.
(define-extern skel-jungle-clay-jar-a skeleton-group)

;; 'havjungw resolves to skel-jungle-clay-jar-a, not a new resident skeleton (#129).
;; Evidence: this file's own extern note above already lists HJX among
;; skel-jungle-clay-jar-a's resident DGOs (jungle-obs.gc, dgos
;; HAVJUNGW/HAVTOURW/HJX/JGX/JUNGLEW). Independently, from the #129 arming: hjx.gd
;; (goal_src/jakx/dgos) carries both jungle-obs.o (the code defining the
;; defskelgroup) and jungle-clay-jar-a-ag.go (the art group it needs) together, the
;; same pairing jgx.gd already carries for the jungle family. havjungw.gd itself
;; only carries jungle-obs.o, not the art group, but every one of havjungw's six
;; continues (level-info.gc) wants at least one jungle section DGO that does carry
;; jungle-clay-jar-a-ag.go: junglea (jga.gd) and jungleg (jgg.gd) both ship it and
;; cover four of the six continues directly; the "havjung-junglef-start" continue
;; (#129's own acceptance continue) wants junglef (jgf.gd) displayed, which does
;; NOT carry the art group, but also wants junglee (jge.gd) non-displayed, which
;; does -- and a non-displayed want still loads the level (display? only gates
;; rendering, not residency; see the level-buffer-state-small note in
;; jakx-shared-level-arming-recipe). So skel-jungle-clay-jar-a is resident across
;; every havjungw continue, junglef-start included, just not via junglef itself.
(defun jakx-racer-skel-for-family ((family symbol))
  "og:preserve-this racer skeleton family dispatch (#193 root-cause doc, section
2.5(c), \"the durable version of (b)\"): mirrors jakx-racer-track-for-family's
(level.gc) family keying one-for-one so the baked centerline and the resident
skeleton-group never drift out of sync. 'junglew (and no boot continue armed
yet, matching the track dispatch's own #f case) keeps the pre-#193 jungle donor,
skel-jungle-clay-jar-a -- it is level-arted (jungle-obs.o, no permanent DGO) and
reads back as integer 0, not #f, when its level never loaded, because the symbol
table is kmalloc'd with KMALLOC_MEMSET (game/kernel/jakx/kscheme.cpp:1550) and
zero-fills every never-assigned symbol; GOAL's (not 0) is #f, so a (not arg0)
guard against that value never fires. jakx-racer-spawn's own zero? guard below
exists for exactly that case. 'icew resolves to skel-ice-flag
(generic-obs.gc), landed permanently resident so it can never hit that trap.
'havjungw resolves to skel-jungle-clay-jar-a (#129): see the note above this
function for the residency evidence, continue by continue. Every other family
returns #f so the caller refuses rather than handing the racer an unrelated
world's art. The refusal branch needs its own cast for the same reason
jakx-racer-track-for-family's does: a bare #f there would widen this function's
inferred return type to plain object."
  (cond
    ((or (not family) (= family 'junglew)) skel-jungle-clay-jar-a)
    ((= family 'icew) skel-ice-flag)
    ((= family 'havjungw) skel-jungle-clay-jar-a)
    (else (the-as skeleton-group #f))
    )
  )

(defun jakx-racer-spawn ()
  "og:preserve-this bring-up racer spawn (#152, #192, #193): manual REPL lever, since
there is no C-side boot arg to arm it automatically (see the *jakx-racer* note
in level.gc). Call from the REPL after boot: (jakx-racer-spawn), then (set!
*jakx-racer* #t) to start it moving. Spawns a family-resident manipy (skel is now
resolved per family, see jakx-racer-skel-for-family above) at the boot continue's
trans (*jakx-want-driver-cp*, set by play's boot-cp branch) and registers it as an
additional actor-birth spawner. Independent of *jakx-racer* on purpose: spawning
and inspecting the process is useful even before movement is armed. Gated on
jakx-racer-track-for-family (level.gc) resolving a real table for the boot
continue's own :level (#192), AND on the family-keyed skel resolving to a real
resident skeleton-group rather than an unbound (integer 0) one (#193): a family
with no baked centerline, or a family whose donor art is not resident this boot,
refuses to spawn with a loud format message, rather than spawning a manipy
jakx-racer-tick would then have nothing correct to drive for, or that faults the
instant initialize-skeleton reads its null skeleton-group. No-op (silent,
unchanged from #152) if no boot continue is armed yet, if the spawner slot is
taken, or if already spawned. Retires with the real vehicle chain."
  (when (and *jakx-want-driver-cp*
             (zero? *additional-spawner-count*)
             (not (handle->process (-> *jakx-racer-handle* 0)))
             )
    (let* ((family (-> *jakx-want-driver-cp* level))
           (track (jakx-racer-track-for-family family))
           (skel (jakx-racer-skel-for-family family))
           )
      (if (or (not track) (zero? (the-as int skel)))
          (format 0 "racer: no baked centerline or no resident art for ~A, refusing to spawn~%"
                  family
                  )
          (let ((proc (the-as process-drawable
                               (ppointer->process
                                 (process-spawn manipy
                                                :init manipy-init
                                                (-> *jakx-want-driver-cp* trans)
                                                #f
                                                skel
                                                #f
                                                0
                                                :name "jakx-racer"
                                                :from *default-dead-pool*
                                                :to *entity-pool*
                                                )
                                 )
                               )
                      )
                )
            (when proc
              (set! (-> *jakx-racer-handle* 0) (process->handle proc))
              (set! *jakx-racer-target-index* 0)
              (register-additional-spawner proc)
              (format 0 "racer: spawned at ~S <~m ~m ~m>~%"
                      (-> *jakx-want-driver-cp* name)
                      (-> proc root trans x)
                      (-> proc root trans y)
                      (-> proc root trans z)
                      )
              ;; og bring-up diagnostics (#193 root-cause doc, section 5 "cheapest
              ;; experiment"): confirm the donor/adoption story from #162 in one log
              ;; read, no behavior change. First line names the level the racer's art
              ;; actually resolved onto (process's own level field, written by #162's
              ;; art-group-get-by-name out-param); second line prints the resolved
              ;; frame-group's address alongside that donor level's heap range, so an
              ;; observer can confirm frame-group falls inside [base, top-base) by eye.
              (format 0 "racer: donor level ~A~%" (-> proc level name))
              (format 0 "racer: root-channel frame-group #x~X, donor heap [#x~X, #x~X)~%"
                      (-> proc skel root-channel 0 frame-group)
                      (-> proc level heap base)
                      (-> proc level heap top-base)
                      )
              )
            )
          )
      )
    )
  (none)
  )

;; og:preserve-this M1 vehicle-leg dev-lever (rung 2): handle stored the same way
;; *jakx-racer-handle* is (level.gc's own note, cited there in full): GOAL symbol
;; value slots are 32 bits, so a bare handle-typed symbol would truncate the
;; pid half on every store; a one-element 'static 'array of handle is a real
;; 64-bit field instead. A separate slot from *jakx-racer-handle* on purpose,
;; so the racer and a parked vehicle can coexist.
(define *jakx-vehicle-handle* (new 'static 'array handle 1 (new 'static 'handle)))
(set! (-> *jakx-vehicle-handle* 0) (the-as handle #f))

(defun jakx-vehicle-spawn ((pos vector))
  "og:preserve-this bring-up vehicle spawn (M1 vehicle-leg rung 2): fresh
sibling to jakx-racer-spawn above, not a modification of it. Manual REPL
lever: (jakx-vehicle-spawn (-> *jakx-want-driver-cp* trans)) after boot, or
pass any explicit position. Spawns a manipy wearing skel-falcon-chassis
(generic-obs.gc), the M1 milestone's parked, renderable car body: no
physics, no driving, no pilot chain, no additional-spawner registration
(that registry is a single slot already owned by jakx-racer-spawn --
register-additional-spawner traps if called a second time while it is
held -- and this vehicle sits at a fixed position near the start line,
within ordinary visibility range, unlike the racer which travels the
whole track and needs the vis-dist-additional-ok? bypass to match).
Refuses if skel-falcon-chassis reads back as (zero? (the-as int ...)): an
unbound symbol is truthy integer 0, not #f, because the symbol table is
kmalloc'd with KMALLOC_MEMSET (game/kernel/jakx/kscheme.cpp:1550) and
zero-fills every never-assigned symbol, so a plain (not skel) guard could
never catch it (jakx-racer-spawn's own #193 fix). skel-falcon-chassis was
landed this rung specifically as a permanent-object defskelgroup so it can
never actually be unassigned; this check is defensive, not an expected
failure path. Does NOT check that jakvl's own art is resident: JAKVL.DGO
must be wanted (jakx-vehicle-want-level!, load-state.gc) and loaded first,
or the chassis renders with placeholder art regardless of this guard.
No-op if already spawned. Retires with the real vehicle chain."
  (when (not (handle->process (-> *jakx-vehicle-handle* 0)))
    (if (zero? (the-as int skel-falcon-chassis))
        (format 0 "vehicle: skel-falcon-chassis unbound, refusing to spawn~%")
        (let ((proc (the-as process-drawable
                             (ppointer->process
                               (process-spawn manipy
                                              :init manipy-init
                                              pos
                                              #f
                                              skel-falcon-chassis
                                              #f
                                              0
                                              :name "jakx-vehicle"
                                              :from *default-dead-pool*
                                              :to *entity-pool*
                                              )
                                )
                              )
                    )
              )
          (when proc
            (set! (-> *jakx-vehicle-handle* 0) (process->handle proc))
            (format 0 "vehicle: spawned at <~m ~m ~m>~%"
                    (-> proc root trans x)
                    (-> proc root trans y)
                    (-> proc root trans z)
                    )
            ;; og bring-up diagnostics, same shape as jakx-racer-spawn's own
            ;; (#193 root-cause doc, section 5 "cheapest experiment"): confirm
            ;; the donor/adoption story in one log read, no behavior change.
            (format 0 "vehicle: donor level ~A~%" (-> proc level name))
            (format 0 "vehicle: root-channel frame-group #x~X, donor heap [#x~X, #x~X)~%"
                    (-> proc skel root-channel 0 frame-group)
                    (-> proc level heap base)
                    (-> proc level heap top-base)
                    )
            )
          )
        )
    )
  (none)
  )

;; og:preserve-this jakx viewport delta vs jak3: actors-update captures the active
;; math camera position per viewport into these, and the vis distance checks below
;; test both when *view-count* is 2. jak3 keeps a single camera-pos local instead.
(define *camera-pos-0* (new 'static 'vector))

(define *camera-pos-1* (new 'static 'vector))

(defun vis-cull-all? ((arg0 level) (arg1 int))
  (or (is-object-visible? arg0 arg1 0) (and (= *view-count* 2) (is-object-visible? arg0 arg1 1)))
  )

(defun vis-dist-additional-ok? ((arg0 vector) (arg1 float))
  (let ((gp-0 (new 'stack-no-clear 'array 'int32 1)))
    (set! (-> gp-0 0) -1)
    (dotimes (s3-0 *additional-spawner-count*)
      (let ((v1-4 (handle->process (-> *additional-spawners* s3-0))))
        (cond
          (v1-4
            (when (< (vector-vector-distance arg0 (-> (the-as process-drawable v1-4) root trans)) arg1)
              (unregister-spawner-at-index (-> gp-0 0))
              (return #t)
              )
            )
          (else
            (set! (-> gp-0 0) s3-0)
            )
          )
        )
      )
    (unregister-spawner-at-index (-> gp-0 0))
    )
  #f
  )

(defun vis-dist-ok? ((arg0 vector) (arg1 float))
  (let ((s5-0 (* arg1 arg1)))
    (or (< (vector-vector-distance-squared arg0 *camera-pos-0*) s5-0)
        (and (= *view-count* 2) (< (vector-vector-distance-squared arg0 *camera-pos-1*) s5-0))
        )
    )
  )

(defun entity-by-name ((arg0 string))
  (if (not arg0)
      (return (the-as entity #f))
      )
  (dotimes (s5-0 (-> *level* length))
    (let ((s4-0 (-> *level* level s5-0)))
      (when (= (-> s4-0 status) 'active)
        (let ((s3-0 (-> s4-0 bsp actors)))
          (when (nonzero? s3-0)
            (dotimes (s2-0 (-> s3-0 length))
              (let ((s1-0 (-> s3-0 data s2-0 actor)))
                (if (string= (the-as string (-> s1-0 unknown)) arg0)
                    (return s1-0)
                    )
                )
              )
            )
          )
        (let ((s3-1 (-> s4-0 bsp nav-meshes)))
          (when (nonzero? s3-1)
            (dotimes (s2-1 (-> s3-1 length))
              (let ((s1-1 (-> s3-1 s2-1)))
                (if (string= (the-as string (-> s1-1 unknown)) arg0)
                    (return s1-1)
                    )
                )
              )
            )
          )
        (let ((s3-2 (-> s4-0 bsp race-meshes)))
          (when (nonzero? s3-2)
            (dotimes (s2-2 (-> s3-2 length))
              (let ((s1-2 (-> s3-2 s2-2)))
                (if (string= (the-as string (-> s1-2 unknown)) arg0)
                    (return s1-2)
                    )
                )
              )
            )
          )
        (let ((s4-1 (-> s4-0 bsp cameras)))
          (when (nonzero? s4-1)
            (dotimes (s3-3 (-> s4-1 length))
              (let ((s2-3 (-> s4-1 s3-3)))
                (if (string= (the-as string (-> s2-3 unknown)) arg0)
                    (return s2-3)
                    )
                )
              )
            )
          )
        )
      )
    )
  (the-as entity #f)
  )

(defun entity-by-aid ((arg0 uint))
  (dotimes (v1-0 (-> *level* length))
    (let ((a1-3 (-> *level* level v1-0)))
      (when (= (-> a1-3 status) 'active)
        (let ((a1-4 (-> a1-3 entity)))
          (when (nonzero? a1-4)
            (let ((a2-4 0)
                  (a3-2 (+ (-> a1-4 length) -1))
                  )
              0
              (while (>= a3-2 a2-4)
                (let* ((t0-3 (+ a2-4 (/ (- a3-2 a2-4) 2)))
                       (t1-2 (-> a1-4 data t0-3))
                       (t2-0 (-> t1-2 perm aid))
                       )
                  (cond
                    ((= t2-0 arg0)
                     (return (-> t1-2 entity))
                     )
                    ((< (the-as uint t2-0) arg0)
                     (set! a2-4 (+ t0-3 1))
                     )
                    (else
                      (set! a3-2 (+ t0-3 -1))
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  (the-as entity #f)
  )

(defmethod add-to-level! ((this entity-actor) (arg0 level-group) (arg1 level) (arg2 actor-id))
  (let ((v1-4 (-> arg1 entity data (-> arg1 entity length))))
    (+! (-> arg1 entity length) 1)
    (set! (-> v1-4 process) #f)
    (set! (-> v1-4 entity) this)
    (set! (-> this extra) v1-4)
    (cond
      ((-> arg0 entity-link)
       (let* ((a0-6 (-> arg0 entity-link))
              (t0-1 (-> a0-6 next-link))
              )
         (set! (-> a0-6 next-link) v1-4)
         (set! (-> v1-4 prev-link) a0-6)
         (set! (-> v1-4 next-link) t0-1)
         (set! (-> t0-1 prev-link) v1-4)
         )
       )
      (else
        (set! (-> v1-4 prev-link) v1-4)
        (set! (-> v1-4 next-link) v1-4)
        )
      )
    (set! (-> arg0 entity-link) v1-4)
    (set! (-> v1-4 trans quad) (-> this trans quad))
    )
  (set! (-> this extra perm aid) arg2)
  (set! (-> this extra level) arg1)
  (set! (-> this extra kill-mask)
        (logior (logand (-> this kill-mask)
                        (task-mask
                          task0
                          task1
                          task2
                          task3
                          task4
                          task5
                          task6
                          task7
                          done
                          dummy0
                          network
                          vehicle
                          special
                          primary0
                          ctywide
                          never
                          )
                        )
                (logclear
                  (task-mask movie0 movie1 movie2 tm19 tm20 tm21 tm22 tm23 tm24 tm25 tm26 tm27 tm28 tm29 tm30 tm31)
                  (-> this kill-mask)
                  )
                )
        )
  (if (not (-> arg1 vis-info 0))
      (set! (-> this extra vis-dist) (res-lump-float this 'vis-dist :default 40960000.0))
      )
  (cond
    ((= (-> this type) entity-actor)
     (set! (-> this extra perm task) (-> this task))
     (set! (-> this extra vis-id) (-> this vis-id))
     )
    (else
      (set! (-> this extra perm task) (game-task none))
      (set! (-> this extra vis-id) 0)
      0
      )
    )
  (none)
  )

(defmethod remove-from-level! ((this entity) (arg0 level-group))
  (let ((v1-0 (-> this extra)))
    (cond
      ((= (-> v1-0 next-link) v1-0)
       (set! (-> arg0 entity-link) #f)
       )
      (else
        (set! (-> v1-0 next-link prev-link) (-> v1-0 prev-link))
        (set! (-> v1-0 prev-link next-link) (-> v1-0 next-link))
        (if (= (-> arg0 entity-link) v1-0)
            (set! (-> arg0 entity-link) (-> v1-0 prev-link))
            )
        )
      )
    )
  this
  )

;; og:preserve-this jakx delta vs jak3: the camera connection registers
;; (view-get-active-camera), not the *camera* global; seventh viewport-era
;; divergence on this ladder.
(defmethod birth! ((this entity-camera))
  (add-connection *camera-engine* (view-get-active-camera) nothing this #f #f)
  this
  )

(defmethod kill! ((this entity-camera))
  (remove-by-param1 *camera-engine* (the-as int this))
  this
  )

(defun init-entity ((arg0 process) (arg1 entity-actor) (arg2 type))
  (activate arg0 *entity-pool* (the-as string (-> arg1 unknown)) (the-as pointer #x70004000))
  (set! (-> arg0 entity) arg1)
  (set! (-> arg0 level) (-> arg1 extra level))
  (set! (-> arg1 extra process) arg0)
  (run-now-in-process arg0 (method-of-object arg0 init-from-entity!) arg0 arg1)
  (none)
  )

;; og:preserve-this one jakx delta vs jak3, from the disassembly: the
;; task-mask never / process-nettable method-40 auto-spawn-prevention prologue
;; (jak3 has no counterpart; the checked birth-viewer return below matches jak3
;; exactly). One runtime-link guard until the home object lands:
;; entity-info-lookup (entity-table.o) degrades to the default #x4000 heap.
;; The birth-viewer guard retired at rung 6b half 2: viewer.o is landed, and
;; actor birth runs from actors-update, long after GAME.CGO links.
;; Forward declaration: entity.o compiles before net-process-mgr-h.o carries the
;; deftype and before net-process-mgr.o defines the symbol, so declare the type and
;; extern the global here (the declare-type idiom; the guard below only tests
;; truthiness, and later consumers get the full deftype).
(declare-type net-process-mgr process)
(define-extern *net-process-mgr* net-process-mgr)
(defmethod birth! ((this entity-actor))
  (when (not (logtest? (-> this extra kill-mask) (task-mask never)))
    (let ((s5-0 (-> this etype)))
      ;; og:preserve-this bring-up guard (forge #51 class): an unresolved etype still
      ;; holds the type-name SYMBOL, and type-type?'s parent walk on a symbol strides
      ;; into garbage (lldb: read fault in gcommon's walk, symbol addresses in the
      ;; registers). Verify the value is a real type object before walking. Retires
      ;; with proper etype resolution (entity-table.o leg).
      ;;
      ;; og:preserve-this bring-up guard (#100): the *net-process-mgr* condition below
