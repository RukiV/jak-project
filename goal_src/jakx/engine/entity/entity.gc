;;-*-Lisp-*-
(in-package goal)

;; name: entity.gc
;; name in dgo: entity
;; dgos: ENGINE, GAME

;; og:preserve-this externs for symbols whose home objects are unlanded stubs:
;; entity-info-lookup lives in entity-table.o and birth-viewer in viewer.o; both
;; call sites below carry runtime-link guards until those objects land.
(define-extern entity-info-lookup (function type entity-info))
(define-extern birth-viewer (function process entity-actor object))

;; DECOMP BEGINS

;; og:preserve-this partial landing (rungs 5 + 6b): the birth chain is live from
;; clean machine output (entity-by-aid, add-to-level!, remove-from-level!, the
;; birth!/kill! family, init-entity, entity-deactivate-handler, birth and
;; deactivate-entities on bsp-header), plus actors-update (the per-frame
;; birth!/kill! driver, called from real-main-draw-hook) and the
;; additional-spawner/vis-predicate surface. Still pending: the debug tooling
;; (draw-actor-marks, entity-speed-test, process-status-bits and friends).
;; jakx caches the entity name in the `unknown` slot where jak3 did a
;; res-lump lookup.

(define *spawn-actors* #t)

;; og:preserve-this bring-up: #f until relocate.gc lands. The dead-pool compactor
;; relocates process heaps, and the relocate overrides for the newly-landed
;; process types (part-spawner, part-tracker, manipy, lightning-tracker) live in
;; the still-stubbed relocate.gc -- without them, compaction leaves stale
;; part/sound pointers and deactivate later dispatches through garbage (the
;; attract-camera DEP crash). Restore #t with the relocate.gc landing.
(define *compact-actors* #f)

;; og:preserve-this bring-up: #f = distance-only spawning (retail default #t gates
;; births on vis-bits, which stay zeroed until the .VIS leg lands, so no actor
;; would ever spawn). Distance-only is what put the first actor pixels on screen;
;; restore #t with the .VIS leg.
(define *vis-actors* #f)

(defun process-entity-set! ((arg0 process) (arg1 entity))
  (set! (-> arg0 entity) (the-as entity-actor arg1))
  (if arg1
      (set! (-> arg0 level) (-> arg1 extra level))
      (set! (-> arg0 level) (-> *level* level-default))
      )
  arg1
  )

;; WARN: Return type mismatch process-drawable vs none.
(defun process-drawable-from-entity! ((arg0 process-drawable) (arg1 entity-actor))
  (logior! (-> arg0 mask) (process-mask actor-pause))
  (set! (-> arg0 root trans quad) (-> arg1 extra trans quad))
  (quaternion-copy! (the-as quaternion (-> arg0 root rot)) (-> arg1 quat))
  (vector-identity! (-> arg0 root scale))
  (none)
  )

(define *additional-spawner-count* 0)

(define *additional-spawners* (new 'static 'array handle 1 (new 'static 'handle)))

;; og:preserve-this jakx-only subsystem, no jak3 counterpart: a one-slot registry
;; of spawner processes whose distance also satisfies the actor birth check
;; (vis-dist-additional-ok?). Nothing registers into it until the race legs land.
(defun register-additional-spawner ((arg0 process))
  (when (>= *additional-spawner-count* 1)
    (break!)
    0
    )
  (set! (-> *additional-spawners* *additional-spawner-count*) (process->handle arg0))
  (let ((v0-0 (+ *additional-spawner-count* 1)))
    (set! *additional-spawner-count* v0-0)
    v0-0
    )
  )

(defun unregister-spawner-at-index ((arg0 int))
  (when (!= arg0 -1)
    (dotimes (v1-1 (- *additional-spawner-count* (+ arg0 1)))
      (set! (-> *additional-spawners* (+ v1-1 arg0)) (-> *additional-spawners* (+ arg0 1 v1-1)))
      )
    (set! *additional-spawner-count* (+ *additional-spawner-count* -1))
    )
  (none)
  )

;; og:preserve-this jakx viewport delta vs jak3: actors-update captures the active
;; math camera position per viewport into these, and the vis distance checks below
;; test both when *view-count* is 2. jak3 keeps a single camera-pos local instead.
(define *camera-pos-0* (new 'static 'vector))

(define *camera-pos-1* (new 'static 'vector))

(defun vis-cull-all? ((arg0 level) (arg1 int))
  (or (is-object-visible? arg0 arg1 0) (and (= *view-count* 2) (is-object-visible? arg0 arg1 1)))
  )

(defun vis-dist-additional-ok? ((arg0 vector) (arg1 float))
  (let ((gp-0 (new 'stack-no-clear 'array 'int32 1)))
    (set! (-> gp-0 0) -1)
    (dotimes (s3-0 *additional-spawner-count*)
      (let ((v1-4 (handle->process (-> *additional-spawners* s3-0))))
        (cond
          (v1-4
            (when (< (vector-vector-distance arg0 (-> (the-as process-drawable v1-4) root trans)) arg1)
              (unregister-spawner-at-index (-> gp-0 0))
              (return #t)
              )
            )
          (else
            (set! (-> gp-0 0) s3-0)
            )
          )
        )
      )
    (unregister-spawner-at-index (-> gp-0 0))
    )
  #f
  )

(defun vis-dist-ok? ((arg0 vector) (arg1 float))
  (let ((s5-0 (* arg1 arg1)))
    (or (< (vector-vector-distance-squared arg0 *camera-pos-0*) s5-0)
        (and (= *view-count* 2) (< (vector-vector-distance-squared arg0 *camera-pos-1*) s5-0))
        )
    )
  )

(defun entity-by-name ((arg0 string))
  (if (not arg0)
      (return (the-as entity #f))
      )
  (dotimes (s5-0 (-> *level* length))
    (let ((s4-0 (-> *level* level s5-0)))
      (when (= (-> s4-0 status) 'active)
        (let ((s3-0 (-> s4-0 bsp actors)))
          (when (nonzero? s3-0)
            (dotimes (s2-0 (-> s3-0 length))
              (let ((s1-0 (-> s3-0 data s2-0 actor)))
                (if (string= (the-as string (-> s1-0 unknown)) arg0)
                    (return s1-0)
                    )
                )
              )
            )
          )
        (let ((s3-1 (-> s4-0 bsp nav-meshes)))
          (when (nonzero? s3-1)
            (dotimes (s2-1 (-> s3-1 length))
              (let ((s1-1 (-> s3-1 s2-1)))
                (if (string= (the-as string (-> s1-1 unknown)) arg0)
                    (return s1-1)
                    )
                )
              )
            )
          )
        (let ((s3-2 (-> s4-0 bsp race-meshes)))
          (when (nonzero? s3-2)
            (dotimes (s2-2 (-> s3-2 length))
              (let ((s1-2 (-> s3-2 s2-2)))
                (if (string= (the-as string (-> s1-2 unknown)) arg0)
                    (return s1-2)
                    )
                )
              )
            )
          )
        (let ((s4-1 (-> s4-0 bsp cameras)))
          (when (nonzero? s4-1)
            (dotimes (s3-3 (-> s4-1 length))
              (let ((s2-3 (-> s4-1 s3-3)))
                (if (string= (the-as string (-> s2-3 unknown)) arg0)
                    (return s2-3)
                    )
                )
              )
            )
          )
        )
      )
    )
  (the-as entity #f)
  )

(defun entity-by-aid ((arg0 uint))
  (dotimes (v1-0 (-> *level* length))
    (let ((a1-3 (-> *level* level v1-0)))
      (when (= (-> a1-3 status) 'active)
        (let ((a1-4 (-> a1-3 entity)))
          (when (nonzero? a1-4)
            (let ((a2-4 0)
                  (a3-2 (+ (-> a1-4 length) -1))
                  )
              0
              (while (>= a3-2 a2-4)
                (let* ((t0-3 (+ a2-4 (/ (- a3-2 a2-4) 2)))
                       (t1-2 (-> a1-4 data t0-3))
                       (t2-0 (-> t1-2 perm aid))
                       )
                  (cond
                    ((= t2-0 arg0)
                     (return (-> t1-2 entity))
                     )
                    ((< (the-as uint t2-0) arg0)
                     (set! a2-4 (+ t0-3 1))
                     )
                    (else
                      (set! a3-2 (+ t0-3 -1))
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  (the-as entity #f)
  )

(defmethod add-to-level! ((this entity-actor) (arg0 level-group) (arg1 level) (arg2 actor-id))
  (let ((v1-4 (-> arg1 entity data (-> arg1 entity length))))
    (+! (-> arg1 entity length) 1)
    (set! (-> v1-4 process) #f)
    (set! (-> v1-4 entity) this)
    (set! (-> this extra) v1-4)
    (cond
      ((-> arg0 entity-link)
       (let* ((a0-6 (-> arg0 entity-link))
              (t0-1 (-> a0-6 next-link))
              )
         (set! (-> a0-6 next-link) v1-4)
         (set! (-> v1-4 prev-link) a0-6)
         (set! (-> v1-4 next-link) t0-1)
         (set! (-> t0-1 prev-link) v1-4)
         )
       )
      (else
        (set! (-> v1-4 prev-link) v1-4)
        (set! (-> v1-4 next-link) v1-4)
        )
      )
    (set! (-> arg0 entity-link) v1-4)
    (set! (-> v1-4 trans quad) (-> this trans quad))
    )
  (set! (-> this extra perm aid) arg2)
  (set! (-> this extra level) arg1)
  (set! (-> this extra kill-mask)
        (logior (logand (-> this kill-mask)
                        (task-mask
                          task0
                          task1
                          task2
                          task3
                          task4
                          task5
                          task6
                          task7
                          done
                          dummy0
                          network
                          vehicle
                          special
                          primary0
                          ctywide
                          never
                          )
                        )
                (logclear
                  (task-mask movie0 movie1 movie2 tm19 tm20 tm21 tm22 tm23 tm24 tm25 tm26 tm27 tm28 tm29 tm30 tm31)
                  (-> this kill-mask)
                  )
                )
        )
  (if (not (-> arg1 vis-info 0))
      (set! (-> this extra vis-dist) (res-lump-float this 'vis-dist :default 40960000.0))
      )
  (cond
    ((= (-> this type) entity-actor)
     (set! (-> this extra perm task) (-> this task))
     (set! (-> this extra vis-id) (-> this vis-id))
     )
    (else
      (set! (-> this extra perm task) (game-task none))
      (set! (-> this extra vis-id) 0)
      0
      )
    )
  (none)
  )

(defmethod remove-from-level! ((this entity) (arg0 level-group))
  (let ((v1-0 (-> this extra)))
    (cond
      ((= (-> v1-0 next-link) v1-0)
       (set! (-> arg0 entity-link) #f)
       )
      (else
        (set! (-> v1-0 next-link prev-link) (-> v1-0 prev-link))
        (set! (-> v1-0 prev-link next-link) (-> v1-0 next-link))
        (if (= (-> arg0 entity-link) v1-0)
            (set! (-> arg0 entity-link) (-> v1-0 prev-link))
            )
        )
      )
    )
  this
  )

;; og:preserve-this jakx delta vs jak3: the camera connection registers
;; (view-get-active-camera), not the *camera* global; seventh viewport-era
;; divergence on this ladder.
(defmethod birth! ((this entity-camera))
  (add-connection *camera-engine* (view-get-active-camera) nothing this #f #f)
  this
  )

(defmethod kill! ((this entity-camera))
  (remove-by-param1 *camera-engine* (the-as int this))
  this
  )

(defun init-entity ((arg0 process) (arg1 entity-actor) (arg2 type))
  (activate arg0 *entity-pool* (the-as string (-> arg1 unknown)) (the-as pointer #x70004000))
  (set! (-> arg0 entity) arg1)
  (set! (-> arg0 level) (-> arg1 extra level))
  (set! (-> arg1 extra process) arg0)
  (run-now-in-process arg0 (method-of-object arg0 init-from-entity!) arg0 arg1)
  (none)
  )

;; og:preserve-this one jakx delta vs jak3, from the disassembly: the
;; task-mask never / process-nettable method-40 auto-spawn-prevention prologue
;; (jak3 has no counterpart; the checked birth-viewer return below matches jak3
;; exactly). One runtime-link guard until the home object lands:
;; entity-info-lookup (entity-table.o) degrades to the default #x4000 heap.
;; The birth-viewer guard retired at rung 6b half 2: viewer.o is landed, and
;; actor birth runs from actors-update, long after GAME.CGO links.
;; Forward declaration: entity.o compiles before net-process-mgr-h.o carries the
;; deftype and before net-process-mgr.o defines the symbol, so declare the type and
;; extern the global here (the declare-type idiom; the guard below only tests
;; truthiness, and later consumers get the full deftype).
(declare-type net-process-mgr process)
(define-extern *net-process-mgr* net-process-mgr)
(defmethod birth! ((this entity-actor))
  (when (not (logtest? (-> this extra kill-mask) (task-mask never)))
    (let ((s5-0 (-> this etype)))
      ;; og:preserve-this bring-up guard (forge #51 class): an unresolved etype still
      ;; holds the type-name SYMBOL, and type-type?'s parent walk on a symbol strides
      ;; into garbage (lldb: read fault in gcommon's walk, symbol addresses in the
      ;; registers). Verify the value is a real type object before walking. Retires
      ;; with proper etype resolution (entity-table.o leg).
      ;;
      ;; og:preserve-this bring-up guard (#100): the *net-process-mgr* condition below
      ;; is a port addition. Retail's prevention is unconditional because the manager
      ;; always exists there and owns nettable spawning through its own walk
      ;; (net-process-mgr.o, unlanded, ~250 ops); with the manager absent, prevented
      ;; entities would die permanently on their first distance-kill (the stamp blocks
      ;; the respawn), so single-player falls through to the normal distance-driven
      ;; birth path instead, which is retail's single-player behavior by outcome.
      ;; Retires when the net-process-mgr leg lands and the manager exists in all
      ;; modes. The synthetic spawn-walk alternative was rejected for the lifecycle
      ;; flaw above (spawn at birth, killed next frame beyond 220 m, never again).
      (when (and *net-process-mgr* (type? s5-0 type) (type-type? s5-0 process-nettable) (nonzero? (-> s5-0 method-table 40)))
        (format 0 "WARNING: preventing ~A from auto-spawning~%" this)
        (logior! (-> this extra kill-mask) (task-mask network never))
        (set! this (the-as entity-actor #f))
        (goto cfg-21)
        )
      )
    )
  (let* ((s5-1 (-> this etype))
         (v1-11 (if (nonzero? entity-info-lookup)
                    (entity-info-lookup s5-1)
                    )
                )
         (s4-0 (get-process
                 *default-dead-pool*
                 s5-1
                 (if v1-11
                     (-> v1-11 heap-size)
                     #x4000
                     )
                 0
                 )
               )
         )
    (cond
      ((not s4-0)
       )
      ((begin
         (set! (-> s4-0 type) s5-1)
         (and s5-1
              (valid? s5-1 type (the-as string #f) #f 0)
              (valid? (method-of-object s4-0 init-from-entity!) function (the-as string #f) #f 0)
              )
         )
       (init-entity s4-0 this s5-1)
       )
      (else
        (when (not (birth-viewer s4-0 this))
          (format 0 "ERROR: no proper process type named ~A exists in the code, could not start ~A~%" s5-1 this)
          (logior! (-> this extra perm status) (entity-perm-status bit-0))
          )
        )
      )
    )
  (label cfg-21)
  this
  )

(defun entity-deactivate-handler ((arg0 process) (arg1 entity-actor))
  (when (= arg0 (-> arg1 extra process))
    (logclear! (-> arg1 extra perm status) (entity-perm-status error no-kill))
    (set! (-> arg1 extra process) #f)
    )
  (none)
  )

;; WARN: Return type mismatch entity vs entity-actor.
(defun entity-actor-from-level-name ((arg0 symbol))
  (let ((v0-0 (the-as entity #f)))
    (dotimes (s5-0 (-> *level* length))
      (let ((s4-0 (-> *level* level s5-0)))
        (when (= (-> s4-0 status) 'active)
          (when (= (-> s4-0 name) arg0)
            (when (zero? (-> s4-0 entity length))
              (format 0 "ERROR: level ~s has no entities!!" (-> s4-0 name))
              (when *debug-segment*
                (break!)
                0
                )
              )
            (set! v0-0 (-> s4-0 entity data 0 entity))
            )
          )
        )
      )
    (the-as entity-actor v0-0)
    )
  )

;; WARN: Return type mismatch int vs entity-perm-status.
(defun process-entity-status! ((arg0 process) (arg1 entity-perm-status) (arg2 symbol))
  (the-as entity-perm-status (cond
                               ((and (-> arg0 entity) arg0 (= arg0 (-> arg0 entity extra process)))
                                (let ((v1-6 (-> arg0 entity extra)))
                                  (if arg2
                                      (logior! (-> v1-6 perm status) arg1)
                                      (logclear! (-> v1-6 perm status) arg1)
                                      )
                                  (the-as int (-> v1-6 perm status))
                                  )
                                )
                               (else
                                 0
                                 )
                               )
          )
  )

(defmethod kill! ((this entity-actor))
  (let ((a0-1 (-> this extra process)))
    (if a0-1
        (deactivate a0-1)
        (entity-deactivate-handler a0-1 this)
        )
    )
  this
  )

;; og:preserve-this the machine output keeps the two retail .mfc0 Count perf
;; reads as explicit asm forms, jak3's exact treatment of the same function. The
;; actor-groups fixup loop is hand-shaped from the raw ops (check and store the
;; actor slot at entry+0, resolve from the aid at entry+4); the decompiler's
;; expression pass misprints that loop's field decomposition.
(defmethod birth ((this bsp-header))
  (local-vars (v1-75 int) (s5-0 int))
  (.mfc0 s5-0 Count)
  (let ((a2-0 (if (nonzero? (-> this actors))
                  (-> this actors length)
                  0
                  )
              )
        )
    (cond
      ((not (-> this level entity))
       (set! (-> this level entity) (new 'loading-level 'entity-links-array a2-0))
       )
      ((< (-> this level entity allocated-length) a2-0)
       (format
         0
         "ERROR: Attempting to rebirth level ~A with incorrect entity table size ~D/~D~%"
         (-> this level)
         a2-0
         (-> this level entity allocated-length)
         )
       )
      )
    )
  (set! (-> this level entity length) 0)
  0
  (when (nonzero? (-> this actors))
    (dotimes (s4-0 (-> this actors length))
      (let* ((a0-4 (-> this actor-birth-order s4-0))
             (v1-23 (-> this actors data (logand a0-4 8191) actor))
             )
        (add-to-level! v1-23 *level* (-> this level) (the-as actor-id (-> v1-23 aid)))
        )
      )
    )
  (let ((s4-1 (-> this cameras)))
    (when (nonzero? s4-1)
      (dotimes (s3-0 (-> s4-1 length))
        (birth! (-> s4-1 s3-0))
        )
      )
    )
  (let ((s4-2 (-> this level status)))
    (set! (-> this level status) 'active)
    (do-nothing *level*)
    (dotimes (s3-1 (-> *level* length))
      (let ((s2-0 (-> *level* level s3-1)))
        (when (= (-> s2-0 status) 'active)
          (when (nonzero? (-> s2-0 bsp actor-groups))
            (countdown (s1-0 (-> s2-0 bsp actor-groups length))
              (let ((s0-0 (-> s2-0 bsp actor-groups s1-0))
                    (sv-16 0)
                    )
                (while (< sv-16 (-> s0-0 length))
                  (if (not (-> s0-0 data sv-16 actor))
                      (set! (-> s0-0 data sv-16 actor) (the-as entity-actor (entity-by-aid (-> s0-0 data sv-16 id))))
                      )
                  (+! sv-16 1)
                  )
                )
              )
            )
          )
        )
      )
    (set! (-> this level status) s4-2)
    )
  (.mfc0 v1-75 Count)
  (let ((a3-2 (- v1-75 s5-0)))
    (format 0 "Done ~S in ~D~%" "birth" a3-2)
    )
  (none)
  )

;; og:preserve-this partial landing: the cross-level reference clearing, the
;; kill!/unlink loops, and the nav-mesh kill loop (guarded, see below) are live;
;; the one deferred piece is the retail tail between the camera and nav-mesh
;; loops, a kernel-context relocating sweep dispatching check-for-rougue-process
;; over the process tree, which waits on check-for-rougue-process and its
;; iterate lambda (actors-update leg). The fixup loops are hand-shaped from the
;; raw ops like birth's (actor slot at entry+0, range-checked as a pointer).
(defmethod deactivate-entities ((this bsp-header))
  (let ((v1-1 (-> this level heap base))
        (a0-2 (-> this level heap top-base))
        )
    (when (nonzero? (-> this actor-groups))
      (dotimes (a1-2 (-> this actor-groups length))
        (let ((a2-2 (-> this actor-groups a1-2)))
          (dotimes (a3-1 (-> a2-2 length))
            (let ((t0-2 (-> a2-2 data a3-1 actor)))
              (if (and t0-2 (not (and (>= (the-as int t0-2) (the-as int v1-1)) (< (the-as int t0-2) (the-as int a0-2)))))
                  (set! (-> a2-2 data a3-1 actor) (the-as entity-actor #f))
                  )
              )
            )
          )
        )
      )
    (dotimes (a1-5 (-> *level* length))
      (let ((a2-10 (-> *level* level a1-5)))
        (when (= (-> a2-10 status) 'active)
          (when (!= a2-10 (-> this level))
            (when (nonzero? (-> a2-10 bsp actor-groups))
              (dotimes (a3-10 (-> a2-10 bsp actor-groups length))
                (let ((t0-13 (-> a2-10 bsp actor-groups a3-10)))
                  (dotimes (t1-2 (-> t0-13 length))
                    (let ((t2-3 (-> t0-13 data t1-2 actor)))
                      (if (and t2-3 (>= (the-as int t2-3) (the-as int v1-1)) (< (the-as int t2-3) (the-as int a0-2)))
                          (set! (-> t0-13 data t1-2 actor) (the-as entity-actor #f))
                          )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  (let ((s5-0 (-> this actors)))
    (when (nonzero? s5-0)
      (dotimes (s4-0 (-> s5-0 length))
        (let ((s3-0 (-> s5-0 data s4-0 actor)))
          (kill! s3-0)
          (remove-from-level! s3-0 *level*)
          )
        )
      )
    )
  (let ((s5-1 (-> this cameras)))
    (when (nonzero? s5-1)
      (dotimes (s4-1 (-> s5-1 length))
        (kill! (-> s5-1 s4-1))
        )
      )
    )
  (let ((s5-3 (-> this nav-meshes)))
    (when (nonzero? s5-3)
      (dotimes (s4-2 (-> s5-3 length))
        ;; og:preserve-this runtime-link guard: entity-nav-mesh inherits kill!
        ;; from entity, whose base defmethod is unlanded, so the slot links 0
        ;; until the nav-mesh leg lands; retail calls it bare
        (let* ((a0-14 (-> s5-3 s4-2))
               (t9-14 (method-of-object a0-14 kill!))
               )
          (if (nonzero? (the-as int t9-14))
              (t9-14 a0-14)
              )
          )
        )
      )
    )
  (none)
  )

;; og:preserve-this retail jakx deltas vs jak3 in this method, all from the
;; disassembly: (1) update-actor-hash is followed by attackable-hash-update;
;; (2) the camera position is captured per viewport into *camera-pos-0/1*
;; under view-push-context, where jak3 keeps one camera-pos local; (3) the
;; distance checks route through vis-dist-ok?/vis-dist-additional-ok?/
;; vis-cull-all? instead of jak3's inline vector-vector-distance forms;
;; (4) tuning: compact lerp 16..4 (jak3 8..1), birth-max floor 4 (jak3 2).
(defmethod actors-update ((this level-group))
  (let ((sv-16 this))
    (when *compact-actors*
      (if (and (= *compact-actors* 'debug) (= (-> *nk-dead-pool* alive-list prev) (-> *nk-dead-pool* first-gap)))
          (churn *nk-dead-pool* 1)
          )
      (let ((gp-0
              (the int
                   (lerp-scale 16.0 4.0 (the float (-> *display* frames (-> *display* last-screen) run-time)) 2000.0 8000.0)
                   )
              )
            )
        (if (nonzero? *debug-dead-pool*)
            (compact *debug-dead-pool* 10)
            )
        (compact *nk-dead-pool* gp-0)
        )
      )
    (update-actor-hash)
    (attackable-hash-update *attackable-hash*)
    (when (not (paused?))
      (let ((gp-1 (-> *display* frames (-> *display* last-screen) run-time)))
        (let ((f0-5 (fmax
                      327680.0
                      (fmin (+ 327680.0 (* 204.8 (the float (- 7000 (the-as int gp-1))))) (-> *ACTOR-bank* birth-dist))
                      )
                    )
              )
          (seek! (-> *ACTOR-bank* pause-dist) f0-5 (* 81920.0 (seconds-per-frame)))
          )
        (seekl! (-> *ACTOR-bank* birth-max) (the int (lerp-scale 25.0 4.0 (the float gp-1) 2000.0 7000.0)) 10)
        )
      (if (movie?)
          (set! (-> *ACTOR-bank* birth-max) 1000)
          )
      )
    (when *spawn-actors*
      (view-push-context 0)
      (set! (-> *camera-pos-0* quad) (-> (view-get-active-math-camera) trans quad))
      (view-pop-context)
      (view-push-context 1)
      (set! (-> *camera-pos-1* quad) (-> (view-get-active-math-camera) trans quad))
      (view-pop-context)
      (let ((sv-24 0))
        (dotimes (gp-4 (-> sv-16 length))
          (let ((s5-1 (-> sv-16 level gp-4)))
            (when (= (-> s5-1 status) 'active)
              (let ((sv-32 (-> s5-1 task-mask)))
                (cond
                  ((= (-> s5-1 display?) 'special)
                   (let* ((s5-2 (-> s5-1 entity))
                          (s4-1 (-> s5-2 length))
                          )
                     (dotimes (s3-0 s4-1)
                       (let ((v1-57 (-> s5-2 data s3-0)))
                         (cond
                           ((and (logtest? (-> v1-57 kill-mask) (task-mask special)) (not (logtest? (-> v1-57 kill-mask) sv-32)))
                            (when (not (or (-> v1-57 process) (logtest? (-> v1-57 perm status) (entity-perm-status bit-0 dead))))
                              (birth! (-> v1-57 entity))
                              (+! sv-24 1)
                              (if (>= sv-24 (-> *ACTOR-bank* birth-max))
                                  (goto cfg-153)
                                  )
                              )
                            )
                           (else
                             (if (and (-> v1-57 process)
                                      (not (logtest? (-> v1-57 perm status) (entity-perm-status no-kill)))
                                      (not (logtest? (-> v1-57 process mask) (process-mask no-kill)))
                                      )
                                 (kill! (-> v1-57 entity))
                                 )
                             )
                           )
                         )
                       )
                     )
                   )
                  ((= (-> s5-1 display?) 'actor)
                   (let* ((s5-3 (-> s5-1 entity))
                          (s4-2 (-> s5-3 length))
                          )
                     (dotimes (s3-1 s4-2)
                       (let ((v1-72 (-> s5-3 data s3-1)))
                         (cond
                           ((not (logtest? (-> v1-72 kill-mask) sv-32))
                            (when (not (or (-> v1-72 process) (logtest? (-> v1-72 perm status) (entity-perm-status bit-0 dead))))
                              (birth! (-> v1-72 entity))
                              (+! sv-24 1)
                              (if (>= sv-24 (-> *ACTOR-bank* birth-max))
                                  (goto cfg-153)
                                  )
                              )
                            )
                           (else
                             (if (and (-> v1-72 process)
                                      (not (logtest? (-> v1-72 perm status) (entity-perm-status no-kill)))
                                      (not (logtest? (-> v1-72 process mask) (process-mask no-kill)))
                                      )
                                 (kill! (-> v1-72 entity))
                                 )
                             )
                           )
                         )
                       )
                     )
                   )
                  ((not *vis-actors*)
                   (let* ((s5-4 (-> s5-1 entity))
                          (s4-3 (-> s5-4 length))
                          )
                     (dotimes (s3-2 s4-3)
                       (let ((s2-0 (-> s5-4 data s3-2)))
                         (cond
                           ((and (or (and (nonzero? *screen-shot-work*) (-> *screen-shot-work* highres-enable))
                                     (or (vis-dist-additional-ok? (-> s2-0 trans) (-> *ACTOR-bank* birth-dist))
                                         (vis-dist-ok? (-> s2-0 trans) (-> *ACTOR-bank* birth-dist))
                                         )
                                     )
                                 (not (logtest? (-> s2-0 perm status) (entity-perm-status bit-9 bit-10)))
                                 (not (logtest? (-> s2-0 kill-mask) sv-32))
                                 )
                            (when (not (or (-> s2-0 process) (logtest? (-> s2-0 perm status) (entity-perm-status bit-0 dead))))
                              (birth! (-> s2-0 entity))
                              (+! sv-24 1)
                              (if (>= sv-24 (-> *ACTOR-bank* birth-max))
                                  (goto cfg-153)
                                  )
                              )
                            )
                           (else
                             (if (and (-> s2-0 process)
                                      (not (logtest? (-> s2-0 perm status) (entity-perm-status no-kill)))
                                      (not (logtest? (-> s2-0 process mask) (process-mask no-kill)))
                                      )
                                 (kill! (-> s2-0 entity))
                                 )
                             )
                           )
                         )
                       )
                     )
                   )
                  (*vis-actors*
                    (when (not (and (-> s5-1 vis-info 0) (-> s5-1 all-visible?)))
                      (let* ((sv-36 (-> s5-1 entity))
                             (sv-40 (-> sv-36 length))
                             (sv-44 (the-as symbol #f))
                             )
                        (dotimes (s4-4 sv-40)
                          (let ((s3-3 (-> sv-36 data s4-4)))
                            (cond
                              ((or (and (vis-dist-additional-ok? (-> s3-3 trans) 327680.0)
                                        (not (logtest? (-> s3-3 perm status) (entity-perm-status bit-9 bit-10)))
                                        (not (logtest? (-> s3-3 kill-mask) sv-32))
                                        )
                                   (and (vis-cull-all? s5-1 (-> s3-3 vis-id))
                                        (not (logtest? (-> s3-3 perm status) (entity-perm-status bit-9 bit-10)))
                                        (not (logtest? (-> s3-3 kill-mask) sv-32))
                                        (or (-> s5-1 vis-info 0) (vis-dist-ok? (-> s3-3 trans) (-> s3-3 vis-dist)))
                                        )
                                   (and (nonzero? *screen-shot-work*) (-> *screen-shot-work* highres-enable))
                                   )
                               (when (not (or (-> s3-3 process) (logtest? (-> s3-3 perm status) (entity-perm-status bit-0 dead)) sv-44))
                                 (birth! (-> s3-3 entity))
                                 (+! sv-24 1)
                                 (when (< (/ (the float (memory-free *nk-dead-pool*)) (the float (memory-total *nk-dead-pool*))) 0.1)
                                   (if (and *debug-segment* (not *display-capture-mode*))
                                       (format
                                         *stdcon*
                                         "low actor memory, no birth triggered!!! ~,,0fK/~,,0fK~%"
                                         (* 0.0009765625 (the float (memory-free *nk-dead-pool*)))
                                         (* 0.0009765625 (the float (memory-total *nk-dead-pool*)))
                                         )
                                       )
                                   (set! sv-44 #t)
                                   )
                                 )
                               )
                              (else
                                (when (and (-> s3-3 process)
                                           (not (logtest? (-> s3-3 perm status) (entity-perm-status no-kill)))
                                           (not (logtest? (-> s3-3 process mask) (process-mask no-kill)))
                                           )
                                  (kill! (-> s3-3 entity))
                                  (+! sv-24 1)
                                  )
                                )
                              )
                            )
                          (if (>= sv-24 (-> *ACTOR-bank* birth-max))
                              (goto cfg-153)
                              )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  (label cfg-153)
  0
  (none)
  )
