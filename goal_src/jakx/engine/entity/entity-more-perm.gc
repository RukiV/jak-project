;;-*-Lisp-*-
(in-package goal)

;; name: entity-more-perm.gc
;; name in dgo: entity-more-perm
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

(deftype entity-more-perm (structure)
  ((aid         uint32     :offset-assert 0)
   (ent         basic      :offset-assert 4)
   (user-object object   2 :offset 8)
   (user-uint64 uint64     :offset 8)
   (user-float  float    2 :offset 8)
   (user-int32  int32    2 :offset 8)
   (user-uint32 uint32   2 :offset 8)
   (user-int16  int16    4 :offset 8)
   (user-uint16 uint16   4 :offset 8)
   (user-int8   int8     8 :offset 8)
   (user-uint8  uint8    8 :offset 8)
   )
  :method-count-assert 10
  :size-assert         #x10
  :flag-assert         #xa00000010
  (:methods
    (entity-more-perm-method-9 (_type_) none) ;; 9
    )
  )

(deftype entity-more-perm-hash (structure)
  ((data                entity-more-perm 512 :inline :offset-assert 0)
   (entity-more-perm-ct int32                :offset-assert 8192)
   (entity-indices      uint16 1024          :offset-assert 8196)
   )
  :method-count-assert 15
  :size-assert         #x2804
  :flag-assert         #xf00002804
  (:methods
    (entity-more-perm-hash-method-9 (_type_) none) ;; 9
    (entity-more-perm-hash-method-10 (_type_ uint32) uint) ;; 10
    (entity-more-perm-hash-method-11 (_type_ uint32) none) ;; 11
    (entity-more-perm-hash-method-12 (_type_ uint (pointer symbol)) entity-more-perm) ;; 12 ;; lookup-or-allocate perm by aid; arg2 receives whether a new slot was allocated
    (entity-more-perm-hash-method-13 (_type_ level) none) ;; 13 ;; called method-of-type style from (method 25 level)
    (entity-more-perm-hash-method-14 (_type_ level) none) ;; 14 ;; called method-of-type style from (method 10 level) unload!
    )
  )

;; og:preserve-this bring-up extern: the global's defining top-level is in the
;; unlanded portion of this file's original object, so the symbol reads 0 at
;; runtime until that leg lands (same extern in net-simple-destruct.gc).
(define-extern *entity-more-perm* entity-more-perm-hash)

;; og:preserve-this hand-written from entity-more-perm_ir2.asm (methods 13/14 fail
;; expression building only on the dynamic-etype method dispatch, which type casts
;; cannot express). Both are class-method style: `this` is never read, and the
;; original callers pass *entity-more-perm* (still undefined = 0) in that slot.
;; Method 13 dispatches process-nettable method 32 on each nettable actor's etype;
;; method 14 is the byte-identical walk dispatching the adjacent slot 33.
(defmethod entity-more-perm-hash-method-13 ((this entity-more-perm-hash) (arg0 level))
  (when (and (-> arg0 name) (nonzero? (-> arg0 entity)) (-> arg0 entity))
    (dotimes (i (-> arg0 entity length))
      (let ((ent (-> arg0 entity data i entity)))
        (when (type? ent entity-actor)
          (let ((actor (the-as entity-actor ent)))
            ;; og:preserve-this bring-up guards, three layers (forge #51 class): the
            ;; type? gate keeps type-type?'s parent walk off unresolved etypes that
            ;; still hold the type-name SYMBOL (walking a symbol strides into garbage;
            ;; lldb-proven on a churned discard), the slot gate below keeps the
            ;; dispatch off landed skeleton types whose slots are still null, and the
            ;; third layer keeps the walk off the get-destruct-perm funnel while
            ;; entity-more-perm is only partially landed. The proven crash there
            ;; (instrumented on the armed jungle boot, 0xC0000005 at level activate)
            ;; is the entity-more-perm-hash method-12 call inside get-destruct-perm:
            ;; entity-more-perm-hash is a structure, so that call is a STATIC jump
            ;; through method-table slot 12, which has no landed body and reads 0,
            ;; regardless of the global's value. The zero *entity-more-perm* global
            ;; is the secondary hazard: a near-0 index inside method 12's body once
            ;; that body lands. Gate BOTH, so neither partial-landing order (define
            ;; without method 12, or method 12 without the define) can reopen the
            ;; crash. Skipping the dispatch costs only destruct-perm persistence,
            ;; acceptable bring-up state while there is no save system. The first
            ;; two layers retire with proper etype resolution (entity-table.o leg);
            ;; the third only when the entity-more-perm leg lands BOTH its defining
            ;; top-level AND method 12's body.
            (when (and (nonzero? (-> entity-more-perm-hash method-table 12)) ;; slot 12 = lookup-or-allocate
                       (nonzero? (the-as int *entity-more-perm*))
                       (type? (-> actor etype) type)
                       (type-type? (-> actor etype) process-nettable)
                       )
              (let ((t9-net (-> (-> actor etype) method-table (method-id-of-type process-nettable process-nettable-method-32))))
                (when (nonzero? (the-as int t9-net))
                  ((the-as (function process-nettable entity-actor none) t9-net)
                   (the-as process-nettable #f)
                   actor
                   )
                  )
                )
              )
            )
          )
        )
      )
    )
  0
  (none)
  )

(defmethod entity-more-perm-hash-method-14 ((this entity-more-perm-hash) (arg0 level))
  (when (and (-> arg0 name) (nonzero? (-> arg0 entity)) (-> arg0 entity))
    (dotimes (i (-> arg0 entity length))
      (let ((ent (-> arg0 entity data i entity)))
        (when (type? ent entity-actor)
          (let ((actor (the-as entity-actor ent)))
            ;; og:preserve-this bring-up guards: same three layers as method 13 above
            ;; (type? gate for symbol-valued etypes, slot gate for skeleton types,
            ;; and the third layer gating BOTH the null entity-more-perm-hash
            ;; method-12 slot, the proven static jump to 0, AND the zero
            ;; *entity-more-perm* global, the hazard inside method 12's body once it
            ;; lands), on the unload-side walk where the churned-discard crash
            ;; actually fired. Retire the third layer only when the entity-more-perm
            ;; leg lands both its defining top-level and method 12's body.
            (when (and (nonzero? (-> entity-more-perm-hash method-table 12)) ;; slot 12 = lookup-or-allocate
                       (nonzero? (the-as int *entity-more-perm*))
                       (type? (-> actor etype) type)
                       (type-type? (-> actor etype) process-nettable)
                       )
              (let ((t9-net (-> (-> actor etype) method-table (method-id-of-type process-nettable process-nettable-method-33))))
                (when (nonzero? (the-as int t9-net))
                  ((the-as (function process-nettable entity-actor none) t9-net)
                   (the-as process-nettable #f)
                   actor
                   )
                  )
                )
              )
            )
          )
        )
      )
    )
  0
  (none)
  )


