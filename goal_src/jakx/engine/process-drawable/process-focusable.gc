;;-*-Lisp-*-
(in-package goal)

;; name: process-focusable.gc
;; name in dgo: process-focusable
;; dgos: ENGINE, GAME

;; TODO JAKX - https://github.com/open-goal/jak-project/pull/4311#discussion_r3410037499
;; +++focus-status
(defenum focus-status
  :type uint64
  :bitfield #t
  (disable 0) ;; if set, all collide checks fail
  (dead 1)    ;; if set, all collide checks fail
  (ignore 2)
  (inactive 3)
  (dangerous 4)
  (in-air 5)
  (hit 6)
  (grabbed 7)
  (in-head 8)
  (touch-water 9)
  (on-water 10)
  (under-water 11)
  (edge-grab 12)
  (pole 13)
  (pilot-riding 14)
  (flut 15)
  (tube 16)
  (light 17)
  (board 18)
  (gun 19)
  (pilot 20) ;; also racer?
  (mech 21)
  (dark 22)
  (rail 23)
  (halfpipe 24)
  (carry 25)
  (super 26)
  (shooting 27)
  (indax 28)
  (arrestable 29)
  (teleporting 30)
  (invulnerable 31)
  (turret 32)
  (no-gravity 33)
  (gun-no-target 34)
  ;; jakx-only bit, jak3's enum stops at 34; tested by get-sound-handle on svc-1 (vehicle) owners
  (unk-35 35)
  )
;; ---focus-status

(defmacro focus-test? (pfoc &rest status)
  `(logtest? (-> (the process-focusable ,pfoc) focus-status) (focus-status ,@status)))

;; DECOMP BEGINS

(deftype process-focusable (process-drawable)
  ((self         process-focusable :override)
   (ppointer     (pointer process-focusable) :override)
   (root         collide-shape     :override)
   (focus-status focus-status  :offset-assert 248) ;; focus-status
   )
  :method-count-assert 59
  :size-assert         #x100
  :flag-assert         #x3b00700100
  (:methods
    (process-focusable-method-50 (_type_) int) ;; 50 ;; result cached per entry by attackable-hash-update
    (get-trans (_type_ int) vector) ;; 51 ;; jak3 parity (id 21 there): trans getter used by sc m24 for point-of-interest
    (process-focusable-method-52 (_type_ int) quaternion) ;; 52 ;; get-quat: result feeds quaternion->matrix; jakx adds an index int like m51
    (process-focusable-method-53 (_type_) none) ;; 53
    (process-focusable-method-54 () none) ;; 54
    (process-focusable-method-55 (_type_) meters) ;; 55 ;; jak3 get-water-height(25)+30
    (process-focusable-method-56 (_type_) time-frame) ;; 56 ;; jak3 get-notice-time(26)+30
    (process-focusable-method-57 (_type_) float) ;; 57 ;; jak3 27 shifted; nsd's impl returns a constant scale that impact-destroys? multiplies into the impulse
    (process-focusable-method-58 (_type_) float) ;; 58 ;; missing _type_ was an arity bug: net-enemy's own override and vehicle's own override (test/decompiler/reference/jakx/engine/vehicle/vehicle-util_REF.gc) both read this-only and return a float; see net-enemy rung's own og:preserve-this note in all-types.gc
    )
  )

;; og:preserve-this method 50 (process-focusable-method-50): clean scoped
;; decode, worktree's own config (--config-override allowed_objects
;; ["process-focusable"], levels_extract false, ntsc_v1). Zero-slot base:
;; net-enemy already overrides this method with its own state-aware body
;; (net-enemy.gc), but nothing landed the process-focusable base fallback
;; that every other process-focusable subtype (including vehicle, via
;; rigid-body-object) actually dispatches to. (method 64 vehicle) is one
;; such caller (vehicle_ir2.asm, offset 216 = (16 + 4*50)), which is what
;; surfaced this as a falcon-crash blocker, but the blast radius is wider
;; and already live: attackable-hash-update (attackable-hash.gc:249,264)
;; dispatches this method on every attackable process-focusable each time
;; it runs, called every frame off update-actor-hash (entity.gc:1053), so
;; this base fallback was a standing crash for any non-net-enemy
;; attackable before this landing, not only a method-64 prerequisite.
;; definition for method 50 of type process-focusable
(defmethod process-focusable-method-50 ((this process-focusable))
  (let ((v0-0 0))
    (let ((v1-0 (-> this mask)))
      (if (logtest? (process-mask crate) v1-0)
          (set! v0-0 (logior v0-0 2))
          )
      (if (logtest? (process-mask enemy) v1-0)
          (set! v0-0 (logior v0-0 16))
          )
      )
    v0-0
    )
  )

;; og:preserve-this get-quat/m55/m56: clean decode, no config edits needed;
;; none of the three read arg0 (m52's own index arg included) or any other
;; process-focusable field beyond root, and jakx-init does not spawn a
;; process-focusable directly (only its subtypes), so this file has no
;; other landed callers to check against.

;; og:preserve-this get-trans (slot 51): declared-never-defined in the
;; original decode, landing the base fallback here per jak3's twin
;; (goal_src/jak3/engine/process-drawable/process-focusable.gc:122, name-
;; dispatched so jak3's +1 method-id shift does not apply). target overrides
;; get-trans on its own type (target-util.gc:227) so this base only fires for
;; every other process-focusable subtype; master-track-target
;; (cam-master.gc:71,87,218,226,275,360) dispatches it on whatever the
;; camera is tracking, so this was the widest-blast-radius zero-slot in the
;; batch. All fields transcribed verbatim from jak3: root/trans/root-prim/
;; prim-core match jakx's own collide-shape and collide-shape-prim layouts
;; (collide-shape-h.gc), gspot-pos matches collide-shape-moving, and
;; draw-control-status's uninited bit is 4 in both games' art-h.gc so the
;; flag-bit hazard does not apply here.
;; definition for method 51 of type process-focusable
;; WARN: Return type mismatch structure vs vector.
(defmethod get-trans ((this process-focusable) (mode int))
  "Get the `trans` for this process."
  (let ((cshape (-> this root)))
    (the-as vector (cond
                     ((zero? mode)
                      (-> cshape trans)
                      )
                     ((and (= mode 1) (type? cshape collide-shape-moving))
                      (-> (the-as collide-shape-moving cshape) gspot-pos)
                      )
                     ((and (or (= mode 2) (= mode 3) (= mode 10)) (type? cshape collide-shape))
                      ;; og:preserve-this added check here so we don't use invalid bones
                      (if (logtest? (-> this draw status) (draw-control-status uninited))
                          (-> (the-as collide-shape-moving cshape) trans)
                          (-> (the-as collide-shape-moving cshape) root-prim prim-core))
                      )
                     (else
                       (-> cshape trans)
                       )
                     )
            )
    )
  )

;; definition for method 52 of type process-focusable
;; WARN: Return type mismatch vector vs quaternion.
(defmethod process-focusable-method-52 ((this process-focusable) (arg0 int))
  (the-as quaternion (-> this root rot))
  )

;; definition for method 55 of type process-focusable
;; WARN: Return type mismatch int vs meters.
(defmethod process-focusable-method-55 ((this process-focusable))
  (the-as meters 0)
  )

;; definition for method 56 of type process-focusable
;; WARN: Return type mismatch int vs time-frame.
(defmethod process-focusable-method-56 ((this process-focusable))
  (the-as time-frame 0)
  )