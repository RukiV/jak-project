;;-*-Lisp-*-
(in-package goal)

;; name: process-nettable.gc
;; name in dgo: process-nettable
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

;; the object's top-level still fails expression conversion, so this stays a partial
;; landing: the three methods the destruction surface needs, each verified against the
;; raw asm (methods 22/25/34 in the ir2; see slice-5 notes on issue #34)

(defmethod process-nettable-method-25 ((this process-nettable))
  "Is this process net-active? (net-flags bit 0)"
  (logtest? (-> this net-flags) 1)
  )

(defmethod process-nettable-method-22 ((this process-nettable))
  "Is this process locally owned? #t when no net session is active."
  (or (not *net-process-mgr*) (= (-> this owner-idx) (-> *net-process-mgr* local-machine-idx)))
  )

(defmethod process-nettable-method-34 ((this process-nettable) (arg0 int) (arg1 rgba))
  "Allocate a local net-process id (mgr method 55); on failure, deactivate this process."
  ;; og:preserve-this bring-up guard: retail dereferences *net-process-mgr* with no null
  ;; check (the mgr always exists there); the bring-up binds it #f, and skipping the whole
  ;; body reproduces the pre-landing gate behavior exactly (no allocation, no deactivate).
  ;; Drop the guard and re-derive verbatim when the net-process-mgr leg lands.
  (when *net-process-mgr*
    (when (not (net-process-mgr-method-55 *net-process-mgr* this arg0 arg1))
      (format 0 "NOT ENOUGH LOCAL NET-PROCESS-IDS!~%")
      (deactivate this)
      )
    )
  0
  (none)
  )

;; og:preserve-this bring-up stubs (#155): methods 27/28/29 are the net-message
;; begin/send/end trio that jungle-stone-snake-head's idle 'explode handler calls back
;; to back (jungle-obs.gc:848-858), itself an og:preserve-this artifact of these same
;; placeholder zero-arg sigs. None of the three has a body anywhere, so the first
;; dispatch (method-27) is a goal-0 null jump -- the landmine audit's only
;; gameplay-grade live crash, reached through landed combat/collision paths
;; (hit-point depletion or vehicle ram on jungle-stone-snake-head-proxy,
;; jungle-obs.gc:595-656). Stubbed together rather than one at a time, since the
;; handler calls all three in sequence and fixing only the first just moves the
;; crash to the next call in the same handler. The call site funcalls through
;; method-of-object with zero arguments and no explicit this, so these bodies must
;; not read this or any argument; a bare return is exactly right here. Retirement
;; condition: the real process-nettable bodies decode. net-simple-destruct.gc:419-431
;; already records the retail arg shapes for the re-derivation (method-27 takes
;; 'object-destroyed and returns a buffer handle, method-29 takes that handle plus
;; -2 and 208, method-28 takes the handle alone); jungle-obs.gc's own call site needs
;; the same re-derivation once these carry real signatures.
;; method-27's declared return retyped none -> mem-buffer (offline suite rung): peak-obs,
;; jungle-obs and net-simple-destruct's own og:preserve-this comments all agree the retail
;; call returns the mem-buffer to fill. The stub still does not build a real one, so it
;; hand-casts a null return to the declared type rather than reading (none) again, which
;; would now be a type error against the new signature. mem-buffer itself gained a
;; type-only landing (mem-buffer-h.gc) in the same rung so this cast has a real type to
;; target; it compiles earlier in dgos/game.gd (mem-buffer-h.o at 130, process-nettable.o
;; at 424), so the type is already known here.
(defmethod process-nettable-method-27 ((this process-nettable) (arg0 object))
  (the-as mem-buffer 0)
  )

;; og:preserve-this bring-up stub (issue 531): the real body is (free-msg-buffer
;; arg0), but free-msg-buffer is declared only in the decompiler config
;; (all-types.gc) and has no defun anywhere in this corpus; calling it here
;; would compile to a landmine (extern-no-defun class). The signature fix
;; below is still real and lands all 6 call sites' arguments correctly; only
;; the body stays a no-op until free-msg-buffer itself gets a real defun.
;; Retirement condition: a real free-msg-buffer definition lands.
(defmethod process-nettable-method-28 ((this process-nettable) (arg0 mem-buffer))
  0
  (none)
  )

(defmethod process-nettable-method-29 ((this process-nettable) (arg0 object) (arg1 object) (arg2 object))
  0
  (none)
  )

;; og:preserve-this methods 19/30/35/36: verified against the raw asm the same way
;; as the six methods above, despite the object's top-level still failing expression
;; conversion. Method 19 dispatches method 30, so both land together to avoid a
;; goal-0 null jump the moment plow.gc's many sub-part cleanup call sites (eye-left,
;; eye-right, thrusters, smoke, and their small siblings) reach it.
(defmethod process-nettable-method-19 ((this process-nettable))
  (process-nettable-method-30 this #f #f)
  (deactivate this)
  0
  (none)
  )

;; og:preserve-this bring-up guard: same precedent as method 34 above (retail
;; dereferences *net-process-mgr* with no null check; net-process-mgr-method-56
;; is not landed either). Skipping the call reproduces pre-landing behavior.
(defmethod process-nettable-method-30 ((this process-nettable) (arg0 object) (arg1 object))
  (when *net-process-mgr*
    (net-process-mgr-method-56 *net-process-mgr* this arg0 arg1)
    )
  0
  (none)
  )

;; methods 35/36: clean decode, both no-op stubs that ignore this/arg0 and return
;; 0/none. method 35's all-types comment (an old open question about the int
;; arg's purpose, suggesting a caller to net-enemy-init-remote as the place to
;; resolve it) is now moot: the raw body never reads arg0 at all.
(defmethod process-nettable-method-35 ((this process-nettable) (arg0 int))
  0
  (none)
  )

(defmethod process-nettable-method-36 ((this process-nettable))
  0
  (none)
  )
