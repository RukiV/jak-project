;;-*-Lisp-*-
(in-package goal)

;; name: etie-near-vu1.gc
;; name in dgo: etie-near-vu1
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

;; definition of type etn-consts
(deftype etn-consts (structure)
  ((gifbufs  qword            :inline)
   (adgif    qword            :inline)
   (alpha    qword            :inline)
   (strgif   generic-gif-tag  :inline)
   (envgif   generic-gif-tag  :inline)
   (envmap   adgif-shader     :inline)
   (pers0    vector           :inline)
   (pers1    vector           :inline)
   (hvdf     vector           :inline)
   (invh     vector           :inline)
   (guard    vector           :inline)
   )
  )

;; definition for method 3 of type etn-consts
(defmethod inspect ((this etn-consts))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'etn-consts)
  (format #t "~1Tgifbufs: #<qword @ #x~X>~%" (-> this gifbufs))
  (format #t "~1Tadgif: #<qword @ #x~X>~%" (-> this adgif))
  (format #t "~1Talpha: #<qword @ #x~X>~%" (-> this alpha))
  (format #t "~1Tstrgif: #<generic-gif-tag @ #x~X>~%" (-> this strgif))
  (format #t "~1Tenvgif: #<generic-gif-tag @ #x~X>~%" (-> this envgif))
  (format #t "~1Tenvmap: #<adgif-shader @ #x~X>~%" (-> this envmap))
  (format #t "~1Tpers0: #<vector @ #x~X>~%" (-> this pers0))
  (format #t "~1Tpers1: #<vector @ #x~X>~%" (-> this pers1))
  (format #t "~1Thvdf: #<vector @ #x~X>~%" (-> this hvdf))
  (format #t "~1Tinvh: #<vector @ #x~X>~%" (-> this invh))
  (format #t "~1Tguard: #<vector @ #x~X>~%" (-> this guard))
  (label cfg-4)
  this
  )

;; definition of type etn-matrix
(deftype etn-matrix (structure)
  ((rmtx   matrix   :inline)
   (nmtx   matrix3  :inline)
   (morph  float    :overlay-at (-> nmtx data 3))
   (fog    float    :overlay-at (-> nmtx data 7))
   (fade   uint32   :overlay-at (-> nmtx data 11))
   (tint   qword    :inline)
   )
  )

;; definition for method 3 of type etn-matrix
(defmethod inspect ((this etn-matrix))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'etn-matrix)
  (format #t "~1Trmtx: #<matrix @ #x~X>~%" (-> this rmtx))
  (format #t "~1Tnmtx: #<matrix3 @ #x~X>~%" (-> this nmtx))
  (format #t "~1Tmorph: ~f~%" (-> this morph))
  (format #t "~1Tfog: ~f~%" (-> this fog))
  (format #t "~1Tfade: ~D~%" (-> this fade))
  (format #t "~1Ttint: #<qword @ #x~X>~%" (-> this tint))
  (label cfg-4)
  this
  )

;; definition of type etn-vtx
(deftype etn-vtx (structure)
  ((pos  vector  :inline)
   (clr  vector  :inline)
   (tex  vector  :inline)
   (tx2  vector  :inline)
   )
  )

;; definition for method 3 of type etn-vtx
(defmethod inspect ((this etn-vtx))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'etn-vtx)
  (format #t "~1Tpos: #<vector @ #x~X>~%" (-> this pos))
  (format #t "~1Tclr: #<vector @ #x~X>~%" (-> this clr))
  (format #t "~1Ttex: #<vector @ #x~X>~%" (-> this tex))
  (format #t "~1Ttx2: #<vector @ #x~X>~%" (-> this tx2))
  (label cfg-4)
  this
  )

;; definition of type etn-plane
(deftype etn-plane (structure)
  ((point    uint32)
   (prev     uint32)
   (outfunc  uint32)
   (flags    uint32)
   (out      etn-vtx  :inline)
   (in       etn-vtx  :inline)
   )
  )

;; definition for method 3 of type etn-plane
(defmethod inspect ((this etn-plane))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'etn-plane)
  (format #t "~1Tpoint: ~D~%" (-> this point))
  (format #t "~1Tprev: ~D~%" (-> this prev))
  (format #t "~1Toutfunc: ~D~%" (-> this outfunc))
  (format #t "~1Tflags: ~D~%" (-> this flags))
  (format #t "~1Tout: #<etn-vtx @ #x~X>~%" (-> this out))
  (format #t "~1Tin: #<etn-vtx @ #x~X>~%" (-> this in))
  (label cfg-4)
  this
  )

;; definition for symbol etn-vu1-block, type vu-function
(define etn-vu1-block (new 'static 'vu-function :length #x7f4 :qlength #x3fa))

;; definition for function etn-magic
(defun etn-magic ((arg0 int))
  (+ #x4b000000 arg0)
  )

;; definition for function etn-init-consts
;; INFO: Used lq/sq
;; WARN: Return type mismatch int vs none.
(defun etn-init-consts ((arg0 etn-consts) (arg1 gs-alpha))
  (set! (-> arg0 adgif dword 0) (make-u128 0 (the-as uint #x1000000000000005)))
  (set! (-> arg0 adgif dword 1) (the-as uint 14))
  ;; og:preserve-this gpr->fpr dropped: vector4w's x/y/z/w fields (vector-h.gc)
  ;; are declared int32, and the compiler's gpr->fpr only accepts a
  ;; compile-time-immediate int and never resolves against an int32 store
  ;; target anyway. The mtc1/swc1 pair the decompiler saw here just moves the
  ;; raw bit pattern #x4b000000+N through the FPR file on its way to an
  ;; int-typed field; storing the plain int sum below writes the identical
  ;; bits (sw instead of swc1) since both sides are already int32. Retire this
  ;; note if the decompiler starts collapsing mtc1+swc1-into-int-field back to
  ;; a plain int store on its own.
  (let ((v1-3 510))
    (set! (-> arg0 gifbufs vector4w x) (+ #x4b000000 v1-3))
    )
  (let ((v1-5 249))
    (set! (-> arg0 gifbufs vector4w y) (+ #x4b000000 v1-5))
    )
  (let ((v1-7 510))
    (set! (-> arg0 gifbufs vector4w z) (+ #x4b000000 v1-7))
    )
  (let ((v1-9 249))
    (set! (-> arg0 gifbufs vector4w w) (+ #x4b000000 v1-9))
    )
  (set! (-> arg0 alpha dword 0) (the-as uint arg1))
  (set! (-> arg0 alpha dword 1) (the-as uint 66))
  (case *subdivide-scissor-draw-mode*
    (((subdivide-setting textured))
     (set! (-> arg0 strgif str-prim)
           (new 'static 'gif-tag-prim
             :pre #x1
             :prim (new 'static 'gs-prim :prim (gs-prim-type tri-strip) :iip #x1 :tme #x1 :fge #x1 :abe #x1)
             :nreg #x3
             )
           )
     (set! (-> arg0 strgif fan-prim)
           (new 'static 'gif-tag-prim
             :pre #x1
             :prim (new 'static 'gs-prim :prim (gs-prim-type tri-fan) :iip #x1 :tme #x1 :fge #x1 :abe #x1)
             :nreg #x3
             )
           )
     (set! (-> arg0 envgif str-prim)
           (new 'static 'gif-tag-prim
             :pre #x1
             :prim (new 'static 'gs-prim :prim (gs-prim-type tri-strip) :iip #x1 :tme #x1 :abe #x1)
             :nreg #x3
             )
           )
     (set! (-> arg0 envgif fan-prim)
           (new 'static 'gif-tag-prim
             :pre #x1
             :prim (new 'static 'gs-prim :prim (gs-prim-type tri-fan) :iip #x1 :tme #x1 :abe #x1)
             :nreg #x3
             )
           )
     )
    (((subdivide-setting outline))
     (set! (-> arg0 strgif str-prim)
           (new 'static 'gif-tag-prim
             :pre #x1
             :prim (new 'static 'gs-prim :prim (gs-prim-type line-strip) :iip #x1 :tme #x1 :fge #x1 :abe #x1)
             :nreg #x3
             )
           )
     (set! (-> arg0 strgif fan-prim)
           (new 'static 'gif-tag-prim
             :pre #x1
             :prim (new 'static 'gs-prim :prim (gs-prim-type line-strip) :iip #x1 :tme #x1 :fge #x1 :abe #x1)
             :nreg #x3
             )
           )
     (set! (-> arg0 envgif str-prim)
           (new 'static 'gif-tag-prim
             :pre #x1
             :prim (new 'static 'gs-prim :prim (gs-prim-type line-strip) :iip #x1 :tme #x1 :abe #x1)
             :nreg #x3
             )
           )
     (set! (-> arg0 envgif fan-prim)
           (new 'static 'gif-tag-prim
             :pre #x1
             :prim (new 'static 'gs-prim :prim (gs-prim-type line-strip) :iip #x1 :tme #x1 :abe #x1)
             :nreg #x3
             )
           )
     )
    (((subdivide-setting gouraud))
     (set! (-> arg0 strgif str-prim)
           (new 'static 'gif-tag-prim
             :pre #x1
             :prim (new 'static 'gs-prim :prim (gs-prim-type tri-strip) :iip #x1 :fge #x1 :abe #x1)
             :nreg #x3
             )
           )
     (set! (-> arg0 strgif fan-prim)
           (new 'static 'gif-tag-prim
             :pre #x1
             :prim (new 'static 'gs-prim :prim (gs-prim-type tri-fan) :iip #x1 :fge #x1 :abe #x1)
             :nreg #x3
             )
           )
     (set! (-> arg0 envgif str-prim)
           (new 'static 'gif-tag-prim
             :pre #x1
             :prim (new 'static 'gs-prim :prim (gs-prim-type tri-strip) :iip #x1 :abe #x1)
             :nreg #x3
             )
           )
     (set! (-> arg0 envgif fan-prim)
           (new 'static 'gif-tag-prim
             :pre #x1
             :prim (new 'static 'gs-prim :prim (gs-prim-type tri-fan) :iip #x1 :abe #x1)
             :nreg #x3
             )
           )
     )
    (((subdivide-setting hack))
     (set! (-> arg0 strgif str-prim)
           (new 'static 'gif-tag-prim
             :pre #x1
             :prim (new 'static 'gs-prim :prim (gs-prim-type line-strip) :iip #x1 :tme #x1 :fge #x1 :abe #x1)
             :nreg #x3
             )
           )
     (set! (-> arg0 strgif fan-prim)
           (new 'static 'gif-tag-prim
             :pre #x1
             :prim (new 'static 'gs-prim :prim (gs-prim-type tri-fan) :iip #x1 :tme #x1 :fge #x1 :abe #x1)
             :nreg #x3
             )
           )
     (set! (-> arg0 envgif str-prim)
           (new 'static 'gif-tag-prim
             :pre #x1
             :prim (new 'static 'gs-prim :prim (gs-prim-type line-strip) :iip #x1 :tme #x1 :abe #x1)
             :nreg #x3
             )
           )
     (set! (-> arg0 envgif fan-prim)
           (new 'static 'gif-tag-prim
             :pre #x1
             :prim (new 'static 'gs-prim :prim (gs-prim-type tri-fan) :iip #x1 :tme #x1 :abe #x1)
             :nreg #x3
             )
           )
     )
    )
  (set! (-> arg0 strgif regs)
        (new 'static 'gif-tag-regs-32 :regs0 (gif-reg-id st) :regs1 (gif-reg-id rgbaq) :regs2 (gif-reg-id xyzf2))
        )
  (set! (-> arg0 envgif regs)
        (new 'static 'gif-tag-regs-32 :regs0 (gif-reg-id st) :regs1 (gif-reg-id rgbaq) :regs2 (gif-reg-id xyzf2))
        )
  (let* ((v1-32 (view-get-active-math-camera))
         (s2-0 (new-stack-matrix0))
         (a2-0 (-> v1-32 perspective))
         (a1-1 (-> v1-32 hmge-scale))
         (s3-0 (-> v1-32 inv-hmge-scale))
         (s4-0 (-> v1-32 hvdf-off))
         (s5-0 (-> v1-32 guard))
         )
    (column-scale-matrix! s2-0 a1-1 a2-0)
    (let ((f2-0 (-> s2-0 rvec x))
          (f3-0 (-> s2-0 uvec y))
          (f4-0 (-> s2-0 fvec z))
          (f0-4 (-> s2-0 fvec w))
          )
      (let ((f1-0 (-> s2-0 trans z)))
        (set! (-> arg0 pers0 x) f2-0)
        (set! (-> arg0 pers0 y) f3-0)
        (set! (-> arg0 pers0 z) f4-0)
        (set! (-> arg0 pers0 w) 0.0)
        (set! (-> arg0 pers1 x) 0.0)
        (set! (-> arg0 pers1 y) 0.0)
        (set! (-> arg0 pers1 z) f1-0)
        )
      (set! (-> arg0 pers1 w) f0-4)
      )
    (set! (-> arg0 invh quad) (-> s3-0 quad))
    (set! (-> arg0 hvdf quad) (-> s4-0 quad))
    (set! (-> arg0 guard quad) (-> s5-0 quad))
    )
  (let* ((v1-38 *default-envmap-shader*)
         (a0-16 (-> arg0 envmap))
         (a1-2 (-> v1-38 quad 0 quad))
         (a2-1 (-> v1-38 quad 1 quad))
         (a3-0 (-> v1-38 quad 2 quad))
         (t0-0 (-> v1-38 quad 3 quad))
         (v1-39 (-> v1-38 quad 4 quad))
         )
    (set! (-> a0-16 quad 0 quad) a1-2)
    (set! (-> a0-16 quad 1 quad) a2-1)
    (set! (-> a0-16 quad 2 quad) a3-0)
    (set! (-> a0-16 quad 3 quad) t0-0)
    (set! (-> a0-16 quad 4 quad) v1-39)
    )
  0
  (none)
  )

;; definition for function etn-init-engine
;; WARN: Return type mismatch dma-buffer vs none.
(defun etn-init-engine ((arg0 dma-buffer) (arg1 gs-alpha) (arg2 gs-test))
  (let ((v1-0 *display*)
        (a0-6 (+ (* (+ (/ (-> etn-vu1-block qlength) 127) 1) 16) 416))
        )
    (+! (-> v1-0 mem-reserve-size) a0-6)
    (when (not (-> v1-0 dma-buffer-overflow))
      (let ((a3-0 (-> v1-0 frames (-> v1-0 on-screen) global-buf)))
        (if (< (-> a3-0 real-buffer-end) (the-as int (&+ (-> a3-0 base) a0-6)))
            (set! (-> v1-0 dma-buffer-overflow) #t)
            )
        )
      (when (not (-> v1-0 dma-buffer-overflow))
        (let* ((v1-2 *viewport-array*)
               (v1-3 (-> v1-2 data (-> v1-2 current-viewport-index)))
               )
          (dma-buffer-add-gs-set arg0
                                 (test-1 arg2)
                                 (frame-1 (-> v1-3 frame))
                                 (zbuf-1 (-> v1-3 zbuf-on))
                                 (scissor-1 (-> v1-3 scissor))
                                 )
          )
        (dma-buffer-add-vu-function arg0 etn-vu1-block 1)
        (let ((s4-0 15))
          (let* ((v1-7 arg0)
                 (a0-17 (-> v1-7 base))
                 )
            (set! (-> (the-as (pointer int64) a0-17)) (logior #x10000000 (shr (shl s4-0 48) 48)))
            (set! (-> (the-as (pointer uint32) a0-17) 2) (the-as uint #x5000000))
            (set! (-> (the-as (pointer uint32) a0-17) 3) (the-as uint (logior #x6c000382 (shr (shl s4-0 56) 40))))
            (set! (-> v1-7 base) (&+ a0-17 16))
            )
          (etn-init-consts (the-as etn-consts (-> arg0 base)) arg1)
          (&+! (-> arg0 base) (* s4-0 16))
          )
        (let* ((v1-10 arg0)
               (a0-21 (-> v1-10 base))
               )
          (set! (-> (the-as (pointer int64) a0-21)) #x10000000)
          (set! (-> (the-as (pointer uint32) a0-21) 2) (the-as uint #x15000008))
          (set! (-> (the-as (pointer uint32) a0-21) 3) (the-as uint #x13000000))
          (set! (-> v1-10 base) (&+ a0-21 16))
          )
        (let* ((v1-11 arg0)
               (a0-23 (-> v1-11 base))
               )
          (set! (-> (the-as (pointer int64) a0-23)) #x10000002)
          (set! (-> (the-as (pointer uint32) a0-23) 2) (the-as uint 0))
          (set! (-> (the-as (pointer uint32) a0-23) 3) (the-as uint #x30000000))
          (set! (-> v1-11 base) (&+ a0-23 16))
          )
        (let* ((v1-12 arg0)
               (a0-25 (-> v1-12 base))
               )
          (set! (-> (the-as (pointer int32) a0-25)) #x4b000000)
          (set! (-> (the-as (pointer uint32) a0-25) 1) (the-as uint #x4b000000))
          (set! (-> (the-as (pointer uint32) a0-25) 2) (the-as uint #x4b000000))
          (set! (-> (the-as (pointer uint32) a0-25) 3) (the-as uint #x4b000000))
          (set! (-> (the-as (pointer uint32) a0-25) 4) (the-as uint #x30000b8))
          (set! (-> (the-as (pointer uint32) a0-25) 5) (the-as uint #x2000020))
          (set! (-> (the-as (pointer uint32) a0-25) 6) (the-as uint #x5000000))
          (set! (-> (the-as (pointer uint32) a0-25) 7) (the-as uint #x1000404))
          (set! (-> v1-12 base) (&+ a0-25 32))
          )
        )
      )
    )
  (none)
  )

;; definition for function etn-end-buffer
;; WARN: Return type mismatch int vs none.
(defun etn-end-buffer ((arg0 dma-buffer))
  (let ((v1-0 *display*)
        (a1-0 96)
        )
    (+! (-> v1-0 mem-reserve-size) a1-0)
    (when (not (-> v1-0 dma-buffer-overflow))
      (let ((a3-0 (-> v1-0 frames (-> v1-0 on-screen) global-buf)))
        (if (< (-> a3-0 real-buffer-end) (the-as int (&+ (-> a3-0 base) a1-0)))
            (set! (-> v1-0 dma-buffer-overflow) #t)
            )
        )
      (when (not (-> v1-0 dma-buffer-overflow))
        (dma-buffer-add-gs-set arg0 (test-1 (new 'static 'gs-test :zte #x1 :ztst (gs-ztest greater-equal))))
        (let* ((v1-5 arg0)
               (a1-10 (-> v1-5 base))
               )
          (set! (-> (the-as (pointer int64) a1-10)) #x10000002)
          (set! (-> (the-as (pointer uint32) a1-10) 2) (the-as uint #x20000000))
          (set! (-> (the-as (pointer uint32) a1-10) 3) (the-as uint 0))
          (set! (-> v1-5 base) (&+ a1-10 16))
          )
        (let* ((v1-6 arg0)
               (a0-1 (-> v1-6 base))
               )
          (set! (-> (the-as (pointer int32) a0-1)) #x15000004)
          (set! (-> (the-as (pointer uint32) a0-1) 1) (the-as uint #x5000000))
          (set! (-> (the-as (pointer uint32) a0-1) 2) (the-as uint #x13000000))
          (set! (-> (the-as (pointer uint32) a0-1) 3) (the-as uint #x30000000))
          (set! (-> (the-as (pointer uint32) a0-1) 4) (the-as uint 0))
          (set! (-> (the-as (pointer uint32) a0-1) 5) (the-as uint 0))
          (set! (-> (the-as (pointer uint32) a0-1) 6) (the-as uint 0))
          (set! (-> (the-as (pointer uint32) a0-1) 7) (the-as uint 0))
          (set! (-> v1-6 base) (&+ a0-1 32))
          )
        )
      )
    )
  0
  (none)
  )

