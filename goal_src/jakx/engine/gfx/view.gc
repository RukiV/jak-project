;; definition for function view-print
;; ERROR: function has no type analysis. Cannot decompile.

;; og:preserve-this hand-written from view_ir2.asm: the tiny view accessors fail the
;; decompiler's type analysis (int8 loads through untyped stack slots) but their
;; semantics are trivial. The pp view branch guards nonzero? too (zeroed process
;; fields read 0, which is truthy; low-memory derefs fault on PC).

(defun view-push-context ((arg0 int))
  (when (>= *view-context-stack-ptr* 8)
    (break!)
    0
    )
  (set! *view-context-stack-ptr* (+ *view-context-stack-ptr* 1))
  (set! (-> *view-context-stack* *view-context-stack-ptr*) arg0)
  0
  (none)
  )

(defun view-get-active ()
  (with-pp
    (cond
      ((and pp (nonzero? (-> pp view)) (-> pp view))
       (-> pp view)
       )
      ((>= *view-context-stack-ptr* 0)
       (-> *views* (-> *view-context-stack* *view-context-stack-ptr*))
       )
      (else
        (when *view-assert*
          (break!)
          0
          )
        (-> *views* (the-as int *view-default*))
        )
      )
    )
  )

(defun view-get-active-index ()
  (let ((v (view-get-active)))
    (if v
        (-> v index)
        -1
        )
    )
  )

(defun view-get-active-camera ()
  (the-as process (-> (view-get-active) camera))
  )

(defun view-get-active-target ()
  (the-as process (-> (view-get-active) target))
  )

(defun view-get-math-camera ((arg0 int))
  (the-as math-camera (-> *views* arg0 math-camera))
  )

(defun view-get-active-math-camera ()
  (the-as math-camera (-> (view-get-active) math-camera))
  )

(defun view-get-active-camera-combiner ()
  ;; og:preserve-this basic return: camera-combiner's deftype compiles later (camera-h.gc)
  (-> (view-get-active) camera-combiner)
  )

(defun view-set-active-camera-combiner ((arg0 basic))
  (set! (-> (view-get-active) camera-combiner) arg0)
  arg0
  )

(defun view-set-active-camera ((arg0 basic))
  (set! (-> (view-get-active) camera) arg0)
  arg0
  )

;; og:preserve-this decode provenance (#152): view_ir2.asm's L38 stores arg0 at
;; +12 off the view returned by view-get-active (s.w! (+ v0-0 12) a0-0); view-h.gc's
;; deftype and view-get-target's own decode above (-> *views* arg0 target) both
;; resolve target to that same offset, confirming the store. Landing this for real
;; retires the R4 forward-decl stub that used to sit at the top of this file (#122)
;; and makes logic-target.gc:127-128's (nonzero? view-set-active-target) guard in
;; start go live for the first time: the symbol had no bound value before, so the
;; guard was always false and start never registered the spawned target as the
;; active view's target.
(defun view-set-active-target ((arg0 basic))
  (set! (-> (view-get-active) target) arg0)
  arg0
  )

;; failed to figure out what this is:
(dotimes (gp-0 2)
  (format 0 "allocating view ~D~%" gp-0)
  (set! (-> *views* gp-0) (new 'global 'view))
  (set! (-> *views* gp-0 camera) #f)
  (set! (-> *views* gp-0 camera-combiner) #f)
  (set! (-> *views* gp-0 target) #f)
  (set! (-> *views* gp-0 math-camera) (new 'global 'math-camera))
  (set! (-> *views* gp-0 index) gp-0)
  )




