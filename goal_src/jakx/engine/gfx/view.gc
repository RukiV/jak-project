;; definition for function view-pop-context
;; WARN: Return type mismatch int vs none.
(defun view-pop-context ()
  (when (< *view-context-stack-ptr* 0)
    (break!)
    0
    )
  (set! *view-context-stack-ptr* (- *view-context-stack-ptr* 1))
  0
  (none)
  )

