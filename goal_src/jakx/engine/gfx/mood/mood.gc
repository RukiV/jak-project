;; definition for method 15 of type mood-control
;; WARN: Return type mismatch int vs none.
(defmethod set-lightning-time! ((this mood-control) (arg0 int) (arg1 int) (arg2 float))
  (set! (-> this lightning-index) arg0)
  (set! (-> this lightning-val) arg1)
  (set! (-> this lightning-time2) (seconds-per-frame))
  (set! (-> this lightning-time3) arg2)
  0
  (none)
  )

;; definition for method 9 of type mood-control
;; og:preserve-this landed from jak3's cleanly-landed shape (jak3/engine/gfx/mood/mood.gc:1288-1586),
;; per the fog audit's Q4 item 1 (docs/2026-08-12-fog-state-audit.md). jak3's mood-control-work
;; layout, its fogs[]/colors[]/channels[]/clouds[] table ordering and the 3*cloud+fog index
;; arithmetic are byte-identical to jakx's own raw decomp: confirmed line-for-line against this
;; method's former commented block (mood.gc, original lines 2073-3840) at the weather/iweather/
;; interp/index writes to mood-control-work offsets 16/20/24/28/32/36/40/44/48/52, the desert
;; branch's apply-mood-fog / mood-control-method-20 / apply-fog-height / adjust-num-clouds call
;; order (original lines 3058-3101, matching jak3 1372-1390), the cloud-interp 8.0x factor, and
;; the closing debug prints (down to the same L266-L275 format strings and the same 1/300 and
;; 1/speed constants). CORRECTION (docs/2026-08-12-cloud-walk-audit.md): this note previously
;; claimed the two 5-draw-plus-speed rand-vu-float-range redraw blocks were confirmed line-for-line
;; too; they were not. The speed draws are faithful, but the 5-draw cloud/fog target sum was a
;; verbatim jak3 transcription (jak3/engine/gfx/mood/mood.gc:1437-1445, 1473-1481) that diverges
;; from jakx's own raw block; see the note at that let below for the corrected shape. Four points
;; diverge from jak3's literal source because jakx's landed tree does not yet carry the symbol or
;; field jak3 calls, or because jakx's own raw decomp overrides jak3's shape outright; jakx's own
;; raw decomp is the authority for all four, per the brief:
;;  - the "bad weather" cheat gate uses the literal mask #x100000 in place of
;;    (game-secrets bad-weather): jakx's game-secrets defenum (settings-h.gc) declares only
;;    hero-mode so far, but the raw block (original lines 3550-3556) tests this exact literal
;;    against *game-info* secrets, so the bit is real and landing it as a literal avoids touching
;;    a second DGO object (settings-h) for this rung.
;;  - the final special-interp seek drops jak3's (not (-> *game-info* dust-storm)) conjunct:
;;    jakx's game-info deftype has no dust-storm field (game-info.gc:587's own note says jak3's
;;    score-owner/timer-owner/dust-storm handle set has no jakx match and is deliberately not
;;    ported, pending a full top-level-login decode). The raw block's own guard for this seek
;;    (original lines 3721-3724) tests only (not (paused?)) too, so this matches both the retail
;;    decomp and the file's existing scope note.
;;  - the rain-hiss start call (rain-id was zero) is wrapped in a nonzero? guard on a new
;;    sound-play-by-name extern, declared at the top of this file next to set-fog-height!/
;;    set-cloud-minmax!: sound-play-by-name has no landing anywhere in jakx's goal_src (grepped
;;    clean tree-wide), and landing the real defbehavior is sound-engine scope, not fog scope.
;;    The already-playing branch below is NOT jak3's shape and does not need a guard: it is
;;    transcribed from jakx's own raw block instead (see the note at that branch).
;;  - the two 5-draw cloud/fog target redraws (below) are jakx's own raw block's shape, not
;;    jak3's: five bare uniforms off rand-uint31-gen *random-generator*, clamped into the live
;;    range, per docs/2026-08-12-cloud-walk-audit.md Q1/Q4. jak3's mood.gc:1437-1445/1473-1481
;;    uses the range-scaled rand-vu-float-range form this replaced and is not being "fixed" from
;;    this finding: jak3 has no raw block in this tree to check it against, and its own level data
;;    (245 of ~296 entries at :max-cloud 1.0) makes the two forms algebraically equivalent there.
(defmethod init-weather! ((this mood-control))
  (local-vars (v1-32 int) (a1-12 object))
  (let ((s5-0 (level-get-target-inside *level*)))
    (when s5-0
      (set! (-> this mood-direction-table) *mood-direction-table*)
      (let ((s4-0 (new 'stack-no-clear 'mood-control-work)))
        (let ((s3-0 this))
          (cond
            ((and (-> s3-0 overide-weather-flag) (not (movie?)) (= (-> s3-0 current-special-interp) 0.0))
             (set! (-> s4-0 weather cloud) (* 2.0 (fmax 0.0 (fmin 1.0 (-> this overide cloud)))))
             (set! (-> s4-0 weather fog) (* 2.0 (-> this overide fog)))
             )
            (else
              (set! (-> s4-0 weather cloud) (* 2.0 (fmax 0.0 (fmin 1.0 (-> this current-interp cloud)))))
              (set! (-> s4-0 weather fog) (* 2.0 (fmax 0.0 (fmin 1.0 (-> this current-interp fog)))))
              )
            )
          )
        (set! (-> s4-0 iweather cloud) (the int (-> s4-0 weather cloud)))
        (let ((f0-12 (- (-> s4-0 weather cloud) (the float (-> s4-0 iweather cloud)))))
          (cond
            ((zero? (-> s4-0 iweather cloud))
             (if (< f0-12 0.5)
                 (set! (-> s4-0 interp cloud) 0.0)
                 (set! (-> s4-0 interp cloud) (* 2.0 (+ -0.5 f0-12)))
                 )
             )
            (else
              (set! (-> s4-0 interp cloud) f0-12)
              )
            )
          )
        (set! (-> s4-0 iweather fog) (the int (-> s4-0 weather fog)))
        (set! (-> s4-0 interp fog) (- (-> s4-0 weather fog) (the float (-> s4-0 iweather fog))))
        (let ((a0-2 (-> s4-0 iweather fog))
              (v1-23 (-> s4-0 iweather cloud))
              )
          (set! (-> s4-0 index 0) (+ (* 3 v1-23) a0-2))
          (set! (-> s4-0 index 1) (+ a0-2 1 (* 3 v1-23)))
          (set! (-> s4-0 index 2) (+ (* 3 (+ v1-23 1)) a0-2))
          (set! (-> s4-0 index 3) (+ a0-2 1 (* 3 (+ v1-23 1))))
          )
