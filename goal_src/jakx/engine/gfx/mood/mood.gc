(define-extern set-fog-height! (function float none))
(define-extern set-cloud-minmax! (function float float none))

;; og:preserve-this runtime-link extern: sound-play-by-name (the rain-hiss loop start in
;; init-weather!, m9) has no landing anywhere in jakx's goal_src, not even an extern (grepped
;; tree-wide); landing the real defbehavior is engine/sound scope, not fog scope. Guarded the
;; same way as the two externs above: the call is a no-op until it is actually landed.
(define-extern sound-play-by-name (function sound-name sound-id int int int uint object sound-id))

(define-extern update-mood-direction (function mood-context-core3 mood-table float float)) ;; landed below (forge #82)

