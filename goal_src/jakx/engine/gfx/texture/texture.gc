  ;; (#when PC_PORT (return #f)) guard on upload-vram-data, since the GS bitbltbuf/
  ;; trxpos/trxreg/trxdir transfer path below is not parsed on PC (see the
  ;; upload-vram-pages comment at line 1354).
  (#when PC_PORT
    ;; disabled.
    (return #f)
    )
