                                   (bitbltbuf (new 'static 'gs-bitbltbuf :dbw (/ arg4 64) :dbp arg1))
                                   (trxpos (new 'static 'gs-trxpos))
                                   (trxreg (new 'static 'gs-trxreg :rrw arg4 :rrh a3-2))
                                   (trxdir (new 'static 'gs-trxdir))
                                   )
            (dma-buffer-add-ref-texture arg0 arg2 arg4 a3-2 (gs-psm ct32))
            )
          (+! arg1 4096)
          (&+! arg2 #x100000)
          (+! arg3 -2048)
          )
        )
      )
    )
  )
  (none)
  )

