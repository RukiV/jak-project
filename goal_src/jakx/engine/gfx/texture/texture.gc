       (set! (-> *level* level-default texture-page-dir 7 page) arg1)
       )
      ((= arg3 5)
       (texture-page-common-allocate arg0 arg1 arg2 arg3)
       (set! (-> *level* level-default texture-page-dir 4 page) arg1)
       )
      ((= arg3 6)
       (texture-page-common-allocate arg0 arg1 arg2 arg3)
       (set! (-> *level* level-default texture-page-dir 0 page) arg1)
       )
      ((= arg3 7)
       (texture-page-common-allocate arg0 arg1 arg2 arg3)
       (set! (-> *level* level-default texture-page-dir 1 page) arg1)
       )
      ((= arg3 8)
