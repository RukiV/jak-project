;; WARN: Return type mismatch symbol vs none.
(defun make-cloud-clut ((arg0 (pointer uint32)) (arg1 float) (arg2 float))
  (local-vars (v1-10 int))
  0
  (let* ((s5-0 (the int (* 255.0 arg1)))
         (s4-1 (max (the int (* 255.0 arg2)) s5-0))
         (f30-0 (/ 128.0 (the float (- s4-1 s5-0))))
         )
    (dotimes (s3-0 256)
      (let ((s2-0 (-> *clut-translate* s3-0)))
        (cond
          ((and (>= s5-0 s3-0) (nonzero? s4-1))
           (set! v1-10 0)
           )
          ((>= s3-0 s4-1)
           (set! v1-10 128)
           )
          (else
            (let ((f0-11 (square (sin (* 128.0 (fmin 128.0 (* (the float (- s3-0 s5-0)) f30-0)))))))
              (set! v1-10 (the int (* 128.0 f0-11)))
              )
            )
          )
        (set! (-> arg0 s2-0) (logior (logand (-> arg0 s2-0) -256) 128))
        (set! (-> arg0 s2-0) (logior (logand (-> arg0 s2-0) -65281) #x8000))
        (set! (-> arg0 s2-0) (logior (logand (-> arg0 s2-0) -16711681) #x800000))
        (set! (-> arg0 s2-0)
              (logior (logand (-> arg0 s2-0) (the-as uint #xffffffff00ffffff)) (shr (shl v1-10 56) 32))
              )
        )
      )
    )
  (none)
  )

;; definition for function texture-anim-cloud-clut-upload
;; WARN: Return type mismatch int vs none.
(defun texture-anim-cloud-clut-upload ((arg0 dma-buffer) (arg1 texture-anim))
  "og:preserve-this jakx PC port. The clut generation is retail and unchanged; only the delivery
changes. upload-vram-data is a dead end here: it builds a GS packet the PC never parses, and is
itself wrapped in a bring-up guard. Instead the generated clut is handed to the texture animator,
which re-cluts the extracted 'clouds' index texture and publishes the result at the dest tbp the
sky's adgif names.

The pad-0 and clutdest tests are not paranoia. texture-anim-cloud-clut-init writes clutdest and
pad 0 onto the record it gets from lookup-texture-by-name, but it never assigns (-> anim tex) --
that comes from init-textures! via a different lookup, so the two can be different records. When
they are, pad 0 is 0 and the retail body's make-cloud-clut would write 1 KiB over EE offset 0
every frame."
  (let ((tex (-> arg1 tex)))
    (when (and tex (nonzero? (-> tex pad 0)) (nonzero? (-> tex clutdest)))
      (make-cloud-clut (the-as (pointer uint32) (-> tex pad 0)) (-> arg1 extra x) (-> arg1 extra y))
      (pc-texture-anim-flag upload-clut-16-16 arg0 :qwc 1)
      (let ((upload-record (the texture-anim-pc-upload (-> arg0 base))))
        (set! (-> upload-record data) (the-as pointer (-> tex pad 0)))
        (set! (-> upload-record width) 16)
        (set! (-> upload-record height) 16)
        (set! (-> upload-record dest) (-> tex clutdest))
        (set! (-> upload-record format) (gs-psm ct32))
        (set! (-> upload-record force-to-gpu) 0)
        )
      (&+! (-> arg0 base) 16)
      (pc-texture-anim-flag clut-index-texture arg0 :qwc 1)
      (let ((clut-index-record (the texture-anim-pc-clut-index (-> arg0 base))))
        (set! (-> clut-index-record itex-idx) 0)
        (set! (-> clut-index-record dest-tbp) (the-as int (-> tex dest 0)))
        (set! (-> clut-index-record clut-tbp) (the-as int (-> tex clutdest)))
        (set! (-> clut-index-record pad) 0)
        )
      (&+! (-> arg0 base) 16)
      (set! (-> *texture-pool* ids (shr (-> tex clutdest) 6)) (the-as uint 0))
      0
      )
    )
  (none)
  )

;; definition for function texture-anim-cloud-clut-init
;; WARN: Return type mismatch int vs none.
(defun texture-anim-cloud-clut-init ((arg0 texture-anim))
  (let ((gp-0 (lookup-texture-by-name (-> arg0 tex-name) (the-as string #f) (the-as (pointer texture-page) #f)))
        (s5-0 (new 'loading-level 'clut16x16))
        )
    (when gp-0
      (set! (-> gp-0 clutdest) (the-as uint (allocate-blocks (-> *level* level-default texture-page-dir 9 page) 4)))
      (set! (-> gp-0 pad 0) (the-as uint s5-0))
      )
    )
  0
  (none)
  )

