;; og:preserve-this
;; The vocabulary the GOAL side uses to talk to the C++ texture animator. None of this is
;; retail data: the PS2 generated its animated textures straight into VRAM, so the PC port
;; needs an explicit hand-off instead.
;;
;; Codes 12-18 are jak3's values and MUST stay identical, because JakX shares jak3's decode
;; path (TextureAnimator.cpp: `case GameVersion::Jak3: case GameVersion::JakX:` decodes with
;; PcTextureAnimCodesJak3). Code 12 never reaches that switch at all: TextureUploadHandler
;; consumes it to open the animator block.
;;
;; jak3's 19-21 (move-rg-to-ba, set-clut-alpha, copy-clut-alpha) are deliberately absent.
;; They exist only in jak3's GOAL enum with no C++ counterpart, so emitting one would fall
;; to the switch's `default: ASSERT_NOT_REACHED()`. The same is true of jak3's animation
;; codes at 22+, which are jak3 content JakX does not have.
;;
;; clut-index-texture, ocean-sky and ocean are new for JakX and sit in the free gap
;; between jak3's 23 and 27. That gap is full now: this-way-arrow-02 (#110) is JakX-only
;; too, but jak3 owns 27-78 solid, so it sits at 79, right past jak3's own top code.
(defenum texture-anim-pc
  (start-anim-array 12)
  (finish-anim-array 13)
  (erase-and-init 14)
  (upload-clut-16-16 15) ;; fog clut upload
  (upload-generic-vram 16) ;; fog texture upload
  (set-shader 17)
  (draw 18)
  (clut-index-texture 24) ;; jakx-only: re-clut an extracted index texture, for the sky clouds
  (ocean-sky 25) ;; jakx-only: fixed anim for *sky-texture-anim-array* slot 3 ("ocean-sky-dest")
  (ocean 26) ;; jakx-only: fixed anim for *ocean-texture-anim-array* slot 0 ("ocean-dest")
  (this-way-arrow-02 79) ;; jakx-only: fixed anim for *this-way-water-texture-anim-array* slot 0 ("this-way-arrow-02-dest"), #110
  )

;; og:preserve-this
(deftype texture-anim-pc-upload (structure)
  ((data       pointer)
   (width      uint16)
   (height     uint16)
   (dest       uint32)
   (format     gs-psm)
   (force-to-gpu uint8)
   (pad        uint8 2)
   )
  :size-assert 16
  )

;; og:preserve-this
;; Payload of clut-index-texture. Mirrors JakXClutIndexInput in TextureAnimator.h; the two must
;; stay in step. itex-idx selects among the index textures setup_texture_anims_jakx resolved.
(deftype texture-anim-pc-clut-index (structure)
  ((itex-idx  int32)
   (dest-tbp  int32)
   (clut-tbp  int32)
   (pad       int32)
   )
  :size-assert 16
  )

;; og:preserve-this
(defmacro pc-texture-anim-flag (kind buf &key (qwc 0))
  `(dma-buffer-add-cnt-vif2
     ,buf
     ,qwc
     (new 'static 'vif-tag :cmd (vif-cmd pc-port) :imm (texture-anim-pc ,kind))
     (new 'static 'vif-tag)
     )
  )

;; og:preserve-this
(defmacro pc-texture-anim-flag-id (kind buf &key (qwc 0))
  `(dma-buffer-add-cnt-vif2
     ,buf
     ,qwc
     (new 'static 'vif-tag :cmd (vif-cmd pc-port) :imm ,kind)
     (new 'static 'vif-tag)
     )
  )

