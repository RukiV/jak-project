;; definition (debug) for function set-car-highlight!
;; WARN: Return type mismatch object vs none.
(defun-debug set-car-highlight! ((arg0 object) (arg1 object) (arg2 object))
  ;; og:preserve-this: gpr->fpr is a decompiler-only pseudo-op with no compiler
  ;; definition (goal_src/jakx/engine/gfx/mood/mood-funcs2.gc:480, the
  ;; "hand-converted gpr->fpr bit store" precedent); the-as already does the
  ;; same raw bit reinterpretation directly on the object-typed arg.
  (let ((v1-2 (-> *default-car-texture-anim-array* array-data 0 data 2)))
    (set! (-> v1-2 start-offset x) (the-as float arg0))
    (set! (-> v1-2 end-offset x) (the-as float arg0))
    (set! (-> v1-2 start-offset y) (the-as float arg1))
    (set! (-> v1-2 end-offset y) (the-as float arg1))
    (set! (-> v1-2 start-scale x) (the-as float arg2))
    (set! (-> v1-2 end-scale x) (the-as float arg2))
    (set! (-> v1-2 start-scale y) (the-as float arg2))
    (set! (-> v1-2 end-scale y) (the-as float arg2))
    )
  (none)
  )

;; definition for function update-car-texture-anim-array
(defun update-car-texture-anim-array ()
  (if (level-get *level* 'menu2)
      (set! (-> *default-car-texture-anim-array* array-data 0 num-layers) (the-as uint 3))
      (set! (-> *default-car-texture-anim-array* array-data 0 num-layers) (the-as uint 2))
      )
  0
  )

