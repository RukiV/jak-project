          :start-scale (new 'static 'vector2 :data (new 'static 'array float 2 1.0 1.0))
          :start-offset (new 'static 'vector2 :data (new 'static 'array float 2 0.5 0.5))
          :start-st-scale (new 'static 'vector2 :data (new 'static 'array float 2 1.0 1.0))
          :start-st-offset (new 'static 'vector2 :data (new 'static 'array float 2 1.0 0.5))
          :start-qs (new 'static 'vector :data (new 'static 'array float 4 1.0 1.0 1.0 1.0))
          :end-color (new 'static 'vector :data (new 'static 'array float 4 1.0 1.0 1.0 1.0))
          :end-scale (new 'static 'vector2 :data (new 'static 'array float 2 1.0 1.0))
          :end-offset (new 'static 'vector2 :data (new 'static 'array float 2 0.5 0.5))
          :end-st-scale (new 'static 'vector2 :data (new 'static 'array float 2 1.0 1.0))
          :end-st-offset (new 'static 'vector2 :data (new 'static 'array float 2 0.0 0.5))
          :end-qs (new 'static 'vector :data (new 'static 'array float 4 1.0 1.0 1.0 1.0))
          )
        )
      )
    )
  )

;; definition for function this-way-water-texture-anim-func
(defun this-way-water-texture-anim-func ((arg0 dma-buffer) (arg1 texture-anim))
  (when (not (paused?))
    (let ((gp-0 (-> arg1 data 0))
          (s4-0 (-> arg1 data 1))
          (s5-1 (-> arg1 data 2))
          )
      (cond
        ((= (-> gp-0 extra x) 0.0)
         (cond
           ((>= 0.0 (-> gp-0 extra y))
            (set! (-> gp-0 extra y) (rand-vu-float-range 150.0 300.0))
            (set! (-> gp-0 extra z) (-> gp-0 extra y))
            (set! (-> gp-0 extra w) (rand-vu-float-range 0.1 0.5))
            (set! (-> gp-0 extra x) 1.0)
            )
           (else
             (set! (-> gp-0 extra y) (- (-> gp-0 extra y) (* 300.0 (seconds-per-frame))))
             )
           )
         )
        ((= (-> gp-0 extra x) 1.0)
         (cond
           ((>= 0.0 (-> gp-0 extra y))
            (set! (-> gp-0 extra y) (rand-vu-float-range 300.0 600.0))
            (set! (-> gp-0 extra x) 0.0)
            )
           (else
             (let* ((f1-8 (+ 0.5 (* (-> gp-0 extra w) (sin (* 32768.0 (/ (-> gp-0 extra y) (-> gp-0 extra z)))))))
                    (f0-17 (- 1.5 f1-8))
                    )
               (set-vector! (-> gp-0 start-color) f0-17 f0-17 f0-17 1.0)
               (set-vector! (-> gp-0 end-color) f0-17 f0-17 f0-17 1.0)
               (set-vector! (-> s4-0 start-color) f1-8 f1-8 f1-8 1.0)
               (set-vector! (-> s4-0 end-color) f1-8 f1-8 f1-8 1.0)
               (set-vector! (-> s5-1 start-color) f0-17 f0-17 f0-17 1.0)
               (set-vector! (-> s5-1 end-color) f0-17 f0-17 f0-17 1.0)
               )
             (set! (-> gp-0 extra y) (- (-> gp-0 extra y) (* 300.0 (seconds-per-frame))))
             )
           )
         )
        )
      )
    )
  0
  )

;; definition for symbol *ocean-texture-anim-array*, type texture-anim-array
