;; definition for function ocean-texture-anim-time-func
;; WARN: Return type mismatch float vs int.
(defun ocean-texture-anim-time-func ((arg0 texture-anim) (arg1 texture-anim))
  (let ((f0-0 (-> *sky-texture-anim-array* array-data 3 frame-time)))
    (set! (-> arg0 frame-time) f0-0)
    (the-as int f0-0)
    )
  )




