                               ((method-of-type sky-work update-camera-matrix) (the-as sky-work s3-0) sv-16)
                               ((method-of-type sky-work setup-stars)
                                (the-as sky-work s3-0)
                                (-> (the-as sky-work s3-0) star-mat)
                                (-> this upload-data)
                                )
                               (if (nonzero? (-> (the-as sky-work s3-0) star-colors 0 x))
                                   (stars-transform-asm (the-as sky-work s3-0))
                                   )
                               (set-sky-vf27 (&-> this giftag-base quad))
                               (draw-roof (the-as sky-work s3-0) s2-0 sv-16)
                               (init-regs-for-sky-asm (the-as sky-work s3-0) sv-16)
                               (if (nonzero? (-> (the-as sky-work s3-0) star-colors 0 x))
                                   (stars-dma (the-as sky-work s3-0) s2-0 sv-16)
                                   )
                               ((method-of-type sky-work sun-dma) (the-as sky-work s3-0) s2-0 sv-16)
                               ((method-of-type sky-work green-sun-dma) (the-as sky-work s3-0) s2-0 sv-16)
                               ((method-of-type sky-work moon-dma) (the-as sky-work s3-0) s2-0 sv-16)
                               ((method-of-type sky-work draw-haze) (the-as sky-work s3-0) s2-0 sv-16)
                               (when *sky-clouds-clut-ready*
                                 ;; og:preserve-this The clut this pass samples is generated per
                                 ;; frame rather than baked, so the pass stays behind a define. It
                                 ;; is satisfied now that the animator has a jakx clut path; the
                                 ;; define remains as the switch to turn the pass off with.
                                 ((method-of-type sky-work draw-clouds) (the-as sky-work s3-0) s2-0 sv-16)
                                 )
                               (set-sky-vf27 (&-> this giftag-base quad))
                               ((method-of-type sky-work draw-base) (the-as sky-work s3-0) s2-0 sv-16)
                               (when (nonzero? *sky-texture-anim-array*)
                                 ;; og:preserve-this The fog generator's link check is gone now that
                                 ;; its PC port is landed. The array check stays: the fog quad draws
                                 ;; with tme on, so without a generated fog texture it would sample
                                 ;; whatever was last bound, fullscreen.
                                 ((method-of-type sky-work draw-fog) (the-as sky-work s3-0) s2-0 sv-16) ;; unbound: none-typed spill slot
                                 )
                               )
                             (view-pop-context)
                             )
                           )
                         )
                       )
                     )
                   )
                 (let ((v1-68 *dma-mem-usage*))
                   (when (nonzero? v1-68)
                     (set! (-> v1-68 length) (max 89 (-> v1-68 length)))
                     (set! (-> v1-68 data 88 name) "sky")
                     (+! (-> v1-68 data 88 count) 1)
                     (+! (-> v1-68 data 88 used)
                         (&- (-> *display* frames (-> *display* on-screen) global-buf base) (the-as uint s5-0))
                         )
                     (set! (-> v1-68 data 88 total) (-> v1-68 data 88 used))
                     )
                   )
                 )
               v0-23
               )
              (else
                (set! (-> *level* level-default texture-anim-array 9) #f)
                (with-dma-buffer-add-bucket ((v1-75 (-> *display* frames (-> *display* on-screen) global-buf))
                                             (bucket-id sky)
                                             )
                  (let ((a1-68 *time-of-day-context*)
                        (a0-60 (-> *viewport-array* default))
                        )
                    (dma-buffer-add-gs-set v1-75
                                           (zbuf-1 (-> a0-60 zbuf-on))
                                           (test-1 (new 'static 'gs-test :ate #x1 :atst (gs-atest always) :zte #x1 :ztst (gs-ztest always)))
                                           (rgbaq (new 'static 'gs-rgbaq
                                                    :q 1.0
                                                    :a (the int (-> a1-68 current-fog erase-color w))
                                                    :b (the int (-> a1-68 current-fog erase-color z))
                                                    :g (the int (-> a1-68 current-fog erase-color y))
                                                    :r (the int (-> a1-68 current-fog erase-color x))
                                                    )
                                                  )
                                           )
                    (let ((a1-75 (the-as object (-> v1-75 base))))
                      (set! (-> (the-as (pointer uint128) a1-75)) (-> this sprite-tmpl dma-vif quad))
                      (set! (-> (the-as (inline-array vector4w) a1-75) 1 quad) (-> this sprite-tmpl quad 1))
                      )
                    (&+! (-> v1-75 base) 32)
                    (let ((a1-78 (-> v1-75 base))
                          (a3-29 #x7000)
                          (t0-12 (* (-> a0-60 screen-maxx) 16))
                          (t1-16 #x7300)
                          (a0-62 (* (-> a0-60 screen-maxy) 16))
                          )
                      (let ((t2-9 (&+ a1-78 0)))
                        (set! (-> (the-as (pointer int32) t2-9)) a3-29)
                        (set! (-> (the-as (pointer uint32) t2-9) 1) (the-as uint t1-16))
                        (set! (-> (the-as (pointer uint32) t2-9) 2) (the-as uint 0))
                        (set! (-> (the-as (pointer uint32) t2-9) 3) (the-as uint 0))
                        )
                      (let ((a1-79 (&+ a1-78 16)))
                        (set! (-> (the-as (pointer int32) a1-79)) t0-12)
                        (set! (-> (the-as (pointer uint32) a1-79) 1) (the-as uint a0-62))
                        (set! (-> (the-as (pointer uint32) a1-79) 2) (the-as uint 0))
                        (set! (-> (the-as (pointer uint32) a1-79) 3) (the-as uint 0))
                        )
                      )
                    )
                  (&+! (-> v1-75 base) 32)
                  )
                )
              )
            )
      )
    0
    (none)
    )
  )




