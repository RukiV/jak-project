;;-*-Lisp-*-
(in-package goal)

;; name: sky-tng.gc
;; name in dgo: sky-tng
;; dgos: GAME

;; og:preserve-this landing notes (jak2 PC shape; jakx's sky matches jak2's
;; method numbering, not jak3's): the polygon pipeline and the heavy DMA
;; methods run as mips2c (see game/mips2c/jakx_functions/sky.cpp); the raw
;; .lvf vf27 loads become set-sky-vf27 and the vf23 constant becomes
;; set-sky-vf23-value, smuggling those registers into the C++ side's shared
;; sky_regs_vfs state. close-sky-buffer is hand-adapted (jr-ra delay slot).
;; the texture-anim leg lands *sky-texture-anim-array*, so the level slot and
;; the anim tex reads are live. draw-clouds and draw-fog are both armed now:
;; draw-clouds behind *sky-clouds-clut-ready* (satisfied, see the in-place note
;; at its call site below), draw-fog behind *sky-texture-anim-array* nonzero
;; (also satisfied; its in-place note is the current one). This note used to
;; say draw-fog stayed gated on real-fog-texture-anim-func until its C++ port
;; landed; that function is landed (texture-anim-funcs.gc:109, its own
;; bring-up guard already removed), so that claim is stale and retired here
;; per the fog audit (Q4 item 4, docs/2026-08-12-fog-state-audit.md).

;; DECOMP BEGINS

;; the C++ sky renderer keeps VF state between mips2c calls; these two setters
;; let the GOAL side hand it the giftag pointer and the vf23 constant
(define-extern *sky-texture-anim-array* texture-anim-array) ;; og:preserve-this: defined in texture-anim-tables.o (links later)
(def-mips2c set-sky-vf27 (function object none))
(def-mips2c set-sky-vf23-value (function int none))

;; og:preserve-this bring-up toggle, now satisfied: the clouds pass needs the
;; per-frame generated clut (make-cloud-clut density ramp), and the C++ animator
;; grew a jakx clut path (clut-index-texture, re-cluts the extracted 'clouds'
;; index texture and publishes it at the dest tbp this pass samples).
(define *sky-clouds-clut-ready* #t)

;; og:preserve-this PC helper ported from jak2 (jakx baselines are identical:
;; -267/267, -126/126, -357/357, -1207/1207, -232/232): rescale the sprite
;; x-coords from their retail constants so the sky sprites stay round on wide
;; aspect ratios. jak2 gates on (-> *pc-settings* use-vis?); pckernel is not
;; landed on the bring-up, so the scale always applies.
(defun update-pc-sky-scaling ()
  (let ((scale-factor (-> *video-params* relative-x-scale)))
    (set! (-> *sky-work* sun-coords 0 x) (* scale-factor -267.0))
    (set! (-> *sky-work* sun-coords 1 x) (* scale-factor 267.0))
    (set! (-> *sky-work* green-coords 0 x) (* scale-factor -126.0))
    (set! (-> *sky-work* green-coords 1 x) (* scale-factor 126.0))
    (set! (-> *sky-work* moon0-coords 0 x) (* scale-factor -357.0))
    (set! (-> *sky-work* moon0-coords 1 x) (* scale-factor 357.0))
    (set! (-> *sky-work* moon1-coords 0 x) (* scale-factor -1207.0))
    (set! (-> *sky-work* moon1-coords 1 x) (* scale-factor 1207.0))
    (set! (-> *sky-work* moon2-coords 0 x) (* scale-factor -232.0))
    (set! (-> *sky-work* moon2-coords 1 x) (* scale-factor 232.0))
    )
  (none)
  )

