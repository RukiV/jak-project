(defmethod cloud-vtx1-to-sky ((this sky-work) (arg0 sky-vertex) (arg1 cloud-vertex))
  (set! (-> arg0 pos quad) (-> arg1 pos quad))
  (set! (-> arg0 stq quad) (-> arg1 stq quad))
  (set! (-> arg0 col quad) (-> arg1 col quad))
  0
