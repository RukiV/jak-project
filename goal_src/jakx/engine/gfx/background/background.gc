;;-*-Lisp-*-
(in-package goal)

;; name: background.gc
;; name in dgo: background
;; dgos: ENGINE, GAME

;; og:preserve-this landing notes: the finish-* family is DORMANT until the per-frame
;; draw hook calls land (main.gc real-main-draw-hook) and the tree draw objects
;; (tfrag.o / tfrag-methods.o / tie.o / shrub.o) populate *background-work*, so the
;; unlanded draw-drawable-tree-* callees are safe unguarded for now. jakx deltas vs
;; jak3: per-view math camera getters, the shared-tree families in background-work,
;; and per-view matrix selects in finish-tie.
(define-extern *instance-tie-work* instance-tie-work) ;; home tie-work.gc (compiles later)
(define-extern *prototype-tie-work* prototype-tie-work) ;; home tie-work.gc (compiles later)
(define-extern *instance-shrub-work* instance-shrub-work) ;; home shrub-work.gc (compiles later)
(define-extern *draw-index* int)
;; og:preserve-this runtime-link externs: the tree draw generators live in the
;; unlanded tfrag.o / tie.o / shrub.o; the finishers that call them stay dormant
;; until the per-frame draw hook lands, so unguarded calls are safe for now
(define-extern draw-drawable-tree-instance-shrub (function drawable-tree-instance-shrub level none))
(define-extern draw-drawable-tree-instance-tie (function drawable-tree-instance-tie level none))
(define-extern draw-drawable-tree-tfrag (function drawable-tree-tfrag none))
(define-extern draw-drawable-tree-tfrag-trans (function drawable-tree-tfrag none))
(define-extern draw-drawable-tree-tfrag-water (function drawable-tree-tfrag none))
(define-extern tie-scissor-make-perspective-matrix (function matrix matrix none))
(define-extern level-update-wind (function wind-work none)) ;; home wind.gc, not landed
(define-extern tfrag-vu1-init-buffers (function none)) ;; home tfrag.gc, not landed
(define-extern *wind-work* wind-work) ;; home wind-work.gc (compiles later)

(defun add-pc-tfrag3-data ((dma-buf dma-buffer) (lev level) (imm int))
  "Add PC-port specific tfrag data"
  (let ((packet (the-as dma-packet (-> dma-buf base))))
    (set! (-> packet dma) (new 'static 'dma-tag :id (dma-tag-id cnt) :qwc 25))
    (set! (-> packet vif0) (new 'static 'vif-tag))
    (set! (-> packet vif1) (new 'static 'vif-tag :cmd (vif-cmd pc-port) :imm imm))
    (set! (-> dma-buf base) (the pointer (&+ packet 16)))
    )

  ;; first 4 quadwords are planes, then itimes
  (let ((data-ptr (the-as (pointer uint128) (-> dma-buf base)))
        (vec-ptr (the-as (inline-array vector) (-> dma-buf base)))
        (math-cam (view-get-active-math-camera))
        )
    ;; the "use-camera-other" flag is set to "move" entire levels.
    (cond
      ((logtest? (-> lev info level-flags) (level-flags use-camera-other))
        (set! (-> data-ptr 0) (-> math-cam plane-other 0 quad))
        (set! (-> data-ptr 1) (-> math-cam plane-other 1 quad))
        (set! (-> data-ptr 2) (-> math-cam plane-other 2 quad))
        (set! (-> data-ptr 3) (-> math-cam plane-other 3 quad))
        (set! (-> data-ptr 4) (-> lev mood-context itimes 0 quad))
        (set! (-> data-ptr 5) (-> lev mood-context itimes 1 quad))
        (set! (-> data-ptr 6) (-> lev mood-context itimes 2 quad))
        (set! (-> data-ptr 7) (-> lev mood-context itimes 3 quad))
        (set! (-> data-ptr 8) (-> math-cam camera-temp-other vector 0 quad))
        (set! (-> data-ptr 9) (-> math-cam camera-temp-other vector 1 quad))
        (set! (-> data-ptr 10) (-> math-cam camera-temp-other vector 2 quad))
        (set! (-> data-ptr 11) (-> math-cam camera-temp-other vector 3 quad))
        (set! (-> data-ptr 12) (-> math-cam hvdf-off quad))
        (let ((vec (-> (the (inline-array vector) data-ptr) 13)))
          (set! (-> vec x) (-> math-cam pfog0))
          (set! (-> vec y) (-> math-cam fog-min))
          (set! (-> vec z) (-> math-cam fog-max))
          )
        ;; pull the translation from inv-camera-rot-other, like jak3's PC port.
        (set! (-> data-ptr 14) (-> math-cam inv-camera-rot-other vector 3 quad))
        (set! (-> vec-ptr 14 w) 1.0)

        (set! (-> data-ptr 15) (-> math-cam camera-rot-other vector 0 quad))
        (set! (-> data-ptr 16) (-> math-cam camera-rot-other vector 1 quad))
        (set! (-> data-ptr 17) (-> math-cam camera-rot-other vector 2 quad))
        (set! (-> data-ptr 18) (-> math-cam camera-rot-other vector 3 quad))

        (set! (-> data-ptr 19) (-> math-cam perspective vector 0 quad))
        (set! (-> data-ptr 20) (-> math-cam perspective vector 1 quad))
        (set! (-> data-ptr 21) (-> math-cam perspective vector 2 quad))
        (set! (-> data-ptr 22) (-> math-cam perspective vector 3 quad))
        )
      (else
        (set! (-> data-ptr 0) (-> math-cam plane 0 quad))
        (set! (-> data-ptr 1) (-> math-cam plane 1 quad))
        (set! (-> data-ptr 2) (-> math-cam plane 2 quad))
        (set! (-> data-ptr 3) (-> math-cam plane 3 quad))
        (set! (-> data-ptr 4) (-> lev mood-context itimes 0 quad))
        (set! (-> data-ptr 5) (-> lev mood-context itimes 1 quad))
        (set! (-> data-ptr 6) (-> lev mood-context itimes 2 quad))
        (set! (-> data-ptr 7) (-> lev mood-context itimes 3 quad))
        (set! (-> data-ptr 8) (-> math-cam camera-temp vector 0 quad))
        (set! (-> data-ptr 9) (-> math-cam camera-temp vector 1 quad))
        (set! (-> data-ptr 10) (-> math-cam camera-temp vector 2 quad))
        (set! (-> data-ptr 11) (-> math-cam camera-temp vector 3 quad))
        (set! (-> data-ptr 12) (-> math-cam hvdf-off quad))
        (let ((vec (-> (the (inline-array vector) data-ptr) 13)))
          (set! (-> vec x) (-> math-cam pfog0))
          (set! (-> vec y) (-> math-cam fog-min))
          (set! (-> vec z) (-> math-cam fog-max))
          )
        ;; use the camera-trans used to derive the camera matrix.
        (set! (-> data-ptr 14) (-> math-cam trans quad))

        (set! (-> data-ptr 15) (-> math-cam camera-rot vector 0 quad))
        (set! (-> data-ptr 16) (-> math-cam camera-rot vector 1 quad))
        (set! (-> data-ptr 17) (-> math-cam camera-rot vector 2 quad))
        (set! (-> data-ptr 18) (-> math-cam camera-rot vector 3 quad))

        (set! (-> data-ptr 19) (-> math-cam perspective vector 0 quad))
        (set! (-> data-ptr 20) (-> math-cam perspective vector 1 quad))
        (set! (-> data-ptr 21) (-> math-cam perspective vector 2 quad))
        (set! (-> data-ptr 22) (-> math-cam perspective vector 3 quad))
        )
      )

    ;; og:preserve-this bring-up fallback: the mood system is not landed, so the level's
    ;; mood-context itimes are zero, which weights every time-of-day palette slot to zero
    ;; and multiplies all vertex colors to black. Substitute full weight (#x40) on every
    ;; slot: dark slots contribute nothing, so this reproduces the lit palette for
    ;; single-lit-slot interiors. Retire with the mood landing.
    (when (and (zero? (-> (the-as (pointer int32) (&-> data-ptr 4)) 0))
               (zero? (-> (the-as (pointer int32) (&-> data-ptr 5)) 0))
               (zero? (-> (the-as (pointer int32) (&-> data-ptr 6)) 0))
               (zero? (-> (the-as (pointer int32) (&-> data-ptr 7)) 0))
               )
      (dotimes (qi 4)
        (let ((wp (the-as (pointer int32) (&-> data-ptr (+ 4 qi)))))
          (dotimes (wi 4)
            (set! (-> wp wi) #x00400040)
            )
          )
        )
      )

    (copyn-charp<-string (the (pointer uint8) (&-> data-ptr 23)) (symbol->string (bsp-name lev)) 32)
    )
  (&+! (-> dma-buf base) (* 16 25))
  )

;; DECOMP BEGINS

