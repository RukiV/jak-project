;; definition for function finish-tie
;; INFO: Used lq/sq
;; WARN: Return type mismatch int vs none.
(defun finish-tie ()
  (let ((gp-0 (the-as level #f)))
    (-> *viewport-array* current-viewport-index)
    (when (nonzero? (-> *background-work* tie-tree-count))
      (set! (-> *instance-tie-work* tod-env-color quad) (-> *time-of-day-context* current-env-color quad))
      (when *debug-segment*
        'tie
        (let ((s4-0 (-> *display* frames (-> *display* on-screen) profile-array data 0))
              (v1-14 'tie)
              (s3-0 *profile-tie-color*)
              )
          (when (and *dproc* *debug-segment*)
            (let ((s2-0 (-> s4-0 data (-> s4-0 count))))
              (let ((s1-0 (-> s4-0 base-time)))
                (set! (-> s2-0 name) v1-14)
                (set! (-> s2-0 start-time) (the-as int (- (timer-count (the-as timer-bank #x10000800)) (the-as uint s1-0))))
                )
              (set! (-> s2-0 depth) (the-as uint (-> s4-0 depth)))
              (set! (-> s2-0 color) s3-0)
              (set! (-> s4-0 segment (-> s4-0 depth)) s2-0)
              )
            (set! (-> s4-0 count) (min 2099 (+ (-> s4-0 count) 1)))
            (+! (-> s4-0 depth) 1)
            (set! (-> s4-0 max-depth) (max (-> s4-0 max-depth) (-> s4-0 depth)))
            )
          )
        0
        )
      (dotimes (s4-1 (-> *background-work* tie-tree-count))
        (let ((s2-1 (-> *background-work* tie-levels s4-1)))
          (let ((s1-1 (-> s2-1 bsp))
                (s3-1 (view-get-active-math-camera))
                )
            (when (!= s2-1 gp-0)
              (upload-vis-bits s2-1 gp-0 s1-1)
              (set-subdivide-settings! s2-1)
              (set! gp-0 s2-1)
              (set! *draw-index* (-> s2-1 draw-index))
              (set! (-> *prototype-tie-work* mood) (-> s2-1 mood-context))
              )
            (set-background-regs! s2-1)
            (set-tie-guard-planes! s2-1)
            ;; og:preserve-this runtime-link guard: tie-scissor-make-perspective-matrix's
            ;; home (tie-near.o asm) is not landed, so the symbol links as 0. The scissor
            ;; path is PS2-only on the PC port anyway.
            (if (nonzero? tie-scissor-make-perspective-matrix)
                (tie-scissor-make-perspective-matrix
                  (-> *instance-tie-work* tie-scissor-perspective-matrix)
                  (if (logtest? (-> s2-1 info level-flags) (level-flags use-camera-other))
                      (-> s3-1 camera-temp-other)
                      (-> s3-1 camera-temp)
                      )
                  )
                )
            )
          (let ((s3-2 (-> *display* frames (-> *display* on-screen) global-buf base)))
            (draw-drawable-tree-instance-tie (-> *background-work* tie-trees s4-1) s2-1)
            (let ((v1-44 *dma-mem-usage*))
              (when (nonzero? v1-44)
                (set! (-> v1-44 length) (max 10 (-> v1-44 length)))
                (set! (-> v1-44 data 9 name) "tie-fragment")
                (+! (-> v1-44 data 9 count) 1)
                (+! (-> v1-44 data 9 used)
                    (&- (-> *display* frames (-> *display* on-screen) global-buf base) (the-as uint s3-2))
                    )
                (set! (-> v1-44 data 9 total) (-> v1-44 data 9 used))
                )
              )
            )
          )
        )
      (when *debug-segment*
        (let ((gp-1 (-> *display* frames (-> *display* on-screen) profile-array data 0)))
          (when (and *dproc* *debug-segment*)
            (let* ((v1-60 (+ (-> gp-1 depth) -1))
                   (s5-1 (-> gp-1 segment v1-60))
                   (s4-2 (-> gp-1 base-time))
                   )
              (when (>= v1-60 0)
                (set! (-> s5-1 end-time) (the-as int (- (timer-count (the-as timer-bank #x10000800)) (the-as uint s4-2))))
                (+! (-> gp-1 depth) -1)
                )
              )
            )
          )
        0
        )
      )
    )
  ;; og:preserve-this bring-up stub: prototype-node-group m14 is not landed yet
  ;; (prototype.gc has only m9/m13), so this dispatches through a 0 method slot.
  ;; Restore with the tie landing.
  ;; (prototype-node-group-method-14 (-> *level* shared-ties))
  (let ((a0-30 (-> *display* frames (-> *display* on-screen) global-buf)))
    (when (< (-> a0-30 real-buffer-end) (the-as int (-> a0-30 base)))
      (break!)
      0
      )
    )
  0
  (none)
  )

;; definition for function finish-texture-mask
(defun finish-texture-mask ((arg0 texture-masks) (arg1 texture-masks-array) (arg2 (pointer float)) (arg3 float) (arg4 int))
  (when (nonzero? arg1)
    (dotimes (v1-0 (-> arg1 length))
      (let ((t1-3 (-> arg1 data v1-0))
            (f0-1 (* (-> arg2 v1-0) arg3))
            )
        (when (and (= (-> t1-3 level) arg4) (!= f0-1 4095996000.0))
          (dotimes (t2-6 3)
            (when (or (= t2-6 2) (>= f0-1 (-> t1-3 data t2-6 dist)))
              (logior! (-> arg0 data 0 mask dword 0) (-> t1-3 data t2-6 mask dword 0))
              (set! (-> arg0 level) (the-as basic (logior (the-as int (-> arg0 level)) (-> t1-3 data t2-6 mask z))))
              (goto cfg-18)
              )
            )
          )
        )
      (label cfg-18)
      )
    #f
    )
  )

;; definition for function finish-texture
;; INFO: Used lq/sq
;; WARN: Return type mismatch int vs none.
(defun finish-texture ()
  (let ((f30-0 (-> (view-get-active-math-camera) fov-correction-factor)))
    (dotimes (gp-0 (-> *level* length))
      (let ((s5-0 (-> *level* level gp-0)))
        (when (= (-> s5-0 status) 'active)
          (let ((s4-0 (-> s5-0 bsp)))
            (dotimes (s3-0 6)
              (let ((v1-8 (-> *level* level s3-0)))
                (when (or (= (-> v1-8 status) 'active) (= (-> v1-8 status) 'reserved))
                  (let ((s2-0 (-> v1-8 bsp)))
                    (finish-texture-mask
                      (the-as texture-masks (-> s5-0 texture-mask))
                      (-> s2-0 tfrag-masks)
                      (-> s2-0 tfrag-closest)
                      f30-0
                      (the-as int s5-0)
                      )
                    (finish-texture-mask
                      (the-as texture-masks (-> s5-0 texture-mask 3))
                      (-> s2-0 alpha-masks)
                      (-> s2-0 alpha-closest)
                      f30-0
                      (the-as int s5-0)
                      )
                    (finish-texture-mask
                      (the-as texture-masks (-> s5-0 texture-mask 4))
                      (-> s2-0 water-masks)
                      (-> s2-0 water-closest)
                      f30-0
                      (the-as int s5-0)
                      )
                    )
                  )
                )
              )
            (finish-texture-mask
              (the-as texture-masks (-> s5-0 texture-mask 2))
              (-> s4-0 shrub-masks)
              (-> s4-0 shrub-closest)
              f30-0
              (the-as int s5-0)
              )
            )
          (dotimes (v1-12 7)
            (let* ((a0-14 (the-as object (-> s5-0 texture-mask v1-12)))
                   (t0-4 (the-as (pointer uint128) (-> s5-0 texture-mask (+ v1-12 11))))
                   (t1-0 (-> (the-as (pointer uint128) a0-14) 0))
                   (t2-0 (-> t0-4 0))
                   (a2-4 (-> (the-as (pointer uint128) a0-14) 1))
                   (a3-4 (-> t0-4 1))
                   (a1-10 (-> (the-as (pointer uint128) a0-14) 2))
                   (t0-5 (-> t0-4 2))
                   (t1-1 (logior t1-0 t2-0))
                   (a2-5 (logior a2-4 a3-4))
                   (a1-11 (logior a1-10 t0-5))
                   )
              (set! (-> (the-as (pointer uint128) a0-14) 0) t1-1)
              (set! (-> (the-as (pointer uint128) a0-14) 1) a2-5)
              (set! (-> (the-as (pointer uint128) a0-14) 2) a1-11)
              )
            )
          )
        )
      )
    )
  0
  (none)
  )

;; og:preserve-this ported from jak3's add-pc-camera-data (goal_src/jak3/engine/gfx/
;; background/background.gc:257-304); jakx's math-camera-h.gc has the same fields this
;; reads (plane, camera-temp, hvdf-off, pfog0/fog-min/fog-max, trans, camera-rot,
;; perspective). The one required delta: jak3 reads the single global *math-camera*,
;; which jakx does not have; jakx replaced it with per-view math-camera getters (see
;; this file's own top-of-file note and every other reader in this file, e.g.
;; set-tie-guard-planes! at :213, set-subdivide-settings! at :257), so this reads
;; (view-get-active-math-camera) instead, matching that established idiom.
(defun add-pc-camera-data ((dma-buf dma-buffer))
  "Add PC-port specific camera data. used as fallback for collide mesh renderer.
   Same as add-pc-trag3-data but level-specific data is left undefined."
  (let ((packet (the-as dma-packet (-> dma-buf base))))
    (set! (-> packet dma) (new 'static 'dma-tag :id (dma-tag-id cnt) :qwc 25))
    (set! (-> packet vif0) (new 'static 'vif-tag))
    (set! (-> packet vif1) (new 'static 'vif-tag :cmd (vif-cmd pc-port)))
    (set! (-> dma-buf base) (the pointer (&+ packet 16)))
    )

  ;; first 4 quadwords are planes, then itimes
  (let ((data-ptr (the-as (pointer uint128) (-> dma-buf base)))
        (cam (view-get-active-math-camera)))
    ;; the "use-camera-other" flag is set to "move" entire levels,
    ;; like the rotating city below in the throne room.
    (set! (-> data-ptr 0) (-> cam plane 0 quad))
    (set! (-> data-ptr 1) (-> cam plane 1 quad))
    (set! (-> data-ptr 2) (-> cam plane 2 quad))
    (set! (-> data-ptr 3) (-> cam plane 3 quad))
    ;; (set! (-> data-ptr 4) (-> lev mood-context itimes 0 quad))
    ;; (set! (-> data-ptr 5) (-> lev mood-context itimes 1 quad))
    ;; (set! (-> data-ptr 6) (-> lev mood-context itimes 2 quad))
    ;; (set! (-> data-ptr 7) (-> lev mood-context itimes 3 quad))
    (set! (-> data-ptr 8) (-> cam camera-temp vector 0 quad))
    (set! (-> data-ptr 9) (-> cam camera-temp vector 1 quad))
    (set! (-> data-ptr 10) (-> cam camera-temp vector 2 quad))
    (set! (-> data-ptr 11) (-> cam camera-temp vector 3 quad))
    (set! (-> data-ptr 12) (-> cam hvdf-off quad))
    (let ((vec (-> (the (inline-array vector) data-ptr) 13)))
      (set! (-> vec x) (-> cam pfog0))
      (set! (-> vec y) (-> cam fog-min))
      (set! (-> vec z) (-> cam fog-max))
      )
    (set! (-> data-ptr 14) (-> cam trans quad))

    (set! (-> data-ptr 15) (-> cam camera-rot vector 0 quad))
    (set! (-> data-ptr 16) (-> cam camera-rot vector 1 quad))
    (set! (-> data-ptr 17) (-> cam camera-rot vector 2 quad))
    (set! (-> data-ptr 18) (-> cam camera-rot vector 3 quad))

    (set! (-> data-ptr 19) (-> cam perspective vector 0 quad))
    (set! (-> data-ptr 20) (-> cam perspective vector 1 quad))
    (set! (-> data-ptr 21) (-> cam perspective vector 2 quad))
    (set! (-> data-ptr 22) (-> cam perspective vector 3 quad))

    (charp<-string (the (pointer uint8) (&-> data-ptr 23)) (symbol->string #f))
    )
  (&+! (-> dma-buf base) (* 16 25))
  )

;; og:preserve-this the pc vis protocol's real ceiling, not jakx's own GOAL-side
;; LEVEL_MAX (18, level-h.gc:9). VisDataHandler::m_stats is a fixed
;; LevelStats[kMaxLevels] with kMaxLevels = 10 (game/graphics/opengl_renderer/
;; VisDataHandler.h:20-21), written unconditionally for every entry
;; OpenGLRenderer.cpp's dispatch_buckets_jak3 tells it to expect (num_vis_to_copy);
;; walking 18 draw-level slots wrote 8 entries past that array every frame the bucket
;; carried data. common/goal_constants.h's jakx::LEVEL_MAX (10, common/
;; goal_constants.h:78) happens to already equal this value, but that is a stale jak3
;; copy nothing here reads (per the prior rung's finding), not this constant's source
;; of truth - it is derived from VisDataHandler's kMaxLevels, not from that header.
(defconstant PC_VIS_LEVEL_MAX 10)

;; og:preserve-this ported from jak3's add-pc-port-background-data (goal_src/jak3/engine/
;; gfx/background/background.gc:306-371), called from finish-background the same way jak3
;; calls it from its own finish-background (goal_src/jak3/engine/gfx/background/
;; background.gc:377-378). Three deltas from jak3's shape, all forced by jakx's own
;; structure:
;;  - the draw-level walk bound is PC_VIS_LEVEL_MAX (10), not (-> *level* length) like
;;    jak3 uses. jak3 can walk its own *level* length directly because it evaluates to
;;    10 there (jak3's *level* level-group :length 10, jak3/engine/level/level-h.gc:510)
;;    which already matches VisDataHandler::kMaxLevels (VisDataHandler.h:20, 10). jakx's
;;    *level* length is 18 (jakx's level-group :length 18, level-h.gc:1018, matching
;;    LEVEL_MAX 18 at level-h.gc:9, because jakx's draw-level array itself is bigger:
;;    level x 19, level-h.gc:875, vs jak3's level x 11, jak3/engine/level/level-h.gc:462),
;;    which overflows what the PC vis protocol can carry (see PC_VIS_LEVEL_MAX's own
;;    comment above). OpenGLRenderer.cpp's num_vis_to_copy must track the same 10 (see
;;    the comment there). Levels living in draw-level slots 10-17 do not get vis-bits
;;    transferred to the PC renderer under this bring-up; that is the accepted bound,
;;    not a bug, until the PC vis protocol itself grows past kMaxLevels.
;;  - jakx's level carries two vis-bits buffers, one per viewport ((vis-bits pointer 2),
;;    level-h.gc:636, allocated level.gc:4001-4002), where jak3's level has a single
;;    vis-bits pointer (jak3/engine/level/level-h.gc, no viewport index). This bring-up
;;    only drives viewport 0's buffer; retire the hardcoded 0 index once split-screen
;;    rendering lands and both viewports need feeding.
;;  - jakx gates the real vis-bits copy on the level actually having loaded vis data;
;;    see the og:preserve-this note at the cond below (issue #41).
(defun add-pc-port-background-data ((dma-buf dma-buffer))
  "PC Port added"
  ;; loop over levels
  (dotimes (lev-idx PC_VIS_LEVEL_MAX)
    (let ((lev (-> *level* draw-level lev-idx))
          (dma-start (-> dma-buf base)))
      (cond
        ((and lev (= (-> lev status) 'active) (not *artist-all-visible*) (-> lev vis-info 0)
              (!= (-> lev all-visible?) 'loading))
         ;; the level is active and has real vis data loaded.
         (let ((packet (the-as dma-packet (-> dma-buf base))))
           (set! (-> packet dma) (new 'static 'dma-tag :id (dma-tag-id cnt) :qwc 128))
           (set! (-> packet vif0) (the-as vif-tag *fog-color*))
           (set! (-> packet vif1) (new 'static 'vif-tag :cmd (vif-cmd pc-port)))
           (set! (-> dma-buf base) (the pointer (&+ packet 16)))
           )
         ;; og:preserve-this viewport 0 only; see the function-level note above.
         (quad-copy! (-> dma-buf base) (-> lev vis-bits 0) 128)
         (&+! (-> dma-buf base) (* 16 128))
         )
        (else
          ;; og:preserve-this (issue #41) this else now also catches active levels gated
          ;; out by the clause above, not just genuinely inactive ones. jakx never loads
          ;; .VIS files (jak1-only; the PVS lives inside each bsp) and since the #41 leg
          ;; the real vis-string path (cam-update.gc:158-185) is live: vis-bits hold real
          ;; per-leaf occlusion when the camera resolves inside a leaf. Levels can still
          ;; take the forced-visible fallback at cam-update.gc:152, gated
          ;; on (or *artist-all-visible* (not (-> lev vis-info 0))) - the exact condition
          ;; negated in the clause above. That fallback also is not guaranteed to have run
          ;; for a level at all yet: vis-bits is malloc'd, not zero-initialized
          ;; (level.gc:3989-4013), so an untouched buffer is raw heap content, and levels
          ;; in slots 6-17 share a single vis-bits allocation across whichever of them is
          ;; active (level.gc:4007-4012). Sending any of that to the PC renderer as if it
          ;; were real occlusion would mark it valid (VisDataHandler.cpp:64) with content
          ;; jakx cannot vouch for; the zero packet below keeps
          ;; occlusion_vis[lev-idx].valid false instead, which Hfrag.cpp:90,
          ;; TFragment.cpp:159 and Tie3.cpp:359 all already check before trusting
          ;; occlusion_vis, so rendering falls back to its current unoccluded state
          ;; instead of the black-frame failure #41 documents for the GOAL side:
          ;; valid-and-all-zero culls every drawable. The camera packet below this loop
          ;; (add-pc-camera-data) is unaffected and still runs every frame for fog color.
          ;; Retire the "or" against *artist-all-visible* / vis-info in the clause above
          ;; once #41 lands real .VIS loading and *artist-all-visible* reverts to its
          ;; retail default; this else then goes back to covering only genuinely inactive
          ;; levels, matching jak3.
          ;;
          ;; Since #153, the clause above also gates on all-visible? != 'loading, closing
          ;; a second sticky-loading trap distinct from the one above: a level that
          ;; activates and displays while the camera has never resolved inside its own
          ;; bsp boxes keeps all-visible? pinned at vis-clear's 'loading forever
          ;; (level.gc:390, 399), because update-visible's own two exits both require
          ;; conditions this level never reaches - the forced-visible arm at
          ;; cam-update.gc:154 is blocked since (-> lev vis-info 0) is true, and the
          ;; vis-valid arm at cam-update.gc:160-191 is gated on inside-boxes? at
          ;; cam-update.gc:152, which a level the camera has never entered never
          ;; satisfies; the (and (= all-visible? 'loading) play?) arm at
          ;; cam-update.gc:192 is an empty body, so 'loading just persists. Before #153,
          ;; that stuck level still satisfied the clause above (active, not
          ;; artist-all-visible, vis-info present) and got the real 128-quadword packet
          ;; built from vis-bits still at vis-clear's zeros, which VisDataHandler.cpp:64
          ;; marks valid on presence alone regardless of content: background gone, actors
          ;; still drawn, since the birth pass at entity.gc:788 treats truthy
          ;; all-visible? (which 'loading is) as all-visible. Retail never reaches this
          ;; state because its continue system only displays a level through an authored
          ;; want-display trigger volume the player has physically walked into, so
          ;; all-visible? has already resolved off 'loading by the time anything draws;
          ;; the bring-up want driver displays by continue proximity alone and can
          ;; activate a level the camera has never set foot in. (Falsified along the way:
          ;; a cross-level vis-data hypothesis, since jak1's .VIS files blended
          ;; visibility across regions - but that mechanism was deleted since Jak II, and
          ;; jakx's vis-info is entirely self-only per level, so no other level's state
          ;; could be involved.) Retire this conjunct once the want driver gains
          ;; trigger-volume fidelity or the retail continue system lands, either of which
          ;; keeps a never-entered level from displaying in the first place.
          (let ((packet (the-as dma-packet (-> dma-buf base))))
            (set! (-> packet dma) (new 'static 'dma-tag :id (dma-tag-id cnt) :qwc 1))
            (set! (-> packet vif0) (the-as vif-tag *fog-color*))
            (set! (-> packet vif1) (new 'static 'vif-tag :cmd (vif-cmd pc-port)))
            (set! (-> dma-buf base) (the pointer (&+ packet 16)))
            )
          (set! (-> (the (pointer uint128) (-> dma-buf base))) (the uint128 0))
          (&+! (-> dma-buf base) (* 16 1))
          )
        )


      (let ((a3-3 (-> dma-buf base)))
        (let ((v1-38 (the-as object (-> dma-buf base))))
          (set! (-> (the-as dma-packet v1-38) dma) (new 'static 'dma-tag :id (dma-tag-id next)))
          (set! (-> (the-as dma-packet v1-38) vif0) (new 'static 'vif-tag))
          (set! (-> (the-as dma-packet v1-38) vif1) (new 'static 'vif-tag))
          (set! (-> dma-buf base) (&+ (the-as pointer v1-38) 16))
          )
        (dma-bucket-insert-tag (-> *display* frames (-> *display* on-screen) bucket-group)
                               (bucket-id bucket2)
                               dma-start
                               (the-as (pointer dma-tag) a3-3)
                               )
        )
      )
    )
  (let* ((dma-buff (-> *display* frames (-> *display* on-screen) global-buf))
         (dma-start (-> dma-buff base)))
    (add-pc-camera-data dma-buff)
    (let ((a3-22 (-> dma-buff base)))
      (let ((v1-57 (the-as object (-> dma-buff base))))
        (set! (-> (the-as dma-packet v1-57) dma) (new 'static 'dma-tag :id (dma-tag-id next)))
        (set! (-> (the-as dma-packet v1-57) vif0) (new 'static 'vif-tag))
        (set! (-> (the-as dma-packet v1-57) vif1) (new 'static 'vif-tag))
        (set! (-> dma-buff base) (&+ (the-as pointer v1-57) 16))
        )
      (dma-bucket-insert-tag
        (-> *display* frames (-> *display* on-screen) bucket-group)
        (bucket-id bucket2)
        dma-start
        (the-as (pointer dma-tag) a3-22)
        )
      )
    )
  (the-as pointer 0)
  )

;; definition for function finish-background
;; WARN: Return type mismatch int vs none.
(defun finish-background ()
  (#when PC_PORT
    (add-pc-port-background-data
      (-> *display* frames (-> *display* on-screen) global-buf)
      )
    )

  (when (not (paused?))
    (flush-cache 0)
    (dotimes (gp-0 (-> *level* length))
      (let ((v1-4 (-> *level* level gp-0)))
        (when (= (-> v1-4 status) 'active)
          (-> v1-4 bsp wind-array)
          ;; og:preserve-this runtime-link guard: level-update-wind's home (wind.gc)
          ;; is not landed yet, so the symbol links as 0 until it is
          (if (and (nonzero? (-> v1-4 bsp wind-array-length)) (nonzero? level-update-wind))
              (level-update-wind *wind-work*)
              )
          )
        )
      )
    )
  (background-upload-vu0)
  (dotimes (v1-10 (-> *level* length))
    (let ((a0-11 (-> *level* level v1-10)))
      (when (= (-> a0-11 status) 'active)
        (let ((a0-12 (-> a0-11 bsp)))
          (when (nonzero? (-> a0-12 tfrag-masks))
            (dotimes (a1-7 (-> a0-12 tfrag-masks length))
              (set! (-> a0-12 tfrag-closest a1-7) 4095996000.0)
              )
            )
          (when (nonzero? (-> a0-12 shrub-masks))
            (dotimes (a1-12 (-> a0-12 shrub-masks length))
              (set! (-> a0-12 shrub-closest a1-12) 4095996000.0)
              )
            )
          (when (nonzero? (-> a0-12 alpha-masks))
            (dotimes (a1-17 (-> a0-12 alpha-masks length))
              (set! (-> a0-12 alpha-closest a1-17) 4095996000.0)
              )
            )
          (when (nonzero? (-> a0-12 water-masks))
            (dotimes (a1-22 (-> a0-12 water-masks length))
              (set! (-> a0-12 water-closest a1-22) 4095996000.0)
              )
            )
          )
        )
      )
    )
  (finish-shrub)
  (finish-tfrag)
  (finish-tfrag-trans)
  (finish-tfrag-water)
  (tfrag-vu1-init-buffers)
  (finish-tie)
  (finish-texture)
  0
  (none)
  )




