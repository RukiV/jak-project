;; definition for function init-background
;; WARN: Return type mismatch int vs none.
(defun init-background ()
  (dotimes (v1-0 8)
    (set! (-> *background-work* tfrag-trees v1-0) #f)
    (set! (-> *background-work* tfrag-trans-trees v1-0) #f)
    (set! (-> *background-work* tfrag-water-trees v1-0) #f)
    (set! (-> *background-work* tfrag-shared-trees v1-0) #f)
    (set! (-> *background-work* tfrag-trans-shared-trees v1-0) #f)
    (set! (-> *background-work* tfrag-water-shared-trees v1-0) #f)
    )
  (set! (-> *background-work* tfrag-tree-count) 0)
  (set! (-> *background-work* tfrag-trans-tree-count) 0)
  (set! (-> *background-work* tfrag-water-tree-count) 0)
  (set! (-> *background-work* tfrag-shared-tree-count) 0)
  (set! (-> *background-work* tfrag-trans-shared-tree-count) 0)
  (set! (-> *background-work* tfrag-water-shared-tree-count) 0)
  (set! (-> *background-work* shrub-tree-count) 0)
  (set! (-> *background-work* tie-tree-count) 0)
  (set! (-> *background-work* wait-to-vu0) (the-as uint 0))
  0
  (none)
  )

;; definition for function upload-vis-bits
;; og:preserve-this hand port of jak3's PC adaptation (the jakx decomp fails CFG on
;; the software-pipelined loop; the body matches jak3's modulo scheduling)
(defun upload-vis-bits ((arg0 level) (arg1 level) (arg2 bsp-header))
  "Upload vis data to the scratchpad."
  ;; og:preserve-this hand-rewritten for PC: jakx keeps per-view vis buffers
  ;; ((-> level vis-bits view)), and the original EE loop (with the debug
  ;; *artist-flip-visible* XOR variant) is a raw branch ladder. On PC the
  ;; scratchpad vis copy only feeds the commented VU culling paths; the C++
  ;; renderers cull on their own, so the straight copy is all that is needed.
  (let ((count (/ (+ (-> arg2 visible-list-length) 15) 16))
        (src (the-as (pointer uint128) (-> arg0 vis-bits 0)))
        (dst (scratchpad-ptr uint128 :offset #x3800))
        )
    (when (nonzero? (the-as int src))
      (dotimes (i count)
        (set! (-> dst i) (-> src i))
        )
      )
    )
  0
  (none)
  )

;; definition for function set-background-regs!
;; og:preserve-this jak3-parity PC no-op: the GS register setup is not needed on PC
(defun set-background-regs! ((arg0 level))
  (none)
  )

;; definition for function set-tie-guard-planes!
;; INFO: Used lq/sq
;; WARN: Return type mismatch plane vs none.
(defun set-tie-guard-planes! ((arg0 level))
  (let ((v1-0 (view-get-active-math-camera)))
    (cond
      ((logtest? (-> arg0 info level-flags) (level-flags use-camera-other))
       (set! (-> *instance-tie-work* guard-plane 0 quad) (-> v1-0 guard-plane-other 0 quad))
       (set! (-> *instance-tie-work* guard-plane 1 quad) (-> v1-0 guard-plane-other 1 quad))
       (set! (-> *instance-tie-work* guard-plane 2 quad) (-> v1-0 guard-plane-other 2 quad))
       (set! (-> *instance-tie-work* guard-plane 3 quad) (-> v1-0 guard-plane-other 3 quad))
       )
      (else
        (set! (-> *instance-tie-work* guard-plane 0 quad) (-> v1-0 guard-plane 0 quad))
        (set! (-> *instance-tie-work* guard-plane 1 quad) (-> v1-0 guard-plane 1 quad))
        (set! (-> *instance-tie-work* guard-plane 2 quad) (-> v1-0 guard-plane 2 quad))
        (set! (-> *instance-tie-work* guard-plane 3 quad) (-> v1-0 guard-plane 3 quad))
        )
      )
    )
  (none)
  )

