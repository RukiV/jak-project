;;-*-Lisp-*-
(in-package goal)

;; name: shadow-cpu.gc
;; name in dgo: shadow-cpu
;; dgos: ENGINE, GAME

(define-extern shadow-vu1-patch-consts (function symbol int int none))
(define-extern shadow-vu1-init-buffer (function dma-buffer int math-camera none))

;; DECOMP BEGINS

;; WARN: Return type mismatch uint vs int.
(defmethod asize-of ((this shadow-geo))
  (the-as int (* (-> this total-qwc) 16))
  )

(defmethod mem-usage ((this shadow-geo) (usage memory-usage-block) (flags int))
  (set! (-> usage length) (max 111 (-> usage length)))
  (set! (-> usage data 110 name) "shadow-geo")
  (+! (-> usage data 110 count) 1)
  (let ((v1-6 (* (-> this total-qwc) 16)))
    (+! (-> usage data 110 used) v1-6)
    (+! (-> usage data 110 total) (logand -16 (+ v1-6 15)))
    )
  this
  )

(define *shadow-data* (new 'static 'shadow-data
                        :dma-unpack-template (new 'static 'dma-packet
                          :dma (new 'static 'dma-tag :id (dma-tag-id cnt))
                          :vif0 (new 'static 'vif-tag :cmd (vif-cmd flush) :msk #x1)
                          :vif1 (new 'static 'vif-tag :cmd (vif-cmd unpack-v4-32))
                          )
                        :dma-cnt (new 'static 'dma-tag :id (dma-tag-id cnt))
                        :vif-unpack-v4-8 (new 'static 'vif-tag :cmd (vif-cmd unpack-v4-8))
                        )
        )

;; og:preserve-this shadow-invert-z-buf, shadow-dma-init and shadow-dma-end all
;; carry a viewport argument jak3's single-viewport versions never needed,
;; proven from the scoped decode: each reads a register (a1 here, t0/t1 in
;; shadow-dma-end below) that the raw disassembly flags as read-before-set,
;; through offsets that match viewport's own existing offset-asserts field for
;; field (shadow-invert-frame 336, zbuf-off 208, scissor 216, screen-sx 564,
;; screen-maxy 560, and more in the other two functions). The retail compiler
;; never gave that register a formal parameter slot either -- shadow-make-
;; invert-buf below just leaves the viewport pointer sitting in a1 from its own
;; prior computation and this function reads it on that assumption -- but
;; AGENTS.md #4 asks for the argument proven from the body to be declared, not
;; transcribed as an uninitialized local, so it is a real parameter here and
;; every call site below passes it explicitly.
(defun shadow-invert-z-buf ((arg0 dma-buffer) (arg1 viewport))
  (dma-buffer-add-gs-set arg0
                         (texflush 0)
                         (frame-1 (-> arg1 shadow-invert-frame))
                         (zbuf-1 (-> arg1 zbuf-off))
                         (scissor-1 (-> arg1 scissor))
                         (test-1 (new 'static 'gs-test :ate #x1 :atst (gs-atest always) :zte #x1 :ztst (gs-ztest always)))
                         (alpha-1 (new 'static 'gs-alpha :b #x1 :c #x2 :d #x2 :fix #x80))
                         (prim (new 'static 'gs-prim :prim (gs-prim-type sprite) :abe #x1))
                         (rgbaq (new 'static 'gs-rgbaq :r #xff :g #xff :b #xff :q 1.0))
                         )
  (let ((v1-3 (-> arg0 base)))
    (let* ((a2-6 arg0)
           (a3-19 (-> a2-6 base))
           )
      (set! (-> (the-as (pointer int64) a3-19)) #x10000000)
      (s.w! (&+ a3-19 8) 0)
      (let ((t0-1 #x50000000))
        (s.w! (&+ a3-19 12) t0-1)
        )
      (set! (-> a2-6 base) (&+ a3-19 16))
      )
    (let ((a2-8 (/ (-> arg1 screen-sx) 32)))
      (let* ((a3-21 arg0)
             (t0-2 (-> a3-21 base))
             )
        (set! (-> (the-as (pointer uint64) t0-2)) (logior (the-as uint #x2400000000008000) (shr (shl a2-8 49) 49)))
        (let ((t1-2 85))
          (s.d! (&+ t0-2 8) t1-2)
          )
        (set! (-> a3-21 base) (&+ t0-2 16))
        )
      (let ((a3-22 0))
        (dotimes (t0-4 a2-8)
          (let* ((t1-3 arg0)
                 (t2-2 (-> t1-3 base))
                 )
            (set! (-> (the-as (pointer int64) t2-2)) (logior #x73000000 (shr (shl (* (+ a3-22 1792) 16) 48) 48)))
            (let ((t3-6 (logior (shr (shl (* (+ a3-22 1824) 16) 48) 48) (shr (shl (* (-> arg1 screen-maxy) 16) 48) 32))))
              (s.d! (&+ t2-2 8) t3-6)
              )
            (set! (-> t1-3 base) (&+ t2-2 16))
            )
          (+! a3-22 32)
          )
        )
      )
    (let ((a1-5 (/ (the-as int (+ (- -16 (the-as int v1-3)) (the-as int (-> arg0 base)))) 16)))
      (cond
        ((nonzero? a1-5)
         (logior! (-> (the-as (pointer uint64) v1-3)) (shr (shl a1-5 48) 48))
         (logior! (-> (the-as (pointer uint64) v1-3) 1) (shl (shr (shl a1-5 48) 48) 32))
         )
        (else
          (set! (-> arg0 base) v1-3)
          )
        )
      )
    )
  (none)
  )

;; og:preserve-this unlike jak3's single-viewport version, this loops over both
;; split-screen viewports (*viewport-array* data 0/1) and threads each one's
;; own viewport pointer into shadow-invert-z-buf explicitly; see that
;; function's own note just above.
(defun shadow-make-invert-buf ()
  (dotimes (gp-0 2)
    (let* ((s4-0 (-> *viewport-array* data gp-0))
           (s5-0 (-> s4-0 shadow-dma))
           )
      (let ((v1-3 s5-0))
        (set! (-> v1-3 base) (-> v1-3 data))
        (set! (-> v1-3 end) (the-as pointer (+ (+ (-> v1-3 allocated-length) 28) (the-as int v1-3))))
        )
      (shadow-invert-z-buf s5-0 s4-0)
      (let ((v1-4 (-> s5-0 base)))
        (set! (-> (the-as (pointer int64) v1-4)) #x60000000)
        (set! (-> (the-as (pointer uint32) v1-4) 2) (the-as uint 0))
        (set! (-> (the-as (pointer uint32) v1-4) 3) (the-as uint 0))
        (set! (-> s5-0 base) (&+ v1-4 16))
        )
      )
    )
  0
  (none)
  )

(shadow-make-invert-buf)

;; og:preserve-this shadow-dma-init returns the dma-buffer's entry base pointer
;; (captured before any of this function's own writes, never rewritten again)
;; in place of jak3's global *shadow-dma-invert-call*; shadow-execute-all below
;; threads that return value through the stack into shadow-dma-end's own sixth
;; argument. Proven by the scoped decode's own return-type mismatch warning
;; (pointer vs none) plus the stack-store/stack-load pair around the two calls
;; at the shadow-execute-all call site; the raw decode discards the captured
;; pointer as a bare expression, which would silently return garbage instead
;; of the invert-call address if landed as printed.
(defun shadow-dma-init ((arg0 dma-buffer) (arg1 viewport))
  (let ((v0-0 (-> arg0 base)))
    (let ((v1-1 (/ (-> arg1 screen-sx) 32)))
      (let* ((a2-0 arg0)
             (a3-0 (-> a2-0 base))
             )
        (set! (-> (the-as (pointer int64) a3-0)) #x10000000)
        (s.w! (&+ a3-0 8) 0)
        (s.w! (&+ a3-0 12) 0)
        (set! (-> a2-0 base) (&+ a3-0 16))
        )
      (dma-buffer-add-gs-set arg0
                             (texflush 0)
                             (frame-1 (-> arg1 shadow-dma-frame))
                             (zbuf-1 (-> arg1 zbuf-off))
                             (scissor-1 (-> arg1 scissor))
                             (tex0-1 (-> arg1 tex0))
                             (tex1-1 (new 'static 'gs-tex1))
                             (miptbp1-1 (new 'static 'gs-miptbp))
                             (clamp-1 (new 'static 'gs-clamp :wms (gs-tex-wrap-mode clamp) :wmt (gs-tex-wrap-mode clamp)))
                             (test-1 (new 'static 'gs-test :ate #x1 :atst (gs-atest always) :zte #x1 :ztst (gs-ztest always)))
                             (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1))
                             (rgbaq (new 'static 'gs-rgbaq :a #x60))
                             (prim (new 'static 'gs-prim :prim (gs-prim-type sprite)))
                             )
      (let ((a2-4 (-> arg0 base)))
        (let* ((a3-8 arg0)
               (t0-26 (-> a3-8 base))
               )
          (set! (-> (the-as (pointer int64) t0-26)) #x10000000)
          (s.w! (&+ t0-26 8) 0)
          (let ((t1-1 #x50000000))
            (s.w! (&+ t0-26 12) t1-1)
            )
          (set! (-> a3-8 base) (&+ t0-26 16))
          )
        (let* ((a3-9 arg0)
               (t0-28 (-> a3-9 base))
               )
          (set! (-> (the-as (pointer uint64) t0-28)) (logior (the-as uint #x2400000000008000) (shr (shl v1-1 49) 49)))
          (let ((t1-4 85))
            (s.d! (&+ t0-28 8) t1-4)
            )
          (set! (-> a3-9 base) (&+ t0-28 16))
          )
        (let ((a3-10 0))
          (dotimes (t0-30 v1-1)
            (let* ((t1-5 arg0)
                   (t2-2 (-> t1-5 base))
                   )
              (set! (-> (the-as (pointer int64) t2-2)) (logior #x73000000 (shr (shl (* (+ a3-10 1792) 16) 48) 48)))
              (let ((t3-6 (logior (shr (shl (* (-> arg1 screen-maxy) 16) 48) 32) (shr (shl (* (+ a3-10 1824) 16) 48) 48))))
                (s.d! (&+ t2-2 8) t3-6)
                )
              (set! (-> t1-5 base) (&+ t2-2 16))
              )
            (+! a3-10 32)
            )
          )
        (let ((a3-14 (/ (the-as int (+ (- -16 (the-as int a2-4)) (the-as int (-> arg0 base)))) 16)))
          (cond
            ((nonzero? a3-14)
             (logior! (-> (the-as (pointer uint64) a2-4)) (shr (shl a3-14 48) 48))
             (logior! (-> (the-as (pointer uint64) a2-4) 1) (shl (shr (shl a3-14 48) 48) 32))
             )
            (else
              (set! (-> arg0 base) a2-4)
              )
            )
          )
        )
      )
    (dma-buffer-add-gs-set arg0
                           (texflush 0)
                           (test-1 (new 'static 'gs-test :ate #x1 :atst (gs-atest always) :zte #x1 :ztst (gs-ztest greater-equal)))
                           (zbuf-1 (if *shadow-debug*
                                       (-> arg1 zbuf-on)
                                       (-> arg1 zbuf-off)
                                       )
                                   )
                           (frame-1 (if *shadow-debug*
                                        (-> arg1 frame)
                                        (-> arg1 shadow-dma-frame)
                                        )
                                    )
                           )
    (the-as (pointer uint64) v0-0)
    )
  )

;; og:preserve-this shadow-dma-end takes the current viewport as a fifth
;; argument (same class as shadow-invert-z-buf's note above) and the pointer
;; shadow-dma-init now returns as a sixth, in place of jak3's global
;; *shadow-dma-invert-call*; written at both branches of the (cond (arg2 ...)
;; (else ...)) split below, mirroring jak3's identical two-branch shape.
(defun shadow-dma-end ((arg0 dma-buffer) (arg1 gs-rgbaq) (arg2 symbol) (arg3 int) (arg4 viewport) (arg5 (pointer uint64)))
  (cond
    (arg2
      (let ((a0-1 (-> arg4 shadow-dma)))
        (set! (-> arg5 0) (logior #x50000000 (shr (shl (the-as int (-> a0-1 data)) 33) 1)))
        (set! (-> arg5 1) (the-as uint 0))
        (let* ((v1-2 arg0)
               (a1-4 (-> v1-2 base))
               )
          (set! (-> (the-as (pointer uint64) a1-4)) (logior #x50000000 (shr (shl (the-as int (-> a0-1 data)) 33) 1)))
          (s.w! (&+ a1-4 8) 0)
          (let ((a0-6 #x13000000))
            (s.w! (&+ a1-4 12) a0-6)
            )
          (set! (-> v1-2 base) (&+ a1-4 16))
          )
        )
      )
    (else
      (set! (-> arg5 0) (the-as uint #x10000000))
      (set! (-> arg5 1) (the-as uint 0))
      0
      )
    )
  (shadow-vu1-patch-consts arg2 arg3 (-> arg4 index))
  (dma-buffer-add-gs-set-flusha arg0
                                (texflush 0)
                                (test-1
                                  (new 'static 'gs-test :ate #x1 :atst (gs-atest not-equal) :aref #x60 :zte #x1 :ztst (gs-ztest always))
                                  )
                                (tex0-1 (if (= arg3 2)
                                            (-> arg4 shadow-dma-tex0)
                                            (-> arg4 tex0)
                                            )
                                        )
                                (frame-1 (-> arg4 frame))
                                (zbuf-1 (-> arg4 zbuf-off))
                                (alpha-1 (new 'static 'gs-alpha))
                                (prim (new 'static 'gs-prim :prim (gs-prim-type sprite) :tme #x1 :abe #x1 :fst #x1))
                                (rgbaq arg1)
                                )
  (let ((a0-15 (/ (-> arg4 screen-sx) 32))
        (v1-9 (-> arg0 base))
        )
    (let* ((a1-25 arg0)
           (a2-2 (-> a1-25 base))
           )
      (set! (-> (the-as (pointer int64) a2-2)) #x10000000)
      (let ((a3-3 #x13000000))
        (s.w! (&+ a2-2 8) a3-3)
        )
      (let ((a3-4 #x50000000))
        (s.w! (&+ a2-2 12) a3-4)
        )
      (set! (-> a1-25 base) (&+ a2-2 16))
      )
    (let* ((a1-26 arg0)
           (a2-4 (-> a1-26 base))
           )
      (set! (-> (the-as (pointer uint64) a2-4)) (logior (the-as uint #x4400000000008000) (shr (shl a0-15 49) 49)))
      (let ((a3-7 #x5353))
        (s.d! (&+ a2-4 8) a3-7)
        )
      (set! (-> a1-26 base) (&+ a2-4 16))
      )
    (let ((a1-27 0)
          (a2-6 0)
          (a3-8 (-> arg4 screen-sy))
          )
      (dotimes (t0-3 a0-15)
        (let* ((t1-1 arg0)
               (t2-0 (-> t1-1 base))
               )
          (set! (-> (the-as (pointer int64) t2-0))
                (logior (shr (shl (+ (* a2-6 16) 8) 48) 32) (shr (shl (+ (* a1-27 16) 8) 48) 48))
                )
          (let ((t3-9 (logior (shr (shl (* (+ a2-6 1840) 16) 48) 32) (shr (shl (* (+ a1-27 1792) 16) 48) 48))))
            (s.d! (&+ t2-0 8) t3-9)
            )
          (let ((t3-14 (logior (shr (shl (+ (* a3-8 16) 8) 48) 32) (shr (shl (+ (* (+ a1-27 32) 16) 8) 48) 48))))
            (s.d! (&+ t2-0 16) t3-14)
            )
          (let ((t3-19 (logior (shr (shl (* (+ a3-8 1840) 16) 48) 32) (shr (shl (* (+ a1-27 1824) 16) 48) 48))))
            (s.d! (&+ t2-0 24) t3-19)
            )
          (set! (-> t1-1 base) (&+ t2-0 32))
          )
        (+! a1-27 32)
        )
      )
    (let ((a1-31 (/ (the-as int (+ (- -16 (the-as int v1-9)) (the-as int (-> arg0 base)))) 16)))
      (cond
        ((nonzero? a1-31)
         (logior! (-> (the-as (pointer uint64) v1-9)) (shr (shl a1-31 48) 48))
         (logior! (-> (the-as (pointer uint64) v1-9) 1) (shl (shr (shl a1-31 48) 48) 32))
         )
        (else
          (set! (-> arg0 base) v1-9)
          )
        )
      )
    )
  (none)
  )

(deftype shadow-stats (structure)
  ((num-single-tris   uint32)
   (num-double-tris   uint32)
   (num-single-edges  uint32)
   (num-double-edges  uint32)
   (num-fragments     uint16)
   (num-objects       uint16)
   )
  )

(defmethod inspect ((this shadow-stats))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'shadow-stats)
  (format #t "~1Tnum-single-tris: ~D~%" (-> this num-single-tris))
  (format #t "~1Tnum-double-tris: ~D~%" (-> this num-double-tris))
  (format #t "~1Tnum-single-edges: ~D~%" (-> this num-single-edges))
  (format #t "~1Tnum-double-edges: ~D~%" (-> this num-double-edges))
  (format #t "~1Tnum-fragments: ~D~%" (-> this num-fragments))
  (format #t "~1Tnum-objects: ~D~%" (-> this num-objects))
  (label cfg-4)
  this
  )

(deftype shadow-dcache (structure)
  ((vtx-table               uint32)
   (single-edge-table       uint32)
   (double-edge-table       uint32)
   (double-tri-table        uint32)
   (dcache-top              uint32)
   (num-facing-single-tris  uint32)
   (num-single-edges        uint32)
   (num-double-edges        uint32)
   (single-tri-list         uint32)
   (single-edge-list        uint32)
   (double-edge-list        uint32)
   (ptr-dual-verts          uint32)
   (stats                   shadow-stats  :inline)
   (frag-qwc                uint32)
   (center                  vector        :inline)
   (plane                   vector        :inline)
   (top-plane               vector        :inline)
   (near-plane              vector        :inline)
   (light-dir               vector        :inline)
   (vtx-min                 vector        :inline)
   (data                    uint8         :dynamic)
   )
  )

(defmethod inspect ((this shadow-dcache))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'shadow-dcache)
  (format #t "~1Tvtx-table: #x~X~%" (-> this vtx-table))
  (format #t "~1Tsingle-edge-table: #x~X~%" (-> this single-edge-table))
  (format #t "~1Tdouble-edge-table: #x~X~%" (-> this double-edge-table))
  (format #t "~1Tdouble-tri-table: #x~X~%" (-> this double-tri-table))
  (format #t "~1Tdcache-top: #x~X~%" (-> this dcache-top))
  (format #t "~1Tnum-facing-single-tris: ~D~%" (-> this num-facing-single-tris))
  (format #t "~1Tnum-single-edges: ~D~%" (-> this num-single-edges))
  (format #t "~1Tnum-double-edges: ~D~%" (-> this num-double-edges))
  (format #t "~1Tsingle-tri-list: #x~X~%" (-> this single-tri-list))
  (format #t "~1Tsingle-edge-list: #x~X~%" (-> this single-edge-list))
  (format #t "~1Tdouble-edge-list: #x~X~%" (-> this double-edge-list))
  (format #t "~1Tptr-dual-verts: #x~X~%" (-> this ptr-dual-verts))
  (format #t "~1Tstats: #<shadow-stats @ #x~X>~%" (-> this stats))
  (format #t "~1Tfrag-qwc: ~D~%" (-> this frag-qwc))
  (format #t "~1Tcenter: #<vector @ #x~X>~%" (-> this center))
  (format #t "~1Tplane: #<vector @ #x~X>~%" (-> this plane))
  (format #t "~1Ttop-plane: #<vector @ #x~X>~%" (-> this top-plane))
  (format #t "~1Tnear-plane: #<vector @ #x~X>~%" (-> this near-plane))
  (format #t "~1Tlight-dir: #<vector @ #x~X>~%" (-> this light-dir))
  (format #t "~1Tvtx-min: #<vector @ #x~X>~%" (-> this vtx-min))
  (format #t "~1Tdata[0] @ #x~X~%" (-> this data))
  (label cfg-4)
  this
  )

(define shadow-vu0-block (new 'static 'vu-function :length 88 :qlength 44))

(def-mips2c shadow-xform-verts function)

(def-mips2c shadow-calc-dual-verts function)

(def-mips2c shadow-scissor-edges function)

(def-mips2c shadow-scissor-top function)

(def-mips2c shadow-init-vars function)

(def-mips2c shadow-find-facing-single-tris function)

(def-mips2c shadow-find-single-edges function)

(def-mips2c shadow-find-facing-double-tris function)

(def-mips2c shadow-find-double-edges function)

(def-mips2c shadow-add-verts function)

(def-mips2c shadow-add-facing-single-tris function)

(def-mips2c shadow-add-single-edges function)

(def-mips2c shadow-add-single-tris function)

(def-mips2c shadow-add-double-tris function)

(def-mips2c shadow-add-double-edges function)

;; WARN: Return type mismatch int vs none.
(defmethod shadow-control-method-14 ((this shadow-control) (arg0 vector) (arg1 vector) (arg2 float) (arg3 float) (arg4 float))
  (let ((gp-0 (-> this settings)))
    (let ((s4-0 (-> gp-0 shadow-dir)))
      (vector-normalize-copy! s4-0 arg1 1.0)
      (set! (-> gp-0 shadow-dir w) (- arg2))
      (when *shadow-debug*
        (add-debug-x #t (bucket-id bucket785) arg0 *color-red*)
        (add-debug-vector #t (bucket-id bucket785) arg0 s4-0 (meters 3) *color-red*)
        )
      (let ((s1-2 (vector+float*! (new 'stack-no-clear 'vector) arg0 s4-0 arg3))
            (s5-2 (vector+float*! (new 'stack-no-clear 'vector) arg0 s4-0 arg4))
            )
        (vector-negate! (-> gp-0 top-plane) s4-0)
        (vector-negate! (-> gp-0 bot-plane) s4-0)
        (set! (-> gp-0 top-plane w) (- (vector-dot s1-2 (the-as vector (-> gp-0 top-plane)))))
        (set! (-> gp-0 bot-plane w) (- (vector-dot s5-2 (the-as vector (-> gp-0 bot-plane)))))
        )
      )
    (logior! (-> gp-0 flags) (shadow-flags shdf02 shdf03 shdf04 shdf07))
    )
  0
  (none)
  )

(defun debug-draw-settings ((arg0 shadow-settings))
  (let ((s4-0 (-> arg0 shadow-dir))
        (s5-0 (-> arg0 center))
        (s3-0 (-> arg0 top-plane))
        (s2-0 (-> arg0 bot-plane))
        (s1-0 (new 'stack-no-clear 'vector))
        (s0-0 (new 'stack-no-clear 'vector))
        )
    (cond
      ((logtest? (-> arg0 flags) (shadow-flags shdf02))
       (vector+float*! s1-0 s5-0 s4-0 (- (vector-dot (the-as vector s3-0) s5-0) (-> s3-0 w)))
       (vector+float*! s0-0 s5-0 s4-0 (- (vector-dot (the-as vector s2-0) s5-0) (-> s2-0 w)))
       )
      (else
        (let ((v1-7 (vector+float*! (new 'stack-no-clear 'vector) s5-0 s4-0 (-> s4-0 w))))
          (vector+float*! s1-0 v1-7 s4-0 (- (vector-dot (the-as vector s3-0) v1-7) (-> s3-0 w)))
          (vector+float*! s0-0 v1-7 s4-0 (- (vector-dot (the-as vector s2-0) v1-7) (-> s2-0 w)))
          )
        )
      )
    (add-debug-sphere #t (bucket-id bucket785) s5-0 (meters 0.8) *color-magenta*)
    (add-debug-vector #t (bucket-id bucket785) s5-0 s4-0 (meters 4) *color-magenta*)
    (add-debug-x #t (bucket-id bucket785) s1-0 *color-blue*)
    (add-debug-vector #t (bucket-id bucket785) s1-0 s3-0 (meters 2) *color-blue*)
    (add-debug-line #t (bucket-id bucket785) (-> arg0 center) s1-0 *color-blue* #f (the-as rgba -1))
    (add-debug-x #t (bucket-id bucket785) s0-0 *color-green*)
    (add-debug-vector #t (bucket-id bucket785) s0-0 s2-0 (meters 2) *color-green*)
    (add-debug-line #t (bucket-id bucket785) s1-0 s0-0 *color-green* #f (the-as rgba -1))
    )
  )

(def-mips2c shadow-execute (function shadow-dma-packet pointer pointer))

(defun shadow-vu0-upload ()
  ;; og:preserve-this PC_PORT guard, jak3's own landed shape (its shadow-cpu.gc
  ;; wraps this exact body in the same #unless): this function builds a real
  ;; VU0 microcode upload chain and dma-buffer-send-chain's it to the VIF0
  ;; bank at #x10008000, pure PS2 hardware; on PC the mips2c suite's own
  ;; exec_N helpers ARE the VU0 program, so the upload must not run. Landed
  ;; unguarded from the raw decode, it faulted in dma-send (dma+0x37 reading
  ;; goal 0) on the first frame that drew a vehicle shadow.
  (#unless PC_PORT
    (let ((gp-0 *vu0-dma-list*))
      (let ((v1-0 gp-0))
        (set! (-> v1-0 base) (-> v1-0 data))
        (set! (-> v1-0 end) (the-as pointer (+ (+ (-> v1-0 allocated-length) 28) (the-as int v1-0))))
        )
      (dma-buffer-add-vu-function gp-0 shadow-vu0-block 0)
      (let* ((v1-1 gp-0)
             (a0-5 (-> v1-1 base))
             )
        (set! (-> (the-as (pointer int64) a0-5)) #x70000000)
        (set! (-> (the-as (pointer uint64) a0-5) 1) (the-as uint 0))
        (set! (-> v1-1 base) (&+ a0-5 16))
        )
      (.sync.l)
      (dma-buffer-send-chain (the-as dma-bank-source #x10008000) gp-0)
      )
    )
  0
  (none)
  )

;; og:preserve-this shadow-execute-all takes no arguments; see the header's own
;; note on the define-extern above (drawable.gc's foreground-execute-cpu-vu0-
;; engines, which calls it, is updated to match in the same change). It
;; derives the current viewport from *viewport-array* internally, uses that
;; viewport's own index to select which of the six *shadow-globals* buckets
;; (three shadow-color categories x two split-screen view-slots) to draw, and
;; threads shadow-dma-init's return value into shadow-dma-end explicitly (see
;; both functions' own notes above); jak3's twin only ever has three buckets
;; and a caller-supplied dma-buffer, since it has no split-screen mode.
(defun shadow-execute-all ()
  (when *debug-segment*
    'other
    (let ((gp-0 (-> *display* frames (-> *display* on-screen) profile-array data 0))
          (v1-8 'other)
          (s5-0 *profile-other-color*)
          )
      (when (and *dproc* *debug-segment*)
        (let ((s4-0 (-> gp-0 data (-> gp-0 count))))
          (let ((s3-0 (-> gp-0 base-time)))
            (set! (-> s4-0 name) v1-8)
            (set! (-> s4-0 start-time) (the-as int (- (timer-count (the-as timer-bank #x10000800)) (the-as uint s3-0))))
            )
          (set! (-> s4-0 depth) (the-as uint (-> gp-0 depth)))
          (set! (-> s4-0 color) s5-0)
          (set! (-> gp-0 segment (-> gp-0 depth)) s4-0)
          )
        (set! (-> gp-0 count) (min 2099 (+ (-> gp-0 count) 1)))
        (+! (-> gp-0 depth) 1)
        (set! (-> gp-0 max-depth) (max (-> gp-0 max-depth) (-> gp-0 depth)))
        )
      )
    0
    )
  (when (logtest? #x40000000 (-> *display* vu1-enable-user))
    (let* ((gp-1 *shadow-globals*)
           (v1-24 *viewport-array*)
           (s5-1 (-> v1-24 data (-> v1-24 current-viewport-index)))
           (s4-1 (-> s5-1 index))
           )
      (let ((v1-26 (-> (the-as shadow-dcache *gsf-buffer*) stats)))
        (set! (-> v1-26 num-single-tris) (the-as uint 0))
        (set! (-> v1-26 num-double-tris) (the-as uint 0))
        (set! (-> v1-26 num-single-edges) (the-as uint 0))
        (set! (-> v1-26 num-double-edges) (the-as uint 0))
        (set! (-> v1-26 num-objects) (the-as uint 0))
        (set! (-> v1-26 num-fragments) (the-as uint 0))
        )
      0
      (let ((v1-28 #f))
        (dotimes (a0-15 3)
          (if (nonzero? (-> (the-as (pointer uint32) (+ (the-as uint gp-1) (* a0-15 64) (* s4-1 32))) 2))
              (set! v1-28 #t)
              )
          )
        (when v1-28
          (shadow-vu0-upload)
          (dotimes (s3-1 3)
            (let* ((s2-0 (the-as shadow-bucket (+ (+ (* s4-1 32) 8 (* s3-1 64)) (the-as int gp-1))))
                   (sv-16 (-> s2-0 first))
                   )
              (when (nonzero? sv-16)
                (with-dma-buffer-add-bucket ((s0-0 (-> *display* frames (-> *display* on-screen) global-buf))
                                             (-> s2-0 bucket-id)
                                             )
                  ;; og:preserve-this scratchpad-object, not the raw #x70000000
                  ;; the decode emitted: jak3's landed twin uses the macro at this
                  ;; exact site (its shadow-cpu.gc:715/720), which resolves to the
                  ;; PC fake-scratchpad on PC_PORT; the raw literal wrote to
                  ;; unmapped 0x70000000+0x2c on the first vehicle-shadow frame.
                  (set! (-> (scratchpad-object shadow-dcache) ptr-dual-verts) (the-as uint 0))
                  (shadow-vu1-init-buffer s0-0 s3-1 (the-as math-camera s5-1))
                  (flush-cache 0)
                  (let ((sv-32 (shadow-dma-init s0-0 s5-1)))
                    (set! (-> s0-0 base) (shadow-execute (the-as shadow-dma-packet sv-16) (-> s0-0 base)))
                    (let ((a2-4 (nonzero? (-> (scratchpad-object shadow-dcache) ptr-dual-verts)))
                          (a1-12 (logior (shl #x3f800000 32) (shr (shl (the-as int (the-as uint32 (-> s2-0 shadow-color))) 32) 32)))
                          )
                      (let ((v1-47 (-> *time-of-day-context* current-shadow-color)))
                        (if (zero? s3-1)
                            (set! a1-12
                                  (logior (logand (logior (logand (logior (logand a1-12 -256) (shr (shl (the int (* 128.0 (-> v1-47 x))) 56) 56)) -65281)
                                                          (shr (shl (the int (* 128.0 (-> v1-47 y))) 56) 48)
                                                          )
                                                  -16711681
                                                  )
                                          (shr (shl (the int (* 128.0 (-> v1-47 z))) 56) 40)
                                          )
                                  )
                            )
                        )
                      (shadow-dma-end s0-0 (the-as gs-rgbaq a1-12) a2-4 s3-1 s5-1 sv-32)
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    (let ((gp-2 *gsf-buffer*))
      (let ((v1-64 (-> *terrain-stats* shadow)))
        (+! (-> v1-64 groups) (-> (the-as shadow-dcache gp-2) stats num-objects))
        (+! (-> v1-64 fragments) (-> (the-as shadow-dcache gp-2) stats num-objects))
        (+! (-> v1-64 tris)
            (* (+ (-> (the-as shadow-dcache gp-2) stats num-single-tris)
                  (-> (the-as shadow-dcache gp-2) stats num-double-tris)
                  (-> (the-as shadow-dcache gp-2) stats num-single-edges)
                  (-> (the-as shadow-dcache gp-2) stats num-double-edges)
                  )
               2
               )
            )
        (+! (-> v1-64 dverts)
            (* (the-as uint 6) (-> (the-as shadow-dcache gp-2) stats num-single-tris))
            (* (the-as uint 6) (-> (the-as shadow-dcache gp-2) stats num-double-tris))
            (* (-> (the-as shadow-dcache gp-2) stats num-single-edges) 4)
            (* (-> (the-as shadow-dcache gp-2) stats num-double-edges) 4)
            )
        )
      (when #f
        (format *stdcon* "~%~%~%~%#single tris : ~4d~%" (-> (the-as shadow-dcache gp-2) stats num-single-tris))
        (format *stdcon* "#double tris : ~4d~%" (-> (the-as shadow-dcache gp-2) stats num-double-tris))
        (format *stdcon* "#single edges: ~4d~%" (-> (the-as shadow-dcache gp-2) stats num-single-edges))
        (format *stdcon* "#double edges: ~4d~%" (-> (the-as shadow-dcache gp-2) stats num-double-edges))
        )
      )
    )
  (when *debug-segment*
    (let ((gp-3 (-> *display* frames (-> *display* on-screen) profile-array data 0)))
      (when (and *dproc* *debug-segment*)
        (let* ((v1-77 (+ (-> gp-3 depth) -1))
               (s5-2 (-> gp-3 segment v1-77))
               (s4-2 (-> gp-3 base-time))
               )
          (when (>= v1-77 0)
            (set! (-> s5-2 end-time) (the-as int (- (timer-count (the-as timer-bank #x10000800)) (the-as uint s4-2))))
            (+! (-> gp-3 depth) -1)
            )
          )
        )
      )
    0
    )
  0
  (none)
  )

(defmethod probe-line-for-shadow ((this shadow-control) (arg0 vector) (arg1 float) (arg2 float) (arg3 float))
  (with-pp
    (let ((s4-0 (new 'stack-no-clear 'collide-query)))
      (let ((v1-0 pp))
        (set! (-> s4-0 start-pos quad) (-> arg0 quad))
        (+! (-> s4-0 start-pos y) 4096.0)
        (set-vector! (-> s4-0 move-dist) 0.0 (- arg3) 0.0 1.0)
        (let ((a0-4 s4-0))
          (set! (-> a0-4 radius) 8192.0)
          (set! (-> a0-4 collide-with) (collide-spec backgnd))
          (set! (-> a0-4 ignore-process0) v1-0)
          (set! (-> a0-4 ignore-process1) #f)
          (set! (-> a0-4 ignore-pat)
                (new 'static 'pat-surface :noentity #x1 :nojak #x1 :probe #x1 :noendlessfall #x1 :board #x1)
                )
          (set! (-> a0-4 action-mask) (collide-action solid))
          (set! (-> a0-4 best-other-prim) #f)
          )
        )
      (cond
        ((>= (collide-cache-method-10 *collide-cache* s4-0) 0.0)
         (let ((v1-5 this))
           (logclear! (-> v1-5 settings flags) (shadow-flags disable-draw))
           )
         0
         (let ((v1-7 this))
           (set! (-> v1-7 settings bot-plane w) (- (+ (-> s4-0 best-other-tri intersect y) arg1)))
           )
         0
         (set! (-> this settings top-plane w) (- (+ (-> s4-0 best-other-tri intersect y) arg2)))
         0
         )
        (else
          (let ((v1-10 this))
            (logior! (-> v1-10 settings flags) (shadow-flags disable-draw))
            )
          0
          )
        )
      )
    0
    (none)
    )
  )
