;; definition for function dirty-eyes
;; WARN: Return type mismatch int vs none.
;; WARN: .subu (32-bit) used on a uint at idx 13. This probably should be a handle.
;; WARN: Function dirty-eyes has a return type of none, but the expression builder found a return statement.
(defun dirty-eyes ()
  (if (zero? are-we-in-time-trial-mode?)
      (return #f)
      )
  (dotimes (gp-0 32)
    (let* ((s5-0 (-> *eye-control-array* data gp-0))
           ;; og:preserve-this hand-fold: the decompiler only half-recognizes
           ;; this handle deref (it emits the raw .asm.sllv.r0 / pid-check
           ;; triple, which goalc cannot compile); the triple is exactly
           ;; handle->process, matching generic-obs.gc's own manipy 'mirror
           ;; hand-fold and visvol-edit.gc's (trans idle visvol-editor) for
           ;; the identical gap.
           (s4-0 (the-as process-drawable (handle->process (the-as handle (-> s5-0 process)))))
           )
      (when (or (are-we-in-time-trial-mode?) (and s4-0
                                                  (logtest? (-> s4-0 skel status) (joint-control-status eye-anim))
                                                  (logtest? (-> s4-0 draw status) (draw-control-status on-screen))
                                                  )
                )
        (when (-> s5-0 shaders)
          (if (-> s5-0 high-res?)
              (set-dirty-mask!
                (-> *level* level (-> s5-0 level-index))
                (the-as int (-> s5-0 level-texture-page))
                #x8000
                (* (-> s5-0 left tbp) 256)
                )
              (set-dirty-mask!
                (-> *level* level (-> s5-0 level-index))
                (the-as int (-> s5-0 level-texture-page))
                8192
                (* (-> s5-0 left tbp) 256)
                )
              )
          )
        )
      )
    )
  0
  (none)
  )

;; definition for function update-eyes
;; og:preserve-this: update-eyes itself decodes clean (the handle->process
;; deref is the same hand-foldable sllv gap dirty-eyes above already
;; resolves; only WARNs otherwise), but it calls render-eyes-32 and
;; render-eyes-64, both held above with no landed body. Landing
;; update-eyes with a real definition would satisfy drawable.gc's own
;; forward extern and flip its "(if (nonzero? update-eyes) (update-eyes))"
;; runtime-link guard live (AGENTS.md rule 5: landing a function activates
;; its guarded callers), crashing on the first frame that calls an
;; unlanded render-eyes-32/64. Held un-landed alongside them so that guard
;; stays dark exactly as it is today; the raw decode is preserved in the
;; REF file for reference.

;; definition for function convert-eye-data
