(define-extern are-we-in-time-trial-mode? (function symbol))

;; definition for symbol *eye-work*, type eye-work
(define *eye-work* (new 'static 'eye-work
                     :sprite-tmpl (new 'static 'dma-gif-packet
                       :dma-vif (new 'static 'dma-packet
                         :dma (new 'static 'dma-tag :qwc #x6 :id (dma-tag-id cnt))
                         :vif1 (new 'static 'vif-tag :imm #x6 :cmd (vif-cmd direct) :msk #x1)
                         )
                       :gif (new 'static 'array uint64 2 #x508b400000008001 #x53531)
                       )
                     :sprite-tmpl2 (new 'static 'dma-gif-packet
                       :dma-vif (new 'static 'dma-packet
                         :dma (new 'static 'dma-tag :qwc #x6 :id (dma-tag-id cnt))
                         :vif1 (new 'static 'vif-tag :imm #x6 :cmd (vif-cmd direct) :msk #x1)
                         )
                       :gif (new 'static 'array uint64 2 #x50ab400000008001 #x53531)
                       )
                     :adgif-tmpl (new 'static 'dma-gif-packet
                       :dma-vif (new 'static 'dma-packet
                         :dma (new 'static 'dma-tag :qwc #x6 :id (dma-tag-id cnt))
                         :vif1 (new 'static 'vif-tag :imm #x6 :cmd (vif-cmd direct) :msk #x1)
                         )
                       :gif (new 'static 'array uint64 2 #x1000000000008005 #xe)
                       )
                     :blink-table (new 'static 'array float 10 0.0 0.667 0.9 1.0 1.0 1.0 1.0 0.333 0.1 0.0)
                     )
        )

;; definition for function find-free-eye-index
;; ERROR: function was not converted to expressions. Cannot decompile.

;; definition for function free-eye-index
(defun free-eye-index ((arg0 int))
  (when (< arg0 32)
    (let ((v1-4 (-> *eye-control-array* data arg0)))
      (set! (-> v1-4 process) (the-as uint #f))
      (set! (-> v1-4 random-time) (the-as uint 60))
      (set! (-> v1-4 blink) 0.0)
      (set! (-> v1-4 shaders) (the-as (inline-array adgif-shader) #f))
      (set! (-> v1-4 level-index) -1)
      (set! (-> v1-4 high-res?) #f)
      (set! (-> v1-4 art-group-name 3) (the-as uint 0))
      (dotimes (a0-4 2)
        (set! (-> v1-4 eyes a0-4 shader-count) (the-as uint 0))
        (dotimes (a1-3 8)
          (set! (-> (the-as eye-control (+ (+ (* a1-3 4) (* 80 a0-4)) (the-as int v1-4))) left shader 0) #f)
          )
        )
      )
    )
  0
  )

;; definition for function render-eyes-32
;; ERROR: function was not converted to expressions. Cannot decompile.
;;
;; og:preserve-this: render-eyes-32's own decode is otherwise clean but the
;; dma-buffer base-field walk (a1 = arg0; (l.wu (+ a1 4)), the &+! 112
;; macro this file's own working blocks use elsewhere) loses its type at
;; its third within-block repeat (op 475), degrading every later use of
;; the same pattern (12+ sites) to raw MIPS fallback forms (l.wu, sll,
;; the-as none) that are not valid GOAL and will not compile. Config
;; casts were tried at that one op (decompiler/config/jakx/ntsc_v1/
;; type_casts.jsonc, the render-eyes-64/32 op 476 entries) and reverted:
;; retyping a1 to dma-buffer there clears this error but cascades into
;; roughly 100 new "Failed store" errors through the rest of the
;; function. Held un-landed until the root cause of the op-475 break is
;; found; the raw decode is preserved in the REF file for reference.

