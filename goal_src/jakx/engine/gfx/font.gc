;;-*-Lisp-*-
(in-package goal)

;; name: font.gc
;; name in dgo: font
;; dgos: ENGINE, GAME

;; og:preserve-this issue 540: draw-string-result single-homed to font-h.gc
;; (game.gd link position 65, this file's own 226). new_type rewrites every
;; custom method slot on every deftype execution of the same interned type
;; (issue 534); a duplicate deftype here risked wiping any future
;; draw-string-result method landed in font-h.gc once this file linked
;; after it. font-h.gc's copy already declares draw-string-xy's own return
;; type, so nothing in this file needed a local redeclaration.

;; DECOMP BEGINS


;; og:preserve-this partial landing: the draw-string ring is real (context setup
;; methods, the packed/3d asm draws as mips2c, wrappers and length measurement).
;; The effect-string chain (draw-effect-string, char-effect-compute*, the font
;; curves) and draw-string-no-asm stay pending; draw-string degrades effect ids
;; to the plain packed draw behind runtime-link guards until that chain lands.

(def-mips2c draw-string-asm-packed (function string dma-buffer font-context draw-string-result))
(def-mips2c draw-string3d-asm (function string dma-buffer font-context draw-string-result))
(def-mips2c get-string-length-asm (function string font-context draw-string-result))
(def-mips2c draw-string-init-justify (function string dma-buffer font-context none))

(define-extern draw-effect-string (function string dma-buffer font-context draw-string-result))
(define-extern char-effect-compute-colors (function font-char-effect int int font-context none))

;; og:preserve-this hand-written from font_ir2.asm: counts display lines in a string
;; (newline / carriage-return separated; a trailing unterminated line counts).
(defmethod font-context-method-11 ((this font-context) (arg0 string))
  (let ((count 0)
        (ptr (-> arg0 data))
        )
    (when (nonzero? (-> ptr 0))
      (while (nonzero? (-> ptr 0))
        (if (or (= (-> ptr 0) 10) (= (-> ptr 0) 13))
            (+! count 1)
            )
        (set! ptr (&-> ptr 1))
        )
      (let ((last (-> (&-> ptr -1) 0)))
        (if (and (!= last 10) (!= last 13))
            (+! count 1)
            )
        )
      )
    count
    )
  )

;; og:preserve-this hand-written from font_ir2.asm: middle-vert centering. The
;; original reads the string through an a1 pass-through from the caller; the port
;; threads it explicitly.
(defmethod font-context-method-12 ((this font-context) (arg0 string))
  (let* ((f30-0 (if (logtest? (-> this flags) (font-flags large))
                    32.0
                    16.0
                    )
                )
         (f1-0 (* f30-0 (the float (font-context-method-11 this arg0))))
         )
    (+! (-> this calc-origin y) (* 0.5 (- (-> this scaled-height) f1-0)))
    )
  0
  (none)
  )

(defmethod font-context-method-9 ((this font-context) (arg0 string))
  (let ((s5-0 (-> *viewport-array* default)))
    (-> this mat)
    (let ((v1-2 (-> this calc-mat))
          (f30-0 (-> this scale))
          )
      (let* ((f2-0 (/ 1.0 f30-0))
             (f3-0 (* (-> *video-params* relative-x-scale) f30-0))
             (f4-0 (* f2-0 (-> *video-params* relative-x-scale-reciprical)))
             (f0-4 (- (-> this origin x) (the float (-> s5-0 screen-hx))))
             (f1-3 (- (-> this origin y) (the float (-> s5-0 screen-hy))))
             )
        (set-vector! (-> this calc-origin) 0.0 0.0 (-> this origin z) 1.0)
        (set! (-> this scaled-width) (* (-> this width) f4-0))
        (set! (-> this scaled-height) (* (-> this height) f2-0))
        (set-vector! (-> v1-2 rvec) f3-0 0.0 0.0 0.0)
        (if (logtest? (-> this flags) (font-flags ff11))
            (set-vector! (-> v1-2 uvec) (* -0.3 f30-0) f30-0 0.0 0.0)
            (set-vector! (-> v1-2 uvec) 0.0 f30-0 0.0 0.0)
            )
        (set-vector! (-> v1-2 fvec) 0.0 0.0 1.0 0.0)
        (set-vector! (-> v1-2 trans) f0-4 f1-3 0.0 1.0)
        )
      (set! (-> this ialpha) (the int (* 128.0 (-> this alpha))))
      (if (logtest? (-> this flags) (font-flags middle-vert))
          (font-context-method-12 this arg0)
          )
      (let ((v1-10 *font-work*))
        (let ((a0-16 (-> *viewport-array* data 0 math-camera)))
          (set! (-> v1-10 screen-max x) #x8fe0)
          (set! (-> v1-10 screen-max y) #x8ce0)
          (set! (-> v1-10 screen-min x) #x7020)
          (set! (-> v1-10 screen-min y) #x7320)
          (let ((f0-11 (the float (-> s5-0 screen-cx)))
                (f1-6 (the float (-> s5-0 screen-cy)))
                )
            (set! (-> v1-10 hvdf-offset x) f0-11)
            (set! (-> v1-10 hvdf-offset y) f1-6)
            (set! (-> v1-10 hvdf-offset z) (-> a0-16 hvdf-off z))
            (set! (-> v1-10 hvdf-offset w) (-> a0-16 hvdf-off w))
            (set! (-> v1-10 hvdf-shadow x) (+ 2.0 f0-11))
            (set! (-> v1-10 hvdf-shadow y) (+ 1.0 f1-6))
            (set! (-> v1-10 hvdf-shadow z) (-> a0-16 hvdf-off z))
            (set! (-> v1-10 hvdf-shadow w) (-> a0-16 hvdf-off w))
            (let* ((f2-25 (fmax 1.0 f30-0))
                   (f2-26 (fmin 2.0 f2-25))
                   )
              (set! (-> v1-10 hvdf-outline0 x) (+ f0-11 f2-26))
              (set! (-> v1-10 hvdf-outline0 y) (+ f1-6 f2-26))
              (set! (-> v1-10 hvdf-outline0 z) (-> a0-16 hvdf-off z))
              (set! (-> v1-10 hvdf-outline0 w) (-> a0-16 hvdf-off w))
              (set! (-> v1-10 hvdf-outline1 x) (- f0-11 f2-26))
              (set! (-> v1-10 hvdf-outline1 y) (+ f1-6 f2-26))
              (set! (-> v1-10 hvdf-outline1 z) (-> a0-16 hvdf-off z))
              (set! (-> v1-10 hvdf-outline1 w) (-> a0-16 hvdf-off w))
              (set! (-> v1-10 hvdf-outline2 x) (- f0-11 f2-26))
              (set! (-> v1-10 hvdf-outline2 y) (- f1-6 f2-26))
              (set! (-> v1-10 hvdf-outline2 z) (-> a0-16 hvdf-off z))
              (set! (-> v1-10 hvdf-outline2 w) (-> a0-16 hvdf-off w))
              (set! (-> v1-10 hvdf-outline3 x) (+ f0-11 f2-26))
              (set! (-> v1-10 hvdf-outline3 y) (- f1-6 f2-26))
              )
            )
          (set! (-> v1-10 hvdf-outline3 z) (-> a0-16 hvdf-off z))
          (set! (-> v1-10 hvdf-outline3 w) (-> a0-16 hvdf-off w))
          )
        (set! (-> v1-10 size3-small w) (/ (-> this y-spacing) 2))
        (set! (-> v1-10 size3-large w) (-> this y-spacing))
        )
      )
    )
  0
  (none)
  )

(defmethod font-context-method-10 ((this font-context) (arg0 string))
  (let* ((s5-0 (-> *viewport-array* default))
         (a2-0 (-> this mat))
         (s2-0 (-> this calc-mat))
         (f30-0 (-> this scale))
         (f0-2 (- (* (-> this meters-per-texel) f30-0)))
         (f1-1 (/ 1.0 f30-0))
         (s4-0 (-> *viewport-array* data 0 math-camera))
         )
    (set! (-> this scaled-width) (* (-> this width) f1-1))
    (set! (-> this scaled-height) (* (-> this height) f1-1))
    (set-vector! (-> s2-0 rvec) f0-2 0.0 0.0 0.0)
    (if (logtest? (-> this flags) (font-flags ff11))
        (set-vector! (-> s2-0 uvec) (* -0.3 f0-2) f0-2 0.0 0.0)
        (set-vector! (-> s2-0 uvec) 0.0 f0-2 0.0 0.0)
        )
    (set-vector! (-> s2-0 fvec) 0.0 0.0 1.0 0.0)
    (set-vector! (-> s2-0 trans) 0.0 0.0 0.0 1.0)
    (matrix*! s2-0 s2-0 a2-0)
    (matrix*! s2-0 s2-0 (-> s4-0 camera-temp))
    (vector-float*! (-> this calc-origin) (-> this origin) f30-0)
    (let ((v1-12 this))
      (set! (-> v1-12 projection) (-> s4-0 pfog0))
      )
    (set! (-> this ialpha) (the int (* 128.0 (-> this alpha))))
    (if (logtest? (-> this flags) (font-flags middle-vert))
        (font-context-method-12 this arg0)
        )
    (let ((v1-19 *font-work*))
      (set! (-> v1-19 hvdf-offset x) (the float (-> s5-0 screen-cx)))
      (set! (-> v1-19 hvdf-offset y) (the float (-> s5-0 screen-cy)))
      (set! (-> v1-19 hvdf-offset z) (-> s4-0 hvdf-off z))
      (set! (-> v1-19 hvdf-offset w) (-> s4-0 hvdf-off w))
      (set! (-> v1-19 hvdf-shadow x) (the float (+ (-> s5-0 screen-cx) 1)))
      (set! (-> v1-19 hvdf-shadow y) (the float (+ (-> s5-0 screen-cy) 1)))
      (set! (-> v1-19 hvdf-shadow z) (-> s4-0 hvdf-off z))
      (set! (-> v1-19 hvdf-shadow w) (-> s4-0 hvdf-off w))
      (let ((f0-31 1.0))
        (set! (-> v1-19 hvdf-outline0 x) (+ (the float (-> s5-0 screen-cx)) f0-31))
        (set! (-> v1-19 hvdf-outline0 y) (+ (the float (-> s5-0 screen-cy)) f0-31))
        (set! (-> v1-19 hvdf-outline0 z) (-> s4-0 hvdf-off z))
        (set! (-> v1-19 hvdf-outline0 w) (-> s4-0 hvdf-off w))
        (set! (-> v1-19 hvdf-outline1 x) (- (the float (-> s5-0 screen-cx)) f0-31))
        (set! (-> v1-19 hvdf-outline1 y) (+ (the float (-> s5-0 screen-cy)) f0-31))
        (set! (-> v1-19 hvdf-outline1 z) (-> s4-0 hvdf-off z))
        (set! (-> v1-19 hvdf-outline1 w) (-> s4-0 hvdf-off w))
        (set! (-> v1-19 hvdf-outline2 x) (- (the float (-> s5-0 screen-cx)) f0-31))
        (set! (-> v1-19 hvdf-outline2 y) (- (the float (-> s5-0 screen-cy)) f0-31))
        (set! (-> v1-19 hvdf-outline2 z) (-> s4-0 hvdf-off z))
        (set! (-> v1-19 hvdf-outline2 w) (-> s4-0 hvdf-off w))
        (set! (-> v1-19 hvdf-outline3 x) (+ (the float (-> s5-0 screen-cx)) f0-31))
        (set! (-> v1-19 hvdf-outline3 y) (- (the float (-> s5-0 screen-cy)) f0-31))
        )
      (set! (-> v1-19 hvdf-outline3 z) (-> s4-0 hvdf-off z))
      (set! (-> v1-19 hvdf-outline3 w) (-> s4-0 hvdf-off w))
      (set! (-> v1-19 size3-small w) (/ (-> this y-spacing) 2))
      (set! (-> v1-19 size3-large w) (-> this y-spacing))
      )
    )
  0
  (none)
  )

;; og:preserve-this hand-written from font_ir2.asm: the result rescaling tail uses
;; raw float-bit swaps (sllv through GPRs) that degrade the decomp; the structure
;; below matches the asm op for op, with the effect branch guarded until the
;; effect chain lands.
(defun draw-string ((arg0 string) (arg1 dma-buffer) (arg2 font-context))
  (when (< (dma-buffer-free arg1) (* 13 (length arg0)))
    (return (the-as draw-string-result (-> arg2 origin quad)))
    )
  (cond
    ((logtest? (-> arg2 flags) (font-flags ff9))
     (font-context-method-10 arg2 arg0)
     (draw-string3d-asm arg0 arg1 arg2)
     )
    (else
      (font-context-method-9 arg2 arg0)
      (draw-string-init-justify arg0 arg1 arg2)
      (let ((s3-1 (the-as draw-string-result (-> arg2 origin quad))))
        (cond
          ((and (nonzero? (-> arg2 effect)) (nonzero? draw-effect-string))
           (when (!= (-> arg2 effect) 8)
             (if (nonzero? char-effect-compute-colors)
                 (char-effect-compute-colors *font-char-effect* (length arg0) (the-as int (-> arg2 effect-color)) arg2)
                 )
             )
           (draw-effect-string arg0 arg1 arg2)
           )
          (else
            (set! s3-1 (draw-string-asm-packed arg0 arg1 arg2))
            )
          )
        (let* ((a0-16 (logior (logand s3-1 (shl (-> (new 'static 'array uint64 1 #xffffffff) 0) 32))
                              (shr (shl (the-as int (* (-> s3-1 length)
                                                       (* (-> arg2 scale) (-> *video-params* relative-x-scale))
                                                       )
                                                )
                                        32
                                        )
                                   32
                                   )
                              )
                      )
               )
          (the-as draw-string-result (logior (logand a0-16 (-> (new 'static 'array uint64 1 #xffffffff) 0))
                                             (shr (shl (the-as int (* (-> a0-16 b) (-> arg2 scale))) 32) 0)
                                             )
                  )
          )
        )
      )
    )
  )

(defun get-string-length ((arg0 string) (arg1 font-context))
  (local-vars (v0-1 draw-string-result))
  (-> arg1 origin quad)
  (cond
    ((logtest? (-> arg1 flags) (font-flags ff9))
     (let* ((a0-1 (get-string-length-asm arg0 arg1))
            (a0-6 (logior (logand a0-1 (shl (-> (new 'static 'array uint64 1 #xffffffff) 0) 32))
                          (shr (shl (the-as int (* (-> a0-1 length) (-> arg1 scale))) 32) 32)
                          )
                  )
            )
       (set! v0-1 (logior (logand a0-6 (-> (new 'static 'array uint64 1 #xffffffff) 0))
                          (shr (shl (the-as int (* (-> a0-6 b) (-> arg1 scale))) 32) 0)
                          )
             )
       )
     )
    (else
      (let* ((a0-11 (get-string-length-asm arg0 arg1))
             (a0-16 (logior (logand a0-11 (shl (-> (new 'static 'array uint64 1 #xffffffff) 0) 32))
                            (shr (shl (the-as int (* (-> a0-11 length) (-> arg1 scale))) 32) 32)
                            )
                    )
             (a0-21 (logior (logand a0-16 (-> (new 'static 'array uint64 1 #xffffffff) 0))
                            (shr (shl (the-as int (* (-> a0-16 b) (-> arg1 scale))) 32) 0)
                            )
                    )
             )
        (set! v0-1 (logior (logand a0-21 (shl (-> (new 'static 'array uint64 1 #xffffffff) 0) 32))
                           (shr (shl (the-as int (* (-> a0-21 length) (-> *video-params* relative-x-scale))) 32) 32)
                           )
              )
        )
      )
    )
  v0-1
  )

(defun draw-string-xy ((arg0 string) (arg1 dma-buffer) (arg2 int) (arg3 int) (arg4 font-color) (arg5 font-flags))
  (let ((a2-2 (new 'stack 'font-context *font-default-matrix* arg2 arg3 8396850.0 arg4 arg5)))
    (when (logtest? arg5 (font-flags right))
      (let ((v1-4 a2-2))
        (set! (-> v1-4 origin x) (the float 0.0))
        (set! (-> v1-4 origin y) (the float arg3))
        )
      (set-width! a2-2 arg2)
      )
    (draw-string arg0 arg1 a2-2)
    )
  )

(defun draw-string-adv ((arg0 string) (arg1 dma-buffer) (arg2 font-context))
  (let ((v1-0 (draw-string arg0 arg1 arg2)))
    (+! (-> arg2 origin x) (-> v1-0 length))
    )
  (none)
  )
