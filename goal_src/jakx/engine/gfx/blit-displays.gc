;;-*-Lisp-*-
(in-package goal)

;; name: blit-displays.gc
;; name in dgo: blit-displays
;; dgos: ENGINE, GAME

;; og:preserve-this landing notes:
;; - do-blit-displays (m17) is the per-frame screen-effects pass (brightness,
;;   contrast, hflip mirror, letterbox, color filter, the blit GS baseline) and
;;   method 26 is the per-viewport motion-blur splicer (walks *viewport-array*,
;;   inserts each viewport's prebuilt blur-forward/reverse/finish dma chains into
;;   bucket 784); methods 24/25 build those chains.
;; - fx-copy-buf (home warp.o) and hflip-z-buf are not landed; their calls sit
;;   inside the horizontal-flip block (dormant until the flag is set) and carry
;;   runtime-link guards.
(define-extern fx-copy-buf (function dma-buffer viewport none)) ;; home warp.gc, not landed
(define-extern hflip-z-buf (function dma-buffer viewport none)) ;; home not landed

;; og:preserve-this PC port, mirroring jak3's blit-displays.gc:39 (issue 761): draw-raw-image's
;; title-card upload (the Dolby card, DOSCREEN.STR) used upload-vram-data, but that call is a
;; compiled no-op on PC (texture.gc:1098's (#when PC_PORT (return #f)) guard), so the sprite
;; sampled tbp 0, which nothing ever wrote, and rendered as a white quad. jak3 replaced the call
;; with this function, which emits the same GENERIC_UPLOAD texture-anim record that
;; TextureAnimator::handle_generic_upload already consumes for jakx (texture-anim-funcs.gc:222-231
;; builds the identical texture-anim-pc-upload record). Not retired: this is the PC-port path,
;; permanent.
(defun pc-upload-raw-texture ((dma-buf dma-buffer) (image-data pointer) (width int) (height int) (tbp int))
  "Added function in the PC port to create a 'raw' texture (no clut)"
  (pc-texture-anim-flag start-anim-array dma-buf)
  (pc-texture-anim-flag upload-generic-vram dma-buf :qwc 1)
  (let ((upload-record (the texture-anim-pc-upload (-> dma-buf base))))
    (set! (-> upload-record data) image-data)
    (set! (-> upload-record width) width)
    (set! (-> upload-record height) height)
    (set! (-> upload-record dest) tbp)
    (set! (-> upload-record format) (gs-psm ct32))
    (set! (-> upload-record force-to-gpu) 1)
    )
  (&+! (-> dma-buf base) 16)
  (pc-texture-anim-flag finish-anim-array dma-buf)
  )

