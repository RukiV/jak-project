(deftype light-trail-tracker-projectile (light-trail-tracker)
  ((state-time uint64  :offset-assert 192) ;; time-frame
   )
  :method-count-assert 23
  :size-assert         #xc8
  :flag-assert         #x17004000c8
  (:state-methods
