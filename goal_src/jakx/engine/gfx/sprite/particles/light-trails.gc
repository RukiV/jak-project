         (set! (-> arg3 y) 0.0)
         (set! (-> this cache-vector 0 quad) (-> arg3 quad))
         (vector-cross! arg3 v1-0 (-> this appearance lie-vector))
         (set! (-> arg3 y) 0.0)
         (vector-cross! arg3 v1-0 arg3)
         (set! (-> this cache-vector 1 quad) (-> arg3 quad))
         )
        )
      )
    )
  (none)
  )

