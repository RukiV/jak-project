;; og:preserve-this trailcasts rung: clean scoped decode, landed once
;; should-draw? (below) resolves the same rung. light-trail-method-13 (its
;; other callee) already landed. See the fresh note further below for the
;; full retirement citation against this file's own "tracker rung"/
;; "trailfinal rung" notes.
(defbehavior light-trail-tracker-common-post light-trail-tracker ()
  (cond
    ((should-draw? self)
     (light-trail-method-13 (-> self trail))
     )
    (else
      (set! (-> self trail strip num-verts) (the-as uint 0))
      (when (-> self trail strip2)
        (set! (-> self trail strip2 num-verts) (the-as uint 0))
        0
        )
      )
    )
  )

(defmethod relocate ((this light-trail) (offset int))
  (&+! (-> this crumb-array) offset)
