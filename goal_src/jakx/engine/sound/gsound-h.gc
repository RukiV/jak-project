   (mode      uint32)
   (priority  uint32)
   )
  )


(deftype sound-rpc-load-music (sound-rpc-bank-cmd)
  ()
  )


(deftype sound-rpc-unload-bank (sound-rpc-cmd)
  ((mode  uint32)
   )
  )


(deftype sound-rpc-play (sound-rpc-sound-cmd)
