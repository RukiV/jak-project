  )


(deftype sound-rpc-stop-group (sound-rpc-group-cmd)
  ()
  )


(deftype sound-rpc-continue-group (sound-rpc-group-cmd)
  ()
  )


(deftype sound-rpc-cancel-dgo (sound-rpc-group-cmd)
