;; definition for function prototypes-game-visible-set!
;; og:preserve-this landed for real: the cdr-chain typing gap the prior extern-only
;; note above described (l.w at s4-2 once s4 is reassigned from the pair's cdr) is
;; the same generic pair-car loop-back residual already documented at (method 11
;; script-context) in type_casts.jsonc; s4 needed casting back to pair at both the
;; cdr load and the following car load (ops 19 and 20 of the ir2) for type prop to
;; resolve the whole loop, not just the failing op alone. arg0 is walked as a pair
;; list via car/cdr; arg1 is tested against #f to choose OR vs AND-NOT on the
;; prototype-bucket flags word; arg2 flows straight into find-instance-by-name-
;; level's level parameter. All 16 call sites (intro-scenes.gc and
;; intro-scenes3.gc, all game-DGO) declared this via define-extern with no defun
;; anywhere in goal_src until this leg; those calls linked to address 0.
;; WARN: Return type mismatch int vs none.
(defun prototypes-game-visible-set! ((arg0 pair) (arg1 symbol) (arg2 level))
  (let ((a0-1 (-> arg0 car)))
    (while (not (null? (the-as object arg0)))
      (let ((v1-0 (find-instance-by-name-level (the-as string a0-1) arg2)))
        (when v1-0
          (if arg1
              (logclear! (-> v1-0 flags) (prototype-flags visible no-collide))
              (logior! (-> v1-0 flags) (prototype-flags visible no-collide))
              )
          )
        )
      (set! arg0 (the-as pair (-> arg0 cdr)))
      (set! a0-1 (-> arg0 car))
      )
    )
  0
  (none)
  )

