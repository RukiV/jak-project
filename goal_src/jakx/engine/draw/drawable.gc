;; definition for function foreground-engine-execute
;; og:preserve-this decompiles clean with the rung-2 externs live (the old commented
;; blob predated foreground-init existing). Only edit vs machine output: the PS2
;; dcache writeback-invalidate ops are commented out, exactly as jak3's source ships
;; them (jak3 drawable.gc:1423-1430). The profiler stays in decompiled inline form,
;; the jakx precedent (no with-profiler macro in this game).
(defun foreground-engine-execute ((arg0 engine))
  "Draw all foreground objects!"
  (when (> (length arg0) 0)
    (let ((gp-0 (-> *display* frames (-> *display* on-screen) global-buf base)))
      (when *debug-segment*
        'foreground
        (let ((s4-0 (-> *display* frames (-> *display* on-screen) profile-array data 0))
              (v1-17 'foreground)
              (s3-0 *profile-foreground-color*)
              )
          (when (and *dproc* *debug-segment*)
            (let ((s2-0 (-> s4-0 data (-> s4-0 count))))
              (let ((s1-0 (-> s4-0 base-time)))
                (set! (-> s2-0 name) v1-17)
                (set! (-> s2-0 start-time) (the-as int (- (timer-count (the-as timer-bank #x10000800)) (the-as uint s1-0))))
                )
              (set! (-> s2-0 depth) (the-as uint (-> s4-0 depth)))
              (set! (-> s2-0 color) s3-0)
              (set! (-> s4-0 segment (-> s4-0 depth)) s2-0)
              )
            (set! (-> s4-0 count) (min 2099 (+ (-> s4-0 count) 1)))
            (+! (-> s4-0 depth) 1)
            (set! (-> s4-0 max-depth) (max (-> s4-0 max-depth) (-> s4-0 depth)))
            )
          )
        0
        )
      (let ((s4-1 (-> *display* frames (-> *display* on-screen) global-buf)))
        (foreground-init)
        ; (let ((v1-35 (-> s4-1 base)))
        ;   (.sync.l)
        ;   (.cache dxwbin v1-35 0)
        ;   (.sync.l)
        ;   (.cache dxwbin v1-35 1)
        ;   )
        ; (.sync.l)
        ; 0
        (execute-connections arg0 s4-1)
        )
      (foreground-wrapup)
      (when *debug-segment*
        (let ((s5-1 (-> *display* frames (-> *display* on-screen) profile-array data 0)))
          (when (and *dproc* *debug-segment*)
            (let* ((v1-50 (+ (-> s5-1 depth) -1))
                   (s4-2 (-> s5-1 segment v1-50))
                   (s3-1 (-> s5-1 base-time))
                   )
              (when (>= v1-50 0)
                (set! (-> s4-2 end-time) (the-as int (- (timer-count (the-as timer-bank #x10000800)) (the-as uint s3-1))))
                (+! (-> s5-1 depth) -1)
                )
              )
            )
          )
        0
        )
      (let ((v1-55 *dma-mem-usage*))
        (when (nonzero? v1-55)
          (set! (-> v1-55 length) (max 36 (-> v1-55 length)))
          (set! (-> v1-55 data 35 name) "pris-fragment")
          (+! (-> v1-55 data 35 count) 1)
          (+! (-> v1-55 data 35 used)
              (&- (-> *display* frames (-> *display* on-screen) global-buf base) (the-as uint gp-0))
              )
          (set! (-> v1-55 data 35 total) (-> v1-55 data 35 used))
          )
        )
      )
    )
  0
  (none)
  )

