       (when (= (-> *screen-shot-work* count) -1)
         (set! (-> *screen-shot-work* size) -1)
         (if (and *record-fma-real* (= *master-mode* 'pause))
             (set-master-mode 'game)
             )
         )
       )
     (let ((s5-1 (-> arg0 frames arg1)))
       (if *sync-dma*
           (sync-path 0 0)
           )
       (let ((v1-150 (-> s5-1 global-buf)))
         (set! (-> v1-150 base) (-> v1-150 data))
         (set! (-> v1-150 end) (the-as pointer (+ (+ (-> v1-150 allocated-length) 28) (the-as int v1-150))))
         )
       (when *debug-segment*
         (let ((v1-153 (-> s5-1 debug-buf)))
           (set! (-> v1-153 base) (-> v1-153 data))
           (set! (-> v1-153 end) (the-as pointer (+ (+ (-> v1-153 allocated-length) 28) (the-as int v1-153))))
           )
         )
       (let ((v1-154 (-> s5-1 calc-buf)))
         (set! (-> v1-154 base) (-> v1-154 data))
         (set! (-> v1-154 end) (the-as pointer (+ (+ (-> v1-154 allocated-length) 28) (the-as int v1-154))))
         )
       (*pre-draw-hook* (-> s5-1 calc-buf))
       (when (not (paused?))
         (clear *stdcon1*)
         ;; og:preserve-this runtime-link guards: homes not landed yet
         (if (nonzero? debug-reset-buffers)
             (debug-reset-buffers)
             )
         (when (nonzero? *simple-sprite-system*)
           (clear! *simple-sprite-system*)
           )
         )
       (set! (-> s5-1 bucket-group) (dma-buffer-add-buckets (-> s5-1 calc-buf) 796))
       )
     )
    (else
      (clear *stdcon1*)
      ;; og:preserve-this runtime-link guards: homes not landed yet
      (if (nonzero? debug-reset-buffers)
          (debug-reset-buffers)
          )
      (when (nonzero? *simple-sprite-system*)
        (clear! *simple-sprite-system*)
        )
      )
    )
  (service-cpads)
  (service-mouse)
  (service-keybd)
  (execute-connections *pad-engine* #f)
  ;; og:preserve-this zeroed-field guard: a 0 in the symbol field is truthy; require a
  ;; real #t. (initialize! may leave it zeroed on the bring-up texture pool.)
  (when (and (nonzero? (-> *texture-pool* update-sprites-flag)) (-> *texture-pool* update-sprites-flag))
    (update-sprites *texture-pool*)
    (particle-adgif-cache-flush)
    (remap-all-particles)
    )
  (if (not (paused?))
      (set! *teleport* #f)
      )
  (none)
  )

