;; definition for function determine-pause-mode
;; WARN: Return type mismatch int vs none.
;; WARN: disable def twice: 62. This may happen when a cond (no else) is nested inside of another conditional, but it should be rare.
(defun determine-pause-mode ()
  (when (and (not *progress-process*)
             (or (!= *master-mode* 'freeze) (and *debug-segment* (cpad-pressed? 0 select start) (cpad-hold? 0 l3)))
             )
    (if (or (and (!= *master-mode* 'progress) (or (cpad-pressed? 0 start) (cpad-pressed? 1 start)))
            (and *debug-segment* (cpad-pressed? 0 select))
            (let ((v1-26 (cond
                           ((= *master-mode* 'menu)
                            (or (cpad-pressed? 0 r3 r2 triangle circle) (cpad-pressed? 1 r3 r2 triangle circle))
                            )
                           ((= *master-mode* 'progress)
                            #f
                            )
                           (*cam-layout*
                             #f
                             )
                           (else
                             #f
                             )
                           )
                         )
                  )
              v1-26
              )
            (or (and (logtest? (-> *cpad-list* cpads 0 valid) 128)
                     (-> *setting-control* user-current allow-in-game-menu)
                     (>= (-> *display* base-clock frame-counter) (the-as time-frame (-> *game-info* blackout-time)))
                     (= (-> *setting-control* user-current bg-a) 0.0)
                     (and (= (-> *setting-control* user-current bg-a-force) 0.0)
                          (< (seconds 1003) (-> *display* real-clock frame-counter))
                          )
                     )
                (and (cpad-pressed? 0 r2) (or (= *master-mode* 'pause) (= *master-mode* 'menu)))
                *pause-lock*
                )
            )
        (toggle-pause)
        )
    )
  (when (and *progress-process* (!= *master-mode* 'progress))
    )
  0
  (none)
  )

;; definition for function calc-ratio
(defun calc-ratio ((arg0 int) (arg1 int))
  (let ((f0-1 (the float (sar (- arg0 arg1) 48))))
    (if (< f0-1 0.0)
        (set! f0-1 (+ 65536.0 f0-1))
        )
    (/ f0-1 (the float *ticks-per-frame*))
    )
  )

;; definition for function display-sync
;; og:preserve-this pc port function, ported from jak3 drawable.gc
(defun pc-maybe-vsync ()
  "PC Port implementation of the block of code in display-sync that computes frame-time-ratio and maybe vsyncs."
  (syncv 0) ;; sync always!
  1.0       ;; and report that we run at full speed.
  )

(defun display-sync ((arg0 display))
  (if (not (-> (the-as (pointer uint32) *setting-control*) 191))
      (sync-path 0 0)
      )
  (let* ((s4-0 (-> arg0 last-screen))
         (s2-0 (shl (timer-count (the-as timer-bank #x10000800)) 48))
         (s5-0 (shl (-> arg0 frames s4-0 start-time) 48))
         (a1-1 (shl (-> arg0 vblank-start-time 0) 48))
         (s1-0 (shl (-> arg0 vblank-start-time 1) 48))
         )
    ;; og:preserve-this PC port, matching jak3: ticks-per-frame is vblank-derived on PS2
    ;; but locked on PC so frame-time heuristics never fire.
    (set! *ticks-per-frame* 9765)
    (let ((f28-0 (the float *ticks-per-frame*))
          (s3-0 (sar (- s2-0 s5-0) 48))
          (f30-1 (fmax 1.0 (calc-ratio (the-as int s2-0) (the-as int s5-0))))
          )
      (/ (the float (sar (- s2-0 (the-as uint s1-0)) 48)) f28-0)
      (let ((f28-1 (/ (the float (sar (- s2-0 (the-as uint s1-0)) 48)) f28-0))
            (f26-0 (fmax 1.0 (fmin 4.0 (-> *display* dog-ratio))))
            )
        (if (< (the-as int s3-0) 0)
            (set! s3-0 (the-as uint (+ #x10000 s3-0)))
            )
        ;; og:preserve-this PC port, matching jak3: run-time forced 0 so 'frame took too
        ;; long' logic never trips. Original: (set! (-> arg0 frames s4-0 run-time) s3-0)
        (set! (-> arg0 frames s4-0 run-time) 0)
        (+ f28-1 f26-0) ;; og:preserve-this keep vars live; original vsync block below
        ;; og:preserve-this PC port, matching jak3: the whole PS2 vsync cond collapses
        ;; to pc-maybe-vsync (always sync, dog-ratio 1.0).
        (if (not (-> (the-as (pointer uint32) *setting-control*) 191))
            (set! f30-1 (pc-maybe-vsync))
            )
        )
      (let ((s4-1 (-> arg0 on-screen)))
        (let ((v1-60 (timer-count (the-as timer-bank #x10000800))))
          (let ((a0-19 (sar (- (shl v1-60 48) s5-0) 48)))
            (if (< (the-as int a0-19) 0)
                (set! a0-19 (the-as uint (+ #x10000 a0-19)))
                )
            (+! (-> arg0 total-run-time) a0-19)
            )
          (set! (-> arg0 frames s4-1 start-time) v1-60)
          )
        (when (not (-> (the-as (pointer uint32) *setting-control*) 191))
          (set-graphics-mode)
          (let ((s5-1 (-> arg0 frames s4-1 calc-buf)))
            (when (nonzero? (dma-buffer-length s5-1))
              (+! s4-1 1)
              (if (< 1 s4-1)
                  (set! s4-1 0)
                  )
              (set! (-> arg0 last-screen) (-> arg0 on-screen))
              (set! (-> arg0 on-screen) s4-1)
              (when *debug-segment*
                (set! *profile-interrupt-segment* (-> *display* frames (-> *display* last-screen) profile-array data 1))
                (set! (-> *profile-interrupt-segment* depth) 0)
                (set! (-> *profile-interrupt-segment* max-depth) 1)
                )
              ;; og:preserve-this PC port, matching jak3: hand the chain to the PC
              ;; renderer instead of the (crash-stub) PS2 DMA path.
              (if (not (-> *display* dma-buffer-overflow))
                  (__send-gfx-dma-chain (the-as dma-bank-source #x10009000) (-> s5-1 data))
                  )
              )
            )
          )
        (determine-pause-mode)
        (when (and (nonzero? *screen-shot-work*) (= (-> *screen-shot-work* count) -1) (!= (-> *screen-shot-work* size) -1))
          (let ((v1-95 (-> *screen-shot-work* size)))
            (set! (-> *screen-shot-work* count) (* v1-95 v1-95))
            )
          (set-master-mode 'pause)
          )
        (display-frame-start arg0 s4-1 f30-1)
        )
      )
    )
  (none)
  )





;; og:preserve-this PHASE-1 HAND-WRITTEN draw hook: the decompiled original degrades
;; to raw ops on the profiling/foreground blocks. This minimal version runs only the
;; background chain (the connection engine draws each active level's bsp into
;; *background-work*, and finish-background turns that into bucket DMA). The
;; foreground/ocean/sprite/particle legs return here as their subsystems land.
(defun real-main-draw-hook ()
  ;; og:preserve-this dma leg: the retail hook calls lobby-dma-reserve-hook first,
  ;; before the mood pump (the commented original's t9-0/call! at 2134, ahead of
  ;; every other leg); it shrinks *display*'s current frame's global-buf by the
  ;; block allocator's running low-water mark and ages every block's alloc-frames
  ;; counter, the gate level.gc:9494 reads to reclaim a stale car-load buffer.
  ;; Without this call first, alloc-frames never increments and that 4-frame age
  ;; gate never clears.
  (lobby-dma-reserve-hook)
  ;; og:preserve-this mood leg: the retail hook runs the time-of-day pump before
  ;; the background draws (see the commented original's update-time-of-day call);
  ;; it fills each level's mood-context times/itimes and the env color
  (if (nonzero? update-time-of-day)
      (update-time-of-day *time-of-day-context*)
      )
  ;; og:preserve-this sky leg: draw the sky dome into bucket 5 (retail hook
  ;; order: pump, then sky, then the background dispatch; the commented original
  ;; wraps this in the sky profiler block)
  (when (nonzero? *sky-work*)
    (draw *sky-work*)
    (flush-cache 0)
    )
  ;; og:preserve-this water leg: retail runs the ocean once per viewport between the
  ;; sky and the actor update (the commented original at 2687-2724: push context,
  ;; store current-viewport-index, draw! [vtable 64], then update-map [vtable 68]
  ;; with the viewport when draw! resolved *ocean-map*, pop; after the loop, when
  ;; not paused, clear the ocean's off/near-off/all-on latches). draw! scans the
  ;; draw levels for one whose level-info carries an :ocean map, so the whole block
  ;; no-ops on ocean-less windows. Index restore per the foreground loop's lesson.
  (when (nonzero? *ocean*)
    (let ((prev-vp (-> *viewport-array* current-viewport-index)))
      (dotimes (vp-idx (-> *viewport-array* num-viewports))
        (view-push-context vp-idx)
        (set! (-> *viewport-array* current-viewport-index) vp-idx)
        (draw! *ocean*)
        (if *ocean-map*
            (update-map *ocean* (-> *viewport-array* data vp-idx))
            )
        (view-pop-context)
        )
      (set! (-> *viewport-array* current-viewport-index) prev-vp)
      )
    (when (not (paused?))
      (set! (-> *ocean* off) #f)
      (set! (-> *ocean* near-off) #f)
      (set! (-> *ocean* all-on) #f)
      )
    )
  ;; og:preserve-this actors leg (rung 6b): retail runs the level actor update
  ;; between the collision-event dispatch and the background draw (the commented
  ;; original's 'actors profiler block wraps a method-17 dispatch on *level*).
  ;; The collision-event and nav blocks that retail runs around it are still
  ;; unlanded; this is the spawn driver only. Every frame it compacts the dead
  ;; pools, refreshes the actor and attackable hashes, and births/kills entities
  ;; by distance and vis against the per-viewport camera positions.
  (actors-update *level*)
  (init-background)
  (execute-connections *background-draw-engine* #f)
  (finish-background)
  ;; og:preserve-this foreground leg (rungs 2-3): retail runs BOTH foreground passes
  ;; once per viewport inside a view context (the commented original's loop: push
  ;; context, store current-viewport-index, foreground-engine-execute, then the
  ;; EE/VU0 pass under the real clock, pop context). foreground-engine-execute is
  ;; length-gated, and *foreground-draw-engine* gets no connections until the rung-5
  ;; spawn path starts calling setup-cspace-and-add (landed, rung 4), so it is a
  ;; no-op today; the EE/VU0 pass
  ;; keeps its rung-1 role (bones + guarded stubs). jakx delta vs jak3: jak3 swaps
  ;; the clock by time-of-day mode, the jakx original loads real-clock always.
  ;; restore current-viewport-index after the loop: view-pop-context only moves the
  ;; view stack, and leaving the index at the last viewport made every later
  ;; consumer in the frame (update-camera -> update-visible among them) read and
  ;; write viewport 1's state while the renderers consume viewport 0's. That was
  ;; the frozen-visibility bug: the per-frame all-visible refresh landed in
  ;; vis-bits[1] and vis-bits[0] never changed after boot.
  (let ((prev-vp (-> *viewport-array* current-viewport-index)))
    (dotimes (vp-idx (-> *viewport-array* num-viewports))
      (view-push-context vp-idx)
      (set! (-> *viewport-array* current-viewport-index) vp-idx)
      (foreground-engine-execute *foreground-draw-engine*)
      (with-pp
        (let ((prev-clock (-> pp clock)))
          (set! (-> pp clock) (-> *display* real-clock))
          (foreground-execute-cpu-vu0-engines)
          (set! (-> pp clock) prev-clock)
          )
        )
      (view-pop-context)
      )
    (set! (-> *viewport-array* current-viewport-index) prev-vp)
    )
  ;; the part engine, jak3's placement and pause gate (#53; lever retired slice 4)
  (if (not (paused?))
      (execute-part-engine)
      )
  ;; #53 slice 4: the sprite leg, retail placement (after the part engine, outside
  ;; any view context; sprite-draw pushes its own per-viewport contexts and inserts
  ;; into buckets 769/772 via its L52 table) behind retail's vu1-enable-user guard
  (if (logtest? (-> *display* vu1-enable-user) (vu1-renderer-mask sprite))
      (sprite-draw *display*)
      )
  0
  (none)
  )

(define *draw-hook* main-draw-hook)
