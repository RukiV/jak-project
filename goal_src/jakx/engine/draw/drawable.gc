;; definition for function foreground-execute-cpu-vu0-engines
(defun foreground-execute-cpu-vu0-engines ()
  "Run foreground drawing code on EE/VU0 (bones, generic merc, part of shadow, lightning, prim)"
  (let ((gp-0 (-> *display* frames (-> *display* on-screen) global-buf)))
    (bones-init gp-0)
    (bones-mtx-calc-execute)
    ;; og:preserve-this bring-up guards: shadow-cpu, lightning and prim are not landed,
    ;; so their symbols link 0 and an unguarded call jumps to 0. Retail calls all four
    ;; unconditionally; each guard retires with its leg. generic-merc-execute-all's
    ;; guard retired at the effects leg's rung 5 with the full pipeline landed; this
    ;; is retail's unconditional call.
    (let ((a0-2 gp-0))
      (generic-merc-execute-all a0-2)
      (if (nonzero? shadow-execute-all)
          (shadow-execute-all a0-2)
          )
      )
    )
  (if (nonzero? lightning-draw-all)
      (lightning-draw-all)
      )
  (if (nonzero? prim-engine-execute)
      (prim-engine-execute)
      )
  (none)
  )

