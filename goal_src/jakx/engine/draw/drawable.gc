;; definition for function display-frame-start
;; WARN: Return type mismatch display vs none.
(defun display-frame-start ((arg0 display) (arg1 int) (arg2 float))
  ;; og:preserve-this PC port, matching jak3: workaround for PS2 hardware bug, no VIF on PC
  ;; (set! (-> (the-as vif-bank #x10003c00) err me0) 1)
  (cond
    ((not *record-fma-real*)
     (set-time-ratios *display* 1.0)
     (tick! (-> arg0 frame-clock))
     (tick! (-> arg0 real-frame-clock))
     (set-time-ratios *display* arg2)
     (tick! (-> arg0 session-clock))
     (tick! (-> arg0 game-clock))
     (tick! (-> arg0 total-game-clock))
     (tick! (-> arg0 base-clock))
     (tick! (-> arg0 real-clock))
     (tick! (-> arg0 target-clock))
     (tick! (-> arg0 camera-clock))
     (tick! (-> arg0 entity-clock))
     (tick! (-> arg0 bg-clock))
     (tick! (-> arg0 user0-clock))
     (tick! (-> arg0 user1-clock))
     (tick! (-> arg0 user2-clock))
     (tick! (-> arg0 user3-clock))
     (tick! (-> arg0 user4-clock))
     (tick! (-> arg0 user5-clock))
     (tick! (-> arg0 user6-clock))
     (tick! (-> arg0 user7-clock))
     (tick! (-> arg0 user8-clock))
     (tick! (-> arg0 user9-clock))
     (set! (-> arg0 bg-clock frame-counter) (the-as time-frame (mod (-> arg0 bg-clock frame-counter) #x69780)))
     (tick! (-> arg0 part-clock))
     )
    ((<= (-> *screen-shot-work* count) 0)
     (let ((f30-0 (* 2.0 (-> *display* time-factor))))
       (set-time-ratios *display* 1.0)
       (advance-by! (-> arg0 frame-clock) f30-0)
       (advance-by! (-> arg0 real-frame-clock) f30-0)
       (let ((a1-6 (if *record-fma-pal*
                       2.4
                       2.002
                       )
                   )
             )
         (set-time-ratios *display* a1-6)
         )
       (advance-by! (-> arg0 session-clock) f30-0)
       (advance-by! (-> arg0 game-clock) f30-0)
       (advance-by! (-> arg0 total-game-clock) f30-0)
       (advance-by! (-> arg0 base-clock) f30-0)
       (advance-by! (-> arg0 real-clock) f30-0)
       (advance-by! (-> arg0 target-clock) f30-0)
       (advance-by! (-> arg0 camera-clock) f30-0)
       (advance-by! (-> arg0 entity-clock) f30-0)
       (advance-by! (-> arg0 user0-clock) f30-0)
       (advance-by! (-> arg0 user1-clock) f30-0)
       (advance-by! (-> arg0 user2-clock) f30-0)
       (advance-by! (-> arg0 user3-clock) f30-0)
       (advance-by! (-> arg0 user4-clock) f30-0)
       (advance-by! (-> arg0 user5-clock) f30-0)
       (advance-by! (-> arg0 user6-clock) f30-0)
       (advance-by! (-> arg0 user7-clock) f30-0)
       (advance-by! (-> arg0 user8-clock) f30-0)
       (advance-by! (-> arg0 user9-clock) f30-0)
       (advance-by! (-> arg0 part-clock) f30-0)
       )
     )
    (else
      (set! (-> arg0 frame-clock sparticle-data x) 0.0)
      (set! (-> arg0 real-frame-clock sparticle-data x) 0.0)
      (set! (-> arg0 session-clock sparticle-data x) 0.0)
      (set! (-> arg0 game-clock sparticle-data x) 0.0)
      (set! (-> arg0 total-game-clock sparticle-data x) 0.0)
      (set! (-> arg0 base-clock sparticle-data x) 0.0)
      (set! (-> arg0 real-clock sparticle-data x) 0.0)
      (set! (-> arg0 target-clock sparticle-data x) 0.0)
      (set! (-> arg0 camera-clock sparticle-data x) 0.0)
      (set! (-> arg0 entity-clock sparticle-data x) 0.0)
      (set! (-> arg0 bg-clock sparticle-data x) 0.0)
      (set! (-> arg0 part-clock sparticle-data x) 0.0)
      )
    )
  (cond
    ;; og:preserve-this zeroed-heap guard: the raw word at +764 is the movie setting; the
    ;; stub *setting-control* leaves it 0 (truthy in GOAL) where the real init writes #f,
    ;; so treat 0 as "no movie" or the frame skips dma-buffer-add-buckets entirely.
    ((let ((v1-mov (-> (the-as (pointer uint32) *setting-control*) 191)))
       (or (zero? v1-mov) (not (the-as basic v1-mov)))
       )
     (when (and (nonzero? *screen-shot-work*) (!= (-> *screen-shot-work* count) -1))
       (let ((v1-130 (-> *screen-shot-work* size)))
         (if (!= (-> *screen-shot-work* count) (* v1-130 v1-130))
             (if (nonzero? store-image) (store-image *screen-shot-work*)) ;; og:preserve-this runtime-link guard
             )
