;;-*-Lisp-*-
(in-package goal)

;; name: cloth.gc
;; name in dgo: cloth
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

;; og:preserve-this bring-up stub for cloth-system-method-34, pattern
;; f5afc742b: NOT retail's body. Called naked (no nonzero? guard) from
;; process-drawable-show-all-cloth's own (not arg1) branch
;; (process-drawable.gc:1967), so hiding all cloth on a process-drawable
;; jumped straight to GOAL address 0 whenever that branch ran with no
;; defmethod installed. Declared return is none and the caller discards
;; it, so a no-op stub disarms the dispatch safely. Retirement condition:
;; the real method 34 landing (its own decode/adaptation lane).
(defmethod cloth-system-method-34 ((this cloth-system))
  0
  (none)
  )

;; og:preserve-this bring-up stub for cloth-system-method-37, pattern
;; f5afc742b: NOT retail's body. Called naked (no nonzero? guard) from
;; process-drawable-cloth-command (process-drawable.gc:2014), so any
;; scripted cloth command dispatched to a process-drawable jumped straight
;; to GOAL address 0 with no defmethod installed. Declared return is none
;; and the caller discards it, so a no-op stub disarms the dispatch
;; safely. Retirement condition: the real method 37 landing (its own
;; decode/adaptation lane).
(defmethod cloth-system-method-37 ((this cloth-system) (arg0 object))
  0
  (none)
  )

