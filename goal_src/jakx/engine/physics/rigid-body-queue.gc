;; og:preserve-this rigid-body-queue rung (held): rigid-body-queue-manager-
;; init-by-other, the idle state and rigid-body-queue-manager-post are
;; omitted as one cluster. Their own decode is clean (init-by-other's
;; stack-size-set!/queue-assign/init-queue!/go-virtual idle body, the idle
;; state's :exit/:code sleep-code/:post shape, and rigid-body-queue-manager-
;; post's own call into rigid-body-queue's method 10, all render without
;; error once given the :behavior tag), but idle's :post reaches method 10
;; (the physics tick) on the very first frame, and method 10 is the function
;; held above with the unverified body. Landing this cluster without a
;; verified tick body would activate a guarded caller
;; (vehicle-manager-init-by-other, see vehicle-manager.gc) into a state that
;; runs unverified code every frame. Nothing in this rung calls rigid-body-
;; queue-manager-spawn (vehicle-manager-init-by-other, its only caller, is
;; held for the same reason), so leaving this cluster undefined is
;; boot-safe today; retire together with method 10 above once its own tick
;; body is independently verified (offline-test -f rigid-body-queue -d).

;; definition for method 10 of type rigid-body-queue-manager
(defmethod deactivate ((this rigid-body-queue-manager))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (set! *rigid-body-queue-manager* #f)
  ((method-of-type process deactivate) this)
  (none)
  )

