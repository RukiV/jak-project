    ((2 3)
     (format
       *stdcon0*
       "  SIM ~s ~d/~d~%"
       (if (logtest? (-> this flags) 1)
           "ON "
           "OFF"
           )
       (-> this playback-index)
       (-> this record-count)
       )
     (format *stdcon0* "  debug-targets ~d~%" (-> this target-count))
     (if (zero? (-> this target-count))
         (format *stdcon0* "  <NONE>~%")
         )
     (dotimes (s5-1 (-> this target-count))
       (let* ((v1-95 (-> this target-array s5-1))
              ;; og:preserve-this rigid-body-small-tier rung: the raw decode
              ;; inlines the handle->process check by hand (subu-s7 against
