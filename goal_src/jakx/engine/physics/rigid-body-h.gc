;;-*-Lisp-*-
(in-package goal)

;; name: rigid-body-h.gc
;; name in dgo: rigid-body-h
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

(deftype rigid-body-info (structure)
  ((max-time-step       float          :offset-assert 0)
   (mass                float          :offset-assert 4)
   (inv-mass            float          :offset-assert 8)
   (linear-damping      float          :offset-assert 12)
   (angular-damping     float          :offset-assert 16)
   (bounce-factor       float          :offset-assert 20)
   (friction-factor     float          :offset-assert 24)
   (bounce-mult-factor  float          :offset-assert 28)
   (cm-offset-joint     vector :inline :offset-assert 32)
   (inv-inertial-tensor matrix :inline :offset-assert 48)
   (inertial-tensor     matrix :inline :offset-assert 112)
   (inertial-tensor-box meters 3       :offset-assert 176) ;; guessed by decompiler
   (gravity             float          :offset-assert 188)
   (max-ang-momentum    float          :offset-assert 192)
   )
  :method-count-assert 10
  :size-assert         #xc4
  :flag-assert         #xa000000c4
  (:methods
    (rigid-body-info-method-9 (_type_) none) ;; 9 ;; (rigid-body-info-method-9 (_type_) none)
    )
  )

;; og:preserve-this the captured comment block re-declared every field of
;; rigid-body-info (max-time-step, mass, inv-mass, linear/angular-damping,
;; bounce/friction-factor, inertial-tensor-x/y/z, gravity) a second time under
;; new names, all at the same offsets rigid-body-info's own :inline fields
;; already cover (0-196). deftype.cpp's add_field_to_type rejects a redeclared
;; name outright, and re-declaring the same bytes under a different name is
;; exactly the state-time class of bug the target-h.gc R1 landing already hit
;; (all-types.gc, target deftype: an inherited field re-listed under the
;; child). Dropped rather than kept as a forced-:offset alias, since unlike
;; target-h's state-object/uint32/float trio (three genuinely different
;; *interpretations* of one union slot, all plausibly read that way by real
;; code) these are the same float-for-float breakdown info already exposes;
;; nothing is lost that (-> x info cm-offset-joint x) does not already reach.
;; Retirement condition: a method-body decode that reads one of the dropped
;; names directly (not through info) would justify restoring it as a forced
;; :offset alias.
(deftype rigid-body-object-constants (structure)
  ((info rigid-body-info :inline :offset-assert 0)
   (name symbol                  :offset-assert 196) ;; guessed by decompiler
   )
  :method-count-assert 10
  :size-assert         #xc8
  :flag-assert         #xa000000c8
  (:methods
    (rigid-body-object-constants-method-9 (_type_) none) ;; 9
    )
  )

(deftype rigid-body-impact (structure)
  ((point    vector      :inline :offset-assert 0)
   (normal   vector      :inline :offset-assert 16)
   (velocity vector      :inline :offset-assert 32)
   (impulse  float               :offset-assert 48)
   (pat      pat-surface         :offset-assert 52) ;; guessed by decompiler
   (process  process             :offset-assert 56) ;; guessed by decompiler
   (prim-id  uint32              :offset-assert 60)
   (surface  basic               :offset-assert 64)
   )
  :method-count-assert 9
  :size-assert         #x44
  :flag-assert         #x900000044
  )

(deftype rb-perf-data (structure)
  ((process           uint64     :offset-assert 0)
   (t-rb-all          uint32     :offset-assert 8)
   (t-rb-callback     uint32     :offset-assert 12)
   (t-rb-fc           uint32     :offset-assert 16)
   (t-rb-move         uint32     :offset-assert 20)
   (t-rb-physics      uint32     :offset-assert 24)
   ;; og:preserve-this 4 bytes unaccounted between t-rb-physics (ends 28) and
   ;; t-vqp-all (32): no field name for it in the capture and this scoped
   ;; decode's rigid-body-h.o inspect method never prints rb-perf-data's own
   ;; fields (it is a plain pointer target, not inline anywhere on this
   ;; rung's chain). Extent-true pad; a decode of whatever function actually
   ;; writes this counter block would resolve it. Debug-only telemetry, not
   ;; on the M1 path.
   (pad-vqp-gap       uint8   4  :offset-assert 28)
   (t-vqp-all         uint32     :offset-assert 32)
   (t-vqp-common      uint32     :offset-assert 36)
   (t-vqp-ja-post     uint32     :offset-assert 40)
   (t-vqp-parts       uint32     :offset-assert 44)
   (t-vqp-post        uint32     :offset-assert 48)
   (t-vqp-sections    uint32     :offset-assert 52)
   (t-vqp-sound       uint32     :offset-assert 56)
   (t-nav-part1       uint32     :offset-assert 60)
   (t-nav-part2       uint32     :offset-assert 64)
   (t-nav-part3       uint32     :offset-assert 68)
   (t-nav-part4       uint32     :offset-assert 72)
   (t-nav-part5       uint32     :offset-assert 76)
   (t-nav-part6       uint32     :offset-assert 80)
   (t-nav-part7       uint32     :offset-assert 84)
   (t-nav-part8       uint32     :offset-assert 88)
   (t-nav-part9       uint32     :offset-assert 92)
   (t-nav-part10      uint32     :offset-assert 96)
   ;; og:preserve-this the captured field list declared t-part-turbo (@116)
   ;; ahead of t-part-exhaust/smoke/scrape/wheels (@100-112); :offset-assert
   ;; requires ascending declaration order (it checks against sequential
   ;; auto-placement), reordered here by offset with no content change.
   (t-part-exhaust    uint32     :offset-assert 100)
   (t-part-smoke      uint32     :offset-assert 104)
   (t-part-scrape     uint32     :offset-assert 108)
   (t-part-wheels     uint32     :offset-assert 112)
   (t-part-turbo      uint32     :offset-assert 116)
   (t-part-debris     uint32     :offset-assert 120)
   (t-part-water      uint32     :offset-assert 124)
   (t-part-forcefield uint32     :offset-assert 128)
   (t-prim-trails     uint32     :offset-assert 132)
   ;; og:preserve-this begin-times/begin-counts/end-counts are captured as
   ;; UNKNOWN 32-element arrays with no per-element type. Resolved to uint32,
   ;; the same width as every other t-* counter in this struct (the array
   ;; span, 128 bytes over 32 elements, is exactly 4 bytes/element and the
   ;; three arrays pack back to back with zero gap: 136+128=264, 264+128=392,
   ;; 392+128=520=size-assert). Debug-only telemetry; not on the M1 path.
   (begin-times       uint32  32 :offset-assert 136)
   (begin-counts      uint32  32 :offset-assert 264)
   (end-counts        uint32  32 :offset-assert 392)
   )
  :method-count-assert 12
  :size-assert         #x208
  :flag-assert         #xc00000208
  (:methods
    (rb-perf-data-method-9 (_type_) none) ;; 9
    (rb-perf-data-method-10 (_type_ object) none) ;; 10
    (rb-perf-data-method-11 (_type_ object) none) ;; 11
    )
  )

;; og:preserve-this rigid-body-object-flag is captured as an unresolved value
;; type ("field rigid-body-object-flag is likely a value type"). A scoped
;; decode of rigid-body-h.o's own inspect method ((method 3 rigid-body-object),
;; rigid-body-h_ir2.asm) settles the width directly: `ld a2, 260(gp)` is a
;; 64-bit load (declared offset 264 with the +4 basic-offset correction,
;; docs/jakx-bringup-quickstart.md's offset trap: rigid-body-object is
;; basic-derived via process-focusable/process/basic, so machine offsets here
;; run 4 below declared). Landed as a plain uint64 rather than a defenum:
;; the inspect method's own bit tests name only 4 of what is evidently a much
;; wider bitfield (dead=8, damaged=4, disturbed=2, enable-collision=1, all
;; confirmed against the same instruction sequence), and a full defenum needs
;; the rest of the bits named from a body-landing rung, out of scope here
;; (headers only, no method bodies this rung).
(deftype rigid-body-object (process-focusable)
  ((info               rigid-body-object-constants  :offset-assert 256)
   (flags              uint64                       :offset-assert 264)
   (max-time-step      float                        :offset-assert 272)
   (incoming-attack-id uint32                        :offset-assert 276)
   ;; og:preserve-this disturbed-time captured as `time-frame` (int64, 8
   ;; bytes), but rigid-body-h.o's own inspect method reads it with
   ;; `lwu a2, 276(gp)` (declared 280 with +4), a 4-byte unsigned load, and
   ;; perf immediately follows at the confirmed offset 284 with no room for
   ;; an 8-byte field in between. Resolved to uint32 per the load width; the
   ;; format string prints it with ~D (plain integer), consistent with a
   ;; truncated frame counter rather than a full time-frame.
   (disturbed-time     uint32                        :offset-assert 280)
   (perf               rb-perf-data                  :offset-assert 284)
   )
  :method-count-assert 89
  :size-assert         #x120
  :flag-assert         #x5900900120
  (:state-methods
    idle ;; 59
    active ;; 60
    )
  (:methods
    (rigid-body-object-method-61 () none) ;; 61
    (rigid-body-object-method-62 (_type_) none) ;; 62
    (rigid-body-object-method-63 (_type_) none) ;; 63
    (rigid-body-object-method-64 (_type_ object) none) ;; 64
    (rigid-body-object-method-65 (_type_) none) ;; 65
    (rigid-body-object-method-66 (_type_) none) ;; 66
    (rigid-body-object-method-67 (_type_) none) ;; 67
    (rigid-body-object-method-68 (_type_ object object) none) ;; 68
    (rigid-body-object-method-69 (_type_) none) ;; 69
    (rigid-body-object-method-70 () none) ;; 70
    (rigid-body-object-method-71 (_type_) none) ;; 71
    (rigid-body-object-method-72 (_type_) none) ;; 72
    (rigid-body-object-method-73 (_type_) none) ;; 73
    (rigid-body-object-method-74 (_type_) none) ;; 74
    (rigid-body-object-method-75 (_type_) none) ;; 75
    (rigid-body-object-method-76 (_type_) none) ;; 76
    (rigid-body-object-method-77 (_type_) none) ;; 77
    (rigid-body-object-method-78 () none) ;; 78
    (rigid-body-object-method-79 (_type_ object object) none) ;; 79
    (rigid-body-object-method-80 (_type_ rigid-body-impact) none) ;; 80
    (rigid-body-object-method-81 (_type_ process int symbol event-message-block) object) ;; 81 ;; jak3's rbody-event-handler shape: the decode reads a0/a1/a2/a3/t0 unset under the bare signature and rigid-body-object-event-handler passes the behavior's four event args straight through
    ;; og:preserve-this arg count corrected from zero (2026-08-16 construction-obs-h
    ;; rung): the construction-object override reads a2 (the second explicit arg) at
    ;; offset 144 as a float and rewrites it before tail-calling the parent unchanged
    ;; with the same a0/a1/a2, so the base signature needs both explicit args even
    ;; though this override never touches the first. Declared arg0 as the file's own
    ;; established placeholder for a not-yet-understood rigid-body-object arg
    ;; (methods 68/79/83/84 all use the same object fallback); arg1 typed rigid-body-
    ;; info since offset 144 (structure, no basic-tag bias) lands exactly on that
    ;; type's own inertial-tensor row 2, x component, a real field boundary already
    ;; declared above, not a fabricated one.
    (rigid-body-object-method-82 (_type_ object rigid-body-info) none) ;; 82
    (rigid-body-object-method-83 (_type_ object object) none) ;; 83
    (rigid-body-object-method-84 (_type_ object object) none) ;; 84
    (rigid-body-object-method-85 () none) ;; 85
    (rigid-body-object-method-86 () none) ;; 86
    (rigid-body-object-method-87 (_type_) none) ;; 87
    (rigid-body-object-method-88 () none) ;; 88
    )
  )

;; og:preserve-this landed from decompiler/config/jakx/all-types.gc's own "resurrected
;; from the dead block" copy (rigid-body-control was forward-declared in goal_src via
;; game-h.gc's declare-type since before this branch, but never given a real deftype
;; here, so TypeSystem::lookup_type throws "not fully defined" the moment any code
;; needs its fields, exactly what construction-object's own rbody-touching methods
;; need). Field-for-field identical to the all-types.gc copy: flags is uint16 rather
;; than an invented rigid-body-flag enum (no defenum for it exists anywhere in the
;; corpus, and jakx's own binary contradicts the jak3-ported bit positions a prior
;; attempt tried, per (method 3 rigid-body-control)'s inspect printing a raw 0x100 no
;; 6-bit enum can represent); rotation overlays rot at offset 64 with :offset, not
;; :offset-assert, since a vector's natural placement there does not match the union.
;; Three method signatures promoted from the trailing-comment guesses to real
;; typespecs on call-site evidence from (method 80 construction-object), the first
;; landed caller: method 12 takes a float (the impulse-normalized value 1.0 passed at
;; that call site), method 13 takes no explicit args (init-velocities!), method 18
;; takes two vectors (apply-impact!, called with the impact point and a locally-built
;; normal-scaled vector). The remaining methods keep their placeholder zero-arg
;; signatures; nothing in this rung calls them.
(deftype rigid-body-control (basic)
  ((flags              uint16                                          :offset-assert 4) ;; og:preserve-this rigid-body-flag referenced but never defined; raw uint16 matches the 2-byte gap, no enum invented
   (debug-id           int8                                            :offset-assert 6)
   (debugger-step      int8                                            :offset-assert 7)
   (info               rigid-body-info                                 :offset-assert 8)
   (force-callback     (function rigid-body-object float none)         :offset-assert 12) ;; guessed by decompiler
   (post-move-callback basic                                           :offset-assert 16)
   (process            process                                         :offset-assert 20) ;; guessed by decompiler
   (time-remaining     float                                           :offset-assert 24)
   (max-ang-momentum   float                                           :offset-assert 28)
   (linear-damping     float                                           :offset-assert 32)
   (angular-damping    float                                           :offset-assert 36)
   (bounce-factor      float                                           :offset-assert 40)
   (friction-factor    float                                           :offset-assert 44)
   (position           vector                                  :inline :offset-assert 48)
   (rot                vector                                  :inline :offset-assert 64)
   (rotation           quaternion                              :inline :offset 64)
   (lin-momentum       vector                                  :inline :offset-assert 80)
   (ang-momentum       vector                                  :inline :offset-assert 96)
   (force              vector                                  :inline :offset-assert 112)
   (torque             vector                                  :inline :offset-assert 128)
   (lin-velocity       vector                                  :inline :offset-assert 144)
   (ang-velocity       vector                                  :inline :offset-assert 160)
   (matrix             matrix                                  :inline :offset-assert 176)
   (inv-i-world        matrix                                  :inline :offset-assert 240)
   )
  :method-count-assert 41
  :size-assert         #x130
  :flag-assert         #x2900000130
  (:methods
    (new (symbol type) _type_) ;; 0 ;; (new (symbol type process) _type_)
    (rigid-body-control-method-9 () none) ;; 9 ;; (rigid-body-control-method-9 (_type_ collide-shape-moving float) none)
    (rigid-body-control-method-10 () none) ;; 10 ;; (rigid-body-control-method-10 (_type_ rigid-body-object float float) object)
    (rigid-body-control-method-11 () none) ;; 11 ;; (update-rbody-transform! (_type_ collide-shape-moving) none)
    (rigid-body-control-method-12 (_type_ float) none) ;; 12 ;; call-site evidence: (method 80 construction-object)
    (rigid-body-control-method-13 (_type_) none) ;; 13 ;; init-velocities!, call-site evidence: (method 80 construction-object)
    (rigid-body-control-method-14 () none) ;; 14 ;; (rigid-body-control-method-14 (_type_ float) none)
    (rigid-body-control-method-15 () none) ;; 15 ;; (rigid-body-control-method-15 (_type_) none)
    (rigid-body-control-method-16 () none) ;; 16 ;; (reset-force-and-torque! (_type_) none)
    (rigid-body-control-method-17 () none) ;; 17 ;; (reset-momentum! (_type_) none)
    (rigid-body-control-method-18 (_type_ vector vector) none) ;; 18 ;; apply-impact!, call-site evidence: (method 80 construction-object)
    (rigid-body-control-method-19 () none) ;; 19 ;; (rigid-body-control-method-19 (_type_ vector vector) none)
    (rigid-body-control-method-20 () none) ;; 20 ;; (add-force! (_type_ vector) none)
    (rigid-body-control-method-21 () none) ;; 21 ;; (rigid-body-control-method-21 (_type_ vector vector float) none)
    (rigid-body-control-method-22 () none) ;; 22 ;; (rigid-body-control-method-22 (_type_ vector vector) none)
    (rigid-body-control-method-23 () none) ;; 23 ;; (rigid-body-control-method-23 (_type_ vector vector) none)
    (rigid-body-control-method-24 () none) ;; 24 ;; (rigid-body-control-method-24 (_type_ vector vector) none)
    (rigid-body-control-method-25 () none) ;; 25 ;; (rigid-body-control-method-25 (_type_ vector) vector)
    (rigid-body-control-method-26 () none) ;; 26 ;; (rigid-body-control-method-26 (_type_) none)
    (rigid-body-control-method-27 () none) ;; 27 ;; (init! (_type_ rigid-body-info vector quaternion (function rigid-body-object float)) none)
    (rigid-body-control-method-28 () none) ;; 28 ;; (rigid-body-control-method-28 (_type_ vector quaternion) none)
    (rigid-body-control-method-29 () none) ;; 29 ;; (debug-print-info (_type_ object) none)
    (rigid-body-control-method-30 () none) ;; 30 ;; (debug-print-force-torque (_type_ object) none)
    (rigid-body-control-method-31 () none) ;; 31 ;; (debug-print-pos-rot (_type_ object) none)
    (rigid-body-control-method-32 () none) ;; 32 ;; (debug-print-momentum (_type_ object) none)
    (rigid-body-control-method-33 () none) ;; 33 ;; (debug-print-velocity (_type_ object) none)
    (rigid-body-control-method-34 () none) ;; 34
    (rigid-body-control-method-35 () none) ;; 35
    (rigid-body-control-method-36 () none) ;; 36
    (rigid-body-control-method-37 () none) ;; 37
    (rigid-body-control-method-38 () none) ;; 38
    (rigid-body-control-method-39 () none) ;; 39
    (rigid-body-control-method-40 () none) ;; 40
    )
  )

;; og:preserve-this landed from decompiler/config/jakx/all-types.gc (already active
;; there, never carried into goal_src): construction-obs-h's own (defstate idle
;; construction-object) uses this as its :event handler, and goalc resolves externs
;; from goal_src only, never all-types.gc, so the symbol was unresolved at compile
;; time until copied here verbatim.
(define-extern rigid-body-object-event-handler (function process int symbol event-message-block object :behavior rigid-body-object))