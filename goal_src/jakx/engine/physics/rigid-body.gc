;;-*-Lisp-*-
(in-package goal)

;; name: rigid-body.gc
;; name in dgo: rigid-body
;; dgos: ENGINE, GAME

;; og:preserve-this landed from jak3's own copy of this file
;; (goal_src/jak3/engine/physics/rigid-body.gc): a pure local scratch helper,
;; never surfaced through an inspect method, confirmed field-for-field against
;; this rung's own scoped decode of (method 30 rigid-body-control): quaternion->
;; matrix targets sp+16 (the mat field, offset 16), and vector-rotate*! writes
;; sp+0 (the vec field, offset 0), both consumed immediately after by a plain
;; vector+! into this.position. No asserts, matching jak3's own declaration.
(deftype rigid-body-stack (structure)
  ((vec vector :inline)
   (mat matrix :inline)
   )
  )

;; DECOMP BEGINS

(define *debug-move-rigid-body* #t)

;; og:preserve-this rigid-body rung: confirmed field-for-field against
;; (method 3 debug-rigid-body-move)'s own inspect print in this rung's own
;; scoped decode: vel-dot-norm/time-step-scale/best-u/i-step print as scalars
;; at 0/4/8/12, proc2/rbody2/best-my-prim print with ~A (an object reference)
;; at 16/20/24, bsphere/impact-info/rbody print by address ("#<TYPE @ #x~X>")
;; at 32/48/132 (the 132 a direct machine-code literal, `daddiu a2, gp, 132`,
;; not a guess; the size-assert this rung's own all-types.gc entry carries is
;; likewise a raw type-flag literal, not arithmetic). rbody-data is landed as
;; a flat byte extent rather than a typed inline rigid-body-control field:
;; goalc's aligner requires any :inline rigid-body-control field to sit on a
;; 16-byte boundary and rejects offset 132 outright (":offset-assert", plain
;; ":offset" and an explicit pad field were all tried and all rejected the
;; same way, "requires 16"), while the retail binary plainly did not share
;; that constraint (every read here is a scalar load or a bare address
;; computation, never lqc2/sqc2). Debug-only telemetry (the rb-debugger
;; playback scratch copy), not on the M1 path.
(deftype debug-rigid-body-move (structure)
  ((vel-dot-norm    float                      :offset-assert 0)
   (time-step-scale float                      :offset-assert 4)
   (best-u          float                      :offset-assert 8)
   (i-step          int8                       :offset-assert 12)
   (proc2           basic                      :offset-assert 16)
   (rbody2          basic                      :offset-assert 20)
   (best-my-prim    basic                      :offset-assert 24)
   (bsphere         sphere             :inline :offset-assert 32)
   (impact-info     rigid-body-impact  :inline :offset-assert 48)
   (pad-pre-rbody   uint8            16        :offset-assert 116) ;; extent-true, impact-info ends at 116 and rbody-data's own proven offset is 132
   (rbody-data      uint8            304       :offset-assert 132) ;; rigid-body-control's own byte layout, unaligned copy; see comment above
   )
  :method-count-assert 9
  :size-assert         #x1b4
  :flag-assert         #x9000001b4
  )

(defmethod inspect ((this debug-rigid-body-move))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'debug-rigid-body-move)
  (format #t "~1Tvel-dot-norm: ~f~%" (-> this vel-dot-norm))
  (format #t "~1Ttime-step-scale: ~f~%" (-> this time-step-scale))
  (format #t "~1Tbest-u: ~f~%" (-> this best-u))
  (format #t "~1Ti-step: ~D~%" (-> this i-step))
  (format #t "~1Tproc2: ~A~%" (-> this proc2))
  (format #t "~1Trbody2: ~A~%" (-> this rbody2))
  (format #t "~1Tbest-my-prim: ~A~%" (-> this best-my-prim))
  (format #t "~1Tbsphere: #<sphere @ #x~X>~%" (-> this bsphere))
  (format #t "~1Timpact-info: #<rigid-body-impact @ #x~X>~%" (-> this impact-info))
  (format #t "~1Trbody: #<rigid-body-control @ #x~X>~%" (-> this rbody-data))
  (label cfg-4)
  this
  )

;; og:preserve-this rigid-body rung: max-ang-momentum/max-ang-velocity/pid/
;; step-count confirmed scalar at 0/4/8/12 against (method 3 rigid-body-work)'s
;; own inspect print in this rung's own scoped decode. debug-history itself
;; prints only "debug-history[16] @ #x~X~%" (address plus a bracketed count,
;; GOAL's boilerplate for an inline array field whose element type has no
;; scalar formatter), so the element TYPE is not recoverable from this
;; evidence, only the element COUNT (16) and the total extent (size-assert
;; 0x1c10 minus the 16-byte header leaves 7168 bytes, exactly 16 x 448).
;; Landed as a flat byte pad rather than a 16-element array of an invented
;; 448-byte record type, the same call rb-perf-data's own pad fields already
;; made for this file family: debug-only telemetry, not on the M1 path.
;; Retirement condition: a decode of whatever function actually writes into
;; this range would resolve the per-element layout.
(deftype rigid-body-work (structure)
  ((max-ang-momentum float          :offset-assert 0)
   (max-ang-velocity float          :offset-assert 4)
   (pid              uint32         :offset-assert 8)
   (step-count       int8           :offset-assert 12)
   (pad-pre-history  uint8   3      :offset-assert 13) ;; extent-true, step-count ends at 13 and debug-history's own proven offset is 16
   (debug-history    uint8   7168   :offset-assert 16)
   )
  :method-count-assert 9
  :size-assert         #x1c10
  :flag-assert         #x900001c10
  )

(defmethod inspect ((this rigid-body-work))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'rigid-body-work)
  (format #t "~1Tmax-ang-momentum: ~f~%" (-> this max-ang-momentum))
  (format #t "~1Tmax-ang-velocity: ~f~%" (-> this max-ang-velocity))
  (format #t "~1Tpid: ~D~%" (-> this pid))
  (format #t "~1Tstep-count: ~D~%" (-> this step-count))
  (format #t "~1Tdebug-history[16] @ #x~X~%" (-> this debug-history))
  (label cfg-4)
  this
  )

(define *rigid-body-work* (new 'static 'rigid-body-work))

