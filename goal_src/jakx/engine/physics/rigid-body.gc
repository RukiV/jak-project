;; og:preserve-this rigid-body-control-integrator rung: config-cured, matches
;; jak3's own slot 14 body-for-body (a stack quaternion built from
;; ang-velocity with w zeroed, then quaternion*!/quaternion-float*! against
;; it in place, then this file's own method 28 called self-only). The prior
;; rung's "Failed store" (a local stack quaternion address computed as a
;; plain pointer offset rather than a field-address-of) needed a
;; type_casts.jsonc range-cast to "(pointer uint128)" for the whole-quad copy
;; at the top; a single-op cast at the same point left it unresolved.
(defmethod rigid-body-control-method-14 ((this rigid-body-control) (arg0 float))
  (rlet ((acc :class vf)
         (vf0 :class vf)
         (vf4 :class vf)
         (vf5 :class vf)
         (vf6 :class vf)
         (vf7 :class vf)
         )
