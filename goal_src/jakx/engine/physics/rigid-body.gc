(defmethod new rigid-body-control ((allocation symbol) (type-to-make type) (arg0 process))
  (let ((v0-0 (object-new allocation type-to-make (the-as int (-> type-to-make size)))))
    (set! (-> v0-0 process) arg0)
    v0-0
    )
  )

(defmethod relocate ((this rigid-body-control) (offset int))
  (&+! (-> this process) offset)
  this
  )

;; og:preserve-this rigid-body-control-integrator rung: config-cured. The
;; prior rung's "Failed load" (a 3-iteration loop reading this + v1*20 + 112,
;; the inv-inertial-tensor's three diagonal entries at offsets 112/132/152)
;; needed only a type_casts.jsonc cast of the loop-index pointer arithmetic
;; to "(pointer float)"; the raw decode is otherwise clean and matches the
;; diagonal-inertia-tensor derivation its own field names describe. Called
;; from rigid-body-control-method-29/init! below.
(defmethod rigid-body-info-method-9 ((this rigid-body-info))
  (let ((f24-0 (-> this mass))
        (f28-0 (-> this inertial-tensor-box 0))
        (f30-0 (-> this inertial-tensor-box 1))
        (f26-0 (-> this inertial-tensor-box 2))
        )
    (let ((f0-0 f24-0))
      (set! (-> this inv-mass) (/ 1.0 f0-0))
      )
    (matrix-identity! (-> this inertial-tensor))
    (matrix-identity! (-> this inv-inertial-tensor))
    (let ((f0-4 (/ f24-0 12)))
      (set! (-> this inertial-tensor rvec x) (* f0-4 (+ (square f30-0) (square f26-0))))
      (set! (-> this inertial-tensor uvec y) (* f0-4 (+ (square f28-0) (square f26-0))))
      (set! (-> this inertial-tensor fvec z) (* f0-4 (+ (square f28-0) (square f30-0))))
      )
    )
  (let ((f0-6 (-> this inertial-tensor rvec x)))
    (set! (-> this inv-inertial-tensor rvec x) (/ 1.0 f0-6))
    )
  (let ((f0-9 (-> this inertial-tensor uvec y)))
    (set! (-> this inv-inertial-tensor uvec y) (/ 1.0 f0-9))
    )
  (let ((f0-12 (-> this inertial-tensor fvec z)))
    (set! (-> this inv-inertial-tensor fvec z) (/ 1.0 f0-12))
    )
  (let ((f0-15 0.0))
    (dotimes (v1-17 3)
      (set! f0-15 (fmax f0-15 (-> (the-as (pointer float) (+ (+ (* v1-17 4) (* v1-17 16)) (the-as int this))) 28)))
      )
    (set! (-> this max-ang-momentum) (* 50.26548 f0-15))
    )
  0
  (none)
  )

;; og:preserve-this rigid-body-object rung: retyped from a bare "none"
;; return, which fails to compile ("get_preferred_reg_class called on
;; NullType") the moment a caller actually uses the result. (method 69
;; rigid-body-object)'s own body is the evidence: the call's result is
;; tested for truthiness, compared against (-> this info) (a
;; rigid-body-object-constants), and passed straight through to (method
;; 68 rigid-body-object)'s arg0 (itself cast to rigid-body-object-constants
;; inside that method), all consistent with "return a possibly-different
;; constants block, or #f if there is none". This rung's own clean decode of
;; the body confirms it exactly.
(defmethod rigid-body-object-constants-method-9 ((this rigid-body-object-constants))
  (let ((v0-0 (the-as object #f)))
    (let ((v1-0 (-> this name)))
      (if (nonzero? v1-0)
          (set! v0-0 (-> v1-0 value))
          )
      )
    (the-as rigid-body-object-constants v0-0)
    )
  )

(defun matrix-3x3-triple-transpose-product ((arg0 matrix) (arg1 matrix) (arg2 matrix))
  (let ((s5-0 (new 'stack-no-clear 'inline-array 'matrix 3)))
    (matrix-copy! (-> s5-0 0) arg1)
    (vector-reset! (-> s5-0 0 trans))
    (matrix-transpose! (-> s5-0 1) (-> s5-0 0))
    (matrix*! (-> s5-0 2) arg2 (-> s5-0 0))
    (matrix*! arg0 (-> s5-0 1) (-> s5-0 2))
    )
  arg0
  )

(defmethod rigid-body-control-method-16 ((this rigid-body-control))
  (set! (-> this force quad) (the-as uint128 0))
  (set! (-> this torque quad) (the-as uint128 0))
  0
  (none)
  )

(defmethod rigid-body-control-method-17 ((this rigid-body-control))
  (set! (-> this lin-momentum quad) (the-as uint128 0))
  (set! (-> this ang-momentum quad) (the-as uint128 0))
  0
  (none)
  )

