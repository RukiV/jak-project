;; set-velocity/derive-momentum pair with method 32 below as its angular
;; counterpart.
(defmethod rigid-body-control-method-31 ((this rigid-body-control) (arg0 vector))
  (set! (-> this lin-velocity quad) (-> arg0 quad))
  (vector-float*! (-> this lin-momentum) arg0 (-> this info mass))
