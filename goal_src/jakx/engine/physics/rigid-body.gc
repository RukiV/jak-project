;; og:preserve-this rigid-body rung: angular counterpart of method 31 above,
;; no jak3 twin. Sets this.ang-velocity from the given vector directly and
;; derives this.ang-momentum by rotating it through a matrix-3x3-triple-
;; transpose-product of this.matrix and this.info.inertial-tensor.
(defmethod rigid-body-control-method-32 ((this rigid-body-control) (arg0 vector))
  (let ((s5-0 (new 'stack-no-clear 'matrix)))
    (matrix-3x3-triple-transpose-product
      (the-as matrix (-> s5-0 rvec))
      (-> this matrix)
      (-> this info inertial-tensor)
      )
    (set! (-> this ang-velocity quad) (-> arg0 quad))
    (vector-rotate*! (-> this ang-momentum) arg0 (the-as matrix (-> s5-0 rvec)))
    )
  0
  (none)
  )

;; og:preserve-this rigid-body rung: no jak3 twin. Scales (position - arg0)
