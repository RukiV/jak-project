;; og:preserve-this rigid-body-control-integrator rung: the rigid-body
;; rung's own arity guess (at least 3 explicit registers, unresolved past
;; that) is superseded by a real call site: rbody-collision below dispatches
;; this at machine offset 116 with arg0 = its own rbody2 field (a nullable
;; rigid-body-control) and arg1 = its own impact-info2 field (a rigid-body-
;; impact), then runs the integer return through gpr->fpr and multiplies by
;; 0.5, proving a float return; rigid-body-h.gc's own :methods entry carries
;; the corrected signature. The prior rung's "Failed to guess stack use for
;; 16" needed a stack_structures.jsonc entry (a local rigid-body-impact
;; scratch copy) once the signature was fixed. Still does not match any
;; single jak3 rigid-body-control method body-for-body; closer to a fragment
;; of jak3's own rbody-collision than a plain accessor.
(defmethod rigid-body-control-method-25 ((this rigid-body-control) (arg0 rigid-body-control) (arg1 rigid-body-impact))
  (let ((gp-0 (new 'stack-no-clear 'rigid-body-impact)))
    (set! (-> gp-0 velocity x) (+ -4096.0 (vector-dot (-> arg1 velocity) (-> arg1 normal))))
    (set! (-> gp-0 velocity w) 0.0)
    (set! (-> gp-0 velocity y) 0.0)
    (set! (-> gp-0 velocity z) 0.0)
    (when (< (-> gp-0 velocity x) 0.0)
      (vector-! (-> gp-0 point) (-> arg1 point) (-> this position))
      (vector-cross! (-> gp-0 normal) (-> gp-0 point) (-> arg1 normal))
      (vector-rotate*! (-> gp-0 normal) (-> gp-0 normal) (-> this inv-i-world))
      (vector-cross! (-> gp-0 normal) (-> gp-0 normal) (-> gp-0 point))
      (set! (-> gp-0 velocity y) (+ (-> this info inv-mass) (vector-dot (-> arg1 normal) (-> gp-0 normal))))
      (when arg0
        (vector-! (-> gp-0 point) (-> arg1 point) (-> arg0 position))
        (vector-cross! (-> gp-0 normal) (-> gp-0 point) (-> arg1 normal))
        (vector-rotate*! (-> gp-0 normal) (-> gp-0 normal) (-> arg0 inv-i-world))
        (vector-cross! (-> gp-0 normal) (-> gp-0 normal) (-> gp-0 point))
        (set! (-> gp-0 velocity z) (+ (-> arg0 info inv-mass) (vector-dot (-> arg1 normal) (-> gp-0 normal))))
        )
      (set! (-> gp-0 velocity w) (* (- (-> gp-0 velocity x)) (/ 1.0 (+ (-> gp-0 velocity y) (-> gp-0 velocity z)))))
      )
    (-> gp-0 velocity w)
    )
  )

;; og:preserve-this rigid-body-control-integrator rung: config-cured. jak3's
;; own named rbody-collision (goal_src/jak3/engine/physics/rigid-body.gc),
;; the core collision-resolution body rigid-body-control-method-9 above
