;;-*-Lisp-*-
(in-package goal)

;; name: logic-target.gc
;; name in dgo: logic-target
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

;; og:preserve-this bring-up lever, rung 2 (#164): #160 bound view-set-active-target,
;; so every 'play-mode init now registers the view target silently once the nonzero?
;; guard in start (below) passes. This flag makes that registration deliberate and
;; flippable from a REPL for A/B instead of happening as a side effect of the symbol
;; landing. Default #t preserves the current empirical behavior (three crash-free
;; boots at this tip today). Mirrors the *jakx-cam-start* lever idiom (cam-start.gc).
;; Retires when target registration is a settled, always-on default and the A/B lever
;; is no longer needed.
(define *jakx-view-target* #t)

;; og:preserve-this forward-decl, R5a (#122): reset-target-state below guards a call to
;; this function (unlanded; raw_obj link-table grep shows it referenced from four
;; objects, including target-death.go, none of which is landed yet); the compiler
;; needs the symbol's type to check the guarded call. The decompiler-side extern
;; (all-types.gc) is visibility-only and does not reach the compiler, mirroring the
;; lesson from view-set-active-target in R4. Retires when the real owning object lands.
(define-extern target-exit (function none :behavior target))

;; og:preserve-this forward-decl (scene chain, issue 522): target-generic-event-handler
;; is landed and real (target-handler.gc), but that file compiles after this one in the
;; build order, so its symbol is not yet visible here; target-continue's own bring-up
;; 'change-mode stand-in below falls back to it for every non-grab message. Same
;; compile-order class as target-exit's forward-decl above, evidenced against
;; all-types.gc's own extern signature (line 49210). Retires if the build order ever
;; changes to compile target-handler.gc first, or does not retire at all otherwise
;; (a forward-decl for a real, landed function is not itself a hold).
(define-extern target-generic-event-handler (function process int symbol event-message-block object :behavior target))

;; og:preserve-this stop, landed for real, R4 (#122): transcribed verbatim from the
;; R0-corrected decode (logic-target_ir2.asm). arg1 is the view-push-context int the
;; original 1-arg signature dropped (R0 RESULTS ADDENDUM item 4; the fix lives on
;; stop's extern in all-types.gc and mirrors in level.gc's and game-info.gc's forward
;; declares). stop is already live at boot (play calls it at level.gc:3013 with no
;; target present), so the null path here, view-get-active-target returning #f and
;; skipping the whole (when ...), is the one that must be right first time.
(defun stop ((arg0 symbol) (arg1 int))
  (view-push-context arg1)
  (format 0 "stop: ~D ~A~%" arg1 (view-get-active-target))
  (when (view-get-active-target)
    (deactivate (view-get-active-target))
    ;; og:preserve-this runtime-link guard, R4 (#122): view-set-active-target's extern
    ;; is uncommented in all-types.gc for decompiler visibility only (kill-current-
    ;; talker precedent, R3a); view.o's body is still unlanded (only its siblings
    ;; view-set-active-camera and view-set-active-camera-combiner are). Retires when
    ;; view-set-active-target lands for real in view.gc.
    (if (nonzero? view-set-active-target)
        (view-set-active-target (the-as basic #f))
        )
    )
  (set! (-> *game-info* mode) arg0)
  (view-pop-context)
  0
  )

;; og:preserve-this bring-up stub, R5a (#122): target-init dispatches here
;; unconditionally on every target spawn (the widened arity below matches target-h.gc's
;; own note; the old zero-arg signature undercounted, the same class of bug stop had
;; before R4), so an unset vtable slot would crash immediately the first time a target
;; is born, the entity-race-mesh zero-slot class of bug named in the leg's risk
;; register (item 2). The real body (logic-target_ir2.asm) resolves past the arity fix
;; but still fails type prop at op 167 ("add failed: object <integer 12>"), deep past
;; allow-pause/allow-progress setting-control calls and a game-info continue-point
;; lookup. Retirement condition: a future rung resolves that load.
;;
;; og:preserve-this partial arming (scene chain, issue 522): the stub now
;; carries ONE of the real body's 91 field initializations, current-level to
;; #f, mirroring jak3's target-init! (jak3 logic-target.gc:3035). Without it
;; the field stays raw zero (EE RAM zeroes at startup, and 0 is truthy in
;; GOAL), and scene-player's wait state faults at scene.gc's
;; current-level name read, disassembly-proven as the intro-missile probe's
;; scene+0x53f9 crash: the (and ...) guard there tests only #f, retail's own
;; correct shape given an initialized field. The class recurs for any other
;; of the real body's fields that landed code reads (next-state is the
;; nearest known candidate, scene.gc's wait state reads it two lines
;; further); those get armed the same way as probes surface them, until the
;; op-167 wall above falls and the real body lands.
(defmethod target-method-59 ((this target) (arg0 basic) (arg1 symbol))
  (set! (-> this current-level) #f)
  (none)
  )

;; og:preserve-this bring-up state, R10 (#122): target-h.gc's :states list reserves
;; the symbol target-continue (deftype.cpp's own :states handling creates the global),
;; but nothing in this tree ever landed a real (defstate target-continue ...); the
;; symbol existed with no backing state object. target-init's (go target-continue)
;; call dispatches into the kernel's enter-state machinery (gkernel.gc), which reads
;; the state object's handler slots to set the process up; with no real object behind
;; the symbol those slots were whatever memory happened to hold, read as an all-ones
;; pattern (a native crash reading GOAL address 0xffffffffffffffff, rip inside gk.exe,
;; not GOAL code: the R10 boot crash, attributed to logic-target+0x62, the return
;; address of stop's own (view-get-active-target) call sitting on the stack from
;; start's earlier (stop arg0 arg2), one frame up from the real fault in the kernel's
;; state-entry code, and to gkernel+0xf54 directly). The real target-continue state
;; (movement/physics :code, :trans on continue triggers, camera framing) is
;; substantial, undecoded behavior, not a guard or a stub; the honest minimal fix is
;; the same shape as generic-obs.gc's bring-up-parked (:code sleep-code only, exactly
;; the "state exists and is not garbage" precedent this leg has already used twice):
;; a real, correctly-typed, all-other-slots-#f state object stands in for the racing
;; continue-arrival behavior. Retirement condition: the real target-continue state
;; lands (movement, physics, camera-framing logic; a separate leg's scope).
;; og:preserve-this arity widened to match target-h.gc's :states entry, (target-continue
;; continue-point): (code target-continue)'s own decode evidence (target-death.gc, R5b)
;; proves the real state reads a continue-point's name field, so target-h.gc's bare
;; zero-arg guess was corrected. This stub's :code still wraps sleep-code verbatim,
;; only now behind a (continue-point) arg to satisfy the widened typecheck; behavior is
;; unchanged. Retirement condition unchanged from above.
;;
;; og:preserve-this bring-up 'change-mode stand-in (scene chain, issue 522):
;; target-continue's own :event slot is still unlanded (the stub note above), so
;; event-hook never gets set to a live handler and gstate.gc's send-event-function
;; guard (its own event-hook check) drops every event sent to a target parked here,
;; including process-grab?'s handshake (generic-obs.gc:1690, sends ('change-mode
;; 'grab #t) via command-get-process). scene.gc:1110-1116 retries that handshake
;; every frame until it sees a truthy answer, so the scene-player's wait state never
;; advances. A fresh scoped decode of target-handler.gc today (target-standard-
;; event-handler, 2 errors: an unresolved type-prop load and an unsupported inline
;; sllv) shows its own 'change-mode dispatch only branches on the pilot-mode symbols
;; and 'normal; a bare 'grab param0 matches neither arm, and both the matched
;; branch's delay slot and the fallthrough path set v0-0 to #f (L21/L22 in the
;; disasm), so landing that function once its own decode errors are resolved would
;; not answer this handshake either. This stand-in answers 'grab truthily without
;; moving the target into any real grab state; retail's own grab semantics (parking
;; the target, disabling control) are out of scope here, matching target-title's own
;; precedent for the same message (title-obs.gc:717). Retirement condition: the real
;; target-continue state lands its own :event (same condition as the stub note
;; above).
;;
;; og:preserve-this partial arming (issue 595, region-mode dossier): the real
;; :exit's own decoded evidence sits held in target-death.gc's commented block
;; (:exit line "(set! (-> *setting-control* user-default region-mode) (the-as
;; basic #t))", held whole since 5372bb41e alongside :code/:event's unrelated
;; decode failures) and jak3's own landed twin agrees verbatim in shape
;; (goal_src/jak3/engine/target/target-death.gc:472, "(set! (-> *setting-control*
;; user-default region-mode) #t)"). start (above in this file, and its jak3 twin
;; at logic-target.gc:3117) unconditionally clears user-default region-mode to #f
;; on every level-start, retail-faithful; retail undoes that clear here, on the
;; continue-arrival this bring-up stub already stands in for. With this stub
;; carrying no :exit at all, the clear was never undone: region-mode stuck #f
;; forever post level-start, evidenced live by the jakx-region-driver diagnosis
;; boot (issue 595) reading user-default AND user-current region-mode #f despite
;; settings.gc:2056's own init store writing #t, and confirmed self-consistent
;; (a REPL write to user-default propagated to user-current and armed the whole
;; region driver gate) rather than an offset defect. Same shape as target-
;; method-59's own partial arming above: one field of the real body's :exit armed
;; by citation, not the whole handler. Retires when the real target-continue
;; :exit lands (movement, physics, camera-framing logic; same leg as target-
;; method-59's retirement condition).
;;
;; og:preserve-this want-copy finding (title-continue chain, this rung): a fresh
;; scoped decode of target-death (scratch, --config-override allowed_objects
;; ["target-death"], this worktree's own types) settles whether the held :code
;; above touches wants before it hits its own wall, further than the existing
;; hold note above needed to go. It does. Raw ops 228/231/239 (`lb`/`lwu` at
;; gp+97/gp+100, gp holding the continue-point arg) read want-count and the want
;; array's base pointer -- raw load offset N binds to the field placed at
;; :offset-assert N+4 for a basic (all-types.gc: want-count 101, want 104), so
;; these are exactly continue-point's own want-count/want fields, not a
;; mistyped read. Ops 233-245 copy each entry's name (+0) and second word (+4)
;; into *load-state* at i*32 for i < want-count; ops 247-260 clear the same two
;; words to #f for the remaining slots up to 6, and two more trailing words
;; (+8/+12) are zeroed unconditionally every iteration. A second, one-shot loop
;; (ops 270-282, raw gp+104 = want-sound's own :offset-assert 108) copies
;; want-sound into *load-state*+1944 and writes a constant 4 into +1948. This is
;; a genuine want-copy, the same structural shape as jak3's own landed
;; target-continue :code. It is a separate mechanism from the want-driver
;; docstring above jakx-want-driver-tick (level.gc:7998): that note is about
;; level-update's per-frame continue block and net-world's race-window staging,
;; which it shows do not touch wants; this is target-continue's own one-time
;; continue-arrival copy, and the two do not contradict each other. Recorded
;; here because it bears on this stub's eventual retirement: whatever replaces
;; sleep-code needs to either perform this copy or prove it is already
;; redundant with the net-world path before dropping it. Retires with the same
;; condition as the :code hold above.
(defstate target-continue (target)
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('change-mode)
       (case (-> block param 0)
         (('grab)
          #t
          )
         )
       )
      (else
        (target-generic-event-handler proc argc message block)
        )
      )
    )
  :exit (behavior ()
    (set! (-> *setting-control* user-default region-mode) (the-as basic #t))
    )
  :code (behavior ((arg0 continue-point))
    (sleep-code)
    )
  )

;; og:preserve-this landed for real, R5a (#122): transcribed verbatim from the decode.
;; The vtable dispatch into target-method-59 (logic-target_ir2.asm op 3-6, method
;; offset 252 = slot 59) only resolved to this clean high-level form once that
;; method's own arity was widened (target-h.gc); it stays a bring-up stub for the
;; reasons noted there, but target-init's own call is real.
(defbehavior target-init target ((arg0 basic))
  (target-method-59 self arg0 #f)
  ;; og:preserve-this bare trsqv root, rung 3a (#164): mirrors manipy-init's arg3=#f
  ;; path verbatim (generic-obs.gc, the (else ...) cond branch of its root
  ;; construction) - the same safe shape here, a bare trsqv with no collide-shape and
  ;; still no draw-control, so the joins-nothing analysis from the rung-1 map stays
  ;; true. Root nonzero means rung 2's guard in target-get-any-pos now passes by
  ;; design rather than blocking, so the sky's time-of-day path reads a real trans
  ;; instead of the camera fallback. Seeded from *jakx-want-driver-cp* (the same
  ;; continue trans jakx-racer-spawn uses for the manipy's spawn position) when a
  ;; boot continue is armed, so the target starts at a sane in-world point rather
  ;; than a zero-origin out-of-world one; left at the trsqv's own defaults otherwise.
  ;; Retires when the real vehicle chain gives the target its retail root (rung 3b,
  ;; a separate later change, out of scope here).
  (set! (-> self root) (the-as collide-shape (new 'process 'trsqv)))
  (if *jakx-want-driver-cp*
      (set! (-> self root trans quad) (-> *jakx-want-driver-cp* trans quad))
      )
  (set! (-> self event-hook) (-> target-continue event))
  (logior! (-> self focus-status) (focus-status teleporting))
  ;; og:preserve-this arg0 restored (title-continue chain, this rung): R5b's
  ;; *jakx-want-driver-cp* substitution above was an invented stand-in, made when
  ;; target-continue's arity was widened and never itself decoded; a fresh scoped
  ;; decode of this object (logic-target_ir2.asm, worktree's own types, this rung)
  ;; shows target-init itself decodes 100% clean with zero errors, and its own op
  ;; 19 (`jalr ra, t9` through `t9 = enter-state`, `a0 = arg0`) is the real
  ;; enter-state dispatch the `go` macro sugars over, with `self+76` (the state
  ;; slot) set to target-continue two ops earlier (op 18) -- retail passes
  ;; target-init's own arg0, cast to continue-point, not the want-driver global.
  ;; jak3's twin (jak3/engine/target/logic-target.gc:3056, `(go target-continue
  ;; arg0)`) shows the same shape with no fallback, corroborating but not the
  ;; proof; the jakx decode itself is. Dropping arg0 here meant every target spawn
  ;; entered target-continue against whatever continue net-world/the boot path had
  ;; last staged in *jakx-want-driver-cp*, not the continue-point start actually
  ;; passed to this spawn.
  (go target-continue (the-as continue-point arg0))
  (none)
  )

;; og:preserve-this landed for real, R5a (#122): transcribed verbatim. Two
;; view-set-active-target calls, both guarded per the kill-current-talker/stop
;; precedent (view.o's body is still unlanded). (stop arg0 arg2) reuses the same
;; view-push-context arg as the context index, matching the raw op sequence.
(defun start ((arg0 symbol) (arg1 basic) (arg2 int))
  (let ((v1-0 arg0))
    (set! (-> *level* play?) (if (= v1-0 'play)
                                 #t
                                 (-> *setting-control* user-default border-mode)
                                 )
          )
    )
  (set! (-> *setting-control* user-default border-mode) #f)
  (set! (-> *setting-control* user-default region-mode) #f)
  (setting-control-method-23 *setting-control*)
  (if (not arg1)
      (set! arg1 (the-as basic (game-info-method-17 *game-info* arg2)))
      )
  (let ((s3-0 (the-as process #f)))
    (view-push-context arg2)
    (stop arg0 arg2)
    (let ((v1-11 (process-spawn
                   target
                   :init target-init
                   (the-as object arg1)
                   :name "target"
                   :from *target-dead-pool*
                   :to *target-pool*
                   :stack *kernel-dram-stack*
                   )
                 )
          )
      (cond
        (v1-11
          (if (and *jakx-view-target* (nonzero? view-set-active-target))
              (view-set-active-target (-> v1-11 0 self))
              )
          (set! s3-0 (view-get-active-target))
          )
        (else
          (if (nonzero? view-set-active-target)
              (view-set-active-target (the-as basic #f))
              )
          )
        )
      )
    (view-pop-context)
    (the-as target s3-0)
    )
  )

;; og:preserve-this landed for real, R5a (#122): transcribed verbatim. Two-player boot
;; entry point (sets *view-count* 2, spawns both targets via start, configures a
;; two-way viewport split); no captured signature existed, derived from the body (see
;; all-types.gc's note on the extern).
(defun start-2 ()
  (set! *view-count* 2)
  (start 'play (the-as basic (-> *level* level2 info continues car)) 0)
  (start 'play (the-as basic (-> *level* level2 info continues car)) 1)
  (viewport-array-method-9 *viewport-array* (the-as viewport 2))
  (none)
  )

;; og:preserve-this landed for real, R5a (#122): transcribed verbatim from the decode.
;; target-exit is guarded per the kill-current-talker/view-set-active-target precedent:
;; the extern is uncommented in all-types.gc for decompiler visibility only; raw_obj
;; link-table grep shows it referenced from four objects including target-death.go,
;; none of which is R5a's, so its owning object is unknown but definitely not landed
;; here. Retires when whichever object defines it lands.
(defbehavior reset-target-state target ((arg0 symbol))
  (when arg0
    (vector-identity! (-> self root scale))
    (quaternion-identity! (the-as quaternion (-> self root rot)))
    (set! (-> self root transv quad) (the-as uint128 0))
    )
  (if (nonzero? target-exit)
      (target-exit)
      )
  (set! (-> self cam-user-mode) 'normal)
  (buzz-stop! 0)
  self
  )

;; og:preserve-this landed for real, R5a (#122): transcribed verbatim, decodes clean.
(defbehavior target-real-post target ()
  (quaternion-copy! (the-as quaternion (-> self root rot)) (-> self root dir-targ))
  (none)
  )

;; og:preserve-this landed for real, R5a (#122): transcribed verbatim; one-line tail
;; call to target-real-post.
(defbehavior target-post target ()
  (target-real-post)
  0
  (none)
  )

;; og:preserve-this landed for real, R5a (#122): transcribed verbatim, same
;; quaternion-copy! shape as target-real-post.
(defbehavior target-no-move-post target ()
  (quaternion-copy! (the-as quaternion (-> self root rot)) (-> self root dir-targ))
  0
  (none)
  )
