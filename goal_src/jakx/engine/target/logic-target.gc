;;-*-Lisp-*-
(in-package goal)

;; name: logic-target.gc
;; name in dgo: logic-target
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

;; og:preserve-this bring-up lever, rung 2 (#164): #160 bound view-set-active-target,
;; so every 'play-mode init now registers the view target silently once the nonzero?
;; guard in start (below) passes. This flag makes that registration deliberate and
;; flippable from a REPL for A/B instead of happening as a side effect of the symbol
;; landing. Default #t preserves the current empirical behavior (three crash-free
;; boots at this tip today). Mirrors the *jakx-cam-start* lever idiom (cam-start.gc).
;; Retires when target registration is a settled, always-on default and the A/B lever
;; is no longer needed.
(define *jakx-view-target* #t)

;; og:preserve-this forward-decl, R5a (#122): reset-target-state below guards a call to
;; this function (unlanded; raw_obj link-table grep shows it referenced from four
;; objects, including target-death.go, none of which is landed yet); the compiler
;; needs the symbol's type to check the guarded call. The decompiler-side extern
;; (all-types.gc) is visibility-only and does not reach the compiler, mirroring the
;; lesson from view-set-active-target in R4. Retires when the real owning object lands.
(define-extern target-exit (function none :behavior target))

;; og:preserve-this forward-decl (scene chain, issue 522): target-generic-event-handler
;; is landed and real (target-handler.gc), but that file compiles after this one in the
;; build order, so its symbol is not yet visible here; target-continue's own bring-up
;; 'change-mode stand-in below falls back to it for every non-grab message. Same
;; compile-order class as target-exit's forward-decl above, evidenced against
;; all-types.gc's own extern signature (line 49210). Retires if the build order ever
;; changes to compile target-handler.gc first, or does not retire at all otherwise
;; (a forward-decl for a real, landed function is not itself a hold).
(define-extern target-generic-event-handler (function process int symbol event-message-block object :behavior target))

;; og:preserve-this forward-decl (title-continue chain, this rung): target-
;; standard-event-handler is landed and real (target-handler.gc), but that
;; file compiles after this one in the build order, the same compile-order
;; class as target-generic-event-handler's own forward-decl above.
;; target-continue's real :code (below) assigns it straight into self's own
;; event-hook field on the mode-cache re-dispatch path, evidenced against
;; all-types.gc's own extern signature (line 49460). Retires under the same
;; condition as the entry above.
(define-extern target-standard-event-handler (function process int symbol event-message-block object :behavior target))

;; og:preserve-this forward-decl (title-continue chain, this rung): target-
;; no-move-post is landed and real, later in this same file (below), but
;; target-continue's own :post field (its defstate sits earlier in the file)
;; is a bare symbol reference the compiler resolves immediately, not a
;; deferred call; "The symbol target-no-move-post was looked up as a global
;; variable, but it does not exist" is the same single-file forward-reference
;; class the two entries above solve across file boundaries, just within one
;; file instead. Retires if target-continue's defstate is ever moved below
;; target-no-move-post's own definition, or does not retire at all otherwise
;; (a forward-decl for a real, landed function is not itself a hold).
(define-extern target-no-move-post (function none :behavior target))

;; og:preserve-this forward-decl (title-continue chain, this rung): reset-
;; target-state is landed and real, later in this same file (below), but
;; target-continue's own :code (its defstate sits earlier in the file) calls
;; it directly; the same single-file forward-reference class as the
;; target-no-move-post entry above ("No method or function named
;; reset-target-state for type symbol", the compiler's own fallback reading
;; of an unresolved call as a method dispatch on the first arg's type).
;; Retires under the same condition as that entry.
(define-extern reset-target-state (function symbol target :behavior target))

;; og:preserve-this forward-decl (title-continue chain, this rung): four more
;; symbols target-continue's own real :code (below) calls or reads, all
;; landed and real in target-death.gc, which compiles after this file in the
;; build order (same class as target-generic-event-handler's own forward-decl
;; above, just against a different file). target-continue-init-art is a
;; zero-arg bring-up stub (target-death.gc); arrive-at-continue and
;; next-continue are both landed for real there too; *auto-continue* is a
;; plain symbol define, hitting the same "looked up as a global variable, but
;; it does not exist" class the target-no-move-post entry above hit, just
;; across a file boundary instead of within one. Retires if the build order
;; ever changes to compile target-death.gc before this file.
(define-extern target-continue-init-art (function none :behavior target))
(define-extern arrive-at-continue (function continue-point none :behavior target))
(define-extern next-continue (function continue-point continue-point))
(define-extern *auto-continue* symbol)

;; og:preserve-this stop, landed for real, R4 (#122): transcribed verbatim from the
;; R0-corrected decode (logic-target_ir2.asm). arg1 is the view-push-context int the
;; original 1-arg signature dropped (R0 RESULTS ADDENDUM item 4; the fix lives on
;; stop's extern in all-types.gc and mirrors in level.gc's and game-info.gc's forward
;; declares). stop is already live at boot (play calls it at level.gc:3013 with no
;; target present), so the null path here, view-get-active-target returning #f and
;; skipping the whole (when ...), is the one that must be right first time.
(defun stop ((arg0 symbol) (arg1 int))
  (view-push-context arg1)
  (format 0 "stop: ~D ~A~%" arg1 (view-get-active-target))
  (when (view-get-active-target)
    (deactivate (view-get-active-target))
    ;; og:preserve-this runtime-link guard, R4 (#122): view-set-active-target's extern
    ;; is uncommented in all-types.gc for decompiler visibility only (kill-current-
    ;; talker precedent, R3a); view.o's body is still unlanded (only its siblings
    ;; view-set-active-camera and view-set-active-camera-combiner are). Retires when
    ;; view-set-active-target lands for real in view.gc.
    (if (nonzero? view-set-active-target)
        (view-set-active-target (the-as basic #f))
        )
    )
  (set! (-> *game-info* mode) arg0)
  (view-pop-context)
  0
  )

;; og:preserve-this bring-up stub, R5a (#122): target-init dispatches here
;; unconditionally on every target spawn (the widened arity below matches target-h.gc's
;; own note; the old zero-arg signature undercounted, the same class of bug stop had
;; before R4), so an unset vtable slot would crash immediately the first time a target
;; is born, the entity-race-mesh zero-slot class of bug named in the leg's risk
;; register (item 2). The real body (logic-target_ir2.asm) resolves past the arity fix
;; but still fails type prop at op 167 ("add failed: object <integer 12>"), deep past
;; allow-pause/allow-progress setting-control calls and a game-info continue-point
;; lookup. Retirement condition: a future rung resolves that load.
;;
;; og:preserve-this partial arming (scene chain, issue 522): the stub now
;; carries ONE of the real body's 91 field initializations, current-level to
;; #f, mirroring jak3's target-init! (jak3 logic-target.gc:3035). Without it
;; the field stays raw zero (EE RAM zeroes at startup, and 0 is truthy in
;; GOAL), and scene-player's wait state faults at scene.gc's
;; current-level name read, disassembly-proven as the intro-missile probe's
;; scene+0x53f9 crash: the (and ...) guard there tests only #f, retail's own
;; correct shape given an initialized field. The class recurs for any other
;; of the real body's fields that landed code reads (next-state is the
;; nearest known candidate, scene.gc's wait state reads it two lines
;; further); those get armed the same way as probes surface them, until the
;; op-167 wall above falls and the real body lands.
(defmethod target-method-59 ((this target) (arg0 basic) (arg1 symbol))
  (set! (-> this current-level) #f)
  (none)
  )

;; og:preserve-this landed for real (title-continue chain, this rung): the R10
;; bring-up state, its arity-widened follow-up, the issue-522 'change-mode
;; stand-in, and the want-copy finding (all formerly here) are retired by this
;; landing; their history is folded into this one note rather than kept
;; separately. :code and :event, held raw since 5372bb41e at target-death.gc
;; (op 558 "add failed: basic <integer 140>", op 486 stack-use guess failure,
;; op 18 an untyped event-message-block load, plus two unsupported inline sllv
;; sites), now decode 100% clean. Every wall fell to decompiler-config-only
;; fixes (type_casts.jsonc/stack_structures.jsonc under decompiler/config/
;; jakx/ntsc_v1/); no goal_src changes were needed to unblock them:
;;
;;  1. (event target-continue) op 18: a0 (event-message-block's own param[1],
;;     the raw process being process->handle'd in the 'change-mode else-arm,
;;     gkernel-h.gc:463-465) was untyped where it reads process-tree's own
;;     ppointer field (raw 28, declared 32 via the +4 basics trap). Cast a0 to
;;     process at that one op; the rest of the chain (the ppointer deref, the
;;     pid read, both sllv-r0 truncations) resolved with no further casts,
;;     the same shape as (event othercam-running)'s own a0-at-op-41 entry.
;;  2. (code target-continue) ops 558/564: two view-get-active-camera-combiner
;;     results (declared plain basic) read at raw 140/156 (declared 144/160,
;;     trans/inv-camera-rot). Cast v0 to camera-combiner at both failing ops,
;;     mirroring debug-set-camera-pos-rot!'s own two-call-site precedent.
;;  3. (code target-continue) op 826/829: self's own root field re-read at raw
;;     284 (declared 288), collide-shape-moving's status field, the same one
;;     target-generic-event-handler's existing [253]/[256] entries already
;;     cast. Cast v1/a0 to collide-shape-moving at the read and the write.
;;  4. (code target-continue) op 486/501: two (new 'stack 'script-context ...)
;;     allocations for (script-eval '(teleport)) and (script-eval (the-as
;;     pair (-> arg0 on-goto))), matching jak3's own twin call shape
;;     (target-death.gc:680-681). Added stack_structures.jsonc hints at
;;     offsets 32 and 192.
;;  5. (code target-continue) op 849 (surfaced after wall 3 cleared): self's
;;     own mode-param1 handle field (raw 476) run through the handle->process
;;     idiom (subu-s7 null check, sllv/dsra32 pid-pointer split, ppointer
;;     deref, live-pid compare). Cast v1 to handle at ops 844-853, mirroring
;;     (method 10 race-state)'s own precedent for the identical shape. A
;;     third, distinct stack allocation at offset 352 (a hand-built
;;     event-message-block for send-event-function's own 'change-mode
;;     re-dispatch to self) needed its own stack_structures.jsonc hint too.
;;
;; :exit remains held; see the issue-595 note below, now the only piece of
;; this state still not landed for real.
;;
;; Landing the real :event trades away the issue-522 stand-in's 'grab
;; truthy answer for retail's own: the decoded 'change-mode case returns #f
;; for both 'grab and 'look-around (matching jak3's own twin verbatim), so
;; process-grab?'s handshake (generic-obs.gc:1690) will read this as a
;; refusal for as long as a target sits in target-continue. Real :code no
;; longer parks here forever (it wants-loads, then arrive-at-continue, then
;; (go target-float) below), so the window this matters in is bounded to
;; however long that load takes, not indefinite the way the sleep-code stub
;; made it; whether scene.gc:1108-1116's own wait loop (issue 522) still
;; depends on catching a target mid-target-continue is unverified from this
;; static rung and needs a runtime check, not a hold, since #f-for-'grab is
;; retail's own decoded behavior, not an invented one.
(defstate target-continue (target)
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (local-vars (v0-0 object))
    (case message
      (('change-mode)
       (case (-> block param 0)
         (('grab 'look-around)
          #f
          )
         (else
           (set! (-> self mode-cache) (the-as symbol (-> block param 0)))
           (set! (-> self mode-param1) (the-as uint (if (>= argc 2)
                                                        (process->handle (the-as process (-> block param 1)))
                                                        (the-as int #f)
                                                        )
                                               )
                 )
           (set! (-> self mode-param2) (-> block param 2))
           (set! v0-0 (-> block param 3))
           (set! (-> self mode-param3) (the-as uint v0-0))
           v0-0
           )
         )
       )
      (('want-continue)
       (set! v0-0 (-> block param 0))
       (set! (-> self state-object 0) (the-as uint v0-0))
       v0-0
       )
      (else
        (target-generic-event-handler proc argc message block)
        )
      )
    )
  :enter (behavior ((arg0 continue-point))
    '()
    )
  ;; og:preserve-this partial arming (issue 595, region-mode dossier): the
  ;; real :exit still cannot land. Its own setting-control-method-17 call
  ;; (retail's region-mode restore) reads two registers, a3 and t0, that
  ;; :exit's own decode never sets: the vtable slot's declared signature
  ;; (settings-h.gc:530, four params past self) is correct against the
  ;; landed method body (settings.gc:1316), which genuinely never reads its
  ;; own arg2/arg3 -- but that only explains why retail's compiler didn't
  ;; bother setting a3/t0 here, not what value they actually carried. A
  ;; sibling call to the same method earlier in :code (op 129-139) shows the
  ;; retail idiom for this exact situation: a3/t0 left over from an earlier
  ;; setting-control-method-19 call in the SAME function (a3=#f, t0=0) rather
  ;; than freshly set. :exit is a separate, independently-analyzed function
  ;; (ir2_register_usage_pass in ObjectFileDB_IR2.cpp:696-744 checks each
  ;; function's own register inputs in isolation) with no earlier a3/t0
  ;; write of its own to inherit from -- gkernel.gc's own exit-state
  ;; dispatch is a bare zero-arg call, `((-> (the protect-frame cur) exit))`,
  ;; so whatever a3/t0 held here came from further up a call chain this
  ;; rung has no way to trace to a single deterministic value. No config
  ;; mechanism exists to suppress the register-usage check itself. Inventing
  ;; a3-0/t0-0 values (the shape the decompiler's own emitted local-vars
  ;; placeholder tempts) would be asserting a retail value with no evidence,
  ;; so this one call stays held; the rest of the region-mode fix below is
  ;; unaffected and unchanged from the issue-595 landing. Retires when a
  ;; future rung finds real evidence for :exit's own a3/t0 (a caller-chain
  ;; trace, or a config mechanism for this check).
  :exit (behavior ()
    (set! (-> *setting-control* user-default region-mode) (the-as basic #t))
    )
  :trans (behavior ()
    '()
    )
  :code (behavior ((arg0 continue-point))
    (local-vars (v1-91 symbol) (v1-117 symbol) (root-collide-shape? symbol) (camera-combiner-live? symbol))
    ;; og:preserve-this bring-up guard (title-continue chain, three smoke crashes):
    ;; retail transcribes this whole collide-setup region unconditionally (jak3's own
    ;; twin, target-death.gc:503-506, has no guard either: "(let ((v1-2 (-> self
    ;; control root-prim))) (set! (-> v1-2 prim-core collide-as) (collide-spec))
    ;; ...)"), because retail's own target-init always gives self root a real
    ;; collide-shape-moving by the time :code runs. jakx's own target-init does not
    ;; yet: its own og:preserve-this note (rung 3a, #164, below) documents self root
    ;; as "a bare trsqv with no collide-shape and still no draw-control... Retires
    ;; when the real vehicle chain gives the target its retail root (rung 3b, a
    ;; separate later change, out of scope here)". Landing this :code verbatim
    ;; against that gap smoked three times, each fix uncovering the next op in the
    ;; same precondition family, all found by compile-time disassembly (asm-file
    ;; :color :disassemble, no live target needed):
    ;;
    ;;  1. logic-target+0x2f1: (-> self root root-prim) reads root+156, past the end
    ;;     of trsqv's own much smaller allocation, and reads back 0; the next op,
    ;;     (set! (-> v1-1 prim-core collide-as) ...), stores to [v1-1+28] -- exception
    ;;     0xc0000005 writing goal address 0x1c.
    ;;  2. logic-target+0x2fd (same function, 12 bytes later, region grown by
    ;;     exactly the inserted branch's own byte count): the first guard, bare
    ;;     (when v1-1 ...), compiled its truthiness test against the '#f symbol
    ;;     pointer (confirmed against this same file's own (when arg0 ...) in
    ;;     reset-target-state below, "mov r9, r14 (load '#f) / cmp rdi, r9"), not
    ;;     literal zero, so it never caught v1-1's raw garbage-zero -- the "zero
    ;;     handles are truthy" class, on a plain pointer. (nonzero? ...) compiles
    ;;     against literal zero instead (reset-target-state's own "(if (nonzero?
    ;;     target-exit) ...)", two lines below: "xor r8, r8 / cmp r9, r8") and fixed
    ;;     this one write cluster, but only this one.
    ;;  3. logic-target+0x370: the crash moved past the fixed cluster into the next
    ;;     collide-shape-only op touching self root while it is still a bare trsqv
    ;;     (move-to-point!, a collide-shape method, and/or the collide-shape-moving
    ;;     status logior! further down both fit the class; a NULL read at offset -4,
    ;;     the standard type-tag fetch a virtual dispatch or a type? both use).
    ;;
    ;; Three crashes on one path is the evidence bar for treating this as one
    ;; precondition rather than patching stores one at a time: self root actually
    ;; being a collide-shape-moving, checked once into root-collide-shape? and
    ;; referenced at every collide-shape-dependent op in this state (the root-prim
    ;; cluster below, move-to-point!, and the status logior! near this state's own
    ;; end) rather than re-derived per site. (type? (-> self root) collide-shape-
    ;; moving) is the right check (retail's own precondition is a type, not just a
    ;; non-null pointer), chained behind (nonzero? (-> self root)) first: type?
    ;; itself reads its argument's own type tag at offset -4 (confirmed by
    ;; disassembly, the same -4 read shape as this crash's own NULL fault), so
    ;; calling it on a value that might itself be zero would just move the fault
    ;; into type? rather than fixing it. self root itself is never null here
    ;; (target-init always gives it a real, if undersized, trsqv), so this chain is
    ;; defensive rather than load-bearing today, but it is the correct shape and
    ;; costs nothing. rot->dir-targ! and vector-reset! below are NOT part of this
    ;; guard: both are declared on trsqv itself (rot->dir-targ!, transformq.gc:29;
    ;; vector-reset! is a plain function touching trsqv's own transv field), so
    ;; both run unconditionally and correctly against the bare trsqv root exactly
    ;; as retail's own bytes do. Retires when the real target-continue root lands
    ;; (rung 3b, the same condition as the rung 3a note below).
    (set! root-collide-shape? (and (nonzero? (-> self root)) (type? (-> self root) collide-shape-moving)))
    (let ((v1-1 (-> self root root-prim)))
      (when root-collide-shape?
        (set! (-> v1-1 prim-core collide-as) (collide-spec))
        (set! (-> v1-1 prim-core collide-with) (collide-spec))
        )
      )
    0
    (set! *spawn-actors* #f)
    (set! (-> self state-object 0) (the-as object #f))
    (set! (-> self mode-cache) #f)
    (set-time! (-> self state-time))
    (logior! (-> self focus-status) (focus-status teleporting))
    (let ((s5-0 (game-info-method-18 (-> self game) (-> arg0 name))))
      (cond
        (s5-0
          (set! (-> self game player-info (view-get-active-index) last-continue) (the-as continue-point s5-0))
          )
        ((string= (-> arg0 name) "default")
         )
        (else
          (format 0 "ERROR: TARGET: attempting to goto continue ~A which is not in level-info~%" (-> arg0 name))
          )
        )
      )
    (if (-> *art-control* reserve-buffer)
        (reserve-free *art-control* (-> *art-control* reserve-buffer heap))
        )
    (setting-control-method-15 *setting-control* self 'region-mode #f 0 0)
    (setting-control-method-15 *setting-control* self 'border-mode #f 0 0)
    (setting-control-method-15 *setting-control* self 'allow-continue #f 0 0)
    (setting-control-method-15 *setting-control* self 'allow-timeout #f 0 0)
    (setting-control-method-15 *setting-control* self 'speech-control #f 0 0)
    (setting-control-method-15 *setting-control* self 'allow-pause #f 0 0)
    (setting-control-method-15 *setting-control* self 'allow-progress #f 0 0)
    (let* ((a0-13 *setting-control*)
           (t9-12 (method-of-object a0-13 setting-control-method-15))
           (a1-11 self)
           (a2-8 'level-trans-time)
           (a3-7 #f)
           (t0-7 0)
           )
      (t9-12 a0-13 a1-11 a2-8 a3-7 t0-7 0)
      (setting-control-method-17
        *setting-control*
        'speech-control
        'speech-control
        (the-as none a3-7)
        (the-as none t0-7)
        )
      )
    (set! (-> *setting-control* user-default border-mode) #f)
    (setting-control-method-23 *setting-control*)
    (reset-target-state #t)
    (target-exit)
    (logior! (-> self focus-status) (focus-status teleporting))
    (let ((t9-17 quaternion-copy!)
          (a0-18 (-> self root rot))
          (a1-13 (new 'stack-no-clear 'quaternion))
          )
      (set! (-> a1-13 x) (* 0.00003051851 (the float (-> arg0 quat x))))
      (set! (-> a1-13 y) (* 0.00003051851 (the float (-> arg0 quat y))))
      (set! (-> a1-13 z) (* 0.00003051851 (the float (-> arg0 quat z))))
      (set! (-> a1-13 w) (* 0.00003051851 (the float (-> arg0 quat w))))
      (t9-17 (the-as quaternion a0-18) a1-13)
      )
    (when root-collide-shape?
      (move-to-point! (-> self root) (-> arg0 trans))
      )
    (rot->dir-targ! (-> self root))
    (vector-reset! (-> self root transv))
    (if (not (string= (-> arg0 name) "default"))
        (set! *external-cam-mode* #f)
        )
    (if (not (logtest? (-> arg0 flags) (continue-flags no-blackout)))
        (cam-stop)
        )
    (suspend)
    (let ((a0-23 (lookup-level-info (-> arg0 vis-nick))))
      (set! (-> *load-state* vis-nick) (if a0-23
                                           (-> a0-23 name)
                                           )
            )
      )
    (dotimes (v1-62 6)
      (cond
        ((< v1-62 (-> arg0 want-count))
         (set! (-> *load-state* want v1-62 name) (-> arg0 want v1-62 name))
         (set! (-> *load-state* want v1-62 display?) (-> arg0 want v1-62 display?))
         )
        (else
          (set! (-> *load-state* want v1-62 name) #f)
          (set! (-> *load-state* want v1-62 display?) #f)
          )
        )
      (set! (-> *load-state* want v1-62 force-vis?) #f)
      (set! (-> *load-state* want v1-62 force-inside?) #f)
      )
    (dotimes (v1-65 1)
      (set! (-> *load-state* want-sound v1-65 name) (-> arg0 want-sound v1-65))
      (set! (-> *load-state* want-sound v1-65 mode) (sound-bank-mode full))
      )
    (when (logtest? (continue-flags race) (-> arg0 flags))
      (let ((a2-14 (level-name-from-vehicle-type (the-as vehicle-type (-> *game-info* current-vehicle)))))
        (if a2-14
            (load-state-method-23 *load-state* 0 a2-14 #f)
            )
        )
      )
    (add-borrow-levels *load-state*)
    (when (not (string= (-> arg0 name) "default"))
      (while (begin
               (dotimes (s5-3 (-> arg0 want-count))
                 (when (not (or (not (-> arg0 want s5-3 name))
                                (not (-> arg0 want s5-3 display?))
                                (= (level-status? *level* (-> arg0 want s5-3 name) #f) 'active)
                                )
                            )
                   (set! v1-91 #t)
                   (goto cfg-51)
                   )
                 )
               (let ((s5-4 *load-state*))
                 (dotimes (s4-1 6)
                   (when (not (or (not (-> s5-4 want s4-1 name))
                                  (not (-> s5-4 want s4-1 display?))
                                  (= (level-status? *level* (-> s5-4 want s4-1 name) #f) 'active)
                                  )
                              )
                     (set! v1-91 #t)
                     (goto cfg-51)
                     )
                   )
                 )
               (set! v1-91 #f)
               (label cfg-51)
               v1-91
               )
        (suspend)
        )
      (while (not (string-charp= (-> *sound-bank-string* 0) (the-as (pointer uint8) (-> *sound-iop-info* sound-banks 1))))
        (suspend)
        )
      (while (begin
               (let ((v1-115 6)
                     (a0-57 17)
                     )
                 (while (>= a0-57 v1-115)
                   (when (-> *load-state* target v1-115 name)
                     (when (not (and (= (-> *load-state* target v1-115 name) (-> *level* level v1-115 name))
