;;-*-Lisp-*-
(in-package goal)

;; name: target-h.gc
;; name in dgo: target-h
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

;; +++target-h:target-flags
(defenum target-flags
  :type uint32
  :bitfield #t
  (tf0 0)
  (tf1 1)
  (tf2 2)
  (tinvuln1 3)
  (tf4 4)
  (tf5 5)
  (tf6 6)
  (prevent-jump 7)
  (prevent-attack 8)
  (prevent-duck 9)
  (tf10 10)
  (tf11 11)
  (tf12 12)
  (tf13 13)
  (tf14 14)
  (tf15 15)
  (tf16 16)
  (prevent-board 17)
  (prevent-gun 18)
  (lleg-still 19)
  (rleg-still 20)
  (lleg-no-ik 21)
  (rleg-no-ik 22)
  (prevent-double-jump 23)
  (disable-attacks 24)
  (tinvuln2 25)
  (tf26 26)
  (tf27 27)
  (invisible 28)
  (tf29 29)
  (tf30 30)
  (tf31 31)
  )
;; ---target-h:target-flags

(deftype target (process-focusable)
  ((vehicle                 uint64                                                                            :offset-assert 256)
   (target-flags            target-flags                                                                      :offset 236) ;; guessed by decompiler
   (game                    game-info                                                                         :offset-assert 264) ;; guessed by decompiler
   (init-time               uint64                                                                            :offset-assert 272) ;; time-frame
   (teleport-time           uint64                                                                            :offset-assert 280) ;; time-frame
   (state-hook-time         uint64                                                                            :offset-assert 288) ;; time-frame
   (state-hook              (function none :behavior target)                                                  :offset-assert 296) ;; guessed by decompiler
   (cam-user-mode           symbol                                                                            :offset-assert 300) ;; guessed by decompiler
   (anim-seed               uint64                                                                            :offset-assert 304)
   (alt-cam-pos             vector                                                                    :inline :offset-assert 320)
   (current-level           level                                                                             :offset-assert 336) ;; guessed by decompiler
   (saved-pos               transformq                                                                :inline :offset-assert 352)
   (saved-owner             uint64                                                                            :offset-assert 400) ;; handle
   (excitement              float                                                                             :offset-assert 408)
   (shock-effect-time       uint64                                                                            :offset-assert 416) ;; time-frame
   (fp-hud                  uint64                                                                            :offset-assert 424) ;; handle
   (no-load-wait            uint64                                                                            :offset-assert 432) ;; time-frame
   (no-look-around-wait     uint64                                                                            :offset-assert 440) ;; time-frame
   (burn-proc               uint64                                                                            :offset-assert 448) ;; handle
   (pre-joint-hook          (function none :behavior target)                                                  :offset-assert 456) ;; guessed by decompiler
   (notify                  uint64                                                                            :offset-assert 464) ;; handle
   (mode-cache              symbol                                                                            :offset-assert 472) ;; guessed by decompiler
   (mode-param1             uint64                                                                            :offset-assert 480) ;; handle
   (mode-param2             uint64                                                                            :offset-assert 488)
   (mode-param3             uint64                                                                            :offset-assert 496)
   (major-mode-exit-hook    (function none :behavior target)                                                  :offset-assert 504) ;; guessed by decompiler
   (major-mode-event-hook   (function process int symbol event-message-block object :behavior target)         :offset-assert 508) ;; guessed by decompiler
   (sub-mode-exit-hook      (function none :behavior target)                                                  :offset-assert 512) ;; guessed by decompiler
   (target-effect           uint64                                                                            :offset-assert 520) ;; target-effect
   (color-effect            symbol                                                                            :offset-assert 528) ;; guessed by decompiler
   (color-effect-start-time uint64                                                                            :offset-assert 536) ;; time-frame
   (color-effect-duration   uint64                                                                            :offset-assert 544) ;; time-frame
   (yes-state               basic                                                                             :offset-assert 552)
   (no-state                basic                                                                             :offset-assert 556)
   ;; og:preserve-this state-object/state-uint32/state-float alias the same 16 bytes (a
   ;; scratch-slot union like target-flags' own overlay above): only state-object can use
   ;; offset-assert (deftype.cpp:233-239 checks it against sequential placement, right
   ;; after no-state); the captured block gave the other two offset-assert 560 as well,
   ;; which (mi) rejects (state-uint32 computed at 576, the offset-assert wanted 560).
   ;; Landed with :offset 560 (forced), matching this file's own union idiom, e.g.
   ;; all-types.gc's vector4w/float data-then-x pattern (:offset-assert 0 then :offset 0).
   (state-object            object                                                                   4       :offset-assert 560)
   (state-uint32            uint32                                                                   4       :offset 560)
   (state-float             float                                                                   4       :offset 560)
   ;; og:preserve-this state-button, state-sound and state-impact are extent-true
   ;; placeholders, not resolved types: no load or store in any of R0's six decoded
   ;; objects (game-info, logic-target, target-h, target, target-util, target-handler)
   ;; touches a target-typed base anywhere in bytes 560-847. Byte widths (16/16/80) come
   ;; from the already-known neighbor offsets alone: state-button 576 to state-vector's
   ;; 592 (16 over 4 elements); state-sound 720 to state-handle's 736 (16 over 4
   ;; elements); state-impact 768 to the struct's own :size-assert #x350=848 (80 over 1
   ;; element). Retirement condition: a broader-scope decode or manual disassembly of
   ;; whichever retail object constructs the target state-arg data. Nothing downstream in
   ;; this leg may rely on their element type.
   (state-button            uint8                                                                    16      :offset-assert 576)
   (state-vector            vector                                                                   4       :offset-assert 592)
   ;; og:preserve-this the captured comment block declared a state-time field here at
   ;; :offset-assert 240. That offset is real, but it belongs to process-drawable's own
   ;; state-time field (all-types.gc, process-drawable deftype, :offset-assert 240),
   ;; inherited by target through process-focusable without redeclaration.
   ;; add_field_to_type (TypeSystem.cpp:1028-1029) rejects redeclaring an inherited field
   ;; name before it even reaches offset checking: "Type target already has a field named
   ;; state-time". The captured 240 was correct data describing an access into the
   ;; inherited field, not a field target owns itself; dropped here rather than relocated
   ;; (an earlier pass of this note relocated it to 656, arithmetically self-consistent
   ;; with state-vector/state-smush's own offsets but wrong: that slot is genuinely
   ;; unused, not a second state-time). Dropping the field leaves 656-688 as an
   ;; unnamed 32-byte gap (state-vector's own end), so state-smush below is placed
   ;; with :offset (forced), not :offset-assert (which asserts against sequential
   ;; auto-placement and would land at 656, the gap's start, not 688); this matches
   ;; the file's own idiom for jumping into a padding region, e.g. target-flags above.
   (state-smush             smush-control                                                             :inline :offset 688)
   (state-sound             uint8                                                                    16      :offset-assert 720) ;; extent-true placeholder, see note above state-button
   (state-handle            handle                                                                   4       :offset-assert 736)
   (state-impact            uint8                                                                    80      :offset-assert 768) ;; extent-true placeholder, see note above state-button
   )
  :method-count-assert 60
  :size-assert         #x350
  :flag-assert         #x3c02c00350
  ;; field mode-param2 uses ~A with a 64-bit load. field mode-param3 uses ~A with a 64-bit load.
  (:methods
    (target-method-59 () none) ;; 59
    )
  (:states
    target-continue ;; associated process guessed by decompiler, old: (state continue-point target)
    target-float ;; associated process guessed by decompiler, old: (state target)
    target-introb
    target-intro
    target-title ;; associated process guessed by decompiler, old: (state symbol target)
    target-pilot-start ;; associated process guessed by decompiler, old: (state handle symbol symbol target)
    )
  )

