;; og:preserve-this load-bearing retail clear: a zero handle is NOT a safe empty
;; slot, because 0 is truthy in GOAL and handle->process would dereference it.
(dotimes (v1-2 48)
  (set! (-> *attackable-hash* procs v1-2) (the-as handle #f))
  )

(defun attackable-hash-copy! ((arg0 attackable-hash) (arg1 int) (arg2 int))
  (set! (-> arg0 procs arg1) (-> arg0 procs arg2))
  (set! (-> arg0 trans arg1 quad) (-> arg0 trans arg2 quad))
  (set! (-> arg0 masks arg1) (the-as int (-> (the-as (pointer uint32) (&+ (-> arg0 masks) (* arg2 4))))))
  (none)
  )

(defun attackable-hash-exchange! ((arg0 attackable-hash) (arg1 int) (arg2 int))
  (let ((v1-2 (-> arg0 procs arg1))
        (a3-3 (-> arg0 trans arg1 quad))
        (v0-0 (-> (the-as (pointer uint32) (&+ (-> arg0 masks) (* arg1 4)))))
        )
    (set! (-> arg0 procs arg1) (-> arg0 procs arg2))
    (set! (-> arg0 trans arg1 quad) (-> arg0 trans arg2 quad))
    (set! (-> arg0 masks arg1) (the-as int (-> (the-as (pointer uint32) (&+ (-> arg0 masks) (* arg2 4))))))
    (set! (-> arg0 procs arg2) v1-2)
    (set! (-> arg0 trans arg2 quad) a3-3)
    (set! (-> arg0 masks arg2) (the-as int v0-0))
    (the-as int v0-0)
    )
  )

(defun attackable-hash-update ((arg0 attackable-hash))
  (let ((s5-0 (+ (-> arg0 length) -1)))
    (let ((s4-0 0)
          (s3-0 (-> arg0 procs))
          )
      (while (and (< s4-0 (the-as int s5-0)) (not (handle->process (-> s3-0 s5-0))))
        (set! (-> s3-0 s5-0) (the-as handle #f))
        (+! s5-0 -1)
        )
      (until #f
        (while (< s4-0 (the-as int s5-0))
          (let ((a0-7 (handle->process (-> s3-0 s4-0))))
            (cond
              (a0-7
                (set! (-> arg0 trans s4-0 quad) (-> (the-as process-focusable a0-7) root trans quad))
                (set! (-> arg0 masks s4-0) (process-focusable-method-50 (the-as process-focusable a0-7)))
                (+! s4-0 1)
                )
              (else
                (empty)
                (goto cfg-25)
                )
              )
            )
          )
        (label cfg-25)
        (when (>= s4-0 (the-as int s5-0))
          (let ((a0-13 (handle->process (-> s3-0 s4-0))))
            (when a0-13
              (set! (-> arg0 trans s4-0 quad) (-> (the-as process-focusable a0-13) root trans quad))
              (set! (-> arg0 masks s4-0) (process-focusable-method-50 (the-as process-focusable a0-13)))
              )
            )
          (goto cfg-47)
          )
        (let ((a0-18 arg0)
              (v1-37 s4-0)
              (a1-13 s5-0)
              )
          (set! (-> a0-18 procs v1-37) (-> a0-18 procs a1-13))
          (set! (-> a0-18 trans v1-37 quad) (-> a0-18 trans a1-13 quad))
          (set! (-> a0-18 masks v1-37) (the-as int (-> (the-as (pointer uint32) (&+ (-> a0-18 masks) (* a1-13 4))))))
          )
        (set! (-> s3-0 s5-0) (the-as handle #f))
        (+! s5-0 -1)
        (while (and (not (handle->process (-> arg0 procs s5-0))) (< s4-0 (the-as int s5-0)))
          (set! (-> s3-0 s5-0) (the-as handle #f))
          (+! s5-0 -1)
          )
        )
      )
    #f
    (label cfg-47)
    (let ((v0-2 (+ s5-0 1)))
      (set! (-> arg0 length) v0-2)
      (the-as int v0-2)
      )
    )
  )
