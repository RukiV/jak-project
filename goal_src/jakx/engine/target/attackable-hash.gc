;;-*-Lisp-*-
(in-package goal)

;; name: attackable-hash.gc
;; name in dgo: attackable-hash
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

;; og:preserve-this jakx-only object, no jak3 counterpart (jak3's per-frame actor
;; tracking is the spatial actor-hash; this is a flat 48-entry combat target table).
;; Layout derived from the object's own top-level (static instance, flag
;; #x900000012), the auto-generated inspect in the debug segment (which prints the
;; retail field names procs/trans/masks) and attackable-hash-update's walk: three
;; parallel tables indexed together, refreshed and compacted once per frame from
;; actors-update. Runtime-inert today: nothing registers entries until the
;; target/enemy legs land, so length stays 0 and update walks nothing.

(deftype attackable-hash (basic)
  ((procs             (pointer handle))
   (trans             (inline-array vector))
   (masks             (pointer int32))
   (allocated-length  uint8)
   (length            uint8)
   )
  )

(defmethod inspect ((this attackable-hash))
  (format #t "[~8x] ~A~%" this (-> this type))
  (format #t "~Tlength: ~D/~D~%" (-> this length) (-> this allocated-length))
  (format #t "~Tdata:~%")
  (dotimes (s5-0 (the-as int (-> this length)))
    (let ((s4-0 (handle->process (-> this procs s5-0))))
      (format #t "~A~%" s4-0)
      (if s4-0
          (format
            #t
            "~t~x~t~`vector`I~%"
            (-> (the-as (pointer uint32) (&+ (-> this masks) (* s5-0 4))))
            (-> this trans s5-0)
            )
          (format #t "---------------~%")
          )
      )
    )
  this
  )

;; definition for symbol *attackable-hash*, type attackable-hash
