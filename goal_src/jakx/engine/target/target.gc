;;-*-Lisp-*-
(in-package goal)

;; name: target.gc
;; name in dgo: target
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

;; og:preserve-this target-nearest-dist, scene chain (issue 522): retail's own
;; body is a two-instruction stub, (set! v0 0) (ret-value v0), reading no
;; argument register at all, so the parameter type cannot be proven from the
;; body the way AGENTS.md rule 4 usually asks; it is proven from the three
;; call sites instead (all in loader.gc: gui-control-method-12 twice,
;; external-art-control's spool-push once), each of which sets up only a0
;; before the jalr, computed as (&+ (-> <process> root) 12), the identical
;; trans-address expression target-get-any-pos below already returns typed
;; vector (that function's own og:preserve-this note: root at raw 184 =
;; declared 188, trans at root's own +12). A wide (function object object)
;; proposal for this symbol was tried and rejected earlier (PR 519, the
;; extern-arity-tier rejected.json ref_drift entry) because applying it
;; drifted loader's REF with unnarrowed junk; this is the narrow,
;; evidence-backed signature instead. The float return is proven at the call
;; site too, not the body: the first call site's own v0 is moved into f30 via
;; mtc1 and compared with c.lt.s against another float; the body's own
;; integer 0 is the bit-identical encoding of float 0.0. Scoped decode
;; (--config-override allowed_objects: ["target"]) confirms zero ERROR/WARN
;; for this function once all-types.gc's own entry is uncommented to
;; (function vector float).
(defun target-nearest-dist ((arg0 vector))
  0.0
  )

;; og:preserve-this landed for real, R5a (#122): transcribed from target_ir2.asm with
;; one hand-resolved cast. The decompiler leaves the offset-184/+12 load unresolved
;; (view-get-target's return is typed process, generic like view-get-active-target);
;; (method 51 target)/get-trans in the same leg's target-util.o already decodes this
;; exact shape cleanly once the base is typed target ((-> this root trans), root at raw
;; 184 = declared 188, trans at root's own +12), so the same cast settles it here. The
;; double call to view-get-target per iteration (once to test, once to store) is the
;; raw decode's own redundant-reevaluation shape, kept verbatim rather than cleaned up
;; to a single call; the last live view wins, not the first, matching the retail loop
;; having no early exit.
(defun target-get-any-pos ()
  (let ((found (the-as process #f)))
    (let ((i 0))
      (while (< i *view-count*)
        (when (view-get-target i)
          (set! found (view-get-target i))
          )
        (set! i (+ i 1))
        )
      )
    ;; og:preserve-this root guard, rung 2 (#164): at the time this guard landed,
    ;; target-init (logic-target.gc) built no root at all; rung 3a (#164, 9fc9ce893)
    ;; later gave it a bare trsqv, but the kernel's activate still zeroes the whole
    ;; subclass field block before target-init's own root-construction line runs,
    ;; so root can still read GOAL 0 here in that window, which is truthy; the raw
    ;; decode's (if found ...) alone lets a root-less target through and derefs
    ;; (-> found root trans) into that zero.
    ;; This sits on a per-frame path (the sky's time-of-day update calls
    ;; level-get-target-inside twice per frame), so a root-less registered target
    ;; crashes almost immediately. Treating a root-less target as no target at all
    ;; keeps the function's existing no-target fallback behavior. Retires when a real
    ;; collide-shape root lands in target-init.
    (if (and found (nonzero? (-> (the-as target found) root)))
        (-> (the-as target found) root trans)
        (let ((pos (begin
                     (view-push-context 0)
                     (camera-pos)
                     )
                    )
              )
          (view-pop-context)
          pos
          )
        )
    )
  )

