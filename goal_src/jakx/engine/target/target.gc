;;-*-Lisp-*-
(in-package goal)

;; name: target.gc
;; name in dgo: target
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

;; og:preserve-this landed for real, R5a (#122): transcribed from target_ir2.asm with
;; one hand-resolved cast. The decompiler leaves the offset-184/+12 load unresolved
;; (view-get-target's return is typed process, generic like view-get-active-target);
;; (method 51 target)/get-trans in the same leg's target-util.o already decodes this
;; exact shape cleanly once the base is typed target ((-> this root trans), root at raw
;; 184 = declared 188, trans at root's own +12), so the same cast settles it here. The
;; double call to view-get-target per iteration (once to test, once to store) is the
;; raw decode's own redundant-reevaluation shape, kept verbatim rather than cleaned up
;; to a single call; the last live view wins, not the first, matching the retail loop
;; having no early exit.
(defun target-get-any-pos ()
  (let ((found (the-as process #f)))
    (let ((i 0))
      (while (< i *view-count*)
        (when (view-get-target i)
          (set! found (view-get-target i))
          )
        (set! i (+ i 1))
        )
      )
    ;; og:preserve-this root guard, rung 2 (#164): target-init (logic-target.gc) never
    ;; builds a root, and the kernel's activate zeroes the whole subclass field block,
    ;; so root reads GOAL 0 here, which is truthy; the raw decode's (if found ...) alone
    ;; lets a root-less target through and derefs (-> found root trans) into that zero.
    ;; This sits on a per-frame path (the sky's time-of-day update calls
    ;; level-get-target-inside twice per frame), so a root-less registered target
    ;; crashes almost immediately. Treating a root-less target as no target at all
    ;; keeps the function's existing no-target fallback behavior. Retires when a real
    ;; collide-shape root lands in target-init.
    (if (and found (nonzero? (-> (the-as target found) root)))
        (-> (the-as target found) root trans)
        (let ((pos (begin
                     (view-push-context 0)
                     (camera-pos)
                     )
                    )
              )
          (view-pop-context)
          pos
          )
        )
    )
  )

