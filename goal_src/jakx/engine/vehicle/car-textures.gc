;; definition for method 17 of type car-info-full
;; WARN: Return type mismatch int vs none.
(defmethod car-info-full-method-17 ((this car-info-full))
  (vu-lights<-light-group! (-> this shield-vu-lights) (-> this shield-light-group))
  (seek! (-> this shield-light-group dir1 extra x) 0.0 (* 8.0 (seconds-per-frame)))
  (seek! (-> this shield-light-group dir2 extra x) 0.0 (* 8.0 (seconds-per-frame)))
  0
  (none)
  )

;; definition for method 18 of type car-info-full
;; INFO: Used lq/sq
;; WARN: Return type mismatch int vs none.
(defmethod car-info-full-method-18 ((this car-info-full) (arg0 vector))
  (set-vector! (-> this shield-light-group ambi color) 0.0 0.0 0.0 1.0)
  (set! (-> this shield-light-group dir0 color quad) (-> arg0 quad))
  (let* ((f1-2 (fmax (fmax (-> arg0 x) (-> arg0 y)) (-> arg0 z)))
         (f0-7 (* 0.5 (+ (-> arg0 x) f1-2)))
         (f2-3 (* 0.5 (+ (-> arg0 y) f1-2)))
         (f1-4 (* 0.5 (+ (-> arg0 z) f1-2)))
         )
    (set-vector! (-> this shield-light-group dir1 color) f0-7 f2-3 f1-4 1.0)
    (set-vector! (-> this shield-light-group dir2 color) f0-7 f2-3 f1-4 1.0)
    )
  (set! (-> this shield-light-group ambi extra x) 0.0)
  (set! (-> this shield-light-group dir0 extra x) 1.0)
  0
  (none)
  )

;; definition for method 19 of type car-info-full
;; WARN: Return type mismatch int vs none.
(defmethod car-info-full-method-19 ((this car-info-full) (arg0 vector) (arg1 vector))
  (let ((gp-0 0)
        (f0-0 100.0)
        (s5-0 (-> this shield-light-group))
        )
    (let ((v1-1 1)
          (a0-1 2)
          )
      (while (>= a0-1 v1-1)
        (when (< (-> s5-0 lights v1-1 extra x) f0-0)
          (set! gp-0 v1-1)
          (set! f0-0 (-> s5-0 lights v1-1 extra x))
          )
        (+! v1-1 1)
        )
      )
    (let ((a0-4 (+ (the-as uint (-> s5-0 dir0)) (* 48 gp-0))))
      (vector-! (the-as vector a0-4) arg1 arg0)
      (vector-normalize! (the-as vector a0-4) 1.0)
      )
    (set! (-> s5-0 lights gp-0 extra x) 2.0)
    )
  0
  (none)
  )

;; definition for method 9 of type car-level-array
;; WARN: Return type mismatch int vs none.
;; og:preserve-this: this method's :methods declaration is a genuine
;; zero-arg signature (all-types.gc: "(car-level-array-method-9 () none)",
;; registered by the compiler as (function none) with no implicit this),
;; and the body never references self. defmethod itself cannot express a
;; truly argument-less method ("Method type must be a symbol, got ()" when
;; tried with an empty list; a (this car-level-array) binding then trips
;; "was originally defined as (function none), but has been redefined as
;; (function car-level-array none)"). The raw decode's own shape is a
;; plain function registered by hand via method-set!, matching how the
;; compiled top level actually built it
;; ((method-set! car-level-array 9 L1) then calling the registered method
;; immediately); landed the same way instead of forcing defmethod syntax.
(defun car-level-array-method-9-body ()
  (dotimes (v1-0 6)
    (set! (-> *car-level-array* data v1-0 level) (-> *level* level (+ v1-0 6)))
    (set! (-> *car-level-array* data v1-0 textures) (-> *car-level-array* textures v1-0))
    )
  0
  (none)
  )
(method-set! car-level-array 9 car-level-array-method-9-body)
((method-of-object *car-level-array* car-level-array-method-9))
