  (format #t "~2Tpowerup-level: ~D~%" (-> this powerup-level))
  (format #t "~2Tmy-type: ~D~%" (-> this my-type))
  (label cfg-4)
  this
  )

;; definition for function v-wpn-base-common-trans
;; WARN: Return type mismatch uint vs object.
;; WARN: .subu (32-bit) used on a uint at idx 1. This probably should be a handle.
(defbehavior v-wpn-base-common-trans vehicle-weapon-slot ()
  ;; og:preserve-this compile-only substitution: the decoder prints its own
  ;; pseudo-op (.asm.sllv.r0) for the raw sllv reinterpretation, which is not
  ;; valid GOAL (rigid-body-debug precedent, same defect class). The
  ;; surrounding nonzero?/pid-compare shape is handle->process's own
  ;; expansion (gkernel-h.gc) verbatim; owning-vehicle is read as a handle
  ;; here even though its own field is declared uint64.
  (let ((gp-0 (handle->process (-> self owning-vehicle))))
    (if (or (not gp-0) (focus-test? (the-as vehicle gp-0) dead))
        (go empty-state)
        )
    (let ((s5-0 (-> self powerup-level)))
      (when (process-nettable-method-22 (the-as vehicle gp-0))
        (let ((v0-2 (vehicle-get-weapon-level (the-as vehicle gp-0) (the-as int (-> self my-type)))))
          (set! (-> self powerup-level) (the-as uint v0-2))
          (if (!= s5-0 v0-2)
              (send-event (the-as vehicle gp-0) 'weapon 'powerup-changed (-> self powerup-level) s5-0)
              )
          )
        )
      )
    )
  (when (logtest? (-> self flags) 1)
    (send-event self 'fire)
    (let ((v0-4 (logand -2 (-> self flags))))
      (set! (-> self flags) v0-4)
      v0-4
      )
    )
  )

;; definition for function v-wpn-event-base
(defbehavior v-wpn-event-base vehicle-weapon-slot ((arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (local-vars (v0-0 object))
  (case arg2
    (('done)
     (deactivate self)
     )
    (('ammo-remaining)
     (vehicle-weapon-slot-method-53 self)
     )
    (('refill-ammo)
     (let ((v1-4 ((method-of-object self vehicle-weapon-slot-method-54))))
       (set! v0-0 (< (-> self ammunition) v1-4))
       (set! (-> self ammunition) v1-4)
       )
     v0-0
     )
    (('get-color)
     (v-wpn-type->color (the-as int (-> self my-type)))
     )
    (('acquire-target)
     ((method-of-object self vehicle-weapon-slot-method-57))
     )
    (('defer-fire)
     (set! v0-0 (logior (-> self flags) 1))
     (set! (-> self flags) (the-as uint v0-0))
     v0-0
     )
    )
  )

;; failed to figure out what this is:
(defstate idle (vehicle-weapon-slot)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (format 0 "WARNING: abstract base class vehicle-weapon-slot received event ~A~%" message)
    (case message
      (('fire)
       (format #t "~s fire!~%" (-> self name))
       )
      (else
        (v-wpn-event-base proc argc message block)
        )
      )
    )
  :trans v-wpn-base-common-trans
  :code sleep-code
  )

;; definition for method 11 of type vehicle-weapon-slot
(defmethod init-from-entity! ((this vehicle-weapon-slot) (arg0 entity-actor))
  (format #t "WARNING: abstract base class vehicle-weapon-slot has been initialized.~%")
  (go (method-of-object this idle))
  )

