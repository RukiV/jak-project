;; og:preserve-this three forward declarations for functions this file calls
;; but does not define. All three targets are still stubs; build-first needs
;; the declarations here regardless of which file eventually lands them,
;; since engine/vehicle compiles ahead of both engine/vehicle/vehicle.gc's
;; own body pass and levels/common in this tree's link order. Signatures
;; copied from decompiler/config/jakx/all-types.gc. Drop each line when its
;; real object lands.
;; vehicle-get-weapon-level: defined by vehicle.gc (this band's own object).
(define-extern vehicle-get-weapon-level (function vehicle int int))
;; v-wpn-type->color: defined by wvehicle-weapons-util.gc (not in this band).
(define-extern v-wpn-type->color (function int int))
;; muzzle-flash-init-by-other: defined by wvehicle-weapons.gc (levels/common,
;; not in this band); (method 51 gunmount-generic-drawable), landed
;; wvehicle-weapons-vein rung 4, reads this symbol as a bare value to
;; forward into run-function-in-process rather than calling it directly, so
;; it still needs a real type here to compile. og:preserve-this
;; wvehicle-weapons-vein rung 5: muzzle-flash-init-by-other's own body and
;; gunmount-generic-drawable-state-55 both landed in wvehicle-weapons.gc.
;; Still nothing landed calls gunmount-drawable-method-51 itself, so the
;; whole chain (method-51 -> muzzle-flash-init-by-other -> muzzle-flash's
;; idle/lit states, and separately state-55's own event/trans dispatch)
;; stays dormant rather than live until a caller lands; (method 64
;; wvehicle) was the candidate caller this rung checked, and it holds on a
;; fresh wall of its own (type_casts.jsonc's own note on that method).
;; The forward declaration below stays: this file compiles ahead of
;; wvehicle-weapons.gc in link order and (method 51 gunmount-generic-
;; drawable) needs the type before muzzle-flash-init-by-other's own real
;; body appears later in that same file (same shape as sleep-code/ja-post,
;; process-drawable-h.gc: extern here, real defbehavior in the .gc file).
(deftype muzzle-flash (process-drawable)
  ((glued-to       uint64             :offset-assert 248)
   (glued-joint    int32              :offset-assert 256)
   (local-rotation quaternion :inline :offset-assert 272)
   )
  :method-count-assert 52
  :size-assert         #x120
  :flag-assert         #x3400900120
  (:state-methods
    lit ;; 50
    idle ;; 51
    )
  )
(define-extern muzzle-flash-init-by-other (function handle int object :behavior muzzle-flash))

;; definition for symbol V_R_MINE1_ARMED?, type object
(define V_R_MINE1_ARMED? (the-as object #t))

;; og:preserve-this: weapon-mask->type and *weapon-suppression-table* are
;; both omitted rather than landed. weapon-mask->type has no type: giving it
;; a concrete (function int int) signature crashes the decompiler outright
;; ("Assertion failed: 'is_var()'", decompiler/IR2/AtomicOp.h:156) while
;; processing this object, isolated by toggling only this extern against an
;; otherwise-unchanged config; a decompiler bug, not a config gap (see the
;; note on the commented-out extern in all-types.gc). *weapon-suppression-
;; table*'s own static data (L34, 21 back-to-back separately-boxed (array
;; symbol) records) fails static-ref in decompile_boxed_array's alignment
;; check and every label_types path tried (data_decompile.cpp:1838-1839,
;; 318-324, 98-99); the decompiler emits an unparseable <static-data L34>
;; placeholder in its place instead of an error line. Neither symbol has a
;; caller anywhere else in the corpus, so both are omitted entirely rather
;; than given an invented value, matching the credits-obs precedent for the
;; same defect class. Re-derive both from the framework's own dump (offline-
;; test -f wvehicle-weapons-h -d) once the two decompiler-side gaps close.

;; definition of type vehicle-weapon-slot
;; og:preserve-this owning-vehicle retyped uint64 -> handle to match
;; all-types.gc (wvehicle-weapons-family lane): v-wpn-base-common-trans's own
;; note below already documents that this field is read as a handle despite
;; its declared type; syncing the declaration keeps TypeConsistency green and
;; lets every consumer object's own decode of this field resolve the
;; handle->process idiom automatically.
