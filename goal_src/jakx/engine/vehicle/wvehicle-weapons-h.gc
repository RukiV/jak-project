  ((owning-vehicle  handle)
   (ammunition      int8)
   (flags           uint8)
   (in-slot         uint8)
   (powerup-level   uint8)
   (my-type         uint8)
   )
  (:state-methods
    idle
    )
  (:methods
    (vehicle-weapon-slot-method-51 (_type_ object) none)
    (vehicle-weapon-slot-method-52 (_type_ object) none)
    (vehicle-weapon-slot-method-53 (_type_) none)
    (vehicle-weapon-slot-method-54 () int)
    (vehicle-weapon-slot-method-55 (_type_) none)
    (vehicle-weapon-slot-method-56 (_type_) none)
    (vehicle-weapon-slot-method-57 () none)
    (vehicle-weapon-slot-method-58 (_type_ object) none)
    (vehicle-weapon-slot-method-59 () none)
    )
  )

;; definition for method 3 of type vehicle-weapon-slot
(defmethod inspect ((this vehicle-weapon-slot))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type process-drawable inspect)))
    (t9-0 this)
    )
  (format #t "~2Towning-vehicle: ~D~%" (-> this owning-vehicle))
  (format #t "~2Tammunition: ~D~%" (-> this ammunition))
  (format #t "~2Tflags: ~D~%" (-> this flags))
