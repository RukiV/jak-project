;; definition for method 0 of type warning-hud-icon
(defmethod new warning-hud-icon ((allocation symbol) (type-to-make type))
  (let ((gp-0 (object-new allocation type-to-make (the-as int (-> type-to-make size)))))
    (set-vector! (-> gp-0 hsprite color) 255 16 16 255)
    (set! (-> gp-0 hsprite pos z) #xffffff0)
    (set! (-> gp-0 hsprite pos w) 0)
    (set! (-> gp-0 hsprite scale-x) 1.0)
    (set! (-> gp-0 hsprite scale-y) 1.0)
    (set! (-> gp-0 hsprite angle) 0.0)
    (set! (-> gp-0 hsprite flags) (hud-sprite-flags hsf3))
    (set! (-> gp-0 hsprite tex) (get-texture car-reticle-07 level-default-minimap))
    gp-0
    )
  )

