;;-*-Lisp-*-
(in-package goal)

;; name: race-line-h.gc
;; name in dgo: race-line-h
;; dgos: ENGINE, GAME

;; definition of type race-line-slice-mapping
(deftype race-line-slice-mapping (structure)
  ((valid-entries  uint16)
   (index-entries  uint32)
   )
  )

;; definition for method 3 of type race-line-slice-mapping
(defmethod inspect ((this race-line-slice-mapping))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'race-line-slice-mapping)
  (format #t "~1Tvalid-entries: ~D~%" (-> this valid-entries))
  (format #t "~1Tindex-entries: #x~X~%" (-> this index-entries))
  (label cfg-4)
  this
  )

;; definition of type race-line-query-info
(deftype race-line-query-info (structure)
  ((query-position       vector  :inline)
   (nearest-position     vector  :inline)
   (ahead-position       vector  :inline)
   (ahead-direction      vector  :inline)
   (direction            vector  :inline)
   (angle-sum-distance   float)
   (look-ahead-distance  float)
   (current-slice        int32)
   (current-line         basic)
   (total-angle-delta    float)
   (skip-gaps?           basic)
   )
  )

;; definition for method 3 of type race-line-query-info
(defmethod inspect ((this race-line-query-info))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'race-line-query-info)
  (format #t "~1Tquery-position: #<vector @ #x~X>~%" (-> this query-position))
  (format #t "~1Tnearest-position: #<vector @ #x~X>~%" (-> this nearest-position))
  (format #t "~1Tahead-position: #<vector @ #x~X>~%" (-> this ahead-position))
  (format #t "~1Tahead-direction: #<vector @ #x~X>~%" (-> this ahead-direction))
  (format #t "~1Tdirection: #<vector @ #x~X>~%" (-> this direction))
  (format #t "~1Tangle-sum-distance: ~f~%" (-> this angle-sum-distance))
  (format #t "~1Tlook-ahead-distance: ~f~%" (-> this look-ahead-distance))
  (format #t "~1Tcurrent-slice: ~D~%" (-> this current-slice))
  (format #t "~1Tcurrent-line: ~A~%" (-> this current-line))
  (format #t "~1Ttotal-angle-delta: ~f~%" (-> this total-angle-delta))
  (format #t "~1Tskip-gaps?: ~A~%" (-> this skip-gaps?))
  (label cfg-4)
  this
  )

;; definition of type race-line
(deftype race-line (structure)
  ((scale             vector  :inline)
   (offset            vector  :inline)
   (length            float)
   (flags             uint16)
   (points-per-slice  int16)
   (point-count       int16)
   (gap-index-count   int16)
   (slice-count       int16)
   (extra-points      int16)
   (points            (pointer uint64))
   (gap-indices       uint32)
   (slices            (pointer int16))
   (pad               uint32)
   )
  (:methods
    ;; wraps a raw point index into [0, point-count - extra-points): proven by
    ;; a0/a1 register reads only (this int), and by the (- (+ index count) count)
    ;; wrap loops on the returned value; jakx-levels-other-tier-4, race-line rung
    (race-line-method-9 (_type_ int) int)
    ;; slices[index] != -1 gap check: a0/a1 reads only (this int), lh from the
    ;; slices array then (nonzero? (+ value 1)); jakx-levels-other-tier-4
    (race-line-method-10 (_type_ int) symbol)
    ;; raw VU asm: reads a2 (an index), t7 (points pointer) and vf12/vf13
    ;; (scale/offset) without ever loading t7/vf12/vf13 itself, and never
    ;; reads a0 (this) at all, so it only works when called right after
    ;; something else (most likely method 12, which loads exactly these three
    ;; from this's own fields) has warmed those registers; flagged
    ;; asm_functions_by_name (hacks.jsonc). No caller of this method exists
    ;; anywhere in this tree yet, so this signature is a guess from the body's
    ;; own register reads only (a2: index, a1: vector to measure against, a3:
    ;; optional out-vector guarded by a beq-vs-#f check), not a proven call
    ;; site; mark accordingly.
    (race-line-method-11 (_type_ int vector vector) float)
    ;; raw VU asm: two inline point-array fetches ("Unsupported inline assembly
    ;; instruction kind" on the index+1/*8 pointer-stride pair) plus a failed
    ;; stack-use guess at offset 16; flagged asm_functions_by_name. Signature
    ;; proven from test-find-line-info's call site: this, the address of a
    ;; local race-line-query-info (read back inside at offsets 88/100, which
    ;; match current-slice/skip-gaps?), a second vector value, an int and a
    ;; symbol (both left unset by this particular caller).
    (race-line-method-12 (_type_ vector vector int symbol) float)
    ;; raw VU asm, recursive point-array fetch shape identical to method 12;
    ;; already flagged asm_functions_by_name before this rung. Signature
    ;; proven from test-find-closest-point's call site: this, two 16-byte
    ;; vector buffers, an int (9), a symbol (#t).
    (race-line-method-13 (_type_ vector vector int symbol) float)
    (race-line-method-14 (_type_) none)
    )
  )

;; definition for method 3 of type race-line
(defmethod inspect ((this race-line))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'race-line)
  (format #t "~1Tscale: #<vector @ #x~X>~%" (-> this scale))
  (format #t "~1Toffset: #<vector @ #x~X>~%" (-> this offset))
  (format #t "~1Tlength: ~f~%" (-> this length))
  (format #t "~1Tflags: ~D~%" (-> this flags))
  (format #t "~1Tpoints-per-slice: ~D~%" (-> this points-per-slice))
  (format #t "~1Tpoint-count: ~D~%" (-> this point-count))
  (format #t "~1Tgap-index-count: ~D~%" (-> this gap-index-count))
  (format #t "~1Tslice-count: ~D~%" (-> this slice-count))
  (format #t "~1Textra-points: ~D~%" (-> this extra-points))
  (format #t "~1Tpoints: #x~X~%" (-> this points))
  (format #t "~1Tgap-indices: #x~X~%" (-> this gap-indices))
  (format #t "~1Tslices: #x~X~%" (-> this slices))
  (format #t "~1Tpad: ~D~%" (-> this pad))
  (label cfg-4)
  this
  )

