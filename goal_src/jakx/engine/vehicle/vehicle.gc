;; og:preserve-this vehicle rung: the top-level killer was the config, not
;; goal_src. top-level-login referenced two commented-out types
;; (debug-vehicle-work, unused anywhere else in this file's own top level)
;; and two commented-out externs (*tmp-vehicle-info*, *vehicle-shadow-
;; control*/*-disabled*); all four are landed in all-types.gc and
;; vehicle-h.gc from direct evidence in this worktree's own decode (see
;; those files' own og:preserve-this notes). This landing covers only the
;; methods/functions that reach a clean decode; rigid-body-object-method-71
;; (vehicle's own override) and vehicle-method-155/157 are held out even
;; though their own bodies decode clean: they dispatch vehicle-method-142,
;; -143 and -134, none of which is landed anywhere in this worktree (142
;; and 143 do decode cleanly, but only inside vehicle-util.gc, out of this
;; rung's file list; 134 has no clean decode anywhere in the full-corpus
;; baseline). wvehicle-race.gc and vehicle-states.gc already call
;; vehicle-method-155 and -157 respectively; that is a pre-existing
;; check_method_slots FAIL, not one this landing introduces, and landing
;; either 155 or 157 here without their own callees would be the AGENTS.md
;; section 5 hazard the other way around. Every other broken function in
;; this file (roughly half of it) is held with its own failing op unnamed
;; here; see this commit's message for the per-function breakdown.

;; definition for symbol *debug-vehicle-work*, type debug-vehicle-work
(define *debug-vehicle-work* (new 'static 'debug-vehicle-work))

;; definition for symbol *tmp-vehicle-info*, type rigid-body-vehicle-constants
(define *tmp-vehicle-info* (the-as rigid-body-vehicle-constants #f))

;; definition for symbol *tmp-rigid-body-control*, type object
(define *tmp-rigid-body-control* (the-as object #f))

;; definition for symbol *vehicle-shadow-control*, type shadow-control
(define *vehicle-shadow-control*
  (new 'static 'shadow-control
    :settings (new 'static 'shadow-settings
      :center (new 'static 'vector :data (new 'static 'array float 4 0.0 0.0 0.0 (the-as float #xa)))
      :shadow-dir (new 'static 'vector :data (new 'static 'array float 4 0.0 -1.0 0.0 163840.0))
      :bot-plane (new 'static 'plane :data (new 'static 'array float 4 0.0 1.0 0.0 40960.0))
      :top-plane (new 'static 'plane :data (new 'static 'array float 4 0.0 1.0 0.0 2048.0))
      )
    )
  )

;; definition for symbol *vehicle-shadow-control-disabled*, type shadow-control
(define *vehicle-shadow-control-disabled*
  (new 'static 'shadow-control
    :settings (new 'static 'shadow-settings
      :center (new 'static 'vector :data (new 'static 'array float 4 0.0 0.0 0.0 (the-as float #x2a)))
      :shadow-dir (new 'static 'vector :data (new 'static 'array float 4 0.0 -1.0 0.0 163840.0))
