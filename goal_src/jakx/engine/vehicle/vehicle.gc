;; definition for method 87 of type vehicle
;; WARN: Return type mismatch int vs none.
(defmethod rigid-body-object-method-87 ((this vehicle))
  (set! *tmp-rigid-body-control* (-> this rbody))
  (let ((s5-0 #x70000000))
    (let ((a1-0 (&-> this rbody type)))
      (quad-copy! (the-as pointer s5-0) a1-0 19)
      )
    (set! (-> this rbody) (the-as rigid-body-control (+ s5-0 4)))
    )
  (set! *tmp-vehicle-info* (-> this info))
  (let ((s5-1 #x70000130))
    (quad-copy! (the-as pointer s5-1) (the-as pointer (-> this info)) 204)
    (rigid-body-object-method-68 this s5-1 #f)
    )
  (breakpoint-range-set! (the-as uint #x20200000) (the-as uint #x70000800) (the-as uint #xfffff800))
  (rigid-body-control-method-10 (-> this rbody) this (-> this rbody time-remaining) (-> this max-time-step))
  0
  (none)
  )

;; definition for method 112 of type vehicle
;; WARN: Return type mismatch int vs none.
(defmethod vehicle-method-112 ((this vehicle))
  (if (logtest? (-> this rbody flags) 256)
      ((method-of-object this vehicle-method-180))
      )
  (when (< (-> this health) 0.0)
    (logior! (-> this flags) 8)
    (if (not (focus-test? this dead))
        (go (method-of-object this explode))
        )
    )
  (let ((v1-15 (-> this rbody)))
    (cond
      ((logtest? (-> this flags) 8)
       (set! (-> v1-15 max-ang-momentum) (-> v1-15 info max-ang-momentum))
       (logand! (-> v1-15 flags) -33)
       )
      (else
        (set! (-> v1-15 max-ang-momentum) (* 500000000.0 (-> this info info mass)))
        )
      )
    )
  (if (and (logtest? (-> this draw status) (draw-control-status on-screen)) (< (-> this camera-dist) 819200.0))
      (calc-vu1-lights (-> this car-info lights) (-> this draw) #f)
      )
  0
  (none)
  )

