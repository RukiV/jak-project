;; og:preserve-this this rung lands only vehicle-section's own clean
;; methods (7, 9, 14, 15, 16, 18, 19; see the individual method notes
;; below). vehicle-section methods 10/12/13 and every vehicle-type
;; method this file also implements (dozens, per the baseline scoped
;; decode: methods including 78, 103, 138, 172, 182, 183 and
;; debug-draw-merc among them) are entirely unsurveyed and unlanded
;; this rung; the file's own scoped decode still carries roughly 45
;; ERROR markers outside the vehicle-section methods landed here, none
;; of them examined. check_method_slots's own vehicle-section-method-9
;; dispatch sites (wcar-wolf, wcar-wombat and others, 180 of 212
;; standing findings before this rung) are what motivated landing this
;; subset; the rest is a future rung's own scoped decode and typing
;; pass.
;;
;; og:preserve-this issue 571 R11 (the falcon-panels rung): (method 68
;; vehicle) and vehicle-section-method-11 are two further exceptions to
;; the paragraph above, both hand-translated rather than surveyed clean
;; -- this same worktree's own scoped decode of this file walls both
;; ("failed type prop at 28: add failed: <integer 1088 + (144 x int)>
;; object" for method 68; "function was not converted to expressions"
;; for method 11, a four-predecessor join at raw L186), structural walls
;; from, respectively, the base declaration's own `object` arg0/arg1
;; typing and a genuine CFG join the decompiler cannot build, not config
;; gaps. See each method's own header note for the full per-instruction
;; citation.
;;
;; og:preserve-this vinit rung (method 64 vehicle callee set): re-surveyed
;; vehicle-section-method-10 with a fresh scoped decode (worktree's own
;; config, --config-override allowed_objects ["vehicle-util"]) since it
;; is one of (method 64 vehicle)'s own zero-slot dispatch targets (offset
;; 56 = 16 + 4*10, called via the vehicle-section type symbol directly on
;; a freshly-initialized section, vehicle_ir2.asm ops 249-252). Confirmed
;; still HELD at that time, not stale: the decode carried "ERROR: Failed
;; to guess stack use for 16 in (method 10 vehicle-section):55", a
;; genuine stack-layout wall (a local 4x4 matrix built on the raw stack
;; via matrix-4x4-inverse!/matrix*!, the same sp+16 scratch idiom the
;; decompiler also cannot resolve in method 64 itself), not a config gap
;; that rung's tools could clear.
;;
;; og:preserve-this vinit2 rung: retired the hold above. A
;; stack_structures.jsonc entry alone ([16,"matrix"]) cleared the first
;; wall but exposed a second: op 70's plain-pointer re-derivation of the
;; matrix base (`(daddu a3, r0, s4)`) downgrades to vector in the
;; decompiler's own type propagation, so the four-quad unrolled copy two
;; ops later reads past a 16-byte vector ("Could not figure out load:
;; (set! a1 (l.q (+ a3 16)))"). Three type_casts.jsonc entries (ops 72-74,
;; each iteratively discovered the same way (method 10 rigid-body-queue)'s
;; own six-cast entry was, per that entry's own comment) recast a3 back to
;; matrix at each of the three remaining reads and the function decodes
;; fully clean, folding the raw quad copy into a plain `matrix-copy!`
;; call. The true footprint is two adjacent matrices (128 bytes, this
;; function's own "stack_vars: 136 bytes at 8" frame comment), the same
;; register-spill-overrun class this rung's own commit (e94d259a9)
;; catalogued -- stack_structures.jsonc now declares the full
;; [16,["inline-array","matrix",2]] span, and the landing below allocates
;; it the same way to match.

;; definition for method 9 of type vehicle-section
(defmethod vehicle-section-method-9 ((this vehicle-section) (arg0 vehicle) (arg1 art-group) (arg2 int))
  (set! (-> this node-index) (the-as int arg2))
  (let ((v1-0 (skeleton-group->draw-control
                (the-as process-drawable arg0)
                (the-as skeleton-group arg1)
                (the-as (pointer cspace-array) (&-> this node-list))
                )
              )
        )
    (set! (-> this draw) v1-0)
    (vector-reset! (-> v1-0 skeleton bones 0 transform trans))
    )
  0
  (none)
  )

;; definition for method 7 of type vehicle-section
(defmethod relocate ((this vehicle-section) (offset int))
  (when (nonzero? (-> this draw))
    (if (nonzero? (-> this node-list))
        (&+! (-> this node-list) offset)
        )
    (if (nonzero? (-> this draw))
        (&+! (-> this draw) offset)
        )
    )
  this
  )

;; definition for method 19 of type vehicle-section
(defmethod vehicle-section-method-19 ((this vehicle-section))
  (when (nonzero? (-> this draw))
    (if (nonzero? (logand (-> this flags) 6))
        (logior! (-> this draw status) 2)
        (logand! (-> this draw status) -3)
        )
    )
  0
  (none)
  )

;; definition for method 18 of type vehicle-section
(defmethod vehicle-section-method-18 ((this vehicle-section))
  (logior! (-> this flags) 4)
  (vehicle-section-method-19 this)
  0
  (none)
  )

;; definition for method 15 of type vehicle-section
(defmethod vehicle-section-method-15 ((this vehicle-section))
  (logior! (-> this flags) 1)
  (set! (-> this damage) 0.0)
  (set! (-> this angle) 0.0)
  (when (nonzero? (-> this draw))
    (car-info-full-method-13 (-> this car-info))
    (logand! (-> this flags) -3)
    (vehicle-section-method-19 this)
    )
  0
  (none)
  )

;; definition for method 14 of type vehicle-section
(defmethod vehicle-section-method-14 ((this vehicle-section))
  (let ((f30-0 (fmin 1.0 (* 0.1 (fabs (-> this d-angle))))))
    (when (< 0.2 f30-0)
      (let ((v1-8
              (make-sound-instance (-> *sound-info* (-> this info rattle-sound)) (new 'static 'sound-id) (the-as handle #f))
              )
            )
        (cond
          (v1-8
            (set! (-> v1-8 volume) (the int (* 1024.0 f30-0)))
            (logior! (-> v1-8 flags) 64)
            (-> v1-8 id)
            )
          (else
            0
            )
          )
        )
      )
    )
  0
  (none)
  )

;; definition for method 16 of type vehicle-section
;; WARN: Return type mismatch symbol vs none.
(defmethod vehicle-section-method-16 ((this vehicle-section) (arg0 draw-control-status) (arg1 draw-control-status))
  (when (nonzero? (-> this draw))
    (set! (-> this draw status) (the-as draw-control-status (logand (logior (-> this draw status) arg0) (lognot arg1))))
    )
  (none)
  )

;; og:preserve-this vehicle-util rung (method 13 landed below, 10/11/12
;; bodies still held at that time, all four signatures already landed):
;; vehicle-section methods 10, 11, 12 and 13 all have evidence-backed
;; argument types in all-types.gc as of the vehicle structural rung (R3)
;; -- method 10's second argument reads offsets 188/192 (process-drawable's
;; inherited root/node-list, unshifted) and 284 raw / 288 landed (car-info,
;; the vehicle-own +4-corrected region); only vehicle carries all three, so
;; it is typed vehicle, not the previously-claimed unproven construction/
;; spawn-params struct. Method 11 takes the spawning vehicle (its call site
;; only resolves once R2's vehicle-spawn externs are landed). Method 12's
;; second argument reads offset 228 (also unshifted, a process-drawable-
;; region field: `sound`, not `rbody` as originally suspected), so it is
;; typed vehicle too. Method 13's first argument is a raw float bit-pattern
;; passed in a gpr (the gpr->fpr mtc1 idiom), typed float -- with that one
;; retype method 13 decodes completely cleanly (a scoped decode after
;; landing the signature, zero error markers) and lands below. Method 11
;; is still a CFG building failure (no expression tree, unaffected by the
;; retype); method 12 still fails type prop at a different op (157, "add
;; failed: <uninitialized> <integer 0>") past an sllv handle-style idiom
;; (the same inlined-macro class rigid-body-queue.gc's own held methods
;; hit), with the originally-cited offset-228 failure itself resolved by
;; the retype. Both stay held; re-derive from the framework's own dump
;; (offline-test -f vehicle-util -d) in a future rung.
;;
;; og:preserve-this vinit2 rung: method 10 lands here too, retiring the
;; hold the paragraph above and the file's own top note left on it. Its
;; own decode wall (a matrix pointer aliased through a plain +0 register
;; copy losing its type) is a decompiler config gap, not the raw-asm wall
;; assumed earlier; see the top-of-file note and this rung's
;; stack_structures.jsonc/type_casts.jsonc entries for the full citation.

;; definition for method 10 of type vehicle-section
(defmethod vehicle-section-method-10 ((this vehicle-section) (arg0 vehicle))
  (logior! (-> this flags) 1)
  (set! (-> this car-info) (-> arg0 car-info))
  (set! (-> this draw lights) (-> arg0 draw lights))
  (set! (-> this draw lod-set lod 0 dist) (-> arg0 draw lod-set lod 0 dist))
  (set! (-> this draw lod-set lod 1 dist) (-> arg0 draw lod-set lod 1 dist))
  (set! (-> this draw lod-set lod 2 dist) (-> arg0 draw lod-set lod 2 dist))
  (logior! (-> this draw status) (draw-control-status force-vu1))
  (set! (-> this debris) (the-as uint #f))
  (vehicle-section-method-15 this)
  (cond
    ((>= 3 (-> this node-index))
     (set! (-> this parent-node-index) 3)
     (matrix-identity! (-> this info joint-local))
     )
    (else
      (let ((s5-1 (-> arg0 node-list data (-> this node-index))))
        (set! (-> this parent-node-index) (+ (-> s5-1 parent joint number) 1))
        (let ((s4-0 (new 'stack-no-clear 'inline-array 'matrix 2)))
          (matrix-4x4-inverse! (-> s4-0 1) (-> s5-1 parent bone transform))
          (matrix*! (-> s4-0 0) (-> s5-1 bone transform) (-> s4-0 1))
          (matrix-copy! (-> this info joint-local) (-> s4-0 0))
          )
        )
      )
    )
  0
  (none)
  )

;; definition for method 13 of type vehicle-section
;; WARN: Return type mismatch float vs none.
(defmethod vehicle-section-method-13 ((this vehicle-section) (arg0 float))
  (logior! (-> this flags) 1)
  (+! (-> this damage) (* arg0 (-> this info inv-hit-points)))
  (if (< 0.25 (-> this damage))
      (car-info-full-method-14 (-> this car-info) (-> this car-part))
      )
  (-> this damage)
  (none)
  )

;; og:preserve-this issue 571 R11: retired by this rung: the real body is
;; hand-translated from vehicle-util.o's machine code (raw L177-L190, 424
;; instructions). The CFG wall is unchanged and unfixable -- the
;; four-predecessor join at L186 is genuine, not a config gap -- but the
;; shape renders goto-free in hand-written GOAL as a three-armed cond plus
;; fallthrough. Two retail branches remain held on absent callees
;; (vehicle-section-method-12, setup-blerc-chains); see the note on the
;; defmethod.

;; definition for method 11 of type vehicle-section
;; og:preserve-this vehicle-spawn-chain rung (issue 571): hand-translated
;; from vehicle-util.o's own machine code (424 instructions, raw L177-L190)
;; because the decompiler cannot build a CFG here -- a four-predecessor
;; join at raw L186, swept against 35 blocks_ending_in_asm_branch
;; configurations with no set resolving it. The raw asm IS the citation for
;; every claim below; there is no twin (jak2/jak3 both declare
;; vehicle-section as a one-float structure with 9 methods). Every touched
;; field resolves to a NAMED field at this lane's current layouts
;; (vehicle-h.gc): joint-local, hinge-axis, min-angle/max-angle, mass and
;; cm-offset-joint (both via rbody info), and the rbody/info/node-list
;; paths on arg0 all checked directly against the landed deftypes before
;; landing, no dossier-generic name needed renaming.
;;
;; Implementer checks: (a) vector-dot is landed in jakx (vector-h.gc:469),
;; used directly below, no rlet fallback needed. (b) the perp-lever
;; computation uses the readable vector-algebra shape (vector-dot/vector-!/
;; vector-float*!), not the byte-faithful fused vmulax/vmaddw rlet: every
;; primitive it needs is already landed and idiomatic, and the rest of this
;; body already reads at that same level (vector-cross!, vector-!,
;; vector-normalize!), so a raw vu rlet here would be the only one of its
;; kind in the function.
;;
;; Two retail branches are intentionally NOT reproduced, both because their
;; callee does not exist in this port:
;;   - raw L185's (vehicle-section-method-12 this arg0): declared at
;;     vehicle-h.gc:123 with no defmethod anywhere, so the dispatch would
;;     jump to address 0 (kscheme.cpp:1069-1075 zero-fills unimplemented
;;     slots). Reached only when a section's damage reaches 1.0.
;;   - raw L186's setup-blerc-chains tail: the symbol does not exist in
;;     jakx at all (merc-blend-shape.gc is a 21-line stub; no mips2c body
;;     shipped). The flag lifecycle around it is reproduced exactly so the
;;     retirement is a one-line edit.
;; PREREQUISITE: (method 68 vehicle), landed earlier in this same lane
;; (issue 571 R11's own first commit), is the only writer of (-> section
;; info); this body dereferences it immediately.
(defmethod vehicle-section-method-11 ((this vehicle-section) (arg0 vehicle))
  (with-pp
    (when (nonzero? (-> this draw))
      (let* ((dc   (-> this draw))
             (sinf (-> this info))
             (dt   (seconds-per-frame))
             (mat  (new 'stack-no-clear 'matrix))
             (matq (new 'stack-no-clear 'matrix))
             (quat (new 'stack-no-clear 'quaternion))
             )
        ;; ---- base transform: joint-local x parent bone -----------------
        (matrix*! mat
                  (-> sinf joint-local)
                  (-> arg0 node-list data (-> this parent-node-index) bone transform)
                  )
        ;; flag bit 3: adopt the rigid body's world orientation, keep translation
        (when (logtest? (-> this flags) 8)
          (set! (-> mat vector 0 quad) (-> arg0 rbody matrix vector 0 quad))
          (set! (-> mat vector 1 quad) (-> arg0 rbody matrix vector 1 quad))
          (set! (-> mat vector 2 quad) (-> arg0 rbody matrix vector 2 quad))
          )
        ;; ---- hinge rotation ---------------------------------------------
        (quaternion-vector-angle! quat (-> sinf hinge-axis) (-> this angle))
        (quaternion->matrix matq quat)
        (matrix*! mat matq mat)

        ;; ---- publish to the section's draw-control -----------------------
        (logclear! (-> dc status) (draw-control-status no-draw-temp uninited))
        (set! (-> dc global-effect) (-> arg0 draw global-effect))
        ;; flag: bones 3 matches the landed convention elsewhere
        ;; (process-drawable.gc:489, debris.gc:387), unproven for a
        ;; section's own skeleton specifically.
        (let ((bt (-> dc skeleton bones 3 transform)))
          (set! (-> bt vector 0 quad) (-> mat vector 0 quad))
          (set! (-> bt vector 1 quad) (-> mat vector 1 quad))
          (set! (-> bt vector 2 quad) (-> mat vector 2 quad))
          (set! (-> bt vector 3 quad) (-> mat vector 3 quad))
          )
        (let ((tmp (new 'stack-no-clear 'vector)))
          (set! (-> tmp quad) (-> dc bounds quad))
          (set! (-> tmp w) 1.0)
          (vector-matrix*! (-> dc origin) tmp mat)
          )
        (set! (-> dc origin w) (-> dc radius))

        ;; ---- damage-driven hinge physics (raw L179..L184) ------------------
        (cond
          ((not (< 0.5 (-> this damage))))          ;; raw: fall straight to L186
          ((< (-> this damage) 1.0)
           (let ((wpos   (new 'stack-no-clear 'vector))
                 (waxis  (new 'stack-no-clear 'vector))
                 ;; flag: raw asm sets lever's w to 1.0; vector-!'s own
                 ;; docstring implies 0; nothing downstream reads w on
                 ;; lever, so the discrepancy is inert and not reproduced.
                 (lever  (new 'stack-no-clear 'vector))
                 (normal (new 'stack-no-clear 'vector))
                 (pvel   (new 'stack-no-clear 'vector))
                 (dvel   (new 'stack-no-clear 'vector))
                 (force  (new 'stack-no-clear 'vector))
                 (mass   (-> sinf rbody info mass))
                 )
             (vector-matrix*! wpos (-> sinf rbody info cm-offset-joint) mat)
             (vector-rotate*! waxis (-> sinf hinge-axis) mat)
             (vector-! lever wpos (-> mat trans))
             (vector-normalize! lever 1.0)
             (vector-cross! normal waxis lever)
             (vector-normalize! normal 1.0)

             (rigid-body-control-method-24 (-> arg0 rbody) wpos pvel)
             (vector-! dvel pvel (-> this vel))
             ;; flag: (* -1.0 (/ -1.0 dt) mass) is unambiguously mass/dt;
             ;; the doubled negation matches the raw asm exactly (raw
             ;; 193-202) and suggests a lost named intermediate upstream,
             ;; not a sign error.
             (vector-float*! force dvel (* -1.0 (/ -1.0 dt) mass))
             (+! (-> force y) (* -245760.0 mass))   ;; (meters -60) * mass, gravity
             (set! (-> this vel quad) (-> pvel quad))

             ;; perpendicular lever arm about the hinge axis
             (let ((perp (new 'stack-no-clear 'vector)))
               (set! (-> perp quad) (-> sinf rbody info cm-offset-joint quad))
               (let ((d (vector-dot (-> sinf hinge-axis) perp)))
                 (vector-! perp perp (vector-float*! (new 'stack-no-clear 'vector)
                                                     (-> sinf hinge-axis) d))
                 )
               (let ((dlen (vector-length perp)))
                 (+! (-> this d-angle) (* (/ (vector-dot normal force) (* mass dlen)) dt))
                 )
               )
             (set! (-> this d-angle) (* 0.97 (-> this d-angle)))
             (+! (-> this angle) (* 10430.3789 dt (-> this d-angle)))  ;; rad -> goal angle
             )

           ;; clamp against the section's own limits; the 4-pred join renders as a cond
           (when (cond
                   ((< (-> this angle) (-> sinf min-angle))
                    (set! (-> this angle) (-> sinf min-angle))
                    #t
                    )
                   ((< (-> sinf max-angle) (-> this angle))
                    (set! (-> this angle) (-> sinf max-angle))
                    #t
                    )
                   )
             (let* ((f1 (* 0.015625 (fmax 0.0 (+ -10.0 (fabs (-> this d-angle))))))
                    (f0 (* f1 f1))
                    )
               (when (< 0.0 f0)
                 (vehicle-section-method-13 this f0)
                 )
               )
             (vehicle-section-method-14 this)
             (set! (-> this d-angle) (* -0.7 (-> this d-angle)))
             )
           )
          (else
            ;; raw L185: (if (not (logtest? (-> this flags) 2))
            ;;               (vehicle-section-method-12 this arg0))
            ;; HELD: method 12 has no defmethod; the call would dispatch to 0.
            )
          )

        ;; ---- blerc tail (raw L186..L190) ------------------------------------
        (when (and (logtest? (-> this flags) 1)
                   (not (logtest? (-> dc status) (draw-control-status no-draw)))
                   )
          (when (nonzero? (-> dc mgeo header blend-target-count))
            (let ((weights (new 'stack-no-clear 'array 'int16 8)))
              ;; flag: literal bound 1, slot 0 immediately overwritten below;
              ;; degenerate but faithful to the raw asm's own zero loop.
              (dotimes (i 1)
                (set! (-> weights i) (the-as int16 0))
                )
              (set! (-> weights 0) (the int (* 8192.0 (fmin 1.0 (-> this damage)))))
              ;; HELD: (setup-blerc-chains (-> dc mgeo) weights
              ;;         (-> *display* frames (-> *display* on-screen) global-buf))
              ;; -- symbol does not exist in jakx; blerc is unported in this game.
              )
            (logclear! (-> this flags) 1)
            )
          )
        )
      )
    0
    (none)
    )
  )

;; og:preserve-this issue 571 (the falcon-panels rung continues): this is
;; the fix for the spawn-crash regression (method 68 vehicle)'s own landing
;; introduced. (method 68 vehicle)'s retail-faithful tail dispatch
;; ((method-of-type rigid-body-vehicle-constants
;; rigid-body-vehicle-constants-method-10) (-> this info)) below reaches
;; this slot (declared vehicle-h.gc:651, :method-count-assert 11 against
;; the parent's 10, kernel zero-fills any slot with no defmethod) on every
;; single spawn, because rigid-body-object.gc:172's
;; (rigid-body-object-method-68 this (the-as rigid-body-object-constants
;; arg0) #t) always passes #t as the guard arg. The body below is retail's
;; own asm, restated verbatim (spawninv-raw/jakx/vehicle-util.asm:4836-4849;
;; task-output files read empty to other agents, so this is the only
;; surviving citation):
;;   lw v1, *vehicle-particle-common-info*(s7)
;;   sw v1, 3256(a0)               ; particle-common@3256 (vehicle-h.gc:641)
;;   lwu a0, 3256(a0)
;;   lw v1, vehicle-particle-common-info(s7)
;;   lwu t9, 52(v1)                ; method (52-16)/4 = 9
;;   jalr ra, t9
;; Both callees are already landed and link before this file: the symbol
;; *vehicle-particle-common-info* (vehicle-effects.gc:121) and
;; vehicle-particle-common-info-method-9 (vehicle-effects.gc:78, pure field
;; assignments, no unlanded dispatch of its own) -- game.gd links
;; vehicle-effects.o at 478 before vehicle-util.o at 481. Two further
;; siblings off the same canonical spawn path (vehicle-manager.gc's
;; vehicle-init-by-other) are flag/behavior-gated and still dodge this
;; landing: vehicle-method-177 (flags bit 2, vehicle-manager.gc:417) and
;; vehicle-method-184 (behavior nonzero, vehicle-manager.gc:426); neither
;; fires on the falcon's own canonical spawn.
;; Signature check: vehicle-h.gc:651 declares (_type_) none, matching
;; all-types.gc's own live (resurrected) deftype (line 53859's :methods).
;; A dead, commented-out duplicate deftype block earlier in that same file
;; (line 53822) still carries the pre-retype () arity -- pre-existing
;; noise this rung does not touch.
;;
;; definition for method 10 of type rigid-body-vehicle-constants
;; WARN: Return type mismatch int vs none.
(defmethod rigid-body-vehicle-constants-method-10 ((this rigid-body-vehicle-constants))
  (set! (-> this particle-common) *vehicle-particle-common-info*)
  (vehicle-particle-common-info-method-9 (-> this particle-common))
  0
  (none)
  )

;; og:preserve-this issue 571 R11: hand-translated from raw asm
;; (vehicle-util.asm:4581-4684, ~104 instructions), the twin-less
;; convention -- this worktree's own scoped decode of this file walls the
;; function ("failed type prop at 28: add failed: <integer 1088 + (144 x
;; int)> object", vehicle-util_ir2.asm:7729), a structural wall from the
;; base declaration's own `object object` arg typing (rigid-body-h.gc),
;; not a config gap; the decompiler's own partial type-tracking through
;; op 27 is cited below wherever it resolves a type ahead of the wall.
;;
;; [op 3] `(-> this info)` is captured into s3-0 before call-parent-method
;; runs, because the parent body (rigid-body-object-method-68,
;; rigid-body-object.gc) overwrites `(-> this info)` with arg0 itself;
;; every later read of the OLD constants has to come from this captured
;; value, not a fresh `(-> this info)`.
;; [ops 4-12] `find-parent-method`/dispatch matches this codebase's own
;; landed call-parent-method macro (kernel/gcommon.gc) register for
;; register (t9 = the looked-up function, a0/a1/a2 = this/arg0/arg1
;; unchanged) -- confirmed against this file's own already-landed
;; parent-dispatch idiom (vehicle.gc:159-162's method 81 override; also
;; plow.gc and garage-obs.gc's landed call-parent-method sites).
;; [ops 14/16/18, guarded by arg1] three plain pointer copies from the OLD
;; constants (s3-0) into the NEW ones (arg0): hardpoint's own
;; local-pos-array (raw offset 3136, typed (inline-array vector) by this
;; scoped decode), rider's attach-point-array (raw 3120, (inline-array
;; matrix)) and attach-node-array (raw 3124, (pointer int8)) -- all three
;; raw offsets match their vehicle-h.gc deftype declarations directly (the
;; :inline base offset of hardpoint/rider plus the field's own internal
;; offset), no further +4 shift: the +4 convention is a basic-tag
;; artifact, and rigid-body-vehicle-constants and its own :inline fields
;; carry no tag of their own once reached through the one +4-corrected
;; `this info` load at op 3.
;; [the loop, ops 20-46] a 12-iteration dotimes over `sections` and
;; `damage section-array`, both :inline arrays per vehicle-h.gc (sections
;; @1024 stride 64; damage@1056 + section-array@32 = 1088 stride 144,
;; matching the raw `dsll .. 6` / `144 x int` multipliers exactly, and the
;; brief's own citation). Per iteration, when arg1 is set, the NEW
;; constants' section-array[i]'s joint-local matrix (offset 48, 4
;; quadwords) is seeded from the OLD constants' own section-array[i]
;; joint-local; unconditionally, this vehicle's own sections[i]'s `info`
;; pointer is repointed at the NEW constants' section-array[i] -- the
;; mechanism that wires each vehicle-section's per-section stats to
;; whichever constants buffer method 68 was last called with (a live
;; readback of a spawned falcon found all four probed sections' info = 0
;; before this landing, method 68 the only writer).
;; [ops 47-53] a third arg1-guarded tail: `(-> this info)` is re-read
;; fresh (not s3-0, not arg0 directly) because call-parent-method already
;; repointed it, then dispatched virtually through rigid-body-vehicle-
;; constants's own method table (declared slot 10, vehicle-h.gc; no
;; defmethod lands its body this rung, per that type's own comment).
;;
;; definition for method 68 of type vehicle
;; WARN: Return type mismatch int vs none.
(defmethod rigid-body-object-method-68 ((this vehicle) (arg0 object) (arg1 object))
  (let ((s3-0 (-> this info))
        (a1-6 (the-as rigid-body-vehicle-constants arg0))
        )
    (call-parent-method this arg0 arg1)
    (when arg1
      (set! (-> a1-6 hardpoint local-pos-array) (-> s3-0 hardpoint local-pos-array))
      (set! (-> a1-6 rider attach-point-array) (-> s3-0 rider attach-point-array))
      (set! (-> a1-6 rider attach-node-array) (-> s3-0 rider attach-node-array))
      )
    (dotimes (v1-0 12)
      (when arg1
        (matrix-copy! (-> a1-6 damage section-array v1-0 joint-local) (-> s3-0 damage section-array v1-0 joint-local))
        )
      (set! (-> this sections v1-0 info) (-> a1-6 damage section-array v1-0))
      )
    (when arg1
      ((method-of-type rigid-body-vehicle-constants rigid-body-vehicle-constants-method-10) (-> this info))
      )
    )
  0
  (none)
  )

;; og:preserve-this method 69 (rigid-body-object-method-69): the vinit rung
;; held this on vehicle-method-100 having no base-vehicle override (v-drone
;; is the uncovered leaf, see that hold's own citation trail, retained
;; below for provenance). vinit2 rung: retired. A scoped decode of this
;; worktree's own vehicle-util object turned up jakx's own base
;; vehicle-method-100 body (landed immediately below, distinct from any
;; wcar-* leaf override), so method 69's own call-parent-method +
;; vehicle-method-100 dispatch now resolves everywhere, including on
;; v-drone. Landing order matters here: method-100 must land first so this
;; method's own dispatch never sees a zero slot.
;;
;; former vinit-rung hold text, kept for the record: Scoped decode against
;; this worktree's own config (--config-override allowed_objects
;; [vehicle-util], levels_extract false, ntsc_v1) is clean:
;; (call-parent-method this) then (vehicle-method-100 this). Zero-slot:
;; vehicle never overrode this slot, so (method 69 wvehicle)
;; (wvehicle-util.gc:12)'s own call-parent-method lands straight on
;; rigid-body-object's base body (rigid-body-object.gc:51), skipping
;; vehicle-level init entirely -- the bug this rung's investigation traced.
;; But landing it as-is trades that bug for a worse one: vehicle-method-100
;; has no base-vehicle override, and while most wcar-* leaf types do
;; override it (wcar-cheetah.gc and 14 siblings), v-drone does not --
;; wcar-drone.gc's (deftype v-drone (wcar-base)) chain (wcar-base.gc,
;; wvehicle-util.gc) carries no vehicle-method-100 override anywhere, and
;; v-drone is a live traffic-vehicle-type (traffic-h.gc:68/146-147,
;; car-info-h.gc:54, *v-drone-constants* in wcar.gc), not dead code.
;; Worse, the reachable path is live today: rigid-body-object's own base
;; method 64 (rigid-body-object.gc:161-173) unconditionally calls
;; (rigid-body-object-method-69 this) on every spawned rigid-body-object
;; that has not overridden method 64 itself, which v-drone (and
;; wcar-base) do not, so v-drone still uses that base method 64. Landing
;; vehicle's method 69 today would make that existing call path resolve
;; through wvehicle's override into vehicle's new one into
;; vehicle-method-100 on a v-drone instance -- a zero vtable slot, a new
;; crash this rung would introduce rather than fix (AGENTS.md section 5).

;; og:preserve-this method 100 (vehicle-method-100): vinit2 rung, the base
;; landing that unblocks method 69 above. Scoped decode of this worktree's
;; own vehicle-util object (lane-decompwall's own build of decompiler.exe,
;; see this rung's report -- the primary checkout's prebuilt binary
;; predates the srl fold and is stale for this whole file) turns up a
;; distinct, clean base body: recomputes root-prim's own local-sphere
;; radius from every child prim's local-sphere (max of length + w), then
;; resets and rewrites it. This is NOT jak3's own vehicle-method-100
;; (city/traffic/vehicle/vehicle-util.gc:952, a shadow-ctrl disable-draw
;; toggle) -- that number collides across the two corpora without being
;; the same method; jakx's own decode is the only evidence used here.
;; definition for method 100 of type vehicle
;; WARN: Return type mismatch int vs none.
(defmethod vehicle-method-100 ((this vehicle))
  (let ((v1-1 (-> this root root-prim))
        (f0-0 0.0)
        )
    (dotimes (a0-1 (the-as int (-> v1-1 specific 0)))
      (let ((a1-3 (-> (the-as collide-shape-prim-group v1-1) child a0-1 local-sphere)))
        (set! f0-0 (fmax f0-0 (+ (vector-length a1-3) (-> a1-3 w))))
        )
      )
    (vector-reset! (-> v1-1 local-sphere))
    (set! (-> v1-1 local-sphere w) f0-0)
    )
  0
  (none)
  )

;; definition for method 69 of type vehicle
;; WARN: Return type mismatch int vs none.
(defmethod rigid-body-object-method-69 ((this vehicle))
  (call-parent-method this)
  (vehicle-method-100 this)
  (none)
  )

