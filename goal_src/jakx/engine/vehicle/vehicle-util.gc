;; definition for method 110 of type vehicle
;; WARN: Return type mismatch int vs none.
(defmethod vehicle-method-110 ((this vehicle))
  (logand! (-> this flags) (the-as uint #xffffdffffc7e4151))
  (set! (-> this v-flags-2) (-> this flags))
  (logior! (-> this rbody flags) 16)
  (logclear! (-> this focus-status) (focus-status disable dead inactive))
  (rigid-body-object-method-69 this)
  (rigid-body-object-method-73 this)
  (set! (-> this health) 1.0)
  (let ((f0-1 0.0))
    (s.f! (&+ this 856) f0-1)
    )
  (if (< 1 *view-count*)
      (logior! (-> this flags) #x2000000)
      )
  (vehicle-method-153 this)
  (set-time! (-> this state-time))
  (let ((v1-22 (-> this info damage section-mask)))
    (dotimes (a0-9 12)
      (when (logtest? v1-22 (ash 1 a0-9))
        (let ((a1-6 (-> this sections a0-9)))
          (set! (-> a1-6 damage) 0.0)
          )
        )
      )
    )
  0
  (none)
  )
