;;-*-Lisp-*-
(in-package goal)

;; name: vehicle-util.gc
;; name in dgo: vehicle-util
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

;; og:preserve-this this rung lands only vehicle-section's own clean
;; methods (7, 9, 14, 15, 16, 18, 19; see the individual method notes
;; below). vehicle-section methods 10/11/12/13 and every vehicle-type
;; method this file also implements (dozens, per the baseline scoped
;; decode: methods including 78, 103, 138, 172, 182, 183 and
;; debug-draw-merc among them) are entirely unsurveyed and unlanded
;; this rung; the file's own scoped decode still carries roughly 45
;; ERROR markers outside the vehicle-section methods landed here, none
;; of them examined. check_method_slots's own vehicle-section-method-9
;; dispatch sites (wcar-wolf, wcar-wombat and others, 180 of 212
;; standing findings before this rung) are what motivated landing this
;; subset; the rest is a future rung's own scoped decode and typing
;; pass.

;; definition for method 9 of type vehicle-section
(defmethod vehicle-section-method-9 ((this vehicle-section) (arg0 vehicle) (arg1 art-group) (arg2 int))
  (set! (-> this node-index) (the-as int arg2))
  (let ((v1-0 (skeleton-group->draw-control
                (the-as process-drawable arg0)
                (the-as skeleton-group arg1)
                (the-as (pointer cspace-array) (&-> this node-list))
                )
              )
        )
    (set! (-> this draw) v1-0)
    (vector-reset! (-> v1-0 skeleton bones 0 transform trans))
    )
  0
  (none)
  )

;; definition for method 7 of type vehicle-section
(defmethod relocate ((this vehicle-section) (offset int))
  (when (nonzero? (-> this draw))
    (if (nonzero? (-> this node-list))
        (&+! (-> this node-list) offset)
        )
    (if (nonzero? (-> this draw))
        (&+! (-> this draw) offset)
        )
    )
  this
  )

;; definition for method 19 of type vehicle-section
(defmethod vehicle-section-method-19 ((this vehicle-section))
  (when (nonzero? (-> this draw))
    (if (nonzero? (logand (-> this flags) 6))
        (logior! (-> this draw status) 2)
        (logand! (-> this draw status) -3)
        )
    )
  0
  (none)
  )

;; definition for method 18 of type vehicle-section
(defmethod vehicle-section-method-18 ((this vehicle-section))
  (logior! (-> this flags) 4)
  (vehicle-section-method-19 this)
  0
  (none)
  )

;; definition for method 15 of type vehicle-section
(defmethod vehicle-section-method-15 ((this vehicle-section))
  (logior! (-> this flags) 1)
  (set! (-> this damage) 0.0)
  (set! (-> this angle) 0.0)
  (when (nonzero? (-> this draw))
    (car-info-full-method-13 (-> this car-info))
    (logand! (-> this flags) -3)
    (vehicle-section-method-19 this)
    )
  0
  (none)
  )

;; definition for method 14 of type vehicle-section
(defmethod vehicle-section-method-14 ((this vehicle-section))
  (let ((f30-0 (fmin 1.0 (* 0.1 (fabs (-> this d-angle))))))
    (when (< 0.2 f30-0)
      (let ((v1-8
              (make-sound-instance (-> *sound-info* (-> this info rattle-sound)) (new 'static 'sound-id) (the-as handle #f))
              )
            )
        (cond
          (v1-8
            (set! (-> v1-8 volume) (the int (* 1024.0 f30-0)))
            (logior! (-> v1-8 flags) 64)
            (-> v1-8 id)
            )
          (else
            0
            )
          )
        )
      )
    )
  0
  (none)
  )

;; definition for method 16 of type vehicle-section
;; WARN: Return type mismatch symbol vs none.
(defmethod vehicle-section-method-16 ((this vehicle-section) (arg0 draw-control-status) (arg1 draw-control-status))
  (when (nonzero? (-> this draw))
    (set! (-> this draw status) (the-as draw-control-status (logand (logior (-> this draw status) arg0) (lognot arg1))))
    )
  (none)
  )

;; og:preserve-this vehicle-util rung (method 13 landed below, 10/11/12
;; bodies still held, all four signatures now landed): vehicle-section
;; methods 10, 11, 12 and 13 all have evidence-backed argument types in
;; all-types.gc as of the vehicle structural rung (R3) -- method 10's
;; second argument reads offsets 188/192 (process-drawable's inherited
;; root/node-list, unshifted) and 284 raw / 288 landed (car-info, the
;; vehicle-own +4-corrected region); only vehicle carries all three, so it
;; is typed vehicle, not the previously-claimed unproven construction/
;; spawn-params struct. Method 11 takes the spawning vehicle (its call site
;; only resolves once R2's vehicle-spawn externs are landed). Method 12's
;; second argument reads offset 228 (also unshifted, a process-drawable-
;; region field: `sound`, not `rbody` as originally suspected), so it is
;; typed vehicle too. Method 13's first argument is a raw float bit-pattern
;; passed in a gpr (the gpr->fpr mtc1 idiom), typed float -- with that one
;; retype method 13 decodes completely cleanly (a scoped decode after
;; landing the signature, zero error markers) and lands below. The other
;; three bodies do not land this rung: method 10's own scoped decode is now
;; clean through its first (if) branch but its (else) branch still carries
;; unresolved raw pointer arithmetic (a matrix-identity!/matrix-4x4-
;; inverse! cascade this rung did not fully trace); method 11 is still a
;; CFG building failure (no expression tree, unaffected by the retype);
;; method 12 still fails type prop, now at a different op (157, "add
;; failed: <uninitialized> <integer 0>") past an sllv handle-style idiom
;; (the same inlined-macro class rigid-body-queue.gc's own held methods
;; hit), with the originally-cited offset-228 failure itself resolved by
;; the retype. Re-derive the remaining three bodies from the framework's
;; own dump (offline-test -f vehicle-util -d) in a future rung.

;; definition for method 13 of type vehicle-section
;; WARN: Return type mismatch float vs none.
(defmethod vehicle-section-method-13 ((this vehicle-section) (arg0 float))
  (logior! (-> this flags) 1)
  (+! (-> this damage) (* arg0 (-> this info inv-hit-points)))
  (if (< 0.25 (-> this damage))
      (car-info-full-method-14 (-> this car-info) (-> this car-part))
      )
  (-> this damage)
  (none)
  )
