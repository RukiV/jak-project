;; og:preserve-this method 153 (vehicle-method-153): vinit2 rung. Held by
;; the vinit rung on "ERROR: Unsupported inline assembly instruction kind -
;; [srl v1, v1, 24]", a genuine decompiler wall; PR 645/647's decompiler
;; fold (folding a bare srl into a shr form) clears it -- this rung's own
;; scoped decode, run against lane-decompwall's own build of decompiler.exe
;; (the primary checkout's prebuilt binary predates the fold), decodes the
;; former raw asm line as a clean `(the float (shr (-> this car-info
;; tuning) 24))` writing unknown-float-720, matching this file's own
;; already-landed field declaration (vehicle-h.gc) exactly.
;; definition for method 153 of type vehicle
;; WARN: Return type mismatch int vs none.
(defmethod vehicle-method-153 ((this vehicle))
  (vehicle-method-182 this 1.0)
  (vehicle-method-183 this (-> this info damage hit-points))
  (set! (-> this unknown-float-720)
        (/ 1.0 (+ 4.0 (* 0.22500001 (the float (shr (-> this car-info tuning) 24)))))
        )
  (set! (-> this torque-scale) (+ 1.0 (* 0.05 (the float (shr (shl (-> this car-info tuning) 48) 56)))))
  0
  (none)
  )

;; og:preserve-this method 110 (vehicle-method-110): the vinit rung held
;; this on vehicle-method-153 having no defmethod anywhere (retained below
