   (idle-throttle                  float                             :offset-assert 2416)
   (wheelbase                      float                             :offset-assert 2420)
   (f-track-width                  float                             :offset-assert 2424)
   (r-track-width                  float                             :offset-assert 2428)
   (susp-spring-control            float                             :offset-assert 2432)
