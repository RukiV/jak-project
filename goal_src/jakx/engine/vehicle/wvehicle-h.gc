;;-*-Lisp-*-
(in-package goal)

;; name: wvehicle-h.gc
;; name in dgo: wvehicle-h
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

;; og:preserve-this issue 540: rigid-body-surface single-homed to
;; rigid-body-surface-h.gc (game.gd link position 365, this file's own
;; 373). new_type rewrites every custom method slot on every deftype
;; execution of the same interned type (issue 534); this file's own
;; duplicate deftype is deleted (its field-choice evidence, the
;; rigid-body-surface-flag/tire-roll-mix note, moved with it), since
;; rigid-body-surface-h.gc compiles first (all_objs.json index 513 vs this
;; file's own 521).

;; og:preserve-this vehicle-wheel-info moved to vehicle-h.gc. The game registers
;; it in vehicle-h, not here, and vehicle-h.o precedes wvehicle-h.o in build
;; order, which vehicle-physics-model-info needs since it holds two of them
;; :inline. vehicle-wheel-state below stays: the game does register that one in
;; this object.

(deftype vehicle-wheel-state (structure)
  ((info             vehicle-wheel-info               :offset-assert 0)
   (flags            uint8                            :offset-assert 4)
   (prev-flags       uint8                            :offset-assert 5)
   (handle           handle                           :offset-assert 8)
   (probe-local-pos  vector                   :inline :offset-assert 16)
   (probe-local-dir  vector                   :inline :offset-assert 32)
   (local-axis       vector                   :inline :offset-assert 48)
   (surface-pos      vector                   :inline :offset-assert 64)
   (ground-pos       vector                   :inline :offset-assert 80)
   (ground-normal    vector                   :inline :offset-assert 96)
   (trans            vector                   :inline :offset-assert 112)
   (quat             quaternion               :inline :offset-assert 128)
   (trail-pos        vector                   2 :inline :offset-assert 144) ;; guessed by decompiler
   (surface          rigid-body-surface               :offset-assert 176) ;; vehicle-wheel-surface
   (pos              float                            :offset-assert 180)
   (pos2             float                            :offset-assert 184)
   (inertia          float                            :offset-assert 188)
   (steer-angle      float                            :offset-assert 192)
   (angle            float                            :offset-assert 196)
   (rev              float                            :offset-assert 200)
   (x-scale          float                            :offset-assert 204)
   (torque           float                            :offset-assert 208)
   (braking-torque   float                            :offset-assert 212)
   (up-force         float                            :offset-assert 216)
   (drive-diff       float                            :offset-assert 220)
   (side-vel         float                            :offset-assert 224)
   (up-vel           float                            :offset-assert 228)
   (forward-vel      float                            :offset-assert 232)
   (forward-slip-vel float                            :offset-assert 236)
   (friction-coef    float                            :offset-assert 240)
   (sink-depth       float                            :offset-assert 244)
   (sin-susp-ang     float                            :offset-assert 248)
   (cos-susp-ang     float                            :offset-assert 252)
   (part-birth-accum sparticle-launch-control 4       :offset-assert 256) ;; guessed by decompiler
   (tread-time       uint32                           :offset-assert 272)
   (tread-tracker    uint64                           :offset-assert 280) ;; handle
   )
  :method-count-assert 9
  :size-assert         #x120
  :flag-assert         #x900000120
  )

;; og:preserve-this :pack-me: wvehicle's own net-extra field lands at the
;; confirmed offset 2140 (raw 2136 + 4, both the original capture and this
;; rung's own decode of wvehicle-h.o's inspect method agree), which is not
;; 16-byte aligned. Every :inline structure in this type system defaults to
;; 16-byte alignment (STRUCTURE_ALIGNMENT) regardless of its own contents
;; unless marked :pack-me, in which case inline placement uses the type's
;; own tightest field alignment (4, for this all-float structure) instead.
(deftype wvehicle-net-extra (structure)
  ((desired-steering  float  :offset-assert 0)
   (desired-throttle  float  :offset-assert 4)
   (desired-wheel-rev float  :offset-assert 8)
   )
  :method-count-assert 9
  :size-assert         #xc
  :flag-assert         #x90000000c
  :pack-me
  )

;; og:preserve-this race-control's own fields (state/racer-state/mesh/line)
;; are all plain, non-inline pointers (4 bytes each, closing race-control's
;; own size-assert exactly at 0x10), so the pointee types only need to
;; exist for the field declarations to resolve; their own internal layouts
;; are not on this rung's critical path. race-state, racer-state and
;; race-line are landed in race-line-h.gc (slot 370, ahead of this file at
;; 375) with the basic-to-structure parent correction, so only race-mesh
;; still needs a forward declare here; it stays outside the brief's M1
;; header list. Forward-declared minimally per the brief's own §5
;; minimum-and-flag guidance.
(declare-type race-mesh basic)

;; method 9's arg1 is a wvehicle, proven at its only call site,
;; wvehicle-method-262 (car-textures corpus, this worktree's config);
;; wvehicle itself is declared later in this same file.
(declare-type wvehicle basic)

;; og:preserve-this issue 540: race-control single-homed to
;; race-control.gc (game.gd link position 371, this file's own 373).
;; new_type rewrites every custom method slot on every deftype execution of
;; the same interned type (issue 534); this file's own duplicate deftype is
;; deleted (its :pack-me and method-9 call-site evidence moved with it),
;; since race-control.gc compiles first (all_objs.json index 519 vs this
;; file's own 521).

;; og:preserve-this issue 540: nav-location single-homed to nav-mesh-h.gc
;; (game.gd link position 181, this file's own 373). new_type rewrites
;; every custom method slot on every deftype execution of the same interned
;; type (issue 534); this file previously carried its own deftype (with
;; nav-mesh/nav-poly forward-declared alongside it) because the nav system
;; was still a goal_src stub when wvehicle-ai-destination below first
;; needed nav-location :inline. nav-mesh-h.gc has since landed the real nav
;; system, including nav-mesh, nav-poly and nav-location itself, and
;; compiles first (all_objs.json index 329 vs this file's 521), so
;; wvehicle-ai-destination below resolves nav-location against the
;; already-registered type without a local redefinition or forward declare.

(deftype wvehicle-ai-destination (structure)
  ((final-position vector       :inline :offset-assert 0)
   (position       vector       :inline :offset-assert 16)
   (velocity       vector       :inline :offset-assert 32)
   (nav-location   nav-location :inline :offset-assert 48)
   (handle         uint64               :offset-assert 56)
   )
  :method-count-assert 9
  :size-assert         #x40
  :flag-assert         #x900000040
  )

(deftype wvehicle-ai-state (structure)
  ((destination             wvehicle-ai-destination :inline :offset-assert 0)
   (nav-location            nav-location            :inline :offset-assert 64)
   (current-travel          vector                  :inline :offset-assert 80)
   (previous-steering-error float                           :offset-assert 96)
   (no-physics-speed        float                           :offset-assert 100)
   (blocked-timer           float                           :offset-assert 104)
   (reverse-timer           float                           :offset-assert 108)
   (flags                   uint32                          :offset-assert 112)
   (desired-speed           float                           :offset-assert 116)
   (weapon-timer            uint64                          :offset-assert 120)
   (weapon-aggression       float                           :offset-assert 128)
   (mode                    uint8                           :offset-assert 132)
   )
  :method-count-assert 9
  :size-assert         #x85
  :flag-assert         #x900000085
  )

;; og:preserve-this loops landed as an extent-true 32-byte pad rather than
;; "wvehicle-engine-loop-state 2": that type's own size-assert (5 bytes,
;; id+index) does not divide the 32-byte span evenly under any of GOAL's
;; array-sizing rules (TypeSystem.cpp:1360-1414: 2x4=8 non-inline reference,
;; or 2x align(5,N) inline), so the true element layout is under-captured.
;; wvehicle-engine-mix-state's own size-assert (32) is confirmed by its use
;; as an inline field twice in wvehicle (min/max-load-engine-mix-state);
;; the internal breakdown is not on this rung's critical path.
(deftype wvehicle-engine-mix-state (structure)
  ((loops uint8 32 :offset-assert 0)
   )
  :method-count-assert 9
  :size-assert         #x20
  :flag-assert         #x900000020
  )

;; og:preserve-this dropped "data" (captured UNKNOWN 4, :offset-assert 0):
;; the brief's own field-extent arithmetic (§2.5) assumed 4 bytes/element
;; for an untyped UNKNOWN field, computing "fields end 16" against this
;; type's actual 4-byte size-assert, the -12 delta on the punch list. "data"
;; is a duplicate alias for the same 4 bytes the four int8 fields (and
;; "blob") already cover, same union-alias class as this rung's other
;; fixes; dropping it closes the delta exactly with no pad needed.
;; og:preserve-this :pack-me: wvehicle's own prev-wpn-sync field lands at
;; the confirmed offset 4584, not 16-byte aligned.
(deftype wvehicle-weapon-sync-blob (structure)
  ((wpn-left-type     int8      :offset-assert 0)
   (wpn-right-type    int8      :offset-assert 1)
   (wpn-left-powerup  int8      :offset-assert 2)
   (wpn-right-powerup int8      :offset-assert 3)
   (blob              int32     :offset 0)
   )
  :method-count-assert 9
  :size-assert         #x4
  :flag-assert         #x900000004
  :pack-me
  )

(deftype wvehicle-sound-loop-state (structure)
  ((id    sound-id  :offset-assert 0) ;; guessed by decompiler
   (vol   float     :offset-assert 4)
   (pitch float     :offset-assert 8)
   )
  :method-count-assert 9
  :size-assert         #xc
  :flag-assert         #x90000000c
  )

;; og:preserve-this three fields marked :inline that the capture did not:
;; wheel (vehicle-wheel-state 4), tire-roll-loop-state
;; (wvehicle-sound-loop-state 6), tire-slide-loop-state
;; (wvehicle-sound-loop-state 2). Each is confirmed by the gap to the next
;; captured field, exact to the byte: wheel spans 2480-3632 (1,152 =
;; 4 x sizeof(vehicle-wheel-state)); tire-roll-loop-state spans 3664-3760
;; (96 = 6 x 16, the type's own 12-byte size rounded up to its inline array
;; stride alignment); tire-slide-loop-state spans 3760-3792 (32 = 2 x 16).
;; A non-inline array of a reference type reserves only array_size x
;; POINTER_SIZE (TypeSystem.cpp:1381-1388), which is nowhere near any of
;; these spans; the captured offsets only make sense as inline arrays.
(deftype wvehicle (vehicle)
  ((net-extra                      wvehicle-net-extra        :inline :offset-assert 2140)
   ;; og:preserve-this vehicle-antenna rung: retyped uint64 -> handle, the
   ;; same wpn-right precedent below. Single writer ((method 64 wvehicle),
   ;; the antenna-spawn block this rung unholds) constructs it via the
   ;; standard process->handle expansion on vehicle-antenna-spawn's own
   ;; return; zero readers anywhere in the corpus.
   (antenna                        handle                            :offset-assert 2152)
   (fire-tracker                   handle                            :offset-assert 2160)
   (race                           race-control              :inline :offset-assert 2168)
   (ai                             wvehicle-ai-state         :inline :offset-assert 2192)
   (engine-rev                     float                             :offset-assert 2328)
   (engine-inertia                 float                             :offset-assert 2332)
   (engine-torque                  float                             :offset-assert 2336)
   (engine-max-torque              float                             :offset-assert 2340)
   (engine-rpm                     float                             :offset-assert 2344)
   (engine-load                    float                             :offset-assert 2348)
   (sound-engine-rpm               float                             :offset-assert 2352)
   (sound-engine-load              float                             :offset-assert 2356)
   (sound-engine-envelope          float                             :offset-assert 2360)
   (wheel-rev                      float                             :offset-assert 2364)
   (wheel-inertia                  float                             :offset-assert 2368)
   (wheel-torque                   float                             :offset-assert 2372)
   (wheel-braking-torque           float                             :offset-assert 2376)
   (wheel-ground-torque            float                             :offset-assert 2380)
   (clutch-grab                    float                             :offset-assert 2384)
   (gear-ratio                     float                             :offset-assert 2388)
   (final-drive-ratio              float                             :offset-assert 2392)
   (total-gear-ratio               float                             :offset-assert 2396)
   (inv-total-gear-ratio           float                             :offset-assert 2400)
   (avg-drive-wheel-radius         float                             :offset-assert 2404)
   (drive-wheel-inertia            float                             :offset-assert 2408)
   (clutch-inertia                 float                             :offset-assert 2412)
   (idle-throttle                  float                             :offset-assert 2416)
   (wheelbase                      float                             :offset-assert 2420)
   (f-track-width                  float                             :offset-assert 2424)
   (r-track-width                  float                             :offset-assert 2428)
   (susp-spring-control            float                             :offset-assert 2432)
   (jump-control                   float                             :offset-assert 2436)
   (shortcut-speed-factor          float                             :offset-assert 2440)
   (path-deviation                 float                             :offset-assert 2444)
   ;; og:preserve-this dropped "turbo-supply" (captured :offset-assert 704):
   ;; 704 is inside vehicle's own range (near vehicle's speed-factor/behavior
   ;; run, landed in the vehicle commit), nowhere near the surrounding
   ;; 2400s here; a decompiler cross-contamination artifact, not a real
   ;; wvehicle field.
   (turbo-ready                    float                             :offset-assert 2448)
   (slide-factor                   float                             :offset-assert 2452)
   (slide-time                     uint32                            :offset-assert 2456)
   (max-speed                      float                             :offset-assert 2460)
   (shift-state                    uint8                             :offset-assert 2464)
   (gear-select                    int8                              :offset-assert 2465)
   (next-gear-select               int8                              :offset-assert 2466)
   (shift-time                     uint32                            :offset-assert 2468)
   ;; og:preserve-this 8 bytes unaccounted (2472-2480).
   (pad-pre-wheel                  uint8                              8 :offset-assert 2472)
   (wheel                          vehicle-wheel-state       4 :inline :offset-assert 2480)
   (gravity-dir                    vector                    :inline :offset-assert 3632)
   (surface-velocity               vector                    :inline :offset-assert 3648)
   (tire-roll-loop-state           wvehicle-sound-loop-state 6 :inline :offset-assert 3664)
   (tire-slide-loop-state          wvehicle-sound-loop-state 2 :inline :offset-assert 3760)
   ;; og:preserve-this dropped "engine-mix-state-array" (captured UNKNOWN 2
   ;; :offset-assert 3792): duplicate alias for the same span
   ;; min-load-engine-mix-state/max-load-engine-mix-state already cover.
   (min-load-engine-mix-state      wvehicle-engine-mix-state :inline :offset-assert 3792)
   (max-load-engine-mix-state      wvehicle-engine-mix-state :inline :offset-assert 3824)
   (damage-sound-id                sound-id                          :offset-assert 3856) ;; guessed by decompiler
   (water-sound-id                 sound-id                          :offset-assert 3860) ;; guessed by decompiler
   (wheel-fire-sound-id            uint32                            :offset-assert 3864)
   (oil-sound-id                   uint32                            :offset-assert 3868)
   (turbo-sound-id                 sound-id                          :offset-assert 3872) ;; guessed by decompiler
   (turbo-sound2-id                uint32                            :offset-assert 3876)
   (car-fire-loop                  uint32                            :offset-assert 3880)
   (hang-time-sound-id             uint32                            :offset-assert 3884)
   (overturned-time                uint32                            :offset-assert 3888)
   (engine-steady-time             uint32                            :offset-assert 3892)
   (splash-time                    uint32                            :offset-assert 3896)
   (knobby-time                    uint32                            :offset-assert 3900)
   (susp-creak-time                uint32                            :offset-assert 3904)
   (ground-time                    uint32                            :offset-assert 3908)
   (jump-time                      uint32                            :offset-assert 3912)
   (no-slide-time                  uint32                            :offset-assert 3916)
   (slide-distance                 float                             :offset-assert 3920)
   (power-slide-hud                handle                            :offset-assert 3928)
   (hang-time-hud                  handle                            :offset-assert 3936)
   (hang-time                      float                             :offset-assert 3944)
   (next-slide-sound-play-distance float                             :offset-assert 3948)
   (attached-array                 handle                    16      :offset-assert 3952) ;; guessed by decompiler
   (eng-pitch-offset               float                             :offset-assert 4080)
   (eng-pitch-variance             float                             :offset-assert 4084)
   (eng-pitch-variance-seek        float                             :offset-assert 4088)
   (eng-vol-variance               float                             :offset-assert 4092)
   (eng-vol-variance-seek          float                             :offset-assert 4096)
   (turbo-pitch                    float                             :offset-assert 4100)
   (health-pickup-multiplier       float                             :offset-assert 4104)
   ;; og:preserve-this jmod-steering-wheel captured as joint-mod-rotate-local
   ;; :inline (size 0x20/32B). Landed as an extent-true pad of the same
   ;; width instead of pulling in that type. Stale as of the vehicle-antenna
   ;; rung: both joint-mod-base and joint-mod-rotate-local already have a
   ;; real home, goal_src/jakx/engine/anim/joint-mod-h.gc:9/295/327/341/352
   ;; (deftype, init, attach-callback/remove-callback, the flags enum, and
   ;; joint-mod-rotate-local's own deftype+init), landed ahead of this rung.
   ;; Out of this rung's own minimum per the brief's §5 guidance; land the
   ;; real type here as a follow-up's call, not a landing-blocker.
   ;; og:preserve-this 4 bytes unaccounted (4108-4112).
   (pad-pre-jmod-steering-wheel    uint8                     4         :offset-assert 4108)
   (jmod-steering-wheel            uint8                     32        :offset-assert 4112)
   ;; og:preserve-this jmod-frame/jmod-axles (both captured UNKNOWN) landed
   ;; as extent-true pads: 4144-4272 (128B, 2 elements = 64B each) and
   ;; 4272-4464 (192B, 4 elements = 48B each). Neither width matches
   ;; joint-mod-rotate-local's own size (32B/0x20), so these are a
   ;; different joint-mod type this rung does not identify.
   (jmod-frame                     uint8                     128     :offset-assert 4144)
   (jmod-axles                     uint8                     192     :offset-assert 4272)
   (water-sound-envelope           float                             :offset-assert 4464)
   ;; og:preserve-this 16 bytes unaccounted (4468-4488).
   (pad-pre-wpn-current-target     uint8                     16      :offset-assert 4468)
   (wpn-current-target             uint64                            :offset-assert 4488)
   (wpn-current-target-acquired    uint64                            :offset-assert 4496)
   (wpn-left                       uint64                            :offset-assert 4504)
   ;; og:preserve-this wpn-right retyped uint64 -> handle: wvehicle-events.gc's
   ;; own decode reads it via ld (64-bit) and stores a literal #f into it (the
   ;; handle-clear idiom), the same evidence class as power-slide-hud/
   ;; hang-time-hud/fire-tracker above.
   (wpn-right                      handle                            :offset-assert 4512)
   (wpn-shield                     uint64                            :offset-assert 4520)
   (wpn-drone                      uint64                            :offset-assert 4528)
   (wpn-oil                        uint64                            :offset-assert 4536)
   (wpn-turbo                      uint64                            :offset-assert 4544)
   (wpn-bulldog-gun                uint64                            :offset-assert 4552)
   ;; og:preserve-this dropped "wpn-drawables" (captured UNKNOWN 2), a
   ;; duplicate alias for the same span wpn-drawable-left/right cover.
   ;;
   ;; og:preserve-this decompwall rung: retyped uint64 -> handle. Every
   ;; documented reader (rapid-fire-control-initialize-from-vehicle's own
   ;; note, wvehicle-weapons.gc's own build-time-deviation notes, the
   ;; anon-function 42/56 wvehicle-weapons precedents in type_casts.jsonc)
   ;; already treats these as handles and either hand-casts `(the-as handle
   ;; ...)` at the read or casts the deref result to `(pointer process)`
   ;; downstream, the same class light-trail-tracker's tracked-object field
   ;; fixed (collision-editor's own (proc) field, all-types.gc, is the
   ;; original precedent). No usage anywhere in this corpus treats either
   ;; field as a plain scalar. This lets the decompiler's own
   ;; push_asm_sllv_to_stack (decompiler/IR2/FormExpressionAnalysis.cpp)
   ;; bitfield fold apply directly instead of leaving raw `.asm.sllv.r0`.
   (wpn-drawable-left              handle                            :offset-assert 4560)
   (wpn-drawable-right             handle                            :offset-assert 4568)
   (wpn-spin-done-left             int32                             :offset-assert 4576)
   (wpn-spin-done-right            int32                             :offset-assert 4580)
   (prev-wpn-sync                  wvehicle-weapon-sync-blob :inline :offset-assert 4584)
   (turbo-suppressor-particle      sparticle-launch-control          :offset-assert 4588)
   (dark-seeking-me                basic                             :offset-assert 4592)
   (dark-suck-sound-pending        int8                              :offset-assert 4596)
   ;; og:preserve-this 3 bytes unaccounted (4597-4600).
   (pad-pre-vehicle-exhaust        uint8                     3       :offset-assert 4597)
   ;; og:preserve-this vehicle-exhaust-subsampler/wheel-launcher/
   ;; wheel-fire-launcher (all captured UNKNOWN) landed as extent-true pads
   ;; spanning their own gaps (4600-4608, 8B; 4608-4624, 16B; 4624-4640,
   ;; 16B); no raw load in this scoped decode resolves their element types.
   (vehicle-exhaust-subsampler     uint8                     8       :offset-assert 4600)
   (wheel-launcher                 uint8                     16      :offset-assert 4608)
   (wheel-fire-launcher            uint8                     16      :offset-assert 4624)
   (hack-armed-right               basic                             :offset-assert 4640)
   (hack-armed-left                basic                             :offset-assert 4644)
   (shake-amount                   float                             :offset-assert 4648)
   (whoosh-sound-id                uint32                            :offset-assert 4652)
   (sink-sound-id                  uint32                            :offset-assert 4656)
   )
  :method-count-assert 272
  :size-assert         #x1234
  :flag-assert         #x11011b01234
  (:state-methods
    hostile ;; 204, disagreement check named it: "the state is named hostile,
            ;; but the slot is named wvehicle-state-204" (this rung's own
            ;; scoped decode: wvehicle-states.gc, method-set! wvehicle 204)
    race-waiting ;; 205, same decode: (method-set! wvehicle 205 gp-6) names
                 ;; the state 'race-waiting
    )
  ;; og:preserve-this methods 206/207/209 are virtual states too, same class
  ;; as 208 below: wvehicle-states.gc's own decode names each one via its own
  ;; (method-set! wvehicle N ...) call and (new 'static 'state :name ...)
  ;; literal ('race-racing for 206, 'race-finished for 207, 'sink for 209).
  ;; The decompiler does not raise its own "Virtual defstate" complaint for
  ;; these three the way it did for 208 (their (_type_) none signature let
  ;; the raw decode through without a check failing), but the type system's
  ;; :methods entry was still wrong: each is a genuine per-vehicle-type
  ;; state, not a plain method. Moved to keep the type consistent with the
  ;; decode and so check_state_inherit.py's parent-state coverage sees them.
  (:state-methods
    race-racing ;; 206
    race-finished ;; 207
    )
  ;; og:preserve-this method 208 is a virtual state, not a plain method: the
  ;; decompiler's own virtual-defstate check names it ("Virtual defstate is
  ;; defining a virtual state 'explode-into-nothing' in method
  ;; wvehicle-method-208 of wvehicle, but the type of this method is
  ;; (function none), which is not a valid virtual state type"), same class
  ;; as rigid-body-object-method-70 fixed in the wvehicle-sounds commit;
  ;; surfaced only once that fix let analysis of wvehicle-states reach this
  ;; far. Moved into :state-methods with its real name.
  (:state-methods
    explode-into-nothing ;; 208
    )
  (:state-methods
    sink ;; 209, same class as 206/207 above: (method-set! wvehicle 209 gp-5)
         ;; names the state 'sink in wvehicle-states.gc's own decode
    )
  (:methods
    (wvehicle-method-210 (_type_ object object) none) ;; 210
    (wvehicle-method-211 (_type_ object) none) ;; 211
    (wvehicle-method-212 (_type_) none) ;; 212
    (wvehicle-method-213 (_type_ object) none) ;; 213
    ;; og:preserve-this wvehicle-core rung: retyped arg0 from the guessed
    ;; "object" to "float", proven by all six of its own uses in the
    ;; method's body, each a direct mtc1 bit-reinterpret with no field
    ;; access ("(gpr->fpr a1-0)"), never a pointer dereference.
    (wvehicle-method-214 (_type_ float) none) ;; 214
    (wvehicle-method-215 (_type_) none) ;; 215
    (wvehicle-method-216 (_type_ object) none) ;; 216
    ;; og:preserve-this wvehicle-core rung: retyped both args from the
    ;; guessed "object object" to "vehicle-wheel-state vehicle-wheel-info",
    ;; proven by (method 219 wvehicle)'s own field reads (arg0/a1 at 16,
    ;; 48, 184, 204, matching vehicle-wheel-state's probe-local-pos/
    ;; local-axis/pos2/x-scale; arg1/a2 at 32, 36, 40, 44, 48, 56, matching
    ;; vehicle-wheel-info's radius/susp-arm-length/steer-arm-length/scale/
    ;; travel/probe-y-offset); (method 217 wvehicle) and (method 218
    ;; wvehicle) share the identical field shape at their own call sites
    ;; but stay held (see hacks.jsonc), so this is a declared-signature fix
    ;; for all three, a landed body only for 219.
    (wvehicle-method-217 (_type_ vehicle-wheel-state vehicle-wheel-info) none) ;; 217
    (wvehicle-method-218 (_type_ vehicle-wheel-state vehicle-wheel-info) none) ;; 218
    (wvehicle-method-219 (_type_ vehicle-wheel-state vehicle-wheel-info) none) ;; 219
    (wvehicle-method-220 (_type_) none) ;; 220
    ;; og:preserve-this issue 571 R10d: arg0 promoted object -> int. Multiplied
    ;; against a fixed 288 (`(*.si v1 a1)`, an array-stride index) at the
    ;; point type prop first fails on this slot's own decode (wvehicle-util
    ;; object); retyping advances the wall rather than clearing it (further
    ;; failures noted below at 232).
    (wvehicle-method-221 (_type_ int) none) ;; 221
    (wvehicle-method-222 (_type_) none) ;; 222
    (wvehicle-method-223 (_type_) none) ;; 223
    ;; og:preserve-this wvehicle-core rung: retyped from the guessed "(object
    ;; object) none" to "(float float) float", proven by all three of its
    ;; call sites (estimate-eng-torque-from-gear, plot-engine-torque-curve
    ;; and (method 215 wvehicle)), which all mtc1/mfc1-reinterpret both args
    ;; as floats and consume the vtable call's own return value as a float
    ;; in immediate float math. The method's own body is held (see hacks.
    ;; jsonc, same offset-720 class as (method 62 wvehicle)); this is a
    ;; declared-signature fix only.
    (wvehicle-method-224 (_type_ float float) float) ;; 224
    (wvehicle-method-225 (_type_) none) ;; 225
    (wvehicle-method-226 (_type_) none) ;; 226
    (wvehicle-method-227 (_type_) none) ;; 227
    ;; og:preserve-this issue 571 R10d: arg0 promoted object -> vector, arg1
    ;; object -> int, the identical shape as vehicle-method-149/150. arg0 is
    ;; passed straight into vector-matrix*! as its output vector (via `info
    ;; rider attach-point-array`'s own trans field); arg1 is shifted (sll 6,
    ;; *64 stride) to index that same attach-point-array (this rung's scoped
    ;; decode, wvehicle-util object).
    (wvehicle-method-228 (_type_ vector int) none) ;; 228
    (wvehicle-method-229 (_type_ object object) none) ;; 229
    (wvehicle-method-230 (_type_ object) none) ;; 230
    ;; og:preserve-this issue 571 R10d: arg0 promoted object -> int. Read as
    ;; `(l.d (+ (* arg0 8) this 3948))`, an 8-byte-stride index into a handle
    ;; array at `this`+3948, then handle->process resolved and type-checked
    ;; against process-focusable; this slot's own decode (wvehicle-util
    ;; object) already fully resolves once arg0 is int (this rung's scoped
    ;; decode).
    (wvehicle-method-231 (_type_ int) none) ;; 231
    ;; og:preserve-this issue 571 R10d: arg0 promoted object -> int, arg1
    ;; object -> process-focusable. arg0 is shifted (sll 3, *8 stride) to
    ;; index the same handle array wvehicle-method-231 reads at `this`+3948;
    ;; arg1 is null-checked then read at +28 (a type-table style deref) to
    ;; build the handle stored at that slot, the same shape as
    ;; wvehicle-method-233 immediately below. Retyping advances the wall
    ;; rather than clearing it (further failures noted below).
    (wvehicle-method-232 (_type_ int process-focusable) none) ;; 232
    ;; og:preserve-this issue 571 R10d: arg0 promoted object -> process-
    ;; focusable. Null-checked then read at +28 (a type-table style deref)
    ;; feeding the same handle-construction idiom as 232 immediately above,
    ;; but against `this`+3948 directly (no separate int index arg); this
    ;; slot's own decode (wvehicle-util object) resolves cleanly once arg0 is
    ;; process-focusable (this rung's scoped decode).
    (wvehicle-method-233 (_type_ process-focusable) none) ;; 233
    (wvehicle-method-234 (_type_) none) ;; 234
    (wvehicle-method-235 (_type_ object object object) none) ;; 235
    (wvehicle-method-236 (_type_) none) ;; 236
    (wvehicle-method-237 (_type_) none) ;; 237
    (wvehicle-method-238 (_type_) none) ;; 238
    (wvehicle-method-239 (_type_) none) ;; 239
    (wvehicle-method-240 (_type_) none) ;; 240
    (wvehicle-method-241 () none) ;; 241
    (wvehicle-method-242 (_type_ object object) none) ;; 242
    (wvehicle-method-243 () none) ;; 243
    (wvehicle-method-244 (_type_ object object float) none) ;; 244
    (wvehicle-method-245 (_type_ object object float) none) ;; 245
    (wvehicle-method-246 (_type_ object object) none) ;; 246
    (wvehicle-method-247 (_type_ object object object) none) ;; 247
    (wvehicle-method-248 (_type_ object object) none) ;; 248
    (wvehicle-method-249 (_type_ object object object) none) ;; 249
    (wvehicle-method-250 (_type_ object object) none) ;; 250
    (wvehicle-method-251 (_type_ object object) none) ;; 251
    (wvehicle-method-252 () none) ;; 252
    (wvehicle-method-253 (_type_ object object) none) ;; 253
    (wvehicle-method-254 (_type_ object object) none) ;; 254
    (wvehicle-method-255 (_type_ object object) none) ;; 255
    (wvehicle-method-256 (_type_ object object) none) ;; 256
    (wvehicle-method-257 (_type_ object object) none) ;; 257
    (wvehicle-method-258 (_type_ object object) none) ;; 258
    (wvehicle-method-259 (_type_ object object) none) ;; 259
    (wvehicle-method-260 (_type_) none) ;; 260
    (wvehicle-method-261 (_type_) none) ;; 261
    ;; og:preserve-this rigid-body-small-tier rung: arg0 retyped from object
    ;; to int. This method's own body multiplies it by 96 (the racer-array
    ;; element stride, per race-control-method-9's own comment, whose only
    ;; call site is this method) and adds 112 to compute the racer-state
    ;; pointer passed to race-control-method-9's arg3; "object" does not
    ;; support integer multiplication.
    (wvehicle-method-262 (_type_ int) none) ;; 262
    (wvehicle-method-263 () none) ;; 263
    (wvehicle-method-264 () none) ;; 264
    (wvehicle-method-265 (_type_ object object) none) ;; 265
    (wvehicle-method-266 (_type_ object object object) none) ;; 266
    (wvehicle-method-267 (_type_) none) ;; 267
    (wvehicle-method-268 (_type_ object object) none) ;; 268
    (wvehicle-method-269 (_type_ object) none) ;; 269
    ;; og:preserve-this issue 571 R10a: bare () -> (_type_ float object).
    ;; arg0 is moved gpr->fpr at entry (`(set! f1-0 (gpr->fpr a1-0))`, the
    ;; same mtc1 raw-bit-pattern idiom already landed on 214 above) and
    ;; multiplied against a random-vu-scaled constant; arg1 is read via
    ;; >=0.si before being reassigned, the same sign-check idiom this rung
    ;; also used on vehicle-method-201 (this rung's scoped decode,
    ;; wvehicle-util object).
    (wvehicle-method-270 (_type_ float object) none) ;; 270
    (wvehicle-method-271 (_type_) none) ;; 271
    )
  )

;; og:preserve-this vehicle-antenna rung: landed here, not vehicle-antenna.gc
;; itself, so (method 64 wvehicle)'s own antenna-spawn call (wvehicle-
;; util.gc, compiling far earlier in the game's own build order than
;; vehicle-antenna.o) can build the params struct and forward-declare
;; vehicle-antenna-spawn's signature against a real type rather than a
;; second forward declaration. Field types field-verified against this
;; rung's own scoped decode of both objects, all four :offset-asserts
;; matching the already-resurrected all-types.gc dead block byte-exact.
(deftype vehicle-antenna-init-params (structure)
  ((pos     vector :inline :offset-assert 0)
   (tilt    float          :offset-assert 16)
   (vehicle process         :offset-assert 20)
   (skel    basic          :offset-assert 24)
   (level   level          :offset-assert 28)
   )
  :method-count-assert 9
  :size-assert         #x20
  :flag-assert         #x900000020
  )

