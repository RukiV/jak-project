;; DECOMP BEGINS

;; og:preserve-this forward declaration for a function this file's states
;; dispatch through :event but does not itself define. vehicle-event-handler
;; is defined by vehicle.gc (this band's own object); build-first needs the
;; declaration here since engine/vehicle compiles ahead of vehicle.gc's own
;; body pass in this tree's link order. Signature copied from
;; decompiler/config/jakx/all-types.gc. Drop this line when vehicle.gc itself
;; lands.
(define-extern vehicle-event-handler (function process int symbol event-message-block object :behavior vehicle))

;; definition for function vehicle-idle-post
;; INFO: Used lq/sq
;; WARN: Return type mismatch none vs object.
(defbehavior vehicle-idle-post vehicle ()
  (rigid-body-control-method-28 (-> self rbody))
  (rigid-body-control-method-11 (-> self rbody) (the-as collide-shape-moving (-> self root)))
  (matrix-copy! (-> self node-list data 0 bone transform) (-> self rbody matrix))
  (set! (-> self node-list data 0 bone transform trans quad) (-> self root trans quad))
  (vehicle-method-112 self)
  (rigid-body-object-method-61 self)
  (update-transforms (-> self root))
  )

;; failed to figure out what this is:
(defstate idle (vehicle)
  :virtual #t
  :event vehicle-event-handler
  :enter (behavior ()
    (set-time! (-> self state-time))
    (set! (-> self water-height) -40960000.0)
    (logior! (-> self flags) #x400000)
    )
  :code sleep-code
  :post vehicle-idle-post
  )

;; failed to figure out what this is:
(defstate inactive (vehicle)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('nav-mesh-kill 'traffic-activate 'traffic-off-force 'traffic-off 'rider-on 'rider-off)
       (rigid-body-object-method-81 self proc argc message block)
       )
      )
    )
  :enter (behavior ()
    (logior! (-> self focus-status) (focus-status disable inactive))
    (rigid-body-object-method-73 self)
    (rigid-body-object-method-75 self)
    (vehicle-method-126 self)
    (logior! (-> self draw status) (draw-control-status no-draw))
    )
  :exit (behavior ()
    (rigid-body-object-method-74 self)
    (logclear! (-> self focus-status) (focus-status disable inactive))
    (logclear! (-> self draw status) (draw-control-status no-draw))
    )
  :code sleep-code
  )

