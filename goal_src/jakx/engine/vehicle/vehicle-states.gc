;; definition for function player-wait-control-hook
;; WARN: Return type mismatch int vs none.
(defun player-wait-control-hook ((arg0 vehicle))
  (let ((gp-0 (new 'stack-no-clear 'vehicle-controls)))
    (mem-set32! (&-> gp-0 steering) 6 0)
    (vehicle-method-129 arg0 (the-as vehicle-controls (&-> gp-0 steering)))
    (set! (-> gp-0 handbrake) 1.0)
    (logand! (-> gp-0 flags) -16)
    (vehicle-method-133 arg0 (&-> gp-0 steering))
    )
  0
  (none)
  )

;; failed to figure out what this is:
(defstate player-control (vehicle)
  :virtual #t
  :event vehicle-event-handler
  ;; og:preserve-this the retail :enter handler decoded as a raw label
  ;; (L28), an anon-function the decompiler never recognized as a proper
  ;; function; raw label references are not valid GOAL, so the key is
  ;; omitted entirely rather than left broken or given an invented stub
  ;; body, matching the credits-obs precedent for the same defect class.
  ;; The raw handler also carries the eight-byte read at self+460
  ;; (spanning two fields, no cast expresses it) and the sllv
  ;; reinterpretation pseudo-op the wvehicle-small-tier rung held; both
  ;; are inside this same unresolved body.
  :exit (behavior ()
    (set! (-> self max-time-step) 0.05)
    (setting-control-method-16 *setting-control* self 'blur-enabled?)
    (vehicle-method-126 self)
    (rigid-body-object-method-76 self)
    (logand! (-> self flags) -590337)
    (set! (-> self controls flags) (the-as uint 0))
    (set! (-> self controls prev-flags) (the-as uint 0))
    0
    )
  :code sleep-code
  :post (behavior ()
    (vehicle-method-157 self)
    )
  )

