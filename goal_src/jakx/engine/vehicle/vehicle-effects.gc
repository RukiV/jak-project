(defmethod rigid-body-object-method-70 ((this vehicle))
  (break!)
  0
  (none)
  )

;; definition for function calc-fade-vals
;; WARN: Return type mismatch object vs none.
(defun calc-fade-vals ((arg0 float))
  (let* ((f1-1 (/ arg0 METER_LENGTH))
         (f0-3 (- f1-1 (the float (the int f1-1))))
         (f1-3 (* 4096.0 (- f1-1 f0-3)))
         (f1-5 (/ -1.0 (* (- 1.0 f0-3) f1-3)))
         (f0-4 (/ f0-3 (- 1.0 f0-3)))
         )
    (format #t ":fade-a ~,,10f~%:fade-b ~,,20f~%" f1-5 f0-4)
    )
  (none)
  )

;; definition for symbol *vehicle-headlight-glow-template*, type object
(define *vehicle-headlight-glow-template*
  (the-as object (new 'static 'sprite-glow-data
                   :position (new 'static 'vector :data (new 'static 'array float 4 0.0 0.0 0.0 8192.0))
                   :size-probe 163.84
                   :z-offset 819.2
                   :size-y 8192.0
                   :color (new 'static 'rgbaf :data (new 'static 'array float 4 255.0 192.0 128.0 16.0))
                   :fade-a -0.0000122044
                   :fade-b 8.997864
                   :tex-id (new 'static 'texture-id :index #x15 :page #x4)
                   )
                 )
  )

