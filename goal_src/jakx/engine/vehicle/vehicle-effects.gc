;; definition for method 9 of type vehicle-particle-common-info
;; WARN: Return type mismatch int vs none.
(defmethod vehicle-particle-common-info-method-9 ((this vehicle-particle-common-info))
  (set! (-> this sp-system2d) *sp-particle-system-2d*)
  (set! (-> this sp-system3d) *sp-particle-system-3d*)
  (set! (-> this part-quat) (-> *particle-birth-work* quat))
  (set! (-> this part-vel) (-> *particle-birth-work* vel-range))
  (set! (-> this part-thruster) (-> *part-id-table* 262))
  (set! (-> this part-thruster-x) (-> *part-id-table* 262 init-specs 0))
  (set! (-> this part-spec2) (-> *part-id-table* 262 init-specs 2))
  (set! (-> this part-spec3) (-> *part-id-table* 262 init-specs 3))
  (set! (-> this part-spec4) (-> *part-id-table* 262 init-specs 4))
  (set! (-> this part-spec5) (-> *part-id-table* 262 init-specs 5))
  (set! (-> this part-spec6) (-> *part-id-table* 262 init-specs 6))
  (set! (-> this headlight-glow-template) (the-as sprite-glow-data *vehicle-headlight-glow-template*))
  (set! (-> this taillight-glow-template) (the-as sprite-glow-data *vehicle-taillight-glow-template*))
  (set! (-> this thruster-glow-template) (the-as sprite-glow-data *vehicle-thruster-glow-template*))
  (set! (-> this part-247-spec-2) (-> *part-id-table* 247 init-specs 2))
  (set! (-> this part-247-spec-13) (-> *part-id-table* 247 init-specs 13))
  (set! (-> this part-247-spec-3) (-> *part-id-table* 247 init-specs 3))
  (set! (-> this part-248-spec-2) (-> *part-id-table* 248 init-specs 2))
  (set! (-> this part-248-spec-11) (-> *part-id-table* 248 init-specs 11))
  (set! (-> this part-248-spec-3) (-> *part-id-table* 248 init-specs 3))
  (if (zero? (-> this thrust-tex-id))
      (set! (-> this thrust-tex-id) (the-as uint (lookup-texture-id-by-name "blue-thrust" (the-as string #f))))
      )
  (if (zero? (-> this dark-thrust-tex-id))
      (set! (-> this dark-thrust-tex-id)
            (the-as uint (lookup-texture-id-by-name "gun-enemy-muzzleflash" (the-as string #f)))
            )
      )
  (set! (-> this part-248) (-> *part-id-table* 248))
  (set! (-> this part-247) (-> *part-id-table* 247))
  (set! (-> this part-249) (-> *part-id-table* 249))
  (set! (-> this part-293) (-> *part-id-table* 293))
  (set! (-> this part-294) (-> *part-id-table* 294))
  (set! (-> this part-295) (-> *part-id-table* 295))
  (set! (-> this part-296) (-> *part-id-table* 296))
  (set! (-> this part-297) (-> *part-id-table* 297))
  (set! (-> this part-298) (-> *part-id-table* 298))
  0
  (none)
  )

;; definition for symbol *vehicle-particle-common-info*, type vehicle-particle-common-info
(define *vehicle-particle-common-info* (new 'static 'vehicle-particle-common-info))

