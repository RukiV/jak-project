;; DECOMP BEGINS

;; og:preserve-this forward declaration for vehicle-manager-init-by-other,
;; this file's own function held below: rigid-body-queue.gc now lands
;; rigid-body-queue's own deftype and most methods plus rigid-body-queue-
;; manager-spawn, but rigid-body-queue-manager's own init-by-other/idle-
;; state/post cluster stays held there (method 10, its idle:post reaches on
;; the first frame, diverges from jak3's twin in ways that rung could not
;; verify). process-spawn's own run-now-in-process expansion embeds this
;; symbol by name at compile time, so vehicle-manager-start needs the
;; declaration even though nothing calls it directly. Drop this line and
;; land the real body once rigid-body-queue.gc's held cluster is verified.
(define-extern vehicle-manager-init-by-other (function object :behavior vehicle-manager))

;; definition of type vehicle-manager
(deftype vehicle-manager (process)
  ()
  (:state-methods
    idle
    active
    )
  (:methods
    (vehicle-manager-method-16 (_type_) none)
    (vehicle-manager-method-17 (_type_) none)
    )
  )

;; definition for method 3 of type vehicle-manager
