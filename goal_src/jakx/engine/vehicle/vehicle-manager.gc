  (format #t "~1Tnext-state: ~A~%" (-> this next-state))
  (format #t "~1Tstate-stack: ~A~%" (-> this state-stack))
  (format #t "~1Ttrans-hook: ~A~%" (-> this trans-hook))
  (format #t "~1Tpost-hook: ~A~%" (-> this post-hook))
  (format #t "~1Tevent-hook: ~A~%" (-> this event-hook))
  (format #t "~1Tallocated-length: ~D~%" (-> this allocated-length))
  (format #t "~1Theap-base: #x~X~%" (-> this heap-base))
  (format #t "~1Theap-top: #x~X~%" (-> this heap-top))
  (format #t "~1Theap-cur: #x~X~%" (-> this heap-cur))
  (format #t "~1Tstack-frame-top: ~A~%" (-> this stack-frame-top))
  (format #t "~1Theap: #<kheap @ #x~X>~%" (&-> this heap-base))
  (format #t "~1Tconnection-list: ~`connectable`P~%" (-> this connection-list))
  (format #t "~1Tstack[0] @ #x~X~%" (-> this stack))
  (label cfg-62)
  this
  )

;; definition for method 7 of type vehicle-manager
;; WARN: Return type mismatch process vs vehicle-manager.
(defmethod relocate ((this vehicle-manager) (offset int))
  (set! *vehicle-manager* this)
  (if *vehicle-manager*
      (set! *vehicle-manager* (&+ *vehicle-manager* offset))
      )
  (the-as vehicle-manager ((method-of-type process relocate) this offset))
  )

;; definition for method 10 of type vehicle-manager
(defmethod deactivate ((this vehicle-manager))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (set! *vehicle-manager* #f)
  (setting-control-method-16 *setting-control* this 'task-mask)
  (setting-control-method-23 *setting-control*)
  ((method-of-type process deactivate) this)
  (none)
  )

;; definition for method 18 of type vehicle-manager
;; WARN: Return type mismatch int vs none.
(defmethod vehicle-manager-method-17 ((this vehicle-manager))
  0
  (none)
  )

;; definition for method 17 of type vehicle-manager
;; WARN: Return type mismatch int vs none.
(defmethod vehicle-manager-method-16 ((this vehicle-manager))
  (rb-reset-perf-times)
  0
  (none)
  )

;; definition for function vehicle-manager-event-handler
(defbehavior vehicle-manager-event-handler vehicle-manager ((arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (case arg2
    (('no-extra-bank)
     (setting-control-method-16 *setting-control* self 'extra-bank)
     )
    (('extra-bank)
     (let ((a3-1 (-> arg3 param 0)))
       (setting-control-method-15 *setting-control* self 'extra-bank a3-1 0 0)
       )
     )
    (('vehicle-count?)
     (let ((gp-0 (the-as object 0)))
       (let ((s5-0 (-> self child)))
         (while s5-0
           (if (type? (ppointer->process s5-0) vehicle)
               (set! gp-0 (+ (the-as int gp-0) 1))
               )
           (set! s5-0 (-> s5-0 0 brother))
           )
         )
       gp-0
       )
     )
    )
  )

;; og:preserve-this vehicle-manager-init-by-other is omitted rather than
;; landed. Its own body is otherwise clean (stack-size-set!, the
;; vehicle-manager-method-17/setting-control-method-13 setup, the
;; event-hook assignment, go-virtual idle all decode without error), but it
;; calls rigid-body-queue-manager-spawn, which process-spawns rigid-body-
;; queue-manager. rigid-body-queue.gc (rigid-body-queue rung) now lands
;; rigid-body-queue's own deftype and most methods plus rigid-body-queue-
;; manager-spawn itself, but rigid-body-queue-manager's own init-by-other/
;; idle-state/post cluster stays held there: that cluster's idle:post
;; reaches rigid-body-queue's method 10 (the physics tick) on the first
;; frame, and that method's own raw decode diverges from jak3's twin in
;; ways that rung could not verify (see rigid-body-queue.gc's own notes).
;; Landing vehicle-manager-init-by-other here would activate that unverified
;; chain via rigid-body-queue-manager-spawn's process-spawn. process-spawn
;; resolves init-by-other by naming convention at the kernel level, not a
;; compile-time symbol reference, so nothing else in this file needs this
;; defined. Re-derive from the framework's own dump (offline-test -f
;; vehicle-manager -d) once rigid-body-queue.gc's held cluster is verified.

;; failed to figure out what this is:
(defstate idle (vehicle-manager)
  :virtual #t
  :event vehicle-manager-event-handler
  :code (behavior ()
    (suspend)
    (suspend)
    (go-virtual active)
    )
  )

;; failed to figure out what this is:
(defstate active (vehicle-manager)
  :virtual #t
  :event vehicle-manager-event-handler
  :code sleep-code
  :post (behavior ()
    (vehicle-manager-method-16 self)
    )
  )

;; definition for function vehicle-manager-start
;; WARN: Return type mismatch int vs none.
;; og:preserve-this vehicle-manager-start is omitted rather than landed,
;; for the same reason vehicle-manager-init-by-other below is omitted:
;; jakx-init calls vehicle-manager-start behind a runtime (nonzero?)
;; guard, and its process-spawn resolves vehicle-manager-init-by-other by
;; name at the kernel level, so with the init function omitted the very
;; first boot after landing this function died at jakx-init with
;; "attempting to run nullptr function!" (vehicle-manager+0xff7 on the
;; stack). Leaving the symbol undefined keeps the guard skipping as it
;; did while this file was a stub. Retires together with the init-by-other
;; note once rigid-body-queue.gc's held init-by-other/idle/post cluster is
;; verified; the body is:
;; (defun vehicle-manager-start ((arg0 process))
;;   (vehicle-particle-common-info-method-9 *vehicle-particle-common-info*)
;;   (if *vehicle-manager*
;;       (change-parent *vehicle-manager* arg0)
;;       (process-spawn vehicle-manager :name "vehicle-manager" :to arg0)
;;       )
;;   0
;;   (none)
;;   )

;; definition for function vehicle-manager-kill
;; WARN: Return type mismatch symbol vs none.
(defun vehicle-manager-kill ()
  (kill-by-type vehicle-manager *active-pool*)
  (none)
  )

;; definition for symbol *car-appearance-hack*, type int
(define *car-appearance-hack* 0)

;; definition (debug) for function find-vehicle
;; WARN: Return type mismatch process-tree vs object.
(defun-debug find-vehicle ((arg0 int))
  (let ((v0-0 (the-as process-tree #f)))
    (let ((v1-1 (-> *vehicle-manager* child)))
      (when v1-1
        (set! v0-0 (-> v1-1 0))
        (dotimes (v1-2 arg0)
          (let ((a1-1 (-> v0-0 brother)))
            (if a1-1
                (set! v0-0 (-> a1-1 0))
                )
            )
          )
        )
      )
    v0-0
    )
  )

