   (angle    int16          :offset 12)
   (flags    uint8          :offset 14) ;; vehicle-seat-flag
   (mask     uint16         :offset 14)
   )
  :method-count-assert 9
  :size-assert         #x10
  :flag-assert         #x900000010
  )

