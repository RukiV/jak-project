;;-*-Lisp-*-
(in-package goal)

;; name: vehicle-h.gc
;; name in dgo: vehicle-h
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

;; og:preserve-this dropped dataf/dataw (both UNKNOWN 5 :offset-assert 0),
;; duplicate names for the same 20 bytes steering/throttle/brake/lean-z/
;; handbrake already cover; same class as rigid-body-object-constants' fix.
;; og:preserve-this jak3's copy of this type carries :pack-me
;; (decompiler/config/jak3/all-types.gc); jakx's lacked it. Without it the
;; compiler inserts its own inter-field padding when this type is embedded
;; :inline elsewhere, which is why vehicle's own controls-through-
;; speed-factor run below could not assert the captured offsets directly.
;; Adding it here, proven by a zero-positive-delta full-corpus decode gate.
(deftype vehicle-controls (structure)
  ((steering   float     :offset-assert 0)
   (throttle   float     :offset-assert 4)
   (brake      float     :offset-assert 8)
   (lean-z     float     :offset-assert 12)
   (handbrake  float     :offset-assert 16)
   (flags      uint8     :offset-assert 20) ;; vehicle-controls-flag
   (prev-flags uint8     :offset-assert 21) ;; vehicle-controls-flag
   (pad0       uint8   2 :offset-assert 22) ;; guessed by decompiler
   )
  :pack-me
  :method-count-assert 9
  :size-assert         #x18
  :flag-assert         #x900000018
  )

;; og:preserve-this the whole rigid-body-vehicle-constants dependency chain
;; (vehicle-section-info through rigid-body-vehicle-constants itself) moved
;; up here, ahead of the `vehicle` deftype that used to sit right after
;; vehicle-controls, for build-first self-containment: `vehicle` narrows its
;; inherited `info` field to rigid-body-vehicle-constants via :override (see
;; the comment on that deftype below), and the compiler's override check
;; needs a REAL, already-known child-of-rigid-body-object-constants relation
;; at that point, not just a name. A `declare-type` forward stub was tried
;; first and rejected with "Wanted to override field info, but type
;; rigid-body-vehicle-constants isn't child of rigid-body-object-constants":
;; declare-type carries no parent information. Moving the full chain (which
;; already had its own internal build-first ordering, and does not reference
;; `vehicle` or `vehicle-controls` anywhere in it) is the only fix
;; TypeConsistencyWithBuildFirst accepts. offline-test -f and the plain
;; type-consistency test both preload all-types and would not catch either
;; gap.
;; vehicle-section-info and vehicle-section landed for build-first self-containment:
;; every wcar body calls (method-of-type vehicle-section vehicle-section-method-9) in
;; its method 66, which needs the full type, its method table included, defined earlier
;; in build order. Both types belong to this object (vehicle-h) per the game's own type
;; registration, and vehicle-h.o runs well ahead of the wcar objects. offline-test -f
;; and the plain type-consistency test both preload all-types and would not catch the
;; gap; only TypeConsistencyWithBuildFirst does. Transcribed verbatim from
;; decompiler/config/jakx/all-types.gc to satisfy the two-file consistency rule.

(deftype vehicle-section-info (structure)
  ((rbody          rigid-body-object-constants         :offset-assert 0)
   (hinge-axis     vector                      :inline :offset-assert 16)
   (color          rgbaf                       :inline :offset-assert 32)
   (joint-local    matrix                      :inline :offset-assert 48)
   (min-angle      float                               :offset-assert 112)
   (max-angle      float                               :offset-assert 116)
   (inv-hit-points float                               :offset-assert 120)
   (hit-points     float                               :offset-assert 124)
   (rattle-sound   uint16                              :offset-assert 128)
   (impact-sound   uint16                              :offset-assert 130)
   )
  :method-count-assert 9
  :size-assert         #x84
  :flag-assert         #x900000084
  )

;; og:preserve-this vehicle-util rung: draw retyped basic -> draw-control.
;; vehicle-util.gc's own method 9 assigns this field the direct return of
;; skeleton-group->draw-control (a draw-control); method 19's own decode
;; reads offset 4 of this field's basic-tagged pointer under the +4 load
;; convention (declared offset 8, draw-control's own status field) to
;; logior!/logand! a status bit, which fails to resolve under plain basic.
(deftype vehicle-section (structure)
  ((vel               vector               :inline :offset-assert 0)
   (info              vehicle-section-info         :offset-assert 16)
   (node-list         basic                        :offset-assert 20)
   (draw              draw-control                 :offset-assert 24)
   (car-info          car-info-full                :offset-assert 28)
   (debris            uint64                       :offset-assert 32)
   (damage            float                        :offset-assert 40)
   (angle             float                        :offset-assert 44)
   (d-angle           float                        :offset-assert 48)
   (node-index        int8                         :offset-assert 52)
   (parent-node-index int8                         :offset-assert 53)
   (flags             uint8                        :offset-assert 54)
   (car-part          int8                         :offset-assert 55)
   )
  :method-count-assert 20
  :size-assert         #x38
  :flag-assert         #x1400000038
  (:methods
    ;; og:preserve-this vehicle rung: method 9 args proven by wcar-cheetah's
    ;; own call site (wcar-cheetah_disasm.gc:95-100), passing this
    ;; (v-cheetah, a vehicle), an art-group-get-by-name result, and the
    ;; literal 19.
    (vehicle-section-method-9 (_type_ vehicle art-group int) none) ;; 9
    ;; og:preserve-this vehicle rung: method 10's own a1 arg reads offsets
    ;; 188/192 (process-drawable's inherited node-list/draw, corrected by
    ;; issue 571 R11 from the original "root/node-list, no shift" claim --
    ;; the +4 convention applies here exactly like everywhere else in this
    ;; file, not exempt for process-drawable's own inherited fields) and
    ;; 284 raw / 288 landed (car-info, the vehicle-own +4-corrected region) -
    ;; only vehicle carries all three at once (vehicle-util_disasm.gc:93-139).
    (vehicle-section-method-10 (_type_ vehicle) none) ;; 10
    ;; og:preserve-this vehicle rung: method 11 promoted from zero explicit
    ;; args; the spawning vehicle is passed at its call site once R2's
    ;; vehicle-spawn externs unblock that function's decode.
    (vehicle-section-method-11 (_type_ vehicle) none) ;; 11
    ;; og:preserve-this vehicle rung: method 12's own a1 arg reads offset 228
    ;; raw (vehicle-util_disasm.gc:322-327+), an ancestor-region
    ;; process-drawable field; corrected by issue 571 R11: the +4
    ;; convention applies here too (no exemption below the rigid-body-
    ;; object boundary, reversing the original claim), so the load at raw
    ;; 228 binds to the field placed at 232, process-drawable's own
    ;; `rbody`, as originally suspected rather than `sound`. Either way
    ;; only vehicle (a process-drawable descendant) carries it, so the arg
    ;; is typed vehicle.
    (vehicle-section-method-12 (_type_ vehicle) none) ;; 12
    ;; og:preserve-this vehicle rung: method 13's arg0 is converted gpr->fpr
    ;; directly (vehicle-util_disasm.gc:238, the mtc1 idiom) before being
    ;; multiplied against a float field, so it is a raw float bit-pattern
    ;; passed in a gpr.
    (vehicle-section-method-13 (_type_ float) none) ;; 13
    (vehicle-section-method-14 (_type_) none) ;; 14
    (vehicle-section-method-15 (_type_) none) ;; 15
    ;; og:preserve-this vehicle-util rung: promoted object -> draw-control-
    ;; status (both args). This slot's own decode reads this.draw.status,
    ;; ORs in arg0 and ANDs OUT arg1 (a set-some/clear-some status update),
    ;; both operands used as the same enum as the field itself.
    (vehicle-section-method-16 (_type_ draw-control-status draw-control-status) none) ;; 16
    (vehicle-section-method-17 () none) ;; 17
    (vehicle-section-method-18 (_type_) none) ;; 18
    (vehicle-section-method-19 (_type_) none) ;; 19
    )
  )

;; The rigid-body-vehicle-constants chain landed here for build-first
;; self-containment: every wcar body passes *v-<car>-constants* to
;; rigid-body-object-method-64, and those symbols are typed
;; rigid-body-vehicle-constants, so the whole chain has to be defined earlier in
;; build order. offline-test -f and the plain type-consistency test both preload
;; all-types and would not catch the gap; only TypeConsistencyWithBuildFirst
;; does. Every type here belongs to this object (vehicle-h) per the game's own
;; type registration, and every one is transcribed verbatim from
;; decompiler/config/jakx/all-types.gc to satisfy the two-file consistency rule.
;; They are ordered so each type's parent and every :inline field type is already
;; defined above it. vehicle-wheel-info leads because vehicle-physics-model-info
;; holds two of them :inline; it moved here out of wvehicle-h.gc, which is one
;; object too late and is not where the game registers it either.

;; forward declaration: vehicle-wheel-info's callback is typed against
;; vehicle-wheel-state, which the game registers in wvehicle-h.
(declare-type vehicle-wheel-state structure)

(deftype vehicle-wheel-info (structure)
  ((local-pos          vector                                                                   :inline :offset-assert 0)
   (flags              uint64                                                                           :offset-assert 16) ;; vehicle-wheel-flag
   (callback           (function rigid-body-object vehicle-wheel-state vehicle-wheel-info none)         :offset-assert 24) ;; guessed by decompiler
   (inertia            float                                                                            :offset-assert 28)
   (radius             float                                                                            :offset-assert 32)
   (susp-arm-length    float                                                                            :offset-assert 36)
   (steer-arm-length   float                                                                            :offset-assert 40)
   (scale              float                                                                            :offset-assert 44)
   (travel             float                                                                            :offset-assert 48)
   (probe-x-offset     float                                                                            :offset-assert 52)
   (probe-y-offset     float                                                                            :offset-assert 56)
   (suspension-spring  float                                                                            :offset-assert 60)
   (suspension-damping float                                                                            :offset-assert 64)
   (forward-grip       float                                                                            :offset-assert 68)
   (side-grip          float                                                                            :offset-assert 72)
   (max-brake-torque   float                                                                            :offset-assert 76)
   (camber             float                                                                            :offset-assert 80)
   (x-scale            float                                                                            :offset-assert 84)
   (probe-radius       float                                                                            :offset-assert 88)
   (width              float                                                                            :offset-assert 92)
   (settle-pos         float                                                                            :offset-assert 96)
   )
  :method-count-assert 9
  :size-assert         #x64
  :flag-assert         #x900000064
  )

(deftype vehicle-camera-info (structure)
  ((string-min-height meters         :offset-assert 0)
   (string-max-height meters         :offset-assert 4)
   (string-min-length meters         :offset-assert 8)
   (string-max-length meters         :offset-assert 12)
   (min-fov           float          :offset-assert 16)
   (max-fov           float          :offset-assert 20)
   (head-offset       float          :offset-assert 24)
   (foot-offset       float          :offset-assert 28)
   ;; og:preserve-this look-pos-array needs :inline, and the four named vectors
   ;; that overlay it become :offset. The game's own (method 3
   ;; vehicle-camera-info) inspect prints look-pos-array[4] at this+32 and then
   ;; look-front/look-left/look-right/look-rear at 32/48/64/80, so the array's
   ;; four elements are 16 bytes apart: inline vectors, not a four-pointer
   ;; array. jak3's copy of this type is identical in shape (its own
   ;; look-pos-array is `vector 4 :inline` with the same four :offset
   ;; overlays). Without :inline the static decompiler reads offsets 32-47 as
   ;; four references and fails every rigid-body-vehicle-constants static with
   ;; "did not have a proper reference for array element 1".
   (look-pos-array    vector 4 :inline :offset-assert 32)
   (look-front        vector :inline :offset 32)
   (look-left         vector :inline :offset 48)
   (look-right        vector :inline :offset 64)
   (look-rear         vector :inline :offset 80)
   )
  :method-count-assert 9
  :size-assert         #x60
  :flag-assert         #x900000060
  )

(deftype vehicle-damage-info (structure)
  ((inv-toughness-factor float                        :offset-assert 0)
   (hit-points           float                        :offset-assert 4)
   (inv-hit-points       float                        :offset-assert 8)
   (hit-threshold        float                        :offset-assert 12)
   (impact-damage-factor float                        :offset-assert 16)
   (section-mask         uint32                       :offset-assert 20)
   (section-array        vehicle-section-info 12 :inline :offset-assert 32) ;; guessed by decompiler
   (section-lf-fender    vehicle-section-info :inline :offset 32)
   (section-rf-fender    vehicle-section-info :inline :offset 176)
   (section-lr-fender    vehicle-section-info :inline :offset 320)
   (section-rr-fender    vehicle-section-info :inline :offset 464)
   (section-l-door       vehicle-section-info :inline :offset 608)
   (section-r-door       vehicle-section-info :inline :offset 752)
   (section-hood         vehicle-section-info :inline :offset 1184)
   (section-trunk        vehicle-section-info :inline :offset 1328)
   (section-f-bumper     vehicle-section-info :inline :offset 896)
   (section-r-bumper     vehicle-section-info :inline :offset 1040)
   (section-roof         vehicle-section-info :inline :offset 1472)
   (section-cockpit      vehicle-section-info :inline :offset 1616)
   )
  :method-count-assert 9
  :size-assert         #x6e0
  :flag-assert         #x9000006e0
  )

;; forward declaration: this file is ordered alphabetically, so vehicle-seat-info's
;; own deftype sits below, next to vehicle-rider-info which needs it :inline. The
;; three seat fields here are pointer-shaped, so a partial definition is enough,
;; the same reason vehicle-wheel-state is declared rather than moved above.
(declare-type vehicle-seat-info structure)

(deftype vehicle-daxter-info (structure)
