(deftype vehicle-sound-loop-info (structure)
  ((sound        uint16  :offset-assert 0) ;; sound-name
   (speed        float   :offset-assert 4)
   (min-speed    float   :offset-assert 8)
   (max-speed    float   :offset-assert 12)
   (pitch-offset float   :offset-assert 16)
   (pitch-scale  float   :offset-assert 20)
   (min-pitch    float   :offset-assert 24)
   (max-pitch    float   :offset-assert 28)
   )
  :allow-misaligned
  ;; og:preserve-this :pack-me added alongside :allow-misaligned. The two flags
  ;; are independent (deftype.cpp:605/615, Type.h:315/321) and only :pack-me sets
  ;; is_packed(), which data_decompile.cpp:1151 requires before it will decompile
  ;; a structure sitting at a non-8-aligned address. tire-roll-sounds starts at
  ;; vehicle-sound-info+28 and vehicle-sound-info itself sits at
  ;; rigid-body-vehicle-constants+544, so element 0 lands on 572, i.e. 4-aligned,
  ;; and every rigid-body-vehicle-constants static failed on it. This is
  ;; placement-neutral: :allow-misaligned already dropped the start alignment to
  ;; 4, and the stride is align(32, 4) == align(32, 16) == 32 either way.
  :pack-me
  :method-count-assert 9
  :size-assert         #x20
  :flag-assert         #x900000020
  )

(deftype vehicle-sound-engine-loop-info (structure)
