(deftype vehicle-hardpoint-info (structure)
  ((local-pos-array    (inline-array vector) :offset-assert 0)
   (flag-attach        vector        :inline :offset-assert 16)
   (antenna-attach     vector        :inline :offset-assert 32)
   (nodes              int8    7             :offset-assert 48)
   (shield-anim        int16                 :offset-assert 56)
   (left-gun           int8                  :offset 48)
   (right-gun          int8                  :offset 49)
   (mine-launcher      int8                  :offset 50)
   (trunk              int8                  :offset 51)
   (super-turbo-attach int8    3             :offset 52)
   )
  :method-count-assert 9
  :size-assert         #x3a
  :flag-assert         #x90000003a
  )

(deftype vehicle-particle-common-info (structure)
  ((pad-pre-headlight-glow-template uint8            36       :offset-assert 0)
   (headlight-glow-template sprite-glow-data         :offset-assert 36)
   (taillight-glow-template sprite-glow-data         :offset-assert 40)
   (thruster-glow-template  sprite-glow-data         :offset-assert 44)
   (pad-pre-thrust-tex-id   uint8                    24       :offset-assert 48)
   (thrust-tex-id           uint32                   :offset-assert 72)
   (dark-thrust-tex-id      uint32                   :offset-assert 76)
   (pad-pre-rgb             uint8                    48       :offset-assert 80)
   (rgb                     rgbaf            :inline :offset-assert 128)
   (lights                  vu-lights                :offset-assert 144)
   (pad-tail                uint8                    8        :offset-assert 148)
   )
  :method-count-assert 10
  :size-assert         #x9c
  :flag-assert         #xa0000009c
  (:methods
    (vehicle-particle-common-info-method-9 (_type_) none) ;; 9 ;; (init! (_type_) none)
    )
  ;; adjudicated: ASSERTS RIGHT (proven), FIELD LIST short four holes.
  ;; This is a structure, so no pointer bias applies and the inspect offsets are
  ;; the all-types offsets directly. (method 3 vehicle-particle-common-info) in
  ;; vehicle-h_ir2.asm loads 36 / 40 / 44 / 72 / 76, computes +128 and loads 144
  ;; -- the dead block's seven offsets verbatim, with the first field at 36 and
  ;; not at 0, which is why the parser (which auto-places the first field of a
  ;; structure at 0) rejected it.
  ;; The jak3 twin corroborates the shape: jak3's vehicle-particle-common-info
  ;; (jak3 all-types.gc:53701, goal_src/jak3/.../vehicle-h.gc:502) is the same
  ;; three consecutive 4-byte glow templates preceded by seven more 4-byte
  ;; references -- headlight/taillight/thruster at 28/32/36 there vs 36/40/44
  ;; here, i.e. jakx's copy carries 2 extra leading words and then keeps going
  ;; where jak3 stops (jak3 size 0x28 = 40, jakx size 0x9c = 156).
  ;; Four regions the inspect never prints, all forced by the surrounding proven
  ;; offsets and by the size-assert: 0..35, 48..71, 80..127, 148..155. The
  ;; boundaries are proven; the pads' contents are not (the first 36 bytes are
  ;; almost certainly jak3's sp-system2d/sp-system3d/part-thruster/
  ;; part-thruster-x/part-spec2/part-quat/part-vel plus two more words, but
  ;; nothing in the jakx machine code names them).
  )

(deftype vehicle-particle-info (structure)
  ((headlight-count       int8     :offset-assert 0)
   (taillight-count       int8     :offset-assert 1)
   (thruster-count        int8     :offset-assert 2)
   (thruster-flame-width  meters   :offset-assert 4)
   (thruster-flame-length meters   :offset-assert 8)
   (thruster-local-pos    vector   :offset-assert 12) ;; guessed by decompiler
   (exhaust-local-pos     vector 2 :inline :offset-assert 16) ;; guessed by decompiler
   (exhaust-local-dir     vector 2 :inline :offset-assert 48) ;; guessed by decompiler
   (smoke-local-pos       vector 2 :inline :offset-assert 80) ;; guessed by decompiler
   (smoke-local-vel       vector 2 :inline :offset-assert 112) ;; guessed by decompiler
   (headlight-local-pos   vector 3 :inline :offset-assert 144) ;; guessed by decompiler
   (taillight-local-pos   vector 2 :inline :offset-assert 192) ;; guessed by decompiler
   )
  :method-count-assert 9
  :size-assert         #xe0
  :flag-assert         #x9000000e0
  )

