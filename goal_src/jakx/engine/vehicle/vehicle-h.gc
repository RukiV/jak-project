(deftype rigid-body-vehicle-constants (rigid-body-object-constants)
  ((flags           uint32                               :offset-assert 200)
   (vehicle-type    uint8                                :offset-assert 204) ;; vehicle-type-u8
   (engine          vehicle-engine-info          :inline :offset-assert 208)
   (transmission    vehicle-transmission-info    :inline :offset-assert 264)
   (handling        vehicle-handling-info        :inline :offset-assert 316)
   (pilot           vehicle-pilot-info           :inline :offset-assert 424)
   (camera          vehicle-camera-info          :inline :offset-assert 448)
   (sound           vehicle-sound-info           :inline :offset-assert 544)
   (particles       vehicle-particle-info        :inline :offset-assert 832)
   (damage          vehicle-damage-info          :inline :offset-assert 1056)
   (physics-model   vehicle-physics-model-info   :inline :offset-assert 2816)
   (setup           vehicle-setup-info                   :offset-assert 3028)
   (rider           vehicle-rider-info           :inline :offset-assert 3040)
   (daxter          vehicle-daxter-info                  :offset-assert 3128)
   (hardpoint       vehicle-hardpoint-info       :inline :offset-assert 3136)
   (shield          vehicle-shield-info          :inline :offset-assert 3200)
   (explosion       vehicle-explosion-info               :offset-assert 3236) ;; guessed by decompiler
   (explosion-part  int32                                :offset-assert 3240)
   (debris          debris-static-params                 :offset-assert 3244) ;; guessed by decompiler
   (name-text       text-id                              :offset-assert 3248) ;; guessed by decompiler
   (helmet-offset   vector                               :offset-assert 3252)
   (particle-common vehicle-particle-common-info         :offset-assert 3256)
   )
  :method-count-assert 11
  :size-assert         #xcbc
  :flag-assert         #xb00000cbc
  (:methods
    ;; og:preserve-this arity corrected from the dead block's () by register
    ;; reads: the body in vehicle-util reads a0 at its first two ops
    ;; (`sw v1, 3256(a0)` then `lwu a0, 3256(a0)`) without ever setting it, and
    ;; never touches a1 or later, so it takes exactly one argument, this.
    (rigid-body-vehicle-constants-method-10 (_type_) none) ;; 10
    )
  )

;; og:preserve-this the captured vehicle deftype's own field offsets are
;; systematically 4 bytes low (the +4 basic-offset trap from
;; docs/jakx-bringup-quickstart.md, applied correctly in the SAME scoped
;; decode for rigid-body-object and wvehicle, but missing here). Every
;; offset below is the captured value +4, cross-checked three ways:
;; (1) vehicle-h.o's own (method 3 vehicle) reads camera-dist with
;; `lwc1 f0, 744(gp)` and impact-proc with `ld a2, 764(gp)` -- both raw,
;; needing +4 to become the declared 748/768;
;; (2) cam-states.o (a consumer, typed `vehicle` at these call sites) reads
;; the shim's cam-target-handle with `ld v1, 748(v1)` (declared 752) and
;; its own flags test with `ld v1, 260(gp)` (declared 264) -- the same +4
;; gap, confirming the correction applies uniformly across both objects;
;; (3) wvehicle's own first field (net-extra, all-types.gc) is
;; :offset-assert 2140, which only self-consistently auto-places
;; (align(parent_size, 4)) if vehicle's true size is exactly 2137 --
;; align(2137, 4) = 2140, exact.
;; Once shifted, car-info lands at 288, immediately after rigid-body-object
;; ends (zero gap), rather than colliding with rigid-body-object's own
;; perf@284. The captured "flags" field (was @260, shifts to @264) is
;; dropped entirely: 264 is rigid-body-object's own inherited flags field
;; (confirmed in the rigid-body-object landing, same commit family), and the
;; capture's own trailing hint ("guessed by decompiler ;;
;; rigid-body-object-flag") already flagged the suspicion. cam-target-handle
;; (the bring-up shim's second field, cam-states.gc) is folded in at its
;; confirmed offset 752, an 8-byte handle, retiring the shim.
;; og:preserve-this info narrowed to rigid-body-vehicle-constants via
;; :override, matching jak3's own vehicle deftype
;; (decompiler/config/jak3/all-types.gc:53878). rigid-body-object-constants'
;; own 200-byte size-assert is correct and untouched (it is the real layout
;; for non-vehicle rigid bodies like *bombbot-body-constants* and
;; *skeet-rigid-body-constants*); the wcar family's info field genuinely
;; holds the richer rigid-body-vehicle-constants at runtime, as the already
;; landed *v-mongoose-constants* et al. (goal_src/jakx/levels/desert/
;; wvehicle/wcar.gc) declare. Without this override the decompiler resolves
;; (-> this info ...) against the 200-byte base type, which is what made a
;; scoped decode of wcar-mongoose fail: (method 69 v-mongoose) loads floats
;; at absolute offsets 2928 and 2968 through info and stores to 2952, all
;; three landing inside rigid-body-vehicle-constants' own
;; physics-model.rear-wheel (physics-model :inline at 2816, rear-wheel at
;; +112 = 2928 local-pos.x, +112+24 = 2952 callback, +112+40 = 2968
;; steer-arm-length) -- a rear-wheel physics-callback assignment, not an
;; under-declared base type. See the comment above vehicle-section-info for
;; why this whole chain, rigid-body-vehicle-constants included, now sits
;; ahead of this deftype instead of below it.
;; og:preserve-this vehicle rung: birth-accum retyped uint32 2 -> float 2:
;; (method 99 vehicle)'s own decode stores to both 4-byte sub-fields with
;; swc1 (s.f!), not sw, so the raw capture's "uint32" guess does not match
;; the actual store width; launcher stays basic, stored via s.w! from a
;; *part-id-table* entry immediately after each birth-accum pair. :pack-me
;; added: method 99's six writes land 12 bytes apart (908/920/932/944/956/
;; 968 raw), a tight stride with no padding; without :pack-me an :inline
;; array of this type compiles to a 16-byte per-element stride (compiler-
;; inserted, the same unpacked-structure mechanism documented on vehicle-
;; controls and vehicle-section), which does not match the retail layout
;; here (unlike vehicle-section, nothing in this type needs 16-byte
;; alignment).
(deftype vehicle-particle (structure)
  ((birth-accum float 2 :offset-assert 0)
   (launcher    basic     :offset-assert 8)
   )
  :pack-me
  :method-count-assert 9
  :size-assert         #xc
  :flag-assert         #x90000000c
  )

(deftype vehicle (rigid-body-object)
  ((info                             rigid-body-vehicle-constants                :override)
   (car-info                        car-info-full                               :offset-assert 288)
   ;; og:preserve-this 12 bytes unaccounted (292-304): no load in this rung's
   ;; scoped decode touches this range. Extent-true pad; a broader decode of
   ;; vehicle.o's non-inspect methods would resolve it.
   (pad-post-car-info                uint8                                12    :offset-assert 292)
   ;; og:preserve-this damage-matrix's span is 304-432 (128 bytes). The name
   ;; and the size (128 = 2x sizeof(matrix)) suggest two 4x4 transform
   ;; matrices, but no raw load in this scoped decode confirms it and a
   ;; non-inline `matrix 2` field does not reserve the 128 bytes the offset
   ;; math needs (GOAL treats a non-inline array of a reference type as
   ;; pointer-sized per element; TypeSystem.cpp:1381-1388). Landed as an
   ;; extent-true pad rather than assert a type this rung cannot confirm;
   ;; a decode of whatever vehicle.o method indexes it would resolve it,
   ;; and :inline matrix 2 is the likely fix once it does.
   (damage-matrix                   uint8                                128   :offset-assert 304)
   (damage-direction                vector                              :inline :offset-assert 432)
   (camera-pos                      vector                              :inline :offset-assert 448)
   ;; og:preserve-this v-flags-2: a second 64-bit flag word, proven by three
   ;; ld/and/sd sites all against this same offset -- vehicle-states_ir2.asm:
   ;; 1426-1434 (mask ~0x40000), vehicle_ir2.asm:7793 and :7832 (masks
   ;; 0x100000 and 0x200000), and vehicle-util_disasm.gc:1683's failed
   ;; `(s.d! (+ this 460) v1-2)` (method 110 mirroring the primary `flags`
   ;; word into this one). Landed bare (no bitfield enum): the individual
   ;; bit semantics beyond these three masks are support-grade only.
   (v-flags-2                       uint64                                      :offset-assert 464)
   (control-hook                    (function vehicle vehicle-controls)         :offset-assert 472) ;; guessed by decompiler
   (control-mask                    vehicle-controls                            :offset-assert 476)
   ;; og:preserve-this impact-callback retyped basic -> function: method 80
   ;; CALLS it directly (vehicle_disasm.gc:48, "Called something that was
   ;; not a function: basic"), only ever setting a0 (self) and a1 (the
   ;; rigid-body-impact arg of method 80 itself) before the call; return
   ;; value is unpinned by this rung's evidence, typed object. Retyped
   ;; identically on vehicle-spawn-params (traffic-h.gc) in the same commit
   ;; -- vehicle-init-by-other copies the field straight across
   ;; (vehicle-manager_ir2.asm, `lwu v1, 96(gp)` / `sw v1, 476(s6)`, the
   ;; usual +4-corrected landing at this field's own offset).
   (impact-callback                 (function vehicle rigid-body-impact object) :offset-assert 480)
   ;; og:preserve-this controls through lin-acceleration are :inline
   ;; structures/vectors needing 16-byte alignment (STRUCTURE_ALIGNMENT); the
   ;; captured (+4-corrected) offsets previously did not land on it because
   ;; vehicle-controls lacked :pack-me (see that type's own comment above).
   ;; With :pack-me added, the captured offsets assert directly below.
   ;; unknown-float-700 and unknown-float-704 (raw capture 700/704,
   ;; +4-corrected offsets 704/708) are load-proven -- dropping either
   ;; regresses the wvehicle-net and wvehicle-h decodes in the full-corpus
   ;; gate -- but no inspect method in this rung's scope names them; retire
   ;; the placeholder names once one does. pad-pre-behavior widened from 8 to
   ;; 16 to absorb them, still landing behavior at its independently
   ;; confirmed offset (vehicle-h.o's own inspect, `ld a2, 724(gp)`, +4).
   ;; vehicle rung: pad-pre-behavior narrows back to 12 to carve out
   ;; torque-scale (raw capture 720, +4-corrected offset 724), read
   ;; alongside engine-max-torque in (method 224 wvehicle)'s own
   ;; engine-torque-curve body (a direct multiplier on the base torque) and
   ;; alongside a *game-info* difficulty-style scalar in (method 62
   ;; wvehicle)'s own acceleration body (a straight multiplier into the same
   ;; kind of output); named by usage pattern across both, not by an inspect
   ;; method (support-level evidence, not proof).
   (controls                        vehicle-controls                    :inline :offset 484)
   (prev-controls                   vehicle-controls                    :inline :offset 508)
   ;; og:preserve-this unknown-flags-528 (raw capture 528, +4-corrected offset
   ;; 532): wvehicle-states.gc's own decode of (enter sink) and (post
   ;; race-finished) both mask this 32-bit load with 8 (bit 3) before gating
   ;; a splash/sound-instance branch; no inspect method in this rung's scope
   ;; names it, so kept as a placeholder alongside the rest of the
   ;; unaccounted 12 bytes between prev-controls and impact.
   (unknown-flags-528               uint32                               :offset 532)
   (pad-pre-impact                  uint8                                8     :offset 536)
   (impact                          rigid-body-impact                   :inline :offset 544)
   (target-acceleration             vector                              :inline :offset 624)
   (impact-local-pos                vector                              :inline :offset 640)
   (lin-acceleration                vector                              :inline :offset 656)
   (max-impact-impulse              float                                       :offset 672)
   (sum-impact-impulse              float                                       :offset 676)
   (underside-y                     float                                       :offset 680)
   (side-x                          float                                       :offset 684)
   (health                          float                                       :offset 688)
   (damage-factor                   float                                       :offset 692)
   (speed-factor                    float                                       :offset 700)
   (unknown-float-700               float                                       :offset 704)
   (unknown-float-704               float                                       :offset 708)
   (pad-pre-behavior                uint8                                12    :offset 712)
   (torque-scale                    float                                       :offset 724)
   (behavior                        uint64                                      :offset-assert 728)
   (cam-view                        int8                                        :offset-assert 736)
   ;; og:preserve-this 7 bytes unaccounted (737-744).
   (pad-post-cam-view               uint8                                7     :offset-assert 737)
   (cam-speed-interp                float                                       :offset-assert 744)
   (camera-dist                     float                                       :offset-assert 748)
   (cam-target-handle               handle                                      :offset-assert 752)
   ;; og:preserve-this 8 bytes unaccounted (760-768).
   (pad-post-cam-target-handle      uint8                                8     :offset-assert 760)
   (impact-proc                     uint64                                      :offset-assert 768) ;; handle
   (net-player                      uint64                                      :offset-assert 776)
   ;; og:preserve-this 4 bytes unaccounted (784-788).
   (pad-post-net-player             uint8                                4     :offset-assert 784)
   (impact-time                     uint32                                      :offset-assert 788)
   (prev-impact-time                uint32                                      :offset-assert 792)
   ;; og:preserve-this 12 bytes unaccounted (796-808).
   (pad-post-prev-impact-time       uint8                                12    :offset-assert 796)
   (offscreen-time                  uint32                                      :offset-assert 808)
   (pad-pre-unknown-int32-812       uint8                                4     :offset-assert 812)
   ;; og:preserve-this unknown-int32-812 (raw capture 812, +4-corrected
   ;; offset 816): football2's own powercell-footie-update-pos-on-vehicle
   ;; writes a time-frame value 150 ticks ahead of the current clock here
   ;; (a schedule-next-check idiom, the same shape as the other
   ;; unknown-*-time fields already carved out of this pad region); no
   ;; inspect method in this rung's scope names it, so kept as a
   ;; placeholder inside the still-unaccounted pad-post-offscreen-time
   ;; span (scoped decode, this worktree's config, football2, rung 2).
   (unknown-int32-812               int32                                :offset-assert 816)
   (pad-post-unknown-int32-812      uint8                                4     :offset-assert 820)
   (physics-enabled-time            uint32                                      :offset-assert 824)
   ;; og:preserve-this 28 bytes unaccounted (828-856).
   (pad-post-physics-enabled-time   uint8                                28    :offset-assert 828)
   (water-height                    float                                       :offset-assert 856)
   ;; og:preserve-this the single largest uncaptured span (860-1808, 948
   ;; bytes): consistent with the brief's own finding that ~85-90% of
   ;; vehicle's payload is unnamed (S4's net-payload fields, weapon and seat
   ;; state, and whatever else lives on the wire between water-height and
   ;; pred, are all somewhere in here). Not resolvable from this rung's
   ;; scoped decode; a body-landing rung with a wider allowed_objects list
   ;; is the retirement path.
   (pad-pre-unknown-sound-id-884    uint8                                28    :offset-assert 860)
   ;; og:preserve-this unknown-sound-id-884 (raw capture 884, +4-corrected
   ;; offset 888): wvehicle-states.gc's own decode of (post explode) lazily
   ;; allocates a sound-id here via new-sound-id the first time it is
   ;; needed (same idiom as the already-named *-sound-id fields above), then
   ;; passes it straight to make-sound-instance; no inspect method in this
   ;; rung's scope names it, so kept as a placeholder inside the still-
   ;; unaccounted net-payload gap.
   (unknown-sound-id-884            sound-id                             :offset-assert 888)
   (pad-pre-unknown-sound-id-892    uint8                                4     :offset-assert 892)
   ;; og:preserve-this unknown-sound-id-892 (raw capture 892, +4-corrected
   ;; offset 896): same lazy new-sound-id/make-sound-instance idiom as
   ;; unknown-sound-id-884 immediately above, a second independent sound-id
   ;; slot read at wvehicle-states.gc's (post explode).
   (unknown-sound-id-892            sound-id                             :offset-assert 896)
   (pad-pre-unknown-float-904       uint8                                8     :offset-assert 900)
   ;; og:preserve-this unknown-float-904 (raw capture 904, +4-corrected
   ;; offset 908): wvehicle-states.gc's own decode of (post explode) reads,
   ;; damps toward zero and writes back this float repeatedly (an
   ;; ease-toward-target accumulator driving the post-explosion camera
   ;; shake decay); no inspect method in this rung's scope names it, so kept
   ;; as a placeholder inside the still-unaccounted net-payload gap.
   (unknown-float-904               float                                :offset-assert 908)
   ;; og:preserve-this vehicle rung: 72 bytes carved off this field's front
   ;; for the resurrected `particles` array (6 x vehicle-particle, proven by
   ;; method 99's own six 12-byte swc1/s.w! groups at placements 912/924/936/
   ;; 948/960/972). The wcar-* family (wcar-bear, wcar-bobcat, wcar-cheetah,
   ;; wcar-cougar, wcar-daxtermobile, wcar-falcon, wcar-gila, wcar-leopard,
   ;; wcar-mongoose, wcar-panther, wcar-possum, wcar-tiger, wcar-wolf,
   ;; wcar-wombat, wcar-snake) own raw byte-indices into pad-net-payload-gap
   ;; (their vehicle-section array access) all re-index onto the new named
   ;; `sections` field below in this same commit.
   (particles                       vehicle-particle                    6     :inline :offset-assert 912)
   ;; og:preserve-this kept as pad-net-payload-gap (not renamed to a
   ;; pad-post-* form) even though it now starts 124 bytes later than its
   ;; original 860: 40 bytes remain unaccounted between particles and the
   ;; newly-landed sections array below.
   (pad-net-payload-gap             uint8                                40    :offset-assert 984)
   ;; og:preserve-this sections: 12 x vehicle-section :inline, proven by two
   ;; independent sites -- vehicle-init-by-other's own loop
   ;; (vehicle-manager_ir2.asm:3045+, `dsll v1, s5, 6` / `daddiu v1, v1, 1020`,
   ;; a 64-byte stride from raw 1020 = landed 1024, 12 iterations) and
   ;; wcar-cheetah's own (method 66 v-cheetah) indexing element 11 directly
   ;; via (&-> this pad-net-payload-gap 816) pre-rung (816 + the old pad-
   ;; net-payload-gap base of 912 = 1728 = 1024 + 11*64). vehicle-section's
   ;; own :size-assert is #x38 (56, tightly packed, no :pack-me); the
   ;; observed 64-byte per-element stride is the compiler's own inter-
   ;; element alignment padding for a structure that opens with an :inline
   ;; vector and lacks :pack-me, the same mechanism already documented on
   ;; vehicle-controls above.
   (sections                        vehicle-section                     12    :inline :offset-assert 1024)
   ;; og:preserve-this issue 571 R10f: 8 bytes carved off this pad's front for
   ;; event-target-handle. Deviates from the brief's suggested "v-flags-3"
   ;; name/framing (a flag word): this rung's own scoped decode of all 17
   ;; family sites at this offset (vehicle, vehicle-net, wvehicle-events,
   ;; wvehicle-util, wvehicle-weapons) shows the identical
   ;; `(l.d (+ this 1792))` / `(subu-s7 ...)` / zero-check idiom immediately
   ;; preceding a `send-event-function` call, plus one direct write of #f
   ;; (vehicle_ir2.asm:372's `(s.d! (+ this 1792) #f)`) -- the standard
   ;; handle-nil-check-then-forward pattern, not a single AND/OR bitmask site
   ;; anywhere in the 17. Named after the already-landed `cam-target-handle`
   ;; field above (offset 752), same `handle` typing, describing what every
   ;; site actually does with it: resolve to a process and forward an event.
   ;; The brief cited "37 family-wide l.d/s.d sites"; this rung's own count
   ;; across vehicle*/wvehicle*-prefixed objects is 17, all this same shape;
   ;; recorded as a discrepancy against the investigation's own ledger, not
   ;; resolved further (decode wins per AGENTS.md rule 9/10).
   (event-target-handle             handle                                      :offset-assert 1792)
   (pad-pre-pred                    uint8                                8     :offset-assert 1800)
   (pred                            net-predictor-sphcol                :inline :offset-assert 1808)
