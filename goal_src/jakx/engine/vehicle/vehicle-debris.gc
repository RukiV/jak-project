;; definition of type vehicle-debris-init-params
(deftype vehicle-debris-init-params (structure)
  ((mat            matrix  :inline)
   (velocity       vector  :inline)
   (ang-velocity   vector  :inline)
   (color          rgbaf   :inline)
   (radius         float)
   (skel           basic)
   (info           rigid-body-object-constants)
   (level          basic)
   (impact-sound   uint16)
   (has-particles  basic)
   )
  )

;; definition for method 3 of type vehicle-debris-init-params
(defmethod inspect ((this vehicle-debris-init-params))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'vehicle-debris-init-params)
  (format #t "~1Tmat: #<matrix @ #x~X>~%" (-> this mat))
  (format #t "~1Tvelocity: #<vector @ #x~X>~%" (-> this velocity))
  (format #t "~1Tang-velocity: #<vector @ #x~X>~%" (-> this ang-velocity))
  (format #t "~1Tcolor: #<rgbaf @ #x~X>~%" (-> this color))
  (format #t "~1Tradius: ~f~%" (-> this radius))
  (format #t "~1Tskel: ~A~%" (-> this skel))
  (format #t "~1Tinfo: #<rigid-body-object-constants @ #x~X>~%" (-> this info))
  (format #t "~1Tlevel: ~A~%" (-> this level))
  (format #t "~1Timpact-sound: ~D~%" (-> this impact-sound))
  (format #t "~1Thas-particles: ~A~%" (-> this has-particles))
  (label cfg-4)
  this
  )

;; og:preserve-this *vehicle-debris-constants* is omitted rather than
;; landed. Its own static (L59) fails static-ref the same way as the
