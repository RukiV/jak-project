;;-*-Lisp-*-
(in-package goal)

;; name: vehicle-debris.gc
;; name in dgo: vehicle-debris
;; dgos: ENGINE, GAME

;; og:preserve-this find-nearest-camera-distance is redeclared here rather
;; than required from race-mesh.gc, matching that file's own precedent
;; (each caller redeclares locally rather than requiring one another).
;; (mi) confirmed the extern is otherwise invisible at this file's own
;; compile order: method 88 below fails with "No method or function
;; named find-nearest-camera-distance for type vector" without it.
(define-extern find-nearest-camera-distance (function vector float))

;; DECOMP BEGINS

;; og:preserve-this car-feeders rung: retyped skel field basic -> skeleton-
;; group. vehicle-debris-init-by-other's own decode reads raw offset 56 of
;; this field (placement 60 under the +4 basics convention, skeleton-group's
;; own bounds.w / radius overlay field) to scale the spawned debris's own
;; draw bounds by the source skeleton's radius; the read does not resolve
;; under plain basic. Matches wvehicle-wheel.gc's own vehicle-wheel-init-
;; params.vehicle retype precedent for the identical defect class.
;; definition of type vehicle-debris-init-params
(deftype vehicle-debris-init-params (structure)
  ((mat            matrix  :inline)
   (velocity       vector  :inline)
   (ang-velocity   vector  :inline)
   (color          rgbaf   :inline)
   (radius         float)
   (skel           skeleton-group)
   (info           rigid-body-object-constants)
   (level          basic)
   (impact-sound   uint16)
   (has-particles  basic)
   )
  )

;; definition for method 3 of type vehicle-debris-init-params
(defmethod inspect ((this vehicle-debris-init-params))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'vehicle-debris-init-params)
  (format #t "~1Tmat: #<matrix @ #x~X>~%" (-> this mat))
  (format #t "~1Tvelocity: #<vector @ #x~X>~%" (-> this velocity))
  (format #t "~1Tang-velocity: #<vector @ #x~X>~%" (-> this ang-velocity))
  (format #t "~1Tcolor: #<rgbaf @ #x~X>~%" (-> this color))
  (format #t "~1Tradius: ~f~%" (-> this radius))
  (format #t "~1Tskel: ~A~%" (-> this skel))
  (format #t "~1Tinfo: #<rigid-body-object-constants @ #x~X>~%" (-> this info))
  (format #t "~1Tlevel: ~A~%" (-> this level))
  (format #t "~1Timpact-sound: ~D~%" (-> this impact-sound))
  (format #t "~1Thas-particles: ~A~%" (-> this has-particles))
  (label cfg-4)
  this
  )

;; og:preserve-this *vehicle-debris-constants* is omitted rather than
;; landed. Its own static (L59) fails static-ref the same way as the
;; other unparseable <static-data LNN> placeholders this band keeps
;; hitting, and it has no caller anywhere in this file's landed content
;; (its only reader is inside vehicle-debris-init-by-other, held below).

;; definition of type vehicle-debris
(deftype vehicle-debris (rigid-body-object)
  ((impact-sound  uint16)
   (camera-dist   float)
   )
  (:state-methods
    explode
    fade-out
    die
    )
  )

;; definition for method 3 of type vehicle-debris
(defmethod inspect ((this vehicle-debris))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type rigid-body-object inspect)))
    (t9-0 this)
    )
  (format #t "~2Timpact-sound: ~D~%" (-> this impact-sound))
  (format #t "~2Tcamera-dist: ~f~%" (-> this camera-dist))
  (label cfg-4)
  this
  )

;; og:preserve-this methods 65 and 87 are omitted rather than landed.
;; Both decode as an almost entirely the-as-none raw-offset fallback and
;; neither is a localized, isolable defect: method 65 fails at op 3 and
;; separately reads a1 with no set (the decompiler's own unset-register
;; diagnostic; every other landed override of this method across the
;; corpus, including rigid-body-object's own base implementation, takes
;; only self, so this is not a dropped-argument fix, something else
;; corrupted this specific override's decode); method 87 fails a
;; stack-use guess with a fully raw ~90-line body.
;;
;; method 88 was in this same held state until its own blocker (an
;; unactivated find-nearest-camera-distance) was cleared by the
;; race-mesh rung (jakx-levels-other-tier-4, both the decompiler-config
;; extern and a real define-extern now live in
;; goal_src/jakx/levels/common/race/race-mesh.gc). Its decode was
;; already fully clean at that point; this rung landed it below.

;; definition for method 66 of type vehicle-debris
;; WARN: Return type mismatch int vs none.
(defmethod rigid-body-object-method-66 ((this vehicle-debris))
  (set! (-> this root max-iteration-count) (the-as uint 3))
  (set! (-> this max-time-step) 0.05)
  (set! (-> this focus-status)
        (the-as focus-status (logior (focus-status gun-no-target) (-> this focus-status)))
        )
  (set! (-> this rbody max-ang-momentum) (/ (-> this rbody info max-ang-momentum) 2))
  0
  (none)
  )

;; definition for method 61 of type vehicle-debris
;; WARN: Return type mismatch int vs none.
(defmethod rigid-body-object-method-61 ((this vehicle-debris))
  (ja-post)
  (if (logtest? (-> this flags) 1)
      (update-transforms (-> this root))
      )
  0
  (none)
  )

;; definition for method 80 of type vehicle-debris
;; WARN: Return type mismatch symbol vs none.
(defmethod rigid-body-object-method-80 ((this vehicle-debris) (arg0 rigid-body-impact))
  (when (< 20480.0 (-> arg0 impulse))
    (let ((f30-0 (fmin 1.0 (* 0.000048828126 (+ -20480.0 (-> arg0 impulse)))))
          (v1-8
            (make-sound-instance (-> *sound-info* (-> this impact-sound)) (new 'static 'sound-id) (the-as handle #f))
            )
          )
      (cond
        (v1-8
          (set! (-> v1-8 volume) (the int (* 1024.0 f30-0)))
          (logior! (-> v1-8 flags) 64)
          (-> v1-8 id)
          )
        (else
          0
          )
        )
      )
    0
    )
  (logior! (-> this root penetrated-by) (penetrate vehicle))
  #t
  (none)
  )

;; definition for method 88 of type vehicle-debris
;; WARN: Return type mismatch int vs none.
(defmethod rigid-body-object-method-88 ((this vehicle-debris))
  (local-vars (v1-8 float))
  (rlet ((acc :class vf)
         (vf0 :class vf)
         (vf1 :class vf)
         (vf2 :class vf)
         )
    (init-vf0-vector)
    (set! (-> this camera-dist) (find-nearest-camera-distance (-> this rbody position)))
    (if (< 901120.0 (-> this camera-dist))
        (go (method-of-object this die))
        )
    (.lvf vf1 (&-> (-> this rbody ang-velocity) quad))
    (.add.w.vf.x vf2 vf0 vf0)
    (.mul.vf vf1 vf1 vf1)
    (.mul.x.vf.x acc vf2 vf1)
    (.add.mul.y.vf.x acc vf2 vf1 acc)
    (.add.mul.z.vf.x vf1 vf2 vf1 acc)
    (.mov v1-8 vf1)
    (let ((f0-2 v1-8))
      (if (< (square 24.0) f0-2)
          (vector-float*! (-> this rbody ang-momentum) (-> this rbody ang-momentum) (/ 24.0 (sqrtf f0-2)))
          )
      )
    (rigid-body-object-method-70 this)
    (rigid-body-control-method-11 (-> this rbody) (the-as collide-shape-moving (-> this root)))
    (rigid-body-object-method-61 this)
    0
    (none)
    )
  )

;; definition for method 71 of type vehicle-debris
;; WARN: Return type mismatch int vs none.
(defmethod rigid-body-object-method-71 ((this vehicle-debris))
  0
  (none)
  )

;; failed to figure out what this is:
(defstate explode (vehicle-debris)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('impact-impulse)
       (let ((a1-1 (-> block param 0)))
         (rigid-body-object-method-80 self (the-as rigid-body-impact a1-1))
         )
       )
      )
    )
  :enter (behavior ()
    (set-time! (-> self state-time))
    (logior! (-> self rbody flags) 10)
    (let ((v1-5 (-> self rbody)))
      (set! (-> v1-5 linear-damping) 0.005)
      (set! (-> v1-5 angular-damping) 0.01)
      (set! (-> v1-5 bounce-factor) 0.2)
      (set! (-> v1-5 friction-factor) 0.1)
      )
    )
  :trans #f
  :code sleep-code
  :post (behavior ()
    (rigid-body-object-method-71 self)
    (if (nonzero? (-> self part))
        (spawn-from-mat (-> self part) (-> self rbody matrix))
        )
    (if (time-elapsed? (-> self state-time) (seconds 4))
        (go-virtual fade-out)
        )
    )
  )

;; failed to figure out what this is:
(defstate fade-out (vehicle-debris)
  :virtual #t
  :enter (behavior ()
    (set-time! (-> self state-time))
    (logior! (-> self draw status) (draw-control-status force-fade))
    )
  :code sleep-code
  :post (behavior ()
    (set! (-> self draw force-fade)
          (the-as
            uint
            (the int (fmax 0.0 (- 128.0 (* 0.42666668 (the float (- (current-time) (-> self state-time)))))))
            )
          )
    (if (< (-> self draw force-fade) (the-as uint 2))
        (go-virtual die)
        )
    (rigid-body-object-method-71 self)
    )
  )

;; failed to figure out what this is:
(defstate die (vehicle-debris)
  :virtual #t
  :code (behavior ()
    (cleanup-for-death self)
    )
  )

;; car-feeders rung: vehicle-debris-init-by-other and vehicle-debris-spawn
;; landed together (the spawner's own run-now-in-process call needs its
;; callee defined, the AGENTS.md section 5 hazard the other way around).
;; Both were held only by their own commented-out externs (all-types.gc,
;; bare "function" typespecs with no prior derivation); typed both by direct
;; symmetry with wvehicle-wheel.gc's own already-landed vehicle-wheel-init-
;; by-other/vehicle-wheel-spawn pair (the identical init-params-plus-process
;; shape) and corroborated vehicle-debris-spawn's own two-argument call site
;; in vehicle-util.gc's raw decode (t9=vehicle-debris-spawn, a0=arg1-0 of the
;; containing function, a1=the address of a stack-built vehicle-debris-init-
;; params). Once typed, vehicle-debris-init-by-other's own decode had one
;; remaining gap: an inlined rand-float-gen bit-pattern trick (mtc1 typed the
;; source GPR uint instead of float, decompiler/config/jakx/ntsc_v1/
;; type_casts.jsonc's own established fix class for this exact idiom, op 30)
;; and the skel field retype recorded above. Both functions now decode with
;; no errors (spawn keeps one ordinary WARN, a process/vehicle-debris return-
;; type widening, landed as-is per this campaign's own convention for that
;; class of warning). vehicle-debris-init-by-other's own body adds self to
;; *rigid-body-queue* via method 11 right after rigid-body-object-method-66,
;; the queue feeder PR 526 left starved.
;;
;; Neither function has a landed caller: vehicle-debris-spawn's own caller
;; (vehicle-util.gc, some vehicle-destruction handler) stays raw/unlanded,
;; so this rung adds no new boot-path exposure.
;; definition for function vehicle-debris-init-by-other
(defbehavior vehicle-debris-init-by-other vehicle-debris ((arg0 vehicle-debris-init-params))
  (logior! (-> self mask) (process-mask vehicle))
  (rigid-body-object-method-65 self)
  (matrix->transformq (the-as transformq (-> self root trans)) (-> arg0 mat))
  (if (and (-> arg0 has-particles) (let* ((f30-0 0.5)
                                          (v1-9 (/ (the-as int (rand-uint31-gen *random-generator*)) 256))
                                          (v1-10 (the-as number (logior #x3f800000 v1-9)))
                                          )
                                     (< f30-0 (+ -1.0 (the-as float v1-10)))
                                     )
           )
      (set! (-> self part) (create-launch-control (-> *part-group-id-table* 43) self))
      )
  (set! (-> self level) (the-as level (-> arg0 level)))
  (initialize-skeleton self (-> arg0 skel) (the-as pair 0))
  (set! (-> self draw color-mult quad) (-> arg0 color quad))
  (set! (-> self draw lod-set lod 0 dist) 819200.0)
  (let ((f0-6 (fmax
                (fmax (vector-length (-> arg0 mat rvec)) (vector-length (-> arg0 mat uvec)))
                (vector-length (-> arg0 mat fvec))
                )
              )
        )
    (set! (-> self draw bounds w) (* (-> arg0 skel bounds w) f0-6))
    (set! (-> self draw longest-edge) (* (-> arg0 skel longest-edge) f0-6))
    )
  (set! (-> self impact-sound) (-> arg0 impact-sound))
  (rigid-body-object-method-64 self (-> arg0 info))
  (rigid-body-object-method-66 self)
  (rigid-body-queue-method-11 *rigid-body-queue* self)
  (let ((s5-0 (-> self rbody)))
    (rigid-body-control-method-31 s5-0 (-> arg0 velocity))
    (rigid-body-control-method-32 s5-0 (-> arg0 ang-velocity))
    )
  (go-virtual explode)
  )

;; definition for function vehicle-debris-spawn
;; WARN: Return type mismatch process vs vehicle-debris.
(defun vehicle-debris-spawn ((arg0 process) (arg1 vehicle-debris-init-params))
  (let ((gp-0 (the-as process #f)))
    (let* ((s3-0 (get-process *default-dead-pool* vehicle-debris #x4000 1))
           (v1-1 (when s3-0
                   (let ((t9-1 (method-of-type process activate)))
                     (t9-1 s3-0 arg0 "vehicle-debris" (the-as pointer #x70004000))
                     )
                   (run-now-in-process s3-0 vehicle-debris-init-by-other arg1)
                   (-> s3-0 ppointer)
                   )
                 )
           )
      (if v1-1
          (set! gp-0 (-> v1-1 0))
          )
      )
    (the-as vehicle-debris gp-0)
    )
  )