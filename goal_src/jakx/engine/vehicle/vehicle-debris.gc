;; og:preserve-this find-nearest-camera-distance is redeclared here rather
;; than required from race-mesh.gc, matching that file's own precedent
;; (each caller redeclares locally rather than requiring one another).
;; (mi) confirmed the extern is otherwise invisible at this file's own
;; compile order: method 88 below fails with "No method or function
;; named find-nearest-camera-distance for type vector" without it.
(define-extern find-nearest-camera-distance (function vector float))

;; DECOMP BEGINS

;; definition of type vehicle-debris-init-params
(deftype vehicle-debris-init-params (structure)
  ((mat            matrix  :inline)
   (velocity       vector  :inline)
   (ang-velocity   vector  :inline)
   (color          rgbaf   :inline)
   (radius         float)
   (skel           basic)
   (info           rigid-body-object-constants)
   (level          basic)
   (impact-sound   uint16)
   (has-particles  basic)
   )
  )

;; definition for method 3 of type vehicle-debris-init-params
(defmethod inspect ((this vehicle-debris-init-params))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'vehicle-debris-init-params)
  (format #t "~1Tmat: #<matrix @ #x~X>~%" (-> this mat))
  (format #t "~1Tvelocity: #<vector @ #x~X>~%" (-> this velocity))
  (format #t "~1Tang-velocity: #<vector @ #x~X>~%" (-> this ang-velocity))
  (format #t "~1Tcolor: #<rgbaf @ #x~X>~%" (-> this color))
  (format #t "~1Tradius: ~f~%" (-> this radius))
  (format #t "~1Tskel: ~A~%" (-> this skel))
  (format #t "~1Tinfo: #<rigid-body-object-constants @ #x~X>~%" (-> this info))
  (format #t "~1Tlevel: ~A~%" (-> this level))
  (format #t "~1Timpact-sound: ~D~%" (-> this impact-sound))
  (format #t "~1Thas-particles: ~A~%" (-> this has-particles))
  (label cfg-4)
  this
  )

;; og:preserve-this *vehicle-debris-constants* is omitted rather than
;; landed. Its own static (L59) fails static-ref the same way as the
;; other unparseable <static-data LNN> placeholders this band keeps
;; hitting, and it has no caller anywhere in this file's landed content
;; (its only reader is inside vehicle-debris-init-by-other, held below).

;; definition of type vehicle-debris
(deftype vehicle-debris (rigid-body-object)
  ((impact-sound  uint16)
   (camera-dist   float)
   )
  (:state-methods
    explode
    fade-out
    die
    )
  )

;; definition for method 3 of type vehicle-debris
(defmethod inspect ((this vehicle-debris))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type rigid-body-object inspect)))
    (t9-0 this)
    )
  (format #t "~2Timpact-sound: ~D~%" (-> this impact-sound))
  (format #t "~2Tcamera-dist: ~f~%" (-> this camera-dist))
  (label cfg-4)
  this
  )

;; og:preserve-this methods 65 and 87 are omitted rather than landed.
;; Both decode as an almost entirely the-as-none raw-offset fallback and
;; neither is a localized, isolable defect: method 65 fails at op 3 and
;; separately reads a1 with no set (the decompiler's own unset-register
;; diagnostic; every other landed override of this method across the
;; corpus, including rigid-body-object's own base implementation, takes
;; only self, so this is not a dropped-argument fix, something else
;; corrupted this specific override's decode); method 87 fails a
;; stack-use guess with a fully raw ~90-line body.
;;
;; method 88 was in this same held state until its own blocker (an
;; unactivated find-nearest-camera-distance) was cleared by the
;; race-mesh rung (jakx-levels-other-tier-4, both the decompiler-config
;; extern and a real define-extern now live in
;; goal_src/jakx/levels/common/race/race-mesh.gc). Its decode was
;; already fully clean at that point; this rung landed it below.

;; definition for method 66 of type vehicle-debris
;; WARN: Return type mismatch int vs none.
(defmethod rigid-body-object-method-66 ((this vehicle-debris))
  (set! (-> this root max-iteration-count) (the-as uint 3))
  (set! (-> this max-time-step) 0.05)
  (set! (-> this focus-status)
        (the-as focus-status (logior (focus-status gun-no-target) (-> this focus-status)))
        )
  (set! (-> this rbody max-ang-momentum) (/ (-> this rbody info max-ang-momentum) 2))
  0
  (none)
  )

;; definition for method 61 of type vehicle-debris
;; WARN: Return type mismatch int vs none.
(defmethod rigid-body-object-method-61 ((this vehicle-debris))
  (ja-post)
  (if (logtest? (-> this flags) 1)
      (update-transforms (-> this root))
      )
  0
  (none)
  )

;; definition for method 80 of type vehicle-debris
;; WARN: Return type mismatch symbol vs none.
(defmethod rigid-body-object-method-80 ((this vehicle-debris) (arg0 rigid-body-impact))
  (when (< 20480.0 (-> arg0 impulse))
    (let ((f30-0 (fmin 1.0 (* 0.000048828126 (+ -20480.0 (-> arg0 impulse)))))
          (v1-8
            (make-sound-instance (-> *sound-info* (-> this impact-sound)) (new 'static 'sound-id) (the-as handle #f))
            )
          )
      (cond
        (v1-8
          (set! (-> v1-8 volume) (the int (* 1024.0 f30-0)))
          (logior! (-> v1-8 flags) 64)
          (-> v1-8 id)
          )
        (else
          0
          )
        )
      )
    0
    )
  (logior! (-> this root penetrated-by) (penetrate vehicle))
  #t
  (none)
  )

;; definition for method 88 of type vehicle-debris
;; WARN: Return type mismatch int vs none.
(defmethod rigid-body-object-method-88 ((this vehicle-debris))
  (local-vars (v1-8 float))
  (rlet ((acc :class vf)
         (vf0 :class vf)
         (vf1 :class vf)
         (vf2 :class vf)
         )
    (init-vf0-vector)
    (set! (-> this camera-dist) (find-nearest-camera-distance (-> this rbody position)))
    (if (< 901120.0 (-> this camera-dist))
        (go (method-of-object this die))
        )
    (.lvf vf1 (&-> (-> this rbody ang-velocity) quad))
    (.add.w.vf.x vf2 vf0 vf0)
    (.mul.vf vf1 vf1 vf1)
    (.mul.x.vf.x acc vf2 vf1)
    (.add.mul.y.vf.x acc vf2 vf1 acc)
    (.add.mul.z.vf.x vf1 vf2 vf1 acc)
    (.mov v1-8 vf1)
    (let ((f0-2 v1-8))
      (if (< (square 24.0) f0-2)
          (vector-float*! (-> this rbody ang-momentum) (-> this rbody ang-momentum) (/ 24.0 (sqrtf f0-2)))
          )
      )
    (rigid-body-object-method-70 this)
    (rigid-body-control-method-11 (-> this rbody) (the-as collide-shape-moving (-> this root)))
    (rigid-body-object-method-61 this)
    0
    (none)
    )
  )

;; definition for method 71 of type vehicle-debris
;; WARN: Return type mismatch int vs none.
(defmethod rigid-body-object-method-71 ((this vehicle-debris))
