    (init-vf0-vector)
    (set! (-> this callback) joint-mod-blend-local-callback)
    (.svf (&-> (-> this transform) trans quad) vf0)
    (quaternion-identity! (the-as quaternion (-> this transform rot)))
    (vector-identity! (-> this transform scale))
    (set! (-> this blend) 0.0)
    ((method-of-type joint-mod-base init) this arg0 arg1 arg2)
    (none)
    )
  )

;; joint-mod-blend-world-work is transcribed verbatim from
;; decompiler/config/jakx/all-types.gc (marked there "added - I really
;; have no idea what is going on here"): a pure stack scratch struct for
;; joint-mod-blend-world-callback's own matrix math (mat1/mat2/quat/vec),
;; never surfaced through an inspect method and never separately
;; registered at runtime (a plain structure, no type-new call), so this
