;; joint-mod-h.gc) declares the identical four-field struct at the
;; identical use site.
(deftype joint-mod-blend-world-work (structure)
  ((mat1 matrix :inline)
   (mat2 matrix :inline)
   (quat quaternion :inline)
   (vec vector :inline))
   )

