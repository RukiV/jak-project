;; og:preserve-this print-game-text forward-declared here: it is a real
;; function used by talker's own draw-text method, already typed in
;; decompiler/config/jakx/all-types.gc, but goalc resolves externs from
;; goal_src only, never all-types.gc, so the symbol was unresolved at
;; compile time regardless. Its true home file is not yet landed; activate
;; here so this file compiles independently, matching the provisional-
;; extern-hygiene pattern already used at hud-oneoff.gc and part-tester.gc.
;; Retire this declaration once print-game-text's owning file lands for real.
(define-extern print-game-text (function string font-context symbol int bucket-id float))

;; og:preserve-this auto-save-user forward-declared here: it is a real
;; zero-arg function used by talker's own active state (enter and exit both
;; call it), already typed in decompiler/config/jakx/all-types.gc, but
;; goalc resolves externs from goal_src only, never all-types.gc, so the
;; symbol was unresolved at compile time regardless. Its true home is
;; game-save.gc, still a stub in this tree; a call that actually reaches
;; this on a live path still links as zero until game-save.gc lands.
;; Retire this declaration once game-save.gc lands for real.
(declare-type auto-save process)
(define-extern auto-save-user (function (pointer auto-save)))

