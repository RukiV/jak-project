;; og:preserve-this the decompiler cannot fold *game-info*'s own raw offset-
;; 1168 read into (-> *game-info* talker-state idx): that raw offset lands
;; on game-info's own unnamed game-info-pad2 slot (declared plain int32,
;; offset-assert 1168 plus the +4 basics convention), the identical lazily-
;; allocated (array uint16 936) pointer game-info.gc's own initialize! reads
;; through (-> this game-info-pad2) cast to (pointer int16) with a manual
;; +6-index header adjustment (that file's own og:preserve-this note, R8).
;; Every talker-speech-class method below reuses the same idiom rather than
;; declaring a second field at the same offset; index math (speech * 2, +1
;; for the neg half, +6/+7 to land past the array's own 12-byte header)
;; matches jak3's own (-> *game-info* talker-state idx) accesses op for op,
;; confirmed against this rung's own ambient_ir2.asm (methods 9-13 of
;; talker-speech-class all compute the identical byte offsets before the
;; decompiler's own fold gives up at the raw offset-1168 load).
(defmethod should-play? ((this talker-speech-class))
  "Return if the talker is in a state where it should play."
  (let ((holder (the-as (pointer uint16) (-> *game-info* game-info-pad2))))
    (and (>= (-> holder (+ (* (-> this speech) 2) 6)) (-> this pos))
         (>= (-> this neg) (-> holder (+ (* (-> this speech) 2) 7)))
         )
    )
  )

(defmethod mark-played! ((this talker-speech-class))
  "Mark something as played by making its state UINT16_MAX"
  (let ((holder (the-as (pointer uint16) (-> *game-info* game-info-pad2))))
    (set! (-> holder (+ (* (-> this speech) 2) 7)) (the-as uint #xffff))
    )
  0
  (none)
  )

(defmethod reset-state! ((this talker-speech-class))
  "Reset the state of this talker to 0 (the initial value)"
  (let ((holder (the-as (pointer uint16) (-> *game-info* game-info-pad2))))
    (set! (-> holder (+ (* (-> this speech) 2) 7)) (the-as uint 0))
    )
  0
  (none)
  )

(defmethod yes-play! ((this talker-speech-class) (arg0 int))
  (let ((holder (the-as (pointer uint16) (-> *game-info* game-info-pad2))))
    (if (>= arg0 0)
        (set! (-> holder (+ (* (-> this speech) 2) 6))
              (the-as uint (seekl (the-as int (-> holder (+ (* (-> this speech) 2) 6))) #xfff0 arg0))
              )
        (set! (-> holder (+ (* (-> this speech) 2) 6))
              (the-as uint (seekl (the-as int (-> holder (+ (* (-> this speech) 2) 6))) 0 (- arg0)))
              )
        )
    )
  (if (should-play? this)
      (talker-spawn-func this *entity-pool* (target-pos 0) (the-as region #f))
      )
  0
  (none)
  )

(defmethod no-play! ((this talker-speech-class) (arg0 int))
  (let ((holder (the-as (pointer uint16) (-> *game-info* game-info-pad2))))
    (if (>= arg0 0)
        (set! (-> holder (+ (* (-> this speech) 2) 7))
              (the-as uint (seekl (the-as int (-> holder (+ (* (-> this speech) 2) 7))) #xfff0 arg0))
              )
        (set! (-> holder (+ (* (-> this speech) 2) 7))
              (the-as uint (seekl (the-as int (-> holder (+ (* (-> this speech) 2) 7))) 0 (- arg0)))
              )
        )
    )
  0
  (none)
  )

