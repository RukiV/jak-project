;; WARN: Return type mismatch int vs none.
;; og:preserve-this runtime-link guard, LIVE (scene chain, issue 522):
;; kill-current-talker's own body unconditionally calls gui-
;; control-method-16 on *gui-control*, which used to have no landed
;; instantiation anywhere in goal_src, only the forward (define-extern
;; *gui-control* gui-control) declaration; this was confirmed as the R10
;; boot crash, since game-info.gc's own initialize! calls
;; (kill-current-talker '() '() 'die) unconditionally on every boot
;; (guarded only on kill-current-talker itself being landed, R3a's own
;; guard above), and kill-current-talker's first (member 'daxter '())
;; check is false, so its first gui-control-method-16 call ran with
;; *gui-control* still 0; the method dispatch's own [a0 - 4] type read then
;; faulted (ambient.gc's own (mi) (asm-file "ambient.gc" :color :disassemble
;; <out>) showed this exact instruction, "mov eax, [r15+rdi*1-0x04]", inside
;; kill-current-talker, rdi holding '*gui-control*; the crash report's own
;; register dump matched every argument value of that first call: rsi=4,
;; rdx=1, rcx=0x14=20, r8=0, r9/r10/r11/r14=#f). The scene-chain rung
;; (issue 522) attempted to land *gui-control*'s own owning define in
;; loader.gc and pulled it back after an empirical red: with the define
;; live, this exact first call's own DISPATCH jumped to goal 0 (an empty
;; slot read, the same argument values in the registers, rbp holding the
;; loaded 0), a different crash one level past the one this guard covers;
;; see loader.gc's own held-define note for the full evidence. So this
;; guard stays LIVE and load-bearing: it retires only when the define
;; lands for real (methods 19 and 25 plus the slot probe named there).
;; Same class as *common-text*'s own guard (text-h.gc:54 defines it
;; (the-as game-text-info #f), main.gc:299 and in-game-menu-hud.gc:76 both
;; check (not *common-text*) before use) and this file's own kill-current-
;; talker/task-node-reset/reset-actors guards just above and below;
;; nonzero? rather than a truthy check, matching those three, since an
;; unset extern's raw value is not guaranteed to be the #f singleton.
(defun kill-current-talker ((arg0 pair) (arg1 pair) (arg2 symbol))
  (when (nonzero? *gui-control*)
    (if (not (member 'daxter arg1))
        (gui-control-method-16
          *gui-control*
          4
          (the-as uint 1)
          20
          0
          (the-as string #f)
          (the-as (function gui-connection symbol) #f)
          (the-as process #f)
          )
        )
    (if (not (member 'pecker arg1))
        (gui-control-method-16
          *gui-control*
          4
          (the-as uint 1)
          25
          0
          (the-as string #f)
          (the-as (function gui-connection symbol) #f)
          (the-as process #f)
          )
        )
    (if (not (member 'speech arg1))
        (gui-control-method-16
          *gui-control*
          4
          (the-as uint 1)
          29
          0
          (the-as string #f)
          (the-as (function gui-connection symbol) #f)
          (the-as process #f)
          )
        )
    (if (not (member 'message arg1))
        (gui-control-method-16
          *gui-control*
          4
          (the-as uint 1)
          67
          0
          (the-as string #f)
          (the-as (function gui-connection symbol) #f)
          (the-as process #f)
          )
        )
    (when (not (member 'notice arg1))
      (gui-control-method-16
        *gui-control*
        4
        (the-as uint 1)
        68
        0
        (the-as string #f)
        (the-as (function gui-connection symbol) #f)
        (the-as process #f)
        )
      (gui-control-method-16
        *gui-control*
        4
        (the-as uint 1)
        71
        0
        (the-as string #f)
        (the-as (function gui-connection symbol) #f)
        (the-as process #f)
