;;-*-Lisp-*-
(in-package goal)

;; name: loader.gc
;; name in dgo: loader
;; dgos: ENGINE, GAME

;; +++loader:spooler-flags
(defenum spooler-flags
  :bitfield #t
  :type uint32
  (blackout-on-stall)
  )
;; ---loader:spooler-flags

;; DECOMP BEGINS

;; og:note the art slice of loader.o lands here (the load-dir mem-usage,
;; lookup and record methods, the art-group master link pair and the art load
;; helpers) plus gui-control methods 9 and 16, its two dispatched slots
;; (add-process and set-action!, four call sites total: cam-states.gc,
;; generic-obs.gc, hud-classes.gc, net-hud.gc), plus the spooler-block type
;; PR 417's ja-play-spooled-anim extern activation let the decompiler
;; recognize (a clean decode on its own, offset-asserts matching
;; all-types.gc exactly). ja-play-spooled-anim's own body decodes too now
;; but does not compile (its own constructor is missing from this object's
;; decode; see the preservation note above its held, commented-out text)
;; and stays a block comment rather than a live landing. The rest of
;; gui-control and the external-art-control/buffer machinery stay parked:
;; their decomp still carries CFG and type-prop errors. ja-play-spooled-no-
;; sync-anim (both overloads) and ja-abort-spooled-anim remain fully
;; blocked ("function has no type analysis. Cannot decompile.").

;; og:preserve-this gui-control carries the full reconstructed field layout,
;; matching all-types, gui-h.gc and cam-states.gc (each file that dispatches
;; a method on it redeclares it locally rather than requiring one another,
;; matching the existing gui-h.gc/cam-states.gc precedent) so the
;; JakXTypeConsistency gate agrees. Method 16's sixth arg was declared
;; plain basic here and in all-types and gui-h.gc until this rung retyped it
;; to (function gui-connection symbol): the raw decode calls it directly at
;; op 51 of method 16's body (jalr through a value read straight from the
;; arg register), and casting it to basic left an unresolved "Called
;; something that was not a function: basic" failure; every other call site
;; passing a real basic there was never possible, only (the-as ... #f)
;; literals (cam-states.gc's slow-mo gui-control-method-16 call), so the
;; retype is a pure signature widening.
(deftype gui-control (basic)
  ((engine             engine)
   (update-time        time-frame)
   (connections        gui-connection  32  :inline)
   (spool-connections  gui-connection  4   :inline)
   (ids                sound-id        112)
   (times              time-frame      112)
   (cmd                pair            112)
   (group              uint8           112)
   )
  (:methods
    (new (symbol type) _type_)
    (gui-control-method-9 (_type_ process int int string float int) uint) ;; add-request
    (gui-control-method-10 () none)
    (gui-control-method-11 (_type_ gui-connection) none)
    (gui-control-method-12 (_type_ process gui-channel gui-action string int float sound-id) sound-id)
    (gui-control-method-13 () none)
    (gui-control-method-14 (_type_ string object object) none)
    (gui-control-method-15 (_type_ object object string) none)
    (gui-control-method-16 (_type_ int uint int int string (function gui-connection symbol) process) int) ;; set-action!
    (gui-control-method-17 (_type_ uint) uint) ;; get-status
    (gui-control-method-18 () none)
    (gui-control-method-19 () none)
    (gui-control-method-20 (_type_ uint symbol int int int float) object) ;; sound-params-set!
    (gui-control-method-21 () none)
    (gui-control-method-22 () none)
    (gui-control-method-23 () none)
    (gui-control-method-24 () none)
    (gui-control-method-25 (_type_ gui-connection object) none)
    )
  )
(define-extern *gui-control* gui-control)

;; og:preserve-this add-process: clean decode, no config edits needed on the
;; body itself (the connectable-list-walk-as-connection idiom needed
;; type_casts.jsonc entries to resolve, not a source-level change). Searches
;; the engine's alive-list for a live gui-connection matching channel and
;; name owned by arg0; on a miss, reuses a free-standing slot with a
;; matching channel/name/priority sentinel out of this's own connections
;; array, or mints a new-sound-id, then calls engine's own add-connection.
(defmethod gui-control-method-9 ((this gui-control) (arg0 process) (arg1 int) (arg2 int) (arg3 string) (arg4 float) (arg5 int))
  (let ((sv-32 (the-as connectable #f)))
    (let ((sv-48 (-> this engine alive-list next0)))
      (-> this engine)
      (let ((sv-64 (-> sv-48 next0)))
        (while (!= sv-48 (-> this engine alive-list-end))
          (when (the-as
                  gui-connection
                  (and (= arg1 (the-as gui-connection (-> (the-as gui-connection sv-48) channel)))
                       (string= arg3 (-> (the-as gui-connection sv-48) name))
                       (the-as gui-connection (= ((method-of-type gui-connection get-process) (the-as connection sv-48)) arg0))
                       )
                  )
            (set! sv-32 sv-48)
            (goto cfg-12)
            )
          (set! sv-48 sv-64)
          (-> this engine)
          (set! sv-64 (-> sv-64 next0))
          )
        )
      )
    (label cfg-12)
    (when (not sv-32)
      (let ((sv-16 0))
        (let ((sv-80 32))
          (while (nonzero? sv-80)
            (+! sv-80 -1)
            (let ((sv-20 (-> this connections sv-80)))
              (if (and (nonzero? (-> sv-20 id))
                       (= arg1 (-> sv-20 channel))
                       (string= arg3 (-> sv-20 name))
                       (>= (-> sv-20 priority) -1.0)
                       )
                  (set! sv-16 (the-as int (-> sv-20 id)))
                  )
              )
            )
          )
        (if (zero? sv-16)
            (set! sv-16 (the-as int (new-sound-id)))
            )
        (set! sv-32 (add-connection (-> this engine) arg0 arg4 0 arg3 sv-16))
        )
      (the-as gui-connection (the-as connection sv-32))
      )
    (the-as
      uint
      (cond
        ((the-as gui-connection sv-32)
         (set! (-> (the-as gui-connection sv-32) priority) arg4)
         (set! (-> (the-as gui-connection sv-32) channel) (the-as gui-channel arg1))
         (set! (-> (the-as gui-connection sv-32) action) (the-as gui-action arg2))
         (set! (-> (the-as gui-connection sv-32) param2) (the-as int arg3))
         (set! (-> (the-as gui-connection sv-32) hold-time) (the-as time-frame arg5))
         (set! (-> (the-as gui-connection sv-32) flags) (the-as gui-connection-flags (the-as gui-connection 1)))
         (set! (-> (the-as gui-connection sv-32) fade) (the-as uint 0))
         (the-as int (-> (the-as gui-connection sv-32) id))
         )
        (else
          (format 0 "ERROR: could not connection ~A to gui engine.~%" arg0)
          0
          )
        )
      )
    )
  )

;; og:preserve-this set-action!: clean decode once the arg5 callback retype
;; above landed (see the deftype note); the body itself needed no further
;; config work. Walks the alive-list applying arg0 (the new gui-action) to
;; every live gui-connection matching id/channel/action/name/predicate
;; (arg5)/owner (arg6), with special-cased hide-on-mismatched-id and
;; already-playing-is-a-noop branches, and kicks method 25 (channel-id-set!)
;; when the new action is 'play and method 19 gates it open.
(defmethod gui-control-method-16 ((this gui-control)
                                 (arg0 int)
                                 (arg1 uint)
                                 (arg2 int)
                                 (arg3 int)
                                 (arg4 string)
                                 (arg5 (function gui-connection symbol))
                                 (arg6 process)
                                 )
  (let ((sv-16 arg0)
        (sv-17 arg3)
        (sv-20 arg4)
        )
    (let ((sv-24 arg5))
      )
    (let ((s1-0 (-> this engine alive-list next0)))
      (-> this engine)
      (let ((s0-0 (-> s1-0 next0)))
        (while (!= s1-0 (-> this engine alive-list-end))
          (when (and (or (= arg1 1) (= arg1 (-> (the-as gui-connection s1-0) id)))
                     (or (zero? arg2) (= arg2 (-> (the-as gui-connection s1-0) channel)))
                     (or (zero? sv-17) (= sv-17 (-> (the-as gui-connection s1-0) action)))
                     (or (not sv-20) (string= sv-20 (-> (the-as gui-connection s1-0) name)))
                     (or (not arg5) (arg5 (the-as gui-connection s1-0)))
                     (or (not arg6) (= arg6 (get-process (the-as gui-connection s1-0))))
                     )
            (cond
              ((and (= sv-16 7)
                    (!= (-> this ids (-> (the-as gui-connection s1-0) channel)) (-> (the-as gui-connection s1-0) id))
                    )
               (set! (-> (the-as gui-connection s1-0) action) (gui-action hidden))
               )
              ((and (= sv-16 2) (= (-> (the-as gui-connection s1-0) action) (gui-action playing)))
               )
              (else
                (set! (-> (the-as gui-connection s1-0) action) (the-as gui-action sv-16))
                (if (and (= sv-16 'play) (let ((t9-3 (method-of-object this gui-control-method-19)))
                                           (-> (the-as gui-connection s1-0) channel)
                                           (t9-3)
                                           )
                         )
                    (gui-control-method-25 this (the-as gui-connection s1-0) (-> (the-as gui-connection s1-0) id))
                    )
                )
              )
            )
          (set! s1-0 s0-0)
          (-> this engine)
          (set! s0-0 (-> s0-0 next0))
          )
        )
      )
    )
  0
  )

;; WARN: Return type mismatch symbol vs load-dir.
(defmethod mem-usage ((this load-dir) (usage memory-usage-block) (flags int))
  (set! (-> usage length) (max 85 (-> usage length)))
  (set! (-> usage data 84 name) "array")
  (+! (-> usage data 84 count) 1)
  (let ((v1-6 (asize-of this)))
    (+! (-> usage data 84 used) v1-6)
    (+! (-> usage data 84 total) (logand -16 (+ v1-6 15)))
    )
  (set! (-> usage length) (max 85 (-> usage length)))
  (set! (-> usage data 84 name) "array")
  (set! (-> usage data 84 count) (-> usage data 84 count))
  (let ((v1-15 (asize-of (-> this string-array))))
    (+! (-> usage data 84 used) v1-15)
    (+! (-> usage data 84 total) (logand -16 (+ v1-15 15)))
    )
  (set! (-> usage length) (max 85 (-> usage length)))
  (set! (-> usage data 84 name) "array")
  (set! (-> usage data 84 count) (-> usage data 84 count))
  (let ((v1-24 (asize-of (-> this data-array))))
    (+! (-> usage data 84 used) v1-24)
    (+! (-> usage data 84 total) (logand -16 (+ v1-24 15)))
    )
  (dotimes (s3-0 (-> this data-array length))
    (mem-usage (-> this data-array s3-0) usage flags)
    )
  (the-as load-dir #f)
  )

(defmethod mem-usage ((this subtitle-range) (usage memory-usage-block) (flags int))
  (set! (-> usage length) (max 73 (-> usage length)))
  (set! (-> usage data 72 name) "subtitle")
  (+! (-> usage data 72 count) 1)
  (let ((v1-6 (asize-of this)))
    (+! (-> usage data 72 used) v1-6)
    (+! (-> usage data 72 total) (logand -16 (+ v1-6 15)))
    )
  this
  )

(defmethod unlink-art-to-master ((this art-group))
  (when this
    (countdown (s5-0 (-> this length))
      (let ((s4-0 (as-type (-> this data s5-0) art-element))
            (s3-1 #f)
            )
        (when s4-0
          (let ((s2-0 19))
            (while (begin (label cfg-13) (nonzero? s2-0))
              (+! s2-0 -1)
              (let ((v1-8 (get-art-group-by-name (-> *level* level s2-0) (-> s4-0 master-art-group-name))))
                (when v1-8
                  (countdown (a0-5 (-> v1-8 length))
                    (when (= s4-0 (-> v1-8 data a0-5))
                      (set! (-> v1-8 data a0-5) #f)
                      (set! s3-1 #t)
                      (goto cfg-13)
                      )
                    )
                  )
                )
              )
            )
          (if (not s3-1)
              (format 0 "ERROR: ~A could not find a master slot to unlink for ~A.~%" (-> this name) s4-0)
              )
          )
        )
      )
    )
  0
  )

(defmethod link-art-to-master ((this art-group))
  (when this
    (countdown (s5-0 (-> this length))
      (let ((s4-0 (as-type (-> this data s5-0) art-element))
            (s2-0 #f)
            )
        (when s4-0
          (let ((s3-1 19))
            (while (begin (label cfg-24) (nonzero? s3-1))
              (+! s3-1 -1)
              (let ((v1-8 (get-art-group-by-name (-> *level* level s3-1) (-> s4-0 master-art-group-name))))
                (when v1-8
                  (countdown (a0-5 (-> v1-8 length))
                    (if (= (-> v1-8 data a0-5) s4-0)
                        (goto cfg-24)
                        )
                    )
                  (cond
                    ((and (< (-> s4-0 master-art-group-index) (-> v1-8 length))
                          (not (-> v1-8 data (-> s4-0 master-art-group-index)))
                          )
                     (set! (-> v1-8 data (-> s4-0 master-art-group-index)) s4-0)
                     (set! s2-0 #t)
                     )
                    (else
                      (countdown (a0-17 (-> v1-8 length))
                        (when (not (-> v1-8 data a0-17))
                          (set! (-> v1-8 data a0-17) s4-0)
                          (set! s2-0 #t)
                          (goto cfg-24)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          (if (not s2-0)
              (format 0 "ERROR: ~A could not find a master slot to link for ~A.~%" (-> this name) s4-0)
              )
          )
        )
      )
    )
  this
  )

(defun art-group-load-check ((arg0 string) (arg1 kheap) (arg2 int))
  ;; og:preserve-this
  ; (local-vars (sp-0 pointer))
  (when *debug-segment*
    ; (the-as none sp-0)
    ; (if (< (the-as uint sp-0) (the-as uint *stack-top*))
    ;     (set! sp-0 (&+ *kernel-sp* -1024))
    ;     )
    (let ((s3-1 (the-as art-group (loado (make-file-name (file-kind art-group) arg0 arg2 #f) arg1))))
      (cond
        ((not s3-1)
         (format 0 "ERROR: art-group ~A is not a valid file.~%" arg0)
         (the-as art-group #f)
         )
        ((not (type? s3-1 art-group))
         (format 0 "ERROR: art-group ~A is not a art-group.~%" arg0)
         (the-as art-group #f)
         )
        ((not (file-info-correct-version? (-> s3-1 info) (file-kind art-group) arg2))
         (the-as art-group #f)
         )
        (else
          (login s3-1)
          )
        )
      )
    )
  )

(defun art-load ((arg0 string) (arg1 kheap))
  ;; og:preserve-this
  ; (local-vars (sp-0 pointer))
  ; (the-as none sp-0)
  ; (if (< (the-as uint sp-0) (the-as uint *stack-top*))
  ;     (set! sp-0 (&+ *kernel-sp* -1024))
  ;     )
  (let ((s5-0 (the-as art (loado arg0 arg1))))
    (if (type? s5-0 art)
        (login s5-0)
        (the-as art #f)
        )
    )
  )

(defun drawable-load ((arg0 drawable) (arg1 kheap))
  ;; og:preserve-this
  ; (local-vars (sp-0 pointer))
  (cond
    ((type? arg0 string)
     ; (the-as none sp-0)
     ; (if (< (the-as uint sp-0) (the-as uint *stack-top*))
     ;     (set! sp-0 (&+ *kernel-sp* -1024))
     ;     )
     (let ((s5-1 (the-as drawable (loado (the-as string arg0) arg1))))
       (if (and s5-1 (type? s5-1 drawable))
           (login s5-1)
           )
       )
     )
    ((type? arg0 drawable)
     (login arg0)
     )
    )
  )

(defmethod set-loaded-art ((this load-dir-art-group) (arg0 art-group))
  (let ((s4-0 (-> this string-array)))
    (dotimes (s3-0 (-> s4-0 length))
      (when (string= (-> arg0 name) (-> s4-0 s3-0))
        (set! (-> this art-group-array s3-0) arg0)
        (set! arg0 (-> this art-group-array s3-0))
        (goto cfg-7)
        )
      )
    (set! (-> s4-0 (-> s4-0 length)) (-> arg0 name))
    (set! (-> this art-group-array (-> s4-0 length)) arg0)
    (+! (-> s4-0 length) 1)
    )
  (+! (-> this art-group-array length) 1)
  (label cfg-7)
  arg0
  )

(defmethod load-to-heap-by-name ((this load-dir-art-group) (arg0 string) (arg1 symbol) (arg2 kheap) (arg3 int))
  (let ((s5-0 (-> this string-array)))
    (dotimes (s3-0 (-> s5-0 length))
      (when (string= arg0 (-> s5-0 s3-0))
        (when (= arg1 'reload)
          (let ((v1-5 (art-group-load-check arg0 arg2 arg3)))
            (if v1-5
                (set! (-> this art-group-array s3-0) v1-5)
                )
            )
          )
        (return (-> this art-group-array s3-0))
        )
      )
    (when (= arg1 'load)
      (let ((v0-2 (art-group-load-check arg0 arg2 arg3)))
        (when v0-2
          (set! (-> s5-0 (-> s5-0 length)) arg0)
          (set! (-> this art-group-array (-> s5-0 length)) v0-2)
          (+! (-> s5-0 length) 1)
          (+! (-> this art-group-array length) 1)
          )
        v0-2
        )
      )
    )
  )

;; definition of type spooler-block
(deftype spooler-block (basic)
  ((anim              spool-anim)
   (idle              art-joint-anim)
   (exit              art-joint-anim)
   (break-func        (function process-drawable object))
   (flags             spooler-flags)
   (part              int32)
   (part-audio-start  float)
   (old-status        uint16)
   (old-pos           int32)
   (good-time         uint64)
   (old-time          uint64)
   (good-count        int32)
   (sid               sound-id)
   (start-time        uint64)
   (paused?           symbol)
   (frame-count       int32)
   (frame-count2      float)
   (next-frame-fmv    basic)
   )
  )

;; og:preserve-this spooler-block: landed as a compile prerequisite for
;; ja-play-spooled-anim below, which allocates and reads/writes one; its
;; own decode is clean and matches all-types.gc's offset-asserted field
;; layout exactly (no :methods block in either file: spooler-block never
;; overrides new). Its inspect method (REF, method 3) stays parked:
;; nothing here calls it, and it is out of this rung's scope.

;; og:preserve-this ja-play-spooled-anim: held in a block comment, matching
;; the cam-debug.gc cam-line-dma precedent for a function that does not
;; compile as decoded. Text below is this worktree's own decode, verbatim,
;; not cleaned up: a single unresolved load at op 43 ("Could not figure out
;; load: (set! a0 (l.wu (+ v1 28)))", reading a field off the spooler-block
;; this behavior just allocated) fails type prop and drags every downstream
;; register to the none type, so the body is raw l.wu/s.w!/s.f!/s.d!/s.h!
;; pointer arithmetic rather than proper field accesses.
;;
;; It also does not compile, for a second and harder reason: retyping
;; t9-0's local-var declaration to match what (method-of-type v1-0 new)
;; actually resolves to on a generically-typed `type` value clears the
;; first type error, but the very next line, (new 'stack-no-clear
;; 'spooler-block), then fails with "Cannot stack allocate with no
;; constructor for a spooler-block": spooler-block extends basic (unlike
;; the structure-typed stack-no-clear precedents elsewhere in this tree,
;; e.g. joint-exploder.gc's bounding-box and collide-query), so retail's
;; version of this call needed a real (defmethod new spooler-block ...),
;; and that method's body is not present anywhere in loader.o's decode
;; (searched the full disasm for "method 0 of type spooler-block" and
;; "new spooler-block": no hits). Retiring this note needs that
;; constructor found and decoded first, wherever its bytes live, not a
;; local type-annotation fix; inventing one here would not be transcribing
;; the decode, it would be guessing at unseen retail code.
;;
;; Also worth naming for whoever eventually lands this for real: partway
;; through, the body dispatches gui-control-method-15 by vtable lookup
;; (method-of-type on *gui-control*'s own type), and no defmethod for
;; method 15 is landed anywhere in this tree yet (it is still in the
;; og:note's parked list above); reaching that branch before method 15
;; lands would be a jump through an unfilled slot.
#|
;; definition for function ja-play-spooled-anim
