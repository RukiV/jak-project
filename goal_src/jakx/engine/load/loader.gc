;;-*-Lisp-*-
(in-package goal)

;; name: loader.gc
;; name in dgo: loader
;; dgos: ENGINE, GAME

;; +++loader:spooler-flags
(defenum spooler-flags
  :bitfield #t
  :type uint32
  (blackout-on-stall)
  )
;; ---loader:spooler-flags

;; og:preserve-this ja-play-spooled-no-sync-anim and ja-play-spooled-anim:
;; scene lane (issue 502). Both declared with the identical five-arg
;; signature (spool-anim, two art-joint-anim, a (function process-
;; drawable symbol), spooler-flags, returning int), evidenced by
;; scene.gc's own (code play-anim scene-player) call sites for each: the
;; same arg-source shape (the anim field, #f, #f, a lambda or false-func,
;; an int 0/1 built from a scene-flags bit test) as every other call in
;; this tree. ja-play-spooled-anim's own extern below was already active
;; in this file's all-types.gc twin (not a provisional guess, unlike
;; ja-play-spooled-no-sync-anim's own commented-out all-types.gc entry
;; before this rung activated it); goal_src carried no define-extern for
;; either until now. Neither this function, ja-play-spooled-anim, nor
;; ja-abort-spooled-anim (loader-h.gc) has a landed defbehavior body
;; anywhere in this tree (this file's own og:preserve-this note on ja-
;; play-spooled-anim below names all three as fully blocked, "function
;; has no type analysis"); each is an e2-class provisional extern. ja-
;; play-spooled-no-sync-anim's own call site is gated behind
;; *record-fma*; ja-play-spooled-anim's is the state's default (non-
;; *record-fma*) branch, so it is exercised on a normal scene playback,
;; same as the whole rest of this activation cluster.
(define-extern ja-play-spooled-no-sync-anim (function spool-anim art-joint-anim art-joint-anim (function process-drawable symbol) spooler-flags int :behavior process-drawable))
(define-extern ja-play-spooled-anim (function spool-anim art-joint-anim art-joint-anim (function process-drawable symbol) spooler-flags int :behavior process-drawable))

;; og:preserve-this target-nearest-dist, scene chain (issue 522): the
;; defun itself lands in target.gc; this file calls it from three sites
;; (gui-control-method-12 twice, external-art-control's spool-push once)
;; and needs its own forward declaration to compile, matching this
;; file's existing ja-play-spooled-anim precedent above.
(define-extern target-nearest-dist (function vector float))

