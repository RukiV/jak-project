    (set! (-> gp-0 cmd 96) '((64 . wait) (65 . wait) (96 . wait)))
    (set! (-> gp-0 cmd 97) '((64 . wait) (65 . wait) (97 . wait)))
    (set! (-> gp-0 cmd 98) '((64 . wait) (65 . wait) (98 . wait)))
