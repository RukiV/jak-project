;; Landed from external-art-control: file-status, update (method 9, this
;; rung), none-reserved?, reserve-alloc, reserve-free (dispatches external-
;; art-buffer's own update above, now landed, not an unfilled method-of-
;; object dispatch any more), clear-rec and spool-push (method 11, this
;; rung): none held.
(defmethod print ((this external-art-buffer))
  (format
    #t
    "#<~A ~S ~D ~A @ #x~X>"
    (-> this type)
    (-> this pending-load-file)
    (-> this pending-load-file-part)
    (-> this status)
    this
    )
  this
  )

(defun external-art-buffer-init ((arg0 external-art-buffer))
  (let ((v1-0 (-> arg0 heap)))
    (set! (-> v1-0 base) (the-as pointer (+ #x84000 (* #x5a000 (-> arg0 index)))))
    (set! (-> v1-0 current) (-> v1-0 base))
    (set! (-> v1-0 top-base) (&+ (-> v1-0 base) #x5a000))
    (set! (-> v1-0 top) (-> v1-0 top-base))
    )
  0
  )

(defmethod set-pending-file ((this external-art-buffer) (arg0 string) (arg1 int) (arg2 handle) (arg3 float))
  (set! (-> this pending-load-file) arg0)
  (set! (-> this pending-load-file-part) arg1)
  (set! (-> this pending-load-file-owner) arg2)
  (set! (-> this pending-load-file-priority) arg3)
  0
  )

(defmethod unlock! ((this external-art-buffer))
  (set! (-> this locked?) #f)
  0
  )

(defmethod inactive? ((this external-art-buffer))
  (!= (-> this status) 'active)
  )

(defmethod file-status ((this external-art-buffer) (arg0 string) (arg1 int))
  (when (and (name= (-> this pending-load-file) arg0) (= (-> this pending-load-file-part) arg1))
    (if (and (name= (-> this load-file) arg0) (= (-> this load-file-part) arg1))
        (-> this status)
        'pending
        )
    )
  )

(defmethod link-file ((this external-art-buffer) (arg0 art-group))
  (when arg0
    (link-art-to-master arg0)
    (set! (-> this art-group) arg0)
    )
  arg0
  )

(defmethod unlink-file ((this external-art-buffer) (arg0 art-group))
  (when arg0
    (unlink-art-to-master arg0)
    (set! (-> this art-group) #f)
    )
  0
  )

;; og:preserve-this update (method 10), text-record-wall rung's own note:
;; the prior hold's stated blocker is gone. Op 205 was the kernel's own
;; link call, and giving `link` its real signature in all-types.gc (from
;; game/kernel/jak3/klink.cpp's link_and_exec_wrapper, five args) resolved
;; it; both sllv errors were downstream of that failed type prop and went
;; with it. Landed here (gui-art pump lane, issue 550/551) because
;; external-art-control's own reserve-free (below) already dispatches it
;; unguarded on the level-unload path once (-> this reserve-buffer) is
;; truthy (issue 551 item 3's own live landmine); leaving it unlanded left
;; that call site reading an empty vtable slot. Drives the buffer's own
;; pending/load-file state machine through str-load/str-load-cancel/
;; str-load-status and the art-group login/link machinery; the "Found some
;; very strange gotos" WARN is decompiler noise over the retry loop
;; (label cfg-18), not a defect.
(defmethod update ((this external-art-buffer))
  (local-vars (v1-47 symbol))
  (when (or (not (name= (-> this pending-load-file) (-> this load-file)))
            (!= (-> this pending-load-file-part) (-> this load-file-part))
            )
    (when (not (handle->process (-> this pending-load-file-owner)))
      (set! (-> this pending-load-file) #f)
      (set! (-> this pending-load-file-part) -1)
      (set! (-> this pending-load-file-owner) (the-as handle #f))
      (set! (-> this pending-load-file-priority) 100000000.0)
      )
    (when (= (-> this status) 'initialize)
      ((-> this init-heap) this)
      (set! (-> this status) 'inactive)
      )
    (cond
      ((-> this load-file)
       (if (= (-> this status) 'loading)
           (str-load-cancel)
           )
       (set! (-> this load-file) #f)
       (set! (-> this load-file-part) -1)
       (set! (-> this load-file-owner) (the-as handle #f))
       (set! (-> this load-file-priority) 100000000.0)
       )
      (else
        (set! (-> this load-file) (-> this pending-load-file))
        (set! (-> this load-file-part) (-> this pending-load-file-part))
        (set! (-> this load-file-owner) (-> this pending-load-file-owner))
        (set! (-> this load-file-priority) (-> this pending-load-file-priority))
        )
      )
    )
  (label cfg-18)
  (cond
    ((-> this load-file)
     (case (-> this status)
       (('active 'reserved)
        )
       (('error)
        (set! (-> this status) 'inactive)
        (set! (-> this load-file) #f)
        (set! (-> this load-file-part) -1)
        (set! (-> this load-file-owner) (the-as handle #f))
        (set! (-> this load-file-priority) 100000000.0)
        (set! (-> this pending-load-file) #f)
        (set! (-> this pending-load-file-part) -1)
        (set! (-> this pending-load-file-owner) (the-as handle #f))
        (set! (-> this pending-load-file-priority) 100000000.0)
        (set! (-> this art-group) #f)
        )
       (('inactive)
        (let ((v1-31 (-> this heap)))
          (set! (-> v1-31 current) (-> v1-31 base))
          )
        (cond
          ((string= (-> this load-file) "reserved")
           (cond
             ((-> *art-control* reserve-buffer)
              (format 0 "ERROR: trying double reserve ~A when ~A is reserved~%" this (-> *art-control* reserve-buffer))
              )
             (else
               (set! (-> this status) 'reserved)
               (set! (-> *art-control* reserve-buffer) this)
               )
             )
           )
          ((and (!= (-> *level* loading-level) (-> *level* level-default))
                (or (< 81920.0 (-> this load-file-priority))
                    (logtest? (-> *level* loading-level info level-flags) (level-flags external))
                    )
                )
           )
          ((begin
             (let ((v1-46 (logand -64 (&+ (-> this heap current) 63))))
               (set! v1-47
                     (when (str-load (-> this load-file) (-> this load-file-part) v1-46 (&- (-> this heap top) (the-as uint v1-46)))
                       (set! v1-47 'loading)
                       (set! (-> this status) v1-47)
                       v1-47
                       )
                     )
               )
             v1-47
             )
           0
           )
          )
        )
       (('loading)
        (case (str-load-status (&-> this len))
          (('error)
           (set! (-> this status) 'error)
           )
          (('busy)
           )
          (else
            (set! (-> this buf) (logand -64 (&+ (-> this heap current) 63)))
            (set! (-> this status) 'loaded)
            (goto cfg-18)
            )
          )
        )
       (('loaded)
        (let ((a0-39 (-> this buf)))
          (cond
            ((-> this login?)
             (set! (-> this art-group)
                   (the-as art-group (link a0-39 (-> this load-file data) (-> this len) (-> this heap) (if *print-login*
                                                                                                             8
                                                                                                             0
                                                                                                             )
                                           )
                           )
                   )
             (let ((s3-0 (-> this art-group))
                   (s4-0 (-> this load-file))
                   )
               (cond
                 ((not s3-0)
                  (format 0 "ERROR: art-group ~A part ~D is not a valid file.~%" s4-0 (-> this load-file-part))
                  (set! (-> this status) 'error)
                  )
                 ((not (type? s3-0 art-group))
                  (format 0 "ERROR: art-group ~A part ~D is not a art-group.~%" s4-0 (-> this load-file-part))
                  (set! (-> this status) 'error)
                  )
                 ((not (file-info-correct-version? (-> s3-0 info) (file-kind art-group) 0))
                  (set! (-> this status) 'error)
                  )
                 (else
                   (login s3-0)
                   (set! (-> this status) 'locked)
                   )
                 )
               )
             )
            (else
              (set! (-> this status) 'locked)
              (set! (-> this art-group) (the-as art-group a0-39))
              )
            )
          )
        )
       (('locked)
        (when (and (not (-> this locked?)) (handle->process (-> this load-file-owner)))
          (if (-> this login?)
              (link-file this (-> this art-group))
              )
          (if (-> this other)
              (set! (-> this other locked?) #t)
              )
          (set! (-> this status) 'active)
          (goto cfg-18)
          )
        )
       )
     )
    (else
      (case (-> this status)
        (('initialize)
         )
        (('reserved)
         (cond
           ((= (-> *art-control* reserve-buffer) this)
            (set! (-> *art-control* reserve-buffer) #f)
            (set! (-> this status) 'inactive)
            )
           (else
             (format 0 "ERROR: trying tro free ~A when ~A is reserved~%" this (-> *art-control* reserve-buffer))
             )
           )
         )
        (('active)
         (if (-> this login?)
             (unlink-file this (-> this art-group))
             )
         (let ((v1-88 (-> this heap)))
           (set! (-> v1-88 current) (-> v1-88 base))
           )
         (set! (-> this art-group) #f)
         (set! (-> this status) 'inactive)
         (when (and (-> this other) (-> this other locked?))
           (unlock! (-> this other))
           (update (-> this other))
           )
         )
        (else
          (let ((v1-98 (-> this heap)))
            (set! (-> v1-98 current) (-> v1-98 base))
            )
          (set! (-> this art-group) #f)
          (set! (-> this status) 'inactive)
          )
        )
      )
    )
  0
  )

;; og:preserve-this *preload-spool-anims*, gui-art pump lane (issue 550/
;; 551): retail top-level, decoded immediately after external-art-buffer's
;; own update and immediately before external-art-control's own file-status
;; (this file's own fresh scoped decode, loader_disasm.gc:543-544), gating
;; the non-urgent-priority preload skip inside external-art-control's own
;; update below. Every other game defines this identically (jak1/jak2/jak3
;; loader.gc, each `(define *preload-spool-anims* #t)` at the same relative
;; position, each with a matching debug-menu toggle this tree has not
;; landed); transcribed verbatim, not ported from a twin.
(define *preload-spool-anims* #t)

(defmethod file-status ((this external-art-control) (arg0 string) (arg1 int))
  (dotimes (s3-0 2)
    (let ((v1-3 (file-status (-> this buffer s3-0) arg0 arg1)))
      (if v1-3
          (return v1-3)
          )
      )
    )
  #f
  )

;; og:preserve-this update (method 9), gui-art pump lane (issues 522/550/
;; 551): held since the scene chain's own scoped decode (op 173, "Could not
;; figure out load" on the candidate buffer, plus two sllv instructions);
;; this rung's own narrowed type_casts.jsonc window ("(method 9 external-
;; art-control)", [173, 191], s4 to external-art-buffer) clears both. Runs
;; each frame: reserves a buffer for a pending "reserved" spool-push if
;; dma-reserve-buffer-count is nonzero, resets the per-buffer frame-lock and
;; per-rec anim-name, links each occupied rec slot to a free, unlocked
;; buffer (first pass: already-matching file-status; second pass: any free
;; buffer, gated on *preload-spool-anims* for non-urgent priorities),
;; releases the reserve buffer's other half when nothing else needs it, and
;; finally pumps both buffers' own update (landed above) and republishes
;; rec into queue-stream for the debug display. This is the retail level-
;; update's own second pump call, jak3 level.gc:3574's (update *art-control*
;; #t), confirmed at jakx's own call site (level.gc's ir2, op 19-23: a1 =
;; #t, matching this method's own debug-display gate).
(defmethod update ((this external-art-control) (arg0 symbol))
  (if (nonzero? (-> this reserve-buffer-count))
      (spool-push this "reserved" 0 *dproc* (if (-> this reserve-buffer)
                                                -110.0
                                                -0.5
                                                )
                  )
      )
  (dotimes (v1-5 2)
    (set! (-> this buffer v1-5 frame-lock) #f)
    )
  (dotimes (v1-8 3)
    (set! (-> this rec v1-8 anim-name) #f)
    )
  (dotimes (s4-0 2)
    (let ((s3-0 (-> this rec s4-0)))
      (when (-> s3-0 name)
        (dotimes (s2-0 2)
          (when (and (file-status (-> this buffer s2-0) (-> s3-0 name) (-> s3-0 parts))
                     (not (-> this buffer s2-0 frame-lock))
                     )
            (set! (-> this buffer s2-0 frame-lock) #t)
            (set! (-> s3-0 anim-name) (the-as string (-> this buffer s2-0)))
            (set! (-> this buffer s2-0 pending-load-file-owner) (-> s3-0 owner))
            (set! (-> this buffer s2-0 load-file-owner) (-> s3-0 owner))
            (set! (-> this buffer s2-0 pending-load-file-priority) (-> s3-0 priority))
            (set! (-> this buffer s2-0 load-file-priority) (-> s3-0 priority))
            (goto cfg-24)
            )
          )
        )
      )
    (label cfg-24)
    )
  (dotimes (s4-1 2)
    (let ((s3-1 (-> this rec s4-1)))
      (when (and (-> s3-1 name) (not (-> s3-1 anim-name)))
        (if (and (not *preload-spool-anims*) (>= (-> s3-1 priority) 0.0))
            (goto cfg-46)
            )
        (dotimes (s2-1 2)
          (when (not (-> this buffer s2-1 frame-lock))
            (set! (-> this buffer s2-1 frame-lock) #t)
            (set-pending-file (-> this buffer s2-1) (-> s3-1 name) (-> s3-1 parts) (-> s3-1 owner) (-> s3-1 priority))
            (set! (-> s3-1 anim-name) (the-as string (-> this buffer s2-1)))
            (goto cfg-46)
            )
          )
        )
      )
    (label cfg-46)
    )
  (when (not (-> this reserve-buffer))
    (let ((s4-2 (the-as external-art-buffer (-> this rec 0 anim-name))))
      (if (and s4-2
               (-> s4-2 locked?)
               (not (string= (-> s4-2 pending-load-file) "reserved"))
               (not (string= (-> s4-2 other pending-load-file) "reserved"))
               )
          (set-pending-file (-> s4-2 other) (the-as string #f) -1 (the-as handle #f) 100000000.0)
          )
      )
    )
  (dotimes (s4-3 2)
    (update (-> this buffer s4-3))
    )
  (let ((s4-4 (-> this queue-stream)))
    (set! (-> s4-4 length) 0)
    (dotimes (s3-2 3)
      (when (-> this rec s3-2 name)
        (mem-copy! (&-> s4-4 (-> s4-4 length) type) (&-> this rec s3-2 type) 44)
        (+! (-> s4-4 length) 1)
        )
      )
    )
  (when (and arg0 *display-art-control*)
    (dotimes (s5-1 3)
      (let ((t9-8 format)
            (a0-27 *stdcon*)
            (a1-8 "rec ~d ~S ~D ~f ~A~%")
            (a2-5 s5-1)
            (a3-3 (-> this rec s5-1 name))
            (t0-3 (-> this rec s5-1 parts))
            (t1-0 (-> this rec s5-1 priority))
            (v1-121 (handle->process (-> this rec s5-1 owner)))
            )
        (t9-8 a0-27 a1-8 a2-5 a3-3 t0-3 t1-0 (if v1-121
                                                 (-> v1-121 name)
                                                 )
              )
        )
      )
    (dotimes (s5-2 2)
      (let ((t9-9 format)
            (a0-28 *stdcon*)
            (a1-9 "buf ~d ~C ~S ~D ~A ~A~%")
            (a2-6 s5-2)
            (a3-4 (if (-> this buffer s5-2 locked?)
                      108
                      32
                      )
                  )
            (t0-4 (-> this buffer s5-2 pending-load-file))
            (t1-1 (-> this buffer s5-2 pending-load-file-part))
            (t2-5 (-> this buffer s5-2 status))
            (v1-142 (handle->process (-> this buffer s5-2 pending-load-file-owner)))
            )
        (t9-9 a0-28 a1-9 a2-6 a3-4 t0-4 t1-1 t2-5 (if v1-142
                                                      (-> v1-142 name)
                                                      )
              )
        )
      )
    (format *stdcon* " a: ~S~%" (-> this active-stream))
    )
  0
  )

(defmethod none-reserved? ((this external-art-control))
  (zero? (-> this dma-reserve-buffer-count))
  )

(defmethod reserve-alloc ((this external-art-control))
  (when (zero? (-> this dma-reserve-buffer-count))
    (when (zero? (-> this dma-reserve-buffer-count))
      (set! (-> this dma-reserve-buffer-count) 1)
      (let ((v1-3 (-> this dma-reserve-heap)))
        (set! (-> v1-3 base) (logand -64 (&+ (&+ (-> *display* frames 1 global-buf end) -368704) 63)))
        (set! (-> v1-3 current) (-> v1-3 base))
        (set! (-> v1-3 top-base) (&+ (-> v1-3 base) #x5a000))
        (set! (-> v1-3 top) (-> v1-3 top-base))
        )
      (set! (-> *display* frames 1 global-buf end) (-> this dma-reserve-heap base))
      (-> this dma-reserve-heap)
      )
    )
  )

(defmethod reserve-free ((this external-art-control) (arg0 kheap))
  (cond
    ((nonzero? (-> this dma-reserve-buffer-count))
     (set! (-> this dma-reserve-buffer-count) 0)
     (let ((v1-3 (-> *display* frames 1 global-buf)))
       (set! (-> v1-3 end) (the-as pointer (+ (+ (-> v1-3 allocated-length) 28) (the-as int v1-3))))
       )
     )
    ((and (zero? (-> this reserve-buffer-count)) (zero? (-> this dma-reserve-buffer-count)))
     (format 0 "ERROR: illegal attempt to free a buffer #x~X which had not been reserved (none reserved).~%" arg0)
     )
    ((not (-> this reserve-buffer))
     (set! (-> this reserve-buffer-count) 0)
     0
     )
    ((= (-> this reserve-buffer heap) arg0)
     (set-pending-file (-> this reserve-buffer) (the-as string #f) -1 (the-as handle #f) 100000000.0)
     (update (-> this reserve-buffer))
     (set! (-> this reserve-buffer-count) 0)
     0
     )
    (else
      (format 0 "ERROR: illegal attempt to free a buffer #x~X which had not been reserved (buffer unknown).~%" arg0)
      )
    )
  0
  )

(defmethod clear-rec ((this external-art-control))
  (dotimes (v1-0 3)
    (set! (-> this rec v1-0 type) spool-anim)
    (set! (-> this rec v1-0 name) #f)
    (set! (-> this rec v1-0 priority) 100000000.0)
    (set! (-> this rec v1-0 owner) (the-as handle #f))
    )
  (set! (-> this frame-mask) (the-as uint (-> *setting-control* user-current process-mask)))
  0
  )

;; og:preserve-this spool-push (method 11), gui-art pump lane (issues 522/
;; 550/551): held since the scene chain's own scoped decode on an unresolved
;; target-nearest-dist (an earlier rung's own landing, target.gc, cleared
;; that) plus three sllv instructions this rung's own narrowed type_casts.
;; jsonc window resolves ("(method 11 external-art-control)", [15, 17], s5
;; to process-drawable, the target-nearest-dist call's own root/trans
;; receiver). Queues a named anim/part pair into this's own 3-slot rec
;; array by priority (defaulting priority from the target's own distance
;; when the caller passes the -99.0 sentinel), replacing an existing queued
;; entry for the same name/part if a lower (more urgent) priority displaces
;; it, otherwise inserting sorted and dropping the lowest-priority slot.
;; This is the same method update (above) calls for the reserve-buffer's
;; own "reserved" placeholder push, and loader.gc's own header note on
;; external-art-buffer's update names this as the caller that made update's
;; own landing load-bearing (issue 551 item 3's landmine, reserve-free).
(defmethod spool-push ((this external-art-control) (arg0 string) (arg1 int) (arg2 process) (arg3 float))
  (if (and (= arg3 -99.0) arg2)
      (set! arg3 (target-nearest-dist (-> (the-as process-drawable arg2) root trans)))
      )
  (cond
    ((and (= arg1 (-> this rec 0 parts)) (name= arg0 (-> this rec 0 name)))
     (if (>= arg3 (-> this rec 0 priority))
         (return (the-as int #f))
         )
     (mem-copy! (&-> this rec 0 type) (&-> this rec 1 type) 44)
     (mem-copy! (&-> this rec 1 type) (&-> this rec 2 type) 44)
     (set! (-> this rec 2 name) #f)
     (set! (-> this rec 2 owner) (the-as handle #f))
     )
    ((and (= arg1 (-> this rec 1 parts)) (name= arg0 (-> this rec 1 name)))
     (if (>= arg3 (-> this rec 1 priority))
         (return (the-as int #f))
         )
     (mem-copy! (&-> this rec 1 type) (&-> this rec 2 type) 44)
     (set! (-> this rec 2 name) #f)
     (set! (-> this rec 2 owner) (the-as handle #f))
     )
    ((and (= arg1 (-> this rec 2 parts)) (name= arg0 (-> this rec 2 name)))
     (if (>= arg3 (-> this rec 2 priority))
         (return (the-as int #f))
         )
     (set! (-> this rec 2 name) #f)
     (set! (-> this rec 2 owner) (the-as handle #f))
     )
    )
  (cond
    ((< arg3 (-> this rec 0 priority))
     (mem-copy! (&-> this rec 2 type) (&-> this rec 1 type) 44)
     (mem-copy! (&-> this rec 1 type) (&-> this rec 0 type) 44)
     (set! (-> this rec 0 name) arg0)
     (set! (-> this rec 0 parts) arg1)
     (set! (-> this rec 0 priority) arg3)
     (set! (-> this rec 0 owner) (process->handle arg2))
     )
    ((< arg3 (-> this rec 1 priority))
     (mem-copy! (&-> this rec 2 type) (&-> this rec 1 type) 44)
     (set! (-> this rec 1 name) arg0)
     (set! (-> this rec 1 parts) arg1)
     (set! (-> this rec 1 priority) arg3)
     (set! (-> this rec 1 owner) (process->handle arg2))
     )
    ((< arg3 (-> this rec 2 priority))
     (set! (-> this rec 2 name) arg0)
     (set! (-> this rec 2 parts) arg1)
     (set! (-> this rec 2 priority) arg3)
     (set! (-> this rec 2 owner) (process->handle arg2))
     )
    )
  0
  )

;; definition of type spooler-block
(deftype spooler-block (basic)
  ((anim              spool-anim)
   (idle              art-joint-anim)
   (exit              art-joint-anim)
   (break-func        (function process-drawable object))
   (flags             spooler-flags)
   (part              int32)
   (part-audio-start  float)
   (old-status        uint16)
   (old-pos           int32)
   (good-time         uint64)
   (old-time          uint64)
   (good-count        int32)
   (sid               sound-id)
   (start-time        uint64)
   (paused?           symbol)
   (frame-count       int32)
   (frame-count2      float)
   (next-frame-fmv    basic)
   )
  )

;; og:preserve-this spooler-block: landed as a compile prerequisite for
;; ja-play-spooled-anim below, which allocates and reads/writes one; its
;; own decode is clean and matches all-types.gc's offset-asserted field
;; layout exactly (no :methods block in either file: spooler-block never
;; overrides new). Its inspect method (REF, method 3) stays parked:
;; nothing here calls it, and it is out of this rung's scope.

;; og:preserve-this ja-play-spooled-anim: held in a block comment, matching
;; the cam-debug.gc cam-line-dma precedent for a function that does not
;; compile as decoded. Text below is this worktree's own decode, verbatim,
;; not cleaned up: a single unresolved load at op 43 ("Could not figure out
;; load: (set! a0 (l.wu (+ v1 28)))", reading a field off the spooler-block
;; this behavior just allocated) fails type prop and drags every downstream
;; register to the none type, so the body is raw l.wu/s.w!/s.f!/s.d!/s.h!
;; pointer arithmetic rather than proper field accesses.
;;
;; It also does not compile, for a second and harder reason: retyping
;; t9-0's local-var declaration to match what (method-of-type v1-0 new)
;; actually resolves to on a generically-typed `type` value clears the
;; first type error, but the very next line, (new 'stack-no-clear
;; 'spooler-block), then fails with "Cannot stack allocate with no
;; constructor for a spooler-block": spooler-block extends basic (unlike
;; the structure-typed stack-no-clear precedents elsewhere in this tree,
;; e.g. joint-exploder.gc's bounding-box and collide-query), so retail's
;; version of this call needed a real (defmethod new spooler-block ...),
;; and that method's body is not present anywhere in loader.o's decode
;; (searched the full disasm for "method 0 of type spooler-block" and
;; "new spooler-block": no hits). Retiring this note needs that
;; constructor found and decoded first, wherever its bytes live, not a
;; local type-annotation fix; inventing one here would not be transcribing
;; the decode, it would be guessing at unseen retail code.
;;
;; Also worth naming for whoever eventually lands this for real: partway
;; through, the body dispatches gui-control-method-15 by vtable lookup
;; (method-of-type on *gui-control*'s own type), and no defmethod for
;; method 15 is landed anywhere in this tree yet (it is still in the
;; og:note's parked list above); reaching that branch before method 15
;; lands would be a jump through an unfilled slot.
#|
;; definition for function ja-play-spooled-anim
;; ERROR: failed type prop at 43: Could not figure out load: (set! a0 (l.wu (+ v1 28)))
;; WARN: Return type mismatch none vs int.
