;;-*-Lisp-*-
(in-package goal)

;; name: load-state.gc
;; name in dgo: load-state
;; dgos: ENGINE, GAME

;; og:preserve-this: the level-buffer-state / level-buffer-state-split / load-state
;; deftypes moved to game-info-h.gc (jak3 parity) so gsound.o, which compiles earlier
;; and calls want-sound-banks, can see the method declarations.

;; function externs for functions still commented out below (decomp failures)
(define-extern add-want-level (function (inline-array level-buffer-state) (pointer int64) symbol symbol symbol symbol int object)) ;; 7th arg = slot

;; og:preserve-this rung 2 (issue 522): *backup-load-state* is defined later
;; in this same file (methods 19 and 20, landed this rung, both reference it
;; ahead of that define). jak3's own load-state.gc carries the identical
;; forward declaration at the same spot (jak3 load-state.gc:12) for the same
;; reason; *load-state* itself needs no matching extern here because
;; script-h.gc:14 already declares it and compiles first.
(define-extern *backup-load-state* load-state)

;; og:preserve-this rung 2 (issue 522): lobby-level-set! (landed method 25's
;; own body) is a real, already-defined jakx function (net-world.gc:193,
;; already called live from credits-obs.gc), but net-world.gc compiles
;; after this file in build order, so its definition is not yet visible
;; here. Same forward-reference class as the extern above. The return type
;; matches all-types.gc's own extern for this symbol exactly (decompiler/
;; config/jakx/all-types.gc:62079, object, not int, already typed from this
;; same method-25 call site); JakXTypeConsistency compiles goal_src against
;; all-types.gc's externs and a mismatched local type here would redefine
;; and fail that gate even though a plain (mi) build never loads all-types.
(define-extern lobby-level-set! (function int symbol symbol object))

;; DECOMP BEGINS


;; definition for method 2 of type level-buffer-state
(defmethod print ((this level-buffer-state))
  (format
    #t
    "#<level-buffer-state ~A ~A ~A ~A @ #x~X>"
    (-> this name)
    (-> this display?)
    (-> this force-vis?)
    (-> this force-inside?)
    this
    )
  this
  )

;; definition for method 2 of type level-buffer-state-small
(defmethod print ((this level-buffer-state-small))
  (format #t "#<level-buffer-state ~A ~A @ #x~X>" (-> this name) (-> this display?) this)
  this
  )

;; definition for method 2 of type level-buffer-state-split
(defmethod print ((this level-buffer-state-split))
  (format
    #t
    "#<level-buffer-state-split ~A ~A ~A @ #x~X>"
    (-> this name)
    (-> this display? 0)
    (-> this display? 1)
    this
    )
  this
  )

