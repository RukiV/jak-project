;; state"], ntsc_v1) re-measured all ten: eight decode clean today, methods
;; 17, 18, 19, 20, 23, 24, 25, 26, transcribed verbatim below (each only
;; carries a cosmetic return-type-mismatch WARN, no ERROR, no raw op). The
;; old held errors on these eight are gone; whatever cleared the failed-
;; type-prop class elsewhere in the tree cleared them too. Methods 2 (of
;; sound-bank-state) and 21 still fail for real and stay held, each with
;; its own updated note naming the live wall. Method 14 also still fails
;; for real (a raw (s.w! ...) store survives type prop at op 15) and stays
;; held alongside them.
;;
;; Landing method 23 closes the e2-class hazard this issue flagged live at
;; scene.gc:1045: the wait state's :enter dispatches load-state-method-23
;; through what was a permanently-zero vtable slot for any scene whose
;; vehicles array is nonzero, since nothing defined the method. That call
;; site needs no source change; it starts reaching real code the moment
;; this defmethod exists.

;; definition for method 17 of type load-state
(defmethod want-force-inside ((this load-state) (arg0 symbol) (arg1 symbol))
  (dotimes (v1-0 18)
    (when (= (-> this want v1-0 name) arg0)
      (set! (-> this want v1-0 force-inside?) arg1)
      (add-borrow-levels this)
      (return 0)
      )
    )
  (format 0 "ERROR: can't force inside on ~A because it isn't loaded~%" arg0)
  0
  (none)
  )

;; definition for symbol *display-load-commands*, type symbol
(define *display-load-commands* #f)

;; definition for method 19 of type load-state
(defmethod backup-load-state-and-set-cmds ((this load-state) (arg0 pair))
  (dotimes (s4-0 256)
    (when (-> this object-name s4-0)
      (format 0 "WARNING: load state somehow aquired object command ~A~%" (-> this object-name s4-0))
      (set! (-> this object-name s4-0) #f)
      )
    )
  (mem-copy! (&-> *backup-load-state* type) (&-> this type) 4232)
  (set! (-> *backup-load-state* command-list) '())
  (set! (-> this command-list) arg0)
  0
  )

;; definition for method 20 of type load-state
(defmethod load-state-method-20 ((this load-state))
  (with-pp
    (execute-commands-up-to this 100000.0)
    (dotimes (gp-0 256)
      (when (-> this object-name gp-0)
        (let ((a0-3 (entity-by-name (-> this object-name gp-0))))
          (when a0-3
            (set! (-> a0-3 extra perm status) (the-as entity-perm-status (-> this object-status gp-0)))
            (if (-> a0-3 extra process)
                (kill! a0-3)
                )
            )
          )
        (set! (-> this object-name gp-0) #f)
        )
      )
    (let ((s5-0 (new 'stack 'load-state))
          (gp-1 (-> *load-state* update-callback))
          )
      (mem-copy! (&-> s5-0 type) (&-> *load-state* type) 4232)
      (mem-copy! (&-> this type) (&-> *backup-load-state* type) 4232)
      (when (!= (-> pp type) scene-player)
        (dotimes (s4-1 18)
          (mem-copy! (the-as pointer (-> *load-state* want s4-1)) (the-as pointer (-> s5-0 want s4-1)) 24)
          )
        (dotimes (v1-34 1)
          (set! (-> *load-state* want-sound v1-34 name) (-> s5-0 want-sound v1-34 name))
          (set! (-> *load-state* want-sound v1-34 mode) (-> s5-0 want-sound v1-34 mode))
          )
        )
      (dotimes (s4-2 18)
        (mem-copy! (the-as pointer (-> *load-state* want-exp s4-2)) (the-as pointer (-> s5-0 want-exp s4-2)) 24)
        (mem-copy! (the-as pointer (-> *load-state* target s4-2)) (the-as pointer (-> s5-0 target s4-2)) 24)
        )
      (dotimes (v1-47 7)
        (set! (-> *load-state* target-sound v1-47 name) (-> s5-0 target-sound v1-47 name))
        (set! (-> *load-state* target-sound v1-47 mode) (-> s5-0 target-sound v1-47 mode))
        )
      (set! (-> *load-state* update-callback) gp-1)
      )
    (add-borrow-levels *load-state*)
    0
    )
  )
