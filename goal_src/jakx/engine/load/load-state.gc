;; definition for method 9 of type load-state
(defmethod reset! ((this load-state))
  (dotimes (v1-0 18)
    (set! (-> this want v1-0 name) #f)
    (set! (-> this want v1-0 display?) #f)
    (set! (-> this want v1-0 force-vis?) #f)
    (set! (-> this want v1-0 force-inside?) #f)
    (set! (-> this want v1-0 force-reload) #f)
    )
  (dotimes (v1-3 1)
    (set! (-> this want-sound v1-3 name) #f)
    (set! (-> this want-sound v1-3 mode) (sound-bank-mode none))
    )
  (set! (-> this command-list) '())
  (dotimes (v1-7 256)
    (set! (-> this object-name v1-7) #f)
    (set! (-> this object-status v1-7) (the-as basic 0))
    )
  this
  )

;; definition for function level-base-level-name
;; WARN: Return type mismatch symbol vs object.
(defun level-base-level-name ((arg0 symbol))
  (when arg0
    (lookup-level-info arg0)
    #f
    )
  )

;; definition for method 11 of type load-state
(defmethod want-levels ((this load-state) (arg0 (pointer symbol)))
  (dotimes (v1-0 6)
    (dotimes (a0-1 6)
      (when (= (-> this want v1-0 name) (-> arg0 a0-1))
        (set! (-> arg0 a0-1) #f)
        (goto cfg-8)
        )
      )
    (set! (-> this want v1-0 name) #f)
    (label cfg-8)
    )
  (dotimes (s4-0 6)
    (when (-> arg0 s4-0)
      (dotimes (s3-0 6)
        (when (not (-> this want s3-0 name))
          (set! (-> this want s3-0 name) (-> arg0 s4-0))
          (set! (-> this want s3-0 display?) #f)
          (set! (-> this want s3-0 force-vis?) #f)
          (set! (-> this want s3-0 force-inside?) #f)
          (set! (-> this want s3-0 force-reload) #f)
          (let ((a0-13 (level-base-level-name (-> this want s3-0 name))))
            (dotimes (v1-24 6)
              (when (= (-> this want-exp v1-24 name) a0-13)
                (set! (-> this want s3-0 display?) (-> this want-exp v1-24 display?))
                (set! (-> this want s3-0 force-vis?) (-> this want-exp v1-24 force-vis?))
                (set! (-> this want s3-0 force-inside?) (-> this want-exp v1-24 force-inside?))
                (set! (-> this want s3-0 force-reload) (-> this want-exp v1-24 force-reload))
                (goto cfg-21)
                )
              )
            )
          (label cfg-21)
          (goto cfg-26)
          )
        )
      )
    (label cfg-26)
    )
  (dotimes (v1-37 6)
    (when (not (-> this want v1-37 name))
      (set! (-> this want v1-37 display?) #f)
      (set! (-> this want v1-37 force-vis?) #f)
      (set! (-> this want v1-37 force-inside?) #f)
      (set! (-> this want v1-37 force-reload) #f)
      )
    )
  (add-borrow-levels this)
  0
  )

;; definition for function add-want-level
;; INFO: Used lq/sq
;; WARN: Return type mismatch int vs object.
(defun add-want-level ((arg0 (inline-array level-buffer-state))
              (arg1 (pointer int64))
              (arg2 symbol)
              (arg3 symbol)
              (arg4 symbol)
              (arg5 symbol)
              (arg6 int)
              )
  (let ((sv-16 arg2)
        (s4-0 arg3)
        (s3-0 arg4)
        (s2-0 arg5)
        (s1-0 arg6)
        )
    (when sv-16
      (let ((s0-0 (lookup-level-info sv-16)))
        (cond
          ((>= (-> arg1 0) 18)
           )
          (else
            (set! (-> arg0 (-> arg1 0) name) sv-16)
            (set! (-> arg0 (-> arg1 0) display?) s4-0)
            (set! (-> arg0 (-> arg1 0) force-vis?) s3-0)
            (set! (-> arg0 (-> arg1 0) force-inside?) s2-0)
            (set! (-> arg0 (-> arg1 0) slot) s1-0)
            (set! (-> arg0 (-> arg1 0) force-reload) #f)
            (let ((v1-21 (-> *load-state* want-split)))
              (set! (-> v1-21 (-> arg1 0) name) (the-as basic sv-16))
              (set! (-> v1-21 (-> arg1 0) display? 0) s4-0)
              (set! (-> v1-21 (-> arg1 0) display? 1) s4-0)
              )
            (+! (-> arg1 0) 1)
            (when (-> s0-0 borrow)
              (let ((sv-32 0))
                (while (< sv-32 3)
                  (let ((v1-32 (-> s0-0 borrow borrow-info sv-32)))
                    (when v1-32
                      (let ((t9-1 add-want-level)
                            (a0-12 arg0)
                            (a1-6 arg1)
                            (a2-2 (car v1-32))
                            (a3-1 (car (cdr v1-32)))
                            )
                        (set! a3-1 (cond
                                     ((or (not s4-0) (= a3-1 'copy))
                                      s4-0
                                      )
                                     (else
                                       (empty)
                                       a3-1
                                       )
                                     )
                              )
                        (t9-1 a0-12 a1-6 (the-as symbol a2-2) (the-as symbol a3-1) s3-0 s2-0 s1-0)
                        )
                      )
                    )
                  (+! sv-32 1)
                  )
                )
              )
            )
          )
        )
      )
    )
  0
  )

;; definition for method 22 of type load-state
;; WARN: Return type mismatch int vs none.
;; WARN: new jak 2 until loop case, check carefully
(defmethod add-borrow-levels ((this load-state))
  (dotimes (s5-0 18)
    (let ((a0-1 (-> this want s5-0 name)))
      (when a0-1
        (let ((a0-2 (lookup-level-info a0-1)))
          (when (= (-> a0-2 memory-mode) (level-memory-mode small-center))
            (set! (-> this want s5-0 name) #f)
            (set! (-> this want s5-0 display?) #f)
            (set! (-> this want s5-0 force-vis?) #f)
            (set! (-> this want s5-0 force-inside?) #f)
            (set! (-> this want s5-0 force-reload) #f)
            )
          )
        )
      )
    )
  (let ((sv-16 0))
    (dotimes (s5-1 6)
      (if (-> this want s5-1 name)
          (add-want-level
            (-> this want-exp)
            (the-as (pointer int64) (& sv-16))
            (-> this want s5-1 name)
            (-> this want s5-1 display?)
            (-> this want s5-1 force-vis?)
            (-> this want s5-1 force-inside?)
            (-> this want s5-1 slot)
            )
          )
      )
    (while (< sv-16 6)
      (set! (-> this want-exp sv-16 name) #f)
      (set! (-> this want-exp sv-16 display?) #f)
      (set! (-> this want-exp sv-16 force-vis?) #f)
      (set! (-> this want-exp sv-16 force-inside?) #f)
      (set! (-> this want-exp sv-16 force-reload) #f)
      (set! (-> this want-split sv-16 name) #f)
      (set! (-> this want-split sv-16 display? 0) #f)
      (set! (-> this want-split sv-16 display? 1) #f)
      (+! sv-16 1)
      )
    )
  (dotimes (v1-63 6)
    (let ((a0-8 (+ v1-63 6)))
      (set! (-> this want-exp a0-8 name) (-> this want a0-8 name))
      (set! (-> this want-exp a0-8 display?) (-> this want a0-8 display?))
      (set! (-> this want-exp a0-8 force-vis?) (-> this want a0-8 force-vis?))
      (set! (-> this want-exp a0-8 force-inside?) (-> this want a0-8 force-inside?))
      (set! (-> this want-exp a0-8 slot) (-> this want a0-8 slot))
      (set! (-> this want-exp a0-8 force-reload) (-> this want a0-8 force-reload))
      )
    )
  (dotimes (v1-66 6)
    (let ((a0-11 (+ v1-66 12))
          (a1-19 #t)
          )
      (dotimes (a2-11 6)
        (if (= (-> this want-exp a0-11 name) (-> this want (+ a2-11 12) name))
            (set! a1-19 #f)
            )
        )
      (when a1-19
        (set! (-> this want-exp a0-11 name) #f)
        (set! (-> this want-exp a0-11 display?) #f)
        (set! (-> this want-exp a0-11 force-vis?) #f)
        (set! (-> this want-exp a0-11 force-inside?) #f)
        (set! (-> this want-exp a0-11 force-reload) #f)
        )
      )
    )
  (dotimes (v1-69 6)
    (let ((a0-14 (+ v1-69 12))
          (a1-30 #f)
          )
      (when (-> this want a0-14 name)
        (dotimes (a2-18 v1-69)
          (if (= (-> this want a0-14 name) (-> this want (+ a2-18 12) name))
              (set! a1-30 #t)
              )
          )
        (when (not a1-30)
          (let ((a1-31 #f))
            (dotimes (a2-22 6)
              (if (= (-> this want-exp (+ a2-22 12) name) (-> this want a0-14 name))
                  (set! a1-31 #t)
                  )
              )
            (when (not a1-31)
              (let ((a1-32 0))
                (until #f
                  (when (not (-> this want-exp (+ a1-32 12) name))
                    (set! (-> this want-exp (+ a1-32 12) name) (-> this want a0-14 name))
                    (set! (-> this want-exp (+ a1-32 12) display?) (-> this want a0-14 display?))
                    (set! (-> this want-exp (+ a1-32 12) force-vis?) (-> this want a0-14 force-vis?))
                    (set! (-> this want-exp (+ a1-32 12) force-inside?) (-> this want a0-14 force-inside?))
                    (set! (-> this want-exp (+ a1-32 12) slot) (+ a1-32 12))
                    (set! (-> this want-exp (+ a1-32 12) force-reload) (-> this want a0-14 force-reload))
                    (goto cfg-48)
                    )
                  (+! a1-32 1)
                  (when (= a1-32 6)
                    (break!)
                    0
                    )
                  )
                )
              #f
              )
            )
          )
        )
      )
    (label cfg-48)
    )
  (cond
    ((-> this update-callback)
     ((-> this update-callback) this)
     )
    (else
      (dotimes (v1-74 18)
        (set! (-> this target v1-74 name) (-> this want-exp v1-74 name))
        (set! (-> this target v1-74 display?) (-> this want-exp v1-74 display?))
        (set! (-> this target v1-74 force-vis?) (-> this want-exp v1-74 force-vis?))
        (set! (-> this target v1-74 force-inside?) (-> this want-exp v1-74 force-inside?))
        (set! (-> this target v1-74 slot) (-> this want-exp v1-74 slot))
        (set! (-> this target v1-74 force-reload) (-> this want-exp v1-74 force-reload))
