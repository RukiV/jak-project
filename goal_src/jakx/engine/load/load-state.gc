;; og:preserve-this: the level-buffer-state / level-buffer-state-split / load-state
;; deftypes moved to game-info-h.gc (jak3 parity) so gsound.o, which compiles earlier
;; and calls want-sound-banks, can see the method declarations.

;; function externs for functions still commented out below (decomp failures)
