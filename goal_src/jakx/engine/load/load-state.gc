;; definition for method 18 of type load-state
(defmethod execute-commands-up-to ((this load-state) (arg0 float))
  (with-pp
    (let ((s4-0 (new 'stack 'script-context (process->ppointer pp) pp (the-as vector #f))))
      (set! (-> s4-0 load-state) this)
      (while (not (null? (-> this command-list)))
        (let ((f0-0 (command-get-float (car (car (-> this command-list))) 0.0))
              (s3-0 (cdr (car (-> this command-list))))
              )
          (if (< arg0 f0-0)
              (return #f)
              )
          (if *display-load-commands*
              (format 0 "NOTICE: ~D: ~f: execute command ~A~%" (current-time) f0-0 s3-0)
              )
          (cond
            ((pair? (car s3-0))
             (let ((a1-4 (car s3-0)))
               (while (not (null? s3-0))
                 (eval! s4-0 (the-as pair a1-4))
                 (set! s3-0 (cdr s3-0))
                 (set! a1-4 (car s3-0))
                 )
               )
             )
            (else
              (eval! s4-0 s3-0)
              )
            )
          )
        (set! (-> this command-list) (cdr (-> this command-list)))
        )
      )
    0
    (none)
    )
  )

;; definition for method 25 of type load-state
(defmethod load-state-method-25 ((this load-state) (arg0 symbol))
  (add-borrow-levels this)
  (lobby-level-set! 1 arg0 'cache)
  (add-borrow-levels this)
  0
  (none)
  )

;; definition for method 23 of type load-state
(defmethod load-state-method-23 ((this load-state) (arg0 int) (arg1 symbol) (arg2 symbol))
  (local-vars (a0-6 symbol))
  (cond
    (arg1
      (let ((v1-0 arg2))
        (dotimes (a0-1 11)
          (when (!= (-> *car-level-array* data 0 current-parts (+ a0-1 (* arg0 512)))
                    (-> *level* level0 filter-look (+ a0-1 (* 1440 (+ arg0 6))))
                    )
            (set! (-> this want (+ arg0 6) force-reload) (the-as basic #t))
            (set! v1-0 #t)
            (set! a0-6 #t)
            (goto cfg-8)
            )
          )
        (set! a0-6 #f)
        (label cfg-8)
        (cond
          (a0-6
            )
          ((or (!= (-> *level* level (+ arg0 6) name) arg1) (!= (-> *level* level (+ arg0 6) status) 'active))
           (set! v1-0 #t)
           )
          )
        (if (not v1-0)
            (return #f)
            )
        )
      (let ((v1-5 (car-type-from-level-name arg1)))
        (when (>= (the-as int v1-5) 0)
          (if (not (-> *car-type-names* v1-5))
              (return #f)
              )
          )
        )
      (dotimes (v1-11 11)
        (set! (-> *level* level0 filter-look (+ v1-11 (* 1440 (+ arg0 6))))
              (-> *car-level-array* data 0 current-parts (+ v1-11 (* arg0 512)))
              )
        )
      )
    (else
      (dotimes (v1-14 11)
        (set! (-> *level* level0 filter-look (+ v1-14 (* 1440 (+ arg0 6)))) 0)
        )
      )
    )
  (set! (-> this want (+ arg0 6) name) arg1)
  (set! (-> this want (+ arg0 6) display?) (if arg1
                                               'special
                                               #f
                                               )
        )
  (set! (-> this want (+ arg0 6) slot) (+ arg0 6))
  (add-borrow-levels this)
  0
  (none)
  )

;; definition for method 26 of type load-state
(defmethod load-state-method-26 ((this load-state) (arg0 int) (arg1 symbol) (arg2 symbol))
  (when arg1
    (set! (-> this want-sound (+ arg0 1) name) arg1)
    (set! (-> this want-sound (+ arg0 1) high) (the-as basic arg2))
    )
  0
  (none)
  )

;; definition for method 24 of type load-state
(defmethod load-state-method-24 ((this load-state) (arg0 int) (arg1 symbol))
  (set! (-> this want (+ arg0 12) name) arg1)
  (set! (-> this want (+ arg0 12) display?) (if arg1
                                                'special
                                                #f
                                                )
        )
  (set! (-> this want (+ arg0 12) slot) (+ arg0 12))
  (add-borrow-levels this)
  0
  (none)
  )

;; failed to figure out what this is:
(kmemopen global "load-state-struct")

;; definition for symbol *backup-load-state*, type load-state
(define *backup-load-state* (new 'global 'load-state))

;; definition (perm) for symbol *load-state*, type load-state
(define-perm *load-state* load-state (new 'global 'load-state))

;; og:preserve-this bring-up init: kmalloc'd memory is zeroed, and a 0 in a
;; function/symbol field is TRUTHY in GOAL (only #f = s7 is false). reset! never
;; touches these, so add-borrow-levels would call update-callback = address 0.
;; The original game registers a real callback (progress/menu code) before the
;; first level load; give the fields an explicit #f until that code exists.
(set! (-> *backup-load-state* update-callback) #f)
(set! (-> *backup-load-state* vis-nick) #f)
(set! (-> *load-state* update-callback) #f)
(set! (-> *load-state* vis-nick) #f)

;; failed to figure out what this is:
(kmemclose)

;; og:preserve-this M1 vehicle-leg dev-lever (rung 2): the car-level want path.
;; load-state-method-23 is the retail composer's own way to arm a car want slot
;; (net-world.gc's R1 stub note, retail-staging ladder #192: method 23 called
;; at net-world_ir2.asm:11689-11696 with 4 args, matching this branch's now-
;; fixed declaration a few commits back), but its body is still an uncompiled
;; failing decode on every branch that carries it (this file, "definition for
;; method 23 of type load-state" above: "failed type prop", registers read but
;; never set) -- there is nothing to call, and transcribing a body from a
;; decode that does not decode would invent content AGENTS.md forbids.
;;
;; add-want-level is the primitive method 23's own body would bottom out on for
;; the actual array write; add-borrow-levels above is the proven, working,
;; in-tree caller ((-> this want-exp), a stack counter via (&...), name/
;; display?/force-vis?/force-inside?/slot copied from an existing want entry).
;; This wraps that same call against (-> *load-state* want) directly, the array
;; net-world-method-76's own step 9 (net-world.gc) copies slots 6-17 from.
;; *level* reserves slots 6-11 for car levels (leg brief M1, texture.gc:
;; 1869-1876, level.gc:1486-1488), so index 6 is car slot 0. No physics, pilot
;; or net composition here; this only arms the want entry the ordinary
;; level-load tick already scans every frame.
(defun jakx-vehicle-want-level! ((level-name symbol))
  "REPL lever: (jakx-vehicle-want-level! 'jakvl) wants the named car level into
*load-state*'s want slot 6 (car slot 0), the same array net-world's own step 9
reads from for the retail composer. Pass #f to clear the slot. Retires once
load-state-method-23 decodes cleanly and the real retail composer (net-world
steps 7-8) lands."
  (let ((idx 6))
    (add-want-level (-> *load-state* want)
                     (the-as (pointer int64) (& idx))
                     level-name
                     #f
                     #f
                     #f
                     6
                     )
    )
  (none)
  )




