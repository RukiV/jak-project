;; og:preserve-this V4a (#41): landed for real from a scoped decode of decomp.o,
;; jak2/jak3's identical hint seed (blocks_ending_in_asm_branch and type_casts)
;; resolved it clean with no iteration needed. Was extern-declared in V2 on the
;; premise that update-vis! sat behind the still-unreachable arm B, so the extern
;; would never actually get called; the V4 lever flip made update-vis! reachable
;; and the eyes-on boot crashed on exactly that call (rip through the zero-value
;; symbol, decomp+0x5ad, inside update-vis!). Matches jak3's landed body
;; (goal_src/jak3/engine/load/decomp.gc:10) verbatim short of the docstring, kept
;; out per this leg's verbatim-first convention.
(defun unpack-comp-rle ((arg0 (pointer int8)) (arg1 (pointer int8)))
  (local-vars (v1-2 int) (v1-3 uint))
  (nop!)
  (loop
    (loop
      (set! v1-2 (-> arg1 0))
      (set! arg1 (&-> arg1 1))
      (b! (<= v1-2 0) cfg-5 :delay (nop!))
      (let ((a2-0 (-> arg1 0)))
        (set! arg1 (&-> arg1 1))
        (label cfg-3)
        (nop!)
        (nop!)
        (nop!)
        (nop!)
        (set! (-> arg0 0) a2-0)
        )
      (set! arg0 (&-> arg0 1))
      (b! (> v1-2 0) cfg-3 :delay (set! v1-2 (+ v1-2 -1)))
      )
    (label cfg-5)
    (b! (zero? v1-2) cfg-8 :delay (set! v1-3 (the-as uint (- v1-2))))
    (label cfg-6)
    (let ((a2-1 (-> arg1 0)))
      (set! arg1 (&-> arg1 1))
      (nop!)
      (nop!)
      (set! (-> arg0 0) a2-1)
      )
    (+! v1-3 -1)
    (b! (> (the-as int v1-3) 0) cfg-6 :delay (set! arg0 (&-> arg0 1)))
    )
  (label cfg-8)
  arg1
  )

