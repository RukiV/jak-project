  (dotimes (s2-0 arg1)
    (when (spheres-overlap? arg0 (the-as sphere (-> this bsphere)))
      (set! (-> arg2 items (-> arg2 num-items)) this)
      (+! (-> arg2 num-items) 1)
      )
    (&+! this 32)
    )
  0
  (none)
  )

