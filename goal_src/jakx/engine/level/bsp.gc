;;-*-Lisp-*-
(in-package goal)

;; name: bsp.gc
;; name in dgo: bsp
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

;; og:preserve-this partial landing: build-masks (called by login-begin in the level
;; load chain) decompiles clean in bsp_ir2.asm and is landed below; the rest of bsp.o
;; stays pending on its blocked top-level.

;; og:preserve-this level-remap-texture is jak3's landed body verbatim: the jakx asm
;; (bsp_ir2.asm L43) is the same remap-table binary search access for access, and the
;; two 64-bit label constants L83/L84 (#xfffffff8, #xffffff00) equal jak3's align mask
;; and its (new 'static 'texture-id :index #xfff :page #xfff). The decompiler cannot
;; resolve the search's CFG (strange-gotos), so this is a port, not machine output.
;; It was the first unbound symbol on the art-group login chain: adgif-shader-login-fast
;; calls it on every shader, so relocate login died at arena+0 without it.
;; WARN: Return type mismatch uint vs texture-id.
(defun level-remap-texture ((arg0 texture-id))
  "Level tpages combine the tpages of many individual actors.
   Given a texture ID for a texture in an individual actor,
   determine the texture ID for this texture in the level's
   combined page."
  (let ((v1-1 (-> *level* log-in-level-bsp)))
    (when v1-1
      (let* ((a3-0 (-> v1-1 texture-remap-table-len))
             (v1-2 (the-as object (-> v1-1 texture-remap-table)))
             (t0-0 (the-as (pointer uint64) v1-2))
             (a1-1 (the-as uint #xfffffff8))
             (a2-1 (logand (new 'static 'texture-id :index #xfff :page #xfff) arg0))
             (a3-2 (the-as object (&+ t0-0 (* a3-0 8))))
             )
        (label cfg-2)
        (b! (= v1-2 a3-2) cfg-8 :delay (nop!))
        (let ((t0-3 (the-as object (logand (/ (+ (the-as int v1-2) (the-as int a3-2)) 2) a1-1))))
          (let ((t1-1 (- (-> (the-as (pointer uint32) t0-3) 0) a2-1)))
            (b! (zero? t1-1) cfg-7 :delay (nop!))
            (b! (< (the-as int t1-1) 0) cfg-6 :delay (nop!))
            )
          (b! #t cfg-2 :delay (set! a3-2 (the-as (pointer uint64) t0-3)))
          (label cfg-6)
          (b! #t cfg-2 :delay (set! v1-2 (+ (the-as int t0-3) 8)))
          (label cfg-7)
          (set! arg0 (the-as texture-id (logior (-> (the-as (pointer uint32) t0-3) 1) 20)))
          )
        )
      (label cfg-8)
      0
      )
    )
  (the-as texture-id arg0)
  )

(defun build-masks ((arg0 bsp-header))
  (let ((v1-0 (-> arg0 drawable-trees))
        (s2-0 (the-as int (-> arg0 tfrag-closest)))
        (s3-0 (the-as int (-> arg0 shrub-closest)))
        (s4-0 (the-as int (-> arg0 alpha-closest)))
        (gp-0 (the-as int (-> arg0 water-closest)))
        )
    (when (zero? (+ s2-0 s3-0 s4-0 gp-0))
      (dotimes (a0-5 (-> v1-0 length))
        (let ((a1-2 (-> v1-0 trees a0-5)))
          (cond
            ((= (-> a1-2 type) drawable-tree-tfrag)
             (let* ((a2-5 (-> (the-as drawable-tree-tfrag a1-2) arrays (+ (-> (the-as drawable-tree-tfrag a1-2) length) -1)))
                    (a1-4 (-> a2-5 length))
                    (a2-6 (-> (the-as drawable-inline-array-tfrag a2-5) data))
                    )
               (dotimes (a3-1 a1-4)
                 (set! (-> a2-6 0 texture-masks-index) (the-as uint s2-0))
                 (+! s2-0 1)
                 (set! a2-6 (the-as (inline-array tfragment) (-> a2-6 1)))
                 )
               )
             )
            ((= (-> a1-2 type) drawable-tree-tfrag-trans)
             (let* ((a2-13
                      (-> (the-as drawable-tree-tfrag-trans a1-2) arrays (+ (-> (the-as drawable-tree-tfrag-trans a1-2) length) -1))
                      )
                    (a1-7 (-> a2-13 length))
                    (a2-14 (-> (the-as drawable-inline-array-tfrag a2-13) data))
                    )
               (dotimes (a3-3 a1-7)
                 (set! (-> a2-14 0 texture-masks-index) (the-as uint s4-0))
                 (+! s4-0 1)
                 (set! a2-14 (the-as (inline-array tfragment) (-> a2-14 1)))
                 )
               )
             )
            ((= (-> a1-2 type) drawable-tree-tfrag-water)
             (let* ((a2-21
                      (-> (the-as drawable-tree-tfrag-water a1-2) arrays (+ (-> (the-as drawable-tree-tfrag-water a1-2) length) -1))
                      )
                    (a1-10 (-> a2-21 length))
                    (a2-22 (-> (the-as drawable-inline-array-tfrag a2-21) data))
                    )
               (dotimes (a3-5 a1-10)
                 (set! (-> a2-22 0 texture-masks-index) (the-as uint gp-0))
                 (+! gp-0 1)
                 (set! a2-22 (the-as (inline-array tfragment) (-> a2-22 1)))
                 )
               )
             )
            ((= (-> a1-2 type) drawable-tree-instance-tie)
             (let* ((a1-13 (-> (the-as drawable-tree-instance-tie a1-2) prototypes prototype-array-tie))
                    (a2-26 (-> a1-13 length))
                    )
               (dotimes (a3-7 a2-26)
                 (cond
                   ((logtest? (-> a1-13 array-data a3-7 flags) (prototype-flags tpage-water))
                    (set! (-> a1-13 array-data a3-7 texture-masks-index) (the-as uint gp-0))
                    (+! gp-0 1)
                    )
                   ((logtest? (-> a1-13 array-data a3-7 flags) (prototype-flags tpage-alpha))
                    (set! (-> a1-13 array-data a3-7 texture-masks-index) (the-as uint s4-0))
                    (+! s4-0 1)
                    )
                   (else
                     (set! (-> a1-13 array-data a3-7 texture-masks-index) (the-as uint s2-0))
                     (+! s2-0 1)
                     )
                   )
                 )
               )
             )
            ((= (-> a1-2 type) drawable-tree-instance-shrub)
             (let* ((a2-30 (-> (the-as drawable-tree-instance-shrub a1-2) info prototype-inline-array-shrub))
                    (a1-16 (-> a2-30 length))
                    (a2-31 (-> a2-30 data))
                    )
               (dotimes (a3-9 a1-16)
                 (set! (-> a2-31 0 texture-masks-index) (the-as uint s3-0))
                 (+! s3-0 1)
                 (set! a2-31 (the-as (inline-array prototype-bucket-shrub) (-> a2-31 1)))
                 )
               )
             )
            )
          )
        )
      )
    (when (nonzero? s2-0)
      (set! (-> arg0 tfrag-masks) (new 'loading-level 'texture-masks-array (the-as int s2-0)))
      (set! (-> arg0 tfrag-closest) (the-as (pointer float) (malloc 'loading-level (the-as int (* s2-0 4)))))
      (let ((v1-5 (-> arg0 tfrag-masks)))
        (dotimes (a0-8 (the-as int s2-0))
          (let ((a1-24 (-> v1-5 data a0-8)))
            (dotimes (a2-34 3)
              (set! (-> a1-24 data a2-34 mask quad) (the-as uint128 0))
              )
            )
          )
        )
      )
    (when (nonzero? s3-0)
      (set! (-> arg0 shrub-masks) (new 'loading-level 'texture-masks-array (the-as int s3-0)))
      (set! (-> arg0 shrub-closest) (the-as (pointer float) (malloc 'loading-level (the-as int (* s3-0 4)))))
      (let ((v1-10 (-> arg0 shrub-masks)))
        (dotimes (a0-11 (the-as int s3-0))
          (let ((a1-32 (-> v1-10 data a0-11)))
            (dotimes (a2-36 3)
              (set! (-> a1-32 data a2-36 mask quad) (the-as uint128 0))
              )
            )
          )
        )
      )
    (when (nonzero? s4-0)
      (set! (-> arg0 alpha-masks) (new 'loading-level 'texture-masks-array (the-as int s4-0)))
      (set! (-> arg0 alpha-closest) (the-as (pointer float) (malloc 'loading-level (the-as int (* s4-0 4)))))
      (let ((v1-15 (-> arg0 alpha-masks)))
        (dotimes (a0-14 (the-as int s4-0))
          (let ((a1-40 (-> v1-15 data a0-14)))
            (dotimes (a2-38 3)
              (set! (-> a1-40 data a2-38 mask quad) (the-as uint128 0))
              )
            )
          )
        )
      )
    (when (nonzero? gp-0)
      (set! (-> arg0 water-masks) (new 'loading-level 'texture-masks-array (the-as int gp-0)))
      (set! (-> arg0 water-closest) (the-as (pointer float) (malloc 'loading-level (the-as int (* gp-0 4)))))
      (let ((v1-20 (-> arg0 water-masks)))
        (dotimes (a0-17 (the-as int gp-0))
          (let ((a1-48 (-> v1-20 data a0-17)))
            (dotimes (a2-40 3)
              (set! (-> a1-48 data a2-40 mask quad) (the-as uint128 0))
              )
            )
          )
        )
      )
    )
  0
  (none)
  )

;; og:preserve-this hand-landed: the decomp fails on the *artist-flip-visible*
;; lq/sq scratchpad loop (debug-only; dropped here). The vf16-31 background
;; register setup matches the original loads; on PC they only feed the commented
;; VU culling paths, but they are kept for fidelity with collect-stats/debug-draw.
(defmethod draw ((this bsp-header))
  "Draw the drawable, and typically its children.
   This usually means adding stuff to a list to be drawn later, rather than expensive drawing here."
  (rlet ((vf16 :class vf)
         (vf17 :class vf)
         (vf18 :class vf)
         (vf19 :class vf)
         (vf20 :class vf)
         (vf21 :class vf)
         (vf22 :class vf)
         (vf23 :class vf)
         (vf24 :class vf)
         (vf25 :class vf)
         (vf26 :class vf)
         (vf27 :class vf)
         (vf28 :class vf)
         (vf29 :class vf)
         (vf30 :class vf)
         (vf31 :class vf)
         )
    (let ((v1-0 (-> this level)))
      (when (-> v1-0 render?)
        (set! *draw-index* (-> v1-0 draw-index))
        (set! (-> *prototype-tie-work* mood) (-> v1-0 mood-context))
        (let ((v1-2 (view-get-active-math-camera)))
          (.lvf vf16 (&-> v1-2 plane 0 quad))
          (.lvf vf17 (&-> v1-2 plane 1 quad))
          (.lvf vf18 (&-> v1-2 plane 2 quad))
          (.lvf vf19 (&-> v1-2 plane 3 quad))
          (.lvf vf20 (&-> v1-2 shrub-mat rvec quad))
          (.lvf vf21 (&-> v1-2 shrub-mat uvec quad))
          (.lvf vf22 (&-> v1-2 shrub-mat fvec quad))
          (.lvf vf23 (&-> v1-2 shrub-mat trans quad))
          (.lvf vf24 (&-> v1-2 camera-rot rvec quad))
          (.lvf vf25 (&-> v1-2 camera-rot uvec quad))
          (.lvf vf26 (&-> v1-2 camera-rot fvec quad))
          (.lvf vf27 (&-> v1-2 camera-rot trans quad))
          (.lvf vf28 (&-> v1-2 camera-temp rvec quad))
          (.lvf vf29 (&-> v1-2 camera-temp uvec quad))
          (.lvf vf30 (&-> v1-2 camera-temp fvec quad))
          (.lvf vf31 (&-> v1-2 camera-temp trans quad))
          )
        (if (nonzero? (-> this drawable-trees))
            (draw (-> this drawable-trees))
            )
        )
      )
    )
  0
  (none)
  )

(defmethod collect-stats ((this bsp-header))
  "Collect triangle/perf statistics for rendering.
   This is only called when viewing stats.
   The vis-bits and culling registers are loaded during this time."
  (rlet ((vf16 :class vf)
         (vf17 :class vf)
         (vf18 :class vf)
         (vf19 :class vf)
         (vf20 :class vf)
         (vf21 :class vf)
         (vf22 :class vf)
         (vf23 :class vf)
         (vf24 :class vf)
         (vf25 :class vf)
         (vf26 :class vf)
         (vf27 :class vf)
         (vf28 :class vf)
         (vf29 :class vf)
         (vf30 :class vf)
         (vf31 :class vf)
         )
    (let ((v0-0 (view-get-active-math-camera)))
      (.lvf vf16 (&-> v0-0 plane 0 quad))
      (.lvf vf17 (&-> v0-0 plane 1 quad))
      (.lvf vf18 (&-> v0-0 plane 2 quad))
      (.lvf vf19 (&-> v0-0 plane 3 quad))
      (.lvf vf20 (&-> v0-0 shrub-mat rvec quad))
      (.lvf vf21 (&-> v0-0 shrub-mat uvec quad))
      (.lvf vf22 (&-> v0-0 shrub-mat fvec quad))
      (.lvf vf23 (&-> v0-0 shrub-mat trans quad))
      (.lvf vf24 (&-> v0-0 camera-rot rvec quad))
      (.lvf vf25 (&-> v0-0 camera-rot uvec quad))
      (.lvf vf26 (&-> v0-0 camera-rot fvec quad))
      (.lvf vf27 (&-> v0-0 camera-rot trans quad))
      (.lvf vf28 (&-> v0-0 camera-temp rvec quad))
      (.lvf vf29 (&-> v0-0 camera-temp uvec quad))
      (.lvf vf30 (&-> v0-0 camera-temp fvec quad))
      (.lvf vf31 (&-> v0-0 camera-temp trans quad))
      )
    (if (nonzero? (-> this drawable-trees))
        (collect-stats (-> this drawable-trees))
        )
    0
    (none)
    )
  )

;; jak1/jak2/jak3 each define this locally in whichever file first needs a real
;; 32-bit (not 64-bit dsll) shift; jakx's viewport-index scaling in bsp-camera-asm
;; below is the first jakx use, so it lands here rather than in collide-hash.gc
;; (#41; identical to jak1's font.gc:10 and jak2/jak3's collide-hash.gc:300)
(defmacro .sll (result in sa)
  `(set! ,result (sext32 (the-as int (shl (logand ,in #xffffffff) ,sa))))
  )

;; WARN: Return type mismatch int vs none.
;; ERROR: Failed load: (set! t2-2 (l.h (+ (the-as pointer t2-1) 2))) at op 46
;; ERROR: Unsupported inline assembly instruction kind - [sll a2, a2, 1]
;; ERROR: Unsupported inline assembly instruction kind - [srl t4, t4, 24]
;; ERROR: Unsupported inline assembly instruction kind - [srl t3, t3, 24]
(defun bsp-camera-asm ((arg0 bsp-header) (arg1 vector) (arg2 int))
  (local-vars
    (a2-1 int)
    (a3-1 int)
    (t0-0 uint128)
    (t0-1 uint128)
    (t0-2 uint128)
    (t0-3 uint128)
    (t1-5 uint)
    (t3-1 uint)
    (t4-1 int)
    (t5-0 uint128)
    (t6-0 uint128)
    (t7-0 uint128)
    (t8-0 uint128)
    )
  (rlet ((Q :class vf)
         (vf0 :class vf)
         (vf1 :class vf)
         (vf2 :class vf)
         (vf3 :class vf)
         )
    (init-vf0-vector)
    (let ((v1-0 (+ (the-as int arg0) arg2)))
      (.lvf vf3 (&-> arg0 bsp-scale quad))
      (.sll a2-1 arg2 1)
      (let ((a3-0 (the-as object (-> arg0 nodes)))
            (a2-2 (+ (the-as int arg0) a2-1))
            )
        (.lvf vf1 (&-> arg1 quad))
        (.lvf vf2 (&-> arg0 bsp-offset quad))
        (.sub.vf.xyz vf1 vf1 vf2)
        (.div.vf Q vf0 vf3 :fsf #b11 :ftf #b0)
        (.wait.vf)
        (.mul.vf.x vf1 vf1 Q)
        (.div.vf Q vf0 vf3 :fsf #b11 :ftf #b1)
        (.wait.vf)
        (.mul.vf.y vf1 vf1 Q)
        (.div.vf Q vf0 vf3 :fsf #b11 :ftf #b10)
        (.wait.vf)
        (.mul.vf.z vf1 vf1 Q)
        (let ((a0-1 #xffffff)
              (a1-1 0)
              )
          (vftoi15.xyzw vf1 vf1)
          (.mov t0-0 vf1)
          (.pw.sra t0-1 t0-0 15)
          (.ppach t0-2 (the-as uint128 0) t0-1)
          (.ppacb t0-3 (the-as uint128 0) t0-2)
          (let ((t0-4 (the-as uint128 (logand (the-as int t0-3) a0-1))))
            (label cfg-1)
            (let ((t2-1 (the-as object (&+ (the-as pointer a3-0) (+ (* a1-1 16) (* a1-1 4))))))
              (nop!)
              (let ((t4-0 (the-as uint128 (-> (the-as bsp-node t2-1) front-box-min clr))))
                (.pcgtb t7-0 t4-0 t0-4)
                (let ((t1-2 (the-as uint128 (-> (the-as bsp-node t2-1) front-box-max clr))))
                  (.pcgtb t5-0 t1-2 t0-4)
                  )
                (let ((t3-0 (the-as uint128 (-> (the-as bsp-node t2-1) back-box-min clr))))
                  (.pcgtb t8-0 t3-0 t0-4)
                  (let ((t1-3 (the-as uint128 (-> (the-as bsp-node t2-1) back-box-max clr))))
                    (.pcgtb t6-0 t1-3 t0-4)
                    )
                  (let* ((t1-4 (-> (the-as bsp-node t2-1) front))
                         (t7-1 (lognot (the-as int t7-0)))
                         (t8-1 (lognot (the-as int t8-0)))
                         (t5-1 (logand t7-1 (the-as int t5-0)))
                         (t6-1 (logand t8-1 (the-as int t6-0)))
                         (t5-2 (logand t5-1 a0-1))
                         (t6-2 (logand t6-1 a0-1))
                         )
                    ;(.srl t4-1 (the-as int t4-0) 24)
                    (set! t4-1 (logand #xffffffff (shr t4-0 24)))
                    ;; (l.h (&+ (the-as pointer t2-1) 2)) is the raw load the
                    ;; decompiler fell back to (see the "Failed load" note above);
                    ;; offset 2 on bsp-node is the declared "back" field
                    (let ((t2-2 (-> (the-as bsp-node t2-1) back)))
                      (b! (= t5-2 a0-1) cfg-4 :delay
                          ;(.srl t3-1 (the-as int t3-0) 24)
                          (set! t3-1 (the uint (logand #xffffffff (shr t3-0 24))))
                          )
                      (b! (= t6-2 a0-1) cfg-7 :delay (set! t1-5 (the-as uint 1)))
                      ;; s.b!/s.h! below are the decompiler's raw store notation
                      ;; (v1-0/a2-2 are int, not a declared pointer type, so no
                      ;; s.b!/s.h! method exists); (pointer uintN) casts stand in
                      (b! #t cfg-11 :delay (set! (-> (the-as (pointer uint8) (+ v1-0 336)) 0) t1-5))
                      (label cfg-4)
                      (b! (zero? t4-1) cfg-1 :likely-delay (set! a1-1 t1-4))
                      (let ((a0-2 a1-1))
                        (set! (-> (the-as (pointer uint8) (+ v1-0 340)) 0) 0)
                        (b! #t cfg-10 :delay (set! a3-1 t1-4))
                        (label cfg-7)
                        (b! (zero? t3-1) cfg-1 :likely-delay (set! a1-1 t2-2))
                        (set! a0-2 a1-1)
                        (let ((a1-2 1))
                          (set! a3-1 t2-2)
                          (set! (-> (the-as (pointer uint8) (+ v1-0 340)) 0) a1-2)
                          )
                        (label cfg-10)
                        (set! (-> (the-as (pointer uint16) (+ a2-2 320)) 0) a3-1)
                        (set! (-> (the-as (pointer uint16) (+ a2-2 328)) 0) a0-2)
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      (set! (-> (the-as (pointer uint8) (+ v1-0 336)) 0) 0)
      )
    (label cfg-11)
    0
    (none)
    )
  )

(defmethod debug-draw ((this bsp-header))
  "Debug-draw a drawable and its children. Typically uses the debug-draw functions."
  (rlet ((vf16 :class vf)
         (vf17 :class vf)
         (vf18 :class vf)
         (vf19 :class vf)
         (vf20 :class vf)
         (vf21 :class vf)
         (vf22 :class vf)
         (vf23 :class vf)
         (vf24 :class vf)
         (vf25 :class vf)
         (vf26 :class vf)
         (vf27 :class vf)
         (vf28 :class vf)
         (vf29 :class vf)
         (vf30 :class vf)
         (vf31 :class vf)
         )
    (let ((v1-0 (-> this level)))
      (set! *draw-index* (-> v1-0 draw-index))
      (set! (-> *prototype-tie-work* mood) (-> v1-0 mood-context))
      )
    (let ((v1-2 (view-get-active-math-camera)))
      (.lvf vf16 (&-> v1-2 plane 0 quad))
      (.lvf vf17 (&-> v1-2 plane 1 quad))
      (.lvf vf18 (&-> v1-2 plane 2 quad))
      (.lvf vf19 (&-> v1-2 plane 3 quad))
      (.lvf vf20 (&-> v1-2 shrub-mat rvec quad))
      (.lvf vf21 (&-> v1-2 shrub-mat uvec quad))
      (.lvf vf22 (&-> v1-2 shrub-mat fvec quad))
      (.lvf vf23 (&-> v1-2 shrub-mat trans quad))
      (.lvf vf24 (&-> v1-2 camera-rot rvec quad))
      (.lvf vf25 (&-> v1-2 camera-rot uvec quad))
      (.lvf vf26 (&-> v1-2 camera-rot fvec quad))
      (.lvf vf27 (&-> v1-2 camera-rot trans quad))
      (.lvf vf28 (&-> v1-2 camera-temp rvec quad))
      (.lvf vf29 (&-> v1-2 camera-temp uvec quad))
      (.lvf vf30 (&-> v1-2 camera-temp fvec quad))
      (.lvf vf31 (&-> v1-2 camera-temp trans quad))
      )
    (if (nonzero? (-> this drawable-trees))
        (debug-draw (-> this drawable-trees))
        )
    0
    (none)
    )
  )
