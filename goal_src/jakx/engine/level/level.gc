;; og:preserve-this bring-up racer levers (#152): off by default, no C-side boot arg.
;; *kernel-boot-cam-fly* is set by kmachine.cpp before this file's top-level even
;; runs (CamFlyBoot's -cam-fly arg parse, kmachine.cpp:140); extending that the same
;; way for the racer would need a kmachine.cpp change and a gk.exe rebuild, out of
;; scope for a GOAL-only landing. Arm from the REPL after boot instead:
;; (set! *jakx-racer* #t), then (jakx-racer-spawn) (entity.gc, needs
;; *jakx-want-driver-cp* already set by play's boot-cp branch above).
;;
;; Speed is meters/second, scaled by (seconds-per-frame) each tick (view-get-active
;; already proves with-pp/pp is safe from a bare defun like this one, not just
;; process methods) rather than assuming a fixed 60fps; 15 is a plausible bring-up
;; pace (54 km/h), not tuned against retail. cam-back/cam-height are the chase
;; camera's settable offset behind and above the racer's trans. Retires with the
;; real race/target/vehicle chain (#152 names the tiers).
(define *jakx-racer* #f)
(define *jakx-racer-speed* (meters 15))
;; og:preserve-this racer handle container (#152): *jakx-racer-handle* was a bare
;; handle-typed symbol. GOAL symbol value slots are 32 bits (IR_SetSymbolValue
;; emits store32 unconditionally, no size guard in goalc's IR.cpp), so the 64-bit
;; handle's pid half truncated silently on every store and handle->process could
;; never match the spawned process again. This was the only bare handle-typed
;; symbol in any game's tree; jak3's own retail equivalent
;; (goal_src/jak3/engine/target/gun/gun-yellow-shot.gc:1268,
;; *last-hit-deflect-target-handle*) sidesteps the same 32-bit truncation with a
;; (pointer process) cast instead. This container mirrors *additional-spawners*
;; (entity.gc) instead: a one-element 'static 'array of handle is a real 64-bit
;; field, not a symbol value slot, so it stores the full handle intact. The
;; explicit set! below is not optional: a zero-initialized static handle has
;; process=0, which is TRUTHY (0 is not the #f address), so handle->process on an
;; unarmed slot would dereference GOAL address 0 and return garbage instead of #f.
;; Arming with a real #f handle makes every pre-spawn read safely #f. Retires with
;; the real race/target/vehicle chain, same as the rest of this block (#152 names
;; the tiers).
(define *jakx-racer-handle* (new 'static 'array handle 1 (new 'static 'handle)))
(set! (-> *jakx-racer-handle* 0) (the-as handle #f))
(define *jakx-racer-target-index* 0)
(define *jakx-racer-cam-back* (meters 8))
(define *jakx-racer-cam-height* (meters 4))
;; last frame's movement direction, 3D-normalized; only x/z are ever consumed, and
;; jakx-racer-cam-tick! re-normalizes them in the horizontal plane before use. Seeds
;; the chase offset and survives the racer being momentarily stationary (arrival
;; snap frame)
(define *jakx-racer-heading* (new 'static 'vector :z 1.0 :w 1.0))

