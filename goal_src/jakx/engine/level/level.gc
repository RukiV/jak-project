           (dotimes (v1-10 2)
             (set! (-> s4-0 current-vis-string v1-10) (the-as uint -1))
             (set! (-> s4-0 vis-bits v1-10) (the-as uint (-> this vis-bits v1-10)))
             )
           (if (= (-> s4-0 from-level) (-> this load-name))
               (set! (-> s4-0 from-bsp) (-> this bsp))
               (set! (-> s4-0 from-bsp) #f)
               )
