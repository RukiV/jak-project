        (case (rtype-of a0-80)
          ((symbol)
           (unload (symbol->string (the-as symbol a0-80)))
           )
          ((string)
           (unload (the-as string a0-80))
           )
          )
        (set! s5-6 (cdr s5-6))
        (set! a0-80 (car s5-6))
        )
      )
    (vis-clear this)
    (let ((v1-145 (-> this heap)))
      (set! (-> v1-145 current) (-> v1-145 base))
