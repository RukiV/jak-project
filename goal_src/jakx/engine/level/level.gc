    (dotimes (v1-264 3)
      ;; og:preserve-this cast: &- yields int, the field wants pointer
      (set! (-> arg0 heap top-base)
            (the-as pointer (&- (-> arg0 heap top-base) (the-as uint (shl (-> arg0 info borrow borrow-size v1-264) 10))))
            )
      (set! (-> arg0 heap top) (-> arg0 heap top-base))
      (let ((a0-118 (-> arg0 borrow-heap v1-264)))
        (set! (-> a0-118 base) (-> arg0 heap top))
        (set! (-> a0-118 current) (-> a0-118 base))
        (set! (-> a0-118 top-base) (&+ (-> a0-118 base) (shl (-> arg0 info borrow borrow-size v1-264) 10)))
        (set! (-> a0-118 top) (-> a0-118 top-base))
        )
      )
    )
  (set! (-> arg0 draw-priority) (-> arg0 info draw-priority))
  (set! (-> arg0 status) 'loaded)
  (do-nothing *level*)
  (set! loading-level global)
  (set! (-> *level* loading-level) (-> *level* level-default))
  (set! *level-type-list* (the-as type 0))
  (set! (-> *level* log-in-level-bsp) #f)
  (set! (-> arg0 load-stop-time) (the-as uint (if (nonzero? *display*) (-> *display* real-clock frame-counter) 0)))
  0
  (.mfc0 v1-278 Count)
  (- v1-278 s5-0)
  (set! (-> *level* load-login-time)
        (* 0.016666668 (the float (- (if (nonzero? *display*) (-> *display* real-clock integral-frame-counter) 0) *dgo-time*)))
        )
  (label cfg-130)
  arg0
  )

;; definition for method 25 of type level
;; INFO: Used lq/sq
(defmethod birth ((this level))
  (with-pp
    (case (-> this status)
      (('loaded)
       (let ((s5-0 loading-level)
             (s4-0 (-> *level* loading-level))
             (s3-0 (-> *level* log-in-level-bsp))
             (s2-1 *level-type-list*)
             )
         (let ((s1-0 (not (-> this entity))))
           (set! loading-level (-> this heap))
           (set! (-> *level* log-in-level-bsp) (-> this bsp))
           (set! (-> *level* loading-level) this)
           (set! *level-type-list* (the-as type (&-> this level-type)))
           (cond
             ((valid? (-> this bsp light-hash) light-hash (the-as string #f) #t 0)
              (set! (-> this light-hash) (-> this bsp light-hash))
              )
             (else
               (set! (-> this light-hash) (the-as light-hash 0))
               0
               )
             )
           (birth (-> this bsp))
           (set! (-> this status) 'alive)
           (do-nothing *level*)
           (set! (-> this render?) #t)
           ;; og:preserve-this guarded dynamic call: game-info methods are not landed
           ;; (empty slot would jump to 0); the original also passes *game-info* (the
           ;; decomp dropped the arg).
           (let ((m15 (method-of-object *game-info* game-info-method-15)))
             (if (nonzero? (the-as int m15))
                 ((the-as (function game-info none) m15) *game-info*)
                 )
             )
           (dotimes (s0-0 2)
             (let ((sv-112 (new 'stack-no-clear 'event-message-block)))
               (set! (-> sv-112 from) (process->ppointer pp))
               (set! (-> sv-112 num-params) 1)
               (set! (-> sv-112 message) 'level-activate)
               (set! (-> sv-112 param 0) (the-as uint (-> this name)))
               (send-event-function (view-get-camera s0-0) sv-112)
               )
             (let ((sv-144 (new 'stack-no-clear 'event-message-block)))
               (set! (-> sv-144 from) (process->ppointer pp))
               (set! (-> sv-144 num-params) 1)
               (set! (-> sv-144 message) 'level-activate)
               (set! (-> sv-144 param 0) (the-as uint (-> this name)))
               (send-event-function (view-get-target s0-0) sv-144)
               )
             )
           (when s1-0
             (let ((s1-1 (get-callback-symbol-value-by-slot! (-> this info) 32)))
               (if (and s1-1 (type? s1-1 function))
                   ((the-as (function level object) s1-1) this)
                   )
               )
             )
           )
         (let ((s1-2 (-> this status)))
           (set! (-> this status) 'active)
           (do-nothing *level*)
           (update-task-masks 'level)
           (assign-draw-indices *level*)
           (update-car-texture-anim-array)
           (let ((s0-1 (-> this bsp nav-meshes)))
             (when (nonzero? s0-1)
               (let ((sv-160 0))
                 (while (< sv-160 (-> s0-1 length))
                   (birth! (-> s0-1 sv-160))
                   (+! sv-160 1)
                   )
                 )
               )
             )
           (let ((s0-2 (get-callback-symbol-value-by-slot! (-> this info) 34)))
             (if (and s0-2 (type? s0-2 function))
                 ((the-as (function level symbol object) s0-2) this 'display)
                 )
             )
           (format 0 "birth level - doing network things~%")
           ((method-of-type entity-more-perm-hash entity-more-perm-hash-method-13)
            (the-as entity-more-perm-hash *entity-more-perm*)
            this
            )
           (tweak-local-net-entities)
           (set! (-> this status) s1-2)
           )
         (set! loading-level s5-0)
         (set! (-> *level* loading-level) s4-0)
         (set! (-> *level* log-in-level-bsp) s3-0)
         (set! *level-type-list* s2-1)
         )
       )
      )
    this
    )
  )

;; og:preserve-this forward decls for the racer subsystem (#193): the
;; level-deactivate racer hook below is far earlier in this file than the
;; *jakx-racer* lever block it needs (~line 3050+), and GOAL requires a symbol
;; declared before use within a file same as across files; jakx-racer-spawn and
;; *additional-spawner-count* additionally live in entity.gc, which builds
;; after level.gc in game.gd (entity.gc:329 vs level.gc:267). Same forward-decl
;; shape as entity.gc's own skel-jungle-clay-jar-a extern. The last four are the
;; #193 rework's deferred-respawn record (see the racer lever block below for
;; why they are plain fields, not a handle container): the hook only arms them,
;; jakx-racer-tick is the sole consumer and is declared after they are, so it
;; needs no forward decl of its own.
(define-extern jakx-racer-spawn (function none))
(define-extern *additional-spawner-count* int)
(define-extern *jakx-racer* symbol)
(define-extern *jakx-racer-handle* (pointer handle))
(define-extern *jakx-racer-track-index* int)
(define-extern *jakx-racer-respawn-pending* symbol)
(define-extern *jakx-racer-respawn-trans* vector)
(define-extern *jakx-racer-respawn-track-index* int)
(define-extern *jakx-racer-respawn-exclude-level* symbol)

;; definition for method 9 of type level
;; INFO: Used lq/sq
(defmethod deactivate ((this level))
  (case (-> this status)
    (('active 'alive)
     (format 0 "----------- deactivate(kill) ~A (status ~A)~%" this (-> this status))
     (let ((s5-0 (get-callback-symbol-value-by-slot! (-> this info) 35)))
       (if (and s5-0 (type? s5-0 function))
           ((the-as (function level object) s5-0) this)
           )
       )
     ;; og:preserve-this bring-up guard: *game-info* is a real define-perm static
     ;; (game-info-h.gc), but game-info.gc is a stub, so vtable slot 14 is null and the
     ;; dispatch was a call through zero (lldb: RIP == arena base, first-ever live
     ;; deactivate). Guard the SLOT, not the object. Note the machine output also
     ;; dropped this call's arguments, the known placeholder-sig trap
     ;; (game-info-method-14 is declared () none); re-derive the call site from the
     ;; asm when game-info.gc lands.
     (let ((t9-gi14 (method-of-object *game-info* game-info-method-14)))
       (if (nonzero? (the-as int t9-gi14))
           (t9-gi14)
           )
       )
     (dotimes (s5-1 *view-count*)
       (send-event (view-get-target s5-1) 'level-deactivate (-> this name))
       )
     (remove-by-param1 *background-draw-engine* (the-as int (-> this bsp)))
     ;; og:preserve-this bring-up racer level-lifecycle guard (#193, reworked):
     ;; the racer manipy (#152's placeholder, jakx-racer-spawn in entity.gc) has
     ;; no entity and no level of its own, so #162's cross-level art resolution
     ;; (process-drawable.gc:619+, landed a95b237a2) homes it on whichever
     ;; currently-resident level happens to hold jungle-clay-jar-a-ag, writing
     ;; that level into the process's own level field. That level has no more
     ;; claim on the racer than any other resident copy holding the same art
     ;; group, but when the want-driver window later discards it, the next level
     ;; loaded into the identical heap slot has its DGO stream overwrite the
     ;; adopted frame-group in place, and the racer's very next
     ;; (ja :num! (loop!)) reads through the overwritten art header and crashes
     ;; in num-func-loop! (issue #193 root-cause doc, sections 1-2). Nothing else
     ;; in jakx protects a process homed this way: deactivate-entities below only
     ;; walks entity-actor tables (the racer has none), and joint-control-cleanup
     ;; (engine/anim/joint.gc) has zero callers in jakx. Guard: only fires when a
     ;; live racer exists AND this is the exact level it adopted art from, so
     ;; every other level's deactivate is a no-op handle read. Kill it through
     ;; the real process deactivate (not a raw free) so draw-control/skel/
     ;; node-list all get torn down together.
     ;;
     ;; The respawn is deferred, not inline, and that is the rework: the first
     ;; landing called jakx-racer-spawn right here, but at this point in
     ;; deactivate this level's status has not yet moved past 'active (this
     ;; method only sets it to 'shutdown, and back to 'loaded, much further
     ;; down), so the level is still a walkable resident and #162's donor scan
     ;; (art-group-get-by-name) re-picks THIS SAME level as the racer's "new"
     ;; donor. Proven by replay (gk-racer193.log:2496-2499): the immediately
     ;; respawned racer logged the same donor level name (junglea), the same
     ;; root-channel frame-group address (#x1be84d4) and the same heap range
     ;; (#x1aeea20, #x1fdaa20) as the process that was just killed, so the JGC
     ;; DGO stream that follows overwrites the new racer's art exactly like it
     ;; did the old one and the crash still fires. Instead of respawning here,
     ;; capture the racer's trans, track index, and this level's own name, then
     ;; arm *jakx-racer-respawn-pending*: jakx-racer-tick (level-update, once per
     ;; frame) holds off until this level's name no longer appears at status
     ;; 'active or 'alive anywhere in *level*, which is the only condition that
     ;; actually proves the donor scan cannot land back on this heap (see that
     ;; function's own comment for the walk). This is bring-up tooling riding a
     ;; retail method: the racer is a dev puppet; retail behavior is unaffected
     ;; by this bug and by this hook, since retail never spawns a parentless,
     ;; entity-less, level-arted manipy. Retires with the real vehicle chain
     ;; replacing the puppet (#152 names the tiers).
     (let ((racer-proc (the-as process-drawable (handle->process (-> *jakx-racer-handle* 0)))))
       (when (and racer-proc (= (-> racer-proc level) this))
         (set! (-> *jakx-racer-respawn-trans* quad) (-> racer-proc root trans quad))
         (set! *jakx-racer-respawn-track-index* *jakx-racer-track-index*)
         (set! *jakx-racer-respawn-exclude-level* (-> this name))
         (format 0 "racer: donor level ~A deactivating, killing racer, deferring respawn~%" (-> this name))
         (deactivate racer-proc)
         (set! (-> *jakx-racer-handle* 0) (the-as handle #f))
         (set! *additional-spawner-count* 0)
         (set! *jakx-racer-respawn-pending* *jakx-racer*)
         )
       )
     (let ((s5-2 (-> this status)))
       (set! (-> this status) 'shutdown)
       (do-nothing *level*)
       (deactivate-entities (-> this bsp))
       (set! (-> this status) s5-2)
       )
     (set! (-> this inside-boxes?) #f)
     (set! (-> this meta-inside?) #f)
     (set! (-> this force-inside?) #f)
     (set! (-> this display?) #f)
     (set! (-> this status) 'loaded)
     (do-nothing *level*)
     (set! (-> this light-hash) (the-as light-hash 0))
     (set! (-> this all-visible?) 'loading)
     (when (-> this vis-bits 0)
       (dotimes (v1-30 128)
         (dotimes (a0-15 2)
           ;; og:preserve-this cast, same as jak3's vis-clear
           (set! (-> (the-as (pointer int128) (&+ (-> this vis-bits a0-15) (* v1-30 16)))) (the int128 0))
           )
         )
       )
     (countdown (v1-33 8)
       (let ((a0-20 (-> this vis-info v1-33)))
         (when a0-20
           (dotimes (a1-12 2)
             (set! (-> a0-20 current-vis-string a1-12) (the-as uint -1))
             )
           )
         )
       )
     (when (logtest? (-> this info base-task-mask) (task-mask primary0))
       (let ((v1-40 (task-mask)))
         (dotimes (a0-22 (-> *level* length))
           (let ((a1-17 (-> *level* level a0-22)))
             (if (= (-> a1-17 status) 'active)
                 (set! v1-40 (logior v1-40 (logand (-> a1-17 info base-task-mask) (task-mask primary0))))
                 )
             )
           )
         (when (not (logtest? v1-40 (task-mask primary0)))
           (dotimes (v1-43 (-> *level* length))
             (let ((a0-28 (-> *level* level v1-43)))
               (if (= (-> a0-28 status) 'active)
                   (logior! (-> a0-28 task-mask) (task-mask primary0))
                   )
               )
             )
           )
         )
       )
     )
    )
  (if (= (-> *level* log-in-level-bsp) (-> this bsp))
      (set! (-> *level* log-in-level-bsp) #f)
      )
  (if *speech-control*
      (speech-control-method-15 *speech-control* (-> this heap))
      )
  this
  )

;; definition for method 10 of type level
(defmethod unload! ((this level))
  ((method-of-type entity-more-perm-hash entity-more-perm-hash-method-14)
   (the-as entity-more-perm-hash *entity-more-perm*)
   this
   )
  (deactivate this)
  (cond
    ((= (-> *level* wide-level 0) this)
     (format 0 "logout wide-level 0 ~s~%" (-> this name))
     (set! (-> *level* wide-level 0) #f)
     )
    ((= (-> *level* wide-level 1) this)
     (format 0 "logout wide-level 1 ~s~%" (-> this name))
     (set! (-> *level* wide-level 1) #f)
     )
    (else
      (prototype-node-group-method-13 (-> *level* shared-ties) this)
      )
    )
  (when (and (not (-> *level* wide-level 0)) (not (-> *level* wide-level 1)))
    (format 0 "reset shared ties ~S~%" (-> this name))
    (prototype-node-group-method-9 (-> *level* shared-ties))
    )
  (when (!= (-> this status) 'inactive)
    (dotimes (s5-0 3)
      (when (-> this borrow-level s5-0)
        (unload! (-> this borrow-level s5-0))
        (set! (-> this borrow-level s5-0) #f)
        )
      )
    (when (-> this borrow-from-level)
      (dotimes (v1-41 3)
        (if (= this (-> this borrow-from-level borrow-level v1-41))
            (set! (-> this borrow-from-level borrow-level v1-41) #f)
            )
        )
      (set! (-> this borrow-from-level) #f)
      )
    (case (-> this status)
      (('loading 'loading-bt)
       (dgo-load-cancel (the-as int (-> this load-id)))
       (link-reset)
       )
      (('alive 'active 'loaded)
       (when (-> this entity)
         (let ((s5-1 (the-as (function level object) (get-callback-symbol-value-by-slot! (-> this info) 33))))
           (if (and s5-1 (type? s5-1 function))
               (s5-1 this)
               )
           )
         )
       )
      )
    (when (or (= (-> this status) 'loaded)
              (= (-> this status) 'alive)
              (= (-> this status) 'active)
              (= (-> this status) 'login)
              )
      (dotimes (s5-2 (-> this art-group art-group-array length))
        (let ((s4-0 (-> this art-group art-group-array s5-2)))
          (if (contains-art-for-other-group? s4-0)
              (unlink-art-to-master s4-0)
              )
          (art-method-10 s4-0)
          )
        )
      (case (-> this status)
        (('alive 'active 'loaded)
         (let* ((s5-3 (-> this info callback-list))
                (v1-79 (car s5-3))
                )
           (while (not (null? s5-3))
             (let ((s4-1 (/ (the-as int (car v1-79)) 8))
                   (v1-80 (cdr v1-79))
                   )
               (when (and (< (the-as uint 1) s4-1) (< s4-1 (the-as uint 12)))
                 (if (nonzero? (-> (the-as symbol v1-80) value))
                     (set! (-> this texture-anim-array (+ s4-1 -2))
                           (clear! (the-as texture-anim-array (-> (the-as symbol v1-80) value)))
                           )
                     )
                 )
               )
             (set! s5-3 (cdr s5-3))
             (set! v1-79 (car s5-3))
             )
           )
         )
        )
      )
    (set! (-> this bsp) #f)
    (set! (-> this entity) #f)
    (set! (-> this status) 'inactive)
    (do-nothing *level*)
    (set! (-> this linking) #f)
    (set! (-> this art-group string-array length) 0)
    (set! (-> this art-group art-group-array length) 0)
    (set! (-> this mem-usage-block) (the-as memory-usage-block 0))
    (set! (-> this mem-usage) 0)
    (set! (-> this part-engine) #f)
    (dotimes (v1-94 4)
      (set! (-> this user-object v1-94) #f)
      )
    (dotimes (v1-97 11)
      (set! (-> this texture-anim-array v1-97) #f)
      )
    (countdown (s5-4 (-> this loaded-texture-page-count))
      (dotimes (v1-100 32)
        (when (= (-> this loaded-texture-page s5-4) (-> *texture-pool* common-page v1-100))
          (set! (-> *texture-pool* common-page v1-100) (the-as texture-page 0))
          0
          )
        )
      (unload-page *texture-pool* (-> this loaded-texture-page s5-4))
      )
    (set! (-> this loaded-texture-page-count) 0)
    (if (and (< (-> this index) 6) (< 17 (-> this index)))
        (unlink-shaders-in-heap *texture-page-dir* (-> this heap))
        (unlink-textures-by-level this)
        )
    (unlink-part-group-by-heap (-> this heap))
    (unlink-lightning-spec-by-heap (-> this heap))
    (particle-adgif-cache-flush)
    (dotimes (v1-115 11)
      (set! (-> this texture-page-dir v1-115 page) #f)
      )
    (set! (-> this loaded-text-info-count) 0)
    ;; og:preserve-this bring-up guard: *art-control* is defined by the unlanded
    ;; jakx car-art/loader object; unbound it reads 0 and the buffer deref faults
    ;; on the first level unload. Drop the guard when its home lands.
    (when (nonzero? *art-control*)
      (dotimes (s5-5 2)
        (let ((v1-121 (-> *art-control* buffer s5-5 pending-load-file)))
          (if (and (>= (the-as int v1-121) (the-as int (-> this heap base)))
                   (< (the-as int v1-121) (the-as int (-> this heap top-base)))
                   )
              (set-pending-file (-> *art-control* buffer s5-5) (the-as string #f) -1 (the-as handle #f) 100000000.0)
              )
          )
        )
      )
    (let ((v1-130 0)
          (a0-79 0)
          (a1-24 (-> this level-type))
          )
      (while a1-24
        (+! a0-79 1)
        (+! v1-130 (-> a1-24 psize))
        (set! (-> a1-24 symbol value) (the-as object 0))
        (set! a1-24 (the-as type (-> a1-24 method-table 8)))
        )
      )
    (let* ((s5-6 (-> this info packages))
           (a0-80 (car s5-6))
           )
      (while (not (null? s5-6))
        (case (rtype-of a0-80)
          ((symbol)
           (unload (symbol->string (the-as symbol a0-80)))
           )
          ((string)
           (unload (the-as string a0-80))
           )
          )
        (set! s5-6 (cdr s5-6))
        (set! a0-80 (car s5-6))
        )
      )
    (vis-clear this)
    (let ((v1-145 (-> this heap)))
      (set! (-> v1-145 current) (-> v1-145 base))
      )
    (set! (-> this memory-mask) (the-as uint 0))
    (set! (-> this code-memory-start) (the-as pointer 0))
    (set! (-> this code-memory-end) (the-as pointer 0))
    (set! (-> this level-type) #f)
    (when (= (-> *level* loading-level) this)
      (set! loading-level global)
      (set! (-> *level* loading-level) (-> *level* level-default))
      (set! (-> *level* log-in-level-bsp) #f)
      (set! *level-type-list* (the-as type 0))
      0
      )
    (assign-draw-indices *level*)
    )
  this
  )

;; og:preserve-this method 11 lands transcribed from jak3's hand-written
;; version (jak3/engine/level/level.gc:2428-2451), swapping jakx's per-view
;; vis-bits array ((vis-bits pointer 2), level-h.gc:648) in for jak3's flat
;; vis-bits pointer. The commented decode this replaced computed a raw
;; immediate of 516 for the per-view load, one slot short of vis-bits'
;; declared offset of 520; that immediate is not trustworthy evidence, since
;; the decompiler failed type prop on the very instruction it came from
;; ("failed type prop at 5: Could not figure out load"), the same failure
;; class inside-bsp? hit before the fix documented below. The real layout is
;; pinned instead by walking the deftype backward from the two fixed anchors
;; vis-info (540) and vis-self-index (572, since 572 = 540 + 8*4 with no
;; gap): linking lands at 536, force-all-visible? at 532, all-visible? at
;; 528, vis-bits at 520-527 and mood-init at 516, and jak3's own field
;; sequence (mood-context, mood-func, mood-init, vis-bits, all-visible?)
;; carries mood-init immediately before vis-bits too, confirming the order.
;; jak3's landed method 11 itself carries a stale raw-asm comment ("lwu v1,
;; 388(a0)") matching none of jak3's own field offsets (its vis-bits sits at
;; 2472), so asm-comment immediates are decoration, not ground truth; this
;; body reads vis-bits by field name only, so it stays correct under the
;; type system regardless of the above. Retire this note if vis-bits ever
;; moves and the layout reasoning needs re-verification.
(defmethod is-object-visible? ((this level) (arg0 int) (arg1 int))
  "Is drawable arg0 visible? Note that this will return #f if the visibility data is not loaded."
  (let* ((vis-data (-> this vis-bits arg1))
         (byte-idx (sar arg0 3))
         (vis-byte (-> (the (pointer int8) vis-data) byte-idx))
         (bit-idx (logand arg0 #b111))
         (shift-amount (+ bit-idx 56))
         (check-sign-word (the int (shl vis-byte shift-amount)))
         )
    (< check-sign-word 0)
    )
  )

;; og:preserve-this machine offset 336 on bsp-header is cam-outside-bsp-view
;; (declared 340; bsp-h.gc:161), the jakx per-view twin of jak3's scalar
;; cam-outside-bsp (jak3 level.gc:2453-2466). This method originally landed
;; reading cam-using-back-view, the pre-fix name carried over from before
;; f4b0778c0's bsp-header name-swap fix even though this landing postdates
;; that fix; fixed here to match jak3's twin (#41). update-level-inside-boxes
;; (level.gc:4081) is its live caller and sole consumer, feeding inside-boxes?
;; and through it vis-valid.
(defmethod inside-bsp? ((this level))
  (cond
    ((not (-> this bsp))
     #f
     )
    ((-> this force-inside?)
     #t
     )
    (else
      (let ((result #f))
        (dotimes (i (the-as int (-> *viewport-array* num-viewports)))
          (if (zero? (-> this bsp cam-outside-bsp-view i))
              (set! result #t)
              )
          )
        result
        )
      )
    )
  )

;; definition for method 20 of type level
;; WARN: Return type mismatch int vs none.
(defmethod debug-print-region-splitbox ((this level) (arg0 vector) (arg1 object))
  (cond
    ((or (not (-> this bsp)) (zero? (-> this bsp region-tree)))
     )
    ((nonzero? (-> this bsp region-tree))
     (debug-print (-> this bsp region-tree) arg0 arg1)
     )
    )
  0
  (none)
  )

;; definition for method 8 of type level
(defmethod mem-usage ((this level) (usage memory-usage-block) (flags int))
  (when (= (-> this status) 'active)
    (set! (-> usage length) (max 67 (-> usage length)))
    (set! (-> usage data 66 name) "entity-links")
    (+! (-> usage data 66 count) (-> this entity length))
    (let ((v1-8 (asize-of (-> this entity))))
      (+! (-> usage data 66 used) v1-8)
      (+! (-> usage data 66 total) (logand -16 (+ v1-8 15)))
      )
    (mem-usage (-> this art-group) usage flags)
    (set! (-> usage length) (max 66 (-> usage length)))
    (set! (-> usage data 65 name) "level-code")
    (+! (-> usage data 65 count) 1)
    (let ((v1-20 (&- (-> this code-memory-end) (the-as uint (-> this code-memory-start)))))
      (+! (-> usage data 65 used) v1-20)
      (+! (-> usage data 65 total) (logand -16 (+ v1-20 15)))
      )
    (countdown (s3-0 (-> this loaded-texture-page-count))
      (mem-usage (-> this loaded-texture-page s3-0) usage flags)
      )
    (countdown (s3-1 (-> this loaded-text-info-count))
      (mem-usage (-> this loaded-text-info s3-1) usage flags)
      )
    (countdown (s3-2 8)
      (let ((s2-0 (-> this vis-info s3-2)))
        (when s2-0
          (cond
            ((zero? s3-2)
             (set! (-> usage length) (max 62 (-> usage length)))
             (set! (-> usage data 61 name) "bsp-leaf-vis-self")
             (+! (-> usage data 61 count) 1)
             (let ((v1-47 (+ (asize-of s2-0) (-> s2-0 allocated-length))))
               (+! (-> usage data 61 used) v1-47)
               (+! (-> usage data 61 total) (logand -16 (+ v1-47 15)))
               )
             )
            (else
              (set! (-> usage length) (max 63 (-> usage length)))
              (set! (-> usage data 62 name) "bsp-leaf-vis-adj")
              (+! (-> usage data 62 count) 1)
              (let ((v1-58 (+ (asize-of s2-0) (-> s2-0 allocated-length))))
                (+! (-> usage data 62 used) v1-58)
                (+! (-> usage data 62 total) (logand -16 (+ v1-58 15)))
                )
              )
            )
          )
        )
      )
    (mem-usage (-> this bsp) usage flags)
    )
  this
  )

;; definition for method 21 of type level-group
;; WARN: Return type mismatch int vs none.
(defmethod init-level-system ((this level-group) (arg0 symbol))
  (when (zero? (-> *level* heap base))
    (kmemopen global "level-heaps")
    (when (nmember "game" *kernel-packages*)
      (set! *kernel-packages* (cons "art" *kernel-packages*))
      (set! *kernel-packages* (cons "common" *kernel-packages*))
      )
    (load-package "art" global)
    (if arg0
        (load-package "common" global)
        )
    (let ((s3-0 (if (and arg0 (not *debug-segment*))
                    #x348000
                    #x690000
                    )
                )
          (s4-0 (-> this car-heap))
          )
      (set! (-> s4-0 base) (kmalloc global s3-0 (kmalloc-flags) "heap"))
      (set! (-> s4-0 current) (-> s4-0 base))
      (set! (-> s4-0 top-base) (&+ (-> s4-0 base) s3-0))
      (set! (-> s4-0 top) (-> s4-0 top-base))
      )
    (let ((s3-1 (if (and arg0 (not *debug-segment*))
                    #xbd0000
                    #xbd0000
                    )
                )
          (s4-1 (-> this heap))
          )
      (set! (-> s4-1 base) (kmalloc global s3-1 (kmalloc-flags) "heap"))
      (set! (-> s4-1 current) (-> s4-1 base))
      (set! (-> s4-1 top-base) (&+ (-> s4-1 base) s3-1))
      (set! (-> s4-1 top) (-> s4-1 top-base))
      )
    (let ((s3-2 (if (and arg0 (not *debug-segment*))
                    #x11d000
                    #x23a000
                    )
                )
          (s4-2 (-> this driver-heap))
          )
      (set! (-> s4-2 base) (kmalloc global s3-2 (kmalloc-flags) "heap"))
      (set! (-> s4-2 current) (-> s4-2 base))
      (set! (-> s4-2 top-base) (&+ (-> s4-2 base) s3-2))
      (set! (-> s4-2 top) (-> s4-2 top-base))
      )
    (when (not (and arg0 (not *debug-segment*)))
      (let ((s5-1 #x600000)
            (gp-1 (-> this cars-heap))
            )
        (set! (-> gp-1 base) (kmalloc global s5-1 (kmalloc-flags) "heap"))
        (set! (-> gp-1 current) (-> gp-1 base))
        (set! (-> gp-1 top-base) (&+ (-> gp-1 base) s5-1))
        (set! (-> gp-1 top) (-> gp-1 top-base))
        )
      )
    (kmemclose)
    )
  0
  (none)
  )

;; definition for method 10 of type level-group
(defmethod level-get-with-status ((this level-group) (arg0 symbol))
  (dotimes (v1-0 (-> this length))
    (if (= (-> this level v1-0 status) arg0)
        (return (-> this level v1-0))
        )
    )
  (the-as level #f)
  )

;; definition for method 33 of type level-group
(defmethod level-group-method-33 ((this level-group))
  (dotimes (v1-0 (-> this length))
    (case (-> this level v1-0 status)
      (('inactive)
       (return (-> this level v1-0))
       )
      )
    )
  (dotimes (v1-6 (-> this length))
    (case (-> this level v1-6 status)
      (('loading 'loading-bt)
       (return (-> this level v1-6))
       )
      )
    )
  (dotimes (v1-12 (-> this length))
    (case (-> this level v1-12 status)
      (('loaded)
       (return (-> this level v1-12))
       )
      )
    )
  (let ((v0-0 (the-as level #f)))
    (dotimes (v1-18 (-> this length))
      (case (-> this level v1-18 status)
        (('active)
         (if (and (not (-> this level v1-18 inside-boxes?)) (not v0-0))
             (set! v0-0 (-> this level v1-18))
             )
         )
        )
      )
    v0-0
    )
  )

;; definition for method 32 of type level-group
(defmethod level-group-method-32 ((this level-group))
  (dotimes (v1-0 (-> this length))
    (if (and (!= (-> this level v1-0 status) 'inactive)
             (nonzero? (-> this level v1-0 info))
             (logtest? (level-flags ocean-all) (-> this level v1-0 info level-flags))
             )
        (return (-> this level v1-0))
        )
    )
  (the-as level #f)
  )

;; definition for method 9 of type level-group
(defmethod level-get ((this level-group) (arg0 symbol))
  (when arg0
    (dotimes (v1-0 (-> this length))
      (if (and (!= (-> this level v1-0 status) 'inactive)
               (or (= (-> this level v1-0 name) arg0) (= (-> this level v1-0 load-name) arg0))
               )
          (return (-> this level v1-0))
          )
      )
    (the-as level #f)
    )
  )

;; definition for method 22 of type level-group
(defmethod art-group-get-by-name ((this level-group) (arg0 string) (arg1 (pointer level)))
  (countdown (s4-0 19)
    (let ((s3-0 (-> *level* level s4-0)))
      (when (or (= (-> s3-0 status) 'active) (= (-> s3-0 status) 'reserved))
        (countdown (s2-0 (-> s3-0 art-group art-group-array length))
          (when (name= (-> s3-0 art-group art-group-array s2-0 name) arg0)
            (if arg1
                (set! (-> arg1 0) s3-0)
                )
            (return (-> s3-0 art-group art-group-array s2-0))
            )
          )
        )
      )
    )
  (the-as art-group #f)
  )

;; definition for method 13 of type level-group
(defmethod activate-levels! ((this level-group))
  (dotimes (s5-0 (-> this length))
    (level-status-update! (-> this level s5-0) 'active)
    )
  0
  )

;; definition for method 20 of type level-group
(defmethod level-get-target-inside ((this level-group))
  (let ((s5-0 (target-get-any-pos)))
    (let ((v1-1 (-> *load-state* vis-nick)))
      (when v1-1
        (dotimes (a0-2 (-> this length))
          (let ((a1-3 (-> this level a0-2)))
            (when (= (-> a1-3 status) 'active)
              (if (and (= (-> a1-3 name) v1-1) (not (logtest? (-> a1-3 info level-flags) (level-flags not-physical))))
                  (return a1-3)
                  )
              )
            )
          )
        )
      )
    (let ((v1-6 (-> *game-info* player-info (view-get-active-index) current-continue level)))
      (dotimes (a0-4 (-> this length))
        (let ((a1-8 (-> this level a0-4)))
          (when (= (-> a1-8 status) 'active)
            (if (and (= (-> a1-8 name) v1-6) (not (logtest? (-> a1-8 info level-flags) (level-flags not-physical))))
                (return a1-8)
                )
            )
          )
        )
      )
    (let ((s4-1 (the-as level #f)))
      (let ((f30-0 0.0))
        (dotimes (s3-0 (-> this length))
          (let ((s2-0 (-> this level s3-0)))
            (when (= (-> s2-0 status) 'active)
              (let ((f0-0 (vector-vector-distance (-> s2-0 bsp bsphere) s5-0)))
                (if (and (-> s2-0 inside-boxes?)
                         (not (logtest? (-> s2-0 info level-flags) (level-flags not-physical)))
                         (or (not s4-1) (< f0-0 f30-0))
                         )
                    (set! s4-1 s2-0)
                    )
                )
              )
            )
          )
        )
      (if s4-1
          (return s4-1)
          )
      )
    )
  (dotimes (v1-27 (-> this length))
    (let ((a0-10 (-> this level v1-27)))
      (when (= (-> a0-10 status) 'active)
        (if (and (-> a0-10 meta-inside?) (not (logtest? (-> a0-10 info level-flags) (level-flags not-physical))))
            (return a0-10)
            )
        )
      )
    )
  (let ((v0-1 (the-as level #f)))
    0.0
    (dotimes (v1-30 (-> this length))
      (let ((a0-15 (-> this level v1-30)))
        (when (= (-> a0-15 status) 'active)
          (if (and (not v0-1) (not (logtest? (-> a0-15 info level-flags) (level-flags not-physical))))
              (set! v0-1 a0-15)
              )
          )
        )
      )
    v0-1
    )
  )

;; definition for method 8 of type level-group
(defmethod mem-usage ((this level-group) (usage memory-usage-block) (flags int))
  (dotimes (s3-0 (-> this length))
    (mem-usage (-> this level s3-0) usage flags)
    )
  this
  )

;; definition for function bg
;; WARN: Return type mismatch int vs none.
(defun bg ((arg0 symbol))
  (set! *cheat-mode* (if *debug-segment*
                         'debug
                         #f
                         )
        )
  (let ((v1-2 (lookup-level-info arg0)))
    (cond
      ((= (-> v1-2 visname) arg0)
       (set! (-> *level* vis?) #t)
       (set! arg0 (-> v1-2 name))
       )
      (else
        (set! (-> *level* vis?) #f)
        (set! (-> *kernel-context* low-memory-message) #f)
        )
      )
    )
  0
  (let ((s5-0 (level-get-for-use *level* arg0 'active -1)))
    (while (and s5-0
                (or (= (-> s5-0 status) 'loading) (= (-> s5-0 status) 'loading-bt) (= (-> s5-0 status) 'login))
                (not *dproc*)
                )
      (load-continue s5-0)
      )
    (reset! *load-state*)
    (set! (-> *load-state* vis-nick) (-> s5-0 name))
    (set! (-> *load-state* want 0 name) (-> s5-0 name))
    (set! (-> *load-state* want 0 display?) 'display)
    ;; og:preserve-this bring-up shim: the load-state update! method (which propagates
    ;; want -> target -> level display?) is not landed yet, so flip the level's
    ;; display? directly at boot activation. Retire with the update! landing.
    (if s5-0
        (set! (-> s5-0 display?) 'display)
        )
    (when (-> s5-0 info continues)
      (dotimes (s4-0 2)
        (let* ((a0-15 *game-info*)
               (t9-4 (method-of-object a0-15 set-continue!))
               (a1-2 (-> s5-0 info continues car))
               (a2-1 s4-0)
               )
          (t9-4 a0-15 (the-as basic a1-2) a2-1)
          )
        )
      )
    )
  (dotimes (v1-32 1)
    (set! (-> *load-state* want-sound v1-32 name)
          (-> *game-info* player-info 0 current-continue want-sound v1-32)
          )
    (set! (-> *load-state* want-sound v1-32 mode) (sound-bank-mode full))
    )
  (add-borrow-levels *load-state*)
  (activate-levels! *level*)
  (set! *print-login* #f)
  (cond
    ((= arg0 'halfpipe)
     (send-event (ppointer->process *time-of-day*) 'change 'ratio 0.0)
     (send-event (ppointer->process *time-of-day*) 'change 'hour 14)
     (set! (-> *time-of-day-context* mode) (time-of-day-palette-id unk0 unk1))
     )
    (else
      (set! (-> *time-of-day-context* mode) (time-of-day-palette-id unk3))
      )
    )
  0
  (none)
  )

;; definition for function play
;; og:preserve-this bring-up externs: home is cam-start.gc, which compiles after the
;; camera ring types this file cannot see. Retire with the warp helpers.
(define-extern jakx-cam-warp-to-level (function level none))
(define-extern jakx-cam-warp-to-continue (function continue-point none))
;; og:preserve-this bring-up extern (#152): jakx-cam-pin-view! is the write-set
;; helper cam-start.gc's jakx-cam-warp-tick now shares with jakx-racer-tick below
;; (this file, position 267 in game.gd, compiles before cam-start.gc at 290).
;; Retires alongside the warp helpers above, same real camera start chain.
(define-extern jakx-cam-pin-view! (function vector matrix none))

;; og:preserve-this bring-up helper: look up a continue point by name across every
;; level-load-info's continues list, jak3 get-continue-by-name's walk without the
;; *game-info* half. Retires when game-info.gc lands.
;; og:preserve-this bring-up want driver state: armed by play when it boots a continue
;; point; consumed by jakx-want-driver-tick from level-update. An earlier note retired
;; this "with the retail continue/race position system in game-info.gc"; the 2026-08-12
;; decodes proved no such system exists (races stage statically via net-world). Retires
;; if exploration ever adopts retail's net-world staging or a race-start path replaces
;; free-roam boots.
;;
;; og:preserve-this default flip, owner direction 2026-08-12: *jakx-want-driver-cp* is
;; now armed on every retail-staged boot (net-world.gc, jakx-stage-boot-task), not just
;; the *jakx-boot-continue* free-roam fallback arm. With the driver defaulting on, that
;; seed also unconditionally arms jakx-racer-spawn's consumer path, and #193's root
;; cause (a level-arted skeleton-group reading as truthy integer 0 rather than #f on a
;; family with no resident donor) fires with no REPL step in between to catch it first.
;; The driver is demoted to an opt-in dev lever until the family-keyed skeleton guard
;; (entity.gc) is proven safe across every armed family: (set! *jakx-want-driver* #t)
;; from the REPL to resume streaming/camera-fly experiments on a booted session. This
;; flip previously lived only as an uncommitted local edit; it is landed for real here
;; so retail-staged boots never carry it active by default.
(define *jakx-want-driver* #f)
(define *jakx-want-driver-frame* 0)
(define *jakx-want-driver-cp* (the continue-point #f))

(defun jakx-find-continue-point ((arg0 string))
  (let ((v1-0 *level-load-list*))
    (while (not (null? v1-0))
      (let* ((a1-0 (-> (the-as symbol (car v1-0)) value))
             (a2-0 (-> (the-as level-load-info a1-0) continues))
             )
        (while (not (null? a2-0))
          (let ((a3-0 (car a2-0)))
            (if (string= arg0 (-> (the-as continue-point a3-0) name))
                (return (the-as continue-point a3-0))
                )
            )
          (set! a2-0 (cdr a2-0))
          )
        )
      (set! v1-0 (cdr v1-0))
      )
    )
  (the-as continue-point #f)
  )

;; og:preserve-this bring-up camera path recorder: while enabled, level-update's tick
;; prints the active camera position a few times a second. A recorded flight bakes
;; into a replay probe (scratchpad tooling) so streaming validation laps run without
;; a pilot. Costs a handful of log lines per second; retire with the race/target legs.
(define *jakx-campath-record* #t)
(define *jakx-campath-frame* 0)

;; og:preserve-this bring-up flight driver: the want driver picks the streaming window
;; from the camera position, and actor birth is distance-gated from that same camera
;; (entity.gc:742 vis-dist-ok? against *ACTOR-bank* birth-dist). So a parked camera
;; means the window never slides and no new actors are ever born: a bare headless boot
;; loads the boot continue's want set and then sits there. Every streaming validation
;; and every section-boundary repro so far has therefore needed a human on a controller.
;;
;; Until the real race/target chain drives the camera, hop it around the boot continue's
;; family: every *jakx-cam-fly-dwell* frames, warp onto the next race continue in list
;; order, wrapping at the end for successive laps. Candidate selection deliberately
;; mirrors jakx-want-driver-tick's filter (same :level home, lightjak grid-starts
;; excluded) so the flight can only ever visit continues whose want sets are built.
;;
;; Dwell must stay under the re-arm window jakx-cam-warp-to-continue sets, or the pin
;; lapses between hops and the ring's settle drags the camera back toward the origin.
;;
;; Off by default for interactive boots: it moves the camera, so it must never surprise
;; one. Smoke boots arm it with gk's -cam-fly arg, read here from the kernel symbol; the
;; REPL can still flip it live. Retire with the camera start chain.
(define *jakx-cam-fly* (if *kernel-boot-cam-fly* #t #f))
(define *jakx-cam-fly-dwell* 300)
(define *jakx-cam-fly-frame* 0)
(define *jakx-cam-fly-index* 0)

(defun jakx-cam-fly-tick ()
  "og:preserve-this bring-up flight driver: advance the camera one race continue every
*jakx-cam-fly-dwell* frames so streaming laps run with no pilot. See the block above."
  (when (and *jakx-cam-fly* *jakx-want-driver-cp* (nonzero? *level-load-list*))
    (+! *jakx-cam-fly-frame* 1)
    (when (>= *jakx-cam-fly-frame* *jakx-cam-fly-dwell*)
      (set! *jakx-cam-fly-frame* 0)
      (let ((home (-> *jakx-want-driver-cp* level))
            (want *jakx-cam-fly-index*)
            (seen 0)
            (pick (the continue-point #f))
            )
        (let ((lst *level-load-list*))
          (while (not (null? lst))
            (let* ((info (the-as level-load-info (-> (the-as symbol (car lst)) value)))
                   (conts (-> info continues))
                   )
              (while (not (null? conts))
                (let ((cp (the-as continue-point (car conts))))
                  (when (and (= (-> cp level) home)
                             (not (logtest? (-> cp flags) (continue-flags lightjak)))
                             )
                    (when (and (not pick) (= seen want))
                      (set! pick cp)
                      )
                    (set! seen (+ seen 1))
                    )
                  )
                (set! conts (cdr conts))
                )
              )
            (set! lst (cdr lst))
            )
          )
        (cond
          (pick
            (format 0 "cam-fly: hop ~D of ~D -> ~S~%" *jakx-cam-fly-index* seen (-> pick name))
            (jakx-cam-warp-to-continue pick)
            (set! *jakx-cam-fly-index* (+ *jakx-cam-fly-index* 1))
            )
          (else
            ;; walked past the end of the family: wrap for the next lap. Guard the
            ;; empty-family case too, or index 0 would never resolve and this would
            ;; spin silently once per dwell.
            (if (zero? seen)
                (format 0 "cam-fly: no race continues for ~A, flight idle~%" home)
                )
            (set! *jakx-cam-fly-index* 0)
            )
          )
        )
      )
    )
  (none)
  )

(defun jakx-want-slide-safe? ((cand continue-point))
  "og:preserve-this bring-up guard: refuse a slide whose want set would evict a section
the camera is inside. Proven live on icelands (2026-08-12): ice-icea-1's two-entry want
set evicted iced at the border, deactivate(kill) under the racer, because want-levels'
name diff discards anything the new set omits. A slide may only fire once every current
window member the camera is inside-boxes? of survives into the candidate's set, so
evictions happen behind the racer, never underneath. The 2026-08-12 net-world decode
proved retail has no mid-race slide to inherit this rule from: races stage one want set
via wait-for-levels and never move it, so border safety is this driver's own problem."
  (let ((safe #t))
    (dotimes (i 6)
      (let ((cur-name (-> *load-state* want i name)))
        (when cur-name
          (dotimes (j (-> *level* length))
            (let ((lev (-> *level* level j)))
              (when (and (= (-> lev name) cur-name)
                         (= (-> lev status) 'active)
                         (-> lev inside-boxes?)
                         )
                (let ((kept #f))
                  (dotimes (k (min 4 (the int (-> cand want-count))))
                    (if (= (-> cand want k name) cur-name)
                        (set! kept #t)
                        )
                    )
                  (if (not kept)
                      (set! safe #f)
                      )
                  )
                )
              )
            )
          )
        )
      )
    safe
    )
  )

(defun jakx-want-driver-tick ()
  "og:preserve-this bring-up want driver for free exploration of the section families.
An earlier docstring claimed retail refreshes wants from race position through
game-info.gc; the 2026-08-12 scoped decodes falsified that: retail level-update's
continue block is an empty-bodied guard, set-continue! never touches wants, and races
stage their window once through net-world (task-selected continue, method 76,
check-start-load, wait-for-levels) with no positional input anywhere. Free exploration
of the w-families therefore has no retail mechanism to port, and this driver is the
authored stand-in: every 30 frames pick the continue point nearest the active camera
within the boot continue's family (same :level home, so only built DGO want sets are
ever requested) and apply its want set when it changes, guarded by jakx-want-slide-safe?
above; update! then streams the section window."
  (when *jakx-campath-record*
    (+! *jakx-campath-frame* 1)
    (when (>= *jakx-campath-frame* 20)
      (set! *jakx-campath-frame* 0)
      (let ((mc (view-get-math-camera 0)))
        (when (nonzero? (the-as int mc))
          (format 0 "campath: ~f ~f ~f~%" (-> mc trans x) (-> mc trans y) (-> mc trans z))
          )
        )
      )
    )
  (when (and *jakx-want-driver* *jakx-want-driver-cp* (nonzero? *level-load-list*))
    (+! *jakx-want-driver-frame* 1)
    (when (>= *jakx-want-driver-frame* 30)
      (set! *jakx-want-driver-frame* 0)
      (let ((mc (view-get-math-camera 0)))
        (when (nonzero? (the-as int mc))
          (let ((cam (-> mc trans))
                (home (-> *jakx-want-driver-cp* level))
                (best (the continue-point #f))
                (best-d 1000000000000000000.0)
                (best-any (the continue-point #f))
                (best-any-d 1000000000000000000.0)
                (cur-d 1000000000000000000.0)
                )
            (let ((lst *level-load-list*))
              (while (not (null? lst))
                (let* ((info (the-as level-load-info (-> (the-as symbol (car lst)) value)))
                       (conts (-> info continues))
                       )
                  (while (not (null? conts))
                    (let ((cp (the-as continue-point (car conts))))
                      (when (= (-> cp level) home)
                        (let* ((dx (- (-> cp trans x) (-> cam x)))
                               (dy (- (-> cp trans y) (-> cam y)))
                               (dz (- (-> cp trans z) (-> cam z)))
                               (d (+ (* dx dx) (* dy dy) (* dz dz)))
                               )
                          (when (or (not best-any) (< d best-any-d))
                            (set! best-any cp)
                            (set! best-any-d d)
                            )
                          ;; skip grid-start continues (the lightjak flag marks them, on
                          ;; both jungle-wide-start and the havjung equivalent) as the
                          ;; PREFERRED candidate: they are pre-race configurations whose
                          ;; want sets drop the arrival section, so crossing the start
                          ;; line under one unloads the world around the camera. They
                          ;; share a trans with the first lap checkpoint, which must win
                          ;; the tie; lap flow belongs to the plain race continues.
                          ;; best-any above still tracks excluded continues so the
                          ;; fallback below can reach one when nothing eligible is
                          ;; nearer (#152: icea's only continue is excluded so icea can
                          ;; never display after a reload; havjung-wide-start's
                          ;; exclusion starved havenb the moment the window first slid).
                          (when (not (logtest? (-> cp flags) (continue-flags lightjak)))
                            (if (= cp *jakx-want-driver-cp*)
                                (set! cur-d d)
                                )
                            (when (or (not best) (< d best-d))
                              (set! best cp)
                              (set! best-d d)
                              )
                            )
                          )
                        )
                      )
                    (set! conts (cdr conts))
                    )
                  )
                (set! lst (cdr lst))
                )
              )
            ;; og:preserve-this fallback (#152): the exclusion above is a preference, not
            ;; a hard rule. When the nearest continue overall is an excluded one, use it
            ;; anyway as long as it beats the nearest eligible continue by the same 1.4x
            ;; hysteresis factor used below against the current position (0.5 in squared
            ;; distance); an eligible continue that is merely close still wins, which
            ;; preserves the jungle-wide-start regression case above by the margin
            ;; instead of by dropping the exclusion. Measured starvation without this:
            ;; the icelands family's only icea-displaying continue is excluded so icea
            ;; could never display after a reload, and havjung-wide-start's exclusion
            ;; unloaded havenb the moment the window first slid. Retires with the retail
            ;; continue/race-position system (game-info.gc), which replaces this whole
            ;; driver.
            (when (and best-any (!= best-any best) (< best-any-d (* 0.5 best-d)))
              (set! best best-any)
              (set! best-d best-any-d)
              )
            ;; hysteresis: switch only when the candidate is decisively closer than the
            ;; current continue (1.4x in linear distance, 0.5 in squared). The margin
            ;; only needs to prevent oscillation between distinct positions; 2x proved
            ;; too conservative in flight, starting the next section's load at ~80% of
            ;; the span between continues, which popped section A in at the lap line
            ;; (the e-1-to-line span covers all of section E). 1.4x starts it at ~2/3.
            (when (and best
                       (!= best *jakx-want-driver-cp*)
                       (< best-d (* 0.5 cur-d))
                       (jakx-want-slide-safe? best)
                       )
              (format 0 "want-driver: window slides to ~S~%" (-> best name))
              (set! *jakx-want-driver-cp* best)
              (let ((a1-11 (new 'stack-no-clear 'array 'symbol 18)))
                (dotimes (i 18)
                  (set! (-> a1-11 i) #f)
                  )
                (dotimes (i (min 4 (the int (-> best want-count))))
                  (set! (-> a1-11 i) (-> best want i name))
                  )
                (want-levels *load-state* a1-11)
                )
              ;; og:preserve-this display every want: an earlier note here argued the #f
              ;; push was needed for hidden wants to land, but want-levels already
              ;; initialises every newly added entry hidden, so the explicit #f only ever
              ;; un-displayed an already-displayed section; on a back-slide (a-3 sits on
              ;; the b-1-to-c-1 leg and nearest-continue has no direction) that push
              ;; deactivated the ground under the racer for ~510 m per lap in the
              ;; recorded repro. Promoting #f to 'display goes one further: the hidden
              ;; value is retail's preload staging (net-world's wait-for-levels flips it
              ;; to 'display once loaded, method 77), and this driver has no later flip
              ;; point, so hold-until-crossed reads as a void ahead. display-wait in the
              ;; level flags keeps a still-loading level deferred, so this never draws
              ;; an unloaded level. Non-#f values ('special task variants) pass through.
              (dotimes (i (min 4 (the int (-> best want-count))))
                (let ((w (-> best want i)))
                  (want-display-level *load-state* (-> w name) (or (-> w display?) 'display))
                  )
                )
              (want-vis-level *load-state* (-> best vis-nick))
              )
            )
          )
        )
      )
    )
  0
  (none)
  )

;; og:preserve-this bring-up racer levers (#152): off by default, no C-side boot arg.
;; *kernel-boot-cam-fly* is set by kmachine.cpp before this file's top-level even
;; runs (CamFlyBoot's -cam-fly arg parse, kmachine.cpp:140); extending that the same
;; way for the racer would need a kmachine.cpp change and a gk.exe rebuild, out of
;; scope for a GOAL-only landing. Arm from the REPL after boot instead:
;; (set! *jakx-racer* #t), then (jakx-racer-spawn) (entity.gc, needs
;; *jakx-want-driver-cp* already set by play's boot-cp branch above).
;;
;; Speed is meters/second, scaled by (seconds-per-frame) each tick (view-get-active
;; already proves with-pp/pp is safe from a bare defun like this one, not just
;; process methods) rather than assuming a fixed 60fps; 15 is a plausible bring-up
;; pace (54 km/h), not tuned against retail. cam-back/cam-height are the chase
;; camera's settable offset behind and above the racer's trans. Retires with the
;; real race/target/vehicle chain (#152 names the tiers).
(define *jakx-racer* #f)
(define *jakx-racer-speed* (meters 15))
;; og:preserve-this racer handle container (#152): *jakx-racer-handle* was a bare
;; handle-typed symbol. GOAL symbol value slots are 32 bits (IR_SetSymbolValue
;; emits store32 unconditionally, no size guard in goalc's IR.cpp), so the 64-bit
;; handle's pid half truncated silently on every store and handle->process could
;; never match the spawned process again. This was the only bare handle-typed
;; symbol in any game's tree; jak3's own retail equivalent
;; (goal_src/jak3/engine/target/gun/gun-yellow-shot.gc:1268,
;; *last-hit-deflect-target-handle*) sidesteps the same 32-bit truncation with a
;; (pointer process) cast instead. This container mirrors *additional-spawners*
;; (entity.gc) instead: a one-element 'static 'array of handle is a real 64-bit
;; field, not a symbol value slot, so it stores the full handle intact. The
;; explicit set! below is not optional: a zero-initialized static handle has
;; process=0, which is TRUTHY (0 is not the #f address), so handle->process on an
;; unarmed slot would dereference GOAL address 0 and return garbage instead of #f.
;; Arming with a real #f handle makes every pre-spawn read safely #f. Retires with
;; the real race/target/vehicle chain, same as the rest of this block (#152 names
;; the tiers).
(define *jakx-racer-handle* (new 'static 'array handle 1 (new 'static 'handle)))
(set! (-> *jakx-racer-handle* 0) (the-as handle #f))
(define *jakx-racer-target-index* 0)
(define *jakx-racer-cam-back* (meters 8))
(define *jakx-racer-cam-height* (meters 4))
;; last frame's movement direction, 3D-normalized; only x/z are ever consumed, and
;; jakx-racer-cam-tick! re-normalizes them in the horizontal plane before use. Seeds
;; the chase offset and survives the racer being momentarily stationary (arrival
;; snap frame)
(define *jakx-racer-heading* (new 'static 'vector :z 1.0 :w 1.0))

