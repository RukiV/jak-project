(defun jakx-racer-track-for-family ((family symbol))
  "og:preserve-this racer track family dispatch (#192): selects which baked
centerline table to drive, keyed by the booted continue's own :level field
(the family: 'junglew, 'icew, 'havjungw, ... -- see the continue-point
statics in level-info.gc). #f (no boot continue armed yet) and 'junglew both
resolve to *jakx-racer-track*: that preserves this rung's actual history,
where the table was always the jungle bake regardless of family, so a jungle
boot (or a REPL poke before *jakx-want-driver-cp* exists) behaves exactly as
before. 'icew resolves to *jakx-racer-track-icew*. 'havjungw resolves to
*jakx-racer-track-havjungw* (#129): the bake exists and the continue chain is
now armed, closing the gap this docstring used to name explicitly. Every
other family returns #f rather than one of the armed tables: handing an
unrelated family the wrong world's table would drive the racer along a
different world's coordinates entirely, not merely a wrong line of the right
one. Callers must treat #f as refuse, not as a signal to fall back to the old
sparse continue-point lerp; jakx-racer-spawn (entity.gc) does exactly that
with a loud format message. No new 64-bit value is introduced here: all three
tables are ordinary boxed-array pointers, the same shape *jakx-racer-track*
already held before this rung, so the 32-bit symbol-value-slot trap
*jakx-racer-handle* works around (see that note above) does not apply to any
of them or to this function's own return value. The refusal branch does need
its own cast though: a bare #f there would give the whole cond (and so this
function's inferred return type) the union of (array vector) and symbol,
which the compiler collapses to plain object -- too weak for callers to
(-> track ...) into. (the-as (array vector) #f) keeps the declared type
intact while still storing a real #f, the same reinterpret-not-truncate idiom
*jakx-racer-handle*'s arming set! uses above, applied to a return type
instead of a field."
  (cond
    ((or (not family) (= family 'junglew)) *jakx-racer-track*)
    ((= family 'icew) *jakx-racer-track-icew*)
    ((= family 'havjungw) *jakx-racer-track-havjungw*)
    (else (the-as (array vector) #f))
    )
  )

;; og:preserve-this bare int index (#161, #192): *jakx-racer-track-index* holds
;; a small int (the current point's slot in whichever table
;; jakx-racer-track-for-family selects -- shared across families rather than
;; per-table, since only one table is ever active per boot), not a 64-bit
;; handle like *jakx-racer-handle* above, so the 32-bit symbol-value-slot
;; truncation that container works around (IR_SetSymbolValue's unconditional
;; store32) does not apply here; a bare symbol is safe.
(define *jakx-racer-track-index* 0)
;; arrival radius for advancing to the next centerline point: filtered track
;; edges are roughly 137 meters apart on average (49 to 272 across the jungle
;; bake, lap seam included), so this is well under one spacing to avoid
;; skipping a point, but far enough above the tiny per-frame lerp step
;; (*jakx-racer-speed* / fps) that the racer actually reaches it rather than
;; orbiting just outside the radius. The old 48-to-386 range came from the
;; unfiltered table and included fork-crossing garbage steps; the fork
;; interleave is resolved as of the extractor's two-pass filter above.
;;
;; og:preserve-this shared across families (#192): one constant serves
;; whichever table jakx-racer-track-for-family selects, not tuned per family.
;; It still holds for icew's table: that bake's own step range is 55.95 to
;; 477.61 m (lap seam included), so 50 m stays under its minimum spacing too
;; and cannot skip a point. Splitting this per family is future work if a
;; later bake's minimum step ever comes in under 50 m.
(define *jakx-racer-track-arrive-radius* (meters 50))

;; og:preserve-this deferred-respawn record (#193 rework): the level-deactivate
;; hook above used to call jakx-racer-spawn synchronously, from inside the
;; dying donor level's own deactivate. At that point in the call the donor
;; level has not yet left status 'active, so it is still walkable and #162's
;; art-donor scan (art-group-get-by-name) re-picks that exact still-resident
;; level as the racer's new donor, landing the respawned racer on the identical
;; heap that is about to be overwritten. Replay proof
;; (gk-racer193.log:2496-2499): the immediate respawn logged the same donor
;; (junglea), the same frame-group address (#x1be84d4) and the same heap range
;; as the process just killed. Deferring the respawn to jakx-racer-tick below,
;; gated on the excluded level actually leaving 'active/'alive, is what lets
;; the donor scan land on a level that will not be discarded out from under it
;; again; see the hook's own comment (above, method 9) for the full account and
;; jakx-racer-tick for the consumer side. Plain fields, not a handle container:
;; nothing captured here is a 64-bit handle (the killed process's own handle is
;; already cleared to #f by the hook before this record is armed), so the
;; 32-bit symbol-value-slot truncation *jakx-racer-handle* works around above
;; (IR_SetSymbolValue's unconditional store32) does not apply to a trans, a
;; bare int track index, or a level-name symbol. Retires with the real vehicle
;; chain, same as the rest of this block (#152 names the tiers).
(define *jakx-racer-respawn-pending* #f)
(define *jakx-racer-respawn-trans* (new 'static 'vector))
(define *jakx-racer-respawn-track-index* 0)
(define *jakx-racer-respawn-exclude-level* #f)

(defun jakx-racer-cam-tick! ((racer-trans vector))
  "og:preserve-this bring-up chase camera (#152): place the camera
*jakx-racer-cam-back* behind and *jakx-racer-cam-height* above the racer along its
last horizontal heading, looking at the racer's trans, then pin view-0 there via
jakx-cam-pin-view! (cam-start.gc, shared with jakx-cam-warp-tick, forward-declared
above near play). The look-at basis (right = world-up x forward, up = forward x
right) is assigned straight into rvec/uvec/fvec, the same direct-assignment shape
jakx-cam-warp-to-continue uses for a decoded continue-point camera-rot, so this
inv-camera-rot is built consistently with the only other producer of one."
  (let ((hx (-> *jakx-racer-heading* x))
        (hz (-> *jakx-racer-heading* z))
        )
    (let ((hlen (sqrtf (+ (* hx hx) (* hz hz)))))
      (when (> hlen 0.001)
        (set! hx (/ hx hlen))
        (set! hz (/ hz hlen))
        )
      )
    (let ((cam-pos (new 'stack-no-clear 'vector)))
      (set! (-> cam-pos x) (- (-> racer-trans x) (* hx *jakx-racer-cam-back*)))
      (set! (-> cam-pos y) (+ (-> racer-trans y) *jakx-racer-cam-height*))
      (set! (-> cam-pos z) (- (-> racer-trans z) (* hz *jakx-racer-cam-back*)))
      (set! (-> cam-pos w) 1.0)
      (let ((fwd (new 'stack-no-clear 'vector))
            (right (new 'stack-no-clear 'vector))
            (up (new 'stack-no-clear 'vector))
            (world-up (new 'stack-no-clear 'vector))
            )
        (set-vector! world-up 0.0 1.0 0.0 1.0)
        (set! (-> fwd x) (- (-> racer-trans x) (-> cam-pos x)))
        (set! (-> fwd y) (- (-> racer-trans y) (-> cam-pos y)))
        (set! (-> fwd z) (- (-> racer-trans z) (-> cam-pos z)))
        (set! (-> fwd w) 1.0)
        (vector-normalize! fwd 1.0)
        (vector-cross! right world-up fwd)
        (vector-normalize! right 1.0)
        (vector-cross! up fwd right)
        (let ((rot (new 'stack-no-clear 'matrix)))
          (matrix-identity! rot)
          (set! (-> rot rvec x) (-> right x))
          (set! (-> rot rvec y) (-> right y))
          (set! (-> rot rvec z) (-> right z))
          (set! (-> rot uvec x) (-> up x))
          (set! (-> rot uvec y) (-> up y))
          (set! (-> rot uvec z) (-> up z))
          (set! (-> rot fvec x) (-> fwd x))
          (set! (-> rot fvec y) (-> fwd y))
          (set! (-> rot fvec z) (-> fwd z))
          (jakx-cam-pin-view! cam-pos rot)
          )
        )
      )
    )
  (none)
  )

;; og:preserve-this bring-up extern (#164 rung 3b): *jakx-view-target* is defined in
;; logic-target.gc, which compiles after this file (level.o at game.gd position 267,
;; logic-target.o at 307). Retires alongside the puppet write below, once the real
;; vehicle chain drives the target directly.
(define-extern *jakx-view-target* symbol)

(defun jakx-racer-puppet-view-target! ((cur vector))
  "og:preserve-this bring-up racer puppet, rung 3b (#164): copies the racer's
final per-tick position (the same cur jakx-racer-cam-tick! receives) onto the
registered view target's root so it visibly rides the racer instead of
sitting wherever the boot continue left it. Both inputs are runtime-proven:
view registration has been live since #160, and the target's root is a bare
trsqv seeded at process init since #166, so a truthy *jakx-view-target* plus
a live view target reliably carries a nonzero root here. Retires once the
real vehicle chain (#152 family) drives the target directly instead of this
puppet copy."
  (let ((vtarget (view-get-active-target)))
    (when (and *jakx-view-target*
               vtarget
               (nonzero? (-> (the-as target vtarget) root))
               )
      (set! (-> (the-as target vtarget) root trans quad) (-> cur quad))
      )
    )
  (none)
  )

(defun jakx-racer-surface-y ((cur vector) (fallback float))
  "og:preserve-this bring-up y correction (#167): the baked centerline table's y
is not the drivable surface (the racer runs underground; see #167's analysis),
so this looks up the y of the continue point nearest cur by x/z distance
instead, restricted to the boot continue's family (same :level home, lightjak
grid-starts excluded, mirroring the continue filter jakx-racer-tick's
continue-fallback path applies below verbatim). Piecewise-constant y taken
from authored on-surface respawn markers is deliberately crude, not a real
ground height; it retires with real ground-following once the vehicle chain
lands collision. Falls back to fallback (the baked table's own y) when
*jakx-want-driver-cp* is unset or the family has no eligible continue, so an
unusual boot degrades to #161's original y instead of asserting."
  (if *jakx-want-driver-cp*
      (let ((home (-> *jakx-want-driver-cp* level))
            (best (the continue-point #f))
            (best-d 1000000000000000000.0)
            )
        (let ((lst *level-load-list*))
          (while (not (null? lst))
            (let* ((info (the-as level-load-info (-> (the-as symbol (car lst)) value)))
                   (conts (-> info continues))
                   )
              (while (not (null? conts))
                (let ((cp (the-as continue-point (car conts))))
                  (when (and (= (-> cp level) home)
                             (not (logtest? (-> cp flags) (continue-flags lightjak)))
                             )
                    (let* ((dx (- (-> cp trans x) (-> cur x)))
                           (dz (- (-> cp trans z) (-> cur z)))
                           (d (+ (* dx dx) (* dz dz)))
                           )
                      (when (or (not best) (< d best-d))
                        (set! best cp)
                        (set! best-d d)
                        )
                      )
                    )
                  )
                (set! conts (cdr conts))
                )
              )
            (set! lst (cdr lst))
            )
          )
        (if best
            (-> best trans y)
            fallback
            )
        )
      fallback
      )
  )

(defun jakx-racer-respawn-excluded-active? ()
  "og:preserve-this deferred-respawn gate (#193 rework): #t while
*jakx-racer-respawn-exclude-level* still names a level sitting at status
'active or 'alive anywhere in *level*. Same walk-and-flag shape as
jakx-want-slide-safe? above (dotimes over (-> *level* level i), compare
by name, not by object identity: the excluded level's own level object is
about to be reused for the replacement level, but its name is stable and is
what the level array actually holds a fresh instance of by the time the slide
completes). jakx-racer-tick holds the deferred respawn off for as long as this
returns #t; only #f proves #162's donor scan (art-group-get-by-name) cannot
re-adopt the dying heap the way the old inline respawn did."
  (let ((still-active #f))
    (dotimes (i (-> *level* length))
      (let ((lev (-> *level* level i)))
        (when (and (= (-> lev name) *jakx-racer-respawn-exclude-level*)
                   (or (= (-> lev status) 'active) (= (-> lev status) 'alive))
                   )
          (set! still-active #t)
          )
        )
      )
    still-active
    )
  )

(defun jakx-racer-tick ()
  "og:preserve-this bring-up racer driver (#152, #161, #192): move the spawned
racer manipy toward the next target at *jakx-racer-speed*, advancing on
arrival and wrapping forever, then pin the chase camera behind it. The active
table comes from jakx-racer-track-for-family, keyed by the booted continue's
:level (defaulting to the jungle table for compatibility, #f for any family
with no bake -- see that function's note for the full selection rule). When
it resolves non-#f the target comes from that baked centerline table, walked
by *jakx-racer-track-index* and advanced once within
*jakx-racer-track-arrive-radius* of the current point: this is the real
authored race-mesh line rather than a lerp between continue points. A boot
whose family has no baked table falls back to the original continue-point
walk below, unchanged from #152: candidate selection mirrors
jakx-cam-fly-tick's filter above verbatim (same :level home, lightjak
grid-starts excluded, so only continues whose want sets are built are ever
visited); unlike that flight driver this MOVES instead of teleporting each
dwell, so it needs its own target index rather than sharing
*jakx-cam-fly-index*. In practice this fallback branch is now dead weight for
proc, not logic: jakx-racer-spawn (entity.gc) already refuses to spawn for an
unarmed family, so proc is never non-#f here without an armed table too; it
stays as the pre-#192 behavior in case a future spawn path ever bypasses that
gate. Snapping when the remaining distance is no more than one frame's step
(rather than a separate arrive-radius constant) guarantees no overshoot and
no separate tunable to keep in sync with speed. Also resolves any deferred
post-kill respawn armed by the level-deactivate hook (#193 rework) before the
drive/camera logic below ever runs."
  ;; og:preserve-this deferred-respawn consumer (#193 rework): resolves the
  ;; record armed by the level-deactivate hook (level.gc method 9; see its
  ;; comment for why the respawn cannot happen inline there, and
  ;; jakx-racer-respawn-excluded-active? above for the gate). Runs first, ahead
  ;; of the normal drive/camera branches below, so a respawn firing this frame
  ;; still gets its trans/track-index restored before anything reads proc's
  ;; position this same tick.
  (when *jakx-racer-respawn-pending*
    (cond
      ((not *jakx-racer*)
       ;; disarmed while pending (toggled off from the REPL mid-wait): nothing
       ;; to spawn, just drop the record
       (set! *jakx-racer-respawn-pending* #f)
       (set! *jakx-racer-respawn-exclude-level* #f)
       )
      ((jakx-racer-respawn-excluded-active?)
       ;; excluded level is still active/alive somewhere in *level*: the donor
       ;; scan could still land back on it, so wait another frame
       )
      (else
        (format 0 "racer: deferred respawn firing, excluded level ~A no longer active, respawning~%"
                *jakx-racer-respawn-exclude-level*
                )
        (jakx-racer-spawn)
        (let ((new-proc (the-as process-drawable (handle->process (-> *jakx-racer-handle* 0)))))
          (when new-proc
            (set! (-> new-proc root trans quad) (-> *jakx-racer-respawn-trans* quad))
            (set! *jakx-racer-track-index* *jakx-racer-respawn-track-index*)
            )
          )
        (set! *jakx-racer-respawn-pending* #f)
        (set! *jakx-racer-respawn-exclude-level* #f)
        )
      )
    )
  (let* ((proc (the-as process-drawable (handle->process (-> *jakx-racer-handle* 0))))
         (track (jakx-racer-track-for-family (if *jakx-want-driver-cp* (-> *jakx-want-driver-cp* level) #f)))
         )
    (when (and *jakx-racer* proc)
      (cond
        (track
          (let ((cur (-> proc root trans)))
            (let* ((cand (-> track *jakx-racer-track-index*))
                   (cdx (- (-> cand x) (-> cur x)))
                   (cdz (- (-> cand z) (-> cur z)))
                   ;; og:preserve-this x/z-only arrival test (#167 follow-up): cand's y is
                   ;; the baked centerline's own underground value, not the surface height
                   ;; cur.y is now driven toward by jakx-racer-surface-y below. Including a
                   ;; cdy term here mixed those two y references; once the surface-corrected
                   ;; cur.y diverged from cand's baked y by more than the radius, cdist could
                   ;; never fall under it again, freezing *jakx-racer-track-index* (and with
                   ;; it cur's x/z, since the racer just keeps re-lerping toward the same
                   ;; stuck target) for the rest of the session. Measured: the racer rode a
                   ;; single nearest continue's y for the whole boot instead of the 22-190m
                   ;; range the authored continues span. Retires with real ground-following
                   ;; once the vehicle chain lands collision, same as the y-lookup below.
                   (cdist (sqrtf (+ (* cdx cdx) (* cdz cdz))))
                   )
              (when (<= cdist *jakx-racer-track-arrive-radius*)
                (set! *jakx-racer-track-index*
                      (mod (+ *jakx-racer-track-index* 1) (-> track length))
                      )
                )
              )
            (let* ((target (-> track *jakx-racer-track-index*))
                   (target-y (jakx-racer-surface-y cur (-> target y)))
                   (dx (- (-> target x) (-> cur x)))
                   (dy (- target-y (-> cur y)))
                   (dz (- (-> target z) (-> cur z)))
                   (dist (sqrtf (+ (* dx dx) (* dy dy) (* dz dz))))
                   (step (* *jakx-racer-speed* (seconds-per-frame)))
                   )
              (cond
                ((<= dist step)
                 (set! (-> cur x) (-> target x))
                 (set! (-> cur y) target-y)
                 (set! (-> cur z) (-> target z))
                 )
                (else
                  (let ((scale (/ step dist)))
                    (set! (-> cur x) (+ (-> cur x) (* dx scale)))
                    (set! (-> cur y) (+ (-> cur y) (* dy scale)))
                    (set! (-> cur z) (+ (-> cur z) (* dz scale)))
                    )
                  ;; only update heading while actually moving: on the snap-to-
                  ;; target frame above, dx/dy/dz points at the point just left
                  ;; behind, not where the racer is headed next
                  (when (> dist (meters 0.001))
                    (set! (-> *jakx-racer-heading* x) (/ dx dist))
                    (set! (-> *jakx-racer-heading* z) (/ dz dist))
                    )
                  )
                )
              )
            (jakx-racer-cam-tick! cur)
            (jakx-racer-puppet-view-target! cur)
            )
          )
        (*jakx-want-driver-cp*
          ;; og:preserve-this dropped (nonzero? *level-load-list*) guard (#152):
          ;; *level-load-list* is a pair, and a pair's address is never zero, so the
          ;; check read like a liveness test but could never fail; removed rather than
          ;; kept as dead weight.
          (let ((home (-> *jakx-want-driver-cp* level))
                (want *jakx-racer-target-index*)
                (seen 0)
                (pick (the continue-point #f))
                )
            (let ((lst *level-load-list*))
              (while (not (null? lst))
                (let* ((info (the-as level-load-info (-> (the-as symbol (car lst)) value)))
                       (conts (-> info continues))
                       )
                  (while (not (null? conts))
                    (let ((cp (the-as continue-point (car conts))))
                      (when (and (= (-> cp level) home)
                                 (not (logtest? (-> cp flags) (continue-flags lightjak)))
                                 )
                        (when (and (not pick) (= seen want))
                          (set! pick cp)
                          )
                        (set! seen (+ seen 1))
                        )
                      )
                    (set! conts (cdr conts))
                    )
                  )
                (set! lst (cdr lst))
                )
              )
            (cond
              (pick
                (let* ((cur (-> proc root trans))
                       (dx (- (-> pick trans x) (-> cur x)))
                       (dy (- (-> pick trans y) (-> cur y)))
                       (dz (- (-> pick trans z) (-> cur z)))
                       (dist (sqrtf (+ (* dx dx) (* dy dy) (* dz dz))))
                       (step (* *jakx-racer-speed* (seconds-per-frame)))
                       )
                  (cond
                    ((<= dist step)
                     (set! (-> cur x) (-> pick trans x))
                     (set! (-> cur y) (-> pick trans y))
                     (set! (-> cur z) (-> pick trans z))
                     (set! *jakx-racer-target-index* (+ *jakx-racer-target-index* 1))
                     )
                    (else
                      (let ((scale (/ step dist)))
                        (set! (-> cur x) (+ (-> cur x) (* dx scale)))
                        (set! (-> cur y) (+ (-> cur y) (* dy scale)))
                        (set! (-> cur z) (+ (-> cur z) (* dz scale)))
                        )
                      ;; only update heading while actually moving: on the snap-to-
                      ;; target frame above, dx/dy/dz points at the point just left
                      ;; behind, not where the racer is headed next
                      (when (> dist (meters 0.001))
                        (set! (-> *jakx-racer-heading* x) (/ dx dist))
                        (set! (-> *jakx-racer-heading* z) (/ dz dist))
                        )
                      )
                    )
                  (jakx-racer-cam-tick! cur)
                  (jakx-racer-puppet-view-target! cur)
                  )
                )
              (else
                ;; walked past the end of the family: wrap for the next lap, same
                ;; empty-family guard as jakx-cam-fly-tick above
                (if (zero? seen)
                    (format 0 "racer: no race continues for ~A, racer idle~%" home)
                    )
                (set! *jakx-racer-target-index* 0)
                )
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun play ((arg0 symbol) (arg1 symbol))
  (kmemopen global "level-boot")
  (format 0 "(play)~%")
  (when *kernel-boot-level*
    (bg (string->symbol (the-as string *kernel-boot-level*)))
    (on #f)
    (kmemclose)
    (kmemclose)
    (return 0)
    )
  (let* ((v1-3 *kernel-boot-message*)
         (s5-0 (cond
                 ((= v1-3 'kiosk)
                  'fmvlev
                  )
                 (*debug-segment*
                   ;; og:preserve-this #56: during bring-up the boot lever wins over the
                   ;; retail debug default. menu2.DGO has never been built on this branch
                   ;; (game.gp keeps its cgo-file commented), so a -debug boot picked an
                   ;; unbuildable level and hung forever on a load that cannot complete,
                   ;; making every REPL-attached boot unusable. With no lever set, -debug
                   ;; keeps retail's menu2. Retires with the boot levers (#43 family).
                   (or *jakx-boot-level* 'menu2)
                   )
                 (else
                   ;; og:preserve-this bring-up lever: retail boots 'fmvlev (the intro
                   ;; movie level); *jakx-boot-level* picks the level to exercise the
                   ;; load chain with (brdroom = smallest real world-geometry DGO)
                   *jakx-boot-level*
                   )
                 )
               )
         ;; og:preserve-this bring-up: resolve the boot continue point (multi-level want
         ;; set plus start-line camera framing); #f falls back to the single-level path.
         ;; Gated on the normal boot path so kiosk/debug boots stay untouched.
         (boot-cp (if (and (= s5-0 *jakx-boot-level*)
                           *jakx-boot-continue*
                           (nonzero? *level-load-list*)
                           )
                      (jakx-find-continue-point (the-as string *jakx-boot-continue*))
                      (the-as continue-point #f)
                      )
                  )
         )
    (if (and *jakx-boot-continue* (= s5-0 *jakx-boot-level*) (not boot-cp))
        (format 0 "WARNING: boot continue ~S not found, booting level ~A~%" *jakx-boot-continue* s5-0)
        )
    (let ((t9-7 stop)
          (a0-7 'play)
          )
      0
      ;; og:preserve-this arity fix, R4 (#122): stop's second (int) argument added to
      ;; keep this pre-existing call site (6b46b40811, predates the leg) compiling
      ;; against the corrected signature. level.o has no decode artifact of its own
      ;; (out of R0's scoped object list), so the literal 0 is carried over from the
      ;; two other decoded call sites in the tree, both showing the same shape:
      ;; game-info.gc's anon-function-14 (game-info_ir2.asm op 7) and main.gc's off
      ;; (main_ir2.asm op 2, raw machine code, unaffected by decompiler-config
      ;; staleness). Re-verify against level.o's own decode when that leg lands.
      (t9-7 a0-7 0)
      )
    (set! (-> *level* vis?) arg0)
    (set! (-> *level* want-level) #f)
    (set! (-> *level* border?) #t)
    (set! (-> *setting-control* user-default border-mode) #t)
    (set! (-> *level* play?) #t)
    (init-level-system *level* #t)
    (set! *display-profile* #f)
    (set! *cheat-mode* (if *debug-segment*
                           'debug
                           #f
                           )
          )
    (set! *time-of-day-fast* #f)
    ;; og:preserve-this added nonzero check, matching jak3's PC port: *time-of-day* is not
    ;; spawned yet on the jakx bring-up (time-of-day.gc not decompiled).
    (when (nonzero? *time-of-day*)
      (send-event (ppointer->process *time-of-day*) 'change 'ratio 1.0)
      (send-event (ppointer->process *time-of-day*) 'change 'hour 7)
      (send-event (ppointer->process *time-of-day*) 'change 'minutes 0)
      (send-event (ppointer->process *time-of-day*) 'change 'seconds 0)
      (send-event (ppointer->process *time-of-day*) 'change 'frames 0)
      )
    (set! (-> *time-of-day-context* mode) (time-of-day-palette-id unk3))
    (set! (-> *mood-control* overide-weather-flag) #f)
    (set-blackout-frames (seconds 0.02))
    ;; og:preserve-this fix (#192): retail's own play unconditionally resets
    ;; *load-state* before composing either want-set (level_ir2.asm:9160-9250).
    ;; *load-state* is kmalloc'd and therefore zero-filled, and GOAL 0 is truthy, so
    ;; an un-reset want[6..17].name fed integer 0 into lookup-level-info via
    ;; add-borrow-levels the first time want-levels ran against it, faulting on
    ;; (-> arg0 value) with arg0 = 0 -- the same hazard class as the
    ;; update-callback/vis-nick note at load-state.gc:1675, just in the one field
    ;; that note left to reset! instead of a definition-site init. The R2 wiring
    ;; (995919afd) put this reset! inside the *jakx-boot-continue* fallback arm's own
    ;; (when (not *dproc*) ...) below, so the *jakx-boot-task* arm skipped it
    ;; entirely; hoisted here it runs before either arm, matching retail. The
    ;; (not *dproc*) guard is unchanged from develop's pre-R2 shape and reset! is
    ;; idempotent, so this does not change the fallback arm's own behavior. Retires
    ;; when the fallback arm is retired (ladder R5) and only one arm is left to hold
    ;; the reset.
    (when (not *dproc*)
      (reset! *load-state*)
      )
    ;; og:preserve-this task-driven staging gate, R2 of the retail-staging ladder
    ;; (#192): when *jakx-boot-task* is set, drive staging through the retail
    ;; net-world composer instead of this file's own *jakx-boot-continue* want-set
    ;; arm. Both levers coexist; the *jakx-boot-continue* arm below is the fallback,
    ;; unchanged, and stays live when *jakx-boot-task* is #f. Retiring the fallback
    ;; arm is the ladder's R5, not this rung's; the want driver's own
    ;; *jakx-want-driver-cp* arming path (inside the boot-cp branch below) is
    ;; likewise untouched.
    (if (and *jakx-boot-task* (nonzero? jakx-stage-boot-task))
        (jakx-stage-boot-task)
        (begin
          (when (not *dproc*)
            ;; og:preserve-this bring-up: the DGO load chain is live and load-state's update!
            ;; IS landed (level.gc, full 348-line retail port, runs every frame); an earlier
            ;; version of this note predated its landing and misled a session (#108). The
            ;; boot path still drives each level synchronously (jungle-a-1 = junglew
            ;; tiny-center + junglee tiny + junglea tiny, which exactly tiles the level
            ;; heap; the tiny allocator has two banks, so a want set can never carry three
            ;; tiny sections). The want-levels/want-display-level/want-vis-level calls feed
            ;; update! normally. Flip *jakx-boot-level-load* in the
            ;; REPL to skip the boot load entirely.
            (when (and (nonzero? *level-load-list*) *jakx-boot-level-load*)
              (let ((a1-11 (new 'stack-no-clear 'array 'symbol 18)))
                (dotimes (i 18)
                  (set! (-> a1-11 i) #f)
                  )
                (cond
                  (boot-cp
                    (dotimes (i (min 4 (the int (-> boot-cp want-count))))
                      (set! (-> a1-11 i) (-> boot-cp want i name))
                      )
                    )
                  (else
                    (set! (-> a1-11 0) s5-0)
                    (if (= s5-0 'ctysluma)
                        (set! (-> a1-11 1) 'ctywide)
                        )
                    )
                  )
                (want-levels *load-state* a1-11)
                )
              (cond
                (boot-cp
                  ;; push every entry's display? value, including #f (see the want driver)
                  (dotimes (i (min 4 (the int (-> boot-cp want-count))))
                    (let ((w (-> boot-cp want i)))
                      (want-display-level *load-state* (-> w name) (-> w display?))
                      )
                    )
                  )
                (else
                  (want-display-level *load-state* s5-0 'display)
                  (if (= s5-0 'ctysluma)
                      (want-display-level *load-state* 'ctywide 'display)
                      )
                  )
                )
              (want-vis-level *load-state* (if boot-cp (-> boot-cp vis-nick) s5-0))
              (cond
                (boot-cp
                  (dotimes (i (min 4 (the int (-> boot-cp want-count))))
                    (let ((w (-> boot-cp want i)))
                      (format 0 "boot-continue: loading ~A (~D of ~D)~%" (-> w name) (+ i 1) (-> boot-cp want-count))
                      (let ((s4-1 (level-get-for-use *level* (-> w name) 'active -1)))
                        (while (and s4-1
                                    (or (= (-> s4-1 status) 'loading)
                                        (= (-> s4-1 status) 'loading-bt)
                                        (= (-> s4-1 status) 'login)
                                        )
                                    )
                          (set-blackout-frames (seconds 0.02))
                          (load-continue s4-1)
                          )
                        )
                      )
                    )
                  )
                (else
                  (let ((s4-1 (level-get-for-use *level* s5-0 'active -1)))
                    (while (and s4-1
                                (or (= (-> s4-1 status) 'loading)
                                    (= (-> s4-1 status) 'loading-bt)
                                    (= (-> s4-1 status) 'login)
                                    )
                                )
                      (set-blackout-frames (seconds 0.02))
                      (load-continue s4-1)
                      )
                    )
                  )
                )
              )
            )
          (set! *print-login* #f)
          (cond
            (boot-cp
              ;; og:preserve-this bring-up shim: activate and display each level of the continue
              ;; want set directly. Retirement condition unchanged from before R6: load-state's
              ;; update! method is landed (see the note above, near *jakx-boot-level-load*), but
              ;; this direct activation is not proven redundant with it and R6 did not touch it;
              ;; still Retires with the update! landing once that's confirmed.
              (dotimes (i (min 4 (the int (-> boot-cp want-count))))
                (let* ((w (-> boot-cp want i))
                       (lev (level-get *level* (-> w name)))
                       )
                  (when lev
                    ;; og:preserve-this fix (#152): level-status-update! used to run for every
                    ;; want entry regardless of display?, so hidden wants went 'active at boot
                    ;; when the steady-state driver (update!, above) only ever promotes
                    ;; displayed wants past 'loaded. That asymmetry made the stuck-level
                    ;; reload bug take ~90 minutes to surface instead of reproducing at boot.
                    ;; Gating here matches steady state; retires with the boot shim above.
                    (when (= (-> w display?) 'display)
                      (level-status-update! lev 'active)
                      (set! (-> lev display?) 'display)
                      )
                    )
                  )
                )
              ;; og:preserve-this retired, R6 (#122): the boot-time (jakx-cam-warp-to-continue
              ;; boot-cp) call is gone; camera arrival at the continue now goes through
              ;; initialize!'s own continue path (move-camera!, game-info method 11, still a
              ;; placeholder per the leg brief section 1.9, so this is not yet a real camera
              ;; move; it is not a live hazard, matching risk register item 6). The function
              ;; and its extern are NOT deleted: jakx-cam-fly-tick (above) still calls it for
              ;; the smoke-test flight driver.
              ;; arm the bring-up want driver: from here on level-update's tick slides the
              ;; window as the camera crosses continue thresholds
              (set! *jakx-want-driver-cp* boot-cp)
              )
            (else
              ;; og:preserve-this added #f check: level-get returns #f while level loading is not
              ;; up yet on the bring-up; the original assumes the boot level always exists.
              (let ((s4-2 (level-get *level* s5-0)))
                (if s4-2
                    (level-status-update! s4-2 'active)
                    )
                ;; og:preserve-this bring-up shim: the load-state update! method (which propagates
                ;; want -> target -> level display?) is not landed yet, so flip the level's
                ;; display? directly after boot activation. Retire with the update! landing.
                (if s4-2
                    (set! (-> s4-2 display?) 'display)
                    )
                ;; og:preserve-this bring-up shim: no camera/target start chain is landed, so the
                ;; free camera sits at the origin ~400 m from brdroom's geometry. Warp the camera
                ;; ring onto the level once at boot activation. Retire with the camera start chain.
                (if s4-2
                    (jakx-cam-warp-to-level s4-2)
                    )
                )
              )
            )
          )
        )
    )
  (on #t)
  ;; og:preserve-this restored, R6 (#122): game-info.gc's initialize! landed by R3a
  ;; (85504cc1d), closing the reason this was disabled. The 296 static continue
  ;; points initialize! and its continue path can reach all carry :on-goto #f
  ;; (level-info.gc:87-89): the decompiler cannot emit the original anonymous lambdas,
  ;; so any continue whose retail behaviour lived in :on-goto silently does nothing now.
  ;; That gap is not this rung's to close; filed separately per the leg brief.
  (if arg1
      (initialize! *game-info* 'boot (the-as game-save #f) (the-as string #f) (the-as resetter-spec #f))
      )
  (kmemclose)
  (kmemclose)
  0
  )

;; definition for function play2
(defun play2 ((arg0 symbol) (arg1 symbol))
  (set! *use-menu2* #f)
  (play arg0 arg1)
  )

;; definition for function play-boot
;; WARN: Return type mismatch int vs none.
(defun play-boot ()
  (process-spawn-function
    process
    (lambda () (with-pp
                 (stack-size-set! (-> pp main-thread) 1024)
                 (play #t #t)
                 (none)
                 )
            )
    :name "play-boot"
    :from *4k-dead-pool*
    :stack *kernel-dram-stack*
    )
  0
  (none)
  )

;; definition for function sound-bank-name->mode
;; WARN: Return type mismatch int vs sound-bank-mode.
(defun sound-bank-name->mode ((arg0 symbol))
  (let ((v1-0 arg0))
    (the-as sound-bank-mode (cond
                              ((or (= v1-0 'half1)
                                   (= v1-0 'half2)
                                   (= v1-0 'ctyslmch)
                                   (= v1-0 'ctyslmbh)
                                   (= v1-0 'ctygnbh)
                                   (= v1-0 'ctyindh)
                                   (= v1-0 'ctyslmah)
                                   (= v1-0 'ctyporth)
                                   (= v1-0 'mhcity1h)
                                   (= v1-0 'mhcity2h)
                                   (= v1-0 'citypedh)
                                   (= v1-0 'cityffh)
                                   (= v1-0 'citycarh)
                                   (= v1-0 'vinroomh)
                                   (= v1-0 'ctyprtdh)
                                   (= v1-0 'citybbh)
                                   )
                               5
                               )
                              ((or (= v1-0 'mong1)
                                   (= v1-0 'mong2)
                                   (= v1-0 'mong3)
                                   (= v1-0 'falc1)
