;; definition for method 12 of type level-group
(defmethod level-get-for-use ((this level-group) (arg0 symbol) (arg1 symbol) (arg2 int))
  (init-level-system this #f)
  (let* ((s2-0 (lookup-level-info arg0))
         (s1-0 (remap-level-name s2-0))
         )
    (let ((s0-0 (level-get this s1-0)))
      (cond
        ((and s0-0 (< arg2 6) (< (-> s0-0 index) 6))
         (level-status-update! s0-0 arg1)
         )
        ((>= arg2 6)
         (level-status-update! (-> this level arg2) arg1)
         (set! s0-0 (-> this level arg2))
         )
        (else
          (let ((a0-9 (level-group-method-33 this)))
            (if a0-9
                (set! a0-9 (level-status-update! a0-9 'inactive))
                )
            (set! s0-0 a0-9)
            )
          )
        )
      (when (not level)
        (format 0 "ERROR: could not find a slot to load ~A into.~%" arg0)
        (set! s0-0 (the-as level #f))
        (goto cfg-22)
        )
      (case (-> s0-0 status)
        (('loaded 'active)
         )
        (else
          (let ((v1-31 (+ (-> this load-order) 1)))
            (set! (-> this load-order) v1-31)
            (set! (-> s0-0 load-order) v1-31)
            )
          )
        )
      (set! (-> s0-0 info) s2-0)
      (set! (-> s0-0 name) arg0)
      (set! (-> s0-0 load-name) s1-0)
      (set! (-> s0-0 display?) #f)
      (set! (-> s0-0 force-all-visible?) #f)
      (set! (-> s0-0 force-inside?) #f)
      (set! (-> s0-0 slot) arg2)
      (level-status-update! s0-0 'loading)
      (level-status-update! s0-0 arg1)
      (label cfg-22)
      s0-0
      )
    )
  )

;; definition for method 27 of type level-group
;; WARN: Return type mismatch int vs none.
(defmethod do-nothing ((this level-group))
  0
  (none)
  )

;; definition for method 26 of type level-group
(defmethod level-status? ((this level-group) (arg0 symbol) (arg1 symbol))
  (if (not arg0)
      (return #f)
      )
  (let ((s4-0 (level-get *level* arg0)))
    (lookup-level-info arg0)
    (when s4-0
      (when (and (or (= (-> s4-0 status) 'loaded) (= (-> s4-0 status) 'active))
                 (and (-> s4-0 info borrow) (!= arg1 'ignore-borrow))
                 )
        (dotimes (s3-1 3)
          (let ((v1-14 (-> s4-0 info borrow borrow-info s3-1)))
            (when v1-14
              (when (car (cdr v1-14))
                (let ((v1-15 (level-status? this (the-as symbol (car v1-14)) arg1)))
                  (if (!= v1-15 (-> s4-0 status))
                      (return v1-15)
                      )
                  )
                )
              )
            )
          )
        )
      (-> s4-0 status)
      )
    )
  )

;; definition for method 26 of type level
;; INFO: Used lq/sq
(defmethod level-status-update! ((this level) (arg0 symbol))
  (case arg0
    (('inactive)
     (-> this status)
     (unload! this)
     )
    (('loading)
     (case (-> this status)
       (('inactive)
        (load-begin this)
        )
       )
     )
    (('loading-bt)
     (case (-> this status)
       (('loading)
        (set! (-> this status) arg0)
        (do-nothing *level*)
        (load-continue this)
        )
       )
     )
    (('loading-done)
     (dma-release 'car-load)
     (when (-> this buffer)
       (reserve-free *art-control* (-> this buffer))
       (set! (-> this buffer) #f)
       )
     (case (-> this status)
       (('loading-bt)
        (set! (-> this status) arg0)
        (do-nothing *level*)
        )
       )
     )
    (('loaded)
     (case (-> this status)
       (('loading-done)
        (login-begin this)
        )
       (('alive 'active)
        (deactivate this)
        )
       )
     )
    (('alive 'active)
     (when *dproc*
       (case (-> this status)
         (('loaded)
          (birth this)
          (level-status-update! this arg0)
          )
         (('alive)
          (when (and *dproc* (= arg0 'active))
            (when (zero? (-> this display-start-time))
              (set! (-> this display-start-time) (the-as uint (if (nonzero? *display*) (-> *display* real-clock frame-counter) 0)))
              0
              )
            (remove-by-param1 *background-draw-engine* (the-as int (-> this bsp)))
            (if (< (-> this index) 6)
                (add-connection *background-draw-engine* *dproc* add-bsp-drawable (-> this bsp) this #f)
                )
            (dotimes (v1-56 19)
              (set! (-> this closest-object v1-56) 0.0)
              (set! (-> this texture-mask v1-56 mask quad) (the-as uint128 0))
              )
            (set! (-> this status) 'active)
            (do-nothing *level*)
            (assign-draw-indices *level*)
            )
          )
         )
       )
     )
    )
  this
  )

;; definition for symbol *login-state*, type login-state
(define *login-state* (new 'global 'login-state))

;; definition for symbol *print-login*, type symbol
(define *print-login* #t)

;; definition for symbol *cached-dgo*, type (array dgo-header)
(define *cached-dgo* (new 'global 'boxed-array dgo-header 72))

;; definition for symbol *cached-dgo-count*, type int
(define *cached-dgo-count* 0)

;; definition for function load-buffer-resize
;; WARN: Return type mismatch int vs none.
(defun load-buffer-resize ((arg0 level) (arg1 dgo-header))
  (case (-> arg0 load-buffer-mode)
    (((level-memory-mode tiny))
     (set! (-> arg0 load-buffer-size) (the-as uint (min #x113000 (the-as int (-> arg0 load-buffer-size)))))
     )
    (((level-memory-mode tiny-edge))
     (set! (-> arg0 load-buffer-size) (+ (-> arg1 length) 2048))
     )
    )
  (let ((v1-4 (logand -64 (+ (-> arg0 load-buffer-size) 63))))
    (if (= arg1 (-> arg0 load-buffer 0))
        (set! (-> arg0 load-buffer 0) (- (-> arg0 load-buffer 1) v1-4))
        (set! (-> arg0 load-buffer 1)
              (the-as uint (&- (logand -64 (&+ (-> arg0 heap top-base) 0)) (the-as uint v1-4)))
              )
        )
    )
  (set! (-> arg0 heap top) (the-as pointer (-> arg0 load-buffer 0)))
  0
  (none)
  )

;; definition for method 17 of type level
(defmethod load-continue ((this level))
  (when (-> this linking)
    (when (nonzero? (link-resume))
      (set! (-> this linking) #f)
      (case (-> this status)
        (('loading)
         (when (not (-> *texture-relocate-later* memcpy))
           (cond
             ((= (-> this load-buffer-mode) (level-memory-mode borrow))
              (let ((a2-0 (logand -64 (&+ (-> this heap current) 63))))
                (dgo-load-continue a2-0 a2-0 a2-0)
                )
              )
             ((= (-> this load-buffer-mode) (level-memory-mode small-center))
              (dgo-load-continue
                (the-as pointer (-> this load-buffer 0))
                (the-as pointer (-> this load-buffer 1))
                (logand -64 (&+ (-> this heap current) 63))
                )
              )
             (else
               (load-buffer-resize this (-> this load-buffer-last))
               (dgo-load-continue
                 (the-as pointer (-> this load-buffer 0))
                 (the-as pointer (-> this load-buffer 1))
                 (logand -64 (&+ (-> this heap current) 63))
                 )
               )
             )
           )
         )
        (('loading-bt)
         (level-status-update! this 'loading-done)
         (level-status-update! this 'loaded)
         )
        )
      )
    (set! this this)
    (goto cfg-94)
    )
  (when (-> *texture-relocate-later* memcpy)
    (relocate-later)
    (load-buffer-resize this (-> this load-buffer-last))
    (dgo-load-continue
      (the-as pointer (-> this load-buffer 0))
      (the-as pointer (-> this load-buffer 1))
      (logand -64 (&+ (-> this heap current) 63))
      )
    (set! this this)
    (goto cfg-94)
    )
  (case (-> this status)
    (('loading)
     (cond
       ((= (-> this load-buffer-mode) (level-memory-mode unk-30))
        (let ((sv-16 (the-as symbol #f)))
          )
        (cond
          ((< *cached-dgo-count* (+ (-> *cached-dgo* length) -1))
           (let ((s5-0 (-> *cached-dgo* *cached-dgo-count*))
                 (s4-0 #f)
                 )
             (set! *cached-dgo-count* (+ *cached-dgo-count* 1))
             (when s5-0
               (set! (-> this load-buffer-last) s5-0)
               (+! (-> *level* load-size) (-> s5-0 length))
               (set! (-> *level* load-time)
                     (* 0.016666668 (the float (- (if (nonzero? *display*) (-> *display* real-clock integral-frame-counter) 0) *dgo-time*)))
                     )
               (set! (-> *level* load-login-time)
                     (* 0.016666668 (the float (- (if (nonzero? *display*) (-> *display* real-clock integral-frame-counter) 0) *dgo-time*)))
                     )
               (when (nonzero? (-> this filter-num))
                 (set! s4-0 #t)
