    (nop!)
    (set! (-> this vis-info v1-0) #f)
    )
  (dotimes (v1-3 128)
    (dotimes (a1-2 2)
      ;; og:preserve-this cast, same as jak3's vis-clear
      (set! (-> (the-as (pointer int128) (&+ (-> this vis-bits a1-2) (* v1-3 16)))) (the int128 0))
      )
    )
  (set! (-> this all-visible?) 'loading)
  0
  (none)
  )

;; definition for method 28 of type level
;; WARN: Return type mismatch int vs none.
(defmethod init-vis-from-bsp ((this level))
