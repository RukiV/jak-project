(defun jakx-continue-buildable? ((cand continue-point))
  "og:preserve-this buildability gate (issue 550): a candidate continue is safe to
slide onto only if every level its want set could request is actually built. Checks
(-> cand want i name) for i below (min 4 want-count) against *jakx-built-levels*
above, the same 4-slot span jakx-want-driver-tick copies into the want array and
jakx-want-slide-safe? walks. An unset want slot (name #f, seen on the trailing
padding entries level-load-info's :want arrays carry) is vacuously buildable: there
is nothing there to be missing. A simple linear scan against *jakx-built-levels* is
fine here; the table is under 50 entries and this runs once per slide, not per
frame."
  (let ((ok #t))
    (dotimes (i (min 4 (the int (-> cand want-count))))
      (let ((want-name (-> cand want i name)))
        (when want-name
          (let ((found #f))
            (dotimes (j (-> *jakx-built-levels* length))
              (if (= (-> *jakx-built-levels* j) want-name)
                  (set! found #t)
                  )
              )
            (if (not found)
                (set! ok #f)
                )
            )
          )
        )
      )
    ok
    )
  )

;; og:preserve-this bring-up flight driver: the want driver picks the streaming window
;; from the camera position, and actor birth is distance-gated from that same camera
;; (entity.gc:742 vis-dist-ok? against *ACTOR-bank* birth-dist). So a parked camera
;; means the window never slides and no new actors are ever born: a bare headless boot
;; loads the boot continue's want set and then sits there. Every streaming validation
;; and every section-boundary repro so far has therefore needed a human on a controller.
;;
;; Until the real race/target chain drives the camera, hop it across every buildable
;; continue in the game, not just the boot continue's own family: every
;; *jakx-cam-fly-dwell* frames, warp onto the next eligible continue in list order,
;; wrapping at the end for successive laps. Candidate selection starts from
;; jakx-want-driver-tick's filter: jakx-continue-buildable? in place of the old
;; same-:level-home pin (issue 550 supersedes that pin with a generated buildability
;; gate; lightjak grid-starts stay excluded) so the flight can still only ever visit
;; continues whose want sets are actually built, now wherever they sit.
;;
;; Issue 581 adds one more filter buildability alone does not cover: residency.
;; jakx-cam-warp-to-continue (cam-start.gc:132) refuses to arm a warp whose target
;; level is not currently loaded (the same level-get shape used here), so a
;; buildable-but-not-resident candidate used to warp silently: 104 of 112 hops in one
;; session no-op'd this way, and the camera sat parked in whatever level the last
;; successful warp landed in while the want driver had already moved on. Filtering on
;; residency here turns those silent no-ops into effective hops, and does not weaken
;; the streaming test: a hop-warp teleports and therefore needs residency NOW, while
;; continuous approach toward a not-yet-resident continue is the want driver's own
;; job, and the driver still loads levels as the camera settles at each hop.
;;
;; Dwell must stay under the re-arm window jakx-cam-warp-to-continue sets, or the pin
;; lapses between hops and the ring's settle drags the camera back toward the origin.
;;
;; Off by default for interactive boots: it moves the camera, so it must never surprise
;; one. Smoke boots arm it with gk's -cam-fly arg, read here from the kernel symbol; the
;; REPL can still flip it live. Retire with the camera start chain.
(define *jakx-cam-fly* (if *kernel-boot-cam-fly* #t #f))
(define *jakx-cam-fly-dwell* 300)
(define *jakx-cam-fly-frame* 0)
(define *jakx-cam-fly-index* 0)

(defun jakx-cam-fly-tick ()
  "og:preserve-this bring-up flight driver: advance the camera one race continue every
*jakx-cam-fly-dwell* frames so streaming laps run with no pilot. See the block above."
  (when (and *jakx-cam-fly* *jakx-want-driver-cp* (nonzero? *level-load-list*))
    (+! *jakx-cam-fly-frame* 1)
    (when (>= *jakx-cam-fly-frame* *jakx-cam-fly-dwell*)
      (set! *jakx-cam-fly-frame* 0)
      (let ((home (-> *jakx-want-driver-cp* level))
            (want *jakx-cam-fly-index*)
            (seen 0)
            (pick (the continue-point #f))
            )
        (let ((lst *level-load-list*))
          (while (not (null? lst))
            (let* ((info (the-as level-load-info (-> (the-as symbol (car lst)) value)))
                   (conts (-> info continues))
                   )
              (while (not (null? conts))
                (let ((cp (the-as continue-point (car conts))))
                  ;; issue 581: skip non-resident targets too -- jakx-cam-warp-to-continue
                  ;; refuses them downstream anyway (a teleport needs residency now); see
                  ;; the block comment above.
                  (when (and (jakx-continue-buildable? cp)
                             (not (logtest? (-> cp flags) (continue-flags lightjak)))
                             (level-get *level* (-> cp level))
                             )
                    (when (and (not pick) (= seen want))
                      (set! pick cp)
                      )
                    (set! seen (+ seen 1))
                    )
                  )
                (set! conts (cdr conts))
                )
              )
            (set! lst (cdr lst))
            )
          )
        (cond
          (pick
            (format 0 "cam-fly: hop ~D of ~D -> ~S~%" *jakx-cam-fly-index* seen (-> pick name))
            (jakx-cam-warp-to-continue pick)
            (set! *jakx-cam-fly-index* (+ *jakx-cam-fly-index* 1))
            )
          (else
            ;; walked past the end of the family: wrap for the next lap. Guard the
            ;; empty-family case too, or index 0 would never resolve and this would
            ;; spin silently once per dwell.
            (if (zero? seen)
                (format 0 "cam-fly: no race continues for ~A, flight idle~%" home)
                )
            (set! *jakx-cam-fly-index* 0)
            )
          )
        )
      )
    )
  (none)
  )

(defun jakx-want-slide-safe? ((cand-names (pointer symbol)) (cand-count int))
  "og:preserve-this bring-up guard: refuse a slide whose want set would evict a section
the camera is inside. Proven live on icelands (2026-08-12): ice-icea-1's two-entry want
set evicted iced at the border, deactivate(kill) under the racer, because want-levels'
name diff discards anything the new set omits. A slide may only fire once every current
window member the camera is inside-boxes? of survives into the candidate's set, so
evictions happen behind the racer, never underneath. The 2026-08-12 net-world decode
proved retail has no mid-race slide to inherit this rule from: races stage one want set
via wait-for-levels and never move it, so border safety is this driver's own problem.

Issue 550 rung R6 retired the continue-point candidate this took (the driver no longer
selects by continue): cand-names/cand-count are the plain window it is about to commit
(tiny-center, tiny0, tiny1). The swap rule that produces that window provably implies
this guard already (0 refusals in 33 simulated swap attempts, design comment), so this
stays wired in as a belt-and-braces assertion rather than the load-bearing gate it used
to be."
  (let ((safe #t))
    (dotimes (i 6)
      (let ((cur-name (-> *load-state* want i name)))
        (when cur-name
          (dotimes (j (-> *level* length))
            (let ((lev (-> *level* level j)))
              (when (and (= (-> lev name) cur-name)
                         (= (-> lev status) 'active)
                         (-> lev inside-boxes?)
                         )
                (let ((kept #f))
                  (dotimes (k cand-count)
                    (if (= (-> cand-names k) cur-name)
                        (set! kept #t)
                        )
                    )
                  (if (not kept)
                      (set! safe #f)
                      )
                  )
                )
              )
            )
          )
        )
      )
    safe
    )
  )

(defun jakx-level-name-built? ((name symbol))
  "og:preserve-this buildability check (issue 550 rung R1/R6): linear scan of the
generated *jakx-built-levels* allowlist above. Same scan jakx-continue-buildable? does
per want slot, factored out here so the geometry selection below (which checks
buildability per CANDIDATE LEVEL, not per continue) does not duplicate it inline."
  (let ((found #f))
    (dotimes (i (-> *jakx-built-levels* length))
      (if (= (-> *jakx-built-levels* i) name)
          (set! found #t)
          )
      )
    found
    )
  )

(defun jakx-find-level-bound ((name symbol))
  "og:preserve-this row lookup (issue 550 rung R6): linear scan of the generated
*jakx-level-bounds* table above for the row matching `name`, or #f. The table is under
400 entries and this runs a handful of times per 30-frame tick, not per frame."
  (let ((found (the jakx-level-bound #f)))
    (dotimes (i (-> *jakx-level-bounds* length))
      (if (= (-> (-> *jakx-level-bounds* i) name) name)
          (set! found (-> *jakx-level-bounds* i))
          )
      )
    found
    )
  )

(defun jakx-level-bound-dist ((lb jakx-level-bound) (p vector))
  "og:preserve-this distance primitive (issue 550 rung R6 design): d(L, p) = min over the
row's K clustered bounding spheres of |sphere-center - p| - sphere-radius, clamped at 0
(inside any sphere counts as distance 0, never negative)."
  (let ((best 1000000000000000000.0))
    (dotimes (i (-> lb sphere-count))
      (let* ((s (-> lb spheres i))
             (dx (- (-> s x) (-> p x)))
             (dy (- (-> s y) (-> p y)))
             (dz (- (-> s z) (-> p z)))
             (d (- (sqrtf (+ (* dx dx) (* dy dy) (* dz dz))) (-> s w)))
             )
        (when (< d best)
          (set! best d)
          )
        )
      )
    (fmax 0.0 best)
    )
  )

(defun jakx-nearest-continue-in-family ((family int) (p vector))
  "og:preserve-this richness-donor lookup (issue 550 rung R6): the nearest buildable
continue point whose owning level's family-id matches `family`, or #f. *jakx-want-driver-cp*
no longer drives window selection (jakx-want-driver-tick below does that from
*jakx-level-bounds* geometry), but other bring-up code still reads it -- vehicle type,
the boot-cp arming path in `play`, jakx-racer-tick, jakx-cam-fly-tick -- so the driver
keeps it populated as a representative continue for whichever family the geometry
selected. Walk structure mirrors jakx-cam-fly-tick's *level-load-list* walk above."
  (let ((best (the continue-point #f))
        (best-d 1000000000000000000.0)
        )
    (let ((lst *level-load-list*))
      (while (not (null? lst))
        (let* ((info (the-as level-load-info (-> (the-as symbol (car lst)) value)))
               (conts (-> info continues))
               )
          (while (not (null? conts))
            (let ((cp (the-as continue-point (car conts))))
              (when (jakx-continue-buildable? cp)
                (let ((lb (jakx-find-level-bound (-> cp level))))
                  (when (and lb (= (-> lb family-id) family))
                    (let* ((dx (- (-> cp trans x) (-> p x)))
                           (dy (- (-> cp trans y) (-> p y)))
                           (dz (- (-> cp trans z) (-> p z)))
                           (d (+ (* dx dx) (* dy dy) (* dz dz)))
                           )
                      (when (or (not best) (< d best-d))
                        (set! best cp)
                        (set! best-d d)
                        )
                      )
                    )
                  )
                )
              )
            (set! conts (cdr conts))
            )
          )
        (set! lst (cdr lst))
        )
      )
    best
    )
  )

(defun jakx-want-driver-tick ()
  "og:preserve-this bring-up want driver for free exploration of the section families.
An earlier docstring claimed retail refreshes wants from race position through
game-info.gc; the 2026-08-12 scoped decodes falsified that: retail level-update's
continue block is an empty-bodied guard, set-continue! never touches wants, and races
stage their window once through net-world (task-selected continue, method 76,
check-start-load, wait-for-levels) with no positional input anywhere. Free exploration
of the w-families therefore has no retail mechanism to port, and this driver is the
authored stand-in.

Issue 550 rung R6 replaced the SELECTION index: this used to walk continue points and
take the nearest one (a continue-point-count-scarcity problem the origin issue
root-caused the icelands dead zone to -- the whole circuit has exactly two usable
continues). It now reads real level geometry from the generated *jakx-level-bounds*
table above (drawable-tree BVH bounding spheres, K-means clustered by
scripts/jakx/gen_level_bounds.py) every 30 frames: the active family is picked by
scoring built tiny/tiny-center MEMBERS, not tiny-center rows directly (issue 581; see
below), a HARD filter -- family-id comes from the co-want graph's connected
components, never from geometry, since armed families overlap in coordinate space; see
that script's header for why), then the two nearest built 'tiny members of that same
family are held, swapping the farther for a nearer non-member only when the non-member
beats it by the existing 1.4x hysteresis factor. Composes with R1:
jakx-level-name-built? gates every candidate against the same generated
*jakx-built-levels* allowlist jakx-continue-buildable? uses. Continue points are no
longer the selection index but are kept as the boot seed (`play`'s boot-cp arming path)
and as a richness donor: *jakx-want-driver-cp* still gets set, via
jakx-nearest-continue-in-family, to the nearest buildable continue in whichever family
the geometry just picked, so the vehicle-type/sound-adjacent bring-up code that reads it
keeps working unchanged. *jakx-want-driver-level* is new: the current primary (tiny-center)
level symbol, used to detect a family change from one tick to the next.

Issue 581: pass 1 originally scored the tiny-center row itself, and point-to-sphere
distance systematically favors coarse-clustered families (few large spheres -- krasw's
8 clusters at 300-580m radii) over fine ones (icew's many small real spheres) even when
the fine family's own territory is where the camera actually sits: at iced-start krasw
scored 1224m to icew's 1715m though the camera sat inside an iced cluster, so
family-changed below tripped on every single tick and the swap arm's 1.4x rule never
ran, the whole circuit stuck rescoring the same dead bootstrap forever. The fix scores
every built tiny/tiny-center member whose family owns a built tiny-center at all, takes
the family of the nearest such member, then re-selects that family's own nearest built
tiny-center. Hysteresis on this scan was measured and rejected: the krasw flip at
iced-start survives the swap arm's 1.4x factor by only 0.08%. Honest limit: family
attribution stays ill-posed in overlap zones -- 57 mis-attributions under the old rule
fall to 41 under this one, across 128 sampled member positions; a residency preference
would close more of those and is deliberately not added here."
  ;; og:preserve-this fix (issue diagnosis: "DGO RPC LoadDGO junglef.DGO file not
  ;; found", junglef's load-info at level-info.gc:407-411 carries :nickname 'jgf and
  ;; the on-disc artifact is JGF.DGO): load-begin (level.gc:1346-1349) only formats
  ;; the DGO filename from a level's nickname when (-> this load-name) equals (-> this
  ;; info visname); adjudicated against jak3's byte-identical landed twin
  ;; (jak3/engine/level/level.gc:1681-1684) and a fresh scoped decode of jakx's own
  ;; level.o (scratch, this rung) at the same offsets, both matching verbatim, so the
  ;; visname compare is retail machine code, not a decode misreading, and load-begin
  ;; itself is untouched. load-name is set by level-get-for-use via remap-level-name
  ;; (this file), which ignores whatever alias (name/visname/nickname) a caller
  ;; passed and instead reads only the global (-> *level* vis?) flag: #t picks
  ;; visname (so load-begin's compare succeeds and nickname wins), #f picks the
  ;; literal name (level-get-for-use rewrites every request down to the plain name
  ;; either way). Retail arms vis? once per session via play's own (set! (-> *level*
  ;; vis?) arg0), called #t from play-boot/play2 (this file); neither has any call
  ;; site anywhere in goal_src/jakx. bg (this file) also arms vis? when its argument
  ;; is a visname and actively CLEARS it on any other alias, and the boot path's own
  ;; (bg *kernel-boot-level*) arms it on default boots -- measured: pre-fix boots
  ;; nickname-resolved the whole ice ring (ICD.DGO in the log). The live defect was
  ;; therefore any plain-name bg call (the old jakx-goto-level, main.gc's
  ;; (bg 'halfpipe)) DISARMING vis? mid-session, after which every driver load took
  ;; load-begin's plain-name branch regardless of nickname (junglef.DGO, not
  ;; JGF.DGO). This function is the unconditional per-frame heart of that
  ;; loading (level-update calls it every frame with no gate), so holding the
  ;; invariant true here makes the driver immune to any residual plain-name bg
  ;; caller; the mirror fix for the debug-menu's manual switch lever is on
  ;; jakx-goto-level's own bg calls below, which resolve and pass the visname
  ;; directly instead. Retires when a real boot sequence wires play's own vis?
  ;; arming into whatever actually invokes play in this bring-up, making this
  ;; redundant.
  (set! (-> *level* vis?) #t)
  (when *jakx-campath-record*
    (+! *jakx-campath-frame* 1)
    (when (>= *jakx-campath-frame* 20)
      (set! *jakx-campath-frame* 0)
      (let ((mc (view-get-math-camera 0)))
        (when (nonzero? (the-as int mc))
          (format 0 "campath: ~f ~f ~f~%" (-> mc trans x) (-> mc trans y) (-> mc trans z))
          )
        )
      )
    )
  ;; og:preserve-this boot camera placement (issue 581 follow-through): a default boot
  ;; leaves the free-fly camera parked at the origin -- probe captures read cam pos
  ;; 0.0 0.0 0.0, hanging over the skybox -- because R6 (#122) dropped the boot-time
  ;; (jakx-cam-warp-to-continue boot-cp) call from `play` (see the retired note near
  ;; *jakx-want-driver-cp*'s boot-cp arm below) on the theory that initialize!'s own
  ;; continue path (move-camera!, game-info method 11) would place the camera instead;
  ;; that path is still a placeholder (per the same retired note) and never moves it.
  ;; The call cannot simply move back into `play`: at boot-cp arming time the
  ;; continue's own level is still 'loading (want-levels was just issued), and
  ;; jakx-cam-warp-to-continue refuses to arm against a level that is not resident
  ;; (cam-start.gc:132-134), the same residency shape jakx-cam-fly-tick's own filter
  ;; relies on above. So this polls once a tick instead: while
  ;; *jakx-boot-camera-placed* is still #f and *jakx-boot-continue* names a continue
  ;; (the REPL can set it #f to disable the boot-continue path entirely, level-h.gc),
  ;; resolve that continue and check its level's residency the level-status? shape
  ;; uses (status 'loaded or 'active, level.gc:501) -- not just level-get truthy,
  ;; since a level object can exist mid-load. Once resident, warp and latch so this
  ;; never re-arms; a re-arm would fight the pad-fallback camera and the racer chase
  ;; pin, which write the same math-camera destinations jakx-cam-pin-view! does
  ;; (cam-start.gc). This block is deliberately NOT gated on *jakx-want-driver*:
  ;; placement is boot behavior, not exploration behavior, and the call site that
  ;; reaches this function (level-update, this file) is itself unconditional, so no
  ;; contortion is needed to run it regardless of the driver flag's value -- with the
  ;; flag now defaulting on (above), it fires either way. Retire with the real camera
  ;; start chain (move-camera!'s own landing), same retirement condition as
  ;; jakx-cam-warp-to-continue itself.
  (when (and (not *jakx-boot-camera-placed*) *jakx-boot-continue*)
    (let ((boot-cp (jakx-find-continue-point (the-as string *jakx-boot-continue*))))
      (when boot-cp
        (let ((lev (level-get *level* (-> boot-cp level))))
          (when (and lev (or (= (-> lev status) 'loaded) (= (-> lev status) 'active)))
            (jakx-cam-warp-to-continue boot-cp)
            (set! *jakx-boot-camera-placed* #t)
            )
          )
        )
      )
    )
  (when (and *jakx-want-driver* *jakx-want-driver-cp* (nonzero? *level-load-list*))
    (+! *jakx-want-driver-frame* 1)
    (when (>= *jakx-want-driver-frame* 30)
      (set! *jakx-want-driver-frame* 0)
      (let ((mc (view-get-math-camera 0)))
        (when (nonzero? (the-as int mc))
          (let ((cam (-> mc trans))
                (best-center (the jakx-level-bound #f))
                (best-center-d 1000000000000000000.0)
                )
            ;; pass 1 (issue 581 fix, see the docstring above): score the family a
            ;; candidate member belongs to, not the tiny-center row directly, then take
            ;; that family's own nearest built tiny-center as best-center. Restricting
            ;; the family scan to members whose family owns a built tiny-center avoids
            ;; ever landing on a family with none to select below.
            (let ((best-family (the int32 -1)) (best-family-d 1000000000000000000.0))
              (dotimes (i (-> *jakx-level-bounds* length))
                (let ((lb (-> *jakx-level-bounds* i)))
                  (when (and (or (= (-> lb memory-mode) 'tiny) (= (-> lb memory-mode) 'tiny-center))
                             (jakx-level-name-built? (-> lb name))
                             )
                    (let ((fam (-> lb family-id)) (has-center #f))
                      (dotimes (j (-> *jakx-level-bounds* length))
                        (let ((cb (-> *jakx-level-bounds* j)))
                          (if (and (= (-> cb memory-mode) 'tiny-center)
                                   (= (-> cb family-id) fam)
                                   (jakx-level-name-built? (-> cb name))
                                   )
                              (set! has-center #t)
                              )
                          )
                        )
                      (when has-center
                        (let ((d (jakx-level-bound-dist lb cam)))
                          (when (< d best-family-d)
                            (set! best-family-d d)
                            (set! best-family fam)
                            )
                          )
                        )
                      )
                    )
                  )
                )
              (dotimes (i (-> *jakx-level-bounds* length))
                (let ((lb (-> *jakx-level-bounds* i)))
                  (when (and (= (-> lb memory-mode) 'tiny-center)
                             (= (-> lb family-id) best-family)
                             (jakx-level-name-built? (-> lb name))
                             )
                    (let ((d (jakx-level-bound-dist lb cam)))
                      (when (< d best-center-d)
                        (set! best-center-d d)
                        (set! best-center lb)
                        )
                      )
                    )
                  )
                )
              )
            (when best-center
              (let* ((family (-> best-center family-id))
                     (family-changed (!= (-> best-center name) *jakx-want-driver-level*))
                     (cur0-name (-> *jakx-want-driver-tiny* 0))
                     (cur1-name (-> *jakx-want-driver-tiny* 1))
                     (cand-tiny0-name cur0-name)
                     (cand-tiny1-name cur1-name)
                     (slid #f)
                     )
                (cond
                  (family-changed
                    ;; bootstrap: hold the two geometrically nearest built 'tiny members
                    ;; outright, no hysteresis on first entry to a family
                    (let ((n0 (the jakx-level-bound #f)) (n0-d 1000000000000000000.0)
                          (n1 (the jakx-level-bound #f)) (n1-d 1000000000000000000.0)
                          )
                      (dotimes (i (-> *jakx-level-bounds* length))
                        (let ((lb (-> *jakx-level-bounds* i)))
                          (when (and (= (-> lb memory-mode) 'tiny)
                                     (= (-> lb family-id) family)
                                     (jakx-level-name-built? (-> lb name))
                                     )
                            (let ((d (jakx-level-bound-dist lb cam)))
                              (cond
                                ((< d n0-d)
                                 (set! n1 n0) (set! n1-d n0-d)
                                 (set! n0 lb) (set! n0-d d)
                                 )
                                ((< d n1-d)
                                 (set! n1 lb) (set! n1-d d)
                                 )
                                )
                              )
                            )
                          )
                        )
                      (set! cand-tiny0-name (if n0 (-> n0 name) #f))
                      (set! cand-tiny1-name (if n1 (-> n1 name) #f))
                      )
                    )
                  (else
                    ;; within-family swap rule (issue 550 design): hold the current two
                    ;; tiny members; swap the farther for the nearest built non-member
                    ;; only when nearest*1.4 < farther.
                    (let* ((cur0 (jakx-find-level-bound cur0-name))
                           (cur1 (jakx-find-level-bound cur1-name))
                           (d0 (if cur0 (jakx-level-bound-dist cur0 cam) 1000000000000000000.0))
                           (d1 (if cur1 (jakx-level-bound-dist cur1 cam) 1000000000000000000.0))
                           (far-is-0 (> d0 d1))
                           (far-d (if far-is-0 d0 d1))
                           (near-non (the jakx-level-bound #f))
                           (near-non-d 1000000000000000000.0)
                           )
                      (dotimes (i (-> *jakx-level-bounds* length))
                        (let ((lb (-> *jakx-level-bounds* i)))
                          (when (and (= (-> lb memory-mode) 'tiny)
                                     (= (-> lb family-id) family)
                                     (!= (-> lb name) cur0-name)
                                     (!= (-> lb name) cur1-name)
                                     (jakx-level-name-built? (-> lb name))
                                     )
                            (let ((d (jakx-level-bound-dist lb cam)))
                              (when (< d near-non-d)
                                (set! near-non-d d)
                                (set! near-non lb)
                                )
                              )
                            )
                          )
                        )
                      (when (and near-non (< (* near-non-d 1.4) far-d))
                        (set! slid #t)
                        (if far-is-0
                            (set! cand-tiny0-name (-> near-non name))
                            (set! cand-tiny1-name (-> near-non name))
                            )
                        )
                      )
                    )
                  )
                (when (or family-changed slid)
                  (let ((cand-names (new 'stack-no-clear 'array 'symbol 3)))
                    (set! (-> cand-names 0) (-> best-center name))
                    (set! (-> cand-names 1) cand-tiny0-name)
                    (set! (-> cand-names 2) cand-tiny1-name)
                    (if (jakx-want-slide-safe? cand-names 3)
                        (begin
                          ;; runtime format warning (design acceptance item 3): a want
                          ;; set should never carry 3 tiny sections (one tiny-center plus
                          ;; two rotation slots, always) or a duplicate slot -- both are
                          ;; unreachable by construction above, so this is free insurance
                          ;; against a future regression, not a live path.
                          (when (= cand-tiny0-name cand-tiny1-name)
                            (format 0 "want-driver: WARNING duplicate tiny slot ~A in the ~
window~%" cand-tiny0-name)
                            )
                          (set! *jakx-want-driver-level* (-> best-center name))
                          (set! (-> *jakx-want-driver-tiny* 0) cand-tiny0-name)
                          (set! (-> *jakx-want-driver-tiny* 1) cand-tiny1-name)
                          (let ((donor (jakx-nearest-continue-in-family family cam)))
                            (when donor
                              (set! *jakx-want-driver-cp* donor)
                              )
                            )
                          (format 0 "want-driver: window = ~A ~A ~A~%"
                                  (-> best-center name) cand-tiny0-name cand-tiny1-name
                                  )
                          (let ((a1-11 (new 'stack-no-clear 'array 'symbol 18)))
                            (dotimes (i 18)
                              (set! (-> a1-11 i) #f)
                              )
                            (set! (-> a1-11 0) (-> best-center name))
                            (set! (-> a1-11 1) cand-tiny0-name)
                            (set! (-> a1-11 2) cand-tiny1-name)
                            (want-levels *load-state* a1-11)
                            )
                          ;; display every member (the driver already did before this
                          ;; rung; the un-display bug the old code's comment documented
                          ;; is unrelated to the selection change and stays fixed here:
                          ;; want-levels initialises every newly added entry hidden, and
                          ;; promoting it straight to 'display is what makes a freshly
                          ;; wanted section actually draw instead of waiting for a later
                          ;; flip point this driver never reaches).
                          (want-display-level *load-state* (-> best-center name) 'display)
                          (when cand-tiny0-name
                            (want-display-level *load-state* cand-tiny0-name 'display)
                            )
                          (when cand-tiny1-name
                            (want-display-level *load-state* cand-tiny1-name 'display)
                            )
                          (want-vis-level *load-state* (-> best-center name))
                          (let ((snd (new 'stack-no-clear 'array 'symbol 4)))
                            (set! (-> snd 0) (-> best-center sound))
                            (set! (-> snd 1) #f)
                            (set! (-> snd 2) #f)
                            (set! (-> snd 3) #f)
                            (want-sound-banks *load-state* snd)
                            )
                          )
                        ;; jakx-want-slide-safe? refused (should not happen -- the swap
                        ;; rule provably implies it, design comment): leave every
                        ;; persisted slot untouched and retry from the same base state
                        ;; next tick, exactly like the old continue-walk driver did.
                        (none)
