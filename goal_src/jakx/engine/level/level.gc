;;-*-Lisp-*-
(in-package goal)

;; name: level.gc
;; name in dgo: level
;; dgos: ENGINE, GAME

;; forward references to texture-anim files (not yet decompiled)
(define-extern *default-pris-texture-anim-array* (texture-anim-array texture-anim))
(define-extern *default-car-texture-anim-array* (texture-anim-array texture-anim))
(define-extern *default-hud-texture-anim-array* (texture-anim-array texture-anim))
(define-extern *default-water-texture-anim-array* (texture-anim-array texture-anim))

;; forward references: both are defined further down this file, below the callers that need them
(define-extern level-update-after-load (function level login-state level))
(define-extern update-sound-banks (function load-state (inline-array sound-bank-state) none))

;; functions whose own files are not decompiled yet
(define-extern target-get-any-pos (function vector)) ;; jakx-new; returns a target position
(define-extern view-get-active-index (function int))

;; display-side function defined later in the build (logic-target.gc)
;; og:preserve-this arity fix, R4 (#122): stop's real signature takes a second int arg
;; (the view-push-context context index); see logic-target.gc and all-types.gc for the
;; full derivation. Mirrored here since this forward-decl predates the fix.
(define-extern stop (function symbol int int))

;; jakx: globals and functions referenced by the load chain, homes not yet decompiled
(define-extern *level-type-list* type)
(declare-type net-world process)
;; og:preserve-this bring-up: #f until net-world.gc decompiles; login-begin's
;; (send-event *net-world* ...) must see #f (undefined would read 0 = truthy and
;; send-event-function would deref low memory).
(define *net-world* (the-as net-world #f))
;; og:preserve-this runtime-link guard, R2 of the retail-staging ladder (#192):
;; net-world.o (429) compiles after level.o (267), the same house idiom as
;; texture.gc:1869's *car-level-array* guard below. play calls this through the
;; (nonzero? jakx-stage-boot-task) check; by the time play runs, the whole GAME CGO
;; has linked and the symbol is bound.
(define-extern jakx-stage-boot-task (function none))
(define-extern *car-level-array* car-level-array)
(define-extern *entity-more-perm* entity-more-perm-hash)
(define-extern texture-page-default-allocate (function texture-pool texture-page kheap int texture-page))
(define-extern texture-page-level-allocate (function texture-pool texture-page kheap int texture-page))

;; jakx functions not yet decompiled elsewhere (texture/dma/view/net); sigs derived from level.o call sites
(define-extern relocate-later (function symbol))
(define-extern build-masks (function bsp-header none))
(define-extern sound-bank-unload (function sound-name int))
(define-extern unlink-lightning-spec-by-heap (function kheap none))
(define-extern update-task-masks (function symbol int))
(define-extern view-get-camera (function int process))
(define-extern view-get-target (function int process))
(define-extern unlink-textures-by-level (function level int))
(define-extern update-car-texture-anim-array (function int))
(define-extern tweak-local-net-entities (function int))
(define-extern adgif-shader-login-no-remap (function adgif-shader texture))

