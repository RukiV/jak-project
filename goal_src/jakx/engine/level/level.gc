      )
    (let ((v1-22 1)
          (a0-5 6)
          )
      (while (>= a0-5 v1-22)
        (let ((a1-2 1))
          (when (and (nonzero? (-> arg0 want-sound v1-22 name)) (-> arg0 want-sound v1-22 name))
            (until #f
