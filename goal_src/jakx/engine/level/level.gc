;; definition for method 30 of type level-group
;; WARN: Return type mismatch int vs level.
(defmethod level-group-method-30 ((this level-group) (arg0 int))
  (set! (-> this level arg0 filter-num) (the-as uint 0))
  (the-as level 0)
  )

;; definition for method 31 of type level-group
(defmethod level-group-method-31 ((this level-group) (arg0 int) (arg1 string))
  (let ((gp-0 (-> this level arg0)))
    (when (< (-> gp-0 filter-num) (the-as uint 16))
      (copy-string<-string (-> gp-0 filter-name (-> gp-0 filter-num)) arg1)
      (+! (-> gp-0 filter-num) 1)
      )
    )
  0
  )

