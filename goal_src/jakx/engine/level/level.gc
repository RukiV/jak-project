             (let ((sv-112 (new 'stack-no-clear 'event-message-block)))
               (set! (-> sv-112 from) (process->ppointer pp))
               (set! (-> sv-112 num-params) 1)
               (set! (-> sv-112 message) 'level-activate)
               (set! (-> sv-112 param 0) (the-as uint (-> this name)))
               (send-event-function (view-get-camera s0-0) sv-112)
               )
             (let ((sv-144 (new 'stack-no-clear 'event-message-block)))
               (set! (-> sv-144 from) (process->ppointer pp))
               (set! (-> sv-144 num-params) 1)
               (set! (-> sv-144 message) 'level-activate)
               (set! (-> sv-144 param 0) (the-as uint (-> this name)))
