    (let ((v1-6 (-> *game-info* player-info (view-get-active-index) current-continue level)))
      (dotimes (a0-4 (-> this length))
        (let ((a1-8 (-> this level a0-4)))
          (when (= (-> a1-8 status) 'active)
            (if (and (= (-> a1-8 name) v1-6) (not (logtest? (-> a1-8 info level-flags) (level-flags not-physical))))
                (return a1-8)
                )
            )
          )
        )
      )
    (let ((s4-1 (the-as level #f)))
      (let ((f30-0 0.0))
        (dotimes (s3-0 (-> this length))
          (let ((s2-0 (-> this level s3-0)))
            (when (= (-> s2-0 status) 'active)
              (let ((f0-0 (vector-vector-distance (-> s2-0 bsp bsphere) s5-0)))
                (if (and (-> s2-0 inside-boxes?)
                         (not (logtest? (-> s2-0 info level-flags) (level-flags not-physical)))
                         (or (not s4-1) (< f0-0 f30-0))
                         )
                    (set! s4-1 s2-0)
                    )
                )
              )
            )
          )
        )
      (if s4-1
          (return s4-1)
          )
      )
    )
  (dotimes (v1-27 (-> this length))
    (let ((a0-10 (-> this level v1-27)))
      (when (= (-> a0-10 status) 'active)
        (if (and (-> a0-10 meta-inside?) (not (logtest? (-> a0-10 info level-flags) (level-flags not-physical))))
            (return a0-10)
            )
        )
      )
    )
  (let ((v0-1 (the-as level #f)))
    0.0
    (dotimes (v1-30 (-> this length))
      (let ((a0-15 (-> this level v1-30)))
        (when (= (-> a0-15 status) 'active)
          (if (and (not v0-1) (not (logtest? (-> a0-15 info level-flags) (level-flags not-physical))))
              (set! v0-1 a0-15)
              )
          )
        )
      )
    v0-1
    )
  )

;; definition for method 8 of type level-group
(defmethod mem-usage ((this level-group) (usage memory-usage-block) (flags int))
  (dotimes (s3-0 (-> this length))
    (mem-usage (-> this level s3-0) usage flags)
    )
  this
  )

;; definition for function bg
;; WARN: Return type mismatch int vs none.
(defun bg ((arg0 symbol))
  (set! *cheat-mode* (if *debug-segment*
                         'debug
                         #f
                         )
        )
  (let ((v1-2 (lookup-level-info arg0)))
    (cond
      ((= (-> v1-2 visname) arg0)
       (set! (-> *level* vis?) #t)
       (set! arg0 (-> v1-2 name))
       )
      (else
        (set! (-> *level* vis?) #f)
        (set! (-> *kernel-context* low-memory-message) #f)
        )
      )
    )
  0
  (let ((s5-0 (level-get-for-use *level* arg0 'active -1)))
    (while (and s5-0
                (or (= (-> s5-0 status) 'loading) (= (-> s5-0 status) 'loading-bt) (= (-> s5-0 status) 'login))
                (not *dproc*)
                )
      (load-continue s5-0)
      )
    (reset! *load-state*)
    (set! (-> *load-state* vis-nick) (-> s5-0 name))
    (set! (-> *load-state* want 0 name) (-> s5-0 name))
    (set! (-> *load-state* want 0 display?) 'display)
    ;; og:preserve-this bring-up shim: the load-state update! method (which propagates
    ;; want -> target -> level display?) is not landed yet, so flip the level's
    ;; display? directly at boot activation. Retire with the update! landing.
    (if s5-0
        (set! (-> s5-0 display?) 'display)
        )
    (when (-> s5-0 info continues)
      (dotimes (s4-0 2)
        (let* ((a0-15 *game-info*)
               (t9-4 (method-of-object a0-15 set-continue!))
               (a1-2 (-> s5-0 info continues car))
               (a2-1 s4-0)
               )
          (t9-4 a0-15 (the-as basic a1-2) a2-1)
          )
        )
      )
    )
  (dotimes (v1-32 1)
    (set! (-> *load-state* want-sound v1-32 name)
          (-> *game-info* player-info 0 current-continue want-sound v1-32)
          )
    (set! (-> *load-state* want-sound v1-32 mode) (sound-bank-mode full))
    )
  (add-borrow-levels *load-state*)
  (activate-levels! *level*)
  (set! *print-login* #f)
  (cond
    ((= arg0 'halfpipe)
     (send-event (ppointer->process *time-of-day*) 'change 'ratio 0.0)
     (send-event (ppointer->process *time-of-day*) 'change 'hour 14)
     (set! (-> *time-of-day-context* mode) (time-of-day-palette-id unk0 unk1))
     )
    (else
      (set! (-> *time-of-day-context* mode) (time-of-day-palette-id unk3))
      )
    )
  0
  (none)
  )

;; definition for function play
;; og:preserve-this bring-up externs: home is cam-start.gc, which compiles after the
;; camera ring types this file cannot see. Retire with the warp helpers.
(define-extern jakx-cam-warp-to-level (function level none))
(define-extern jakx-cam-warp-to-continue (function continue-point none))

;; og:preserve-this bring-up helper: look up a continue point by name across every
;; level-load-info's continues list, jak3 get-continue-by-name's walk without the
;; *game-info* half. Retires when game-info.gc lands.
;; og:preserve-this bring-up want driver state: armed by play when it boots a continue
;; point; consumed by jakx-want-driver-tick from level-update. Retires with the retail
;; continue/race position system in game-info.gc.
(define *jakx-want-driver* #t)
(define *jakx-want-driver-frame* 0)
(define *jakx-want-driver-cp* (the continue-point #f))

(defun jakx-find-continue-point ((arg0 string))
  (let ((v1-0 *level-load-list*))
    (while (not (null? v1-0))
      (let* ((a1-0 (-> (the-as symbol (car v1-0)) value))
             (a2-0 (-> (the-as level-load-info a1-0) continues))
             )
        (while (not (null? a2-0))
          (let ((a3-0 (car a2-0)))
            (if (string= arg0 (-> (the-as continue-point a3-0) name))
                (return (the-as continue-point a3-0))
                )
            )
          (set! a2-0 (cdr a2-0))
          )
        )
      (set! v1-0 (cdr v1-0))
      )
    )
  (the-as continue-point #f)
  )

;; og:preserve-this bring-up camera path recorder: while enabled, level-update's tick
;; prints the active camera position a few times a second. A recorded flight bakes
;; into a replay probe (scratchpad tooling) so streaming validation laps run without
;; a pilot. Costs a handful of log lines per second; retire with the race/target legs.
(define *jakx-campath-record* #t)
(define *jakx-campath-frame* 0)

;; og:preserve-this bring-up flight driver: the want driver picks the streaming window
;; from the camera position, and actor birth is distance-gated from that same camera
;; (entity.gc:742 vis-dist-ok? against *ACTOR-bank* birth-dist). So a parked camera
;; means the window never slides and no new actors are ever born: a bare headless boot
;; loads the boot continue's want set and then sits there. Every streaming validation
;; and every section-boundary repro so far has therefore needed a human on a controller.
;;
;; Until the real race/target chain drives the camera, hop it around the boot continue's
;; family: every *jakx-cam-fly-dwell* frames, warp onto the next race continue in list
;; order, wrapping at the end for successive laps. Candidate selection deliberately
;; mirrors jakx-want-driver-tick's filter (same :level home, lightjak grid-starts
;; excluded) so the flight can only ever visit continues whose want sets are built.
;;
;; Dwell must stay under the re-arm window jakx-cam-warp-to-continue sets, or the pin
;; lapses between hops and the ring's settle drags the camera back toward the origin.
;;
;; Off by default for interactive boots: it moves the camera, so it must never surprise
;; one. Smoke boots arm it with gk's -cam-fly arg, read here from the kernel symbol; the
;; REPL can still flip it live. Retire with the camera start chain.
(define *jakx-cam-fly* (if *kernel-boot-cam-fly* #t #f))
(define *jakx-cam-fly-dwell* 300)
(define *jakx-cam-fly-frame* 0)
(define *jakx-cam-fly-index* 0)

(defun jakx-cam-fly-tick ()
  "og:preserve-this bring-up flight driver: advance the camera one race continue every
*jakx-cam-fly-dwell* frames so streaming laps run with no pilot. See the block above."
  (when (and *jakx-cam-fly* *jakx-want-driver-cp* (nonzero? *level-load-list*))
    (+! *jakx-cam-fly-frame* 1)
    (when (>= *jakx-cam-fly-frame* *jakx-cam-fly-dwell*)
      (set! *jakx-cam-fly-frame* 0)
      (let ((home (-> *jakx-want-driver-cp* level))
            (want *jakx-cam-fly-index*)
            (seen 0)
            (pick (the continue-point #f))
            )
        (let ((lst *level-load-list*))
          (while (not (null? lst))
            (let* ((info (the-as level-load-info (-> (the-as symbol (car lst)) value)))
                   (conts (-> info continues))
                   )
              (while (not (null? conts))
                (let ((cp (the-as continue-point (car conts))))
                  (when (and (= (-> cp level) home)
                             (not (logtest? (-> cp flags) (continue-flags lightjak)))
                             )
                    (when (and (not pick) (= seen want))
                      (set! pick cp)
                      )
                    (set! seen (+ seen 1))
                    )
                  )
                (set! conts (cdr conts))
                )
              )
            (set! lst (cdr lst))
            )
          )
        (cond
          (pick
            (format 0 "cam-fly: hop ~D of ~D -> ~S~%" *jakx-cam-fly-index* seen (-> pick name))
            (jakx-cam-warp-to-continue pick)
            (set! *jakx-cam-fly-index* (+ *jakx-cam-fly-index* 1))
            )
          (else
            ;; walked past the end of the family: wrap for the next lap. Guard the
            ;; empty-family case too, or index 0 would never resolve and this would
            ;; spin silently once per dwell.
            (if (zero? seen)
                (format 0 "cam-fly: no race continues for ~A, flight idle~%" home)
                )
            (set! *jakx-cam-fly-index* 0)
            )
          )
        )
      )
    )
  (none)
  )

(defun jakx-want-driver-tick ()
  "og:preserve-this bring-up want driver: retail refreshes load-state wants from race
position through the continue-point system in game-info.gc (unlanded). Until it lands,
every 30 frames pick the continue point nearest the active camera within the boot
continue's family (same :level home, so only built DGO want sets are ever requested)
and apply its want set when it changes; update! then streams the section window."
  (when *jakx-campath-record*
    (+! *jakx-campath-frame* 1)
    (when (>= *jakx-campath-frame* 20)
      (set! *jakx-campath-frame* 0)
      (let ((mc (view-get-math-camera 0)))
        (when (nonzero? (the-as int mc))
          (format 0 "campath: ~f ~f ~f~%" (-> mc trans x) (-> mc trans y) (-> mc trans z))
          )
        )
      )
    )
  (when (and *jakx-want-driver* *jakx-want-driver-cp* (nonzero? *level-load-list*))
    (+! *jakx-want-driver-frame* 1)
    (when (>= *jakx-want-driver-frame* 30)
      (set! *jakx-want-driver-frame* 0)
      (let ((mc (view-get-math-camera 0)))
        (when (nonzero? (the-as int mc))
          (let ((cam (-> mc trans))
                (home (-> *jakx-want-driver-cp* level))
                (best (the continue-point #f))
                (best-d 0.0)
                (cur-d 1000000000000000000.0)
                )
            (let ((lst *level-load-list*))
              (while (not (null? lst))
                (let* ((info (the-as level-load-info (-> (the-as symbol (car lst)) value)))
                       (conts (-> info continues))
                       )
                  (while (not (null? conts))
                    (let ((cp (the-as continue-point (car conts))))
                      ;; skip grid-start continues (the lightjak flag marks them, on both
                      ;; jungle-wide-start and the havjung equivalent): they are pre-race
                      ;; configurations whose want sets drop the arrival section, so
                      ;; crossing the start line under one unloads the world around the
                      ;; camera. They share a trans with the first lap checkpoint, which
                      ;; must win the tie; lap flow belongs to the plain race continues.
                      (when (and (= (-> cp level) home)
                                 (not (logtest? (-> cp flags) (continue-flags lightjak)))
                                 )
                        (let* ((dx (- (-> cp trans x) (-> cam x)))
                               (dy (- (-> cp trans y) (-> cam y)))
                               (dz (- (-> cp trans z) (-> cam z)))
                               (d (+ (* dx dx) (* dy dy) (* dz dz)))
                               )
                          (if (= cp *jakx-want-driver-cp*)
                              (set! cur-d d)
                              )
                          (when (or (not best) (< d best-d))
                            (set! best cp)
                            (set! best-d d)
                            )
                          )
                        )
                      )
                    (set! conts (cdr conts))
                    )
                  )
                (set! lst (cdr lst))
                )
              )
            ;; hysteresis: switch only when the candidate is decisively closer than the
            ;; current continue (1.4x in linear distance, 0.5 in squared). The margin
            ;; only needs to prevent oscillation between distinct positions; 2x proved
            ;; too conservative in flight, starting the next section's load at ~80% of
            ;; the span between continues, which popped section A in at the lap line
            ;; (the e-1-to-line span covers all of section E). 1.4x starts it at ~2/3.
            (when (and best
                       (!= best *jakx-want-driver-cp*)
                       (< best-d (* 0.5 cur-d))
                       )
              (format 0 "want-driver: window slides to ~S~%" (-> best name))
              (set! *jakx-want-driver-cp* best)
              (let ((a1-11 (new 'stack-no-clear 'array 'symbol 18)))
                (dotimes (i 18)
                  (set! (-> a1-11 i) #f)
                  )
                (dotimes (i (min 4 (the int (-> best want-count))))
                  (set! (-> a1-11 i) (-> best want i name))
                  )
                (want-levels *load-state* a1-11)
                )
              ;; propagate every entry's display? value, including #f: want-levels keeps
              ;; an existing entry's flag by name, so a hidden want (jungle-wide-start's
              ;; jungleb) never lands unless pushed explicitly
              (dotimes (i (min 4 (the int (-> best want-count))))
                (let ((w (-> best want i)))
                  (want-display-level *load-state* (-> w name) (-> w display?))
                  )
                )
              (want-vis-level *load-state* (-> best vis-nick))
              )
            )
          )
        )
      )
    )
  0
  (none)
  )

(defun play ((arg0 symbol) (arg1 symbol))
  (kmemopen global "level-boot")
  (format 0 "(play)~%")
  (when *kernel-boot-level*
    (bg (string->symbol (the-as string *kernel-boot-level*)))
    (on #f)
    (kmemclose)
    (kmemclose)
    (return 0)
    )
  (let* ((v1-3 *kernel-boot-message*)
         (s5-0 (cond
                 ((= v1-3 'kiosk)
                  'fmvlev
                  )
                 (*debug-segment*
                   ;; og:preserve-this #56: during bring-up the boot lever wins over the
                   ;; retail debug default. menu2.DGO has never been built on this branch
                   ;; (game.gp keeps its cgo-file commented), so a -debug boot picked an
                   ;; unbuildable level and hung forever on a load that cannot complete,
                   ;; making every REPL-attached boot unusable. With no lever set, -debug
                   ;; keeps retail's menu2. Retires with the boot levers (#43 family).
                   (or *jakx-boot-level* 'menu2)
                   )
                 (else
                   ;; og:preserve-this bring-up lever: retail boots 'fmvlev (the intro
                   ;; movie level); *jakx-boot-level* picks the level to exercise the
                   ;; load chain with (brdroom = smallest real world-geometry DGO)
                   *jakx-boot-level*
                   )
                 )
               )
         ;; og:preserve-this bring-up: resolve the boot continue point (multi-level want
         ;; set plus start-line camera framing); #f falls back to the single-level path.
         ;; Gated on the normal boot path so kiosk/debug boots stay untouched.
         (boot-cp (if (and (= s5-0 *jakx-boot-level*)
                           *jakx-boot-continue*
                           (nonzero? *level-load-list*)
                           )
                      (jakx-find-continue-point (the-as string *jakx-boot-continue*))
                      (the-as continue-point #f)
                      )
                  )
         )
    (if (and *jakx-boot-continue* (= s5-0 *jakx-boot-level*) (not boot-cp))
        (format 0 "WARNING: boot continue ~S not found, booting level ~A~%" *jakx-boot-continue* s5-0)
        )
    (let ((t9-7 stop)
          (a0-7 'play)
          )
      0
      ;; og:preserve-this arity fix, R4 (#122): stop's second (int) argument added to
      ;; keep this pre-existing call site (6b46b40811, predates the leg) compiling
      ;; against the corrected signature. level.o has no decode artifact of its own
      ;; (out of R0's scoped object list), so the literal 0 is carried over from the
      ;; two other decoded call sites in the tree, both showing the same shape:
      ;; game-info.gc's anon-function-14 (game-info_ir2.asm op 7) and main.gc's off
      ;; (main_ir2.asm op 2, raw machine code, unaffected by decompiler-config
      ;; staleness). Re-verify against level.o's own decode when that leg lands.
      (t9-7 a0-7 0)
      )
    (set! (-> *level* vis?) arg0)
    (set! (-> *level* want-level) #f)
    (set! (-> *level* border?) #t)
    (set! (-> *setting-control* user-default border-mode) #t)
    (set! (-> *level* play?) #t)
    (init-level-system *level* #t)
    (set! *display-profile* #f)
    (set! *cheat-mode* (if *debug-segment*
                           'debug
                           #f
                           )
          )
    (set! *time-of-day-fast* #f)
    ;; og:preserve-this added nonzero check, matching jak3's PC port: *time-of-day* is not
    ;; spawned yet on the jakx bring-up (time-of-day.gc not decompiled).
    (when (nonzero? *time-of-day*)
      (send-event (ppointer->process *time-of-day*) 'change 'ratio 1.0)
      (send-event (ppointer->process *time-of-day*) 'change 'hour 7)
      (send-event (ppointer->process *time-of-day*) 'change 'minutes 0)
      (send-event (ppointer->process *time-of-day*) 'change 'seconds 0)
      (send-event (ppointer->process *time-of-day*) 'change 'frames 0)
      )
    (set! (-> *time-of-day-context* mode) (time-of-day-palette-id unk3))
    (set! (-> *mood-control* overide-weather-flag) #f)
    (set-blackout-frames (seconds 0.02))
    (when (not *dproc*)
      (reset! *load-state*)
      ;; og:preserve-this bring-up: the DGO load chain is live and load-state's update!
      ;; IS landed (level.gc, full 348-line retail port, runs every frame); an earlier
      ;; version of this note predated its landing and misled a session (#108). The
      ;; boot path still drives each level synchronously (jungle-a-1 = junglew
      ;; tiny-center + junglee tiny + junglea tiny, which exactly tiles the level
      ;; heap; the tiny allocator has two banks, so a want set can never carry three
      ;; tiny sections). The want-levels/want-display-level/want-vis-level calls feed
      ;; update! normally. Flip *jakx-boot-level-load* in the
      ;; REPL to skip the boot load entirely.
      (when (and (nonzero? *level-load-list*) *jakx-boot-level-load*)
        (let ((a1-11 (new 'stack-no-clear 'array 'symbol 18)))
          (dotimes (i 18)
            (set! (-> a1-11 i) #f)
            )
          (cond
            (boot-cp
              (dotimes (i (min 4 (the int (-> boot-cp want-count))))
                (set! (-> a1-11 i) (-> boot-cp want i name))
                )
              )
            (else
              (set! (-> a1-11 0) s5-0)
              (if (= s5-0 'ctysluma)
                  (set! (-> a1-11 1) 'ctywide)
                  )
              )
            )
          (want-levels *load-state* a1-11)
          )
        (cond
          (boot-cp
            ;; push every entry's display? value, including #f (see the want driver)
            (dotimes (i (min 4 (the int (-> boot-cp want-count))))
              (let ((w (-> boot-cp want i)))
                (want-display-level *load-state* (-> w name) (-> w display?))
                )
              )
            )
          (else
            (want-display-level *load-state* s5-0 'display)
            (if (= s5-0 'ctysluma)
                (want-display-level *load-state* 'ctywide 'display)
                )
            )
          )
        (want-vis-level *load-state* (if boot-cp (-> boot-cp vis-nick) s5-0))
        (cond
          (boot-cp
            (dotimes (i (min 4 (the int (-> boot-cp want-count))))
              (let ((w (-> boot-cp want i)))
                (format 0 "boot-continue: loading ~A (~D of ~D)~%" (-> w name) (+ i 1) (-> boot-cp want-count))
                (let ((s4-1 (level-get-for-use *level* (-> w name) 'active -1)))
                  (while (and s4-1
                              (or (= (-> s4-1 status) 'loading)
                                  (= (-> s4-1 status) 'loading-bt)
                                  (= (-> s4-1 status) 'login)
                                  )
                              )
                    (set-blackout-frames (seconds 0.02))
                    (load-continue s4-1)
                    )
                  )
                )
              )
            )
          (else
            (let ((s4-1 (level-get-for-use *level* s5-0 'active -1)))
              (while (and s4-1
                          (or (= (-> s4-1 status) 'loading)
                              (= (-> s4-1 status) 'loading-bt)
                              (= (-> s4-1 status) 'login)
                              )
                          )
                (set-blackout-frames (seconds 0.02))
                (load-continue s4-1)
                )
              )
            )
          )
        )
      )
    (set! *print-login* #f)
    (cond
      (boot-cp
        ;; og:preserve-this bring-up shim: activate and display each level of the continue
        ;; want set directly. Retirement condition unchanged from before R6: load-state's
        ;; update! method is landed (see the note above, near *jakx-boot-level-load*), but
        ;; this direct activation is not proven redundant with it and R6 did not touch it;
        ;; still Retires with the update! landing once that's confirmed.
        (dotimes (i (min 4 (the int (-> boot-cp want-count))))
          (let* ((w (-> boot-cp want i))
                 (lev (level-get *level* (-> w name)))
                 )
            (when lev
              (level-status-update! lev 'active)
              (if (= (-> w display?) 'display)
                  (set! (-> lev display?) 'display)
                  )
              )
            )
          )
        ;; og:preserve-this retired, R6 (#122): the boot-time (jakx-cam-warp-to-continue
        ;; boot-cp) call is gone; camera arrival at the continue now goes through
        ;; initialize!'s own continue path (move-camera!, game-info method 11, still a
        ;; placeholder per the leg brief section 1.9, so this is not yet a real camera
        ;; move; it is not a live hazard, matching risk register item 6). The function
        ;; and its extern are NOT deleted: jakx-cam-fly-tick (above) still calls it for
        ;; the smoke-test flight driver.
        ;; arm the bring-up want driver: from here on level-update's tick slides the
        ;; window as the camera crosses continue thresholds
        (set! *jakx-want-driver-cp* boot-cp)
        )
      (else
        ;; og:preserve-this added #f check: level-get returns #f while level loading is not
        ;; up yet on the bring-up; the original assumes the boot level always exists.
        (let ((s4-2 (level-get *level* s5-0)))
          (if s4-2
              (level-status-update! s4-2 'active)
              )
          ;; og:preserve-this bring-up shim: the load-state update! method (which propagates
          ;; want -> target -> level display?) is not landed yet, so flip the level's
          ;; display? directly after boot activation. Retire with the update! landing.
          (if s4-2
              (set! (-> s4-2 display?) 'display)
              )
          ;; og:preserve-this bring-up shim: no camera/target start chain is landed, so the
          ;; free camera sits at the origin ~400 m from brdroom's geometry. Warp the camera
          ;; ring onto the level once at boot activation. Retire with the camera start chain.
          (if s4-2
              (jakx-cam-warp-to-level s4-2)
              )
          )
        )
      )
    )
  (on #t)
  ;; og:preserve-this restored, R6 (#122): game-info.gc's initialize! landed by R3a
  ;; (85504cc1d), closing the reason this was disabled. The 296 static continue
  ;; points initialize! and its continue path can reach all carry :on-goto #f
  ;; (level-info.gc:87-89): the decompiler cannot emit the original anonymous lambdas,
  ;; so any continue whose retail behaviour lived in :on-goto silently does nothing now.
  ;; That gap is not this rung's to close; filed separately per the leg brief.
  (if arg1
      (initialize! *game-info* 'boot (the-as game-save #f) (the-as string #f) (the-as resetter-spec #f))
      )
  (kmemclose)
  (kmemclose)
  0
  )

;; definition for function play2
(defun play2 ((arg0 symbol) (arg1 symbol))
  (set! *use-menu2* #f)
  (play arg0 arg1)
  )

;; definition for function play-boot
