    process
    (lambda () (with-pp
                 (stack-size-set! (-> pp main-thread) 1024)
                 (play #t #t)
                 (none)
                 )
            )
    :name "play-boot"
    :from *4k-dead-pool*
    :stack *kernel-dram-stack*
    )
  0
  (none)
  )

