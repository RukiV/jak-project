;; og:preserve-this geometry-driven streaming window table (issue 550, rung R6). Row type
;; for the generated table below: one row per level-load-info :name that has real drawable
;; geometry, holding K representative bounding spheres (K-means clustered from the level's
;; drawable-tree BVH leaf spheres by scripts/jakx/gen_level_bounds.py; see that script's own
;; header for the three decode hardenings the design names), the co-want graph's family id
;; (connected components of every continue's :want array -- armed families overlap in
;; coordinate space, so family membership cannot come from geometry, per the design's
;; correction 2), and the family's want-sound symbol. :spheres holds up to 8 (x, y, z, r)
;; bounding spheres as vectors with the radius in w, the same convention `drawable`'s own
;; bsphere field uses; :sphere-count is how many of the 8 slots are populated (a level with
;; fewer than 8 clustered spheres pads the rest with a zeroed vector).
(deftype jakx-level-bound (basic)
  ((name         symbol)
   (memory-mode  symbol)
   (family-id    int32)
   (sound        symbol)
   (sphere-count int32)
   (spheres      vector 8 :inline)
   )
  )

