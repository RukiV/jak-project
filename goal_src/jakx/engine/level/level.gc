       )
     ;; og:preserve-this bring-up guard: *game-info* is a real define-perm static
     ;; (game-info-h.gc), but game-info.gc is a stub, so vtable slot 14 is null and the
     ;; dispatch was a call through zero (lldb: RIP == arena base, first-ever live
     ;; deactivate). Guard the SLOT, not the object. Note the machine output also
     ;; dropped this call's arguments, the known placeholder-sig trap
     ;; (game-info-method-14 is declared () none); re-derive the call site from the
     ;; asm when game-info.gc lands.
     (let ((t9-gi14 (method-of-object *game-info* game-info-method-14)))
       (if (nonzero? (the-as int t9-gi14))
           (t9-gi14)
           )
       )
     (dotimes (s5-1 *view-count*)
       (send-event (view-get-target s5-1) 'level-deactivate (-> this name))
       )
     (remove-by-param1 *background-draw-engine* (the-as int (-> this bsp)))
     (let ((s5-2 (-> this status)))
       (set! (-> this status) 'shutdown)
       (do-nothing *level*)
       (deactivate-entities (-> this bsp))
       (set! (-> this status) s5-2)
       )
     (set! (-> this inside-boxes?) #f)
     (set! (-> this meta-inside?) #f)
     (set! (-> this force-inside?) #f)
     (set! (-> this display?) #f)
     (set! (-> this status) 'loaded)
     (do-nothing *level*)
     (set! (-> this light-hash) (the-as light-hash 0))
     (set! (-> this all-visible?) 'loading)
     (when (-> this vis-bits 0)
       (dotimes (v1-30 128)
         (dotimes (a0-15 2)
           ;; og:preserve-this cast, same as jak3's vis-clear
           (set! (-> (the-as (pointer int128) (&+ (-> this vis-bits a0-15) (* v1-30 16)))) (the int128 0))
           )
         )
       )
     (countdown (v1-33 8)
       (let ((a0-20 (-> this vis-info v1-33)))
         (when a0-20
           (dotimes (a1-12 2)
             (set! (-> a0-20 current-vis-string a1-12) (the-as uint -1))
             )
           )
         )
       )
     (when (logtest? (-> this info base-task-mask) (task-mask primary0))
       (let ((v1-40 (task-mask)))
         (dotimes (a0-22 (-> *level* length))
           (let ((a1-17 (-> *level* level a0-22)))
             (if (= (-> a1-17 status) 'active)
                 (set! v1-40 (logior v1-40 (logand (-> a1-17 info base-task-mask) (task-mask primary0))))
                 )
             )
           )
         (when (not (logtest? v1-40 (task-mask primary0)))
           (dotimes (v1-43 (-> *level* length))
             (let ((a0-28 (-> *level* level v1-43)))
               (if (= (-> a0-28 status) 'active)
                   (logior! (-> a0-28 task-mask) (task-mask primary0))
                   )
               )
             )
           )
         )
       )
     )
    )
  (if (= (-> *level* log-in-level-bsp) (-> this bsp))
      (set! (-> *level* log-in-level-bsp) #f)
      )
  (if *speech-control*
      (speech-control-method-15 *speech-control* (-> this heap))
      )
  this
  )

;; definition for method 10 of type level
(defmethod unload! ((this level))
  ((method-of-type entity-more-perm-hash entity-more-perm-hash-method-14)
   (the-as entity-more-perm-hash *entity-more-perm*)
   this
   )
  (deactivate this)
  (cond
    ((= (-> *level* wide-level 0) this)
     (format 0 "logout wide-level 0 ~s~%" (-> this name))
     (set! (-> *level* wide-level 0) #f)
     )
    ((= (-> *level* wide-level 1) this)
     (format 0 "logout wide-level 1 ~s~%" (-> this name))
     (set! (-> *level* wide-level 1) #f)
     )
    (else
      (prototype-node-group-method-13 (-> *level* shared-ties) this)
      )
    )
  (when (and (not (-> *level* wide-level 0)) (not (-> *level* wide-level 1)))
    (format 0 "reset shared ties ~S~%" (-> this name))
    (prototype-node-group-method-9 (-> *level* shared-ties))
    )
  (when (!= (-> this status) 'inactive)
    (dotimes (s5-0 3)
      (when (-> this borrow-level s5-0)
        (unload! (-> this borrow-level s5-0))
        (set! (-> this borrow-level s5-0) #f)
        )
      )
    (when (-> this borrow-from-level)
      (dotimes (v1-41 3)
        (if (= this (-> this borrow-from-level borrow-level v1-41))
            (set! (-> this borrow-from-level borrow-level v1-41) #f)
            )
        )
      (set! (-> this borrow-from-level) #f)
      )
    (case (-> this status)
      (('loading 'loading-bt)
       (dgo-load-cancel (the-as int (-> this load-id)))
       (link-reset)
       )
      (('alive 'active 'loaded)
       (when (-> this entity)
         (let ((s5-1 (the-as (function level object) (get-callback-symbol-value-by-slot! (-> this info) 33))))
           (if (and s5-1 (type? s5-1 function))
               (s5-1 this)
               )
           )
         )
       )
      )
    (when (or (= (-> this status) 'loaded)
              (= (-> this status) 'alive)
              (= (-> this status) 'active)
              (= (-> this status) 'login)
              )
      (dotimes (s5-2 (-> this art-group art-group-array length))
        (let ((s4-0 (-> this art-group art-group-array s5-2)))
          (if (contains-art-for-other-group? s4-0)
              (unlink-art-to-master s4-0)
              )
          (art-method-10 s4-0)
          )
        )
      (case (-> this status)
        (('alive 'active 'loaded)
         (let* ((s5-3 (-> this info callback-list))
                (v1-79 (car s5-3))
                )
           (while (not (null? s5-3))
             (let ((s4-1 (/ (the-as int (car v1-79)) 8))
                   (v1-80 (cdr v1-79))
                   )
