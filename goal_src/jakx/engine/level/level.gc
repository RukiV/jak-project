;; og:preserve-this: update-sound-banks and load-state update! land machine-verbatim.
;; The old parks retired when the sound-bank-mode enum gained the jakx-only value 10
;; and update!'s remaining conversion blocker got a config entry (the border-tail
;; level casts at ops 830/837). The car-load dma-try-alloc stack pair blocker
;; retired outright once dma-try-alloc's real 7-arg signature landed (lobby-dma,
;; issue 571): the call now decodes as a single clean form instead of the raw
;; function-pointer degrade the old 5-arg mistype forced. Two degraded expressions
;; inside update! are kept verbatim: the (the-as level ...) status compare and the
;; filter-name-typed print of (-> this target i name); both encode the retail
;; loads exactly, the decompiler only picked the wrong type's field name for display.
;; definition for function update-sound-banks
;; WARN: Return type mismatch int vs none.
;; WARN: new jak 2 until loop case, check carefully
;; WARN: Function update-sound-banks has a return type of none, but the expression builder found a return statement.
(defun update-sound-banks ((arg0 load-state) (arg1 (inline-array sound-bank-state)))
  (if (-> *setting-control* user-current unknown-usd-752)
      (return #f)
      )
  (set! (-> arg0 target-sound 0 name) (-> arg0 want-sound 0 name))
  (if (-> arg0 target-sound 0 name)
      (copy-string<-string (-> *sound-bank-string* 0) (symbol->string (-> arg0 target-sound 0 name)))
      )
  (if (zero? (-> arg0 want-sound 0 name))
      (set! (-> arg0 target-sound 0 name) #f)
      )
  (set! (-> arg0 target-sound 0 mode) (-> arg0 want-sound 0 mode))
  0
  (let ((s4-1 1)
        (s5-1 0)
        )
    (let ((s3-0 1)
          (s2-0 6)
          )
      (while (>= s2-0 s3-0)
        (set! (-> arg0 target-sound s3-0 name) #f)
        (set! (-> arg0 target-sound s3-0 high) #f)
        (clear (-> *sound-bank-string* s3-0))
        (+! s3-0 1)
        )
      )
    (let ((v1-22 1)
          (a0-5 6)
          )
      (while (>= a0-5 v1-22)
        (let ((a1-2 1))
          (when (and (nonzero? (-> arg0 want-sound v1-22 name)) (-> arg0 want-sound v1-22 name))
            (until #f
              (if (or (= a1-2 s4-1) (and (= (-> arg0 target-sound a1-2 name) (-> arg0 want-sound v1-22 name))
                                         (not (-> arg0 want-sound a1-2 high))
                                         )
                      )
                  (goto cfg-25)
                  )
              (+! a1-2 1)
              )
            #f
            (label cfg-25)
            (cond
              ((= a1-2 s4-1)
               (set! (-> arg0 target-sound s4-1 name) (-> arg0 want-sound v1-22 name))
               (when (-> arg0 want-sound v1-22 high)
                 (+! s5-1 1)
                 (set! (-> arg0 target-sound s4-1 high) (the-as basic #t))
                 )
               (+! s4-1 1)
               )
              (else
                (when (-> arg0 want-sound v1-22 high)
                  (+! s5-1 1)
                  (set! (-> arg0 target-sound a1-2 high) (the-as basic #t))
                  )
                )
              )
            )
          )
        (+! v1-22 1)
