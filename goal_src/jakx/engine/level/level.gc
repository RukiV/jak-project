;; og:preserve-this per-level inside-boxes? setter, extracted from retail jakx's
;; level-update (method 19 level-group) via the same scoped decode as
;; update-level-vis-valid below (#41). Retail runs this as an 18-slot unconditional
;; loop (raw ops 30-41, a separate vtable dispatch this rung does not decode or
;; land, out of scope) followed by a length-bounded, status='active-gated loop
;; (raw ops 42-65) that calls inside-bsp? per level and stores the result, setting
;; render? unconditionally and meta-inside? only when inside-boxes? is true. Both
;; the address computation and the virtual dispatch return degrade to raw offset
;; stores ("the-as none", s.w!) in the decompiler's own output even though the
;; addressing shape matches update-level-vis-valid's own (clean) per-level loop
;; below; hand-reconstructed from the raw offsets (480/488/492, all confirmed
;; against level-h.gc's declared inside-boxes?/render?/meta-inside? fields) rather
;; than transcribed line-for-line, and simplified from retail's two-armed cond
;; (each arm sets render? separately) to one unconditional set, a provably
;; equivalent rewrite of a decompiler artifact, not a behavior change.
;;
;; This is the prerequisite update-level-vis-valid's own guard depends on:
;; inside-boxes? is never set anywhere else in the landed bring-up (grepped the
;; whole level object decode; the only other write is the #f reset in level
;; deactivation). Without this, wiring update-level-vis-valid alone is a no-op.
(defun update-level-inside-boxes ((this level-group))
  (dotimes (i (-> this length))
    (let ((lev (-> this level i)))
      (when (= (-> lev status) 'active)
        (set! (-> lev inside-boxes?) (inside-bsp? lev))
        (set! (-> lev render?) #t)
        (if (-> lev inside-boxes?)
            (set! (-> lev meta-inside?) #t)
            )
        )
      )
    )
  0
  (none)
  )

;; og:preserve-this vis-valid setter, extracted from retail jakx's level-update
;; (method 19 level-group) via a scoped decode of the level object (#41). jak3
;; carries the identical mechanism inline in its own level-update (goal_src/jak3/
;; engine/level/level.gc:3690-3742): the same "is anyone inside-boxes?" outer gate
;; over every level slot (18 here, matching jakx's declared level array; jak3's is
;; 10), then per active level, per vis-info slot, clear vis-valid and refresh
;; from-bsp, then set vis-valid on the level's own slot if display? is
;; 'display-self or the level is inside-boxes?. jakx's own guard is unchanged from
;; jak3's, not weakened or substituted, matching what the retail binary actually
;; checks (confirmed instruction by instruction against the decode, including the
;; folded array-base-plus-field-offset constant (544 + 480 = 1024) the decompiler
;; could not resolve back into a named field on its own).
;;
;; V4 (#41): wired into level-update below, alongside update-level-inside-boxes
;; above (its own prerequisite) and the *artist-all-visible* flip at
;; main-h.gc:5795. The force-all-visible?/all-visible?='loading interaction noted
;; in this leg's V3 report is accepted, not resolved: it is live-set machinery
;; (engine/load/load-state.gc), and the coordinator's call is that the wiring
;; belongs in the same change as the lever flip, where behavior change is expected
;; and observed under an eyes-on boot rather than assumed byte-for-byte. *vis-actors*
;; is untouched.
(defun update-level-vis-valid ((this level-group))
  (when (let ((any-inside #f))
          (dotimes (i 18)
            (when (-> this level i inside-boxes?)
              (set! any-inside #t)
              )
            )
          any-inside
          )
    (dotimes (i (-> this length))
      (let ((lev (-> this level i)))
        (when (= (-> lev status) 'active)
          (dotimes (j 8)
            (let ((vi (-> lev vis-info j)))
              (when vi
                (set! (-> vi flags) (the-as vis-info-flag (logclear (-> vi flags) (vis-info-flag vis-valid))))
                (set! (-> vi from-bsp)
                      (if (= j (-> lev vis-self-index))
                          (-> lev bsp)
                          (let ((other (level-get this (-> vi from-level))))
                            (if other
                                (-> other bsp)
                                )
                            )
                          )
                      )
                )
              )
            )
          (cond
            ((= (-> lev display?) 'display-self)
             (let ((vi (-> lev vis-info (-> lev vis-self-index))))
               (if vi
                   (set! (-> vi flags) (the-as vis-info-flag (logior (vis-info-flag vis-valid) (-> vi flags))))
                   )
               )
             )
            ((-> lev inside-boxes?)
             (let ((vi (-> lev vis-info (-> lev vis-self-index))))
               (if vi
                   (set! (-> vi flags) (the-as vis-info-flag (logior (vis-info-flag vis-valid) (-> vi flags))))
                   )
               )
             )
            )
          )
        )
      )
    )
  0
  (none)
  )

;; og:preserve-this level-update (method 19) drives per-frame level maintenance. An
;; earlier note here claimed the retail jakx body "additionally does the music/continue
;; propagation"; the 2026-08-12 scoped decode falsified both halves. Retail keeps
;; jak3's entire continue-propagation guard and then executes an EMPTY body (one
;; instruction wide), and no music write can exist because jakx's level-load-info has
;; no music-bank or sound-reverb fields. There is no retail walk left to port: retail
;; races stage their whole want set once through net-world (set-continue-point-from-task
;; -> method 76 -> check-start-load -> wait-for-levels) and never move it mid-race.
(defmethod level-update ((this level-group))
  ;; og:preserve-this bring-up: the retail jakx level-update pumps every slot's
  ;; load-continue and runs the load-state update! mid-body (jak3 level.gc:3569 is the
  ;; landed reference). This PC-shaped method carries the pieces streaming and vis
  ;; need: the per-frame load pump, the bring-up want driver (a stand-in for the
  ;; exploration-mode streaming retail never had; see the driver's own notes), update!,
  ;; and (V4, #41) the inside-boxes and vis-valid setters at retail's own relative
  ;; position, inside-boxes before update! and vis-valid after, matching the scoped
  ;; decode.
  (dotimes (i (-> this length))
    (load-continue (-> this level i))
    )
  ;; og:preserve-this bring-up: fly before the want driver reads the camera, so a hop
  ;; and the window slide it causes land in the same tick rather than a frame apart.
  (jakx-cam-fly-tick)
  (jakx-want-driver-tick)
  ;; og:preserve-this bring-up (#152): after the want driver, so both drivers can be
  ;; armed together without fighting over view-0 in the same frame (cam-fly warps the
  ;; ring to a fixed continue target; the racer pins it to a moving chase position).
  ;; Gated on *jakx-racer* inside the tick itself, like its neighbors above.
  (jakx-racer-tick)
  (update-level-inside-boxes this)
  (update! *load-state*)
  ;; og:preserve-this vis-self-index reset, hand-ported from jak3's level-update
  ;; (goal_src/jak3/engine/level/level.gc:3662-3667), which zeroes it for every
  ;; active level slot each frame at this same relative position (after update!
  ;; *load-state*, before the vis-valid setter loop; jak3's intervening
  ;; target-inside block is not landed here yet). jakx never writes
  ;; vis-self-index anywhere else in the tree (only reads: cam-update.gc:161
  ;; and update-level-vis-valid above at lines 4131/4145/4152), and
  ;; update-level-vis-valid indexes vis-info by vis-self-index and nothing
  ;; else initializes the field; without this reset it stays uninitialized
  ;; memory and can select the wrong vis-info slot.
  (dotimes (i (-> this length))
    (let ((lev (-> this level i)))
      (when (= (-> lev status) 'active)
        (set! (-> lev vis-self-index) 0)
        )
      )
    )
  (update-level-vis-valid this)
  (let ((lev-names (new 'stack-no-clear 'array 'string 10))
        (active-lev-names (new 'stack-no-clear 'array 'string 10)))
    (dotimes (i 10)
      (set! (-> active-lev-names i) "none")
      (set! (-> lev-names i) "none")
      (cond
        ((or (= (-> this level i status) 'active)
             (= (-> this level i status) 'alive)
             (= (-> this level i status) 'loaded))
          (set! (-> lev-names i) (symbol->string (bsp-name (-> this level i))))
          (if (-> this level i display?)
              (set! (-> active-lev-names i) (-> lev-names i)))
          )
        )
      )
    (__pc-set-levels lev-names)
    (__pc-set-active-levels active-lev-names)
    )
  0
  (none)
  )