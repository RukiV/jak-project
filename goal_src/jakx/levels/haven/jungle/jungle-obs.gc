;;-*-Lisp-*-
(in-package goal)

;; name: jungle-obs.gc
;; name in dgo: jungle-obs
;; dgos: HAVJUNGW, HAVTOURW, HJX, JGX, JUNGLEW

;; og:preserve-this forward declaration: jungle-stone-snake-head-draw-init-by-other
;; takes the parent head process as an argument but the head's deftype sits later in
;; the file; the offline gate never notices because all-types predeclares everything,
;; so forward-declare it here.
(declare-type jungle-stone-snake-head process-nettable)

;; DECOMP BEGINS

(deftype jungle-clay-jar-a (net-simple-destruct)
  ()
  )


(defskelgroup skel-jungle-clay-jar-a jungle-clay-jar-a jungle-clay-jar-a-lod0-jg jungle-clay-jar-a-idle-ja
              ((jungle-clay-jar-a-lod0-mg (meters 999999)))
              :bounds (static-spherem 0 4 0 8)
              :origin-joint-index 3
              )

(defskelgroup skel-jungle-debris-jar-a-a jungle-debris-jar-a jungle-debris-jar-a-a-lod0-jg -1
