(defmethod destroy! ((this jungle-clay-jar-a))
  (rlet ((vf0 :class vf)
         (vf4 :class vf)
         (vf5 :class vf)
         (vf6 :class vf)
         )
    (init-vf0-vector)
    (let ((v1-1 (make-sound-instance (-> *sound-info* 533) (new 'static 'sound-id) (the-as handle #f))))
      (if v1-1
          (-> v1-1 id)
          0
          )
      )
    (set! (-> *part-tracker-params-default* group) (-> *part-group-id-table* 354))
    (vector-reset! (-> *part-tracker-params-default* local-offset))
    (set! (-> *part-tracker-params-default* duration) (the-as uint 1500))
    (set! (-> *part-tracker-params-default* callback) #f)
    (set! (-> *part-tracker-params-default* userdata) (the-as uint #f))
    (set! (-> *part-tracker-params-default* target) #f)
    (set! (-> *part-tracker-params-default* mat-joint) (-> this node-list data 3 bone transform))
    (set! (-> *part-tracker-params-default* local-space-param) 0)
    (set! (-> *part-tracker-params-default* local-space-callback) #f)
    (set! (-> *part-tracker-params-default* subsampler-num) 1.0)
    *part-tracker-params-default*
    (if (logtest? (-> *part-group-id-table* 354 flags) (sp-group-flag sp13))
        (process-spawn
          part-tracker-subsampler
          :init part-tracker-subsampler-init
          *part-tracker-params-default*
          :name "part-tracker-subsampler"
          :to *entity-pool*
          :unk 0
          )
        (process-spawn
          part-tracker
          :init part-tracker-init
          *part-tracker-params-default*
          :name "part-tracker"
          :to *entity-pool*
          :unk 0
          )
        )
    (let ((s5-2 (new 'stack 'debris-tuning (the-as uint 0))))
      (set-vector! (-> s5-2 fountain-rand-transv-lo) -40960.0 61440.0 -40960.0 1.0)
      (let ((a1-8 (-> s5-2 fountain-rand-transv-lo)))
        (let ((v1-34 (-> s5-2 fountain-rand-transv-lo))
              (a0-16 (-> this impact-velocity))
              )
          (.lvf vf4 (&-> v1-34 quad))
          (.lvf vf5 (&-> a0-16 quad))
          )
        (.mov.vf.w vf6 vf0)
        (.add.vf.xyz vf6 vf4 vf5)
        (.svf (&-> a1-8 quad) vf6)
        )
      (set-vector! (-> s5-2 fountain-rand-transv-hi) 40960.0 61440.0 40960.0 1.0)
      (let ((a1-9 (-> s5-2 fountain-rand-transv-hi)))
        (let ((v1-36 (-> s5-2 fountain-rand-transv-hi))
              (a0-21 (-> this impact-velocity))
              )
          (.lvf vf4 (&-> v1-36 quad))
          (.lvf vf5 (&-> a0-21 quad))
          )
        (.mov.vf.w vf6 vf0)
        (.add.vf.xyz vf6 vf4 vf5)
        (.svf (&-> a1-9 quad) vf6)
        )
      (set! (-> s5-2 fountain-rand-transv-hi w) 16384.0)
      (set! (-> s5-2 duration) (seconds 2))
      (set! (-> s5-2 scale-rand-lo) 1.0)
      (set! (-> s5-2 scale-rand-hi) 1.0)
      (when (type? (-> this root) collide-shape)
        (let ((v1-43 (-> this root root-prim)))
          (set! (-> v1-43 prim-core collide-as) (collide-spec))
          (set! (-> v1-43 prim-core collide-with) (collide-spec))
          )
        0
        )
      (logior! (-> this draw status) (draw-control-status no-draw))
      (if (type? (-> this root) collide-shape)
          (transform-post)
          )
      (debris-spawn this s5-2 *jungle-clay-jar-a-debris-params* (the-as process-drawable #f))
      )
    ((method-of-type net-simple-destruct destroy!) this)
    (none)
    )
  )

(defmethod init-from-entity! ((this jungle-clay-jar-a) (arg0 entity-actor))
  (stack-size-set! (-> this main-thread) 32)
  (logior! (-> this mask) (process-mask actor-pause))
  (let ((s4-0 (new 'process 'collide-shape this (collide-list-enum usually-hit-by-player))))
    (let ((s3-0 (new 'process 'collide-shape-prim-group s4-0 (the-as uint 1) 0)))
      (set! (-> s4-0 total-prims) (the-as uint 2))
      (set! (-> s3-0 prim-core collide-as) (collide-spec obstacle camera-blocker pusher))
      (set! (-> s3-0 prim-core collide-with) (collide-spec jak bot player-list))
      (set! (-> s3-0 prim-core action) (collide-action solid))
      (set! (-> s3-0 transform-index) 3)
      (set-vector! (-> s3-0 local-sphere) 0.0 16384.0 0.0 32768.0)
      (set! (-> s4-0 root-prim) s3-0)
      )
    (pusher-init s4-0)
    (let ((v1-15 (new 'process 'collide-shape-prim-mesh s4-0 (the-as uint 0) (the-as uint 0))))
      (set! (-> v1-15 prim-core collide-as) (collide-spec obstacle camera-blocker pusher))
      (set! (-> v1-15 prim-core collide-with) (collide-spec jak bot player-list))
      (set! (-> v1-15 prim-core action) (collide-action solid))
      (set! (-> v1-15 transform-index) 3)
      (set-vector! (-> v1-15 local-sphere) 0.0 16384.0 0.0 32768.0)
      )
    (set! (-> s4-0 nav-radius) (* 0.75 (-> s4-0 root-prim local-sphere w)))
    (let ((v1-18 (-> s4-0 root-prim)))
      (set! (-> s4-0 backup-collide-as) (-> v1-18 prim-core collide-as))
      (set! (-> s4-0 backup-collide-with) (-> v1-18 prim-core collide-with))
      )
    (set! (-> this root) s4-0)
    )
  (initialize-skeleton
    this
    (the-as skeleton-group (art-group-get-by-name *level* "skel-jungle-clay-jar-a" (the-as (pointer level) #f)))
    (the-as pair 0)
    )
  (set! (-> this hit-points) 10.0)
  (process-drawable-from-entity! this arg0)
  (set! (-> this draw light-index) (the-as uint 10))
  (go (method-of-object this idle))
  )

