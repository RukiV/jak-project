        :parent-joint-index 3
        :group "skel-jungle-debris-jar-a-b"
        :offset (new 'static 'vector :data (new 'static 'array float 4 -4096.0 16384.0 -12288.0 1.0))
        )
      (new 'static 'debris-static-joint-params
        :parent-joint-index 3
        :group "skel-jungle-debris-jar-a-c"
        :offset (new 'static 'vector :data (new 'static 'array float 4 -8192.0 24576.0 4096.0 1.0))
        )
      (new 'static 'debris-static-joint-params
        :parent-joint-index 3
        :group "skel-jungle-debris-jar-a-d"
        :offset (new 'static 'vector :data (new 'static 'array float 4 12288.0 32768.0 -8192.0 1.0))
        )
      (new 'static 'debris-static-joint-params
        :parent-joint-index 3
