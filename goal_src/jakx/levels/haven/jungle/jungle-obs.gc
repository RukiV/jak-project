(deftype flaming-arrow (process-drawable)
  ((flame-sound  ambient-sound)
   )
  (:state-methods
    idle
    )
  )


(defskelgroup skel-jungle-flaming-arrow jungle-flaming-arrow jungle-flaming-arrow-lod0-jg jungle-flaming-arrow-idle-ja
              ((jungle-flaming-arrow-lod0-mg (meters 999999)))
              :bounds (static-spherem 0 0 0 20)
              :origin-joint-index 3
              )

(defmethod init-from-entity! ((this flaming-arrow) (arg0 entity-actor))
  (stack-size-set! (-> this main-thread) 32)
  (set! (-> this root) (new 'process 'trsqv))
  (set! (-> this level) (level-group-method-32 *level*))
  (process-drawable-from-entity! this arg0)
  (initialize-skeleton
    this
    (the-as
      skeleton-group
      (art-group-get-by-name *level* "skel-jungle-flaming-arrow" (the-as (pointer level) #f))
      )
    (the-as pair 0)
    )
  ;; (the pre-slice-5 slot-9 guard text retired: gsound landed, slot 9 is live, and the
  ;; nonzero? test below auto-passed -- which is exactly what armed the m0 defect.)
  ;; og:preserve-this bring-up re-park (slice 5): the hand-carried (new ambient-sound)
  ;; executes object-new with a NULL type and size 0 at runtime (allocation-trace-proven;
  ;; see issue #34 slice-5 notes and the part-spawner park in generic-obs), returning a
  ;; phantom object that aliases free heap. Constructing here corrupts the process heap the
  ;; moment this entity births. Park until the m0 phantom is diagnosed;
  ;; flame-sound stays 0 (idle post/deactivate/relocate all nonzero?-test it).
  (when #f ;; was: (nonzero? (-> ambient-sound method-table 9))
    (set! (-> this flame-sound) (new 'process 'ambient-sound "flaming-arrow" (-> this root trans) 0.0))
    (set-falloff-far! (-> this flame-sound) 1228800.0)
    )
  ;; the guard history for this call (unlanded initialize/spawn slots, then the
  ;; *jakx-particles-ready* lever) is in git; the lever retired at #53 slice 4
  (set! (-> this part) (create-launch-control (-> *part-group-id-table* 356) this))
  (set! (-> this draw light-index) (the-as uint 10))
  (go (method-of-object this idle))
  )

(defbehavior spawn-flame flaming-arrow ()
  ;; og:preserve-this bring-up guard: retail tests only (-> self part). spawn-from-mat
  ;; is landed but tails into sparticle-launch-control's spawn (slot 16), a separately
  ;; failed decomp whose slot reads 0, and the init-from-entity! guard above auto-sets
