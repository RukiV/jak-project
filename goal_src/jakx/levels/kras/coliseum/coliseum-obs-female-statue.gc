    (set! (-> (the-as coli-break-object pp) root trans quad) (-> arg1 quad))
    (quaternion-copy! (the-as quaternion (-> (the-as coli-break-object pp) root rot)) arg2)
    (vector-identity! (-> (the-as coli-break-object pp) root scale))
    (set! (-> (the-as coli-break-object pp) level) (-> arg0 level))
    (coli-break-object-method-51 (the-as coli-break-object pp))
    (when arg3
      ;; og:preserve-this gui-control-method-20 arg count widened 6 -> 7
      ;; (gui-control completion lane, issue 531): the prior 6-arg
      ;; declaration left this call's own 7th register set (t3, always #t
      ;; here) as a dead statement immediately before an indirect
      ;; method-of-object dispatch; loader.gc's own deftype note carries the
      ;; full callee-side evidence. A fresh scoped decode of this object
      ;; against the widened declaration resolves the call cleanly to the
      ;; direct call form below, transcribed verbatim.
