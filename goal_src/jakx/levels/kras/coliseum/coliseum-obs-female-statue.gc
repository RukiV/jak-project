      (set! (-> s4-0 prim-core action) (collide-action solid))
      (set! (-> s4-0 transform-index) 3)
      (set-vector! (-> s4-0 local-sphere) 0.0 -81920.0 0.0 1064960.0)
      (set! (-> s5-0 root-prim) s4-0)
      )
