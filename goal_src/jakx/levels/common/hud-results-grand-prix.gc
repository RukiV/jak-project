;; definition for symbol *hud-results-grand-prix-totals-proc*, type object
(define *hud-results-grand-prix-totals-proc* (the-as object #f))

;; definition of type hud-results-grand-prix-totals
(deftype hud-results-grand-prix-totals (in-game-hud)
  ()
  )

;; definition for method 3 of type hud-results-grand-prix-totals
(defmethod inspect ((this hud-results-grand-prix-totals))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type in-game-hud inspect)))
    (t9-0 this)
    )
  (label cfg-4)
  this
  )

;; definition for method 7 of type hud-results-grand-prix-totals
;; WARN: Return type mismatch in-game-hud vs hud-results-grand-prix-totals.
(defmethod relocate ((this hud-results-grand-prix-totals) (offset int))
  (set! *hud-results-grand-prix-totals-proc* this)
  (if (nonzero? *hud-results-grand-prix-totals-proc*)
      (set! *hud-results-grand-prix-totals-proc* (+ (the-as uint *hud-results-grand-prix-totals-proc*) offset))
      )
  (the-as hud-results-grand-prix-totals ((method-of-type in-game-hud relocate) this offset))
  )

;; definition for method 26 of type hud-results-grand-prix-totals
(defmethod hud-method-26 ((this hud-results-grand-prix-totals))
  (set! (-> this items) (the-as (array hud-item) *hud-results-grand-prix-totals*))
  (set! (-> this manager) (new 'static 'basic-manager))
  (set! *hud-results-grand-prix-totals-proc* this)
  ((method-of-type in-game-hud hud-method-26) this)
  (none)
  )

;; definition for method 10 of type hud-results-grand-prix-totals
(defmethod deactivate ((this hud-results-grand-prix-totals))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (set! *hud-results-grand-prix-totals-proc* (the-as object #f))
  ((method-of-type in-game-hud deactivate) this)
  (none)
  )

;; definition for method 24 of type hud-results-grand-prix-totals
(defmethod hud-method-24 ((this hud-results-grand-prix-totals))
  (when *debug-hud*
    (set! (-> this real-items) (the-as (array hud-item) *hud-results-grand-prix-totals*))
    (hud-method-26 this)
    )
  ((method-of-type in-game-hud hud-method-24) this)
  (none)
  )

;; definition for function spawn-hud-results-grand-prix-totals
(defun spawn-hud-results-grand-prix-totals ()
  (cond
    (*hud-results-grand-prix-totals-proc*
      *hud-results-grand-prix-totals-proc*
      )
    (*net-game-mgr*
      (let ((v0-0 (ppointer->process (process-spawn
                                       hud-results-grand-prix-totals
                                       :init hud-init-by-other
                                       :name "hud-results-grand-prix-totals"
                                       :to *net-game-mgr*
                                       )
                                     )
                  )
            )
        (when (the-as hud-results-grand-prix-totals v0-0)
          (set! (-> (the-as hud-results-grand-prix-totals v0-0) inited-strings-count) 0)
          0
          )
        v0-0
        )
      )
    (else
      #f
      )
    )
  )

