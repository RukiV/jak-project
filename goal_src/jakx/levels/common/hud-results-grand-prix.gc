;;-*-Lisp-*-
(in-package goal)

;; name: hud-results-grand-prix.gc
;; name in dgo: hud-results-grand-prix
;; dgos: COMMON, GAME

;; DECOMP BEGINS

;; forward-reference breaker: hud-results-grand-prix, hud-results-grand-prix-
;; totals and hud-results-medal-1 are each used in a (the-as ...) cast in
;; their own static instance's definition before their (deftype ...) forms
;; further down this file, matching the original top-level-login's own
;; instruction order (the static define precedes the type-new call for each
;; type in the retail binary).
(declare-type hud-results-grand-prix in-game-hud)
(declare-type hud-results-grand-prix-totals in-game-hud)
(declare-type hud-results-medal-1 in-game-hud)
;; og:preserve-this hud-static-literals rung: *net-game-mgr* forward-declared
;; here for the same reason as hud-classes.gc's *minimap*. Its spawn
;; functions use it only as a truthy guard and as process-spawn's :to
;; target, no field access, so a name-only declare-type (matching its own
;; declared parent, process-nettable) is enough; the real net-game-mgr type
;; and instance are not landed anywhere in this tree yet.
(declare-type net-game-mgr process-nettable)
(define-extern *net-game-mgr* net-game-mgr)

;; og:preserve-this hud-static-literals rung: hud-results-base, hud-results,
;; hud-rank-name-score and hud-medal-results forward-declared here (full
;; deftype, transcribed verbatim from decompiler/config/jakx/all-types.gc).
;; This file's own static hud-item arrays construct real instances of all
;; four, but none of the four get a type-new call anywhere in this object's
;; own decode; the retail type-new calls for this family live in
;; hud-results.gc (own scoped decode confirms it: hud-results_ir2.asm),
;; which is still a 9-line stub in this tree. Retire these four declarations
;; once hud-results.gc lands the real definitions.
(deftype hud-results-base (hud-item-group)
  ((spawn-time        int32   :offset-assert 44)
   (start-time        int32   :offset-assert 48)
   (grand-prix        symbol  :offset-assert 52)
   (grand-prix-totals symbol  :offset-assert 56)
   )
  :method-count-assert 24
  :size-assert         #x3c
  :flag-assert         #x180000003c
  )

(deftype hud-rank-name-score (hud-item-group)
  ((player-id         int32   :offset-assert 44)
   (grand-prix        symbol  :offset-assert 48)
   (grand-prix-totals symbol  :offset-assert 52)
   )
  :method-count-assert 25
  :size-assert         #x38
  :flag-assert         #x1900000038
  (:methods
    (hud-rank-name-score-method-24 (_type_ object) none) ;; 24
    )
  )

(deftype hud-results (hud-results-base)
  ((i-got-medal uint8      :offset-assert 60)
   (stats-type  uint64     :offset-assert 64)
   (pad-tail    uint8 8    :offset-assert 72)
   )
  :method-count-assert 25
  :size-assert         #x50
  :flag-assert         #x1900000050
  (:methods
    (hud-results-method-24 () none) ;; 24
    )
  )

(deftype hud-medal-results (hud-results-base)
  ((i-got-medal        uint8  :offset-assert 60)
   (has-sent-inc-event basic  :offset-assert 64)
   )
  :method-count-assert 25
  :size-assert         #x44
  :flag-assert         #x1900000044
  (:methods
    (hud-medal-results-method-24 (_type_ object float) none) ;; 24
    )
  )

;; og:preserve-this hud-static-literals rung: the full hud-effect-* subtype
;; family (group, slide, font-effect, offscreen, trigger-sound,
;; text-effect-sound, move, throb, fade, scale, emit-score-icon,
;; trigger-score-sound) forward-declared here for the same reason as the
;; hud-results family above; their retail type-new calls all live in
;; hud-effects.gc (own scoped decode confirms it: hud-effects_ir2.asm),
;; which decodes with two genuine, unrelated errors of its own this rung (a
;; net-game-mgr field read past its own known layout and a net-player field
;; read past its own :size-assert, both outside a static-literals rung's
;; evidence), so it stays a stub rather than being landed here too. Retire
;; all twelve declarations once hud-effects.gc lands the real definitions.
(deftype hud-effect-group (hud-effect)
  ((items (array hud-effect)  :offset-assert 28)
   )
  :method-count-assert 15
  :size-assert         #x20
  :flag-assert         #xf00000020
  )

(deftype hud-effect-slide (hud-effect)
  ((slide-type       uint64  :offset-assert 32)
   (slide-time       float   :offset-assert 40)
   (start-time       int32   :offset-assert 44)
   (message-is-enter symbol  :offset-assert 48)
   )
  :method-count-assert 15
  :size-assert         #x34
  :flag-assert         #xf00000034
  )

