;;-*-Lisp-*-
(in-package goal)

;; name: hud-results-grand-prix.gc
;; name in dgo: hud-results-grand-prix
;; dgos: COMMON, GAME

;; DECOMP BEGINS

;; forward-reference breaker: hud-results-grand-prix, hud-results-grand-prix-
;; totals and hud-results-medal-1 are each used in a (the-as ...) cast in
;; their own static instance's definition before their (deftype ...) forms
;; further down this file, matching the original top-level-login's own
;; instruction order (the static define precedes the type-new call for each
;; type in the retail binary).
(declare-type hud-results-grand-prix in-game-hud)
(declare-type hud-results-grand-prix-totals in-game-hud)
(declare-type hud-results-medal-1 in-game-hud)
;; og:preserve-this hud-static-literals rung: *net-game-mgr* forward-declared
;; here for the same reason as hud-classes.gc's *minimap*. Its spawn
;; functions use it only as a truthy guard and as process-spawn's :to
;; target, no field access, so a name-only declare-type (matching its own
;; declared parent, process-nettable) is enough. The real net-game-mgr type
;; and its own definer now land in net-game-mgr-h.gc (net-game-mgr rung);
;; this file's own forward declare stays as a harmless, order-independent
;; safety net (an ENGINE-dgo file compiling after a COMMON-dgo file is not
;; a case this rung verified) rather than being removed outright.
(declare-type net-game-mgr process-nettable)
(define-extern *net-game-mgr* net-game-mgr)

;; og:preserve-this issue 540: this file previously carried forward-declare
;; duplicates for the full hud-effect-* subtype family (group, slide,
;; font-effect, offscreen, trigger-sound, text-effect-sound, move, throb,
;; fade, scale, emit-score-icon, trigger-score-sound), for hud-player-icon,
;; hud-localized-string and hud-item-string-big, and for hud-player-icon-name,
;; all now deleted. new_type rewrites every custom method slot on every
;; deftype execution of the same interned type (issue 534); each of these
;; duplicates risked wiping methods landed in its own real home the moment
;; this file linked after it (game.gd link position 537, after hud-effects.o
;; at 534 and hud-widgets.o at 535). hud-effects.gc has since landed the
;; real hud-effect-* family (including the fade-out-on basic -> symbol
;; retype this file's own note used to track separately) and hud-widgets.gc
;; the real hud-player-icon/hud-localized-string/hud-item-string-big;
;; hud-player-icon-name is single-homed to hud-results.gc instead (link
;; position 536, earlier than this file), the only one of the four still a
;; bare forward-declare stub in either file. hud-results-base,
;; hud-results, hud-rank-name-score and hud-medal-results were already
;; retired from this file the same way in an earlier rung.

;; definition for function calc-grand-prix-score
(defun calc-grand-prix-score ((arg0 (pointer int8)))
  (let ((v1-0 (-> arg0 286)))
    (cond
      ((zero? v1-0)
       10
       )
      ((= v1-0 1)
       8
       )
      ((= v1-0 2)
       6
       )
      ((= v1-0 3)
       4
       )
      ((= v1-0 4)
       2
       )
      (else
        1
        )
      )
    )
  )

