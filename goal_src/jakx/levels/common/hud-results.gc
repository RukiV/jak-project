;; og:preserve-this hud-results rung: spawn-hud-game-end, cash-stats-on?
;; and end-game-menu-on? forward-declared here, matching the exact
;; signatures hud-high-scores.gc already declared for the same reason
;; ("Unrecognized symbol ... as head of form" without this); all three
;; are defined in hud-cash.gc, which compiles after this file.
;; og:preserve-this hud-results rung: hud-player-icon, hud-player-icon-
;; name, hud-localized-string and hud-item-string-big relanded here too
;; (full deftype, transcribed verbatim from decompiler/config/jakx/
;; all-types.gc), matching hud-results-grand-prix.gc's own identical
;; forward declarations for the same four types (their own retail type-
;; new calls live in hud-widgets.gc, still a stub in this tree); goalc
;; tolerates the identical redefinition (the same net-player deftype
;; already lives, unconflicted, in both net-player-h.gc and cam-
;; states.gc), and this file's own static hud-item arrays construct real
;; instances of hud-localized-string directly ("Type hud-localized-string
;; is unknown" without this).
(deftype hud-player-icon (hud-item-group)
  ((player-id int32  :offset-assert 44)
   )
  :method-count-assert 28
  :size-assert         #x30
  :flag-assert         #x1c00000030
  ;; og:preserve-this hud-widgets rung: method 24 dropped from this type's own
  ;; :methods list; hud-item now declares that slot itself (hud-widgets rung,
  ;; this corpus), and hud-player-icon-method-24 (defined once hud-widgets.gc
  ;; lands) is an override of the base slot (proven by the decompiler's own
  ;; method-set!-derived label staying "24" after hud-item's own count
  ;; changed), not a new addition.
  )

(deftype hud-player-icon-name (hud-player-icon)
  ()
  :method-count-assert 28
  :size-assert         #x30
  :flag-assert         #x1c00000030
  )

(deftype hud-localized-string (hud-item-string)
  ()
  :method-count-assert 29
  :size-assert         #x3c
  :flag-assert         #x1d0000003c
  )

(deftype hud-item-string-big (hud-item-string)
  ()
  :method-count-assert 29
  :size-assert         #x3c
  :flag-assert         #x1d0000003c
  )

