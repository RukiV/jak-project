;; definition for symbol *hud-results-team-view-1-proc*, type object
(define *hud-results-team-view-1-proc* (the-as object #f))

;; definition of type hud-results-team-view-1
(deftype hud-results-team-view-1 (in-game-hud)
  ()
  )

;; definition for method 3 of type hud-results-team-view-1
(defmethod inspect ((this hud-results-team-view-1))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type in-game-hud inspect)))
    (t9-0 this)
    )
  (label cfg-4)
  this
  )

;; definition for method 7 of type hud-results-team-view-1
;; WARN: Return type mismatch in-game-hud vs hud-results-team-view-1.
(defmethod relocate ((this hud-results-team-view-1) (offset int))
  (set! *hud-results-team-view-1-proc* this)
  (if (nonzero? *hud-results-team-view-1-proc*)
      (set! *hud-results-team-view-1-proc* (+ (the-as uint *hud-results-team-view-1-proc*) offset))
      )
  (the-as hud-results-team-view-1 ((method-of-type in-game-hud relocate) this offset))
  )

;; definition for method 26 of type hud-results-team-view-1
(defmethod hud-method-26 ((this hud-results-team-view-1))
  (set! (-> this items) *hud-results-team-view-1*)
  (set! (-> this manager) (new 'static 'basic-manager))
  (set! *hud-results-team-view-1-proc* this)
  ((method-of-type in-game-hud hud-method-26) this)
  (none)
  )

;; definition for method 10 of type hud-results-team-view-1
(defmethod deactivate ((this hud-results-team-view-1))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (set! *hud-results-team-view-1-proc* (the-as object #f))
  ((method-of-type in-game-hud deactivate) this)
  (none)
  )

;; definition for method 24 of type hud-results-team-view-1
(defmethod hud-method-24 ((this hud-results-team-view-1))
  (when *debug-hud*
    (set! (-> this real-items) *hud-results-team-view-1*)
    (hud-method-26 this)
    )
  ((method-of-type in-game-hud hud-method-24) this)
  (none)
  )

;; definition for function spawn-hud-results-team-view-1
(defun spawn-hud-results-team-view-1 ()
  (cond
    (*hud-results-team-view-1-proc*
      *hud-results-team-view-1-proc*
      )
    (*net-game-mgr*
      (let ((v0-0 (ppointer->process (process-spawn
                                       hud-results-team-view-1
                                       :init hud-init-by-other
                                       :name "hud-results-team-view-1"
                                       :to *net-game-mgr*
                                       )
                                     )
                  )
            )
        (when (the-as hud-results-team-view-1 v0-0)
          (set! (-> (the-as hud-results-team-view-1 v0-0) inited-strings-count) 0)
          0
          )
        v0-0
        )
      )
    (else
      #f
      )
    )
  )

;; definition for method 22 of type hud-results-team-view-1
;; WARN: Return type mismatch symbol vs none.
(defmethod hud-method-22 ((this hud-results-team-view-1))
  (none)
  )

;; definition for function spawn-hud-results-team
(defun spawn-hud-results-team ()
  (cond
    ((zero? (-> *viewport-array* mode))
     (spawn-hud-results-team-view-0)
     )
    ((zero? (view-get-active-index))
     (spawn-hud-results-team-view-0)
     )
    (else
      (spawn-hud-results-team-view-1)
      )
    )
  (spawn-hud-results-background)
  )

;; definition for function spawn-hud-results
(defun spawn-hud-results ()
  (case (if *net-world*
            (the-as int (-> (the-as game-task-node-info (-> *net-world* task-node-info)) net-play-mode))
            18
            )
    ((3)
     (let ((v1-5 (-> *net-players* 0)))
       (when v1-5
         (case (if *net-world*
                   (the-as int (-> (the-as game-task-node-info (-> *net-world* task-node-info)) net-play-mode))
                   18
                   )
           ((3)
            (report-score (the-as int (* 0.0033333334 (the float (-> (the-as net-player-race v1-5) finish-time)))))
            )
           (else
             (report-score (the-as int (the float (-> v1-5 score))))
             )
           )
         )
       )
     )
    )
  (kill-by-type hud-headset-talker-race *active-pool*)
  (kill-by-type hud-headset-talker-other *active-pool*)
  (when (and (!= (if *net-world*
                     (the-as int (-> (the-as game-task-node-info (-> *net-world* task-node-info)) net-play-mode))
                     18
                     )
                 3
                 )
             (is-nonstandard-mode-ignore-split?)
             )
    (let ((v1-15 (view-get-active-index)))
      (cond
        ((zero? v1-15)
         (spawn-hud-results-background)
         (return (spawn-hud-results-medal))
         )
        ((= v1-15 1)
         (spawn-hud-results-background)
         (return (spawn-hud-results-medal-1))
         )
        )
      )
    )
  (when (and (is-clan-challenge)
             (zero? (if *net-world*
                        (the-as int (-> (the-as game-task-node-info (-> *net-world* task-node-info)) net-play-mode))
                        18
                        )
                    )
             )
    (spawn-hud-results-background)
    (if (zero? (view-get-active-index))
        (return (spawn-hud-results-view-0))
        (return (spawn-hud-results-view-1))
        )
    (the-as none 0)
    )
  (if (logtest? (-> *net-world* net-state flags) 4)
      (return (spawn-hud-results-team))
      )
  (spawn-hud-results-background)
  (if (-> *game-info* playing-grand-prix?)
      (return (spawn-hud-results-grand-prix))
      )
  (cond
    ((zero? (-> *viewport-array* mode))
     (case (if *net-world*
               (the-as int (-> (the-as game-task-node-info (-> *net-world* task-node-info)) net-play-mode))
               18
               )
       ((1)
        (cond
          ((< (-> *net-game-mgr* human-ct) 2)
           (spawn-hud-results-medal)
           )
          ((zero? (view-get-active-index))
           (spawn-hud-results-view-0)
           )
          (else
            (spawn-hud-results-view-1)
            )
          )
        )
       ((2 13)
        (spawn-hud-results-medal)
        )
       ((17)
        #f
        )
       (else
         (spawn-hud-results-view-0)
         )
       )
     )
    ((zero? (view-get-active-index))
     (spawn-hud-results-view-0)
     )
    (else
      (spawn-hud-results-view-1)
      )
    )
  )

;; definition for function calc-player-rank
(defun calc-player-rank ((arg0 int) (arg1 object))
  (cond
    ((and (nonzero? (if *net-world*
                        (the-as int (-> (the-as game-task-node-info (-> *net-world* task-node-info)) net-play-mode))
                        18
                        )
                    )
          (logtest? (-> *net-world* net-state flags) 4)
          )
     (when (-> *net-players* arg0)
       (let ((gp-1 (calc-team-score 0))
             (v1-9 (calc-team-score 1))
             )
         (cond
           (*hud-results-team-view-0-proc*
             (set! gp-1 (-> (the-as hud-team-score-results (-> *hud-results-team-view-0* 0)) red-team-score))
             (set! v1-9 (-> (the-as hud-team-score-results (-> *hud-results-team-view-0* 0)) blue-team-score))
             )
           (*hud-results-team-view-1-proc*
             (set! gp-1 (-> (the-as hud-team-score-results (-> *hud-results-team-view-1* 0)) red-team-score))
             (set! v1-9 (-> (the-as hud-team-score-results (-> *hud-results-team-view-1* 0)) blue-team-score))
             )
           )
         (let ((a0-19 (-> *net-players* (* (if *net-mgr*
                                               (-> *net-mgr* game-state local-machine-idx)
                                               0
                                               )
                                           2
                                           )
                          )
                      )
               )
           (when a0-19
             (let ((a0-20 (-> a0-19 team)))
               (cond
                 ((zero? a0-20)
                  (if (>= gp-1 v1-9)
                      (return 0)
                      (return 1)
                      )
                  (the-as none 0)
                  )
                 ((= a0-20 1)
                  (if (>= v1-9 gp-1)
                      (return 0)
                      (return 1)
                      )
                  (the-as none 0)
                  )
                 )
               )
             )
           )
         )
       )
     0
     )
    (else
      (let ((s4-0 0)
            (s3-0 1)
            (s2-0 (+ (-> *net-game-mgr* sorted-ct) -1))
            )
        (while (>= s2-0 s3-0)
          (let ((a0-23 (-> *net-players* (-> *net-game-mgr* sorted-ids (+ s3-0 -1))))
                (s1-0 (-> *net-players* (-> *net-game-mgr* sorted-ids s3-0)))
                )
            (cond
              (arg1
                (if (not (net-player-method-81 a0-23 s1-0))
                    (set! s4-0 s3-0)
                    )
                )
              (else
                (if (not (net-player-method-80 a0-23 s1-0))
                    (set! s4-0 s3-0)
                    )
                )
              )
            (if (= arg0 (-> s1-0 player-id))
                (return s4-0)
                )
            )
          (+! s3-0 1)
          )
        )
      0
      )
    )
  )
