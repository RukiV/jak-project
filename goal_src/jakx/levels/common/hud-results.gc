;; definition for symbol *hud-results-view-1-proc*, type object
(define *hud-results-view-1-proc* (the-as object #f))

;; definition of type hud-results-view-1
(deftype hud-results-view-1 (in-game-hud)
  ()
  )

;; definition for method 3 of type hud-results-view-1
(defmethod inspect ((this hud-results-view-1))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type in-game-hud inspect)))
    (t9-0 this)
    )
  (label cfg-4)
  this
  )

;; definition for method 7 of type hud-results-view-1
;; WARN: Return type mismatch in-game-hud vs hud-results-view-1.
(defmethod relocate ((this hud-results-view-1) (offset int))
  (set! *hud-results-view-1-proc* this)
  (if (nonzero? *hud-results-view-1-proc*)
      (set! *hud-results-view-1-proc* (+ (the-as uint *hud-results-view-1-proc*) offset))
      )
  (the-as hud-results-view-1 ((method-of-type in-game-hud relocate) this offset))
  )

;; definition for method 26 of type hud-results-view-1
(defmethod hud-method-26 ((this hud-results-view-1))
  (set! (-> this items) (the-as (array hud-item) *hud-results-view-1*))
  (set! (-> this manager) (new 'static 'basic-manager))
  (set! *hud-results-view-1-proc* this)
  ((method-of-type in-game-hud hud-method-26) this)
  (none)
  )

;; definition for method 10 of type hud-results-view-1
(defmethod deactivate ((this hud-results-view-1))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (set! *hud-results-view-1-proc* (the-as object #f))
  ((method-of-type in-game-hud deactivate) this)
  (none)
  )

;; definition for method 24 of type hud-results-view-1
(defmethod hud-method-24 ((this hud-results-view-1))
  (when *debug-hud*
    (set! (-> this real-items) (the-as (array hud-item) *hud-results-view-1*))
    (hud-method-26 this)
    )
  ((method-of-type in-game-hud hud-method-24) this)
  (none)
  )

;; definition for function spawn-hud-results-view-1
(defun spawn-hud-results-view-1 ()
  (cond
    (*hud-results-view-1-proc*
      *hud-results-view-1-proc*
      )
    (*net-game-mgr*
      (let ((v0-0
              (ppointer->process
                (process-spawn hud-results-view-1 :init hud-init-by-other :name "hud-results-view-1" :to *net-game-mgr*)
                )
              )
            )
        (when (the-as hud-results-view-1 v0-0)
          (set! (-> (the-as hud-results-view-1 v0-0) inited-strings-count) 0)
          0
          )
        v0-0
        )
      )
    (else
      #f
      )
    )
  )

;; definition for method 22 of type hud-results-view-1
;; WARN: Return type mismatch symbol vs none.
(defmethod hud-method-22 ((this hud-results-view-1))
  (none)
  )

