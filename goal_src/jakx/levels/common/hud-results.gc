;; definition for function set-stats-text
;; og:preserve-this hud-results rung: arg0 retyped object -> hud-item-
;; string; the decompiler could not narrow a free function's own arg type
;; the way a method dispatch would, but every call site in this body
;; (hud-item-method-24/26, and the pre-existing (the-as hud-item-
;; string arg0) cast just below) already treats it as one ("No method or
;; function named hud-item-method-24 for type object" without
;; this retype).
;; WARN: Return type mismatch none vs object.
(defun set-stats-text ((arg0 hud-item-string) (arg1 object) (arg2 net-player-race))
  (set! (-> arg0 color) (the-as uint 54))
  (let ((v1-1 arg1))
    (cond
      ((zero? v1-1)
       (cond
         ((score-is-time)
          (let* ((s4-0 print-time)
                 (a0-3 (clear *temp-string*))
                 (f0-0 3.0)
                 (f1-0 0.33333334)
                 (v1-4 (abs (-> arg2 finish-time)))
                 (f1-1 (* f1-0 (the float v1-4)))
                 )
            (s4-0 a0-3 (the-as time-frame (the int (* f0-0 (the float (the int (+ 0.5 f1-1)))))))
            )
          (hud-item-method-24 arg0 *temp-string*)
          )
         (else
           (hud-item-method-26 arg0 (-> arg2 score))
           )
         )
       )
      ((= v1-1 1)
       (let ((s4-1 (method-of-object (the-as hud-item-string arg0) hud-item-method-24)))
         (format (clear *temp-string*) "~,,2f" (-> arg2 best-power-slide))
         (s4-1 (the-as hud-item-string arg0) *temp-string*)
         )
       )
      ((= v1-1 2)
       (print-time (clear *temp-string*) (the-as time-frame (-> arg2 best-hang-time)))
       (hud-item-method-24 arg0 *temp-string*)
       )
      ((= v1-1 3)
       (hud-item-method-26 arg0 (-> arg2 kills))
       )
      ((= v1-1 4)
       (hud-item-method-26 arg0 (-> arg2 deaths))
       )
      ((= v1-1 6)
       (hud-item-method-26
         arg0
         (-> (the-as (pointer int32) (+ (* (net-player-method-71 arg2) 4) (the-as int *game-info*))) 377)
         )
       )
      ((= v1-1 7)
       (hud-item-method-26
         arg0
         (-> (the-as (pointer int32) (+ (* (net-player-method-71 arg2) 4) (the-as int *game-info*))) 400)
         )
       )
      )
    )
  )

;; definition of type hud-results-base
(deftype hud-results-base (hud-item-group)
  ((spawn-time         int32)
   (start-time         int32)
   (grand-prix         symbol)
   (grand-prix-totals  symbol)
   )
  )

;; definition for method 3 of type hud-results-base
(defmethod inspect ((this hud-results-base))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this (-> this type))
  (format #t "~1Talpha: ~D~%" (-> this alpha))
  (format #t "~1Treal-alpha: ~D~%" (-> this real-alpha))
  (format #t "~1Tposition-x: ~D~%" (-> this position-x))
  (format #t "~1Tposition-y: ~D~%" (-> this position-y))
  (format #t "~1Treal-position-x: ~D~%" (-> this real-position-x))
  (format #t "~1Treal-position-y: ~D~%" (-> this real-position-y))
  (format #t "~1Twidth: ~D~%" (-> this width))
  (format #t "~1Theight: ~D~%" (-> this height))
  (format #t "~1Treal-width: ~D~%" (-> this real-width))
  (format #t "~1Treal-height: ~D~%" (-> this real-height))
  (format #t "~1Tzval: ~D~%" (-> this zval))
  (format #t "~1Treal-scale: ~D~%" (-> this real-scale))
  (format #t "~1Tscale: ~D~%" (-> this scale))
  (format #t "~1Tflags: ~D~%" (-> this flags))
  (format #t "~1Teffect: ~A~%" (-> this effect))
  (format #t "~1Tparent: ~A~%" (-> this parent))
  (format #t "~1Titems: ~A~%" (-> this items))
  (format #t "~1Tspawn-time: ~D~%" (-> this spawn-time))
  (format #t "~1Tstart-time: ~D~%" (-> this start-time))
  (format #t "~1Tgrand-prix: ~A~%" (-> this grand-prix))
  (format #t "~1Tgrand-prix-totals: ~A~%" (-> this grand-prix-totals))
  (label cfg-4)
  this
  )

;; definition for symbol *had-gold*, type object
(define *had-gold* (the-as object #f))

;; definition for method 9 of type hud-results-base
;; WARN: Return type mismatch int vs none.
(defmethod hud-item-method-9 ((this hud-results-base))
  (let ((t9-0 (method-of-type hud-item-group hud-item-method-9)))
    (t9-0 this)
    )
  (set! (-> this start-time) (the-as int (current-time)))
  ;; og:preserve-this net-mgr rung: *net-mgr*'s own read below was bare
  ;; (-> *net-mgr* game-type) in this method's own decode; *net-mgr* audit
  ;; flagged it live-and-unguarded (method 9 runs on every hud-results-
  ;; base-derived spawn, matching the sibling fix already landed on
  ;; cash-hud's own identical pattern in hud-cash.gc), guarded with the
  ;; same (and *net-mgr* ...) idiom.
  (if (and (zero? (-> *viewport-array* mode)) *net-mgr* (= (-> *net-mgr* game-type) 4))
      (set! (-> this spawn-time) -1)
      (set! (-> this spawn-time) (the-as int (current-time)))
      )
  (none)
  )

;; definition for function is-nonstandard-mode-ignore-split?
;; WARN: Return type mismatch symbol vs object.
(defun is-nonstandard-mode-ignore-split? ()
  (let ((v1-3 (if *net-world*
                  (the-as int (-> (the-as game-task-node-info (-> *net-world* task-node-info)) net-play-mode))
                  18
                  )
              )
        )
    (cond
      ((or (= v1-3 2) (or (= v1-3 1) (= v1-3 13) (= v1-3 3)))
       )
      (else
        (if (= *active-net-player-count* 1)
            (return (the-as object #t))
            )
        )
      )
    )
  (when (logtest? (-> *net-world* net-state flags) 4)
    (let ((a1-3 -1)
          (v1-14 #t)
          )
      (dotimes (a0-5 (the-as int *active-net-player-count*))
        (if (and (!= -1 a1-3) (!= a1-3 (-> *active-net-players* a0-5 team)))
            (set! v1-14 #f)
            )
        (set! a1-3 (the-as int (-> *active-net-players* a0-5 team)))
        )
      (if v1-14
          (return (the-as object #t))
          )
      )
    )
  (case (if *net-world*
            (the-as int (-> (the-as game-task-node-info (-> *net-world* task-node-info)) net-play-mode))
            18
            )
    ((3)
     #t
     )
    ((1 2 13)
     (if (and (= (if *net-world*
                     (the-as int (-> (the-as game-task-node-info (-> *net-world* task-node-info)) net-play-mode))
                     18
                     )
                 1
                 )
              (= (-> *net-game-mgr* human-ct) 2)
              )
         (return (the-as object #f))
         )
     (let ((v1-33 (-> (get-open-task-node-info) default-advanced-options))
           (a0-15 (-> *net-world* net-state options))
           )
       (if (or (!= (-> v1-33 weapons) (-> a0-15 advanced-options weapons))
               (!= (-> v1-33 param1) (-> a0-15 advanced-options param1))
               (!= (-> v1-33 param2) (-> a0-15 advanced-options param2))
               (!= (-> v1-33 param3) (-> a0-15 advanced-options param3))
               )
           #t
           #f
           )
       )
     )
    (else
      #f
      )
    )
  )

;; definition for function is-nonstandard-mode?
(defun is-nonstandard-mode? ()
  (if (= (view-get-active-index) 1)
      (return #t)
      )
  (is-nonstandard-mode-ignore-split?)
  )

;; definition for method 19 of type hud-results-base
;; WARN: Return type mismatch int vs none.
(defmethod hud-item-method-19 ((this hud-results-base))
  (let ((t9-0 (method-of-type hud-item-group hud-item-method-19)))
    (t9-0 this)
    )
  (cond
    ((or (not (-> this grand-prix)) (-> this grand-prix-totals))
     (when (and (not (demo?))
                (not (cash-stats-on?))
                (not (end-game-menu-on?))
                (or (= -1 (-> this spawn-time)) (< (+ (-> this spawn-time) 1200) (current-time)))
                )
       (cond
         ((or (and (!= -1 (-> this spawn-time)) (< (+ (-> this spawn-time) 1200) (current-time)))
              (and (< (seconds 1) (- (current-time) (the-as time-frame (-> this start-time))))
                   (cpad-pressed? (view-get-active-index) x)
                   )
              )
          (logclear! (-> *cpad-list* cpads (view-get-active-index) button0-abs 0) (pad-buttons x))
          (logclear! (-> *cpad-list* cpads (view-get-active-index) button0-rel 0) (pad-buttons x))
          (cond
            ((and (!= (if *net-world*
                          (the-as int (-> (the-as game-task-node-info (-> *net-world* task-node-info)) net-play-mode))
                          18
                          )
                      3
                      )
                  (or (and (-> *game-info* playing-grand-prix?) (!= 2 (-> *game-info* grand-prix-index)))
                      (is-nonstandard-mode?)
                      )
                  )
             (when (not (send-event *net-game-mgr* 'suppress-end-of-game))
               (when (spawn-hud-game-end)
                 (let ((v1-48 (make-sound-instance (-> *sound-info* 315) (new 'static 'sound-id) (the-as handle #f))))
                   (cond
                     (v1-48
                       (logior! (-> v1-48 flags) 320)
                       (-> v1-48 id)
                       )
                     (else
                       0
                       )
                     )
                   )
                 )
               )
             )
            (else
              (when (spawn-high-score-hud)
                (let ((v1-53 (make-sound-instance (-> *sound-info* 315) (new 'static 'sound-id) (the-as handle #f))))
                  (cond
                    (v1-53
                      (logior! (-> v1-53 flags) 320)
                      (-> v1-53 id)
                      )
                    (else
                      0
                      )
                    )
                  )
                )
              )
            )
          (set! (-> this spawn-time) -1)
          )
         ((and (= (-> this grand-prix-totals) #t) (cpad-pressed? (view-get-active-index) triangle))
          (logclear! (-> *cpad-list* cpads (view-get-active-index) button0-abs 0) (pad-buttons triangle))
          (logclear! (-> *cpad-list* cpads (view-get-active-index) button0-rel 0) (pad-buttons triangle))
          (send-event *current-hud* 'kill-hud-instant)
          (let ((v1-80 (make-sound-instance (-> *sound-info* 315) (new 'static 'sound-id) (the-as handle #f))))
            (cond
              (v1-80
                (logior! (-> v1-80 flags) 320)
                (-> v1-80 id)
                )
              (else
                0
                )
              )
            )
          )
         )
       )
     )
    (else
      (when (and (not (demo?))
                 (not (cash-stats-on?))
                 (not (grand-prix-totals-on?))
                 (or (= -1 (-> this spawn-time)) (< (+ (-> this spawn-time) 1200) (current-time)))
                 )
        (when (or (and (!= -1 (-> this spawn-time)) (< (+ (-> this spawn-time) 1200) (current-time)))
                  (and (< (seconds 1) (- (current-time) (the-as time-frame (-> this start-time))))
                       (cpad-pressed? (view-get-active-index) x)
                       )
                  )
          (let ((v1-96 (make-sound-instance (-> *sound-info* 315) (new 'static 'sound-id) (the-as handle #f))))
            (cond
              (v1-96
                (logior! (-> v1-96 flags) 320)
                (-> v1-96 id)
                )
              (else
                0
                )
              )
            )
          (logclear! (-> *cpad-list* cpads (view-get-active-index) button0-abs 0) (pad-buttons x))
          (logclear! (-> *cpad-list* cpads (view-get-active-index) button0-rel 0) (pad-buttons x))
          (spawn-hud-results-grand-prix-totals)
          (set! (-> this spawn-time) -1)
          )
        )
      )
    )
  (none)
  )

;; definition of type hud-rank-name-score
