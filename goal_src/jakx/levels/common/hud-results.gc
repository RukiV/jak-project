       (set! (-> this items 0 position-y) 20)
       (set! (-> v1-5 position-x) -60)
       (set! (-> a0-2 position-x) 60)
       (set! (-> a1-0 position-y) 285)
       (set! (-> v1-5 position-y) 285)
       (set! (-> a0-2 position-y) 285)
       (set! (-> this position-y) -5)
       (set! (-> this scale) 192)
       (set! (-> a1-0 scale) 153)
       (set! (-> v1-5 scale) 153)
       (set! (-> a0-2 scale) 153)
       )
      ((= a2-1 2)
       (set! (-> this items 1 position-y) -20)
       (set! (-> this items 2 position-y) 115)
       (set! (-> this items 2 position-x) -50)
       (set! (-> this items 2 scale) 256)
       (set! (-> (the-as hud-item-group (-> (the-as hud-item-group (-> this items 2)) items 0)) items 0 scale) 256)
       (set! (-> (the-as hud-item-group (-> (the-as hud-item-group (-> this items 2)) items 0)) items 1 scale) 256)
       (set! (-> (the-as hud-item-group (-> (the-as hud-item-group (-> this items 2)) items 0)) items 1 flags) 32)
       (set! (-> (the-as hud-item-group (-> (the-as hud-item-group (-> this items 2)) items 0)) items 1 position-y)
             30
             )
       (set! (-> this items 0 position-y) 95)
       (set! (-> v1-5 position-x) 60)
       (set! (-> a0-2 position-x) -60)
       (set! (-> a1-0 position-y) 510)
       (set! (-> v1-5 position-y) 510)
       (set! (-> a0-2 position-y) 510)
       (set! (-> this position-y) -20)
       (set! (-> this scale) 166)
       (set! (-> a1-0 scale) 153)
       (set! (-> v1-5 scale) 153)
       (set! (-> a0-2 scale) 153)
       )
      )
    )
  (let ((s5-1 (calc-team-score 0))
        (v1-6 (calc-team-score 1))
        (a0-11 (-> *net-players* (* (if *net-mgr*
                                        (-> *net-mgr* game-state local-machine-idx)
                                        0
                                        )
                                    2
                                    )
                   )
               )
        )
    (when a0-11
      (let ((a0-12 (-> a0-11 team)))
        (cond
          ((zero? a0-12)
           (if (>= s5-1 v1-6)
               (set! (-> this i-got-medal) (the-as uint (report-score #x40400000)))
               (set! (-> this i-got-medal) (the-as uint (report-score 0)))
               )
           )
          ((= a0-12 1)
           (if (>= v1-6 s5-1)
               (set! (-> this i-got-medal) (the-as uint (report-score #x40400000)))
               (set! (-> this i-got-medal) (the-as uint (report-score 0)))
               )
           )
          )
        )
      )
    )
  ((method-of-type hud-results-base hud-item-method-9) this)
  (none)
  )

;; definition for method 19 of type hud-team-score-results
;; og:preserve-this hud-results rung: this method's own body is withheld,
;; not decoded. Three of its own sub-branches (adventure-mode gold-medal
;; text, and both is-clan-challenge score-comparison branches) do
;; (copy-charp<-charp ... (&+ <static-data L131> #xf2d8)), reaching a
;; short string (almost certainly a literal separator, by its own call
;; position between two localized text fragments) via a far-offset
;; pointer computed off L131, a genuine MIPS code label sitting right
;; after this method's own stack-adjust prologue rather than any data
;; symbol; decompiler/config/jakx/ntsc_v1/label_types.jsonc's own L131
;; entry (this rung) gets the decompiler as far as recognizing it needs a
;; sized type but "Type X with length N is not yet supported by the data
;; decompiler" stops it printing a real literal for any size tried, and
;; without that no addressable GOAL symbol exists to hand-transcribe the
;; pointer arithmetic against (writing a raw hex address would be
;; guessing, not transcribing). The rest of this method (dispatch on
;; stats-type, pad input to cycle the stat display, red/blue team-score
;; comparison for the non-adventure non-clan-challenge branches) decodes
;; and type-checks cleanly and was held back only because it shares this
;; one defmethod form with the three blocked branches. Retirement
;; condition: a decompiler fix for printing sized data at an
;; unconventional (code-adjacent) label, or independent evidence for
;; what L131+0xf2d8 actually names. Until then hud-team-score-results
;; falls back to hud-results-base's own generic method 19; the retail
;; per-frame stats-type cycling and team-score text update this override
;; drives do not fire.

;; og:preserve-this hud-results rung: hud-results-background-item's own
;; deftype is relanded here too rather than dropped, the same reasoning
;; as hud-name-score above (goalc tolerates the identical redefinition;
;; this file's own methods need the type known locally since hud-high-
;; scores.gc compiles after it). Field-for-field identical (bare, no
;; fields) to hud-high-scores.gc's own copy.
;; definition of type hud-results-background-item
