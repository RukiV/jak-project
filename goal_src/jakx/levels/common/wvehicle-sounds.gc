;; definition of type wvehicle-sound-loop-params
(deftype wvehicle-sound-loop-params (structure)
  ((speed   float)
   (weight  float)
   )
  )

;; definition for method 3 of type wvehicle-sound-loop-params
(defmethod inspect ((this wvehicle-sound-loop-params))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'wvehicle-sound-loop-params)
  (format #t "~1Tspeed: ~f~%" (-> this speed))
  (format #t "~1Tweight: ~f~%" (-> this weight))
  (label cfg-4)
  this
  )

