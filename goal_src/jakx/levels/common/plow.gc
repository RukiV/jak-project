;; definition for method 7 of type plow
(defmethod relocate ((this plow) (offset int))
  (if (nonzero? (-> this thruster-left))
      (&+! (-> this thruster-left) offset)
      )
  (if (nonzero? (-> this thruster-right))
      (&+! (-> this thruster-right) offset)
      )
  (if (nonzero? (-> this thruster-left-small))
      (&+! (-> this thruster-left-small) offset)
      )
  (if (nonzero? (-> this thruster-right-small))
      (&+! (-> this thruster-right-small) offset)
      )
  (if (nonzero? (-> this thruster-main))
      (&+! (-> this thruster-main) offset)
      )
  (if (nonzero? (-> this eye-left))
      (&+! (-> this eye-left) offset)
      )
  (if (nonzero? (-> this eye-right))
      (&+! (-> this eye-right) offset)
      )
  (if (nonzero? (-> this eye-left-small))
      (&+! (-> this eye-left-small) offset)
      )
  (if (nonzero? (-> this eye-right-small))
      (&+! (-> this eye-right-small) offset)
      )
  (if (nonzero? (-> this smoke))
      (&+! (-> this smoke) offset)
      )
  (if (nonzero? (-> this smoke2))
      (&+! (-> this smoke2) offset)
      )
  (call-parent-method this offset)
  )

;; definition for method 10 of type plow
(defmethod deactivate ((this plow))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (process-nettable-method-19 (-> this thruster-left))
  (process-nettable-method-19 (-> this thruster-right))
  (process-nettable-method-19 (-> this thruster-left-small))
  (process-nettable-method-19 (-> this thruster-right-small))
  (process-nettable-method-19 (-> this thruster-main))
  (process-nettable-method-19 (-> this eye-left))
  (process-nettable-method-19 (-> this eye-right))
  (process-nettable-method-19 (-> this eye-left-small))
  (process-nettable-method-19 (-> this eye-right-small))
  (process-nettable-method-19 (-> this smoke))
  (process-nettable-method-19 (-> this smoke2))
  (call-parent-method this)
  (none)
  )

;; definition for method 75 of type plow
;; WARN: Return type mismatch int vs none.
(defmethod net-enemy-method-75 ((this plow))
  (let ((s5-0 (new 'process 'collide-shape-moving this (collide-list-enum usually-hit-by-player))))
    (set! (-> s5-0 dynam) (copy *standard-dynamics* 'process))
    (set! (-> s5-0 reaction) cshape-reaction-default)
    (set! (-> s5-0 no-reaction)
          (the-as (function collide-shape-moving collide-query vector vector object) nothing)
          )
    (set! (-> s5-0 penetrated-by) (penetrate))
    (let ((s4-0 (new 'process 'collide-shape-prim-group s5-0 (the-as uint 2) 0)))
      (set! (-> s5-0 total-prims) (the-as uint 3))
      (set! (-> s4-0 prim-core collide-as) (collide-spec enemy obstacle camera-blocker))
      (set! (-> s4-0 prim-core collide-with)
            (collide-spec backgnd jak crate civilian enemy obstacle vehicle-sphere hit-by-others-list player-list pusher)
            )
      (set! (-> s4-0 prim-core action) (collide-action solid deadly no-standon))
      (set-vector! (-> s4-0 local-sphere) 0.0 22528.0 0.0 72089.6)
      (set! (-> s5-0 root-prim) s4-0)
      )
    (let ((v1-12 (new 'process 'collide-shape-prim-sphere s5-0 (the-as uint 1))))
      (set! (-> v1-12 prim-core collide-as) (collide-spec camera-blocker))
      (set! (-> v1-12 prim-core collide-with) (collide-spec player-list))
      (set! (-> v1-12 prim-core action) (collide-action solid))
      (set-vector! (-> v1-12 local-sphere) 0.0 32768.0 0.0 61440.0)
      )
    (let ((v1-14 (new 'process 'collide-shape-prim-sphere s5-0 (the-as uint 0))))
      (set! (-> v1-14 prim-core collide-as) (collide-spec enemy))
      (set! (-> v1-14 prim-core collide-with)
            (collide-spec backgnd jak crate civilian enemy obstacle vehicle-sphere hit-by-others-list player-list pusher)
            )
      (set! (-> v1-14 prim-core action) (collide-action solid))
      (set-vector! (-> v1-14 local-sphere) 0.0 12288.0 0.0 61440.0)
      )
    (set! (-> s5-0 nav-radius) 8192.0)
    (let ((v1-16 (-> s5-0 root-prim)))
      (set! (-> s5-0 backup-collide-as) (-> v1-16 prim-core collide-as))
      (set! (-> s5-0 backup-collide-with) (-> v1-16 prim-core collide-with))
      )
    (set! (-> s5-0 max-iteration-count) (the-as uint 3))
    (set! (-> s5-0 event-self) 'touched)
    (set! (-> this root) s5-0)
    )
  0
  (none)
  )

;; definition for method 76 of type plow
;; WARN: Return type mismatch int vs none.
(defmethod net-enemy-method-76 ((this plow))
  (vector-float*! (-> this root scale) (-> this root scale) 4.0)
  (initialize-skeleton
    this
    (the-as skeleton-group (art-group-get-by-name *level* "skel-plow" (the-as (pointer level) #f)))
    (the-as pair 0)
    )
  (set! (-> this thruster-left)
        (the-as process-nettable (create-launch-control (-> *part-group-id-table* 315) this))
        )
  (set! (-> this thruster-right)
        (the-as process-nettable (create-launch-control (-> *part-group-id-table* 315) this))
