;; definition of type plow
(deftype plow (net-enemy)
  ((tracking-player       uint64)
   (do-flip-anim          basic)
   (been-hit              basic)
   (thruster-left         process-nettable)
   (thruster-right        process-nettable)
   (thruster-left-small   process-nettable)
   (thruster-right-small  process-nettable)
   (thruster-main         process-nettable)
   (eye-left              process-nettable)
   (eye-right             process-nettable)
   (eye-left-small        process-nettable)
   (eye-right-small       process-nettable)
   (smoke                 process-nettable)
   (smoke2                process-nettable)
   (engine-sound-id       uint32)
   )
  (:state-methods
    intro-path
    following-path
    reverse
    )
  )

;; definition for method 3 of type plow
(defmethod inspect ((this plow))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type net-enemy inspect)))
    (t9-0 this)
    )
  (format #t "~2Ttracking-player: ~D~%" (-> this tracking-player))
  (format #t "~2Tdo-flip-anim: ~A~%" (-> this do-flip-anim))
  (format #t "~2Tbeen-hit: ~A~%" (-> this been-hit))
  (format #t "~2Tthruster-left: ~A~%" (-> this thruster-left))
  (format #t "~2Tthruster-right: ~A~%" (-> this thruster-right))
  (format #t "~2Tthruster-left-small: ~A~%" (-> this thruster-left-small))
  (format #t "~2Tthruster-right-small: ~A~%" (-> this thruster-right-small))
  (format #t "~2Tthruster-main: ~A~%" (-> this thruster-main))
  (format #t "~2Teye-left: ~A~%" (-> this eye-left))
  (format #t "~2Teye-right: ~A~%" (-> this eye-right))
  (format #t "~2Teye-left-small: ~A~%" (-> this eye-left-small))
  (format #t "~2Teye-right-small: ~A~%" (-> this eye-right-small))
  (format #t "~2Tsmoke: ~A~%" (-> this smoke))
  (format #t "~2Tsmoke2: ~A~%" (-> this smoke2))
  (format #t "~2Tengine-sound-id: ~D~%" (-> this engine-sound-id))
  (label cfg-4)
  this
  )

;; definition for function plow-init-remote
;; WARN: Return type mismatch int vs none.
(defbehavior plow-init-remote process-focusable ((arg0 int))
  (process-nettable-method-34 self -1 (new 'static 'rgba :r #xff :g #xff))
  (process-nettable-method-35 self arg0)
  (process-nettable-method-36 self)
  0
  (none)
  )

;; definition for method 41 of type plow
(defmethod process-nettable-method-41 ((this plow) (arg0 int))
  (ppointer->process (process-spawn plow :init plow-init-remote arg0 :name "plow"))
  )

;; definition for method 37 of type plow
;; WARN: Return type mismatch int vs none.
(defmethod process-nettable-method-37 ((this plow) (arg0 net-process-class-info))
  (set! (-> arg0 msg-map (-> arg0 msg-count)) 'do-flip-anim-msg)
  (+! (-> arg0 msg-count) 1)
  0
  (none)
  )

;; definition for symbol *msg-map-plow*, type (array symbol)
(define *msg-map-plow* (new 'static 'boxed-array :type symbol :length 0 :allocated-length 64))

;; definition for symbol *net-process-class-info-plow*, type net-process-class-info
(define *net-process-class-info-plow* (new 'static 'net-process-class-info))

;; failed to figure out what this is:
(set! (-> *net-process-class-info-plow* msg-map) *msg-map-plow*)

;; failed to figure out what this is:
(write-msg-map-rec plow *net-process-class-info-plow*)

;; failed to figure out what this is:
(set! (-> *net-process-class-info-plow* owner-type) plow)

;; failed to figure out what this is:
(net-process-class-register *net-process-class-info-plow*)

;; definition for method 40 of type plow
(defmethod process-nettable-method-40 ((this plow))
  *net-process-class-info-plow*
  )

