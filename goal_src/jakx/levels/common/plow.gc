             )
        (joint-node plow-lod0-jg main)
        (t9-9 (the-as process-nettable a0-9))
        )
      )
    )
  (when (-> self been-hit)
    (set! (-> self been-hit) #f)
    (launch-nearby-players)
    )
  0
  (none)
  )

