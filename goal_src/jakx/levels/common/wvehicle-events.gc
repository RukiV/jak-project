;;-*-Lisp-*-
(in-package goal)

;; name: wvehicle-events.gc
;; name in dgo: wvehicle-events
;; dgos: COMMON, GAME

;; DECOMP BEGINS

(defbehavior handle-weapon-removed-event wvehicle ((arg0 wvehicle) (arg1 vehicle-weapon-slot) (arg2 event-message-block))
  (let ((v1-0 (-> arg1 in-slot)))
    (cond
      ((zero? v1-0)
       (set! (-> arg0 wpn-left) (the-as handle #f))
       (send-event (handle->process (-> arg0 event-target-handle)) 'weapon-removed 'left)
       (set! (-> arg0 hack-armed-left) #f)
       (the-as int #f)
       )
      ((= v1-0 1)
       (set! (-> arg0 wpn-right) (the-as handle #f))
       (send-event (handle->process (-> arg0 event-target-handle)) 'weapon-removed 'right)
       (set! (-> arg0 hack-armed-right) #f)
       (the-as int #f)
       )
      ((= v1-0 2)
       (if (!= (-> arg1 my-type) 10)
           (format 0 "ERROR: non-shield ~a removed itself from shield slot on ~a.~%" (-> arg1 name) (-> arg0 name))
           )
       (set! (-> arg0 wpn-shield) (the-as uint #f))
       (the-as int #f)
       )
      ((= v1-0 4)
       (if (not (or (= (-> arg1 my-type) 12) (= (-> arg1 my-type) 11)))
           (format 0 "ERROR: non-smoke/oil ~a removed itself from smoke/oil slot on ~a.~%" (-> arg1 name) (-> arg0 name))
           )
       (set! (-> arg0 wpn-oil) (the-as uint #f))
       (the-as int #f)
       )
      ((= v1-0 5)
       (set! (-> arg0 wpn-turbo) (the-as uint #f))
       (the-as int #f)
       )
      ((= v1-0 6)
       (set! (-> arg0 wpn-bulldog-gun) (the-as uint #f))
       (the-as int #f)
       )
      (else
        (format 0 "Weapon ~A in invalid slot ~d~%" arg1 (-> arg1 in-slot))
        (break!)
        0
        )
      )
    )
  )

(defbehavior wv-query-handler wvehicle ((arg0 wvehicle) (arg1 vehicle-weapon-slot) (arg2 event-message-block))
  (case (-> arg2 param 0)
    (('ready)
     (and (and (-> arg0 next-state) (= (-> arg0 next-state name) 'race-waiting)) (logtest? (-> arg0 flags) 128))
     )
    (('camera-inside-view)
     (logtest? #x40000 (-> arg0 flags))
     )
    (('tuning)
     (case (-> arg2 param 1)
       (('engine)
        (shr (shl (-> arg0 car-info tuning) 56) 56)
        )
       (('gearbox)
        (shr (shl (-> arg0 car-info tuning) 48) 56)
        )
       (('armor)
        (shr (shl (-> arg0 car-info tuning) 40) 56)
        )
       (('turbo)
        (shr (-> arg0 car-info tuning) 24)
        )
       )
     )
    )
  )

(defbehavior wv-go-handler wvehicle ((arg0 wvehicle) (arg1 vehicle-weapon-slot) (arg2 event-message-block))
  (case (-> arg2 param 0)
    (('hostile)
     (when (not (focus-test? arg0 dead))
       (-> arg2 param 1)
       (vehicle-method-175 arg0)
       )
     )
    (('die)
     (format 0 "vehicle received go die~%")
     (let ((v1-5 (-> arg0 root root-prim)))
       (set! (-> v1-5 prim-core collide-as) (collide-spec))
       (set! (-> v1-5 prim-core collide-with) (collide-spec))
       )
     0
     (set! (-> arg0 unknown-float-704) 0.0)
     (go (method-of-object arg0 die))
     )
    (('explode)
     (when (logtest? (-> arg0 flags) 512)
       (cpad-set-buzz! (-> *cpad-list* cpads (view-get-active-index)) 0 255 (seconds 1))
       (cpad-set-buzz! (-> *cpad-list* cpads (view-get-active-index)) 1 178 (seconds 1))
       )
     (set! (-> arg0 killed-by) -1)
     (set! (-> arg0 killed-with) 0)
     (set! (-> arg0 unknown-int32-2120) (- (- (if *net-mgr*
                                                  (-> *net-mgr* game-state time)
                                                  0
                                                  )
                                              (if *net-world*
                                                  (-> *net-world* net-state game-start-time)
                                                  0
                                                  )
                                              )
                                           (if *net-world*
                                               (-> *net-world* net-state total-pause-time)
                                               0
                                               )
                                           )
           )
     (go (method-of-object arg0 crash))
     )
    (('race)
     (when (not (focus-test? arg0 dead))
       (set! (-> arg0 behavior) (the-as uint 5))
       (vehicle-method-166 arg0)
       )
     )
    (('player-control)
     (when (not (or (focus-test? arg0 dead) (= (-> arg0 behavior) 4)))
       (set! (-> arg0 behavior) (the-as uint 4))
       (vehicle-method-166 arg0)
       )
     )
    )
  )

