;; definition for symbol *text-display-nice-shot*, type (array hud-item)
(define *text-display-nice-shot*
  (new 'static 'boxed-array :type hud-item
    (new 'static 'hud-item-string
      :alpha #xff
      :position-y -90
      :width #x190
      :zval #xfff0
      :scale #x100
      :flags #x1080
      :effect (new 'static 'hud-effect-group
        :items (new 'static 'boxed-array :type hud-effect
          (new 'static 'hud-effect-font-effect :message 'enter :font-effect #x4)
          (new 'static 'hud-effect-font-effect :message 'exit :font-effect #xf)
          )
        )
      :text-id #x1322
      :font-effect #x8
      :color #x36
      :font-flags #x4
      :has-outline #t
      )
    )
  )

;; definition for symbol *text-display-nice-shot-proc*, type process
(define *text-display-nice-shot-proc* (the-as process #f))

;; definition of type text-display-nice-shot
(deftype text-display-nice-shot (in-game-hud)
  ()
  )

;; definition for method 3 of type text-display-nice-shot
(defmethod inspect ((this text-display-nice-shot))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type in-game-hud inspect)))
    (t9-0 this)
    )
  (label cfg-4)
  this
  )

;; definition for method 7 of type text-display-nice-shot
;; WARN: Return type mismatch in-game-hud vs text-display-nice-shot.
(defmethod relocate ((this text-display-nice-shot) (offset int))
  (set! *text-display-nice-shot-proc* this)
  (if (nonzero? *text-display-nice-shot-proc*)
      (set! *text-display-nice-shot-proc* (&+ *text-display-nice-shot-proc* offset))
      )
  (the-as text-display-nice-shot ((method-of-type in-game-hud relocate) this offset))
  )

;; definition for method 26 of type text-display-nice-shot
(defmethod hud-method-26 ((this text-display-nice-shot))
  (set! (-> this items) *text-display-nice-shot*)
  (set! (-> this manager) (new 'static 'text-display-manager))
  (set! *text-display-nice-shot-proc* this)
  ((method-of-type in-game-hud hud-method-26) this)
  (none)
  )

;; definition for method 10 of type text-display-nice-shot
(defmethod deactivate ((this text-display-nice-shot))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (set! *text-display-nice-shot-proc* #f)
  ((method-of-type in-game-hud deactivate) this)
  (none)
  )

;; definition for method 24 of type text-display-nice-shot
(defmethod hud-method-24 ((this text-display-nice-shot))
  (when *debug-hud*
    (set! (-> this real-items) *text-display-nice-shot*)
    (hud-method-26 this)
    )
  ((method-of-type in-game-hud hud-method-24) this)
  (none)
  )

;; definition for function spawn-text-display-nice-shot
;; WARN: Return type mismatch process vs object.
(defun spawn-text-display-nice-shot ()
  (cond
    (*text-display-nice-shot-proc*
      *text-display-nice-shot-proc*
      )
    (*net-game-mgr*
      (let ((v0-0 (ppointer->process (process-spawn
                                       text-display-nice-shot
                                       :init hud-init-by-other
                                       :name "text-display-nice-shot"
                                       :to *net-game-mgr*
                                       )
                                     )
                  )
            )
        (when (the-as text-display-nice-shot v0-0)
          (set! (-> (the-as text-display-nice-shot v0-0) inited-strings-count) 0)
          0
          )
        v0-0
        )
      )
    (else
      (the-as process #f)
      )
    )
  )

;; definition for method 17 of type text-display-nice-shot
;; WARN: Return type mismatch symbol vs none.
(defmethod hud-method-17 ((this text-display-nice-shot))
  (none)
  )

;; definition for method 22 of type text-display-nice-shot
;; WARN: Return type mismatch symbol vs none.
(defmethod hud-method-22 ((this text-display-nice-shot))
  (none)
  )

;; definition for function display-nice-shot-to-view
(defun display-nice-shot-to-view ()
  (let ((s5-0 (new 'static 'array int16 8 #x1322 #x1323 #x1324 #x1325 #x1326 #x1327 #x1328 #x1329))
        (gp-0 (the-as hud-item-string (-> *text-display-nice-shot* 0)))
        (v1-1 (logand (rand-uint31-gen *random-generator*) 7))
        )
    (if (!= (-> s5-0 v1-1) (-> gp-0 text-id))
        (set! (-> gp-0 text-id) (the-as uint (-> s5-0 v1-1)))
        (set! (-> gp-0 text-id) (the-as uint (-> s5-0 (logand (+ v1-1 1) 7))))
        )
    )
  (spawn-text-display-nice-shot)
  )

;; definition of type hud-headset-talker
(deftype hud-headset-talker (hud-item-group)
  ((decoder-talk-times  uint32  8)
   )
  )

;; definition for method 3 of type hud-headset-talker
(defmethod inspect ((this hud-headset-talker))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this (-> this type))
  (format #t "~1Talpha: ~D~%" (-> this alpha))
  (format #t "~1Treal-alpha: ~D~%" (-> this real-alpha))
  (format #t "~1Tposition-x: ~D~%" (-> this position-x))
  (format #t "~1Tposition-y: ~D~%" (-> this position-y))
  (format #t "~1Treal-position-x: ~D~%" (-> this real-position-x))
  (format #t "~1Treal-position-y: ~D~%" (-> this real-position-y))
  (format #t "~1Twidth: ~D~%" (-> this width))
  (format #t "~1Theight: ~D~%" (-> this height))
  (format #t "~1Treal-width: ~D~%" (-> this real-width))
  (format #t "~1Treal-height: ~D~%" (-> this real-height))
  (format #t "~1Tzval: ~D~%" (-> this zval))
  (format #t "~1Treal-scale: ~D~%" (-> this real-scale))
  (format #t "~1Tscale: ~D~%" (-> this scale))
  (format #t "~1Tflags: ~D~%" (-> this flags))
  (format #t "~1Teffect: ~A~%" (-> this effect))
  (format #t "~1Tparent: ~A~%" (-> this parent))
  (format #t "~1Titems: ~A~%" (-> this items))
  (format #t "~1Tdecoder-talk-times[8] @ #x~X~%" (-> this decoder-talk-times))
  (label cfg-4)
  this
  )

