;; definition for function spawn-hud-headset-talker
(defun spawn-hud-headset-talker ()
  (when (and *net-mgr*
             (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'playing-game))
             (= *view-count* 1)
             )
    (if (zero? (if *net-world*
                   (the-as int (-> (the-as game-task-node-info (-> *net-world* task-node-info)) net-play-mode))
                   18
                   )
               )
        (spawn-hud-headset-talker-race)
        (spawn-hud-headset-talker-other)
        )
    )
  )
