                                       :name "hud-headset-talker-other"
                                       :to *net-game-mgr*
                                       )
                                     )
                  )
            )
        (when (the-as hud-headset-talker-other v0-0)
          (set! (-> (the-as hud-headset-talker-other v0-0) inited-strings-count) 0)
          0
          )
        v0-0
        )
      )
    (else
      (the-as process #f)
      )
    )
  )

;; definition for symbol *last-talker-ids*, type (pointer int32)
(define *last-talker-ids* (new 'static 'array int32 4 0 0 0 0))

;; definition for method 9 of type hud-headset-talker
(defmethod hud-item-method-9 ((this hud-headset-talker))
  (dotimes (v1-0 4)
    (set! (-> *last-talker-ids* v1-0) -1)
    )
  (dotimes (v1-3 6)
    (set! (-> this decoder-talk-times v1-3) (the-as uint -1500))
    )
  (call-parent-method this)
  (none)
  )

