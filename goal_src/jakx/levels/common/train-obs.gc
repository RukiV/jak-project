;; definition for method 71 of type train-object
;; INFO: Used lq/sq
;; WARN: Return type mismatch int vs none.
(defmethod rigid-body-object-method-71 ((this train-object))
  (let ((f30-0 (seconds-per-frame)))
    (let ((v1-1 (new 'stack-no-clear 'vector)))
      (vector-! (the-as vector (-> v1-1 data)) (-> this target-position) (-> this root trans))
      (vector-float*! (-> this rbody lin-velocity) (the-as vector (-> v1-1 data)) (/ 1.0 f30-0))
      )
    (vector-float*! (-> this rbody lin-momentum) (-> this rbody lin-velocity) (-> this rbody info mass))
    (vector-reset! (-> this rbody ang-momentum))
    (let ((v1-8 (new 'stack-no-clear 'collide-query)))
      (set! (-> v1-8 start-pos quad) (-> this root root-prim prim-core world-sphere quad))
      (vector-float*! (-> v1-8 move-dist) (-> this rbody lin-velocity) (seconds-per-frame))
      (let ((a0-10 (the-as structure (-> v1-8 best-other-tri))))
        (set! (-> (the-as collide-query a0-10) radius) (+ 122880.0 (-> this root root-prim local-sphere w)))
        (set! (-> (the-as collide-query a0-10) collide-with) (collide-spec vehicle-sphere hit-by-others-list))
        (set! (-> (the-as collide-query a0-10) ignore-process0) #f)
        (set! (-> (the-as collide-query a0-10) ignore-process1) #f)
        (set! (-> (the-as collide-query a0-10) ignore-pat)
              (new 'static 'pat-surface :noentity #x1 :nojak #x1 :probe #x1 :noendlessfall #x1 :board #x1)
              )
        (set! (-> (the-as collide-query a0-10) action-mask) (collide-action solid))
        (set! (-> (the-as collide-query a0-10) best-other-prim) #f)
        )
      (fill-using-line-sphere *collide-cache* (the-as collide-query (-> v1-8 best-other-tri)))
      )
    (rigid-body-control-method-13 (-> this rbody))
    ;; og:preserve-this compile-only cast: same class as peak-obs's
    ;; identical fix for this shared rigid-body-object-method-71 body;
    ;; rbody-collision is method 62, declared only on collide-shape-moving,
    ;; and the decoder already casts the same root argument for the
    ;; neighboring rigid-body-control-method-11 call three lines below but
    ;; missed this earlier call.
    (rbody-collision (the-as collide-shape-moving (-> this root)) (-> this rbody) f30-0)
    )
  ((method-of-object this rigid-body-object-method-70))
  (rigid-body-control-method-11 (-> this rbody) (the-as collide-shape-moving (-> this root)))
  ((method-of-object this rigid-body-object-method-61))
  (update-transforms (-> this root))
  0
  (none)
  )

