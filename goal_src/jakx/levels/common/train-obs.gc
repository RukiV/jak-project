;; failed to figure out what this is:
(defstate idle (train-car)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('die)
       (go empty-state)
       )
      (else
        ;; og:preserve-this compile-only substitution: the retail body is
        ;; call-parent-state-handler manually inlined (find-parent-method's
        ;; result needs cast-to-method-type before .event resolves, which
        ;; is exactly what call-parent-state-handler already wraps; the
        ;; decompiler could not recognize the macro shape here, matching
        ;; this object's own baseline warning "Can't use call-parent-method
        ;; because find-parent-method was called ... which isn't a method
        ;; or state handler"). Replaced with the real macro call rather
        ;; than hand-patched, since the inlined args (a0-2/a1-1, the type
        ;; and method-id used for the lookup) do not match the event
        ;; handler's own real signature.
        (call-parent-state-handler
          event
          :type (function process int symbol event-message-block symbol)
          proc
          argc
          message
          block
          )
        )
      )
    )
  :post (behavior ()
    (rigid-body-object-method-71 self)
    )
  )

