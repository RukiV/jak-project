;; definition for method 7 of type train
;; WARN: Return type mismatch rigid-body-object vs train.
(defmethod relocate ((this train) (offset int))
  (if (nonzero? (-> this curve))
      (&+! (-> this curve) offset)
      )
  (the-as train ((method-of-type rigid-body-object relocate) this offset))
  )

