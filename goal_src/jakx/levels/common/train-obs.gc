;; definition of type train
(deftype train (train-object)
  ((curve           basic)
   (head-car        int32)
   (number-of-cars  int32)
   (cars            uint64  10)
   (length          float)
   (train-sound-id  uint32)
   (horn-id         uint32)
   (next-horn-time  int32)
   (start           vector  :inline)
   (end             vector  :inline)
   (offset-time     float)
   )
  (:states
    training-mine
    )
  )

;; definition for method 3 of type train
(defmethod inspect ((this train))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type train-object inspect)))
    (t9-0 this)
    )
  (format #t "~2Tcurve: ~A~%" (-> this curve))
  (format #t "~2Thead-car: ~D~%" (-> this head-car))
  (format #t "~2Tnumber-of-cars: ~D~%" (-> this number-of-cars))
  (format #t "~2Tcars[10] @ #x~X~%" (-> this cars))
  (format #t "~2Tlength: ~f~%" (-> this length))
  (format #t "~2Ttrain-sound-id: ~D~%" (-> this train-sound-id))
  (format #t "~2Thorn-id: ~D~%" (-> this horn-id))
  (format #t "~2Tnext-horn-time: ~D~%" (-> this next-horn-time))
  (format #t "~2Tstart: #<vector @ #x~X>~%" (-> this start))
  (format #t "~2Tend: #<vector @ #x~X>~%" (-> this end))
  (format #t "~2Toffset-time: ~f~%" (-> this offset-time))
  (label cfg-4)
  this
  )

