    )
  (let ((t9-0 (method-of-type rigid-body-object inspect)))
    (t9-0 this)
    )
  (format #t "~2Ttarget-position: #<vector @ #x~X>~%" (-> this target-position))
  (label cfg-4)
  this
  )

