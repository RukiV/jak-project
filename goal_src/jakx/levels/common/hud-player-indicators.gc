;; definition for function hud-indicators-spawn
(defun hud-indicators-spawn ()
  (cond
    ((zero? (-> *viewport-array* mode))
     (case (if *net-world*
               (the-as int (-> (the-as game-task-node-info (-> *net-world* task-node-info)) net-play-mode))
               18
               )
       ((11)
        (spawn-hud-artifact-indicators-view0)
        )
       ((14)
        (spawn-hud-assassin-indicators-view0)
        )
       ((7)
        (spawn-hud-ctf-indicators-view0)
        )
       ((5)
        (spawn-hud-hunt-indicators-view0)
        )
       ((13)
        #f
        )
       (else
         (spawn-hud-player-indicators-view0)
         )
       )
     )
    (else
      (case (if *net-world*
                (the-as int (-> (the-as game-task-node-info (-> *net-world* task-node-info)) net-play-mode))
                18
                )
        ((11)
         (spawn-unused-hud-artifact-indicators-view)
         )
        ((14)
         (spawn-unused-hud-assassin-indicators-view)
         )
        ((7)
         (spawn-unused-hud-ctf-indicators-view)
         )
        ((5)
         (spawn-unused-hud-hunt-indicators-view)
         )
        ((13)
         #f
         )
        (else
          (spawn-unused-hud-player-indicators-view)
          )
        )
      )
    )
  )
