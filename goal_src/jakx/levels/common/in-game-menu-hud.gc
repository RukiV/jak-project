;; definition for function spawn-hud-in-game-menu
(defun spawn-hud-in-game-menu ()
  (if (and (!= (-> *net-mgr* game-type) 4)
           (!= (if *net-world*
                   (the-as int (-> (the-as game-task-node-info (-> *net-world* task-node-info)) net-play-mode))
                   18
                   )
               3
               )
           )
      (return (spawn-hud-in-game-menu-networked))
      )
  (cond
    ((= *kernel-boot-message* 'demo-shared)
     (cond
       ((zero? (-> *viewport-array* mode))
        (spawn-hud-in-game-menu-view-shared-0)
        )
       ((zero? (view-get-active-index))
        (spawn-hud-in-game-menu-view-shared-1)
        )
       (else
         (spawn-hud-in-game-menu-view-shared-2)
         )
       )
     )
    ((zero? (-> *viewport-array* mode))
     (spawn-hud-in-game-menu-view-0)
     )
    ((zero? (view-get-active-index))
     (spawn-hud-in-game-menu-view-1)
     )
    (else
      (spawn-hud-in-game-menu-view-2)
      )
    )
  )

