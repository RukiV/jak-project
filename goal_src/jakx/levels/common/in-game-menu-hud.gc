;; definition for method 7 of type hud-in-game-menu-view-0
;; WARN: Return type mismatch in-game-hud vs hud-in-game-menu-view-0.
(defmethod relocate ((this hud-in-game-menu-view-0) (offset int))
  (set! *hud-in-game-menu-view-0-proc* this)
  (if (nonzero? *hud-in-game-menu-view-0-proc*)
      (set! *hud-in-game-menu-view-0-proc* (+ (the-as uint *hud-in-game-menu-view-0-proc*) offset))
      )
  (the-as hud-in-game-menu-view-0 ((method-of-type in-game-hud relocate) this offset))
  )

;; definition for method 26 of type hud-in-game-menu-view-0
(defmethod hud-method-26 ((this hud-in-game-menu-view-0))
  (set! (-> this items) (the-as (array hud-item) *hud-in-game-menu-view-0*))
  (set! (-> this manager) (new 'static 'basic-manager))
  (set! *hud-in-game-menu-view-0-proc* this)
  ((method-of-type in-game-hud hud-method-26) this)
  (none)
  )


;; definition for method 24 of type hud-in-game-menu-view-0
(defmethod hud-method-24 ((this hud-in-game-menu-view-0))
  (when *debug-hud*
    (set! (-> this real-items) (the-as (array hud-item) *hud-in-game-menu-view-0*))
    (hud-method-26 this)
    )
  ((method-of-type in-game-hud hud-method-24) this)
  (none)
  )

;; definition for function spawn-hud-in-game-menu-view-0
;; WARN: Return type mismatch object vs hud-in-game-menu-view-0.
(defun spawn-hud-in-game-menu-view-0 ()
  (the-as
    hud-in-game-menu-view-0
    (cond
      (*hud-in-game-menu-view-0-proc*
        *hud-in-game-menu-view-0-proc*
        )
      (*net-game-mgr*
        (let* ((gp-0 (the-as hud-in-game-menu-view-0 (get-process *default-dead-pool* hud-in-game-menu-view-0 #x4000 1)))
               (v0-0
                 (ppointer->process (when gp-0
                                      (let ((t9-1 (method-of-type hud-in-game-menu-view-0 activate)))
                                        (t9-1 gp-0 *net-game-mgr* "hud-in-game-menu-view-0" (the-as pointer #x70004000))
                                        )
                                      (run-now-in-process gp-0 hud-init-by-other)
                                      (-> gp-0 ppointer)
                                      )
                                    )
                 )
               )
          (when (the-as hud-in-game-menu-view-0 v0-0)
            (set! (-> (the-as hud-in-game-menu-view-0 v0-0) inited-strings-count) 0)
            0
            )
          v0-0
          )
        )
      (else
        #f
        )
      )
    )
  )

