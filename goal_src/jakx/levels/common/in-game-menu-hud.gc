;; definition for method 10 of type hud-in-game-menu-view-0
;; INFO: this function exists in multiple non-identical object files
(defmethod deactivate ((this hud-in-game-menu-view-0))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (set! *hud-in-game-menu-view-0-proc* (the-as object #f))
  (set! *in-game-menu-process* (the-as (pointer process) #f))
  (call-parent-method this)
  (none)
  )

