(in-package goal)

;; name: in-game-menu-hud.gc
;; name in dgo: in-game-menu-hud
;; dgos: COMMON, GAME

;; DECOMP BEGINS

;; og:preserve-this runtime-link visibility fix, matching the
;; kill-current-talker precedent (ambient-h.gc): current-finish-mode is
;; called directly by name below but is not landed anywhere in jakx
;; goal_src yet (net-race/results territory, out of scope here), so the raw
;; call needs a real extern for the compiler to see, not just the
;; decompiler-config one. A call that actually reaches this on a live path
;; still links as zero until that file lands.
(define-extern current-finish-mode (function symbol))
;; same class: in-game-menu-on? is called directly by name below but its
;; own body is not landed anywhere in jakx goal_src yet (in-game-menu-hud2
;; territory, out of scope here).
(define-extern in-game-menu-on? (function object))
;; same class: is-clan-challenge is read directly by name below but its own
;; body is not landed anywhere in jakx goal_src yet (net-race/clan territory,
;; out of scope here).
(define-extern is-clan-challenge (function object))
;; forward-reference breakers: the eleven spawn-hud-in-game-menu* functions
;; are all defined further down this same file, but the two dispatchers
;; among them (spawn-hud-in-game-menu, spawn-hud-in-game-menu-networked) and
;; several of the per-view activate methods call each other and the
;; dispatchers ahead of their own definitions. Their own return types need
;; the nine hud-in-game-menu-* types declared this early too.
(declare-type hud-in-game-menu-view-0 process)
(declare-type hud-in-game-menu-view-1 process)
(declare-type hud-in-game-menu-view-2 process)
(declare-type hud-in-game-menu-view-shared-0 process)
(declare-type hud-in-game-menu-view-shared-1 process)
(declare-type hud-in-game-menu-view-shared-2 process)
(declare-type hud-in-game-menu-networked-view-0 process)
(declare-type hud-in-game-menu-networked-view-1 process)
(declare-type hud-in-game-menu-networked-view-2 process)
(define-extern spawn-hud-in-game-menu-view-0 (function hud-in-game-menu-view-0))
(define-extern spawn-hud-in-game-menu-view-1 (function hud-in-game-menu-view-1))
(define-extern spawn-hud-in-game-menu-view-2 (function hud-in-game-menu-view-2))
(define-extern spawn-hud-in-game-menu-view-shared-0 (function hud-in-game-menu-view-shared-0))
(define-extern spawn-hud-in-game-menu-view-shared-1 (function hud-in-game-menu-view-shared-1))
(define-extern spawn-hud-in-game-menu-view-shared-2 (function hud-in-game-menu-view-shared-2))
(define-extern spawn-hud-in-game-menu (function object))
(define-extern spawn-hud-in-game-menu-networked-view-0 (function hud-in-game-menu-networked-view-0))
(define-extern spawn-hud-in-game-menu-networked-view-1 (function hud-in-game-menu-networked-view-1))
(define-extern spawn-hud-in-game-menu-networked-view-2 (function hud-in-game-menu-networked-view-2))
(define-extern spawn-hud-in-game-menu-networked (function object))

;; definition for symbol *in-game-menu-process*, type (pointer process)
(define *in-game-menu-process* (the-as (pointer process) #f))

;; definition for symbol *in-game-menu-on?*, type object
(define *in-game-menu-on?* (the-as object #f))

;; definition for function in-game-menu-allowed?
(defun in-game-menu-allowed? ()
  (not (or (-> *setting-control* user-current movie)
           (movie?)
           (handle->process (-> *game-info* pov-camera-handle))
           (handle->process (-> *game-info* other-camera-handle))
           (< (-> *display* base-clock frame-counter) (the-as time-frame (-> *game-info* letterbox-time)))
           (< (-> *display* base-clock frame-counter) (the-as time-frame (-> *game-info* blackout-time)))
           (!= (-> *setting-control* user-current bg-a) 0.0)
           (!= (-> *setting-control* user-current bg-a-force) 0.0)
           (not (-> *setting-control* user-current allow-in-game-menu))
           (or (and (handle->process (-> *game-info* auto-save-proc))
                    (not (send-event (handle->process (-> *game-info* auto-save-proc)) 'progress-allowed?))
                    )
               (= *cheat-mode* 'camera)
               (= *master-mode* 'freeze)
               *master-exit*
               (not *common-text*)
               (< (memory-free *nk-dead-pool*) #x8000)
               (and (current-finish-mode) *net-mgr* (= (-> *net-mgr* game-type) 4))
               (in-game-menu-on?)
               )
           )
       )
  )

;; definition of type in-game-menu-struct
(deftype in-game-menu-struct (structure)
  ((last-selection-index  int8)
   (confirmation-sym      basic)
   )
  (:methods
    (in-game-menu-struct-method-9 (_type_) none)
    )
  )

;; definition for method 3 of type in-game-menu-struct
(defmethod inspect ((this in-game-menu-struct))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'in-game-menu-struct)
  (format #t "~1Tlast-selection-index: ~D~%" (-> this last-selection-index))
  (format #t "~1Tconfirmation-sym: ~A~%" (-> this confirmation-sym))
  (label cfg-4)
  this
  )

;; definition for method 9 of type in-game-menu-struct
;; WARN: Return type mismatch int vs none.
(defmethod in-game-menu-struct-method-9 ((this in-game-menu-struct))
  (set! (-> this last-selection-index) 0)
  (set! (-> this confirmation-sym) #f)
  0
  (none)
  )

;; definition for symbol *in-game-menu-struct*, type in-game-menu-struct
(define *in-game-menu-struct* (new 'static 'in-game-menu-struct))

;; definition of type hud-bar-slider
(deftype hud-bar-slider (hud-item-group)
  ()
  ;; og:preserve-this hud-widgets rung: method 24's own float arg0 is NOT
  ;; compatible with hud-item's own now-declared object-typed method 24;
  ;; goalc's own defmethod type-check proved this directly. A genuinely new
  ;; slot, not an override, renamed to method-28.
  (:methods
    (hud-bar-slider-method-28 (_type_ float) none)
    )
  )

;; definition for method 3 of type hud-bar-slider
(defmethod inspect ((this hud-bar-slider))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this (-> this type))
  (format #t "~1Talpha: ~D~%" (-> this alpha))
  (format #t "~1Treal-alpha: ~D~%" (-> this real-alpha))
  (format #t "~1Tposition-x: ~D~%" (-> this position-x))
  (format #t "~1Tposition-y: ~D~%" (-> this position-y))
  (format #t "~1Treal-position-x: ~D~%" (-> this real-position-x))
  (format #t "~1Treal-position-y: ~D~%" (-> this real-position-y))
  (format #t "~1Twidth: ~D~%" (-> this width))
  (format #t "~1Theight: ~D~%" (-> this height))
  (format #t "~1Treal-width: ~D~%" (-> this real-width))
  (format #t "~1Treal-height: ~D~%" (-> this real-height))
  (format #t "~1Tzval: ~D~%" (-> this zval))
  (format #t "~1Treal-scale: ~D~%" (-> this real-scale))
  (format #t "~1Tscale: ~D~%" (-> this scale))
  (format #t "~1Tflags: ~D~%" (-> this flags))
  (format #t "~1Teffect: ~A~%" (-> this effect))
  (format #t "~1Tparent: ~A~%" (-> this parent))
  (format #t "~1Titems: ~A~%" (-> this items))
  (label cfg-4)
  this
  )

;; definition for method 24 of type hud-bar-slider
(defmethod hud-bar-slider-method-28 ((this hud-bar-slider) (arg0 float))
  (let ((v1-3 (-> (the-as hud-item-group (-> this items 1)) items 1)))
    (set! (-> v1-3 scale) (the int (* 12288.0 arg0)))
    )
  (hud-item-method-14 this)
  (hud-item-method-12 this)
  (none)
  )

