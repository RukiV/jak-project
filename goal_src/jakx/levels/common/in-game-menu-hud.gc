;; definition for method 9 of type in-game-menu-hud
(defmethod hud-item-method-9 ((this in-game-menu-hud))
  (set! (-> this sound-id) (the-as uint (new-sound-id)))
  (in-game-menu-hud-method-28 this)
  (logclear! (-> *current-hud* mask) (process-mask pause menu))
  (set! (-> this start-time) (the-as uint (+ (current-time) (seconds 0.5))))
  (set! (-> this selection-index) (-> *in-game-menu-struct* last-selection-index))
  (send-event (handle->process (-> *game-info* player-info (view-get-active-index) vehicle)) 'set 'grabbed #t)
  (call-parent-method this)
  (none)
  )

;; definition for method 24 of type in-game-menu-hud
;; WARN: Return type mismatch symbol vs none.
(defmethod in-game-menu-hud-method-28 ((this in-game-menu-hud))
  (dotimes (v1-0 22)
    (set! (-> this old-clock-ratio v1-0) (-> *display* clock v1-0 clock-ratio))
    (set! (-> *display* clock v1-0 clock-ratio) 1.0)
    )
  (none)
  )

;; definition for method 25 of type in-game-menu-hud
;; WARN: Return type mismatch symbol vs none.
(defmethod in-game-menu-hud-method-29 ((this in-game-menu-hud))
  (dotimes (v1-0 22)
    (set! (-> *display* clock v1-0 clock-ratio) (-> this old-clock-ratio v1-0))
    )
  (none)
  )

;; definition for method 11 of type in-game-menu-hud
(defmethod hud-item-method-11 ((this in-game-menu-hud))
  (send-event (handle->process (-> *game-info* player-info (view-get-active-index) vehicle)) 'set 'grabbed #f)
  (sound-stop (the-as sound-id (-> this sound-id)) #t)
  (call-parent-method this)
  (none)
  )

