;; definition for function spawn-hud-in-game-menu-networked
;; og:preserve-this hand-touch: the raw decode's expression builder gave up
;; on this function (a local-vars dump of mostly `none`-typed registers with
;; `.call!` pseudo-ops that are not valid GOAL), for two reasons this rung
;; traced but did not fully resolve in config: *hud-in-game-menu-networked-
;; view-N* are declared generic array (element type not recoverable this
;; rung) so the raw offset-12/offset-36 chase into them needed a hand
;; pointer cast rather than named-field access, and (call!) placeholders sit
;; where t9 was set to a named function/global one op earlier (turned back
;; into direct calls here, a mechanical substitution, not an invented one).
;; WARN: Return type mismatch none vs object.
(defun spawn-hud-in-game-menu-networked ()
  (let ((not-in-timed-clan-challenge
          (not (and (= (if *net-mgr* (-> *net-mgr* game-state local-machine-idx) 0)
                       (-> *net-mgr* game-state session-master-idx)
                       )
                    (is-clan-challenge)
                    (< 6000
                       (- (if *net-mgr* (-> *net-mgr* game-state time) 0)
                          (if *net-world* (-> *net-world* net-state game-start-time) 0)
                          (if *net-world* (-> *net-world* net-state total-pause-time) 0)
                          )
                       )
                    )
               )
          )
        )
    (let ((flag (if not-in-timed-clan-challenge 4 3)))
      (set! (-> (the-as (pointer int32) (-> (the-as (pointer int32) *hud-in-game-menu-networked-view-0*) 3)) 9) flag)
      (set! (-> (the-as (pointer int32) (-> (the-as (pointer int32) *hud-in-game-menu-networked-view-1*) 3)) 9) flag)
      (set! (-> (the-as (pointer int32) (-> (the-as (pointer int32) *hud-in-game-menu-networked-view-2*) 3)) 9) flag)
      )
    )
  (cond
    ((zero? (-> *viewport-array* mode))
     (spawn-hud-in-game-menu-networked-view-0)
     )
    ((zero? (view-get-active-index))
     (spawn-hud-in-game-menu-networked-view-1)
     )
    (else
      (spawn-hud-in-game-menu-networked-view-2)
      )
    )
  )




