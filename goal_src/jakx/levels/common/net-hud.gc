;; og:preserve-this hud-static-literals rung: message/active/pending retyped
;; basic -> symbol, mirroring the same fix in decompiler/config/jakx/
;; all-types.gc. hud-results-grand-prix's static hud-effect-font-effect
;; instances store a real symbol ('enter) in message, and jakx's symbol type
;; derives from object rather than basic, so a basic-typed field cannot hold
;; a non-#f SYM_PTR through the static-data decoder. message/active/pending
;; are used exclusively as #f/#t booleans or bare event-name symbols in this
;; file's own code (hud-effect-method-11's (not (-> this active)), the
;; (= arg2 (-> this message)) comparison against send-event symbols).
;; definition of type hud-effect
(deftype hud-effect (basic)
  ((message       symbol)
   (active        symbol)
   (pending       symbol)
   (delay         int32)
   (receive-time  int32)
   (item          hud-item)
   )
  (:methods
    (hud-effect-method-9 (_type_) none)
    (hud-effect-method-10 (_type_) none)
    (hud-effect-method-11 (_type_) none)
    (hud-effect-method-12 (_type_ object) none)
    (hud-effect-method-13 (_type_ object object object object) none)
    (hud-effect-method-14 (_type_) none)
    )
  )

;; definition for method 3 of type hud-effect
(defmethod inspect ((this hud-effect))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this (-> this type))
  (format #t "~1Tmessage: ~A~%" (-> this message))
  (format #t "~1Tactive: ~A~%" (-> this active))
  (format #t "~1Tpending: ~A~%" (-> this pending))
  (format #t "~1Tdelay: ~D~%" (-> this delay))
  (format #t "~1Treceive-time: ~D~%" (-> this receive-time))
  (format #t "~1Titem: ~A~%" (-> this item))
  (label cfg-4)
  this
  )

;; definition for method 9 of type hud-effect
;; WARN: Return type mismatch int vs none.
(defmethod hud-effect-method-9 ((this hud-effect))
  0
  (none)
  )

;; definition for method 10 of type hud-effect
;; WARN: Return type mismatch int vs none.
(defmethod hud-effect-method-10 ((this hud-effect))
