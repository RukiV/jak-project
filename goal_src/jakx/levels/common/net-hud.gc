;; definition for method 9 of type basic-manager
(defmethod hud-manager-method-9 ((this basic-manager))
  (set! (-> this exit-start-time) -1)
  (let ((a1-0 *current-hud*))
    (hud-method-27 a1-0 a1-0 0 'enter #f)
    )
  (none)
  )

;; definition for method 10 of type basic-manager
;; WARN: Return type mismatch int vs none.
(defmethod hud-manager-method-10 ((this basic-manager))
  (when (!= (-> this exit-start-time) -1)
    (let ((s5-0 (+ (-> this exit-start-time) (-> this exit-time))))
      (if (and (>= (- (- (if *net-mgr*
                             (-> *net-mgr* game-state time)
                             0
                             )
                         (if *net-world*
                             (-> *net-world* net-state game-start-time)
                             0
                             )
                         )
                      (if *net-world*
                          (-> *net-world* net-state total-pause-time)
                          0
                          )
                      )
                   s5-0
                   )
               (>= s5-0 (-> this previous-time))
               )
          (send-event *current-hud* 'exit)
          )
      (let ((v1-14 (+ s5-0 600)))
        (if (>= (- (- (if *net-mgr*
                          (-> *net-mgr* game-state time)
                          0
                          )
                      (if *net-world*
                          (-> *net-world* net-state game-start-time)
                          0
                          )
                      )
                   (if *net-world*
                       (-> *net-world* net-state total-pause-time)
                       0
                       )
                   )
                v1-14
                )
            (send-event *current-hud* 'hide-and-die)
            )
        )
      )
    (set! (-> this previous-time) (- (- (if *net-mgr*
                                            (-> *net-mgr* game-state time)
                                            0
                                            )
                                        (if *net-world*
                                            (-> *net-world* net-state game-start-time)
                                            0
                                            )
                                        )
                                     (if *net-world*
                                         (-> *net-world* net-state total-pause-time)
                                         0
                                         )
                                     )
          )
    )
  0
  (none)
  )

;; definition for method 11 of type basic-manager
;; WARN: Return type mismatch object vs none.
(defmethod hud-manager-method-11 ((this basic-manager) (arg0 object) (arg1 object) (arg2 symbol) (arg3 event-message-block))
  (case arg2
    (('kill-hud)
     (cond
       ((= (-> this exit-start-time) -1)
        (set! (-> this exit-start-time) (- (- (if *net-mgr*
                                                  (-> *net-mgr* game-state time)
                                                  0
                                                  )
                                              (if *net-world*
                                                  (-> *net-world* net-state game-start-time)
                                                  0
                                                  )
                                              )
                                           (if *net-world*
                                               (-> *net-world* net-state total-pause-time)
                                               0
                                               )
                                           )
              )
        (set! (-> this exit-time) (the-as int (-> arg3 param 0)))
        (set! (-> this previous-time) (- (- (if *net-mgr*
                                                (-> *net-mgr* game-state time)
                                                0
                                                )
                                            (if *net-world*
                                                (-> *net-world* net-state game-start-time)
                                                0
                                                )
                                            )
                                         (if *net-world*
                                             (-> *net-world* net-state total-pause-time)
                                             0
                                             )
                                         )
              )
        )
       (else
         (set! (-> this exit-time) (min (-> this exit-time) (the-as int (-> arg3 param 0))))
         )
       )
     #t
     )
    (('kill-hud-instant)
     (set! (-> this exit-start-time) (+ (- (- -3000 (if *net-world*
                                                        (-> *net-world* net-state total-pause-time)
                                                        0
                                                        )
                                              )
                                           (if *net-world*
                                               (-> *net-world* net-state game-start-time)
                                               0
                                               )
                                           )
                                        (if *net-mgr*
                                            (-> *net-mgr* game-state time)
                                            0
                                            )
                                        )
           )
     (set! (-> this exit-time) 0)
     (set! (-> this previous-time) (-> this exit-start-time))
     (deactivate *current-hud*)
     (send-event *current-hud* 'hide-and-die)
     )
    (('revive-hud)
     (cond
       ((and (!= -1 (-> this exit-start-time))
             (< (+ (-> this exit-start-time) (-> this exit-time)) (- (- (if *net-mgr*
                                                                            (-> *net-mgr* game-state time)
                                                                            0
                                                                            )
                                                                        (if *net-world*
                                                                            (-> *net-world* net-state game-start-time)
                                                                            0
                                                                            )
                                                                        )
                                                                     (if *net-world*
                                                                         (-> *net-world* net-state total-pause-time)
                                                                         0
                                                                         )
                                                                     )
                )
             )
        )
       ((!= (-> this exit-start-time) -1)
        (set! (-> this exit-start-time) -1)
        #t
        )
       (else
         #t
         )
       )
     )
    )
  (none)
  )

