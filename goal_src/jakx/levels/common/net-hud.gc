;; forward-reference breaker: in-game-hud -> hud-item, in-game-hud -> hud-manager
;; (both types are declared further down this file, but in-game-hud's own fields
;; reference them directly)
(declare-type hud-item basic)
(declare-type hud-manager basic)

;; definition of type in-game-hud
(deftype in-game-hud (hud)
  ((real-items            (array hud-item))
   (items                 (array hud-item))
   (manager               hud-manager)
   (inited-strings-count  int32)
   )
  (:methods
    (in-game-hud-method-30 () none)
    (in-game-hud-method-31 (_type_) none)
    (in-game-hud-method-32 (_type_ hud-item vector) none)
    )
  )

;; definition for method 3 of type in-game-hud
(defmethod inspect ((this in-game-hud))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type hud inspect)))
    (t9-0 this)
    )
  (format #t "~2Treal-items: ~A~%" (-> this real-items))
  (format #t "~2Titems: ~A~%" (-> this items))
  (format #t "~2Tmanager: ~A~%" (-> this manager))
  (format #t "~2Tinited-strings-count: ~D~%" (-> this inited-strings-count))
  (label cfg-4)
  this
  )

;; definition for symbol *current-hud*, type in-game-hud
(define *current-hud* (the-as in-game-hud #f))

;; forward-reference breaker: hud-item -> hud-effect (mutual reference: hud-effect's
;; own item field points back to hud-item, and hud-effect's full deftype is declared
;; further down this file)
(declare-type hud-effect basic)

