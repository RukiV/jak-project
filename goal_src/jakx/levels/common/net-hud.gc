;; definition for method 11 of type hud-effect
;; WARN: Return type mismatch int vs none.
(defmethod hud-effect-method-11 ((this hud-effect))
  (let ((s5-0 (- (- (if *net-mgr*
                        (-> *net-mgr* game-state time)
                        0
                        )
                    (if *net-world*
                        (-> *net-world* net-state game-start-time)
                        0
                        )
                    )
                 (if *net-world*
                     (-> *net-world* net-state total-pause-time)
                     0
                     )
                 )
              )
        )
    (when (and (not (-> this active)) (!= -1 (-> this receive-time)))
      (if (-> this pending)
          (hud-item-method-13 (-> this item))
          )
      (when (>= s5-0 (+ (-> this receive-time) (-> this delay)))
        (set! (-> this active) #t)
        (set! (-> this receive-time) -1)
        (hud-effect-method-14 this)
        )
      )
    )
  0
  (none)
  )

;; definition for method 12 of type hud-effect
;; WARN: Return type mismatch object vs none.
(defmethod hud-effect-method-12 ((this hud-effect) (arg0 object))
  (set! (-> this active) #f)
  (set! (-> this pending) #f)
  (set! (-> this receive-time) -1)
  (set! (-> this item) (the-as hud-item arg0))
  (none)
  )

;; definition for method 10 of type hud-item
;; WARN: Return type mismatch int vs none.
(defmethod hud-item-method-10 ((this hud-item))
  (logior! (-> this flags) 2)
  0
  (none)
  )

;; definition for method 14 of type hud-effect
;; WARN: Return type mismatch symbol vs none.
(defmethod hud-effect-method-14 ((this hud-effect))
  (let ((s5-0 (-> this item)))
    (hud-item-method-12 s5-0)
    (hud-item-method-14 s5-0)
    (hud-item-method-13 s5-0)
    )
  (set! (-> this pending) #f)
  (none)
  )

;; definition for method 13 of type hud-effect
(defmethod hud-effect-method-13 ((this hud-effect) (arg0 object) (arg1 object) (arg2 object) (arg3 object))
  (when (and (not (-> this active)) (= arg2 (-> this message)))
    (set! (-> this receive-time) (- (- (if *net-mgr*
                                           (-> *net-mgr* game-state time)
                                           0
                                           )
                                       (if *net-world*
                                           (-> *net-world* net-state game-start-time)
                                           0
                                           )
                                       )
                                    (if *net-world*
                                        (-> *net-world* net-state total-pause-time)
                                        0
                                        )
                                    )
          )
    (set! (-> this active) #f)
    (set! (-> this pending) #t)
    (hud-item-method-13 (-> this item))
    )
  (none)
  )

