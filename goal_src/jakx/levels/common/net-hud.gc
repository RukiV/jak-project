    (hud-item-method-21 (_type_) none)
    (hud-item-method-22 (_type_) none)
    (hud-item-method-23 (_type_ object object object object) none)
    ;; og:preserve-this hud-widgets rung: base-level virtual slot, proven by
    ;; hud-place-event's own method 19 (hud-widgets_ir2.asm, this rung)
    ;; dispatching offset-112 on a bare hud-item array element with a single
    ;; a1 arg (a static string-label address); hud-item-method-24 and
    ;; hud-item-method-24 (both already landed, this same corpus)
    ;; already share this exact (_type_ object) none shape as their own
    ;; override of this slot, previously misdeclared as each subtype's own
    ;; new method because this slot was missing here.
    (hud-item-method-24 (_type_ object) none)
    ;; og:preserve-this hud-widgets rung: contiguity companion to 24/26/27; no
    ;; bare-hud-item call site in this rung's own corpus resolves id 25
    ;; directly, but the vtable is a contiguous table and
    ;; hud-item-method-25 (already landed) shares the same
    ;; (_type_ object) none shape, so a gap here is not representable.
    (hud-item-method-25 (_type_ object) none)
    ;; og:preserve-this hud-widgets rung: proven by hud-leader-score's own
    ;; method 19 (hud-widgets_ir2.asm, this rung) dispatching offset-120 on a
    ;; bare hud-item array element with a single a1 arg (an int,
    ;; calc-team-score's own result); hud-item-method-26 (already
    ;; landed) shares this shape.
    (hud-item-method-26 (_type_ object) none)
    ;; og:preserve-this hud-widgets rung: proven by hud-leader-score's own
    ;; method 19 (hud-widgets_ir2.asm, this rung) dispatching offset-124 on a
    ;; bare hud-item array element with a single a1 arg (the int literal 3);
    ;; hud-item-method-27 (already landed) shares this shape.
    (hud-item-method-27 (_type_ object) none)
    )
  )

