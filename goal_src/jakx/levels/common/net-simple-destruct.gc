(defstate idle (net-simple-destruct)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('impact-impulse)
       (let ((gp-1 (the-as object (-> block param 0))))
         (when (impact-destroys? self (the-as rigid-body-impact gp-1))
           (let ((a0-5 (as-type (-> (the-as rigid-body-impact gp-1) process) vehicle)))
             (send-event a0-5 'set 'padshock)
             )
           )
         (net-simple-destruct-method-63 self (the-as rigid-body-impact gp-1))
         )
       )
      (('attack)
       (let ((s4-0 (the-as object (-> block param 1))))
         ;; og:preserve-this bring-up guard: get-penetrate-using-from-attack-event's
         ;; body is not landed yet (collide/attack leg), so the symbol reads 0 at
         ;; runtime. Retail calls it unconditionally and discards the result here.
         ;; Drop the nonzero? gate when that leg lands.
         (if (nonzero? get-penetrate-using-from-attack-event)
             (get-penetrate-using-from-attack-event (the-as process-drawable proc) block)
             )
         (when (!= (-> (the-as attack-info s4-0) id) (-> self incoming-attack-id))
           (set! (-> self incoming-attack-id) (the-as int (-> (the-as attack-info s4-0) id)))
           (let* ((a0-11 self)
                  (t9-5 (method-of-object a0-11 net-simple-destruct-method-62))
                  )
             (-> block param 0)
             (t9-5 a0-11 proc (the-as attack-info s4-0))
             )
           )
         )
       )
      (('die)
       (net-simple-destruct-method-67 self #f)
       (go-virtual explode)
       )
      )
    )
  :enter (behavior ()
    (ja-post)
    )
  :code sleep-code
  )

(defstate explode (net-simple-destruct)
  :virtual #t
  :enter (behavior ()
    (destroy! self)
    )
  :code sleep-code
  :post (behavior ()
    (when (not (-> self child))
      ;; cleanup-for-death (m44) landed in slice 5; prop kills now clear the collide
      ;; prims and mark the entity dead before the process ends
      ((method-of-object self cleanup-for-death) self)
      (go empty-state)
      )
    (ja-post)
    )
  )

(defstate die (net-simple-destruct)
  :virtual #t
  :code (behavior ()
    '()
    )
  )

