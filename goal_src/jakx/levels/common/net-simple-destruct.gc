    (set! (-> gp-0 0) 0)
    (dotimes (s4-0 (-> *destruct-powerup-names* length))
      (let* ((sv-32 (new 'static 'res-tag))
             (v1-3 (res-lump-value
                     (-> arg0 entity)
                     (the-as symbol (-> *destruct-powerup-names* s4-0))
                     uint128
                     :tag-ptr (& sv-32)
                     :time -1000000000.0
                     )
                   )
             )
        (if (nonzero? sv-32)
            (+! (-> gp-0 0) (the-as int v1-3))
            )
        )
      )
    (-> gp-0 0)
    )
  )

