(defmethod relocate ((this powercell-dispenser-subdraw) (offset int))
  (let ((t9-0 (method-of-type process-drawable relocate)))
    (t9-0 this offset)
    )
  (let ((v1-1 (&+ this offset)))
    (the-as powercell-dispenser-subdraw (when (nonzero? (-> v1-1 draw lights))
                                          (let ((v0-1 (&+ (-> v1-1 draw lights) offset)))
                                            (set! (-> v1-1 draw lights) v0-1)
                                            v0-1
