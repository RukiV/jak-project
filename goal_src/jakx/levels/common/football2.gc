;; definition for function powercell-subdraw-init-by-other
;; INFO: Used lq/sq
(defbehavior powercell-subdraw-init-by-other powercell-dispenser-subdraw ()
  (set! (-> self root) (new 'process 'trsqv))
  (let ((v1-2 (-> self root trans))
        (a0-1 (-> self parent))
        )
    (set! (-> v1-2 quad) (-> (the-as process-drawable (if a0-1
                                                          (the-as process-drawable (-> a0-1 0 self))
                                                          )
                                     )
                             root
                             trans
                             quad
                             )
          )
    )
  (set-vector! (-> self root scale) 3.0 3.0 3.0 1.0)
  (initialize-skeleton
    self
    (the-as skeleton-group (art-group-get-by-name *level* "skel-fuel-cell-shield" (the-as (pointer level) #f)))
    (the-as pair 0)
    )
  (when (nonzero? (-> *viewport-array* mode))
    (set! (-> self part) (create-launch-control (-> *part-group-id-table* 310) self))
    (logior! (-> self draw status) (draw-control-status no-draw))
    )
  (let ((v1-17 (-> self luxo)))
    (set! (-> self draw lights) v1-17)
    (logior! (-> self draw global-effect) (draw-control-global-effect disable-envmap))
    (logior! (-> self draw status) (draw-control-status disable-fog))
    (vector-reset! (-> v1-17 ambient))
    (set! (-> v1-17 color 1 quad) (the-as uint128 0))
    (set! (-> v1-17 color 2 quad) (the-as uint128 0))
    (set-vector! (-> v1-17 color 0) 1.0 1.0 1.0 1.0)
    )
  (set! (-> self draw-part?) (the-as basic #t))
  (go-virtual idle)
  )

