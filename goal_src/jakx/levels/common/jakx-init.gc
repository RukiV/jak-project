;;-*-Lisp-*-
(in-package goal)

;; name: jakx-init.gc
;; name in dgo: jakx-init
;; dgos: COMMON, GAME

(define-extern vehicle-manager-start (function process none)) ;; home vehicle-manager.o is a stub, not landed; the CALL below carries the runtime-link guard, not this declaration

;; DECOMP BEGINS

;; og:preserve-this runtime-link guard (forge #219, bisect-proven guilty commit 693f31412):
;; vehicle-manager-start's home vehicle-manager.gc is still an empty stub, so the symbol
;; links as 0. This call is a bare top-level form, executed unconditionally the moment
;; jakx-init links, not gated inside jakx-activate as this file's original landing note
;; claimed, so the unguarded call jumped through zero on every boot and corrupted the heap.
;; Retires when vehicle-manager.gc lands a real vehicle-manager-start.
;; failed to figure out what this is:
(if (nonzero? vehicle-manager-start)
    (vehicle-manager-start (the-as process *entity-pool*))
    )

;; definition for function jakx-login
(defun jakx-login ()
  (format 0 "jakx-login~%")
  0
  )

;; definition for function jakx-activate
(defun jakx-activate ()
  (format 0 "jakx-activate~%")
  0
  )

;; definition for function jakx-deactivate
(defun jakx-deactivate ()
  (format 0 "jakx-deactivate~%")
  0
  )
