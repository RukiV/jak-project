;;-*-Lisp-*-
(in-package goal)

;; name: jakx-init.gc
;; name in dgo: jakx-init
;; dgos: COMMON, GAME

(define-extern vehicle-manager-start (function process none)) ;; vehicle-manager.gc lands a real vehicle-manager-start (vehicle-manager-arming rung, issues 532, 208), the condition this line used to name as unmet; the CALL below keeps its runtime-link guard as defense in depth, not this declaration

;; DECOMP BEGINS

;; og:preserve-this runtime-link guard (forge #219, bisect-proven guilty commit 693f31412):
;; vehicle-manager-start's home vehicle-manager.gc was an empty stub when this guard was
;; added, so the symbol linked as 0 and this bare top-level call, executed unconditionally
;; the moment jakx-init links (not gated inside jakx-activate as this file's original
;; landing note claimed), jumped through zero on every boot and corrupted the heap.
;; vehicle-manager.gc now lands a real vehicle-manager-start (issues 532, 208), so the
;; symbol links nonzero; the guard stays anyway as defense in depth, a deliberate choice
;; made at that landing, not an oversight, and does not retire.
;; failed to figure out what this is:
(if (nonzero? vehicle-manager-start)
    (vehicle-manager-start (the-as process *entity-pool*))
    )

;; definition for function jakx-login
(defun jakx-login ()
  (format 0 "jakx-login~%")
  0
  )

;; definition for function jakx-activate
(defun jakx-activate ()
  (format 0 "jakx-activate~%")
  0
  )

;; definition for function jakx-deactivate
(defun jakx-deactivate ()
  (format 0 "jakx-deactivate~%")
  0
  )
