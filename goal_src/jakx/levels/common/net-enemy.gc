;;-*-Lisp-*-
(in-package goal)

;; name: net-enemy.gc
;; name in dgo: net-enemy
;; dgos: COMMON, GAME

;; DECOMP BEGINS

;; og:preserve-this: only net-enemy's own "startup" state is landed here; the
;; rest of this object (25+ methods, baseline 26 decode errors per this
;; rung's own scoped decode) is a separate, substantial landing out of scope
;; for the raptor rung. This one state is landed narrowly because raptor's
;; own (defstate startup (raptor) :virtual #t ...) inherits it at link time
;; (define-virtual-state-hook), and scripts/check_state_inherit.py fails the
;; build when a virtual defstate's ancestor is landed nowhere in goal_src;
;; net-enemy's own startup decodes clean (zero errors) and is a trivial,
;; self-contained transcription. Retire this comment once net-enemy.gc lands
;; for real.
(defstate startup (net-enemy)
  :virtual #t
  :enter (behavior ()
    '()
    )
  :code sleep-code
  )

