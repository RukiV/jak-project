;; definition for method 72 of type net-enemy
(defmethod net-enemy-method-72 ((this net-enemy) (arg0 net-enemy-transition))
  (when (-> arg0 preempt)
    (set! (-> this transition-ct) 0)
    0
    )
  (when (>= (-> this transition-ct) 3)
    (format 0 "***too many transitions~%")
    (inspect arg0)
    (dotimes (s5-1 (-> this transition-ct))
      (inspect (-> this transitions s5-1))
      )
    (return #f)
    )
  (mem-copy! (the-as pointer (-> this transitions (-> this transition-ct))) (the-as pointer arg0) 80)
  (+! (-> this transition-ct) 1)
  0
  (none)
  )

