(defstate in-ragdoll (net-enemy)
  :virtual #t
  :exit (behavior ()
    (if (-> self skel effect)
        (logior! (-> self skel effect flags) (effect-control-flag ecf2))
        )
    (set! (-> self vehicle-penetrate-time) -1)
    (logclear! (-> self root penetrated-by) (penetrate vehicle))
    )
  :trans (behavior ()
    (vector-float*! (-> self root transv) (-> self root transv) 0.8)
    (update-transforms (-> self root))
    )
  :code (behavior ()
    (local-vars (v1-4 symbol))
    (until v1-4
      (suspend)
      (set! v1-4 (and (nonzero? (+ (-> self info time-before-evaporate) (-> self last-transition-time) 1))
                      (>= (- (- (- (if *net-mgr*
                                       (-> *net-mgr* game-state time)
                                       0
                                       )
                                   (if *net-world*
                                       (-> *net-world* net-state game-start-time)
                                       0
                                       )
                                   )
                                (if *net-world*
                                    (-> *net-world* net-state total-pause-time)
                                    0
                                    )
                                )
                             (+ (-> self info time-before-evaporate) (-> self last-transition-time))
                             )
                          0
                          )
                      )
            )
      )
    (logior! (-> self skel effect flags) (effect-control-flag ecf1))
    (logclear! (-> self skel effect flags) (effect-control-flag ecf2))
    (do-effect (-> self skel effect) "death-default" 0.0 -1)
    (suspend-for (seconds 0.017)
      )
    (send-event self 'death-end)
    )
  )

