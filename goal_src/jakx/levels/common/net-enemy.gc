     )
    (('instant-death)
     (set! (-> self last-transition-time) (- (- (if *net-mgr*
                                                    (-> *net-mgr* game-state time)
                                                    0
                                                    )
                                                (if *net-world*
                                                    (-> *net-world* net-state game-start-time)
                                                    0
                                                    )
                                                )
                                             (if *net-world*
                                                 (-> *net-world* net-state total-pause-time)
                                                 0
                                                 )
                                             )
           )
     (net-enemy-method-73 self)
     (net-enemy-method-66 self 0 0)
     )
    )
  )

