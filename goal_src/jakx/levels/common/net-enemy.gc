                )
           (set! (-> v1-1 attack-id) a0-5)
           (set! (-> s4-0 id) a0-5)
           )
         (set! (-> s4-0 damage) 100.0)
         (set! (-> s4-0 vehicle-damage-factor) 1.0)
         (set! (-> s4-0 vehicle-impulse-factor) 1.0)
         (set! (-> s4-0 attacker) (process->handle self))
         (send-event arg0 'attack (-> arg3 param 0) s4-0)
         (if (nonzero? (-> s4-0 attacker))
             (send-event (handle->process (-> s4-0 attacker)) 'you-attacked 'attack arg0 s4-0)
             )
         )
       )
     )
    (('attack)
