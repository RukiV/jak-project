;; definition for method 19 of type hud-position
(defmethod hud-item-method-19 ((this hud-position))
  (local-vars (a1-1 int))
  (let ((s5-0 (-> this race-position)))
    (if (= s5-0 -1)
        (set! s5-0 (-> *net-players*
                       (+ (view-get-active-index) (* (if *net-mgr*
                                                         (-> *net-mgr* game-state local-machine-idx)
                                                         0
                                                         )
                                                     2
                                                     )
                          )
                       rank
                       )
              )
        )
    (let* ((v1-12 (the-as hud-item-group (-> this items 0)))
           (a0-3 (-> v1-12 items 0))
           (s4-0 (-> v1-12 items 1))
           )
      (hud-item-method-26 a0-3 (+ s5-0 1))
      0
      (cond
        ((zero? s5-0)
         (set! a1-1 2017)
         )
        ((= s5-0 1)
         (set! a1-1 2016)
         )
        ((= s5-0 2)
         (set! a1-1 2014)
         )
        (else
          (set! a1-1 2015)
          )
        )
      (hud-item-method-24 s4-0 (game-text-info-method-9 *common-text* a1-1 #f))
      )
    )
  ((method-of-type hud-item-group hud-item-method-19) this)
  (none)
  )

