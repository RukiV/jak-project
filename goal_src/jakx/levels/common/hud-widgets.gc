;; definition for method 19 of type hud-item-player-name
;; og:preserve-this hud-widgets rung: arg1 offset sum needs an explicit
;; (pointer uint8) cast, the same class of fix landed on hud-results.gc's
;; and hud-player-indicators.gc's own sibling calls.
(defmethod hud-item-method-19 ((this hud-item-player-name))
  (string<-charp
    (-> this string text)
    (the-as (pointer uint8) (+ (+ (* 96 (+ (view-get-active-index) (* (if *net-mgr*
                                                  (-> *net-mgr* game-state local-machine-idx)
                                                  0
                                                  )
                                              2
                                              )
                   )
             )
          32
          )
       (the-as int *net-player-names*)
       ))
    )
  ((method-of-type hud-item-string hud-item-method-19) this)
  (none)
  )

