   (previous-score      int32)
   (initial-texture-id  uint32)
   )
  )

;; definition for method 3 of type hud-item-score
(defmethod inspect ((this hud-item-score))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this (-> this type))
  (format #t "~1Talpha: ~D~%" (-> this alpha))
  (format #t "~1Treal-alpha: ~D~%" (-> this real-alpha))
  (format #t "~1Tposition-x: ~D~%" (-> this position-x))
  (format #t "~1Tposition-y: ~D~%" (-> this position-y))
  (format #t "~1Treal-position-x: ~D~%" (-> this real-position-x))
  (format #t "~1Treal-position-y: ~D~%" (-> this real-position-y))
  (format #t "~1Twidth: ~D~%" (-> this width))
  (format #t "~1Theight: ~D~%" (-> this height))
  (format #t "~1Treal-width: ~D~%" (-> this real-width))
  (format #t "~1Treal-height: ~D~%" (-> this real-height))
  (format #t "~1Tzval: ~D~%" (-> this zval))
  (format #t "~1Treal-scale: ~D~%" (-> this real-scale))
  (format #t "~1Tscale: ~D~%" (-> this scale))
  (format #t "~1Tflags: ~D~%" (-> this flags))
  (format #t "~1Teffect: ~A~%" (-> this effect))
  (format #t "~1Tparent: ~A~%" (-> this parent))
  (format #t "~1Titems: ~A~%" (-> this items))
  (format #t "~1Tplayer-id: ~D~%" (-> this player-id))
  (format #t "~1Tinitial-player-id: ~D~%" (-> this initial-player-id))
  (format #t "~1Tprevious-score: ~D~%" (-> this previous-score))
  (format #t "~1Tinitial-texture-id: ~D~%" (-> this initial-texture-id))
  (label cfg-4)
  this
  )

;; definition for method 23 of type hud-item-score
;; WARN: Return type mismatch object vs none.
(defmethod hud-item-method-23 ((this hud-item-score) (arg0 object) (arg1 object) (arg2 object) (arg3 object))
  (case arg2
    (('update-score)
     (let ((v1-8 (-> *net-players* (+ (view-get-active-index) (* (if *net-mgr*
                                                                     (-> *net-mgr* game-state local-machine-idx)
                                                                     0
                                                                     )
                                                                 2
                                                                 )
                                      )
                     )
                 )
           )
       (when (and v1-8 (= (-> v1-8 player-id) (-> this player-id)))
         (+! (-> v1-8 score) (-> (the-as event-message-block arg3) param 1))
         (let ((v1-10 (make-sound-instance (-> *sound-info* 318) (new 'static 'sound-id) (the-as handle #f))))
           (if v1-10
               (-> v1-10 id)
               0
               )
           )
         )
       )
     )
    (else
      ((method-of-type hud-item-group hud-item-method-23) this arg0 arg1 arg2 arg3)
      )
    )
  (none)
  )

;; definition for method 9 of type hud-item-score
(defmethod hud-item-method-9 ((this hud-item-score))
  (set! (-> this previous-score) -1)
  (set! (-> this player-id) (-> this initial-player-id))
  (set! (-> (the-as hud-item-sprite (-> this items 0)) tex-id) (-> this initial-texture-id))
  (set! (-> (the-as hud-item-sprite (-> this items 1)) tex-id) (the-as uint #x90d300))
  (cond
    ((= (-> this player-id) -2)
     (set! (-> this player-id) (* (if *net-mgr*
                                      (-> *net-mgr* game-state local-machine-idx)
                                      0
                                      )
                                  2
                                  )
           )
     )
    ((= (-> this player-id) -3)
     (set! (-> this player-id) (+ (* (if *net-mgr*
                                         (-> *net-mgr* game-state local-machine-idx)
                                         0
                                         )
                                     2
                                     )
                                  1
                                  )
           )
     )
    )
  ((method-of-type hud-item-group hud-item-method-9) this)
  (none)
  )

