;; definition for method 23 of type hud-score-single
;; WARN: Function (method 23 hud-score-single) has a return type of none, but the expression builder found a return statement.
(defmethod hud-item-method-23 ((this hud-score-single) (arg0 object) (arg1 object) (arg2 object) (arg3 object))
  (case arg2
    (('update-score)
     (if (-> this other-human)
         (return #f)
         )
     (+! (-> this display-score) (-> (the-as event-message-block arg3) param 1))
     (hud-item-method-26 (-> (the-as hud-item-group (-> this items 1)) items 0) (-> this display-score))
     (hud-item-method-13 this)
     )
    )
  ((method-of-type hud-item-group hud-item-method-23) this arg0 arg1 arg2 arg3)
  (none)
  )

;; definition of type hud-leader-score
(deftype hud-leader-score (hud-item-group)
  ((force-visible  basic)
   (only-humans    basic)
