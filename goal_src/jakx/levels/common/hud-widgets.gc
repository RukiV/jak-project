;; definition for method 19 of type hud-clock
;; WARN: Return type mismatch int vs none.
(defmethod hud-item-method-19 ((this hud-clock))
  (with-pp
    (if (nonzero? (-> this text-id))
        (hud-item-method-22 (-> this items 0))
        (hud-item-method-21 (-> this items 0))
        )
    (cond
      ((-> this fixed-time?)
       (let* ((a0-3 this)
              (t9-2 (method-of-object a0-3 hud-item-method-24))
              (a1-0 (-> this fixed-time-val))
              )
         (-> this fixed-time-val)
         (t9-2 a0-3 a1-0)
         )
       )
      ((-> this count-up)
       (let ((a1-1 (- (- (- (if *net-mgr*
                                (-> *net-mgr* game-state time)
                                0
                                )
                            (if *net-world*
                                (-> *net-world* net-state game-start-time)
                                0
                                )
                            )
                         (if *net-world*
                             (-> *net-world* net-state total-pause-time)
                             0
                             )
                         )
                      (-> *net-game-mgr* intro-end-time)
                      )
                   )
             )
         (- (the-as time-frame a1-1) (- (current-time) (-> pp clock old-frame-counter)))
         (hud-item-method-24 this a1-1)
         )
       )
      (else
