;; definition of type hud-lap
(deftype hud-lap (hud-item-group)
  ((show-total-laps     basic)
   (is-net-player-race  basic)
   (total-laps          int8)
   (current-laps        int8)
   )
  )

;; definition for method 3 of type hud-lap
(defmethod inspect ((this hud-lap))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this (-> this type))
  (format #t "~1Talpha: ~D~%" (-> this alpha))
  (format #t "~1Treal-alpha: ~D~%" (-> this real-alpha))
  (format #t "~1Tposition-x: ~D~%" (-> this position-x))
  (format #t "~1Tposition-y: ~D~%" (-> this position-y))
  (format #t "~1Treal-position-x: ~D~%" (-> this real-position-x))
  (format #t "~1Treal-position-y: ~D~%" (-> this real-position-y))
  (format #t "~1Twidth: ~D~%" (-> this width))
  (format #t "~1Theight: ~D~%" (-> this height))
  (format #t "~1Treal-width: ~D~%" (-> this real-width))
  (format #t "~1Treal-height: ~D~%" (-> this real-height))
  (format #t "~1Tzval: ~D~%" (-> this zval))
  (format #t "~1Treal-scale: ~D~%" (-> this real-scale))
  (format #t "~1Tscale: ~D~%" (-> this scale))
  (format #t "~1Tflags: ~D~%" (-> this flags))
  (format #t "~1Teffect: ~A~%" (-> this effect))
  (format #t "~1Tparent: ~A~%" (-> this parent))
  (format #t "~1Titems: ~A~%" (-> this items))
  (format #t "~1Tshow-total-laps: ~A~%" (-> this show-total-laps))
  (format #t "~1Tis-net-player-race: ~A~%" (-> this is-net-player-race))
  (format #t "~1Ttotal-laps: ~D~%" (-> this total-laps))
  (format #t "~1Tcurrent-laps: ~D~%" (-> this current-laps))
  (label cfg-4)
  this
  )

;; definition for method 9 of type hud-lap
(defmethod hud-item-method-9 ((this hud-lap))
  (let ((v1-0 (new 'stack-no-clear 'array 'int8 1)))
    (if (-> this is-net-player-race)
        (set! (-> v1-0 0) (the-as int (-> *net-world* net-state options advanced-options param1)))
        (set! (-> v1-0 0) (-> this total-laps))
        )
    (if (>= (-> v1-0 0) 10)
        (set! (-> (the-as hud-item-group (-> this items 1)) items 2 width) 38)
        (set! (-> (the-as hud-item-group (-> this items 1)) items 2 width) 22)
        )
    )
  ((method-of-type hud-item-group hud-item-method-9) this)
  (none)
  )

