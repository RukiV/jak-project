;; definition for method 19 of type hud-leader-score
(defmethod hud-item-method-19 ((this hud-leader-score))
  (cond
    ((and (not (-> this force-visible))
          (or (and (-> this only-humans) (< (-> *net-game-mgr* human-ct) 2))
              (and (not (-> this only-humans)) (< (the-as int *active-net-player-count*) 2))
              )
          )
     (hud-item-method-21 this)
     )
