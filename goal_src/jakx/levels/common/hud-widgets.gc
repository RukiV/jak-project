(defun spawn-hud-side-split-bar ()
  (cond
    (*hud-side-split-bar-proc*
      *hud-side-split-bar-proc*
      )
    (*net-game-mgr*
      (let ((v0-0
              (ppointer->process
                (process-spawn hud-side-split-bar :init hud-init-by-other :name "hud-side-split-bar" :to *net-game-mgr*)
                )
              )
            )
        (when v0-0
          (set! (-> (the-as in-game-hud v0-0) inited-strings-count) 0)
          0
          )
        v0-0
        )
      )
    (else
      (the-as process #f)
      )
    )
  )

