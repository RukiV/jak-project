;; definition for method 23 of type hud-clock
(defmethod hud-item-method-23 ((this hud-clock) (arg0 object) (arg1 object) (arg2 object) (arg3 object))
  (case arg2
    (('set-clock-time)
     (when (< 1 (-> (the-as event-message-block arg3) num-params))
       (if (= (-> this clock-id) (-> (the-as event-message-block arg3) param 1))
           (set! (-> this fixed-time-val) (the-as int (-> (the-as event-message-block arg3) param 0)))
           )
       )
     )
    (else
      (let ((t9-0 (method-of-type hud-item-group hud-item-method-23)))
        (t9-0 this arg0 arg1 arg2 arg3)
        )
      )
    )
  ((method-of-type hud-item-group hud-item-method-23) this arg0 arg1 arg2 arg3)
  (none)
  )

