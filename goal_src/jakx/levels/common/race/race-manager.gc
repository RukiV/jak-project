;;-*-Lisp-*-
(in-package goal)

;; name: race-manager.gc
;; name in dgo: race-manager
;; dgos: COMMON, GAME

;; DECOMP BEGINS

;; definition for method 11 of type racer-state
;; INFO: Used lq/sq
;; WARN: Return type mismatch int vs none.
(defmethod racer-state-method-11 ((this racer-state) (arg0 race-state))
  (let ((a2-0 arg0))
    (set! (-> this racer) (the-as uint (ppointer->handle (if a2-0
                                                             (the-as (pointer process) (-> a2-0 start-dir w))
                                                             )
                                                         )
                                  )
          )
    )
  (when arg0
    (set! (-> this position quad)
          (-> (&+ (the-as (pointer uint128) (-> arg0 racer-array 0 end-of-race-dist)) 12) 0)
          )
    (set! (-> this last-race-mesh-position quad)
          (-> (&+ (the-as (pointer uint128) (-> arg0 racer-array 0 end-of-race-dist)) 12) 0)
          )
    )
  (set! (-> this flags) (the-as uint 40))
  (set! (-> this lap-count) 0)
  (set! (-> this lap-distance) 0.0)
  (set! (-> this lap-quadrant) 3)
  (set! (-> this lap) 0.0)
  (set! (-> this prev-racer-lap) 0.0)
  (set! (-> this next-racer-lap) 0.0)
  (set! (-> this last-slice) 0)
  (set! (-> this last-race-line) #f)
  0
  (none)
  )

;; definition for method 9 of type race-state
;; WARN: Return type mismatch int vs none.
(defmethod race-state-method-9 ((this race-state) (arg0 process-drawable) (arg1 int))
  (if (< arg1 10)
      (racer-state-method-11 (-> this racer-array arg1) (the-as race-state arg0))
      )
  0
  (none)
  )

;; definition for method 10 of type race-state
;; WARN: Return type mismatch symbol vs none.
(defmethod race-state-method-10 ((this race-state))
  (dotimes (s5-0 (-> this racer-count))
    (let ((v1-3 (-> this racer-array s5-0)))
      (send-event (handle->process (-> v1-3 racer)) 'race-deactivate)
      )
    )
  (none)
  )

;; definition for symbol *race-state*, type object
;; the retail static instance is fully zero-initialized (272 raw words, all
;; 0x0 in the scoped decode); race-state's own :inline racer-array and other
;; fields all default to zero under (new 'static 'race-state), so no manual
;; field-by-field literal derivation is needed here (not the hud band's
;; static-literal wall, issue 335: that class is nested non-zero arrays of
;; hud-item/race-map-info, this is a single zeroed instance). *race-state*
;; itself stays declared object (provisional, decompiler/config/jakx/all-types.gc,
;; widely referenced elsewhere per (method 262 wvehicle)'s own type_casts.jsonc
;; note); not this rung's to retype globally.
(define *race-state* (new 'static 'race-state))
