;; definition for method 14 of type hud-effect-trigger-score-sound
(defmethod hud-effect-method-14 ((this hud-effect-trigger-score-sound))
  (let ((f30-0 0.0))
    (case (if *net-world*
              (the-as int (-> (the-as game-task-node-info (-> *net-world* task-node-info)) net-play-mode))
              18
              )
      ((1)
       (let ((a0-4 (the-as
                     object
                     (-> *net-players* (+ (view-get-active-index) (* (if *net-mgr*
                                                                         (-> *net-mgr* game-state local-machine-idx)
                                                                         0
                                                                         )
                                                                     2
                                                                     )
                                          )
                         )
                     )
                   )
             )
         (when (the-as net-player a0-4)
           (let ((v1-12 (-> (the-as (pointer int32) a0-4) 126)))
             (set! f30-0 (fmin 0.5 (* 0.05 (fmax 0.0 (+ -1.0 (the float v1-12))))))
             )
           )
         )
       )
      ((13)
       (let ((a0-10 (the-as
                      object
                      (-> *net-players* (+ (view-get-active-index) (* (if *net-mgr*
                                                                          (-> *net-mgr* game-state local-machine-idx)
                                                                          0
                                                                          )
                                                                      2
                                                                      )
                                           )
                          )
                      )
                    )
             )
         (when (the-as net-player a0-10)
           (let ((v1-23 (-> (the-as (pointer int32) a0-10) 124)))
             (set! f30-0 (fmin 0.5 (* 0.05 (fmax 0.0 (+ -1.0 (the float v1-23))))))
             )
           )
         )
       )
      )
    (let ((v1-28 (make-sound-instance (-> *sound-info* (-> this soundname)) (new 'static 'sound-id) (the-as handle #f)))
          )
      (cond
        (v1-28
          (set! (-> v1-28 pitch-mod) (the int (* 1524.0 f30-0)))
          (logior! (-> v1-28 flags) 320)
          (logior! (-> v1-28 mask) 1)
          (-> v1-28 id)
          )
        (else
          0
          )
        )
      )
    )
  (set! (-> this active) #f)
  (set! (-> this pending) #f)
  (set! (-> this receive-time) -1)
  ((method-of-type hud-effect hud-effect-method-14) this)
  (none)
  )

;; definition of type hud-text-effect-sound
(deftype hud-text-effect-sound (hud-effect)
  ((soundname      uint16  :offset-assert 28)
   (next-play-time int32   :offset-assert 32)
   (length         int32   :offset-assert 36)
   (force-length   int32   :offset-assert 40)
   (player-rank    int32   :offset-assert 44)
   (increment      int32   :offset-assert 48)
   )
  )

;; definition for method 3 of type hud-text-effect-sound
(defmethod inspect ((this hud-text-effect-sound))
  (when (not this)
    (set! this this)
