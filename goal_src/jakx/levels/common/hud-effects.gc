;; DECOMP BEGINS

;; og:preserve-this hud-effects rung: runtime-link visibility fix, matching
;; the kill-current-talker precedent (ambient-h.gc) and hud.gc's own copies
;; of the same idiom. hud-effect-emit-score-icon's own method-14 calls
;; create-points-icon-from-screen-pos by name; hud-effects.gc (COMMON)
;; compiles before hud-widgets-3.gc, the file that actually defines it, so
;; the real compiler needs this extern even though decompiler/config/jakx/
;; all-types.gc plays no part here (create-points-icon-from-screen-pos is a
;; plain function, not a method).
(define-extern create-points-icon-from-screen-pos (function vector2 int vector object))

;; og:preserve-this issue 540: the full hud-effect-* subtype family landed
;; in this file (group, slide, font-effect, offscreen, trigger-sound,
;; text-effect-sound, move, throb, fade, scale, emit-score-icon,
;; trigger-score-sound) is single-homed here (game.gd link position 534,
;; hud-results-grand-prix.gc's own 537, which previously carried an
;; identical forward-declare duplicate of every one of these twelve types,
;; now deleted). new_type rewrites every custom method slot on every
;; deftype execution of the same interned type (issue 534); that duplicate
;; risked wiping every method this file lands below the moment
;; hud-results-grand-prix.o linked after it. This file compiles first
;; (all_objs.json index 76 vs hud-results-grand-prix.gc's own 79).

;; definition of type hud-effect-group
;; og:preserve-this hud-effects rung: items retyped basic -> (array hud-effect);
;; methods 9/10/11/12/13 all read items+0 as a length (l.w) then index
;; items+12+i*4 for a per-element pointer, the standard boxed (array T)
;; layout (length/alloc-length/content-type header, data at +12); each
;; iteration then loads the element's own type pointer at elt-4 for a
;; dynamic vtable dispatch, proving polymorphic hud-effect elements rather
;; than a single concrete subtype. Matches decompiler/config/jakx/
;; all-types.gc's own resurrected declaration.
(deftype hud-effect-group (hud-effect)
  ((items (array hud-effect) :offset-assert 28)
   )
  )

;; definition for method 3 of type hud-effect-group
(defmethod inspect ((this hud-effect-group))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this (-> this type))
  (format #t "~1Tmessage: ~A~%" (-> this message))
  (format #t "~1Tactive: ~A~%" (-> this active))
  (format #t "~1Tpending: ~A~%" (-> this pending))
  (format #t "~1Tdelay: ~D~%" (-> this delay))
  (format #t "~1Treceive-time: ~D~%" (-> this receive-time))
  (format #t "~1Titem: ~A~%" (-> this item))
  (format #t "~1Titems: ~A~%" (-> this items))
  (label cfg-4)
  this
  )

