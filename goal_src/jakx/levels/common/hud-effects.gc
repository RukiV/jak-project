(defmethod hud-effect-method-14 ((this hud-effect-fade))
  (set! (-> this start-time) (- (- (if *net-mgr*
                                       (-> *net-mgr* game-state time)
                                       0
                                       )
                                   (if *net-world*
                                       (-> *net-world* net-state game-start-time)
                                       0
                                       )
                                   )
                                (if *net-world*
                                    (-> *net-world* net-state total-pause-time)
                                    0
                                    )
                                )
        )
  (call-parent-method this)
  (none)
  )

