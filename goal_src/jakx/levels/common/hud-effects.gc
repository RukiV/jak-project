;; definition for method 9 of type hud-effect-scale
(defmethod hud-effect-method-9 ((this hud-effect-scale))
  (when (-> this active)
    (let* ((v1-4 (- (current-time) (the-as time-frame (-> this start-time))))
           (f0-1 (fmin 1.0 (/ (the float v1-4) (-> this scale-time))))
           (s5-0 (-> this item))
           )
      (set! (-> s5-0 real-scale) (the int (* 256.0 (lerp (-> this start-scale) (-> this target-scale) f0-1))))
      (hud-item-method-14 s5-0)
      )
    )
  ((method-of-type hud-effect hud-effect-method-9) this)
  (none)
  )

;; definition for method 10 of type hud-effect-scale
(defmethod hud-effect-method-10 ((this hud-effect-scale))
  (when (not (-> this dont-move-me))
    (let* ((v1-4 (- (current-time) (the-as time-frame (-> this start-time))))
           (f30-0 (fmin 1.0 (/ (the float v1-4) (-> this scale-time))))
           (s5-0 (-> this item))
           )
      (when (-> this active)
        (+! (-> s5-0 real-position-x) (the int (ceil (* 0.5 (the float (-> s5-0 real-width)) (+ -1.0 f30-0)))))
        (+! (-> s5-0 real-position-y) (the int (ceil (* 0.5 (the float (-> s5-0 real-height)) (+ -1.0 f30-0)))))
        (hud-item-method-12 s5-0)
        )
      )
    )
  ((method-of-type hud-effect hud-effect-method-10) this)
  (none)
  )

;; definition for method 14 of type hud-effect-scale
(defmethod hud-effect-method-14 ((this hud-effect-scale))
  (set! (-> this start-time) (the-as int (current-time)))
  (set! (-> this start-scale) (* 0.00390625 (the float (-> this item real-scale))))
  ((method-of-type hud-effect hud-effect-method-14) this)
  (none)
  )

