  (format #t "~1Tsoundname: ~D~%" (-> this soundname))
  (format #t "~1Tnext-play-time: ~D~%" (-> this next-play-time))
  (format #t "~1Tlength: ~D~%" (-> this length))
  (format #t "~1Tforce-length: ~D~%" (-> this force-length))
  (format #t "~1Tplayer-rank: ~D~%" (-> this player-rank))
  (format #t "~1Tincrement: ~D~%" (-> this increment))
