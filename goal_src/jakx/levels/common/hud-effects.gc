;; definition for symbol *last-play-time*, type time-frame
(define *last-play-time* (the-as time-frame -1))

;; definition for method 11 of type hud-text-effect-sound
(defmethod hud-effect-method-11 ((this hud-text-effect-sound))
  (when (-> this active)
    (when (< (-> this next-play-time) (current-time))
      (+! (-> this length) -1)
      (when (< (seconds 0.03) (- (current-time) *last-play-time*))
        (let ((v1-11 (make-sound-instance (-> *sound-info* (-> this soundname)) (new 'static 'sound-id) (the-as handle #f)))
              )
          (cond
            (v1-11
              (logior! (-> v1-11 flags) 320)
              (-> v1-11 id)
              )
            (else
              0
              )
            )
          )
        (set! *last-play-time* (current-time))
        )
      (+! (-> this next-play-time) (-> this increment))
      (if (<= (-> this length) 0)
          (set! (-> this active) #f)
          )
      )
    (hud-item-method-13 (-> this item))
    )
  ((method-of-type hud-effect hud-effect-method-11) this)
  (none)
  )

;; og:preserve-this hud-effects rung: hud-effect-method-14 held for
;; hud-text-effect-sound. Its own decode is clean, but it unconditionally
;; dispatches (method-of-object *net-game-mgr* net-game-mgr-method-45) and
;; two calls to game-text-info-method-10, and neither has a landed body
;; anywhere in this corpus yet (net-game-mgr-method-45 is one of the many
;; still-unfilled slots on net-game-mgr's own method-count-80 vtable;
;; game-text-info-method-10 has a landed signature in text-h.gc but no
;; landed defmethod). Holding just this one override is safe rather than a
;; boot risk: hud-text-effect-sound simply inherits hud-effect's own
;; landed method-14 (net-hud.gc) until this override is filled, the normal
;; GOAL virtual-dispatch behavior for an unset vtable slot, not a jump to
;; zero. Retire once net-game-mgr-method-45 and game-text-info-method-10
;; both have landed bodies.

