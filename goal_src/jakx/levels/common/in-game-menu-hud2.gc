(deftype hud-in-game-menu-options-view-1 (in-game-hud)
  ()
  )

;; definition for symbol *hud-in-game-menu-options-view-1-proc*, type hud-in-game-menu-options-view-1
(define *hud-in-game-menu-options-view-1-proc* (the-as hud-in-game-menu-options-view-1 #f))

;; definition for method 3 of type hud-in-game-menu-options-view-1
(defmethod inspect ((this hud-in-game-menu-options-view-1))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type in-game-hud inspect)))
    (t9-0 this)
    )
  (label cfg-4)
  this
  )

;; definition for method 7 of type hud-in-game-menu-options-view-1
;; WARN: Return type mismatch in-game-hud vs hud-in-game-menu-options-view-1.
(defmethod relocate ((this hud-in-game-menu-options-view-1) (offset int))
  (set! *hud-in-game-menu-options-view-1-proc* this)
  (if (nonzero? *hud-in-game-menu-options-view-1-proc*)
      (set! *hud-in-game-menu-options-view-1-proc* (&+ *hud-in-game-menu-options-view-1-proc* offset))
      )
  (the-as hud-in-game-menu-options-view-1 ((method-of-type in-game-hud relocate) this offset))
  )

;; definition for method 26 of type hud-in-game-menu-options-view-1
(defmethod hud-method-26 ((this hud-in-game-menu-options-view-1))
  (set! (-> this items) *hud-in-game-menu-options-view-1*)
  (set! (-> this manager) (new 'static 'basic-manager))
  (set! *hud-in-game-menu-options-view-1-proc* this)
  ((method-of-type in-game-hud hud-method-26) this)
  (none)
  )

;; definition for method 10 of type hud-in-game-menu-options-view-1
(defmethod deactivate ((this hud-in-game-menu-options-view-1))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (set! *hud-in-game-menu-options-view-1-proc* #f)
  ((method-of-type in-game-hud deactivate) this)
  (none)
  )

;; definition for method 24 of type hud-in-game-menu-options-view-1
(defmethod hud-method-24 ((this hud-in-game-menu-options-view-1))
  (when *debug-hud*
    (set! (-> this real-items) *hud-in-game-menu-options-view-1*)
    (hud-method-26 this)
    )
  ((method-of-type in-game-hud hud-method-24) this)
  (none)
  )

