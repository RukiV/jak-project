;;-*-Lisp-*-
(in-package goal)

;; name: in-game-menu-hud2.gc
;; name in dgo: in-game-menu-hud2
;; dgos: COMMON, GAME

;; og:preserve-this in-game-menu-hud2 rung: in-game-menu-hud and
;; in-game-menu-hud-options's own home is in-game-menu-hud.gc, still
;; unlanded this rung (its own decode carries two open blockers: a raw
;; type-registration blob at top-level-login that the decompiler cannot
;; guess a label use for, and a hand-inlined handle->process check in
;; in-game-menu-allowed? that prints as unsupported pseudo-ops, the same
;; class jakx's rigid-body-debug.gc already documents). Several of this
;; file's own methods dispatch on these two types, so they are forward-
;; declared here; when in-game-menu-hud.gc lands, its own deftype forms
;; for these two types should be dropped in favor of these to avoid a
;; duplicate-definition throw.
(deftype in-game-menu-hud (hud-item-group)
  ((start-time      uint64)
   (selection-index int8)
   (old-clock-ratio float 22)
   (sound-id        uint32)
   )
  ;; og:preserve-this hud-widgets rung 2: methods 24/25 both REPLACE
  ;; hud-item's own inherited slots (see the matching all-types.gc comment
  ;; for the full mechanism; defined in in-game-menu-hud.gc).
  (:methods
    (hud-item-method-24 (_type_) none :replace)
    (hud-item-method-25 (_type_) none :replace)
    )
  )

(deftype in-game-menu-hud-options (in-game-menu-hud)
  ()
  )

(deftype hud-bar-slider (hud-item-group)
  ()
  ;; og:preserve-this hud-widgets rung 2: method 24 REPLACES hud-item's own
  ;; inherited slot (see the matching all-types.gc comment for the full
  ;; mechanism; defined in in-game-menu-hud.gc).
  (:methods
    (hud-item-method-24 (_type_ float) none :replace)
    )
  )

;; og:preserve-this in-game-menu-hud2 rung: *in-game-menu-struct* and its
;; own type are also homed in in-game-menu-hud.gc, populated there via a
;; runtime (method-set! ...) top-level form rather than a static instance,
;; so it cannot simply be dropped into this file's own static data; forward
;; declared for the same open-blocker reason as the two deftypes above.
(deftype in-game-menu-struct (structure)
  ((last-selection-index int8)
   (confirmation-sym     basic)
   )
  (:methods
    (in-game-menu-struct-method-9 (_type_) none)
    )
  )
(define-extern *in-game-menu-struct* in-game-menu-struct)

;; og:preserve-this in-game-menu-hud2 rung: quit-game-stats-update homes to
;; net-game-mgr.gc and suppress-look-start homes to wvehicle-util.gc, both
;; entirely outside this band and still unlanded, so both symbols link as 0
;; until they land. Their three call sites below gained a (nonzero? ...)
;; runtime-link guard matching the vehicle-manager-start precedent in
;; jakx-init.gc.
(define-extern quit-game-stats-update (function object))
(define-extern suppress-look-start (function object))

;; og:preserve-this in-game-menu-hud2 rung: stat-info and
;; *net-player-ladder-stats-info* home to a different unlanded file (jakx
;; eng-util wave evidence, all-types.gc's own comment), forward declared
;; here for the same reason as the types above; this file's own use is a
;; single constant-index pointer read, (-> *net-player-ladder-stats-info*
;; 3).
(deftype stat-info (structure)
  ((text-id      uint32)
   (taskname     basic)
   (name         basic)
   (offset       int32)
   (tp           uint64)
   (scale        float)
   (format-scale float)
   (flags        uint64)
   (init         int32)
   (min-div      int32)
   )
  (:methods
    (stat-info-method-9 (_type_ int string symbol) none)
    (stat-info-method-10 (_type_ int string symbol) symbol)
    (stat-info-method-11 (_type_ int float) symbol)
    (stat-info-method-12 (_type_ int float) symbol)
    (stat-info-method-13 (_type_ int stat-info stat-info) symbol)
    (stat-info-method-14 (_type_ object) none)
    )
  )
(define-extern *net-player-ladder-stats-info* (pointer stat-info))

;; og:preserve-this in-game-menu-hud2 rung: *medius-my-player*'s own type
;; (medius-cached-info-player, a multiplayer lobby record entirely outside
;; this band) is not landed anywhere in goal_src; this file's own use is
;; raw pointer arithmetic feeding a method call argument, not a named
;; field access, so the global stays typed object and the read is a raw
;; byte pointer cast at its call site (same class as (method 19
;; in-game-menu-hud)'s own op 427, tracked separately in that unlanded
;; file).
(define-extern *medius-my-player* object)

;; og:preserve-this in-game-menu-hud2 rung: spawn-hud-in-game-menu homes to
;; in-game-menu-hud.gc, still unlanded this rung (its own decode carries
;; two open blockers, tracked in that file's own comments), so the symbol
;; links as 0 until it lands. Its one call site below gained a (nonzero?
;; ...) runtime-link guard matching the vehicle-manager-start precedent in
;; jakx-init.gc.
(define-extern spawn-hud-in-game-menu (function object))

;; og:preserve-this in-game-menu-hud2 rung: in-game-menu-on?'s own body
;; (this file, DECOMP BEGINS below) checks nine more *-proc* globals whose
;; owning types home to in-game-menu-hud.gc, still unlanded; forward
;; declared as object, matching their own untyped provisional declaration
;; in all-types.gc, since only truthiness is ever tested here.
(define-extern *hud-in-game-menu-view-0-proc* object)
(define-extern *hud-in-game-menu-view-1-proc* object)
(define-extern *hud-in-game-menu-view-2-proc* object)
(define-extern *hud-in-game-menu-view-shared-0-proc* object)
;; *hud-in-game-menu-view-shared-1-proc* and -2-proc* are already typed to
;; their own concrete types in all-types.gc (a previous rung's real
;; evidence), so those two forward-declare their owning types too rather
;; than a bare object placeholder, to avoid a define-extern retype throw.
(deftype hud-in-game-menu-view-shared-1 (in-game-hud)
  ()
  )
(define-extern *hud-in-game-menu-view-shared-1-proc* hud-in-game-menu-view-shared-1)
(deftype hud-in-game-menu-view-shared-2 (in-game-hud)
  ()
  )
(define-extern *hud-in-game-menu-view-shared-2-proc* hud-in-game-menu-view-shared-2)
(define-extern *hud-in-game-menu-networked-view-0-proc* object)
(define-extern *hud-in-game-menu-networked-view-1-proc* object)
(define-extern *hud-in-game-menu-networked-view-2-proc* object)

