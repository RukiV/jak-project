;; definition for function spawn-hud-in-game-menu-options
(defun spawn-hud-in-game-menu-options ()
  (cond
    ((zero? (-> *viewport-array* mode))
     (spawn-hud-in-game-menu-options-view-0)
     )
    ((zero? (view-get-active-index))
     (spawn-hud-in-game-menu-options-view-1)
     )
    (else
      (spawn-hud-in-game-menu-options-view-2)
      )
    )
  )

;; definition for method 19 of type in-game-menu-hud
(defmethod hud-item-method-19 ((this in-game-menu-hud))
  (let ((s5-0 (-> this items length)))
    (cond
      ((< (current-time) (the-as time-frame (-> this start-time)))
       )
      ((cpad-pressed? (view-get-active-index) down)
       (+! (-> this selection-index) 1)
       (logclear! (-> *cpad-list* cpads (view-get-active-index) button0-abs 0) (pad-buttons down))
       (logclear! (-> *cpad-list* cpads (view-get-active-index) button0-rel 0) (pad-buttons down))
       (let ((v1-28 (make-sound-instance (-> *sound-info* 343) (new 'static 'sound-id) (the-as handle #f))))
         (cond
           (v1-28
             (logior! (-> v1-28 flags) 320)
             (-> v1-28 id)
             )
           (else
             0
             )
           )
         )
       )
      ((cpad-pressed? (view-get-active-index) up)
       (+! (-> this selection-index) -1)
       (logclear! (-> *cpad-list* cpads (view-get-active-index) button0-abs 0) (pad-buttons up))
       (logclear! (-> *cpad-list* cpads (view-get-active-index) button0-rel 0) (pad-buttons up))
       (let ((v1-54 (make-sound-instance (-> *sound-info* 343) (new 'static 'sound-id) (the-as handle #f))))
         (cond
           (v1-54
             (logior! (-> v1-54 flags) 320)
             (-> v1-54 id)
             )
           (else
             0
             )
           )
         )
       )
      ((cpad-pressed? (view-get-active-index) start)
       (logclear! (-> *cpad-list* cpads (view-get-active-index) button0-abs 0) (pad-buttons start))
       (logclear! (-> *cpad-list* cpads (view-get-active-index) button0-rel 0) (pad-buttons start))
       (set! *in-game-menu-process* (the-as (pointer process) #f))
       (set-master-mode 'game)
       (hud-item-method-25 this)
       (deactivate *current-hud*)
       )
      ((cpad-pressed? (view-get-active-index) x)
       (logclear! (-> *cpad-list* cpads (view-get-active-index) button0-abs 0) (pad-buttons x))
       (logclear! (-> *cpad-list* cpads (view-get-active-index) button0-rel 0) (pad-buttons x))
       (let ((v1-102 (make-sound-instance (-> *sound-info* 315) (new 'static 'sound-id) (the-as handle #f))))
         (cond
           (v1-102
             (logior! (-> v1-102 flags) 320)
             (-> v1-102 id)
             )
           (else
             0
             )
           )
         )
       (let ((v1-109 (-> (the-as hud-item-string (-> this items (-> this selection-index))) text-id)))
         (cond
           ((or (zero? v1-109) (= v1-109 526))
            (set! *in-game-menu-process* (the-as (pointer process) #f))
            (set-master-mode 'game)
            (hud-item-method-25 this)
            (deactivate *current-hud*)
            )
           ((or (zero? v1-109) (= v1-109 127))
            (set! *in-game-menu-process* (the-as (pointer process) #f))
            (set-master-mode 'game)
            (set-blackout-frames (seconds 1))
            (send-event *net-game-mgr* 'restart-game)
            (deactivate *current-hud*)
            )
           ((or (zero? v1-109) (= v1-109 1510))
            (set! *in-game-menu-process* (the-as (pointer process) #f))
            (set-master-mode 'game)
            (set-blackout-frames (seconds 1))
            (send-event *net-game-mgr* 'abort-game)
            (deactivate *current-hud*)
            )
           ((or (zero? v1-109) (= v1-109 28))
            (hud-item-method-25 this)
            (set! *in-game-menu-process* (process->ppointer (the-as process (spawn-hud-in-game-menu-options))))
            (set! (-> *in-game-menu-struct* last-selection-index) (-> this selection-index))
            (deactivate *current-hud*)
            )
           ((or (zero? v1-109) (= v1-109 52))
            (cond
              ((demo?)
               (set! *master-exit* 'force)
               )
              (else
                (if (nonzero? quit-game-stats-update)
                    (quit-game-stats-update)
                    )
                (send-event *net-mgr* 'quit-game)
                ;; og:preserve-this in-game-menu-hud2 rung: *net-game-mgr*'s
                ;; own type (net-game-mgr, a 0x130-byte, 37-new-method
                ;; multiplayer game-mode manager entirely outside this
                ;; band) is not landed anywhere in goal_src; both reads of
                ;; its intro-end-time field below (declared offset 224) are
                ;; rewritten as raw offset pointer reads rather than
                ;; forward-declaring the unlanded type for two field reads.
                (if (and (< 1500 (cond
                                   ((not *net-game-mgr*)
                                    0
                                    )
                                   ((< (-> (the-as (pointer int32) (&+ *net-game-mgr* 224)) 0) 0)
                                    0
                                    )
                                   (else
                                     (max 0 (- (- (- (if *net-mgr*
                                                         (-> *net-mgr* game-state time)
                                                         0
                                                         )
                                                     (if *net-world*
                                                         (-> *net-world* net-state game-start-time)
                                                         0
                                                         )
                                                     )
                                                  (if *net-world*
                                                      (-> *net-world* net-state total-pause-time)
                                                      0
                                                      )
                                                  )
                                               (-> (the-as (pointer int32) (&+ *net-game-mgr* 224)) 0)
                                               )
                                          )
                                     )
                                   )
                            )
                         (!= (if *net-world*
                                 (the-as int (-> (the-as game-task-node-info (-> *net-world* task-node-info)) net-play-mode))
                                 18
                                 )
                             3
                             )
                         )
                    (stat-info-method-11
                      (-> *net-player-ladder-stats-info* 3)
                      (the-as int (&-> (the-as (pointer uint8) *medius-my-player*) 364))
                      1.0
                      )
                    )
                )
              )
            (set-blackout-frames (seconds 1))
            (set-master-mode 'game)
            (deactivate *current-hud*)
            )
           )
         )
       )
      ((cpad-pressed? (view-get-active-index) triangle)
       (set! *in-game-menu-process* (the-as (pointer process) #f))
