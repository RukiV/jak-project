;; og:preserve-this bring-up stub (#115): this object is the retail home of
;; in-game-menu-startup (only it and the caller main.o reference the symbol).
;; The real body spawns the in-game menu process; a no-op is safe because
;; set-master-mode's ('progress) branch then sees (not *in-game-menu-process*)
;; and bounces master-mode back to 'game. Without this the symbol linked 0 and
;; the same pause path as #115's menu-respond-to-pause crashed goal-0. Retires
;; with the menu leg (#98).
(defun in-game-menu-startup ()
  (none)
  )

