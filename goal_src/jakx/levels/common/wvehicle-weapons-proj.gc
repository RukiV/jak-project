;; definition for method 17 of type mine-b
(defmethod process-nettable-method-17 ((this mine-b) (arg0 symbol) (arg1 mem-buffer))
  (case arg0
    (('falling-off)
     (mem-buffer-method-41 arg1 (-> this root trans))
     (mem-buffer-method-43 arg1 (-> this root rot))
     (mem-buffer-method-41 arg1 (-> this root transv))
