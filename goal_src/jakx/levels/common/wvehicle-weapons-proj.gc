    )
  (format #t "~2Tshooter: ~D~%" (-> this shooter))
  (format #t "~2Tdestination-point: #<vector @ #x~X>~%" (-> this destination-point))
  (format #t "~2Tdestination-rot: #<quaternion @ #x~X>~%" (-> this destination-rot))
