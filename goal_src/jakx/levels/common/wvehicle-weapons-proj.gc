         (mem-buffer-method-15 s5-1 ((method-of-object *net-process-mgr* net-process-mgr-method-51)))
         (net-predictor-simple-method-10 (-> this pred) s5-1)
         (process-nettable-method-29 this s5-1 -2 0)
         (process-nettable-method-28 this s5-1)
