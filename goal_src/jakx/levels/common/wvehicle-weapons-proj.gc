  ((method-of-type mem-buffer mem-buffer-method-25) (the-as mem-buffer arg0) (-> this root rot))
  ((method-of-type mem-buffer mem-buffer-method-23) (the-as mem-buffer arg0) (-> this destination-point))
  ((method-of-type mem-buffer mem-buffer-method-25) (the-as mem-buffer arg0) (-> this destination-rot))
  (write-handle (the-as mem-buffer arg0) (the-as uint (-> this shooter)))
  (write-handle (the-as mem-buffer arg0) (the-as uint (-> this glued-to)))
  ((method-of-type mem-buffer mem-buffer-method-16) (the-as mem-buffer arg0) (-> this attach-point))
  (let ((t9-8 (method-of-type mem-buffer mem-buffer-method-20)))
    (+ (- (the-as time-frame (- (- (if *net-mgr*
                                       (-> *net-mgr* game-state time)
                                       0
                                       )
                                   (if *net-world*
                                       (-> *net-world* net-state game-start-time)
