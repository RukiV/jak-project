;; DECOMP BEGINS

;; og:preserve-this wvehicle-weapons-vein rung 5, item 4: net-projectile,
;; mine-a, mine-b and v-yellow-guided-missile all land their deftype plus
;; one clean method each (net-projectile-method-72's own override on
;; v-yellow-guided-missile, mine-a-method-62, mine-b-method-65), verbatim
;; from decompiler/config/jakx/all-types.gc's own already-derived offsets
;; (mechanical/oracle-verified provenance per that file's own notes on
;; each type, not re-derived here). None of the three needed method arity
;; had to change: net-projectile-method-72 decoded clean once
;; type_casts.jsonc's own "(method 72 v-yellow-guided-missile)" -- sic,
;; the decompiler names the override by the concrete type -- picked up a
;; two-slot vector stack hint (stack_structures.jsonc); mine-a-method-62
;; and mine-b-method-65 decoded clean with zero config changes beyond the
;; existing (pointer process) -> uint logior retype this rung's own note
;; on (method 62 mine-a) documents. Two build-time deviations from the raw
;; decode, both matching precedent already established elsewhere in this
;; file family: process->ppointer/ppointer->handle's own macro calls
;; replace the decoder's raw nonzero?/l32-false-check/pid-shift expansion
;; in both mine-a-method-62 and mine-b-method-65 (v-wpn-base-common-trans's
;; own note, wvehicle-weapons-h.gc, documents the identical class), and
;; net-projectile-method-72's own dead sp+16/sp+32 vector scratches print
;; as ordinary vector locals with no further deviation needed. Every other
;; method on all four types (61/62/67/70/78/79/80 on v-yellow-guided-
;; missile; 15/17/35 on mine-a/mine-b) stays unlanded; each has its own
;; further wall, not chased this rung (item 4 is "as time allows").
(deftype net-projectile (projectile)
  ()
  :method-count-assert 75
  :size-assert         #x231
  :flag-assert         #x4b01b00231
  (:methods
    (net-projectile-method-72 (_type_ vector vector vector vector object) vector) ;; 72
    (net-projectile-method-73 () none) ;; 73
    (net-projectile-method-74 (_type_) none) ;; 74
    )
  )

