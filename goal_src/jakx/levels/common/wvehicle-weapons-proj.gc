    (('attached-to)
     (set! (-> this glued-to) (the-as uint (read-handle arg1)))
     (set! (-> this attach-point) (the-as int (mem-buffer-method-34 arg1)))
     enter-state
     (-> this glued-to)
     (-> this attach-point)
     (go (method-of-object this leaping-onto))
     )
    )
  (none)
  )

;; definition for method 80 of type v-yellow-guided-missile
