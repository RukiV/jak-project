;; definition for method 72 of type net-projectile
(defmethod net-projectile-method-72 ((this v-yellow-guided-missile) (arg0 vector) (arg1 vector) (arg2 vector) (arg3 vector) (arg4 object))
  (when (not arg2)
    (let ((v1-1 (new 'stack-no-clear 'vector)))
      (set! (-> v1-1 quad) (-> this starting-pos quad))
      (set! arg2 v1-1)
      )
    )
  (when (not arg3)
    (let ((v1-4 (new 'stack-no-clear 'vector)))
      (set! (-> v1-4 quad) (-> this root transv quad))
      (set! arg3 v1-4)
      )
    )
  (if (not arg4)
      (-> this spawn-time)
      )
  (set! (-> arg0 quad) (-> arg2 quad))
  (let ((v0-0 arg1))
    (set! (-> v0-0 quad) (-> arg3 quad))
    v0-0
    )
  )

;; definition for method 62 of type mine-a
(defmethod mine-a-method-62 ((this mine-a))
  (let ((s4-0 -4194305)
        (s5-0 (new 'process 'collide-shape this (collide-list-enum usually-hit-by-player)))
        )
    (set! (-> s5-0 penetrate-using) (the-as penetrate -1))
    (set! (-> s5-0 penetrated-by) (the-as penetrate s4-0))
    (let ((v1-3 (new 'process 'collide-shape-prim-sphere s5-0 (the-as uint 0))))
      (set! (-> v1-3 prim-core collide-as) (collide-spec obstacle))
      (set-vector! (-> v1-3 local-sphere) 0.0 0.0 0.0 24576.0)
      (set! (-> s5-0 total-prims) (the-as uint 1))
      (set! (-> s5-0 root-prim) v1-3)
      )
    (set! (-> s5-0 nav-radius) (* 0.75 (-> s5-0 root-prim local-sphere w)))
    (let ((v1-6 (-> s5-0 root-prim)))
      (set! (-> s5-0 backup-collide-as) (-> v1-6 prim-core collide-as))
      (set! (-> s5-0 backup-collide-with) (-> v1-6 prim-core collide-with))
      )
    (set! (-> s5-0 event-self) 'touched)
    (set! (-> this root) s5-0)
    )
  (initialize-skeleton
    this
    (the-as skeleton-group (art-group-get-by-name *level* "skel-mine-a" (the-as (pointer level) #f)))
    (the-as pair 0)
    )
  (set! (-> this warning) (new 'process 'warning-hud-icon))
  (set! (-> this part) (create-launch-control (-> *part-group-id-table* 253) this))
  (cond
    ((>= (-> *attackable-hash* length) (-> *attackable-hash* allocated-length))
     (format 0 "Attackable hash has been overfilled. Tell Elan.~%")
     (break!)
     0
     )
    (else
      (let ((s5-2 (-> *attackable-hash* length)))
        (+! (-> *attackable-hash* length) 1)
        (set! (-> *attackable-hash* procs s5-2) (ppointer->handle (process->ppointer this)))
        (set! (-> *attackable-hash* trans s5-2 quad) (-> (get-trans this 3) quad))
        (set! (-> *attackable-hash* masks s5-2) (process-focusable-method-50 this))
        )
      )
    )
  (none)
  )

