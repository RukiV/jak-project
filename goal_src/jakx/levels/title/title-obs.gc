;; dgos: ENGINE, GAME

;; DECOMP BEGINS

;;-*-Lisp-*-
(in-package goal)

;; definition of type title-control
(deftype title-control (process)
  ((buffer     external-art-buffer  2)
   (want       int32                2)
   (want-name  string               2)
   (have       int32                2)
   (draw       int32)
   (draw-name  string)
   (active     symbol)
   )
  (:state-methods
    startup
    )
  (:methods
    (title-control-method-16 () none)
    (title-control-method-17 () none)
    )
  (:state-methods
    scrap-book
    control-spec
    splash-screen
    thx-dolby
    )
  )

;; og:preserve-this: not decoder output. title-control-init (below) sets
;; this symbol but goalc has no other declaration of it anywhere in
;; goal_src -- jakx's own build never emitted one because title-control-init
;; was stubbed out (raw ERROR comment, no body) until this lane landed it.
;; jak3's own title-obs.gc twin declares the identical singleton
;; (goal_src/jak3/levels/title/title-obs.gc:9) as `(pointer title-control)`
;; right after its own deftype; jakx's decoded (set! *title-control* (the-as
;; title-control (process->ppointer self))) casts to bare title-control
;; rather than a pointer type, so the extern here matches that cast instead
;; of jak3's declared type, following the *target*/*camera* convention this
;; file's own all-types.gc citation already names.
(define-extern *title-control* title-control)

;; menu-road rung 3 (issue 699): lobby-start's own real defun lands in
;; lobby-menu-manager.gc, which compiles after this file in DGO build
;; order; forward-declared here so (enter target-title)'s own newly-armed
;; call resolves ahead of that later landing.
(define-extern lobby-start (function int))

;; og:preserve-this menu-road rung 3 round 8 (issue 699): lever for the
;; (lobby-start) call armed below. lobby-start's own chain reaches
;; base-menu-init-by-other, which lives in engine/ui/menu2.gc; that object
;; is landed and compiles but its own game.gd row was never added (the
;; widget-engine landing rung, queued separately, has to clean menu2.gc's
;; 107 raw gpr->fpr decompiler artifacts first, see menu2.gc's own header
;; history). Until that lands, the base-menu process spawns with a null
;; init function and the enriched trap in run-function-in-process halts
;; the boot on purpose (the menuboot3 evidence line: "attempting to run
;; nullptr function! in process base-menu ... all five spawn sites pass
;; base-menu-init-by-other, which no landed object in any built DGO
;; defines"). Flip this to #t only once menu2.o has a row in game.gd.
;;
;; og:preserve-this retirement (issue 699, retail boot road): menu2.o now has a
;; row (game.gd:570) with a real base-menu-init-by-other (menu2-installs.gc:694,
;; menu2-installs.o at game.gd:398), so this lever's own stated retirement
;; condition is met and it flips to #t here. The call site below no longer
;; relies on this lever alone: the owner (issue 699 comment 23661) demanded a
;; menu2 residency guard on the (lobby-start) call before any merge, since the
;; want driver can evict menu2 out from under a call that assumes it stays
;; resident. That guard is the real gate now; this lever stays live only as a
;; kill switch for a session that wants the old og-stub boot back without
;; touching the residency guard itself. Retires for real once the whole
;; menu-road ladder is proven and every caller trusts residency alone.
(define *jakx-menu-road-armed* #t)

;; definition for method 3 of type title-control
(defmethod inspect ((this title-control))
  (when (not this)
    (set! this this)
    (goto cfg-7)
    )
  (let ((t9-0 (method-of-type process inspect)))
    (t9-0 this)
    )
  (format #t "~2Tbuffer[2] @ #x~X~%" (-> this buffer))
  (dotimes (s5-0 2)
    (format #t "~T  [~D]~2Tbuffer: ~A~%" s5-0 (-> this buffer s5-0))
    )
  (format #t "~2Twant[2] @ #x~X~%" (-> this want))
  (format #t "~2Twant-name[2] @ #x~X~%" (-> this want-name))
  (format #t "~2Thave[2] @ #x~X~%" (-> this have))
  (format #t "~2Tdraw: ~D~%" (-> this draw))
  (format #t "~2Tdraw-name: ~A~%" (-> this draw-name))
  (format #t "~2Tactive: ~A~%" (-> this active))
  (label cfg-7)
  this
  )

;; definition for method 7 of type title-control
;; WARN: Return type mismatch process vs title-control.
(defmethod relocate ((this title-control) (offset int))
  (dotimes (v1-0 2)
    (if (nonzero? (-> this buffer v1-0))
        (&+! (-> this buffer v1-0) offset)
        )
    )
  (the-as title-control ((method-of-type process relocate) this offset))
  )

;; definition for method 10 of type title-control
(defmethod deactivate ((this title-control))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (dotimes (s5-0 2)
    (set-pending-file (-> this buffer s5-0) (the-as string #f) -1 (the-as handle #f) 100000000.0)
    )
  (dotimes (s5-1 2)
    (update (-> this buffer s5-1))
    )
  ((method-of-type process deactivate) this)
  (none)
  )

;; definition for function title-control-init
;; og:preserve-this: arg0 (symbol) was re-derived by this lane, not decoded
;; as-is. The retail body reads a0 at function entry before any call
;; clobbers it (the decompiler's raw trace: "or gp, a0, r0" as instruction
;; 0), and title-control-spawn (below) forwards its own arg0 into this
;; function's a0 via run-function-in-process's extra-arg slot -- a genuine
;; caller-supplied mode selector, not an unset-register residual like this
;; file's own target-title :enter. The pre-authored all-types.gc extern
;; declared zero args; retyping it to (function symbol object :behavior
;; title-control) is what let this body convert. Also fixed in the same
;; change: anonymous_function_types.jsonc's title-obs index 30 (the
;; external-art-buffer init-heap callback below) was typed (function object
;; object), a placeholder too generic for its own `(+ a0 28)` field access
;; to type-prop; retyped to (function external-art-buffer object), matching
;; external-art-buffer's own declared init-heap field type. Together these
;; two config fixes are what unparked this function and title-control-spawn
;; from decompiler/config/jakx/ntsc_v1/hacks.jsonc's asm_functions_by_name
;; list; see that file's own comment for the full account.
(defbehavior title-control-init title-control ((arg0 symbol))
  (stack-size-set! (-> self main-thread) 2048)
  (logclear! (-> self mask) (process-mask freeze pause menu progress actor-pause))
  (setting-control-method-15 *setting-control* self 'allow-pause #f 0 0)
  (setting-control-method-15 *setting-control* self 'allow-progress #f 0 0)
  (setting-control-method-15 *setting-control* self 'allow-timeout #f 0 0)
  (setting-control-method-15 *setting-control* self 'allow-error #f 0 0)
  (setting-control-method-23 *setting-control*)
  (dotimes (s5-0 2)
    (set! (-> self buffer s5-0) (new
                                  'process
                                  'external-art-buffer
                                  s5-0
                                  (lambda ((arg0 external-art-buffer))
                                    (let ((gp-0 (-> arg0 heap)))
                                      (set! (-> gp-0 base) (dma-get-named-buffer 'title-control 0 0))
                                      (set! (-> gp-0 current) (-> gp-0 base))
                                      (set! (-> gp-0 top-base) (&+ (-> gp-0 base) #xd0000))
                                      (set! (-> gp-0 top) (-> gp-0 top-base))
                                      )
                                    0
                                    )
                                  #f
                                  )
          )
    )
  (dotimes (v1-19 2)
    (set! (-> self want v1-19) -1)
    (set! (-> self have v1-19) -1)
    )
  (set! (-> self draw) -1)
  (set! (-> self active) #f)
  (set! *title-control* (the-as title-control (process->ppointer self)))
  (set! (-> *game-info* controller 0) (process->handle self))
  (cond
    ((= arg0 #t)
     (go-virtual splash-screen)
     )
    ((= arg0 #f)
     (go-virtual control-spec)
     )
    ((= arg0 'thx-dolby)
     (go-virtual thx-dolby)
     )
    ((= arg0 'scrap-book1)
     enter-state
     1
     (go-virtual scrap-book)
     )
    ((= arg0 'scrap-book2)
     enter-state
     2
     (go-virtual scrap-book)
     )
    ((= arg0 'scrap-book3)
     enter-state
     3
     (go-virtual scrap-book)
     )
    )
  )

;; definition for function title-control-spawn
;; WARN: Return type mismatch int vs object.
(defbehavior title-control-spawn title-control ((arg0 symbol))
  (kill-by-type title-control *active-pool*)
  (ppointer->handle (process-spawn
                      title-control
                      :init title-control-init
                      arg0
                      :name "title-control"
                      :to *entity-pool*
                      :stack-size 4096
                      )
                    )
  )

;; definition for function title-screen-change
(defbehavior title-screen-change title-control ((arg0 string) (arg1 int) (arg2 string) (arg3 int) (arg4 symbol) (arg5 symbol))
  (when arg5
    (let ((s1-0 (the-as int (-> *setting-control* user-current language))))
      0
      (if (and (= (the-as language-enum s1-0) (language-enum english)) (= (scf-get-territory) 1))
          (set! s1-0 11)
          )
      (let ((v1-6 (cond
                    ((zero? s1-0)
                     0
                     )
                    ((= s1-0 1)
                     1
                     )
                    ((= s1-0 2)
                     2
                     )
                    ((= s1-0 3)
                     3
                     )
                    ((= s1-0 4)
                     4
                     )
                    ((= s1-0 11)
                     5
                     )
                    (else
                      0
                      )
                    )
                  )
            )
        (if (>= arg1 0)
            (+! arg1 (* 3 v1-6))
            )
        (if (>= arg3 0)
            (+! arg3 (* 3 v1-6))
            )
        )
      )
    )
  (set! (-> self want-name 0) arg0)
  (set! (-> self want 0) arg1)
  (set! (-> self want-name 1) (-> self draw-name))
  (set! (-> self want 1) (-> self draw))
  (when arg4
    (setting-control-method-15 *setting-control* self 'bg-a 'abs #x3f800000 0)
    (set! (-> *setting-control* user-current bg-a) 1.0)
    (set-blackout-frames 0)
    (setting-control-method-23 *setting-control*)
    )
  (when (>= (-> self draw) 0)
    (setting-control-method-15 *setting-control* self 'bg-a 'abs #x3f800000 0)
    (setting-control-method-23 *setting-control*)
    (while (!= (-> *setting-control* user-current bg-a) 1.0)
      (suspend)
      )
    )
  (set! (-> self draw) arg1)
  (set! (-> self draw-name) arg0)
  (set! (-> self active) #f)
  (while (and (>= (-> self draw) 0) (not (-> self active)))
    (suspend)
    )
  (setting-control-method-16 *setting-control* self 'bg-a)
  (set! (-> self want-name 1) arg2)
  (set! (-> self want 1) arg3)
  0
  )

;; failed to figure out what this is:
(defstate startup (title-control)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('scrap-book)
       enter-state
       (-> block param 0)
       (go-virtual scrap-book)
       )
      (('control-spec)
       enter-state
       (-> block param 0)
       (go-virtual control-spec)
       )
      )
    )
  :exit (behavior ()
    (when (not (and (-> self next-state)
                    (let ((v1-3 (-> self next-state name)))
                      (or (= v1-3 'startup) (= v1-3 'wait) (= v1-3 'idle) (= v1-3 'scrap-book) (= v1-3 'control-spec))
                      )
                    )
               )
      (screen-filter-method-11 *screen-filter*)
      (send-event (ppointer->process (-> *setting-control* user-current movie)) 'abort)
      )
    )
  :code sleep-code
  ;; og:preserve-this: the retail :post handler decoded as a raw label
  ;; (L140) because the decompiler could not resolve the winning
  ;; external-art-buffer's type across the find-loop's break/fallthrough
  ;; merge ("Could not figure out load: (set! v1 (l.wu (+ gp 96)))"); two
  ;; decompiler/config/jakx/ntsc_v1/type_casts.jsonc casts on (post startup
  ;; title-control) (ops 151 and 225, both "gp" to external-art-buffer)
  ;; unparked it. Shape matches jak3's own twin body's (and gp-4 (-> gp-4
  ;; art-group)) guard (goal_src/jak3/levels/title/title-obs.gc), used only
  ;; as the reading key rather than a transplant source: jakx's own bytes
  ;; compute the draw-sprite2d-xy rect from *viewport-array* rather than
  ;; jak3's hardcoded -208/416, and pass bucket785 rather than jak3's
  ;; bucket789. arg5 to draw-raw-image below is (-> self level) -- process's
  ;; own inherited field (all-types.gc process :offset-assert 68), not a
  ;; field title-control declares itself. jakx's title-control is leaner
  ;; than jak3's (no level/logo/sprites/selected fields of its own), but
  ;; this function never reads any of those; it only touches the shared
  ;; buffer/want/have/draw/draw-name/active fields plus the inherited
  ;; level.
  ;;
  ;; SAFETY, not armed by this change: title-control's two art heaps come
  ;; from (dma-get-named-buffer 'title-control 0 0) (lobby-dma.gc:337),
  ;; which returns (the-as pointer #f) on a miss. Spawning title-control
  ;; without a prior (dma-try-alloc #xd2800 #xd2800 'title-control 0 ...)
  ;; puts both heaps at the #f symbol's address with a #xd0000 extent -- a
  ;; symbol-table overwrite, the same defect class this file's own
  ;; *end-credits-proc* comment documents for a store through a #f-typed
  ;; cell (title-obs.gc:958-966). This landing does not spawn
  ;; title-control or change when it spawns; it only wires the :post that
  ;; was previously omitted, so the arming requirement above is a
  ;; precondition for the boot probe that exercises this code, not a claim
  ;; that arming happened here.
  :post (behavior ()
    (local-vars (gp-4 external-art-buffer))
    (dotimes (v1-0 2)
      (set! (-> self buffer v1-0 frame-lock) #f)
      (set! (-> self have v1-0) -1)
      )
    (dotimes (gp-0 2)
      (let ((s5-0 (-> self want gp-0))
            (s4-0 (-> self want-name gp-0))
            )
        (when (>= s5-0 0)
          (dotimes (s3-0 2)
            (case (file-status (-> self buffer s3-0) s4-0 s5-0)
              (('locked 'active)
               (set! (-> self buffer s3-0 frame-lock) #t)
               (set! (-> self have gp-0) s3-0)
               )
              )
            )
          )
        )
      )
    (dotimes (gp-1 2)
      (let ((a2-1 (-> self want gp-1))
            (a1-4 (-> self want-name gp-1))
            )
        (when (and (>= a2-1 0) (< (-> self have gp-1) 0))
          (dotimes (v1-30 2)
            (when (not (-> self buffer v1-30 frame-lock))
              (set-pending-file (-> self buffer v1-30) a1-4 a2-1 (process->handle self) -1.0)
              (goto cfg-33)
              )
            )
          )
        )
      (label cfg-33)
      )
    (dotimes (gp-2 2)
      (update (-> self buffer gp-2))
      )
    (set! (-> self active) #f)
    (when (>= (-> self draw) 0)
      (dotimes (gp-3 2)
        (when (file-status (-> self buffer gp-3) (-> self draw-name) (-> self draw))
          (set! gp-4 (-> self buffer gp-3))
          (goto cfg-46)
          )
        )
      (set! gp-4 (the-as external-art-buffer #f))
      (label cfg-46)
      (when (and gp-4 (-> gp-4 art-group))
        (with-dma-buffer-add-bucket ((s4-1 (-> *display* frames (-> *display* on-screen) global-buf))
                                     (bucket-id bucket785)
                                     )
          (dma-buffer-add-gs-set s4-1
                                 (test-1 (new 'static 'gs-test :ate #x1 :afail #x3 :zte #x1 :ztst (gs-ztest always)))
                                 )
          (let ((t1-0 (shl #x8000 16)))
            (draw-sprite2d-xy
              s4-1
              -256
              (- (-> *viewport-array* default screen-hy))
              512
              (-> *viewport-array* default screen-sy)
              (the-as rgba t1-0)
              #x3fffff
              )
            )
          )
        (let ((t9-6 draw-raw-image)
              (a0-31 *blit-displays-work*)
              (a1-15 785)
              (a2-5 (-> gp-4 art-group))
              (a3-7 (new 'static 'vector :data (new 'static 'array float 4 512.0 416.0 0.0 1.0)))
              (t0-2 (new 'stack-no-clear 'vector))
              )
          (set! (-> t0-2 x) (-> *video-params* relative-x-scale))
          (set! (-> t0-2 y) 1.0)
          (set! (-> t0-2 z) 0.0)
          (set! (-> t0-2 w) 1.0)
          (t9-6 a0-31 (the-as bucket-id a1-15) a2-5 a3-7 t0-2 (-> self level) 8)
          )
        (set! (-> self active) #t)
        )
      )
    )
  )

;; definition for function title-progress
(defun title-progress ((arg0 symbol))
  (with-pp
    (screen-filter-method-10
      *screen-filter*
      (new 'static 'vector :data (new 'static 'array float 4 0.0 0.0 0.0 128.0))
      (new 'static 'vector :data (new 'static 'array float 4 0.0 0.0 0.0 128.0))
      (seconds-per-frame)
      (bucket-id bucket789)
      #x3fffff
      #x33001
      (the-as symbol 0)
      )
    (setting-control-method-15 *setting-control* pp 'allow-progress #t 0 0)
    (setting-control-method-23 *setting-control*)
    (setting-control-method-15 *setting-control* pp 'allow-progress #f 0 0)
    (dotimes (gp-0 5)
      (suspend)
      )
    (screen-filter-method-11 *screen-filter*)
    (setting-control-method-16 *setting-control* pp 'allow-error)
    (setting-control-method-15 *setting-control* pp 'allow-error #f 0 0)
    (setting-control-method-23 *setting-control*)
    (set-blackout-frames (seconds 0.2))
    0
    )
  )

;; definition for function title-fade-out
(defun title-fade-out ((arg0 float))
  (screen-filter-method-10
    *screen-filter*
    (new 'static 'vector)
    (new 'static 'vector :data (new 'static 'array float 4 0.0 0.0 0.0 128.0))
    arg0
    (bucket-id bucket789)
    #x3fffff
    #x33001
    (the-as symbol 0)
    )
  (suspend-for (seconds 0.4)
    )
  (send-event (ppointer->process (-> *setting-control* user-current movie)) 'abort)
  (set! (-> *setting-control* user-current bg-a) 0.0)
  (while (or (-> *setting-control* user-current movie)
             (not (view-get-active-target))
             (not (and (-> (view-get-active-target) next-state) (= (-> (view-get-active-target) next-state name) 'target-title))
                  )
             (!= (-> *setting-control* user-current bg-a) 0.0)
             )
    (suspend)
    )
  (set! (-> *game-info* blackout-time) (the-as uint 0))
  (set! (-> *setting-control* user-current bg-a-force) 0.0)
  (screen-filter-method-11 *screen-filter*)
  0
  )

;; definition for function direction-press
(defun direction-press ((arg0 time-frame) (arg1 time-frame) (arg2 symbol))
  (let ((s2-0 (current-time))
        (s3-0 #f)
        )
    (while (not (or (time-elapsed? s2-0 arg1) (and (time-elapsed? s2-0 arg0) s3-0)))
      (if (cpad-pressed? 0 r1 confirm)
          (set! s3-0 'forward)
          )
      (if (cpad-pressed? 0 l1)
          (set! s3-0 'back)
          )
      (when (and arg2 (cpad-pressed? 0 triangle))
        (set! s3-0 'abort)
        (goto cfg-19)
        )
      (suspend)
      )
    (label cfg-19)
    s3-0
    )
  )

