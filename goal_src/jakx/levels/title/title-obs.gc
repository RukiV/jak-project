;; failed to figure out what this is:
(defstate scrap-book (title-control)
  :virtual #t
  :event (-> (method-of-type title-control startup) event)
  :enter (-> (method-of-type title-control startup) enter)
  :exit (-> (method-of-type title-control startup) exit)
  :code (behavior ()
    ;; og:preserve-this compile-only substitution: the decompiler left the
    ;; branch selector as a bare none-typed local (a0-0) it could not trace
    ;; to a source (title-control has no param field, ruling out a state
    ;; entry-arg reading). The sibling control-spec state immediately below
    ;; does the same three-way language-tier selection explicitly off
    ;; (-> *setting-control* user-current language), so this reads the
    ;; same source.
    (set-blackout-frames (seconds 1000))
    (let ((gp-1 (cond
                  ((= (the-as int (-> *setting-control* user-current language)) 3)
                   *scrap-book-3*
                   )
                  ((= (the-as int (-> *setting-control* user-current language)) 2)
                   *scrap-book-2*
                   )
                  (else
                    *scrap-book-1*
                    )
                  )
                )
          (s3-0 0)
          )
      0
      (let ((s5-0 (length gp-1))
            (s4-0 s3-0)
            )
        (+ s3-0 1)
        (let ((v1-5 #f))
          (while (not (or (>= s4-0 s5-0) (= v1-5 'abort)))
            ;; og:preserve-this compile-only substitution: l.h is a raw
            ;; MIPS-style halfword load with no goalc primitive of that
            ;; name (every other l.h reference landed anywhere in this
            ;; corpus is a dead comment, never live code); rewritten as a
            ;; pointer dereference over the identical byte address the
            ;; retail code computes.
