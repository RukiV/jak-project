;; definition for function check-language
;; WARN: Found some very strange gotos. Check result carefully, this is not well tested.
;; WARN: Return type mismatch int vs object.
;; WARN: new jak 2 until loop case, check carefully
(defun check-language ()
  (label cfg-0)
  (let ((gp-0 (new 'stack-no-clear 'mc-slot-info)))
    (mc-get-slot-info 0 gp-0)
    (when (zero? (-> gp-0 known))
      (set-blackout-frames (seconds 0.05))
      (suspend)
      (goto cfg-0)
      )
    (set! (-> *setting-control* user-default bg-a) 0.0)
    (when (and (= (scf-get-territory) 1) (zero? (scf-get-language)))
      (cond
        ((or (zero? (-> gp-0 handle)) (zero? (-> gp-0 formatted)) (zero? (-> gp-0 inited)) (< (-> gp-0 last-file) 0))
         (set-blackout-frames 0)
         (let ((s5-2 0)
               (gp-1 11)
               )
           (until #f
             (when (cpad-pressed? 0 left)
               (+! s5-2 -1)
               (if (< s5-2 0)
                   (set! s5-2 6)
                   )
               )
             (when (cpad-pressed? 0 right)
               (+! s5-2 1)
               (if (< 6 s5-2)
                   (set! s5-2 0)
                   )
               )
             (if (cpad-pressed? 0 x)
                 (goto cfg-25)
                 )
             (draw-language-select)
             (suspend)
             )
           #f
           (label cfg-25)
           (cond
             ((zero? s5-2)
              (set! gp-1 0)
              )
             ((= s5-2 1)
              (set! gp-1 1)
              )
             ((= s5-2 2)
              (set! gp-1 2)
              )
             ((= s5-2 3)
              (set! gp-1 3)
              )
             ((= s5-2 4)
              (set! gp-1 4)
              )
             ((= s5-2 5)
              (set! gp-1 8)
              )
             ((= s5-2 6)
              (set! gp-1 9)
              )
             )
           (set! (-> *setting-control* user-default language) (the-as language-enum gp-1))
           (set! (-> *setting-control* user-default subtitle-language) (the-as uint gp-1))
           (when (< (the-as uint gp-1) (the-as uint 5))
             (set! (-> *setting-control* user-default audio-language) (the-as uint gp-1))
             gp-1
             )
           )
         )
        (else
          (let ((v1-58 (-> gp-0 file (-> gp-0 last-file) language)))
            (when (and (>= v1-58 0) (< v1-58 (the-as uint 11)))
              (set! (-> *setting-control* user-default language) (the-as language-enum v1-58))
              (set! (-> *setting-control* user-default subtitle-language) v1-58)
              (when (< v1-58 (the-as uint 5))
                (set! (-> *setting-control* user-default audio-language) v1-58)
                (the-as int v1-58)
                )
              )
            )
          )
        )
      )
    )
  )

;; failed to figure out what this is:
(defstate target-title (target)
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('change-mode)
       (case (-> block param 0)
         (('grab)
          (if (not (-> block param 1))
              #t
              (go target-float)
              )
          )
         )
       )
      (else
        (target-generic-event-handler proc argc message block)
        )
      )
    )
  ;; og:preserve-this: the retail :enter handler decoded as a raw label (L40)
  ;; because the decompiler could not previously resolve its trailing call
  ;; through lobby-start; landed here now that lobby rung 2 (af786d70a)
  ;; derived lobby-start's own signature from its register usage, letting the
  ;; label resolve into a normal behavior body matching this file's own
  ;; target-intro :enter (below) almost verbatim. Decodes clean at
  ;; test/decompiler/reference/jakx/levels/title/title-obs_REF.gc:693-718,
  ;; regenerated from the decompiler's own fresh output in that same commit.
  ;;
  ;; The trailing (lobby-start) call was stubbed at landing time: lobby-start
  ;; had no defun anywhere and its own body process-spawns lobby-menu-manager
  ;; via lobby-menu-manager-init-by-other, itself undefined, the zero-vtable-
  ;; slot/nullptr-function crash class jakx-build-toolchain-quirks #5d named
  ;; for vehicle-manager-start. Both claims are stale as of menu-road rung 2
  ;; (issue 699): lobby-menu-manager.gc now lands lobby-start and lobby-menu-
  ;; manager-init-by-other for real, so this rung arms the call for real too.
  ;;
  ;; a0-0 (declared (local-vars (a0-0 none)) by the decompiler, read in the
  ;; (when a0-0 ...) block below) is a genuine register-not-set residual, not
  ;; a hidden argument like set-continue!'s a3: the corpus's one call site,
  ;; target-death.gc's (go target-title), passes no argument at all (checked
  ;; against the full 758-object census, not just this tree's landed
  ;; callers), unlike jak3's own target-title :enter, which declares an
  ;; explicit arg0 and whose callers pass #t/#f. Transcribed otherwise
  ;; verbatim per the decoded form; retyped none to object (the same
  ;; already-landed fix credits-obs.gc:555 applies to the identical
  ;; none-in-a-condition shape) since goalc rejects a none-typed variable in
  ;; a condition outright: "Cannot use none-typed variable in a condition."
  ;; The branch still reads whatever the prior call left in a0, matching
  ;; retail rather than inventing an argument the corpus disproves.
  :enter (behavior ()
    (local-vars (a0-0 object))
    (let ((a0-1 (-> *hud-engine* alive-list next0)))
      *hud-engine*
      (let ((s5-0 (-> a0-1 next0)))
        (while (!= a0-1 (-> *hud-engine* alive-list-end))
          (deactivate ((method-of-type connection get-process) (the-as connection a0-1)))
          (set! a0-1 s5-0)
          *hud-engine*
          (set! s5-0 (-> s5-0 next0))
          )
        )
      )
    (when a0-0
      (let ((v1-13 (-> self mask))
            (a0-4 (-> *game-info* mode))
            )
        (set! (-> *game-info* mode) 'movie)
        (logior! (-> self mask) (process-mask no-kill))
        (set! (-> self mask) v1-13)
        (set! (-> *game-info* mode) a0-4)
        )
      (send-event (ppointer->process (-> *setting-control* user-current movie)) 'abort)
      )
    ;; og:preserve-this menu-road rung 3 round 8: gated by *jakx-menu-road-
    ;; armed* (see its own definition above) until menu2.o has a game.gd
    ;; row; #f here makes this identical to the pre-rung-3 og-stub boot.
    ;;
    ;; og:preserve-this residency guard (issue 699 comment 23661, owner-
    ;; demanded before merge): lobby-start's own chain reaches into menu2, but
    ;; the want driver can evict menu2 right after it was loaded (the
    ;; forge-proven crash class: a default boot streams menu2 in, then the
    ;; driver's own eviction pass discards it before the call, so lobby-start
    ;; would dispatch through a dangling symbol into a freed heap). Checked
    ;; the same level-status? shape jakx-boot-camera-placed's own residency
    ;; poll uses above (level.gc:8473-8474, level-get + status 'loaded or
    ;; 'active, not just level-get truthy since a level object can exist
    ;; mid-load): only call through when menu2 is actually resident, else log
    ;; one named line and skip the call instead of dispatching into a
    ;; discarded heap. Retires when the want driver either stops evicting
    ;; menu2 or menu2 gets pinned resident for the whole menu road.
    (when *jakx-menu-road-armed*
      (let ((menu2-lev (level-get *level* 'menu2)))
        (if (and menu2-lev (or (= (-> menu2-lev status) 'loaded) (= (-> menu2-lev status) 'active)))
            (lobby-start)
            (format 0 "lobby-start skipped: menu2 not resident~%")
            )
        )
      )
    )
  :exit (behavior ()
    '()
    )
  :code sleep-code
  :post post-memcard
  )

