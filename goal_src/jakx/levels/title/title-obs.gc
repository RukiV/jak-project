  ;; Every call here except fmv-player-run is landed: check-language
  ;; (this file), dma-try-alloc (lobby-dma.gc), title-control-spawn (this
  ;; file), search-process-tree (gkernel.gc), dma-release (lobby-dma.gc),
  ;; mc-get-slot-info (a C-kernel extern, kernel-defs.gc), kiosk? (main.gc),
  ;; auto-save-command (game-save.gc), and game-info-method-18 (game-info.gc,
  ;; already called with this exact "menu2-start" literal at
  ;; net-world.gc:789). The body plays the THX/Dolby logo sting via
  ;; title-control-spawn, then two movies back to back via fmv-player-run
  ;; ("thx" then "intro", both named entries in *m2v-info* above), then
  ;; dispatches a 'continue message carrying the resolved "menu2-start" or
  ;; "menu2-start-button" continue-point.
  ;;
  ;; fmv-player-run itself is the extern-no-defun class (fmv-player.gc's own
  ;; stub, issue 569/729): retail's fmv-player.o is confirmed by this rung's
  ;; own scoped decode to hold a real, substantial function (level/texture-
  ;; page lookups, aspect-ratio matrix setup, *fmv-work* writes) that runs out
  ;; of field-layout evidence almost immediately -- issue 569's own FMV-road
  ;; scope (no M2V decoder exists in any game for this format), not something
  ;; this rung invents. The call sites here are transcribed verbatim (retail-
  ;; faithful); the stubbed callee never sets *fmv-player*, so the two
  ;; (while *fmv-player* (suspend)) waits fall through immediately instead of
  ;; hanging -- the movies are skipped, not played, and the state proceeds
  ;; straight to its post-movie continue dispatch. Retires when issue 569
  ;; lands fmv-player-run's real body.
  :code (behavior ()
    (check-language)
    (until #f
      (let ((v1-0 (new 'stack-no-clear 'array 'pointer 2)))
        (when (dma-try-alloc #xd2800 #xd2800 'title-control 0 (&-> v1-0 0) (&-> v1-0 1) #f)
          (suspend)
          (suspend)
          (goto cfg-5)
          )
        )
      (suspend)
      0
      )
    #f
    (label cfg-5)
    (suspend)
    (suspend)
    (title-control-spawn 'thx-dolby)
    (while (search-process-tree
             *active-pool*
             (the-as
               (function process-tree object)
               (lambda ((arg0 object)) (= (l.wu (+ (the-as uint arg0) -4)) title-control))
               )
             )
      (suspend)
      )
    (dma-release 'title-control)
    (fmv-player-run "thx" *target-pool* #f)
    (while *fmv-player*
      (suspend)
      )
    (fmv-player-run "intro" *target-pool* #f)
    (while *fmv-player*
      (mc-get-slot-info 0 *progress-save-info*)
      (suspend)
      )
    (cond
      ((kiosk?)
       (cond
         ((= *game-mode* 'adventure)
          (set! *game-mode* #f)
          (let ((t9-9 auto-save-command)
                (a0-8 'restore)
                (a1-5 0)
                (a2-3 *profile-slot*)
                (t0-1 #f)
                )
            (t9-9 a0-8 a1-5 a2-3 self t0-1)
            )
          )
