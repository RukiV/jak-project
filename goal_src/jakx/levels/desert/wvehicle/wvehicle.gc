    (vector-matrix*! (-> gp-0 3) (-> gp-0 1) arg0)
    (draw-debug-line (-> gp-0 2) (-> gp-0 3) (bucket-id bucket785) arg4 #f (the-as rgba -1))
    (set! (-> gp-0 1 x) arg1)
    (set! (-> gp-0 1 y) arg2)
    (set! (-> gp-0 0 quad) (-> gp-0 1 quad))
    (set! (-> gp-0 0 y) (- (-> gp-0 0 y) arg3))
    (+! (-> gp-0 1 y) arg3)
    (vector-matrix*! (-> gp-0 2) (-> gp-0 0) arg0)
    (vector-matrix*! (-> gp-0 3) (-> gp-0 1) arg0)
    (draw-debug-line (-> gp-0 2) (-> gp-0 3) (bucket-id bucket785) arg4 #f (the-as rgba -1))
    )
  0
  (none)
  )

;; og:preserve-this wvehicle-core rung (held): (method 157 wvehicle)
;; decodes clean on its own but calls meters-per-sec->mph, whose real
;; signature this rung can prove (float float, the jak3 twin plus this
;; method's own call site) but whose implementation is not defined
;; anywhere in the jakx corpus; activating the extern without a landed
;; body is the AGENTS.md section 5 hazard (a symbol that is not landed
;; links as zero), so held alongside its own only unresolved callee rather
;; than landed on a zero-linking call. Overrides an inherited slot, so
;; holding it just leaves the ancestor's own default running. Parked in
;; hacks.jsonc's no_type_analysis_functions_by_name.

;; og:preserve-this wvehicle-core rung (held): vehicle-handle->net-player
;; reads a byte field at process+2116 no ancestor this rung can edit
;; declares (vehicle.gc is out of this rung's scope), plus one sllv
;; ppointer-chase-to-handle fold. cam-states.gc already calls it and gets
;; an unset symbol today (wvehicle.gc was a stub before this rung), so
;; holding it is not a regression, only an unclosed gap. Parked in
;; hacks.jsonc's no_type_analysis_functions_by_name.

;; definition for method 48 of type wvehicle
(defmethod process-drawable-method-48 ((this wvehicle))
  (if (and (nonzero? (-> this race racer-state)) (-> this race racer-state))
      (-> this race racer-state lap)
      (call-parent-method this)
      )
  )
