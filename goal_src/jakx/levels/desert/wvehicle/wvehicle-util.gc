;; DECOMP BEGINS

;; definition for method 225 of type wvehicle
;; WARN: Return type mismatch int vs none.
(defmethod wvehicle-method-225 ((this wvehicle))
  (set! (-> this idle-throttle) 0.0)
  0
  (none)
  )

;; og:preserve-this winit rung: rigid-body-object-method-68's own base
;; declaration ((_type_ object object), all-types.gc:48999) leaves arg0
;; and the process-drawable chain it wires up untyped; type_casts.jsonc
;; now casts arg0 to rigid-body-vehicle-constants (every offset it reads
;; matches that type's own engine/physics-model fields), the ppointer-
;; chase-to-handle fold in the wheel loop resolves the same way method
;; 220's own precedent above does (process-drawable at the offset-184/
;; declared-188 root field), and stack_structures.jsonc adds the two
;; scratch buffers (sp+16 a plain vector for the per-wheel root-scale
;; write, sp+32 two contiguous vectors for the max-rpm quadratic). The
;; four wheel-info stores at the top duplicate method 213's own
;; wheel-spawn-null hoist (wvehicle-physics.gc) rather than replacing it:
;; that hoist runs once, before this method is ever called with real
;; constants, so removing it would leave the first spawn unwired again.
;; Landing both leaves the redundancy in place for a follow-up to fold,
;; per this rung's own call; retire this note alongside that hoist's own
;; if a later rung consolidates them. Method 225 above is landed here too
;; only because this method's own suspension-geometry tail calls it
;; directly and it had no defmethod anywhere in the tree (e2 clearance);
;; its own body is a two-line, zero-hazard idle-throttle reset with no
;; wall of its own.
;; og:preserve-this handleinit rung (falcon attempt-5 crash): partial landing
;; of retail's (method 64 wvehicle), wheel-handle arming only. wvehicle
;; currently has no method-64 slot of its own, so the vtable resolves
;; straight to vehicle's own landed shadow partial (vehicle.gc:252, #633)
;; and on to rigid-body-object's base method 64, whose body virtually
;; dispatches (method 68 wvehicle) below over this instance's wheel array.
;; That per-wheel loop (this file, line 57 below) reads each wheel's
;; `handle` field and passes it through the l32-false-check nonzero gate
;; (goal-symbol-slots-are-32-bit class) before dereferencing it at line 59;
;; with no arming, the field holds process-heap garbage that survives the
;; gate and faults on `(-> a2-2 process)`.
;;
;; Retail's own wvehicle:64 (scoped decode, C:\Users\alex\AppData\Local\
;; Temp\claude\D--jak-project\1cf767c4-bde0-470a-8f68-8f6160452efd\
;; scratchpad\vfr3-m64-wvehicle.asm) arms this before ever reaching that
;; dispatch: instructions [58]-[66] (asm lines 115-127) are a 4-iteration
;; loop over `a0-0 + 2476 + 288*i` (288 = vehicle-wheel-state's own
;; :size-assert #x120; machine base 2476 + 4 basic-bias = declared 2480,
;; matching `wheel vehicle-wheel-state 4 :inline :offset-assert 2480`)
;; storing #f at +8 (`handle`, wvehicle-h.gc:29, already handle-typed) and
;; +280 (`tread-tracker`, wvehicle-h.gc:61, declared uint64 with a "; handle"
;; comment -- not retyped this rung, armed via the established (the-as
;; uint64 (the-as handle #f)) idiom, game-info.gc:782-786 precedent). This
;; loop is instructions [58]-[66], strictly before retail's own single
;; call-parent-method dispatch at instructions [77]-[84] (asm lines 144-
;; 157), so the ordering this partial reproduces (arm both fields for all
;; four wheels, then call-parent-method) matches retail's.
;;
;; NOTE: an earlier read of the same scratch asm misidentified a *different*
;; 12-field #f-store block at declared offsets 4472-4568 (asm lines 558-
;; 728, the wpn-current-target/wpn-left/wpn-right/wpn-shield/wpn-drone/
;; wpn-oil/wpn-turbo/wpn-bulldog-gun/wpn-drawable-left/wpn-drawable-right
;; weapon-slot handles) as the crash's cause. Method 68's own landed body
;; below proves that block is unrelated -- it never touches any wpn-*
;; field, only `(-> this wheel i handle)` -- so it is left alone here;
;; those weapon-slot fields still want their own arming, but that is a
;; separate rung against a verified caller, not this crash.
;;
;; og:preserve-this wheelmirror rung (falcon collapsed-flat-wheels fix):
;; extends the partial above with retail's second per-wheel loop, asm ops
;; [115]-[201] (same scoped decode cited above, asm lines 193-319), landed
;; together with its drive-radius tail because avg-drive-wheel-radius
;; divides by the loop's own drive-wheel count -- landing the loop without
;; the tail would leave a divide-by-zero window open. Every offset below is
;; confirmed against wvehicle-h.gc's and vehicle-h.gc's own declared
;; asserts: vehicle-wheel-state and vehicle-wheel-info are both plain
;; `structure`s, so their fields need no +4 basic-bias past the wheel
;; array's own base (already +4'd, machine 2476 -> declared 2480, per the
;; note above); `this`/`root`/`rbody` do take the +4 (root machine 184 ->
;; declared 188, same as above); arg0 -- rigid-body-vehicle-constants,
;; itself `structure`-derived, not `basic` -- takes none, confirmed by
;; `transmission gear-count` (264 + 48 = 312) and `engine idle-rpm`
;; (208 + 12 = 220) landing at their compound declared offsets with zero
;; adjustment, matching the asm's raw 312/220 exactly.
;;
;; float2 is (vector-dot (-> this root transv) (-> this rbody matrix
;; fvec)); byte0/float0 are plain accumulator locals rather than a new
;; stack-struct type, per this rung's own brief -- this is a hand-authored
;; insertion against a fixed spec, not a fresh decompiler run, so there is
;; no struct-inference gap to fill. Per wheel: x-scale mirrors retail's own
;; parity (1.0 even, -1.0 odd, offset 204) -- the read side of
;; wvehicle-physics.gc:266's own `(* (-> s3-0 x-scale) (-> s3-0 info
;; x-scale))`, retail's mirrored-mesh method for wheels 1 and 3; surface
;; resets to #f (176); rev is float2 / (info radius * info scale) (200,
;; radius*scale materialized once as retail's own asm does, reused for the
;; drive-wheel accumulator below); the drive-wheel branch tests (-> info
;; flags) against literal 1 (bit 0) rather than a defenum -- jakx has none
;; for this field; inertia copies from info (188); probe-local-dir and
;; local-axis load from static (0.0 -1.0 0.0 1.0) (32) and (1.0 0.0 0.0
;; 1.0) (48), the same `vector-copy!` idiom jak3's own landed wvehicle.gc
;; (lines 882-883) uses for the identical retail construct. Ops [176]-[177]
;; (two "or a0, s7, r0" sets between the loop and the tail) write no memory
;; and are overwritten before any read; the same dead-set idiom already
;; appears, unlanded, at this function's own ops [32]-[33] and [67]-[68],
;; so they carry no source-level construct and are not transcribed.
;;
;; The tail computes avg-drive-wheel-radius (float0 / (the float byte0),
;; 2404) and wheel-rev (float2 / avg-drive-wheel-radius, 2364); the
;; (< 0.0 float2) branch sets gear-select and engine-rev for fidelity with
;; retail, dead at a standing spawn (float2 is a fore-aft dot product
;; against transv, which starts zero). jak3's own per-side
;; collision-mesh-index line, that game's equivalent wheel-loop addition,
;; does not exist in jakx's (method 213 wvehicle) and is not added here; x
;; is not negated in method 217 either.
;;
;; og:preserve-this wvehicle m64 remainder rung: lands every op range the
;; wheelmirror note above still called held -- [3]-[57] (particle-
;; subsampler seed loop), [67]-[76] (the flat 8-field #f/0 reset, not
;; actually a loop despite the earlier note's "4-iteration" guess: antenna,
;; fire-tracker, power-slide-hud, hang-time-hud, hang-time-sound-id, wheel-
;; fire-sound-id, oil-sound-id, sink-sound-id), [85]-[113] (control-hook,
;; clutch-grab, sound-engine-envelope, gear-select defaults, the wvehicle-
;; method-225 call, susp/jump/turbo/health 1.0 stores, rbody flags |=
;; 4128), [202]-[295] (underside-y/side-x extent from two root-prim child
;; samples plus the wheel-launcher/wheel-fire-launcher create-launch-
;; control spawn loop and the 16-slot attached-array reset), [296]-[365]
;; (eng-pitch-offset from player-id, vehicle-method-182, the wpn-* handle
;; resets), [366]-[377] (the v-drone type? gate), [378]-[458] (the two
;; gunmount-generic-drawable spawns for wpn-drawable-left/right), [488]-
;; [497] (dark-seeking-me), and [498]-[571] (turbo-suppressor-particle,
;; the local-space-info connection, and the final set-local-space-info
;; dispatch). Unblocking needed three fixes beyond the extern retype:
;; `turbo-suppressor-particle` was declared plain `basic` in both
;; wvehicle-h.gc and all-types.gc (a placeholder); retyped to
;; sparticle-launch-control in both (type-consistency requires both) once
;; the tail's own call resolved to method 20 of a 22-method type declaring
;; exactly `(set-local-space-info (_type_ particle-local-space-info)
;; none)` at that slot (all-types.gc:39435) -- an exact structural match,
;; not a guess. `root root-prim` (collide-shape's own field, offset-assert
;; 160) needed a type_casts.jsonc cast to collide-shape-prim-group for its
;; own offset-64 `child` field, the same cast every wcar's own (method 100
;; v-*) already uses (type_casts.jsonc:699, :1117, :3869+). The local-
;; space record from `(add-connection *part-local-space-engine* this
;; local-space-proc-joint 0 0 0)` needed a cast to particle-local-space-
;; info, proven by local-space-proc-joint's own declared signature
;; (`(function particle-local-space-info none)`, all-types.gc:43411) and
;; three other call sites in the corpus building the identical shape
;; (generic-obs.gc:1325-1334, football2.gc:1410-1419, wvehicle-weapons.gc:
;; 115) -- mat-prev/mat-new/hand/flags at offsets 32/96/160/168 match this
;; method's own writes exactly. All three fixes are cited in
;; stack_structures.jsonc, type_casts.jsonc and all-types.gc directly.
;;
;; Four spots build a `handle` from a raw process pointer via the compiled
;; sllv/dsll32/logior expansion of `(process->handle (ppointer->process
;; ...))` (gkernel-h.gc:440-466; the same nested-macro idiom PS2 Jak 2/3
;; and jakx alike use for `(process->handle (ppointer->process
;; (process-spawn ...)))`, e.g. jak3's scorpion-gun.gc:1187): both
;; gunmount-generic-drawable spawns (wpn-drawable-left/right) and, inside
;; the local-space block, `this` itself for the local-space record's own
;; `hand` field (computed twice in the raw decode -- a genuine retry: `(when
;; (not v1-91) (set! v1-91 ...))`, not a dead-set, so both computations are
;; transcribed). Two fields the raw decode still cannot resolve to a name
;; (declared 4472/4480, inside the 16-byte `pad-pre-wpn-current-target`
;; gap, wvehicle-h.gc:323) are stored via the same `(s.d! (&+ this N) #f)`
;; raw-offset idiom vehicle-util.gc:718 already uses elsewhere in this
;; tree, rather than inventing field names the decode does not show.
;; `wheel-launcher`/`wheel-fire-launcher` are declared `uint8 16` (already
;; flagged "captured UNKNOWN" above) but this method's own create-launch-
;; control spawn loop stores four sparticle-launch-control pointers into
;; each; retyping them is a follow-up's call, so the writes stay raw
;; `(s.w! (&+ this N) ...)` here too rather than retyping a field this
;; rung does not otherwise need to touch.
;;
;; Ops [0]-[2] (`(set! (-> this info) arg0)` in the raw decode) open the
;; method, before op [3]'s particle-subsampler loop; `info` is declared
;; rigid-body-vehicle-constants (vehicle's own :override of rigid-body-
;; object's field), so the cast to arg0 here matches every other arg0
;; read in this body (gear-select/engine-rev, the antenna hold's own pos
;; source). The raw decode's own fresh-compile of this exact line fails
;; without a cast ("Typecheck failed... got a 'object' when expecting a
;; 'rigid-body-vehicle-constants'"), the same skip_compile_functions
;; class documented on (method 220 wvehicle) above; test/offline/config/
;; jakx/config.jsonc gets a matching entry for this method.
;;
;; HELD: ops [459]-[487], the antenna spawn. vehicle-antenna-spawn (all-
;; types.gc) has no defun and no goal_src declaration anywhere in the
;; tree -- an e2 hazard (AGENTS.md section 5): landing the call links it to
;; zero and faults. The extern is retyped this rung to its proven
;; signature, `(function vehicle-antenna-init-params process)` (ops
;; [459]-[470] build a 32-byte vehicle-antenna-init-params on the stack:
;; pos from `(-> arg0 hardpoint antenna-attach)` :inline, tilt the
;; constant 0xC5638E39 == (degrees -20.0), vehicle self, skel #f, level
;; from `(-> this level)`; ops [476]-[487] are the same process->handle
;; idiom above on the call's return, stored to `antenna`, wvehicle-h.gc:
;; 215/machine offset 2148) so a future rung can land the call the moment
;; vehicle-antenna-spawn gets a body, without re-deriving the signature.
;; The block is self-contained: ops [67]-[76] above already arm `antenna`
;; to #f, and nothing later in this method or its known callers reads it
;; back, so holding the spawn leaves antenna permanently #f rather than
;; leaving a half-built struct or a dangling call.
;;
;; og:preserve-this: gunmount-drawable-init-by-other has a real defbehavior
;; (wvehicle-weapons.gc, landed rung 6, not the issue-376 no-defun class);
;; the forward declaration below exists only because wvehicle-weapons.gc
;; compiles after this file in the game's own build order, so the symbol
;; is not yet a known global when this method compiles. The type matches
;; its own defbehavior header exactly (pointer, int, object -> object,
;; bound to gunmount-drawable).
(define-extern gunmount-drawable-init-by-other (function pointer int object object :behavior gunmount-drawable))
(defmethod rigid-body-object-method-64 ((this wvehicle) (arg0 object))
  (set! (-> this info) (the-as rigid-body-vehicle-constants arg0))
  (dotimes (i 2)
    (let ((scale (if (logtest? (-> this flags) 1024)
                      1.0
                      0.5
                      )
                 )
          )
      (s.w! (&+ this (+ 4596 (* i 4)))
            (new 'process 'sparticle-subsampler *sp-particle-system-2d* (the uint 263) (* 2.0 scale) #t 0.0)
            )
      )
    )
  (set! (-> this flags) (logand (lognot 1024) (-> this flags)))
  (dotimes (i 4)
    (set! (-> this wheel i handle) (the-as handle #f))
    (set! (-> this wheel i tread-tracker) (the-as uint64 (the-as handle #f)))
    )
  (set! (-> this antenna) (the-as uint64 (the-as handle #f)))
  (set! (-> this fire-tracker) (the-as handle #f))
  (set! (-> this power-slide-hud) (the-as handle #f))
  (set! (-> this hang-time-hud) (the-as handle #f))
  (set! (-> this hang-time-sound-id) (the-as uint 0))
  (set! (-> this wheel-fire-sound-id) (the-as uint 0))
  (set! (-> this oil-sound-id) (the-as uint 0))
  (set! (-> this sink-sound-id) (the-as uint 0))
  (call-parent-method this arg0)
  (set! (-> this control-hook) #f)
  (set! (-> this clutch-grab) 0.0)
  (set! (-> this sound-engine-envelope) 1.0)
  (set! (-> this gear-select) 1)
  (wvehicle-method-225 this)
  (set! (-> this susp-spring-control) 1.0)
  (set! (-> this jump-control) 0.0)
  (set! (-> this turbo-ready) 1.0)
  (set! (-> this health-pickup-multiplier) 1.0)
  (set! (-> this rbody flags) (logior (-> this rbody flags) 4128))
  (let ((float2 (vector-dot (-> this root transv) (-> this rbody matrix fvec)))
        (byte0 0)
        (float0 0.0)
        )
    (dotimes (i 4)
      (let* ((wheel (-> this wheel i))
             (info (-> wheel info))
             (radius-scale (* (-> info radius) (-> info scale)))
             )
        (set! (-> wheel x-scale) (if (= (logand i 1) 1)
                                     -1.0
                                     1.0
                                     )
              )
        (set! (-> wheel surface) #f)
        (set! (-> wheel rev) (/ float2 radius-scale))
        (when (logtest? (-> info flags) 1)
          (+! byte0 1)
          (+! float0 radius-scale)
          (set! (-> wheel drive-diff) 1.0)
          )
        (set! (-> wheel inertia) (-> info inertia))
        (vector-copy! (-> wheel probe-local-dir) (new 'static 'vector :y -1.0 :w 1.0))
        (vector-copy! (-> wheel local-axis) (new 'static 'vector :x 1.0 :w 1.0))
        )
      )
    (set! (-> this avg-drive-wheel-radius) (/ float0 (the float byte0)))
    (set! (-> this wheel-rev) (/ float2 (-> this avg-drive-wheel-radius)))
    (when (< 0.0 float2)
      (set! (-> this gear-select) (+ (-> (the-as rigid-body-vehicle-constants arg0) transmission gear-count) -1))
      (set! (-> this engine-rev) (* 0.10471976 (-> (the-as rigid-body-vehicle-constants arg0) engine idle-rpm)))
      )
    )
  (let ((root-prim (the-as collide-shape-prim-group (-> this root root-prim)))
        (extent (new 'stack-no-clear 'inline-array 'vector 3))
        )
    (set! (-> extent 2 x) (the-as float #xff800000))
    (set! (-> extent 2 y) (the-as float #x7f800000))
    (set! (-> extent 2 z) (the-as float #xff800000))
    (set! (-> extent 2 w) (the-as float #x7f800000))
    (dotimes (i 2)
      (set! (-> extent 0 quad) (-> (the-as vector (&+ (-> root-prim child) (+ 44 (* i 160)))) quad))
      (set! (-> extent 1 x) (+ (-> extent 0 y) (* -0.75 (-> extent 0 w))))
      (set! (-> extent 1 y) (+ (-> extent 0 y) (* -0.25 (-> extent 0 w))))
      (set! (-> extent 2 x) (fmax (-> extent 2 x) (-> extent 1 x)))
      (set! (-> extent 2 y) (fmin (-> extent 2 y) (-> extent 1 y)))
      (set! (-> extent 1 z) (+ (-> extent 0 x) (* 0.25 (-> extent 0 w))))
      (set! (-> extent 1 w) (+ (-> extent 0 x) (* 0.75 (-> extent 0 w))))
      (set! (-> extent 2 z) (fmax (-> extent 2 z) (-> extent 1 z)))
      (set! (-> extent 2 w) (fmin (-> extent 2 w) (-> extent 1 w)))
      )
    (set! (-> this underside-y) (* 0.5 (+ (-> extent 2 x) (-> extent 2 y))))
    (set! (-> this side-x) (* 0.5 (+ (-> extent 2 z) (-> extent 2 w))))
    (dotimes (i 2)
      (let ((prim (the-as collide-shape-prim (&+ (-> root-prim child) (* i 80)))))
        (set! (-> prim specific 8) (the-as uint 1))
        (set! (-> prim specific 9) (the-as uint (+ i 2)))
        )
      )
    ;; og:preserve-this bring-up guard (falcon-spawn crash, gk-falcon-
    ;; repaint.err.log: wvehicle-util+0xccd, GOAL code [0x1232000,+0x1744),
    ;; "reading r15 minus 4" off rdi=0 -- a type-tag fetch on a null object
    ;; inside create-launch-control's own virtual method-9 dispatch). No
    ;; defpartgroup anywhere in the landed tree sets *part-group-id-table*
    ;; 226 or 227 (nor 273/280 below); retail's own ops call create-launch-
    ;; control on them unconditionally (this is not a missed branch to
    ;; restore), so this is the bring-up-absent-asset class rather than a
    ;; transcription gap, the same class generic-obs.gc's own bring-up-
    ;; guard note documents for the identical create-launch-control-on-an-
    ;; unset-table-entry hazard. Guard the table read, not the call's
    ;; result: an unset entry now leaves the launcher field #f instead of
    ;; dereferencing it.
    ;;
    ;; og:preserve-this: the guard is `(nonzero? entry)`, not a plain `(if
    ;; entry ...)` truthiness test. The marker round (m64-A..N, dropped
    ;; from this tree) proved the fault survived the first `if`-based
    ;; version of this same guard and stayed pinned at the dark-seeking-me
    ;; block below (*part-group-id-table* 280) even though this wheel-
    ;; launcher pair's own identical-looking guard never faulted -- the
    ;; difference is that 227/226 are genuinely populated (real pointers)
    ;; while 280 is not, and *part-group-id-table*'s own array slots are
    ;; zero-filled by their `boxed-array` allocation rather than armed
    ;; with the real `#f` symbol object. `if`/`when` truthiness compiles
    ;; to a compare against `#f`'s own (non-zero) address, the same class
    ;; goal-symbol-slots-are-32-bit's own memory documents ("zero handles
    ;; are truthy"): a raw-zero slot is not equal to `#f` and slips the
    ;; check straight into create-launch-control's own [-4] type-tag
    ;; fetch. `nonzero?` compares the raw integer value against 0 instead
    ;; and catches both representations; every table-entry guard in this
    ;; method uses it from here on.
    (dotimes (i 4)
      (let ((group-227 (-> *part-group-id-table* 227))
            (group-226 (-> *part-group-id-table* 226))
            )
        (s.w! (&+ this (+ 4604 (* i 4)))
              (if (nonzero? group-227) (create-launch-control group-227 this) (the-as sparticle-launch-control #f))
              )
        (s.w! (&+ this (+ 4620 (* i 4)))
              (if (nonzero? group-226) (create-launch-control group-226 this) (the-as sparticle-launch-control #f))
              )
        )
      )
    (dotimes (i 16)
      (set! (-> this attached-array i) (the-as handle #f))
      )
    (vector-reset! (-> this surface-velocity))
    )
  (let ((pid (-> this player-id)))
    (set! (-> this eng-pitch-offset)
          (* 0.041666668 (the float (if (and (>= pid 0) (< pid 16))
                                         (- pid)
                                         (+ pid -15)
                                         )
                                     )
             )
          )
    )
  (vehicle-method-182 this 1.0)
  (set! (-> this wpn-left) (the-as uint64 (the-as handle #f)))
  (set! (-> this wpn-right) (the-as handle #f))
  (set! (-> this wpn-shield) (the-as uint64 (the-as handle #f)))
  (set! (-> this wpn-drone) (the-as uint64 (the-as handle #f)))
  (set! (-> this wpn-oil) (the-as uint64 (the-as handle #f)))
  (set! (-> this wpn-turbo) (the-as uint64 (the-as handle #f)))
  (set! (-> this wpn-bulldog-gun) (the-as uint64 (the-as handle #f)))
  (set! (-> this prev-wpn-sync blob) 0)
  (s.d! (&+ this 4468) #f)
  (s.d! (&+ this 4476) #f)
  (set! (-> this wpn-drawable-left) (the-as handle #f))
  (set! (-> this wpn-drawable-right) (the-as handle #f))
  (when (not (type? this v-drone))
    (let ((proc (the-as process (get-process *default-dead-pool* gunmount-generic-drawable #x4000 1))))
      (when proc
        ((method-of-type gunmount-generic-drawable activate) (the-as gunmount-generic-drawable proc) *rigid-body-queue-manager* "gunmount-generic-drawable" (the-as pointer #x70004000))
        (run-function-in-process proc gunmount-drawable-init-by-other this 0 0 0 0 0)
        )
      (set! (-> this wpn-drawable-left) (process->handle (ppointer->process (-> proc ppointer))))
      )
    (let ((proc (the-as process (get-process *default-dead-pool* gunmount-generic-drawable #x4000 1))))
      (when proc
        ((method-of-type gunmount-generic-drawable activate) (the-as gunmount-generic-drawable proc) *rigid-body-queue-manager* "gunmount-generic-drawable" (the-as pointer #x70004000))
        (run-function-in-process proc gunmount-drawable-init-by-other this 1 1 0 0 0)
        )
      (set! (-> this wpn-drawable-right) (process->handle (ppointer->process (-> proc ppointer))))
      )
    ;; HELD: the antenna spawn (ops [459]-[487]). See this method's own
    ;; og:preserve-this note above for the e2 rationale and the proven
    ;; vehicle-antenna-init-params shape.
    )
  (set! (-> this wpn-current-target) (the-as uint64 (the-as handle #f)))
  ;; og:preserve-this bring-up guard: same class and same crash citation as
  ;; the wheel-launcher note above (*part-group-id-table* 280/273, neither
  ;; ever set by a landed defpartgroup), landing sequentially with only the
  ;; trivial dark-suck-sound-pending reset between them, so both need the
  ;; guard even though only one is reached first. gk-falcon-repaint.err.log
  ;; (wvehicle-util+0xccd) landed close enough to this pair to name it the
  ;; suspect at the time; gk-spawnguard.err.log and gk-spawnguard2.err.log,
  ;; taken after successive guard attempts, both stayed pinned at
  ;; +0xd04 -- the marker round (m64-A..N, dropped from this tree) proved
  ;; the fault sits in this exact dark-seeking-me block (A-H all printed,
  ;; I never did). The first `if group-280`-shaped guard here was not
  ;; wrong in principle but wrong in comparison: it tests the loaded entry
  ;; against the `#f` symbol object, and *part-group-id-table*'s own
  ;; unpopulated slots are zero-filled by their `boxed-array` allocation
  ;; rather than armed with that symbol, so a raw-zero (never-set) slot is
  ;; not equal to `#f` and slipped the check straight into create-launch-
  ;; control's own [-4] type-tag fetch -- the same "zero handles are
  ;; truthy" class goal-symbol-slots-are-32-bit's own memory documents.
  ;; 227/226 above never faulted only because both happen to already be
  ;; populated (real pointers) in this bring-up; 280 is not. `nonzero?`
  ;; compares the raw integer against 0 and catches both representations;
  ;; turbo-suppressor-particle below and the wheel-launcher pair above are
  ;; all switched to it together rather than leaving a guard that only
  ;; happens to work for whichever slots are populated today.
  (let ((group-280 (-> *part-group-id-table* 280)))
    (set! (-> this dark-seeking-me) (if (nonzero? group-280) (create-launch-control group-280 this) (the-as basic #f)))
    )
  (set! (-> this dark-suck-sound-pending) 0)
  (let ((group-273 (-> *part-group-id-table* 273)))
    (set! (-> this turbo-suppressor-particle) (if (nonzero? group-273) (create-launch-control group-273 this) (the-as sparticle-launch-control #f)))
    )
  (let ((local-space (the-as particle-local-space-info
                              (add-connection *part-local-space-engine* this local-space-proc-joint 0 0 0)
                              )
                      )
        )
    (if local-space
        (begin
          (let ((hand (process->handle (ppointer->process (-> this ppointer)))))
            (when (not hand)
              (set! hand (process->handle (ppointer->process (-> this ppointer))))
              )
            (set! (-> local-space hand) hand)
            )
          (matrix-identity! (-> local-space mat-new))
          (matrix-identity! (-> local-space mat-prev))
          (set! (-> local-space flags) (part-local-space-flags))
          )
        (begin
          (format 0 "out of local-space connections. ~A~%" this)
          (format *stdebug* "out of local-space connections. ~A~%" this)
          (set! local-space #f)
          )
        )
    ;; og:preserve-this bring-up guard: gk-spawnguard.err.log's own crash
    ;; (wvehicle-util+0xd04, same "reading r15 minus 4"/rdi=0 type-tag-off-
    ;; null signature as the create-launch-control pair above) named this
    ;; exact call as a suspect: (-> this turbo-suppressor-particle) reads
    ;; back the field the guarded create-launch-control above leaves #f
    ;; whenever *part-group-id-table* 273 is unset, and set-local-space-
    ;; info's own virtual dispatch dereferences its receiver's type
    ;; unconditionally with no null check of its own; the marker round
    ;; later pinned the actual fault one cluster earlier (dark-seeking-me,
    ;; see the note above), but this read-back is the same representation
    ;; hazard on the same field and needs the same `nonzero?` guard rather
    ;; than a plain truthiness test, so it stays fixed here too.
    ;;
    ;; og:preserve-this bring-up guard: gk-spawnguard3.err.log crashed
    ;; differently once the field-nullness class above was closed --
    ;; "executing address 0" / "indirect dispatch" (not a read fault), the
    ;; stack scan's own top return address landing right after this
    ;; call (the last call this method makes before its epilogue, no other
    ;; call in the local-space block sits anywhere near it). Re-disassembly
    ;; confirms it: turbo-suppressor-particle's own type is valid here (the
    ;; guard above already proved it nonzero, so the [-4] type-tag fetch
    ;; for this dispatch is not the fault) but the resolved method-20 slot
    ;; itself -- set-local-space-info (_type_ particle-local-space-info)
    ;; none, sparticle-launch-control's own declared slot 20, defmethod
    ;; landed in sparticle-launcher.gc -- reads 0 on this path, the same
    ;; class the sentinel lesson above applies to function values, not
    ;; just data pointers ("unlinked" reads as 0 whether the missing thing
    ;; is a symbol or a vtable slot). Retail's own ops call this
    ;; unconditionally too (op [567] in this rung's scoped decode: t9-24
    ;; loaded once via method-of-type, called with no branch), so this is
    ;; the same bring-up-absent-state class as every other guard in this
    ;; method, not a missed branch to restore. Fetch the slot explicitly
    ;; via method-of-type and check it before calling through it, the same
    ;; shape method-call syntax alone cannot express.
    ;; og:preserve-this BOTH sentinels, not one: this field holds raw 0 (never
    ;; written), #f (the guarded create-launch-control above arms it with
    ;; (the-as sparticle-launch-control #f) when *part-group-id-table* 273 is
    ;; unset), or a real launch-control. The previous guard tested nonzero?
    ;; alone, and #f is NONZERO (it is s7's address), so method-of-object ran
    ;; on #f and read the type tag from [s7-4], the bytes just before the
    ;; symbol table: layout-dependent garbage that sometimes chained to 0
    ;; (inner guard caught it, boot survived) and sometimes to a live-looking
    ;; value (call r9 executed garbage, the heisenbug spawn crash pinned by
    ;; disasm at m64+0xF70, rdi == r14 == s7 in the crash registers). A field
    ;; can need the truthiness test AND the nonzero? test whenever its writers
    ;; use both sentinel representations.
    (let ((tsp (-> this turbo-suppressor-particle)))
      (when (and (nonzero? tsp) tsp)
        (let ((info-setter (method-of-object tsp set-local-space-info)))
          (when (nonzero? info-setter)
            (info-setter tsp local-space)
            )
          )
        )
      )
    )
  (set! (-> this unknown-float-704) 0.0)
  0
  (none)
  )

;; definition for method 68 of type wvehicle
;; INFO: Used lq/sq
;; WARN: Return type mismatch int vs none.
(defmethod rigid-body-object-method-68 ((this wvehicle) (arg0 object) (arg1 object))
  (call-parent-method this arg0 arg1)
  (let ((v1-0 (-> (the-as rigid-body-vehicle-constants arg0) physics-model)))
    (set! (-> this wheel 0 info) (the-as vehicle-wheel-info v1-0))
    (set! (-> this wheel 1 info) (the-as vehicle-wheel-info v1-0))
    )
  (let ((v1-1 (-> (the-as rigid-body-vehicle-constants arg0) physics-model rear-wheel)))
    (set! (-> this wheel 2 info) v1-1)
    (set! (-> this wheel 3 info) v1-1)
    )
  (when arg1
    (let ((v1-3 (new 'stack-no-clear 'vector)))
      (dotimes (a0-3 4)
        (let* ((a3-0 (-> this wheel a0-3))
               (a1-6 (-> a3-0 info))
               (a2-2 (-> a3-0 handle))
               (a2-3
                 (and (nonzero? (l32-false-check a2-2)) (let ((t0-2 (-> (the-as (pointer process) (-> a2-2 process)) 0)))
                                                          (if (= (-> a2-2 pid) (-> t0-2 pid))
                                                              t0-2
                                                              )
                                                          )
                      )
                 )
               )
          (when a2-3
            (let ((a2-5 (the-as basic (-> (the-as process-drawable a2-3) root))))
              (let ((t0-5 (-> v1-3 data)))
                (set! (-> t0-5 0) (* (-> a3-0 x-scale) (-> a1-6 x-scale)))
                (set! (-> t0-5 1) 1.0)
                (set! (-> t0-5 2) 1.0)
                (set! (-> t0-5 3) 1.0)
                )
              (vector-float*! (the-as vector (-> v1-3 data)) (the-as vector (-> v1-3 data)) (-> a1-6 scale))
              (set! (-> (the-as trsqv a2-5) scale quad) (-> (the-as vector (-> v1-3 data)) quad))
              )
            )
          )
        )
      )
    (set! (-> this f-track-width)
          (* 2.0
             (+ (-> (the-as rigid-body-vehicle-constants arg0) physics-model front-wheel local-pos x)
                (-> (the-as rigid-body-vehicle-constants arg0) physics-model front-wheel susp-arm-length)
                (-> (the-as rigid-body-vehicle-constants arg0) physics-model front-wheel steer-arm-length)
                )
             )
          )
    (set! (-> this r-track-width)
          (* 2.0
             (+ (-> (the-as rigid-body-vehicle-constants arg0) physics-model rear-wheel local-pos x)
                (-> (the-as rigid-body-vehicle-constants arg0) physics-model rear-wheel susp-arm-length)
                (-> (the-as rigid-body-vehicle-constants arg0) physics-model rear-wheel steer-arm-length)
                )
             )
          )
    (set! (-> this wheelbase)
          (- (-> (the-as rigid-body-vehicle-constants arg0) physics-model front-wheel local-pos z)
             (-> (the-as rigid-body-vehicle-constants arg0) physics-model rear-wheel local-pos z)
             )
          )
    (let ((v1-9 (-> this draw shadow-ctrl)))
      (set! (-> v1-9 settings shadow-dir w) (-> this info setup shadow-locus-dist))
      (set! (-> v1-9 settings top-plane w) 0.0)
      (set! (-> v1-9 settings bot-plane w) (- (-> this info setup shadow-bot-clip)))
      )
    (wvehicle-method-225 this)
    (let ((v1-13 (new 'stack-no-clear 'inline-array 'vector 2)))
      (set! (-> v1-13 0 w) (-> (the-as rigid-body-vehicle-constants arg0) engine powerband-width-rpm))
      (set! (-> v1-13 1 x) (-> (the-as rigid-body-vehicle-constants arg0) engine peak-torque-rpm))
      (set! (-> v1-13 1 y) (-> (the-as rigid-body-vehicle-constants arg0) engine drag))
      (set! (-> v1-13 1 z) (/ 1.0 (square (-> v1-13 0 w))))
      (set! (-> v1-13 0 x) (* -1.0 (-> v1-13 1 z)))
      (set! (-> v1-13 0 y) (- (* 2.0 (-> v1-13 1 z) (-> v1-13 1 x)) (/ (-> v1-13 1 y) (-> v1-13 1 x))))
      (set! (-> v1-13 0 z) (- 1.0 (* (square (-> v1-13 1 x)) (-> v1-13 1 z))))
      (set! (-> v1-13 1 w)
            (/ (- (- (-> v1-13 0 y)) (sqrtf (- (square (-> v1-13 0 y)) (* 4.0 (-> v1-13 0 z) (-> v1-13 0 x)))))
               (* 2.0 (-> v1-13 0 x))
               )
            )
      (set! (-> (the-as rigid-body-vehicle-constants arg0) engine max-rpm) (-> v1-13 1 w))
      )
    0
    )
  0
  (none)
  )

;; definition for method 69 of type wvehicle
;; WARN: Return type mismatch int vs none.
(defmethod rigid-body-object-method-69 ((this wvehicle))
  (call-parent-method this)
  (set! (-> this rbody post-move-callback)
        (the-as (function rigid-body-object float none) (method-of-object this wvehicle-method-212))
        )
  (set! (-> this info physics-model front-wheel callback) (method-of-object this wvehicle-method-217))
  (set! (-> this info physics-model rear-wheel callback) (method-of-object this wvehicle-method-217))
  0
  (none)
  )
