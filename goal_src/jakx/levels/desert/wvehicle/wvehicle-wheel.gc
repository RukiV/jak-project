;; than required from race-mesh.gc, matching that file's own precedent
;; (each caller redeclares locally rather than requiring one another) and
;; vehicle-debris.gc's own copy of this same declaration, this rung.

(define-extern find-nearest-camera-distance (function vector float))

;; DECOMP BEGINS

;; og:preserve-this vehicle rung: retyped vehicle field basic -> vehicle.
;; vehicle-wheel-init-by-other's own decode reads raw offset 192 of this
;; field (placement 196 under the +4 basics convention, process-drawable's
;; own inherited draw field) and then raw offset 248 of that (placement
;; 252, draw-control's own lights field), copying the parent vehicle's own
;; vu-lights into the spawned wheel's own draw-control at the identical
;; offset; neither read resolves under plain basic.
;; definition of type vehicle-wheel-init-params
(deftype vehicle-wheel-init-params (structure)
  ((vehicle   vehicle)
   (skel      skeleton-group)
   (level     symbol)
   (radius    float)
   (position  vector      :inline)
   (rotation  quaternion  :inline)
   (scale     vector      :inline)
   )
  )

;; definition for method 3 of type vehicle-wheel-init-params
(defmethod inspect ((this vehicle-wheel-init-params))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'vehicle-wheel-init-params)
  (format #t "~1Tvehicle: ~A~%" (-> this vehicle))
  (format #t "~1Tskel: ~A~%" (-> this skel))
  (format #t "~1Tlevel: ~A~%" (-> this level))
  (format #t "~1Tradius: ~f~%" (-> this radius))
  (format #t "~1Tposition: #<vector @ #x~X>~%" (-> this position))
  (format #t "~1Trotation: #<quaternion @ #x~X>~%" (-> this rotation))
  (format #t "~1Tscale: #<vector @ #x~X>~%" (-> this scale))
  (label cfg-4)
  this
  )

;; falcon-wheels rung (wheel-constants leg): *vehicle-wheel-constants*'s
;; own static (L53) landed. The prior hold's "likely type, rigid-body-
;; vehicle-constants" guess was never checked against the label's own raw
;; bytes; it measures 200 bytes (0xc8), not 3,200+, exactly
;; rigid-body-object-constants's own size (all-types.gc), the same type
;; jak3's own homologous static uses (goal_src/jak3/levels/desert/wvehicle/
;; wvehicle-wheel.gc), and every field below is cited from L53's own hex
;; (decompiler/config/jakx/all-types.gc's own extern retype resolves it
;; with no label_types.jsonc entry needed, the same as every other landed
;; rigid-body-object-constants global in this corpus).
;; definition for symbol *vehicle-wheel-constants*, type rigid-body-object-constants
(define *vehicle-wheel-constants*
  (new 'static 'rigid-body-object-constants
    :info (new 'static 'rigid-body-info
      :max-time-step 0.033333335
      :mass 1.0
      :inv-mass 1.0
      :linear-damping 0.01
      :angular-damping 0.01
      :bounce-factor 0.5
      :friction-factor 0.5
      :bounce-mult-factor 1.22
      :cm-offset-joint (new 'static 'vector :data (new 'static 'array float 4 0.0 0.0 0.0 1.0))
      :inertial-tensor-box (new 'static 'array meters 3 (meters 2) (meters 3) (meters 3))
      :gravity 204800.0
      )
    :name '*vehicle-wheel-constants*
    )
  )

;; definition of type vehicle-wheel
(deftype vehicle-wheel (rigid-body-object)
  ((camera-dist  float)
   )
  (:state-methods
    explode
    fade-out
    die
    )
  (:methods
    (vehicle-wheel-method-92 (_type_ object object) none)
    ;; og:preserve-this falcon-wheels rung: method 65 REPLACES rigid-body-
    ;; object's own zero-explicit-arg slot ("Function may read a register
    ;; that is not set: a1" against the old 0-arg declaration,
    ;; wvehicle-wheel_ir2.asm op 1 of this override, this rung's own
    ;; scoped decode). vehicle-wheel-init-by-other calls this as its own
    ;; first statement with no explicit second arg, so the borrowed a1
    ;; register is init-by-other's own live arg0 (its vehicle-wheel-init-
    ;; params), not yet clobbered; op 41 reads only its offset-12 float
    ;; (the params' own radius field) into the new collision sphere's
    ;; local-sphere.w. No other landed rigid-body-object-method-65
    ;; override touches this register, so the base slot and its other
    ;; eleven overrides are untouched.
    (rigid-body-object-method-65 (_type_ vehicle-wheel-init-params) none :replace) ;; 65
    )
  )

;; definition for method 3 of type vehicle-wheel
(defmethod inspect ((this vehicle-wheel))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type rigid-body-object inspect)))
    (t9-0 this)
    )
  (format #t "~2Tcamera-dist: ~f~%" (-> this camera-dist))
  (label cfg-4)
  this
  )

