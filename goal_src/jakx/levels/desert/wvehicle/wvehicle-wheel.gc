(in-package goal)

;; name: wvehicle-wheel.gc
;; name in dgo: wvehicle-wheel
;; dgos: COMMON, GAME

;; DECOMP BEGINS

;; definition of type vehicle-wheel-init-params
(deftype vehicle-wheel-init-params (structure)
  ((vehicle   basic)
   (skel      skeleton-group)
   (level     symbol)
   (radius    float)
   (position  vector      :inline)
   (rotation  quaternion  :inline)
   (scale     vector      :inline)
   )
  )

;; definition for method 3 of type vehicle-wheel-init-params
(defmethod inspect ((this vehicle-wheel-init-params))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'vehicle-wheel-init-params)
  (format #t "~1Tvehicle: ~A~%" (-> this vehicle))
  (format #t "~1Tskel: ~A~%" (-> this skel))
  (format #t "~1Tlevel: ~A~%" (-> this level))
  (format #t "~1Tradius: ~f~%" (-> this radius))
  (format #t "~1Tposition: #<vector @ #x~X>~%" (-> this position))
  (format #t "~1Trotation: #<quaternion @ #x~X>~%" (-> this rotation))
  (format #t "~1Tscale: #<vector @ #x~X>~%" (-> this scale))
  (label cfg-4)
  this
  )

;; og:preserve-this *vehicle-wheel-constants* is omitted rather than
;; landed. Its own static (L53) fails static-ref the same way as the
;; other unparseable <static-data LNN> placeholders this band keeps
;; hitting; its likely type, rigid-body-vehicle-constants, is a huge
;; nested structure (12 sub-types, 3,200+ bytes), not a quick
;; label_types.jsonc win like vehicle-effects's glow templates. Method
;; 66 (its only reader) is omitted with it.

;; definition of type vehicle-wheel
(deftype vehicle-wheel (rigid-body-object)
  ((camera-dist  float)
   )
  (:state-methods
    explode
    fade-out
    die
    )
  (:methods
    (vehicle-wheel-method-92 () none)
    )
  )

;; definition for method 3 of type vehicle-wheel
(defmethod inspect ((this vehicle-wheel))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type rigid-body-object inspect)))
    (t9-0 this)
    )
  (format #t "~2Tcamera-dist: ~f~%" (-> this camera-dist))
  (label cfg-4)
  this
  )

;; og:preserve-this methods 92, 65, 87 and 88 are omitted rather than
;; landed. Same defect class as vehicle-debris's methods 65/87/88 in
;; this same band: method 92 fails at op 0 and reads a0/a1/a2 with none
;; set (three unset registers, not a dropped-argument fix, something
;; else corrupted this override's decode); method 65 fails at op 41 and
;; reads a1 unset; method 87 fails a stack-use guess; method 88
;; references an unactivated find-nearest-camera-distance (the same
;; missing symbol vehicle-debris's own method 88 hit) but is otherwise
;; raw-fallback regardless. New discoveries, not in either the
;; wvehicle-small-tier or rigid-body-object rung's held lists. Re-derive
;; from the framework's own dump (offline-test -f wvehicle-wheel -d)
;; once the root cause is found. idle's own :event handler still
;; dispatches vehicle-wheel-method-92 (unfilled, check_method_slots
;; flags it); the callee's home is this same object once method 92
;; lands.

;; definition for method 61 of type vehicle-wheel
;; WARN: Return type mismatch int vs none.
(defmethod rigid-body-object-method-61 ((this vehicle-wheel))
  (ja-post)
  (if (logtest? (-> this rbody flags) 1)
      (update-transforms (-> this root))
      )
  0
  (none)
  )

;; definition for method 71 of type vehicle-wheel
;; WARN: Return type mismatch int vs none.
(defmethod rigid-body-object-method-71 ((this vehicle-wheel))
  0
  (none)
  )

;; definition for method 80 of type vehicle-wheel
