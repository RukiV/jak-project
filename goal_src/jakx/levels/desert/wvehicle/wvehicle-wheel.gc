;;-*-Lisp-*-
(in-package goal)

;; name: wvehicle-wheel.gc
;; name in dgo: wvehicle-wheel
;; dgos: COMMON, GAME

;; og:preserve-this find-nearest-camera-distance is redeclared here rather
;; than required from race-mesh.gc, matching that file's own precedent
;; (each caller redeclares locally rather than requiring one another) and
;; vehicle-debris.gc's own copy of this same declaration, this rung.

(define-extern find-nearest-camera-distance (function vector float))

;; DECOMP BEGINS

;; og:preserve-this vehicle rung: retyped vehicle field basic -> vehicle.
;; vehicle-wheel-init-by-other's own decode reads raw offset 192 of this
;; field (placement 196 under the +4 basics convention, process-drawable's
;; own inherited draw field) and then raw offset 248 of that (placement
;; 252, draw-control's own lights field), copying the parent vehicle's own
;; vu-lights into the spawned wheel's own draw-control at the identical
;; offset; neither read resolves under plain basic.
;; definition of type vehicle-wheel-init-params
(deftype vehicle-wheel-init-params (structure)
  ((vehicle   vehicle)
   (skel      skeleton-group)
   (level     symbol)
   (radius    float)
   (position  vector      :inline)
   (rotation  quaternion  :inline)
   (scale     vector      :inline)
   )
  )

;; definition for method 3 of type vehicle-wheel-init-params
(defmethod inspect ((this vehicle-wheel-init-params))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'vehicle-wheel-init-params)
  (format #t "~1Tvehicle: ~A~%" (-> this vehicle))
  (format #t "~1Tskel: ~A~%" (-> this skel))
  (format #t "~1Tlevel: ~A~%" (-> this level))
  (format #t "~1Tradius: ~f~%" (-> this radius))
  (format #t "~1Tposition: #<vector @ #x~X>~%" (-> this position))
  (format #t "~1Trotation: #<quaternion @ #x~X>~%" (-> this rotation))
  (format #t "~1Tscale: #<vector @ #x~X>~%" (-> this scale))
  (label cfg-4)
  this
  )

;; og:preserve-this *vehicle-wheel-constants* is omitted rather than
;; landed. Its own static (L53) fails static-ref the same way as the
;; other unparseable <static-data LNN> placeholders this band keeps
;; hitting; its likely type, rigid-body-vehicle-constants, is a huge
;; nested structure (12 sub-types, 3,200+ bytes), not a quick
;; label_types.jsonc win like vehicle-effects's glow templates. Method
;; 66 (its only reader) is omitted with it.

;; definition of type vehicle-wheel
(deftype vehicle-wheel (rigid-body-object)
  ((camera-dist  float)
   )
  (:state-methods
    explode
    fade-out
    die
    )
  (:methods
    (vehicle-wheel-method-92 (_type_ object object) none)
    )
  )

;; definition for method 3 of type vehicle-wheel
(defmethod inspect ((this vehicle-wheel))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type rigid-body-object inspect)))
    (t9-0 this)
    )
  (format #t "~2Tcamera-dist: ~f~%" (-> this camera-dist))
  (label cfg-4)
  this
  )

;; og:preserve-this methods 92, 65 and 87 are omitted rather than
;; landed. Same defect class as vehicle-debris's methods 65/87 in this
;; same band: method 92 fails at op 0 and reads a0/a1/a2 with none set
;; (three unset registers, not a dropped-argument fix, something else
;; corrupted this override's decode); method 65 fails at op 41 and reads
;; a1 unset; method 87 fails a stack-use guess. idle's own :event
;; handler still dispatches vehicle-wheel-method-92 (unfilled,
;; check_method_slots flags it); the callee's home is this same object
;; once method 92 lands.
;;
;; method 88 was in this same held state until its own blocker (the same
;; unactivated find-nearest-camera-distance vehicle-debris's method 88
;; hit) was cleared by the race-mesh rung (jakx-levels-other-tier-4, both
;; the decompiler-config extern and a real define-extern now live in
;; goal_src/jakx/levels/common/race/race-mesh.gc). Its decode was
;; already fully clean at that point; this rung landed it below.

;; definition for method 61 of type vehicle-wheel
;; WARN: Return type mismatch int vs none.
(defmethod rigid-body-object-method-61 ((this vehicle-wheel))
  (ja-post)
  (if (logtest? (-> this rbody flags) 1)
      (update-transforms (-> this root))
      )
  0
  (none)
  )

;; definition for method 88 of type vehicle-wheel
;; WARN: Return type mismatch int vs none.
(defmethod rigid-body-object-method-88 ((this vehicle-wheel))
  (set! (-> this camera-dist) (find-nearest-camera-distance (-> this rbody position)))
  (if (< 901120.0 (-> this camera-dist))
      (go (method-of-object this die))
      )
  (rigid-body-object-method-70 this)
  (rigid-body-control-method-11 (-> this rbody) (the-as collide-shape-moving (-> this root)))
  (rigid-body-object-method-61 this)
  0
  (none)
  )

;; definition for method 71 of type vehicle-wheel
;; WARN: Return type mismatch int vs none.
(defmethod rigid-body-object-method-71 ((this vehicle-wheel))
  0
  (none)
  )

;; definition for method 80 of type vehicle-wheel
;; WARN: Return type mismatch symbol vs none.
(defmethod rigid-body-object-method-80 ((this vehicle-wheel) (arg0 rigid-body-impact))
  (when (< 40960.0 (-> arg0 impulse))
    (let ((f30-0 (* 0.000024414063 (+ -40960.0 (-> arg0 impulse))))
          (v1-5 (make-sound-instance (-> *sound-info* 625) (new 'static 'sound-id) (the-as handle #f)))
          )
      (cond
        (v1-5
          (set! (-> v1-5 volume) (the int (* 1024.0 (fmin 1.0 f30-0))))
          (logior! (-> v1-5 flags) 64)
          (-> v1-5 id)
          )
        (else
          0
          )
        )
      )
    (when (< 81920.0 (-> arg0 impulse))
      (let ((f30-1 (* 0.000024414063 (+ -81920.0 (-> arg0 impulse))))
            (v1-13 (make-sound-instance (-> *sound-info* 624) (new 'static 'sound-id) (the-as handle #f)))
            )
        (cond
          (v1-13
            (set! (-> v1-13 volume) (the int (* 1024.0 (fmin 1.0 f30-1))))
            (logior! (-> v1-13 flags) 64)
            (-> v1-13 id)
            )
          (else
            0
            )
          )
        )
      )
    0
    )
  (logior! (-> this root penetrated-by) (penetrate vehicle))
  #t
  (none)
  )

;; vehicle rung: vehicle-wheel-init-by-other and vehicle-wheel-spawn landed
;; together (the spawner's own run-now-in-process call needs its callee
;; defined, the AGENTS.md section 5 hazard the other way around). Both were
;; held only by their own commented-out externs (all-types.gc); no
;; hacks.jsonc entry blocked them. vehicle-wheel-init-by-other's own
;; offset-192-of-vehicle read needed the vehicle-wheel-init-params.vehicle
;; field retyped above.
;; definition for function vehicle-wheel-init-by-other
(defbehavior vehicle-wheel-init-by-other vehicle-wheel ((arg0 vehicle-wheel-init-params))
  (rigid-body-object-method-65 self)
  (set! (-> self root trans quad) (-> arg0 position quad))
  (quaternion-copy! (the-as quaternion (-> self root rot)) (-> arg0 rotation))
  (set! (-> self root scale quad) (-> arg0 scale quad))
  (set! (-> self level) (the-as level (-> arg0 level)))
  (initialize-skeleton self (-> arg0 skel) (the-as pair 0))
  (let ((v1-10 (-> self draw)))
    (set! (-> v1-10 lod-set lod 0 dist) 4096.0)
    (set! (-> v1-10 lod-set lod 1 dist) 81920.0)
    (set! (-> v1-10 lod-set lod 2 dist) 163840.0)
    (set! (-> v1-10 lod-set lod (-> v1-10 lod-set max-lod) dist) 819200.0)
    )
  (let ((f0-7 (fmax (fmax (fabs (-> arg0 scale x)) (fabs (-> arg0 scale y))) (fabs (-> arg0 scale z)))))
    (set! (-> self draw bounds w) (* (-> arg0 skel bounds w) f0-7))
    (set! (-> self draw longest-edge) (* (-> arg0 skel longest-edge) f0-7))
    )
  (set! (-> self draw lights) (-> arg0 vehicle draw lights))
  (when (and (nonzero? (-> self draw)) (= *lobby-local-players* 2))
    (logior! (-> self draw global-effect) (draw-control-global-effect rim-lights3))
    (set! (-> self draw lod-set lod 0 dist) (/ (-> self draw lod-set lod 0 dist) 2))
    (set! (-> self draw lod-set lod 1 dist) (/ (-> self draw lod-set lod 1 dist) 2))
    )
  (rigid-body-object-method-66 self)
  (go-virtual idle)
  )

;; definition for function vehicle-wheel-spawn
;; WARN: Return type mismatch process vs vehicle-wheel.
(defun vehicle-wheel-spawn ((arg0 process) (arg1 vehicle-wheel-init-params))
  (let ((gp-0 (the-as process #f)))
    (let* ((s3-0 (get-process *default-dead-pool* vehicle-wheel #x4000 1))
           (v1-1 (when s3-0
                   (let ((t9-1 (method-of-type process activate)))
                     (t9-1 s3-0 arg0 "vehicle-wheel" (the-as pointer #x70004000))
                     )
                   (run-now-in-process s3-0 vehicle-wheel-init-by-other arg1)
                   (-> s3-0 ppointer)
                   )
                 )
           )
      (if v1-1
          (set! gp-0 (-> v1-1 0))
          )
      )
    (the-as vehicle-wheel gp-0)
    )
  )

;; failed to figure out what this is:
(defstate idle (vehicle-wheel)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (local-vars (v0-1 object))
    (case message
      (('explode)
       (let ((a0-3 (-> self draw color-mult)))
         (vector-float*! (the-as vector a0-3) (the-as vector a0-3) 0.25)
         )
       (set! (-> self rbody position quad) (-> self root trans quad))
       (quaternion-copy! (the-as quaternion (-> self rbody rot)) (the-as quaternion (-> self root rot)))
       (let ((a1-3 (-> block param 0))
             (gp-1 (-> block param 1))
             )
         (when (and a1-3 gp-1)
           (rigid-body-control-method-31 (-> self rbody) (the-as vector a1-3))
           (rigid-body-control-method-32 (-> self rbody) (the-as vector gp-1))
           (go-virtual explode)
           )
         )
       )
      (('enable-collision)
       (set! v0-1 (logior (-> self flags) 1))
       (set! (-> self flags) (the-as uint v0-1))
       v0-1
       )
      (('disable-collision)
       (set! v0-1 (logand -2 (-> self flags)))
       (set! (-> self flags) (the-as uint v0-1))
       v0-1
       )
      (('modify-draw-status)
       ((method-of-object self vehicle-wheel-method-92)
        self
        (-> block param 0)
        (-> block param 1)
        )
       )
      )
    )
  :enter (behavior ()
    (let ((v1-1 (-> self root root-prim)))
      (set! (-> v1-1 prim-core collide-as) (collide-spec))
      (set! (-> v1-1 prim-core collide-with) (collide-spec))
      )
    0
    )
  :trans #f
  :post (behavior ()
    (rigid-body-object-method-61 self)
    )
  )

;; failed to figure out what this is:
(defstate explode (vehicle-wheel)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('impact-impulse)
       (let ((a1-1 (-> block param 0)))
         (rigid-body-object-method-80 self (the-as rigid-body-impact a1-1))
         )
       )
      )
    )
  ;; og:preserve-this the retail :enter handler decoded as a raw label
  ;; (L13), an anon-function the decompiler never recognized as a proper
  ;; function; raw label references are not valid GOAL, so the key is
  ;; omitted entirely rather than left broken or given an invented stub
  ;; body, matching the credits-obs precedent for the same defect class.
  :trans #f
  :code sleep-code
  :post (behavior ()
    (rigid-body-object-method-71 self)
    (if (time-elapsed? (-> self state-time) (seconds 4))
        (go-virtual fade-out)
        )
    )
  )

;; failed to figure out what this is:
(defstate fade-out (vehicle-wheel)
  :virtual #t
  :enter (behavior ()
    (set-time! (-> self state-time))
    (logior! (-> self draw status) (draw-control-status force-fade))
    )
  :code sleep-code
  :post (behavior ()
    (set! (-> self draw force-fade)
          (the-as
            uint
            (the int (fmax 0.0 (- 128.0 (* 0.42666668 (the float (- (current-time) (-> self state-time)))))))
            )
          )
    (if (< (-> self draw force-fade) (the-as uint 2))
        (go-virtual die)
        )
    (rigid-body-object-method-71 self)
    )
  )

;; failed to figure out what this is:
(defstate die (vehicle-wheel)
  :virtual #t
  :code (behavior ()
    (cleanup-for-death self)
    )
  )
