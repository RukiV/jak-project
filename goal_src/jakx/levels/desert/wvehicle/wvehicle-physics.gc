(in-package goal)

;; name: wvehicle-physics.gc
;; name in dgo: wvehicle-physics
;; dgos: COMMON, GAME

;; DECOMP BEGINS

;; og:preserve-this rigid-body-small-tier rung (held): the raw machine code
;; writes into a fixed scratchpad address (0x70002000) at offsets past 500
;; bytes for debug/network telemetry, and also reads wvehicle's own field at
;; offset 720, which the current field list does not declare in that region.
;; Neither the scratchpad buffer's full layout nor the missing field are
;; derivable from this rung's own scoped decode alone; hacks.jsonc's
;; no_type_analysis_functions_by_name carries "(method 62 wvehicle)" so the
;; rest of this object still decodes. Not reached by anything landed this
;; rung: (method 158 vehicle) and (method 159 vehicle) below call the base
;; rigid-body-object-method-62, not this override, and neither vehicle nor
;; wvehicle has any other landed caller of this slot.

;; definition of type wvehicle-wheel-work
(deftype wvehicle-wheel-work (structure)
  ((side-dir     vector  :inline)
   (forward-dir  vector  :inline)
   (velocity     vector  :inline)
   )
  )

;; definition for method 3 of type wvehicle-wheel-work
(defmethod inspect ((this wvehicle-wheel-work))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'wvehicle-wheel-work)
  (format #t "~1Tside-dir: #<vector @ #x~X>~%" (-> this side-dir))
  (format #t "~1Tforward-dir: #<vector @ #x~X>~%" (-> this forward-dir))
  (format #t "~1Tvelocity: #<vector @ #x~X>~%" (-> this velocity))
  (label cfg-4)
  this
  )

;; definition of type wvehicle-physics-work
(deftype wvehicle-physics-work (structure)
  ((wheel-work-array       wvehicle-wheel-work  4 :inline)
   (mat                    matrix               :inline)
   (force                  vector               :inline)
   (velocity               vector               :inline)
   (vel-dir                vector               :inline)
   (world-pos              vector               :inline)
   (local-pos              vector               :inline)
   (tmp                    vector               :inline)
   (p-body                 vector               :inline)
   (axis                   vector               :inline)
   (ground-pos             vector               :inline)
   (forward-dir            vector               :inline)
   (side-dir               vector               :inline)
   (wheel-axis             vector               :inline)
   (wsphere                sphere               :inline)
   (vel-len                float)
   (forward-vel            float)
   (friction-coef          float)
   (wheel-radius           float)
   (gravity-mag            float)
   (downforce              float)
   (side-force             float)
   (forward-force          float)
   (max-forward-tire-grip  float)
   (max-side-tire-grip     float)
   (inertia-eff            float)
   (ground-torque          float)
   (braking-torque         float)
   (total-torque           float)
   (limit-braking-torque   float)
   (max-braking-torque     float)
   (traction-factor        float)
   (tire-traction          float)
   (surface-drag           float)
   (cur-time               uint32)
   )
  )

;; definition for method 3 of type wvehicle-physics-work
(defmethod inspect ((this wvehicle-physics-work))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'wvehicle-physics-work)
  (format #t "~1Twheel-work-array[4] @ #x~X~%" (-> this wheel-work-array))
  (format #t "~1Tmat: #<matrix @ #x~X>~%" (-> this mat))
  (format #t "~1Tforce: #<vector @ #x~X>~%" (-> this force))
  (format #t "~1Tvelocity: #<vector @ #x~X>~%" (-> this velocity))
  (format #t "~1Tvel-dir: #<vector @ #x~X>~%" (-> this vel-dir))
  (format #t "~1Tworld-pos: #<vector @ #x~X>~%" (-> this world-pos))
  (format #t "~1Tlocal-pos: #<vector @ #x~X>~%" (-> this local-pos))
  (format #t "~1Ttmp: #<vector @ #x~X>~%" (-> this tmp))
  (format #t "~1Tp-body: #<vector @ #x~X>~%" (-> this p-body))
  (format #t "~1Taxis: #<vector @ #x~X>~%" (-> this axis))
  (format #t "~1Tground-pos: #<vector @ #x~X>~%" (-> this ground-pos))
  (format #t "~1Tforward-dir: #<vector @ #x~X>~%" (-> this forward-dir))
  (format #t "~1Tside-dir: #<vector @ #x~X>~%" (-> this side-dir))
  (format #t "~1Twheel-axis: #<vector @ #x~X>~%" (-> this wheel-axis))
  (format #t "~1Twsphere: #<sphere @ #x~X>~%" (-> this wsphere))
  (format #t "~1Tvel-len: ~f~%" (-> this vel-len))
  (format #t "~1Tforward-vel: ~f~%" (-> this forward-vel))
  (format #t "~1Tfriction-coef: ~f~%" (-> this friction-coef))
  (format #t "~1Twheel-radius: ~f~%" (-> this wheel-radius))
  (format #t "~1Tgravity-mag: ~f~%" (-> this gravity-mag))
  (format #t "~1Tdownforce: ~f~%" (-> this downforce))
  (format #t "~1Tside-force: ~f~%" (-> this side-force))
  (format #t "~1Tforward-force: ~f~%" (-> this forward-force))
  (format #t "~1Tmax-forward-tire-grip: ~f~%" (-> this max-forward-tire-grip))
  (format #t "~1Tmax-side-tire-grip: ~f~%" (-> this max-side-tire-grip))
  (format #t "~1Tinertia-eff: ~f~%" (-> this inertia-eff))
  (format #t "~1Tground-torque: ~f~%" (-> this ground-torque))
  (format #t "~1Tbraking-torque: ~f~%" (-> this braking-torque))
  (format #t "~1Ttotal-torque: ~f~%" (-> this total-torque))
  (format #t "~1Tlimit-braking-torque: ~f~%" (-> this limit-braking-torque))
  (format #t "~1Tmax-braking-torque: ~f~%" (-> this max-braking-torque))
  (format #t "~1Ttraction-factor: ~f~%" (-> this traction-factor))
  (format #t "~1Ttire-traction: ~f~%" (-> this tire-traction))
  (format #t "~1Tsurface-drag: ~f~%" (-> this surface-drag))
  (format #t "~1Tcur-time: ~D~%" (-> this cur-time))
  (label cfg-4)
  this
  )

;; definition of type wvehicle-probe-work
(deftype wvehicle-probe-work (structure)
  ((mat                matrix         :inline)
   (world-pos          vector         :inline)
   (probe-dir          vector         :inline)
   (tmp                vector         :inline)
   (ground-normal-sum  vector         :inline)
   (probe-uu           float)
   (wheel-radius       float)
   (water-y            float)
   (surface-type       uint8)
   (surface-depth      float)
   (material           uint64)
   (cquery             collide-query  :inline)
   )
  )

;; definition for method 3 of type wvehicle-probe-work
(defmethod inspect ((this wvehicle-probe-work))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'wvehicle-probe-work)
  (format #t "~1Tmat: #<matrix @ #x~X>~%" (-> this mat))
  (format #t "~1Tworld-pos: #<vector @ #x~X>~%" (-> this world-pos))
  (format #t "~1Tprobe-dir: #<vector @ #x~X>~%" (-> this probe-dir))
  (format #t "~1Ttmp: #<vector @ #x~X>~%" (-> this tmp))
  (format #t "~1Tground-normal-sum: #<vector @ #x~X>~%" (-> this ground-normal-sum))
  (format #t "~1Tprobe-uu: ~f~%" (-> this probe-uu))
  (format #t "~1Twheel-radius: ~f~%" (-> this wheel-radius))
  (format #t "~1Twater-y: ~f~%" (-> this water-y))
  (format #t "~1Tsurface-type: ~D~%" (-> this surface-type))
  (format #t "~1Tsurface-depth: ~f~%" (-> this surface-depth))
  (format #t "~1Tmaterial: ~D~%" (-> this material))
  (format #t "~1Tcquery: #<collide-query @ #x~X>~%" (-> this cquery))
  (label cfg-4)
  this
  )

;; og:preserve-this rigid-body-small-tier rung (held): the raw machine code
;; forwards a2 (touching-shapes-entry-adjacent object) unmodified into
;; (method 216 wvehicle) via a floating point division whose operand types
;; the decompiler's expression builder cannot resolve at this rung's own
;; evidence level ("Floating point division attempted on invalid types").
;; hacks.jsonc's no_type_analysis_functions_by_name carries "(method 216
;; wvehicle)" so the rest of this object still decodes.

;; definition for method 212 of type wvehicle
;; INFO: Used lq/sq
(defmethod wvehicle-method-212 ((this wvehicle))
  (let ((a1-0 #x70002000))
    (let* ((v1-0 (the-as object (+ a1-0 0)))
           (t1-0 (-> this rbody matrix))
           (a2-1 (-> t1-0 rvec quad))
           (a3-0 (-> t1-0 uvec quad))
           (t0-0 (-> t1-0 fvec quad))
           (t1-1 (-> t1-0 trans quad))
           )
      (set! (-> (the-as (pointer uint128) v1-0) 0) a2-1)
      (set! (-> (the-as (pointer uint128) v1-0) 1) a3-0)
      (set! (-> (the-as (pointer uint128) v1-0) 2) t0-0)
      (set! (-> (the-as (pointer uint128) v1-0) 3) t1-1)
      )
    (wvehicle-method-211 this a1-0)
    )
  (none)
  )

;; og:preserve-this bring-up stub f5afc742b retired, falcon-wheels rung
;; (wheel-constants leg): the real body decodes clean from wvehicle-util
;; (its own home object) once its real blocker, wvehicle-method-220
;; (wvehicle.gc), is landed; stack_structures.jsonc's own new entry
;; declares its sp+16 as vehicle-wheel-init-params (the recipe recovered
;; from the PR 604 lane's own record). One compile-only substitution: the
;; decoder prints its own pseudo-op (.asm.sllv.r0) for the raw sllv
;; reinterpretation building a handle from vehicle-wheel-spawn's own
;; returned ppointer, which is not valid GOAL (v-wpn-base-common-trans
;; precedent, wvehicle-weapons-h.gc, same defect class); substituted with
;; ppointer->handle (gkernel-h.gc), its own exact expansion.
;; definition for method 213 of type wvehicle
;; INFO: Used lq/sq
;; WARN: Return type mismatch int vs none.
(defmethod wvehicle-method-213 ((this wvehicle) (arg0 object))
  (let ((s5-0 (new 'stack-no-clear 'vehicle-wheel-init-params)))
    (set! (-> s5-0 vehicle) this)
    (set! (-> s5-0 position quad) (-> this root trans quad))
    (quaternion-identity! (-> s5-0 rotation))
    (vector-identity! (-> s5-0 scale))
    (set! (-> s5-0 skel) (the-as skeleton-group arg0))
    (set! (-> s5-0 level) (the-as symbol (-> this level)))
    (set! (-> s5-0 radius) 4096.0)
    (&-> s5-0 vehicle)
    ;; og:preserve-this wheel-spawn-null rung: (method 213 wvehicle)'s own
    ;; wheel-info wiring, not this rung's own scoped decode of this
    ;; function (wvehicle-physics.o's compiled body, falclcrash-dis.py
    ;; against wvehicle-physics+0xa2e, has no write to any wheel's info
    ;; slot anywhere in this method; the crash itself is r9=0 read from
    ;; (-> this wheel 0 info) before vehicle-wheel-spawn ever runs, PP
    ;; "vehicle", first-ever execution once the falcon's wheel art group
    ;; resolved, PR 619). jak3's own structurally-identical spawn-wheels!
    ;; (goal_src/jak3/levels/desert/wvehicle/wvehicle-util.gc:505-551)
    ;; reads (-> sv-96 info scale/radius/settle-pos) the same way, guarded
    ;; upstream by (method 37 wvehicle)'s own override (same file, lines
    ;; 30-37) wiring wheel 0/1 to (-> this info physics-model front-wheel)
    ;; and wheel 2/3 to rear-wheel, called from alloc-rbody-control! before
    ;; spawn-wheels! ever runs. jakx has consolidated that whole chain into
    ;; (method 64 rigid-body-object) (rigid-body-object.gc, this rung's own
    ;; read of its full body), which carries no wheel-specific step at all,
    ;; and no wvehicle override of method 64 or any equivalent exists yet,
    ;; so nothing else in the landed corpus performs this wiring. Landed
    ;; here, once, ahead of the loop that reads it, rather than as a new
    ;; vtable override: every wcar-*.gc family shares this same method, so
    ;; the fix covers all 15 vehicle types' first spawn, not just the
    ;; falcon that exposed it. Retire this note if a real (method 64
    ;; wvehicle) or alloc-rbody-control! override ever lands and takes over
    ;; the wiring.
    ;;
    ;; og:preserve-this winit rung addendum: (method 68 wvehicle)
    ;; (wvehicle-util.gc) has since landed and writes this same four-slot
    ;; wheel-info wiring from its own arg0 (a rigid-body-vehicle-constants
    ;; passed in whenever constants are reapplied), not from (-> this
    ;; info) as this hoist does. The two are not fully interchangeable:
    ;; this hoist runs once, before vehicle-wheel-spawn ever runs and
    ;; before method 68 could have anything valid to write from, so it
    ;; cannot simply be deleted in favor of method 68. Left as a known
    ;; redundant write for a follow-up to fold once the two call sites'
    ;; relative timing across the full spawn chain is mapped.
    (set! (-> this wheel 0 info) (-> this info physics-model front-wheel))
    (set! (-> this wheel 1 info) (-> this info physics-model front-wheel))
    (set! (-> this wheel 2 info) (-> this info physics-model rear-wheel))
    (set! (-> this wheel 3 info) (-> this info physics-model rear-wheel))
    (dotimes (s4-1 4)
      (let ((s3-0 (-> this wheel s4-1)))
        (set! (-> s5-0 radius) (* 1.3 (-> s3-0 info scale) (-> s3-0 info radius)))
        (vector-identity! (-> s5-0 scale))
        (set! (-> s5-0 scale x) (* (-> s3-0 x-scale) (-> s3-0 info x-scale)))
        (vector-float*! (-> s5-0 scale) (-> s5-0 scale) (-> s3-0 info scale))
        (let ((v1-13 (process->ppointer (vehicle-wheel-spawn this (the-as vehicle-wheel-init-params (&-> s5-0 vehicle))))))
          (set! (-> s3-0 handle) (ppointer->handle v1-13))
          )
        (set! (-> s3-0 pos) (-> s3-0 info settle-pos))
        (set! (-> s3-0 pos2) (-> s3-0 pos))
        )
      )
    )
  (when (nonzero? (-> this behavior))
    (rigid-body-object-method-86 this)
    (wvehicle-method-220 this)
    (wvehicle-method-212 this)
    (dotimes (v1-28 4)
      (let ((a0-19 (-> this wheel v1-28)))
        (set! (-> a0-19 pos2) (-> a0-19 pos))
        )
      )
    )
  (wvehicle-method-220 this)
  (vehicle-method-115 this)
  0
  (none)
  )

;; og:preserve-this rigid-body-small-tier rung (held): a related cluster of
;; debug/network telemetry methods that write into the same shared fixed
;; scratchpad address (0x70002000, method 212 above) at offsets past 500
;; bytes, arg1/arg2 typed "object" throughout since neither this rung's own
;; scoped decode nor a quick corpus check turned up a declared type wide
;; enough to cover the observed offsets (528+ in method 210 alone).
;; hacks.jsonc's no_type_analysis_functions_by_name carries "(method 211
;; wvehicle)" and "(method 210 wvehicle)" so the rest of this object still
;; decodes. (method 212 wvehicle) above forwards the same scratchpad
;; constant into (method 211 wvehicle) but is landed itself, since its own
;; failing ops were a single self-contained quad copy, not part of the
;; wider buffer-layout gap.

;; definition for method 158 of type vehicle
(defmethod vehicle-method-158 ((this wvehicle) (arg0 float))
  (rigid-body-object-method-62 this arg0)
  (none)
  )

;; definition for method 159 of type vehicle
(defmethod vehicle-method-159 ((this wvehicle) (arg0 float))
  (rigid-body-object-method-62 this arg0)
  (none)
  )
