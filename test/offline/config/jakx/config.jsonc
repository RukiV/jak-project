    // unrelated ops (type_casts.jsonc comment on this method). No landed
    // body; see the og:preserve-this comment in goal_src.
    "(method 19 end-menu)",
    // hud-widgets-tier rung: (method 19 hud-cash-stats), (method 24
    // hud-cash-stats) and (method 26 hud-cash-stats) held together.
    // Method 26's own op 288 net-player read is the same prior-rung-
    // documented blocker as above; methods 19 and 24 call 24 and 26
    // directly by name, so none of the three can land independently of
    // it. Beyond the held op, method 26's decode also leaks raw
    // register-emulation forms goalc rejects outright ("Unrecognized
    // symbol call! as head of form"). No landed bodies; see the
    // og:preserve-this comments in goal_src.
    "(method 19 hud-cash-stats)",
    "(method 24 hud-cash-stats)",
    "(method 26 hud-cash-stats)",
    // hud-widgets-tier rung: (method 19 cash-hud) dispatches net-game-mgr-
    // method-50 and net-game-mgr-method-51 by name; net-game-mgr itself is
    // only a name-only declare-type in this tree (hud-results-grand-
    // prix.gc), the same out-of-scope boundary an earlier "hud-static-
    // literals rung" drew for net-game-mgr generally. No landed body; see
    // the og:preserve-this comment in goal_src.
    "(method 19 cash-hud)",
    // engine-quick-tier-6 rung: print-default-collision (collision-editor.gc)
    // walks a process-drawable's node-list several times over (once per
    // prim-type debug print block: sphere/mesh/group), and the decompiler
    // only types the base pointer as plain process at every one of those
    // sites; fixing one site with a type_casts.jsonc cast only exposes the
    // next site downstream with the identical shape, at least six of them
    // total. The fresh decode's own compile attempt fails outright on a
    // guessed dispatch name from the same unresolved chain ("The method
    // get-process of type object could not be found"). Held un-landed
    // (commented out) in goal_src; see the og:preserve-this comment there.
    "print-default-collision",
    // engine-quick-tier-6 rung: five cam-debug functions each carry an
    // unresolved decode defect (see the og:preserve-this comments at each
    // one in goal_src/jakx/engine/camera/cam-debug.gc for the full
    // evidence); all five are commented out there and held un-landed.
    // The fresh decode's own compile attempt fails on each for a different
    // reason: cam-line-dma rejects pointer arithmetic on a still-generic
    // pointer type ("Cannot do math on a pointer"), camera-fov-frame and
    // camera-slave-debug both carry a repeating VU-scratchpad or camera-
    // master/camera-combiner cast chain that never fully converges, and
    // cam-collision-record-save and cam-collision-record-draw both carry
    // at least one unresolved stack-structure or field-type gap
    "cam-line-dma",
    "camera-fov-frame",
    "camera-slave-debug",
    "cam-collision-record-save",
    "cam-collision-record-draw",
    // camera-facing-quad: method 9 (the retail draw-quad submission) is
    // held un-landed in goal_src (see the og:preserve-this comment there)
    // because it dispatches clear-strip, whose own implementation lives in
    // wvehicle-weapons-oil.gc, unlanded and out of this rung's scope. The
    // fresh decode's own compile attempt fails on the same call, since the
    // raw decompiler pseudo-code prints an uncompiled "(call! a0-1)"
    // placeholder rather than a real call form for it (a0-1 never resolves
    // to a callable clear-strip typespec). Retire alongside the
    // og:preserve-this note once wvehicle-weapons-oil lands.
    "(method 9 camera-facing-quad)",
    // collide-cache: seven of the object's own unfilled methods emit a
    // defmethod from their raw decode (each still carries a decode error,
    // see the og:preserve-this note at the top of goal_src/jakx/engine/
    // collide/collide-cache.gc) but the fallback body itself does not
    // compile: methods 14 and 18 both do raw pointer math against a value
    // typed object ("Cannot do math on a object" on (+ a3-0 128)/(+ a2-1
    // 128)); methods 16, 19, 20, 21 and 23 each carry an unresolved load
    // that the expression builder turns into a (the-as none ...) cast used
    // where a real type is required. goal_src omits all seven; the
    // decomp-vs-REF diff still gates the rest of the object.
    "(method 14 collide-cache)",
    "(method 16 collide-cache)",
    "(method 18 collide-cache)",
    "(method 19 collide-cache)",
    "(method 20 collide-cache)",
    "(method 21 collide-cache)",
    "(method 23 collide-cache)"
  ],
  "skip_compile_states": {
    // bad handle->process folds (jak3 carries the same class of entries); the
    // landed goal_src carries hand-folded handle->process at these sites
    "(idle manipy)": ["event", "code"],
    // kras-obs: (defstate idle (kras-fireworks-ship-a) ...)'s :exit and :post
    // handlers both decode as raw label references (L122, L114); goal_src
    // carries the full analysis for the other three handlers.
    "(idle kras-fireworks-ship-a)": ["exit", "post"],
    // kras-obs: (defstate idle (kras-flag) ...)'s :code handler decodes as a
    // raw label reference (L107); goal_src carries the full analysis for the
    // other four handlers.
    "(idle kras-flag)": ["code"],
    // desarena-obs: (defstate idle (palm-tree) ...)'s :event handler decodes as
    // a raw label reference (L39); goal_src carries the full analysis for the
    // other four handlers.
    "(idle palm-tree)": ["event"],
    // desarena-obs: (defstate vibrate (palm-tree) ...)'s :event handler also
    // decodes as a raw label reference (L31); goal_src carries the full
    // analysis for the other four handlers.
    "(vibrate palm-tree)": ["event"],
    // train-obs: (defstate idle (train-car) :virtual #t ...)'s :event handler
    // decodes a manual find-parent-method fallback whose result the compiler
    // types as plain `function`, which has no `event` field to read; goal_src
    // carries the full analysis for the other (inherited) :post handler.
    "(idle train-car)": ["event"],
    // train-obs: (defstate idle (train) :virtual #t ...)'s :post handler
    // decodes as a raw label reference (L10); goal_src carries the full
    // analysis for the other four handlers.
    "(idle train)": ["post"],
    // kras-obs: (defstate idle (kras-windsock) ...)'s :code handler decodes as
    // a raw label reference (L100); goal_src carries the full analysis for the
    // other four handlers.
    "(idle kras-windsock)": ["code"],
    // title-obs: (defstate target-title (target) ...)'s :enter handler decodes
    // as a raw label reference (L40); goal_src carries the full analysis for
    // the other three handlers.
    // peak-obs: (defstate idle (peak-snowball) :virtual #t ...)'s :post
    // handler fails the same matrix-copy! typecheck as (method 17
    // peak-snowball) above (the decoded arg1 casts through quaternion instead
    // of matrix); goal_src carries the full analysis.
    "(idle peak-snowball)": ["post"],
    // kras-obs: (defstate idle (kras-pump-break) :virtual #t ...)'s :event
    // handler fails the same NullType reg-class failure as peak-obs's own
    // (method 80 peak-snowball) above, on the same
    // process-nettable-method-27/-29 pair; goal_src carries the full analysis.
    "(idle kras-pump-break)": ["event"],
    // kras-obs: (defstate explode (kras-pump-break-draw) ...)'s :event handler
    // decodes as a raw label reference (L11), and its :enter handler does
    // pointer arithmetic on a collide-shape-prim-typed value ((+ v1-9 108)
    // feeding s.w!) the compiler rejects; goal_src carries the full analysis
    // for the other handlers.
    "(explode kras-pump-break-draw)": ["event", "enter"],
    // vehicle-states (vehicle band): (defstate player-control (vehicle)
    // ...)'s :enter handler decodes as a raw label reference (L28), an
    // anon-function the decompiler never recognized as a proper function; the
    // raw handler also carries the eight-byte read at self+460 (spanning two
    // fields, no cast expresses it) and the sllv reinterpretation pseudo-op
    // the wvehicle-small-tier rung held. Both held issues live inside this
    // one unresolved body; goal_src omits the key entirely (credits-obs
    // precedent) and carries the full analysis for the state's other
    // handlers.
    "(player-control vehicle)": ["enter"],
    // visvol-edit: (defstate idle (visvol-editor) :virtual #t ...)'s :trans
    // handler decodes self->proc's handle->process deref as the raw
    // .asm.sllv.r0 / pid-check triple (the same class "(idle manipy)" above
    // holds); goal_src hand-folds it to (handle->process ...) and carries the
    // full analysis for the state's other three handlers.
    "(idle visvol-editor)": ["trans"],
    // wvehicle-states: (defstate explode (wvehicle) :virtual #t ...)'s :enter
    // handler decodes as explosion-init-params being built cleanly (both
    // handle fields, the stack struct) up to the same sllv reinterpretation
    // pseudo-op "(player-control vehicle)" above holds, this time on a
    // ppointer-chase result rather than a directly-loaded handle field;
    // parked as asm by config (decompiler/config/jakx/ntsc_v1/hacks.jsonc,
    // "(anon-function 18 wvehicle-states)"); goal_src omits the key entirely
    // (credits-obs precedent) and carries the full analysis for :post.
    "(explode wvehicle)": ["enter"],
    // wvehicle-states: (defstate explode-into-nothing (wvehicle) :virtual #t
    // ...)'s :enter handler is the same class as "(explode wvehicle)" above
    // (asm-parked as "(anon-function 16 wvehicle-states)"); goal_src omits
    // the key entirely and carries the full analysis for :code/:post.
    "(explode-into-nothing wvehicle)": ["enter"]
  }
