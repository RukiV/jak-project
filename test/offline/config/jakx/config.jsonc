  "skip_compile_files": [
    // gsound's *sound-handles* (L383) and *sound-bank-reload-names* (L356) statics
    // emit as bare label refs; goal_src lands compilable hand-carries and the
    // decomp-vs-REF diff still gates all the code
    "gsound",
    // gsound-h's ambient-sound new (m0) fails on srl/pcpyud inline asm and emits
    // only the error comment block; goal_src lands the hand-carried method and the
    // decomp-vs-REF diff still gates the types and the other methods
    "gsound-h",
    // both statics now decompile clean (label_types.jsonc sizes L123 and the
    // apply()-abort fix in insert_static_refs stopped it from suppressing L122
    // right after); the remaining blocker is get-destruct-perm's raw (&-> ...) cast
    // to a symbol's value slot, which goalc types as (pointer object) without the
    // hand-cast goal_src carries; the decomp-vs-REF diff still gates the code
    "net-simple-destruct",
    "types-h", // weird array of types.
    // "hfrag-h", // weird duplicate type
    // the REFs record the parked VU0/scratchpad decompression family (joint) and the
    // raw-op parked methods (process-drawable) which do not compile; goal_src lands
    // the real bodies and the decomp-vs-REF diff still gates both
    "joint",
    "process-drawable",
    // "subdivide",
    "shadow-cpu-h",
    // jak3 parity: foreground-draw/-ripple carry undecompilable VU0 asm and
    // foreground-emerc never converts, so the whole file skips goalc in the
    // offline set (jak3's config does the same); the decomp-vs-REF diff still runs
    "foreground",
    // the retail static at L27 now decompiles clean (label_types.jsonc sizes it), but
    // codegen still fails: the decompiler emits two internal-named (method inspect
    // attackable-hash) definitions and goalc refuses the duplicate; goal_src hand-
    // authors the type and the decomp-vs-REF diff still gates the code
    "attackable-hash",
    // the REF records the parked gui-control/spooler/external-art surface, which
    // still carries CFG and type-prop errors; goal_src lands the art slice and
    // the decomp-vs-REF diff still gates the whole object
    "loader",
    // credits-obs: *credits-chars* is a raw <static-data L157> blob, a top-level
    // define the compiler tokenizes as three arguments instead of a value; not a
    // function or a state, so neither skip mechanism below can reach it, and
    // goal_src carries the same raw marker verbatim (this landing never compiled).
    // Same shape as gsound/joint/process-drawable above: whole file, not a function.
    "credits-obs",
    // title-obs: same class as credits-obs above, *end-credits-proc* is a raw
    // <static-data L226> blob in a top-level define; goal_src carries the same
    // raw marker verbatim. (Its five defstate handlers with raw-label-leak
    // :post/:code/:enter slots would each need their own skip_compile_states
    // entry too, but this file-level skip already makes those moot, so they are
    // not added.)
    "title-obs",
    // hud-static-literals rung: the decompiler emits two non-identical
    // internal-named (method hud-method-26 hang-time-hud-single) definitions
    // (COMMON and GAME DGO copies decode to different bytecode, the same
    // duplicate-object-file class as attackable-hash above) and goalc
    // refuses the duplicate; goal_src keeps the fuller of the two (the one
    // with the get-current-language text-id switch) and the decomp-vs-REF
    // diff still gates the rest of the object
    "hud-widgets-powerhang"
    // "tie-methods",
    // "scene-actor" // top level lambda that defines a type
  ],
  "skip_compile_functions": [
    // generic-obs: the decompiler applies these casts internally but drops the
    // printed the-as (mat-joint as matrix / pf get-trans dispatch / editor float
    // event result); the landed goal_src carries hand-casts at the same sites
    "part-tracker-init-base",
    "(method 17 lightning-tracker)",
    "(method 11 part-spawner)",
    // cache stuff
    "invalidate-cache-line",
    // dma
    "dma-buffer-add-vu-function",
    // math
    "logf",
    "log2f",
    "cube-root",
    "lerp-scale",
    "rand-vu-init",
    "rand-vu",
    "rand-vu-nostep",
    // connect
    "(method 0 engine)",
    "(method 0 engine-pers)",
    // sky (multiple definition)
    "(method 3 sky-vertex)",
    // timer
    "(method 9 clock)",
    "(method 3 generic-tie-interp-point)",
    // bones. The reference records the decompiled skinning loop, which carries two
    // .addiu pointer bumps that do not compile. jak3 skips this function for the same
    // reason; goal_src comments them out and indexes the arrays instead.
    "bones-mtx-calc-execute",
    // collide-shape (slice 4): the reference records the raw prim-walk delay slots
    // ((+ prim 80) on a basic), which do not compile; the landed goal_src carries
    // jak3's og:preserve-this (&+ ...) at the same sites. Same five skips as jak3's
    // offline config, same reason.
    "(method 18 collide-shape-prim-group)",
    "(method 19 collide-shape-prim)",
    "(method 36 collide-shape)",
    "(method 12 collide-shape-prim-group)",
    "(method 13 collide-shape-prim)",
    // collide-hash: collide-list-fill-bg-using-line-sphere fails past its own
    // resolved stack layout on a field read at raw offset 172 off a
    // collide-hash-scratch value that does not declare a field there; goal_src
    // carries the full analysis, including the type_casts attempt that did not
    // change the error.
    "collide-list-fill-bg-using-line-sphere",
    // collide-list-fill-bg-using-box: same matrix4h vector4h/long offset-0 tie as
    // main-collide's instance-sphere-box-intersect?; the REF records the
    // decompiler's own (-> s3-0 origin vector4h long), which goalc rejects, and
    // goal_src carries the hand-corrected (-> s3-0 origin long 0) at the same site
    // (same byte address, matching every other index in the same expression); the
    // decomp-vs-REF diff still gates the rest of the function.
    "collide-list-fill-bg-using-box",
    // (method 8 collide-hash) (mem-usage): the REF records the decompiler's own
    // (logand a0-11 31) with a0-11 printed as uint (the item id field's own
    // declared type); goalc rejects that as ash's exponent argument. goal_src
    // carries a hand-cast to int at both sites, same byte-identical semantics.
    "(method 8 collide-hash)",
    // idle-control: (method 10 idle-control) (play-idle-frames!) fails on an
    // art-element field at offset 32 that falls in undocumented padding, past the
    // point jak3's twin corroborates (it uses the high-level ja macro there
    // instead of raw channel manipulation); goal_src carries the full analysis.
    "(method 10 idle-control)",
    // collide-debug: (method 9 collide-cache) and col-rend-draw both hit the same
    // unresolved collide-cache-prim/collide-shape-prim-sphere chain (goal_src
    // carries the full analysis); (method 9 col-rend) (draw) calls col-rend-draw
    // and is deferred alongside it for the same link-as-zero reason vol's own
    // (method 9 vol-control) is deferred alongside (method 9 plane-volume).
    "(method 9 collide-cache)",
    "col-rend-draw",
    "(method 9 col-rend)",
    // vol: (method 9 plane-volume)'s own decode fails expression building on a
    // float division past the resolved stack layout (goal_src carries the full
    // analysis); (method 9 vol-control) calls it twice and is deferred alongside it
    // rather than compile clean today and link as zero at kernel link once the
    // callee's real body eventually lands.
    "(method 9 plane-volume)",
    "(method 9 vol-control)",
    // race-control: output-race-mesh's own all-types.gc define-extern documents the
    // full analysis. Type prop fails on its first load ((l.wu (+ a0 52)) against a0
    // typed object) before any compile-time cast could apply; a config-only rung
    // already tried and reverted casting a0 at both the entry op and the failing op.
    // No call site anywhere in the corpus narrows the argument's real type. goal_src
    // leaves the function undefined (deferred, not landed) rather than carry the
    // decompiler's non-compiling fallback body; the decomp-vs-REF diff still gates
    // the rest of the object.
    "output-race-mesh",
    // peak-obs: (method 80 peak-snowball) fails compiling its own decode,
    // "get_preferred_reg_class called on NullType" on the let-bound result of
    // (method-of-object this process-nettable-method-27); goal_src carries the
    // full analysis and the decomp-vs-REF diff still gates the rest of the file.
    "(method 80 peak-snowball)",
    // peak-obs: (method 71 peak-snowball) calls rbody-collision, the same
    // never-declared function train-obs's own method 71 override hits below;
    // goal_src carries the full analysis.
    "(method 71 peak-snowball)",
    // peak-obs: (method 17 peak-snowball) (process-nettable's own method 17)
    // fails a real typecheck, matrix-copy!'s first argument decoding as
    // quaternion instead of matrix; goal_src carries the full analysis.
    "(method 17 peak-snowball)",
    // kras-obs: (method 44 kras-pump-break) does pointer arithmetic on a
    // process-focusable-typed value ((+ v1-2 292) feeding s.d!), which the
    // compiler rejects even though the raw offset math is fine; goal_src
    // carries the full analysis.
    "(method 44 kras-pump-break)",
    // train-obs: (method 71 train-object) calls rbody-collision, a function no
    // landed file declares or defines anywhere in the corpus (not even an
    // extern); goal_src carries the full analysis and the decomp-vs-REF diff
    // still gates the rest of the file.
    "(method 71 train-object)",
    // time-box-obs: (method 55 time-freeze-short) (net-powerup's own method 55)
    // decodes with an empty arg list instead of ((this time-freeze-short)), the
    // same class of malformed-signature decode failure as the pre-fix
    // rigid-body-object-method-70; goal_src carries the full analysis.
    "(method 55 time-freeze-short)",
    // target-handler: target-standard-event-handler's own 'get-on branch calls
    // vehicle-spawn, which stays commented out at all-types.gc line 62310 pending
    // traffic-object-spawn-params (the race/vehicle band's own typing territory);
    // goal_src holds the whole function back as a define-extern with no body for the
    // same reason. Retires when vehicle-spawn lands.
    "target-standard-event-handler"
  ],
  "skip_compile_states": {
    // bad handle->process folds (jak3 carries the same class of entries); the
    // landed goal_src carries hand-folded handle->process at these sites
    "(idle manipy)": ["event", "code"],
    // kras-obs: (defstate idle (kras-fireworks-ship-a) ...)'s :exit and :post
    // handlers both decode as raw label references (L122, L114); goal_src
    // carries the full analysis for the other three handlers.
    "(idle kras-fireworks-ship-a)": ["exit", "post"],
    // kras-obs: (defstate idle (kras-flag) ...)'s :code handler decodes as a
    // raw label reference (L107); goal_src carries the full analysis for the
    // other four handlers.
    "(idle kras-flag)": ["code"],
    // desarena-obs: (defstate idle (palm-tree) ...)'s :event handler decodes as
    // a raw label reference (L39); goal_src carries the full analysis for the
    // other four handlers.
    "(idle palm-tree)": ["event"],
    // desarena-obs: (defstate vibrate (palm-tree) ...)'s :event handler also
    // decodes as a raw label reference (L31); goal_src carries the full
    // analysis for the other four handlers.
    "(vibrate palm-tree)": ["event"],
    // train-obs: (defstate idle (train-car) :virtual #t ...)'s :event handler
    // decodes a manual find-parent-method fallback whose result the compiler
    // types as plain `function`, which has no `event` field to read; goal_src
    // carries the full analysis for the other (inherited) :post handler.
    "(idle train-car)": ["event"],
    // train-obs: (defstate idle (train) :virtual #t ...)'s :post handler
    // decodes as a raw label reference (L10); goal_src carries the full
    // analysis for the other four handlers.
    "(idle train)": ["post"],
    // kras-obs: (defstate idle (kras-windsock) ...)'s :code handler decodes as
    // a raw label reference (L100); goal_src carries the full analysis for the
    // other four handlers.
    "(idle kras-windsock)": ["code"],
    // title-obs: (defstate target-title (target) ...)'s :enter handler decodes
    // as a raw label reference (L40); goal_src carries the full analysis for
    // the other three handlers.
    // peak-obs: (defstate idle (peak-snowball) :virtual #t ...)'s :post
    // handler fails the same matrix-copy! typecheck as (method 17
    // peak-snowball) above (the decoded arg1 casts through quaternion instead
    // of matrix); goal_src carries the full analysis.
    "(idle peak-snowball)": ["post"],
    // kras-obs: (defstate idle (kras-pump-break) :virtual #t ...)'s :event
    // handler fails the same NullType reg-class failure as peak-obs's own
    // (method 80 peak-snowball) above, on the same
    // process-nettable-method-27/-29 pair; goal_src carries the full analysis.
    "(idle kras-pump-break)": ["event"],
    // kras-obs: (defstate explode (kras-pump-break-draw) ...)'s :event handler
    // decodes as a raw label reference (L11), and its :enter handler does
    // pointer arithmetic on a collide-shape-prim-typed value ((+ v1-9 108)
    // feeding s.w!) the compiler rejects; goal_src carries the full analysis
    // for the other handlers.
    "(explode kras-pump-break-draw)": ["event", "enter"]
  }
}