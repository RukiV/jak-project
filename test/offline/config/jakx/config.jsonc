    // landed goal_src carries a hand cast back to int at the same site (same
    // byte-identical arithmetic, sv-144 stays an accumulate-only local never
    // read as unsigned elsewhere in the function).
    "debug-merc-highres-runtime",
    // debug-foreground: debug-merc-size-runtime hits the identical int-literal
    // accumulator reassigned to a uint-cast sum shape as
    // debug-merc-highres-runtime above, on its own sv-48; same hand cast at
