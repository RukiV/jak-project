    // the decomp-vs-REF diff still gates those.
    "set-veh-weapon",
    "dm-set-veh-weapon",
    "test-vehicle-weapon",
    // debug-foreground: debug-merc-highres-runtime's own sv-144 accumulator is
    // let-bound to the int literal 0, then reassigned
    // (+ (* (the-as uint 3) v1-25) 1 sv-144), which the decompiler's own cast
