    // Retires when that object is re-landed.
    "target-standard-event-handler",
    // path: (method 28 path-control)'s sv-112 out-of-range-sentinel init loads
    // the positive-infinity bit pattern (#x7f800000); the decompiler's float
    // literal table folds -1.0/1.0 into a plain float constant but does not
    // recognize this pattern, so the raw decoded string keeps the internal
    // gpr->fpr helper instead of a the-as float cast. The landed goal_src
    // carries the hand cast at the same site (matching jak3's own path.gc,
    // which renders this identical assignment as (the-as float #x7f800000));
    // the decomp-vs-REF diff still gates the rest of the object.
    "(method 28 path-control)",
    // race-sabotage: with-pp's own pp is hardcoded :type process
    // (gkernel-h.gc), so the raw decode's bare (-> pp net-player) etc. do
    // not compile; the landed goal_src carries (the-as sabotage-sequence
    // pp) at every sabotage-sequence-specific field access on pp, matching
    // the existing net-world.gc precedent for the same with-pp shape.
    "sabotage-sequence-init-by-other",
    "sabotage-sequence-trans",
    // wvehicle-weapons-debug (vehicle band): set-veh-weapon and
    // test-vehicle-weapon are the wvehicle-small-tier rung's held item, a
    // compiler-folded 0-or-8 weapon-slot selector before a shared doubleword
