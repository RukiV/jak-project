;; definition for method 11 of type des-cactus-b
;; WARN: Return type mismatch none vs object.
(defmethod init-from-entity! ((this des-cactus-b) (arg0 entity-actor))
  (stack-size-set! (-> this main-thread) 32)
  (des-plant-method-71 this (-> arg0 extra trans) (-> arg0 quat))
  )

;; definition for method 71 of type des-cactus-b
;; WARN: Return type mismatch object vs none.
(defmethod des-plant-method-71 ((this des-cactus-b) (arg0 vector) (arg1 quaternion))
  (let ((s3-0 (new 'process 'collide-shape this (collide-list-enum usually-hit-by-player))))
    (let ((s2-0 (new 'process 'collide-shape-prim-group s3-0 (the-as uint 2) 0)))
      (set! (-> s3-0 total-prims) (the-as uint 3))
      (set! (-> s2-0 prim-core action) (collide-action solid))
      (set-vector! (-> s2-0 local-sphere) 0.0 12288.0 0.0 18432.0)
      (set! (-> s3-0 root-prim) s2-0)
      )
    (let ((a0-6 (new 'process 'collide-shape-prim-sphere s3-0 (the-as uint 0))))
      (set! (-> a0-6 prim-core action) (collide-action solid))
      (set! (-> a0-6 transform-index) 0)
      )
    (let ((a0-8 (new 'process 'collide-shape-prim-sphere s3-0 (the-as uint 0))))
      (set! (-> a0-8 prim-core action) (collide-action solid))
      (set! (-> a0-8 transform-index) 0)
      )
    (set! (-> s3-0 nav-radius) (* 0.75 (-> s3-0 root-prim local-sphere w)))
    (let ((v1-11 (-> s3-0 root-prim)))
      (set! (-> s3-0 backup-collide-as) (-> v1-11 prim-core collide-as))
      (set! (-> s3-0 backup-collide-with) (-> v1-11 prim-core collide-with))
      )
    (set! (-> this root) s3-0)
    )
  (initialize-skeleton
    this
    (the-as skeleton-group (art-group-get-by-name *level* "skel-des-cactus-b" (the-as (pointer level) #f)))
    (the-as pair 0)
    )
  (set! (-> this exploder-params) *des-cactus-b-explode-params*)
  (set! (-> this exploder-skel)
        (the-as
          skeleton-group
          (art-group-get-by-name *level* "skel-des-cactus-b-explode" (the-as (pointer level) #f))
          )
        )
  (set! (-> this exploder-anim) (the-as uint 8))
  ((method-of-type joint-mod-rotate-local init)
   (-> this jmods 0)
   this
   (the-as uint 4)
   (joint-mod-base-flags attached)
   )
  (init (-> this jmods 1) this (the-as uint 5) (joint-mod-base-flags attached))
  (init (-> this jmods 2) this (the-as uint 6) (joint-mod-base-flags attached))
  (init (-> this jmods 3) this (the-as uint 7) (joint-mod-base-flags attached))
  (set! (-> this hit-points) 7.0)
  (let ((t9-11 (method-of-type des-plant des-plant-method-71)))
    (t9-11 this arg0 arg1)
    )
  (go (method-of-object this idle))
  (none)
  )

