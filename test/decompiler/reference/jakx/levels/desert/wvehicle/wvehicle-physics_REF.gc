;; definition of type wvehicle-wheel-work
(deftype wvehicle-wheel-work (structure)
  ((side-dir     vector  :inline)
   (forward-dir  vector  :inline)
   (velocity     vector  :inline)
   )
  )

;; definition for method 3 of type wvehicle-wheel-work
(defmethod inspect ((this wvehicle-wheel-work))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'wvehicle-wheel-work)
  (format #t "~1Tside-dir: #<vector @ #x~X>~%" (-> this side-dir))
  (format #t "~1Tforward-dir: #<vector @ #x~X>~%" (-> this forward-dir))
  (format #t "~1Tvelocity: #<vector @ #x~X>~%" (-> this velocity))
  (label cfg-4)
  this
  )

;; definition of type wvehicle-physics-work
(deftype wvehicle-physics-work (structure)
  ((wheel-work-array       wvehicle-wheel-work  4 :inline)
   (mat                    matrix               :inline)
   (force                  vector               :inline)
   (velocity               vector               :inline)
   (vel-dir                vector               :inline)
   (world-pos              vector               :inline)
   (local-pos              vector               :inline)
   (tmp                    vector               :inline)
   (p-body                 vector               :inline)
   (axis                   vector               :inline)
   (ground-pos             vector               :inline)
   (forward-dir            vector               :inline)
   (side-dir               vector               :inline)
   (wheel-axis             vector               :inline)
   (wsphere                sphere               :inline)
   (vel-len                float)
   (forward-vel            float)
   (friction-coef          float)
   (wheel-radius           float)
   (gravity-mag            float)
   (downforce              float)
   (side-force             float)
   (forward-force          float)
   (max-forward-tire-grip  float)
   (max-side-tire-grip     float)
   (inertia-eff            float)
   (ground-torque          float)
   (braking-torque         float)
   (total-torque           float)
   (limit-braking-torque   float)
   (max-braking-torque     float)
   (traction-factor        float)
   (tire-traction          float)
   (surface-drag           float)
   (cur-time               uint32)
   )
  )

;; definition for method 3 of type wvehicle-physics-work
(defmethod inspect ((this wvehicle-physics-work))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'wvehicle-physics-work)
