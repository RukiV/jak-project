(defmethod wvehicle-method-267 ((this wvehicle))
  (set! (-> this ai destination handle) (the-as uint #f))
  (set! (-> this ai destination nav-location nav-mesh) #f)
  (set! (-> this ai destination nav-location nav-poly) #f)
  (set! (-> this ai blocked-timer) 0.0)
  (set! (-> this ai reverse-timer) 0.0)
  (cond
    ((-> this nav)
     (set! (-> this ai nav-location nav-mesh) (-> this nav state mesh))
     (set! (-> this ai nav-location nav-poly) (-> this nav state current-poly))
     )
    (else
      (set! (-> this ai nav-location nav-mesh) #f)
      (set! (-> this ai nav-location nav-poly) #f)
      )
    )
  (set! (-> this ai current-travel quad) (-> this rbody lin-velocity quad))
  (set! (-> this ai previous-steering-error) 0.0)
  (set! (-> this ai no-physics-speed) (vector-length (-> this ai current-travel)))
  (set! (-> this ai desired-speed) (-> this max-speed))
  (set! (-> this ai weapon-timer) (the-as uint 0))
  (set! (-> this ai weapon-aggression) 0.5)
  0
  (none)
  )

