(in-package goal)

;; definition for function check-travel
(defun check-travel ((arg0 vector) (arg1 float) (arg2 object))
  (let ((f0-0 (vector-length arg0)))
    (if (< (+ 20480.0 arg1) f0-0)
        (format 0 "TOO FAST! ~s: ~m/~m~%" arg2 f0-0 arg1)
        )
    )
  )

