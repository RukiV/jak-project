;;-*-Lisp-*-
(in-package goal)

;; definition of type hoff-text-floater
(deftype hoff-text-floater (process)
  ((screen-from  vector  :inline)
   (float-rate   float)
   (duration     uint64)
   (state-time   uint64)
   (context      font-context)
   (text         basic)
   )
  (:state-methods
    run
    )
  )

;; definition for method 3 of type hoff-text-floater
(defmethod inspect ((this hoff-text-floater))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type process inspect)))
    (t9-0 this)
    )
  (format #t "~2Tscreen-from: #<vector @ #x~X>~%" (-> this screen-from))
  (format #t "~2Tfloat-rate: ~f~%" (-> this float-rate))
  (format #t "~2Tduration: ~D~%" (-> this duration))
  (format #t "~2Tstate-time: ~D~%" (-> this state-time))
  (format #t "~2Tcontext: ~A~%" (-> this context))
  (format #t "~2Ttext: ~A~%" (-> this text))
  (label cfg-4)
  this
  )

;; definition of type hoff-text-floater-init-params
(deftype hoff-text-floater-init-params (structure)
  ((world-from           vector  :inline)
   (float-rate           float)
   (duration             uint32)
   (in-view              int32)
   (in-static-string     basic)
   (alloc-string-length  uint8)
   (color                uint8)
   (scale                float)
   (flags                uint16)
   )
  )

;; definition for method 3 of type hoff-text-floater-init-params
(defmethod inspect ((this hoff-text-floater-init-params))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'hoff-text-floater-init-params)
  (format #t "~1Tworld-from: #<vector @ #x~X>~%" (-> this world-from))
  (format #t "~1Tfloat-rate: ~f~%" (-> this float-rate))
  (format #t "~1Tduration: ~D~%" (-> this duration))
  (format #t "~1Tin-view: ~D~%" (-> this in-view))
  (format #t "~1Tin-static-string: ~A~%" (-> this in-static-string))
  (format #t "~1Talloc-string-length: ~D~%" (-> this alloc-string-length))
  (format #t "~1Tcolor: ~D~%" (-> this color))
  (format #t "~1Tscale: ~f~%" (-> this scale))
  (format #t "~1Tflags: ~D~%" (-> this flags))
  (label cfg-4)
  this
  )

;; definition for method 7 of type hoff-text-floater
(defmethod relocate ((this hoff-text-floater) (offset int))
  (let ((v1-0 (-> this text)))
    (if (and (>= (the-as int v1-0) (-> *kernel-context* relocating-min))
             (< (the-as int v1-0) (-> *kernel-context* relocating-max))
             )
        (&+! (-> this text) offset)
        )
    )
  (if (nonzero? (-> this context))
      (&+! (-> this context) offset)
      )
  (call-parent-method this offset)
  )

;; definition for function hoff-text-floater-init-by-other
;; INFO: Used lq/sq
(defbehavior hoff-text-floater-init-by-other hoff-text-floater ((arg0 hoff-text-floater-init-params))
  (let ((s5-0 (new 'stack-no-clear 'vector)))
    (transform-point-vector! s5-0 (-> arg0 world-from))
    (+! (-> s5-0 x) -1792.0)
    (+! (-> s5-0 y) -1840.0)
    (when (= (-> arg0 in-view) 1)
      (case (-> *viewport-array* mode)
        ((1)
         (+! (-> s5-0 y) 192.0)
         )
        ((2)
         (+! (-> s5-0 x) 256.0)
         )
        (else
          )
        )
      )
    (set! (-> self screen-from quad) (-> s5-0 quad))
    )
  (set! (-> self float-rate) (-> arg0 float-rate))
  (set! (-> self duration) (-> arg0 duration))
  (set! (-> self text) (if (-> arg0 in-static-string)
                           (-> arg0 in-static-string)
                           (new 'process 'string (the-as int (-> arg0 alloc-string-length)) (the-as string #f))
                           )
        )
  (set! (-> self context) (new
                            'process
                            'font-context
                            *font-default-matrix*
                            (the-as int (-> self screen-from x))
                            (the-as int (-> self screen-from y))
                            8396850.0
                            (the-as font-color (-> arg0 color))
                            (the-as font-flags (-> arg0 flags))
                            )
        )
  (set-scale! (-> self context) (-> arg0 scale))
  (go-virtual run)
  )

;; failed to figure out what this is:
(defstate run (hoff-text-floater)
  :virtual #t
  :enter (behavior ()
    (set! (-> self state-time) (the-as uint (current-time)))
    )
  :trans (behavior ()
    (let ((v1-0 (-> self context))
          (f0-0 (-> self screen-from x))
          (f1-0 (-> self screen-from y))
          )
      (set! (-> v1-0 origin x) f0-0)
      (set! (-> v1-0 origin y) f1-0)
      )
    (let ((t9-0 print-game-text)
          (a0-0 (-> self text))
          (a1-0 (-> self context))
          (a2-0 #f)
          (a3-0 44)
          (t0-0 787)
          )
      (t9-0 (the-as string a0-0) a1-0 a2-0 a3-0 (the-as bucket-id t0-0))
      )
    (let ((f0-3 (/ (the float (- (current-time) (the-as int (-> self state-time)))) (the float (-> self duration))))
          (v1-5 (-> self context))
          )
      (cond
        ((>= f0-3 1.0)
         (go empty-state)
         )
        (else
          (set! (-> v1-5 alpha) (- 1.0 f0-3))
          (set! (-> self screen-from y) (- (-> self screen-from y) (* (-> self float-rate) (seconds-per-frame))))
          )
        )
      )
    )
  :code sleep-code
  )
