;; failed to figure out what this is:
(defstate explode (explosion)
  :virtual #t
  :event L11
  :enter (behavior ()
    (set! (-> self start-time) (the-as uint (current-time)))
    (when (nonzero? (-> self params collide-with))
      (update-transforms (-> self root))
      (let ((a1-0 (new 'stack-no-clear 'overlaps-others-params)))
        (set! (-> a1-0 options) (overlaps-others-options))
        (set! (-> a1-0 collide-with-filter) (the-as collide-spec -1))
        (set! (-> a1-0 tlist) *touching-list*)
        (find-overlapping-shapes (-> self root) a1-0)
        )
      )
    (let ((v1-11 (-> self root root-prim)))
      (set! (-> v1-11 prim-core collide-as) (collide-spec))
      (set! (-> v1-11 prim-core collide-with) (collide-spec))
      )
    0
    )
  :trans (behavior ()
    (when (!= (-> self params velocity w) 0.0)
      (let ((gp-0 (-> self root)))
        (integrate-and-collide! gp-0 (-> gp-0 transv))
        (let* ((s4-0 (-> self mat))
               (s5-0 (vector-normalize-copy! (new 'stack-no-clear 'vector) (-> gp-0 transv) 1.0))
               (s2-0 (new 'stack-no-clear 'vector))
               (a0-4 (vector-get-closest-perpendicular! s2-0 s5-0 (vector-get-unique! (new 'stack-no-clear 'vector) s5-0)))
               (v1-3 s4-0)
               )
          (set! (-> v1-3 fvec quad) (-> s5-0 quad))
          (set! (-> v1-3 uvec quad) (-> a0-4 quad))
          (vector-cross! (-> v1-3 rvec) (-> v1-3 uvec) s5-0)
          )
        (set! (-> self mat trans quad) (-> gp-0 trans quad))
        )
      )
    (cond
      ((time-elapsed? (the-as int (-> self start-time)) (the-as time-frame (-> self duration)))
       (if (time-elapsed?
             (the-as int (-> self start-time))
             (the-as time-frame (+ (-> self duration) (-> self linger-duration)))
             )
           (deactivate self)
           )
       )
      ((or (= (-> self params group) (-> self params group-on-kill)) (not (-> self killed-someone?)))
       (if (not *explosion-effect-suppress*)
           (spawn-from-mat (-> self part) (-> self mat))
           )
       )
      )
    )
  :code sleep-code
  :post (behavior ()
    (if (!= (-> self params velocity w) 0.0)
        (transform-post)
        )
    )
  )
