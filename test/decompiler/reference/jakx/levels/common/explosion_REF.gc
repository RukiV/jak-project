  (mem-copy! (the-as pointer (-> self params)) (the-as pointer arg0) 113)
  (logclear! (-> self mask) (process-mask actor-pause movie))
  (let ((s5-0 (new 'process 'collide-shape self (collide-list-enum hit-by-player))))
