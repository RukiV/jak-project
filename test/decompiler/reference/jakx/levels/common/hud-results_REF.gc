;; definition for method 9 of type hud-results
(defmethod hud-item-method-9 ((this hud-results))
  (set! *had-gold* (the-as object #f))
  (if (and (not (-> this grand-prix-totals)) (= (-> (get-open-task-node-info) medals 0) (game-task-medal gold)))
      (set! *had-gold* #t)
      )
  (case (get-current-language)
    (((language-enum italian))
     (set! (-> (the-as
                 hud-item-group
                 (-> (the-as hud-item-group (-> (the-as hud-item-group (-> this items 0)) items 0)) items 1)
                 )
               items
               2
               width
               )
           250
           )
     )
    (else
      (set! (-> (the-as
                  hud-item-group
                  (-> (the-as hud-item-group (-> (the-as hud-item-group (-> this items 0)) items 0)) items 1)
                  )
                items
                2
                width
                )
            100
            )
      )
    )
  (let ((a2-0 (-> this items 2))
        (v1-10 (-> this items 8))
        (a0-20 (-> this items 9))
        (a1-1 (-> this items 10))
        (a3-1 (-> *viewport-array* mode))
        )
    (cond
      ((zero? a3-1)
       (set! (-> this position-x) 0)
       (set! (-> this items 0 scale) 256)
       (set! (-> this items 1 scale) 256)
       (set! (-> this items 1 width) (the int (* 400.0 (-> *video-params* relative-x-scale))))
       (set! (-> this items 0 position-y) -110)
       (set! (-> this items 8 scale) 115)
       (set! (-> this items 9 scale) 115)
       (set! (-> this items 10 scale) 256)
       (set! (-> a2-0 position-y) 0)
       (set! (-> v1-10 position-y) 40)
       (set! (-> a0-20 position-y) 40)
       (set! (-> a1-1 position-y) 40)
       (set! (-> v1-10 position-x) 0)
       (set! (-> a0-20 position-x) 0)
       (set! (-> this scale) 256)
       )
      ((= a3-1 1)
       (set! (-> this position-x) 0)
       (set! (-> this items 0 scale) 153)
       (set! (-> this items 1 scale) 153)
       (set! (-> this items 0 position-y) -90)
       (set! (-> this items 8 scale) 92)
       (set! (-> this items 9 scale) 92)
       (set! (-> this items 10 scale) 204)
       (set! (-> a2-0 position-y) -10)
