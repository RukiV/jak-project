;; definition for symbol *hud-results-medal-proc*, type object
(define *hud-results-medal-proc* (the-as object #f))

;; definition of type hud-results-medal
(deftype hud-results-medal (in-game-hud)
  ()
  )

;; definition for method 3 of type hud-results-medal
(defmethod inspect ((this hud-results-medal))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type in-game-hud inspect)))
    (t9-0 this)
    )
  (label cfg-4)
  this
  )

;; definition for method 7 of type hud-results-medal
;; WARN: Return type mismatch in-game-hud vs hud-results-medal.
(defmethod relocate ((this hud-results-medal) (offset int))
  (set! *hud-results-medal-proc* this)
  (if (nonzero? *hud-results-medal-proc*)
      (set! *hud-results-medal-proc* (+ (the-as uint *hud-results-medal-proc*) offset))
      )
  (the-as hud-results-medal ((method-of-type in-game-hud relocate) this offset))
  )

;; definition for method 26 of type hud-results-medal
(defmethod hud-method-26 ((this hud-results-medal))
  (set! (-> this items) (the-as (array hud-item) *hud-results-medal*))
  (set! (-> this manager) (new 'static 'basic-manager))
  (set! *hud-results-medal-proc* this)
  ((method-of-type in-game-hud hud-method-26) this)
  (none)
  )

;; definition for method 10 of type hud-results-medal
(defmethod deactivate ((this hud-results-medal))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (set! *hud-results-medal-proc* (the-as object #f))
  ((method-of-type in-game-hud deactivate) this)
  (none)
  )

;; definition for method 24 of type hud-results-medal
(defmethod hud-method-24 ((this hud-results-medal))
  (when *debug-hud*
    (set! (-> this real-items) (the-as (array hud-item) *hud-results-medal*))
    (hud-method-26 this)
    )
  ((method-of-type in-game-hud hud-method-24) this)
  (none)
  )

;; definition for function spawn-hud-results-medal
(defun spawn-hud-results-medal ()
  (cond
    (*hud-results-medal-proc*
      *hud-results-medal-proc*
      )
    (*net-game-mgr*
      (let ((v0-0
              (ppointer->process
                (process-spawn hud-results-medal :init hud-init-by-other :name "hud-results-medal" :to *net-game-mgr*)
                )
              )
            )
        (when (the-as hud-results-medal v0-0)
          (set! (-> (the-as hud-results-medal v0-0) inited-strings-count) 0)
          0
          )
        v0-0
        )
      )
    (else
      #f
      )
    )
  )

;; definition for method 22 of type hud-results-medal
;; WARN: Return type mismatch symbol vs none.
(defmethod hud-method-22 ((this hud-results-medal))
  (none)
  )

