;; definition for method 24 of type hud-bar-slider
(defmethod hud-bar-slider-method-24 ((this hud-bar-slider) (arg0 float))
  (let ((v1-3 (-> (the-as hud-item-group (-> this items 1)) items 1)))
    (set! (-> v1-3 scale) (the int (* 12288.0 arg0)))
    )
  (hud-item-method-14 this)
  (hud-item-method-12 this)
  (none)
  )

