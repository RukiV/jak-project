;;-*-Lisp-*-
(in-package goal)

;; definition for symbol *in-game-menu-process*, type (pointer process)
(define *in-game-menu-process* (the-as (pointer process) #f))

;; definition for symbol *in-game-menu-on?*, type object
(define *in-game-menu-on?* (the-as object #f))

;; definition for function in-game-menu-allowed?
(defun in-game-menu-allowed? ()
  (not (or (-> *setting-control* user-current movie)
           (movie?)
           (handle->process (-> *game-info* pov-camera-handle))
           (handle->process (-> *game-info* other-camera-handle))
           (< (-> *display* base-clock frame-counter) (the-as time-frame (-> *game-info* letterbox-time)))
           (< (-> *display* base-clock frame-counter) (the-as time-frame (-> *game-info* blackout-time)))
           (!= (-> *setting-control* user-current bg-a) 0.0)
           (!= (-> *setting-control* user-current bg-a-force) 0.0)
           (not (-> *setting-control* user-current allow-in-game-menu))
           (or (and (handle->process (-> *game-info* auto-save-proc))
                    (not (send-event (handle->process (-> *game-info* auto-save-proc)) 'progress-allowed?))
                    )
               (= *cheat-mode* 'camera)
               (= *master-mode* 'freeze)
               *master-exit*
               (not *common-text*)
               (< (memory-free *nk-dead-pool*) #x8000)
               (and (current-finish-mode) *net-mgr* (= (-> *net-mgr* game-type) 4))
               (in-game-menu-on?)
               )
           )
       )
  )

;; definition of type in-game-menu-struct
(deftype in-game-menu-struct (structure)
  ((last-selection-index  int8)
   (confirmation-sym      basic)
   )
  (:methods
    (in-game-menu-struct-method-9 (_type_) none)
    )
  )

;; definition for method 3 of type in-game-menu-struct
(defmethod inspect ((this in-game-menu-struct))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'in-game-menu-struct)
  (format #t "~1Tlast-selection-index: ~D~%" (-> this last-selection-index))
  (format #t "~1Tconfirmation-sym: ~A~%" (-> this confirmation-sym))
  (label cfg-4)
  this
  )

;; definition for method 9 of type in-game-menu-struct
;; WARN: Return type mismatch int vs none.
(defmethod in-game-menu-struct-method-9 ((this in-game-menu-struct))
  (set! (-> this last-selection-index) 0)
  (set! (-> this confirmation-sym) #f)
  0
  (none)
  )

;; definition for symbol *in-game-menu-struct*, type in-game-menu-struct
(define *in-game-menu-struct* (new 'static 'in-game-menu-struct))

