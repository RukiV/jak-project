;;-*-Lisp-*-
(in-package goal)

;; this file is debug only
(declare-file (debug))

;; definition of type drive-data
(deftype drive-data (structure)
  ((angles  vector  :inline)
   (pos     vector  :inline)
   )
  )

;; definition for method 3 of type drive-data
(defmethod inspect ((this drive-data))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'drive-data)
  (format #t "~1Tangles: ~`vector`P~%" (-> this angles))
  (format #t "~1Tpos: #<vector @ #x~X>~%" (-> this pos))
  (label cfg-4)
  this
  )

;; definition for symbol *drift-file-stream*, type file-stream
(define *drift-file-stream* (new 'static 'file-stream))

;; definition of type drift-editor
(deftype drift-editor (process)
  ((angles                        euler-angles     :inline)
   (counter                       int32)
   (editor-start-time             uint32)
   (all-data-array                (pointer float)  5)
   (drive-data-array              (pointer float)  :overlay-at (-> all-data-array 0))
   (wheel-front-left-data-array   (pointer float)  :overlay-at (-> all-data-array 1))
   (wheel-front-right-data-array  (pointer float)  :overlay-at (-> all-data-array 2))
   (wheel-rear-left-data-array    (pointer float)  :overlay-at (-> all-data-array 3))
   (wheel-rear-right-data-array   (pointer float)  :overlay-at (-> all-data-array 4))
   (release-start-trigger         basic)
   (odd-even                      int8)
   )
  (:state-methods
    init-state
    run-state
    write-file
    )
  (:methods
    (drift-editor-method-18 (_type_ string int) none)
    )
  )

;; definition for method 3 of type drift-editor
(defmethod inspect ((this drift-editor))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type process inspect)))
    (t9-0 this)
    )
  (format #t "~2Tangles: #<euler-angles @ #x~X>~%" (-> this angles))
  (format #t "~2Tcounter: ~D~%" (-> this counter))
  (format #t "~2Teditor-start-time: ~D~%" (-> this editor-start-time))
  (format #t "~2Tall-data-array[5] @ #x~X~%" (-> this all-data-array))
  (format #t "~2Tdrive-data-array: #x~X~%" (-> this drive-data-array))
  (format #t "~2Twheel-front-left-data-array: #x~X~%" (-> this wheel-front-left-data-array))
  (format #t "~2Twheel-front-right-data-array: #x~X~%" (-> this wheel-front-right-data-array))
  (format #t "~2Twheel-rear-left-data-array: #x~X~%" (-> this wheel-rear-left-data-array))
  (format #t "~2Twheel-rear-right-data-array: #x~X~%" (-> this wheel-rear-right-data-array))
  (format #t "~2Trelease-start-trigger: ~A~%" (-> this release-start-trigger))
  (format #t "~2Todd-even: ~D~%" (-> this odd-even))
  (label cfg-4)
  this
  )

;; definition (perm) for symbol *drift-editor*, type drift-editor
(define-perm *drift-editor* drift-editor #f)

;; definition for function drift-editor-init-by-other
(defbehavior drift-editor-init-by-other drift-editor ()
  (set! *drift-editor* (the-as drift-editor (process->ppointer self)))
  (set! (-> self counter) 0)
  (set! (-> self release-start-trigger) #f)
  (set! (-> self odd-even) 0)
  (set! (-> self drive-data-array) (the-as (pointer float) (malloc 'debug #x9600)))
  (set! (-> self wheel-front-left-data-array) (the-as (pointer float) (malloc 'debug #x9600)))
  (set! (-> self wheel-front-right-data-array) (the-as (pointer float) (malloc 'debug #x9600)))
  (set! (-> self wheel-rear-left-data-array) (the-as (pointer float) (malloc 'debug #x9600)))
  (set! (-> self wheel-rear-right-data-array) (the-as (pointer float) (malloc 'debug #x9600)))
  (go-virtual init-state)
  )

;; failed to figure out what this is:
(defstate init-state (drift-editor)
  :virtual #t
  :trans (behavior ()
    (if (cpad-pressed? 0 l3)
        (go-virtual run-state)
        )
    )
  :code sleep-code
  )

;; failed to figure out what this is:
(defstate run-state (drift-editor)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('die)
       (format #t "received die signal")
       (go empty-state)
       )
      )
    )
  :enter (behavior ()
    (set! (-> self editor-start-time) (the-as uint (current-time)))
    )
  :trans (behavior ()
    (if (= (-> self counter) 1200)
        (go-virtual write-file)
        )
    (cond
      ((not (logtest? (-> self odd-even) 1))
       (set! (-> self odd-even) 1)
       (if (and (cpad-pressed? 0 l3) (-> self release-start-trigger))
           (go-virtual write-file)
           (set! (-> self release-start-trigger) (the-as basic #t))
           )
       )
      (else
        (set! (-> self odd-even) 0)
        (let ((v1-16 (net-player-method-49 (-> *net-players* 0))))
          (when v1-16
            (let ((s0-0 (-> (the-as wvehicle v1-16) node-list data 3 bone transform))
                  (s1-0
                    (-> (the-as wvehicle (handle->process (-> (the-as wvehicle v1-16) wheel 0 handle)))
                        node-list
                        data
                        3
                        bone
                        transform
                        )
                    )
                  (sv-352 (-> (the-as wvehicle v1-16) node-list data 3 bone transform trans))
                  (gp-0 (- (current-time) (the-as int (-> self editor-start-time))))
                  )
              (let ((s2-0 (-> (the-as wvehicle v1-16) wheel))
                    (s3-0 (-> (the-as wvehicle v1-16) wheel 1))
                    (s4-0 (-> (the-as wvehicle v1-16) wheel 2))
                    (s5-0 (-> (the-as wvehicle v1-16) wheel 3))
                    )
                (let ((v1-17 (new 'stack-no-clear 'euler-angles)))
                  (matrix->eul (the-as euler-angles (-> v1-17 data)) s0-0 0)
                  )
                (matrix->eul
                  (the-as euler-angles (+ (+ (* (-> self counter) 32) 0) (the-as int (-> self drive-data-array))))
                  s0-0
                  20
                  )
                (set! (-> (the-as (pointer uint128) (+ (+ (* (-> self counter) 32) 16) (the-as int (-> self drive-data-array)))) 0)
                      (-> sv-352 quad)
                      )
                (set! (-> (the-as
                            (pointer uint128)
                            (+ (+ (* (-> self counter) 32) 16) (the-as int (-> self wheel-front-left-data-array)))
                            )
                          0
                          )
                      (-> s2-0 0 trans quad)
                      )
                (matrix->eul
                  (the-as euler-angles (+ (+ (* (-> self counter) 32) 0) (the-as int (-> self wheel-front-left-data-array))))
                  s1-0
                  20
                  )
                (let ((s1-1 (new 'stack-no-clear 'matrix)))
                  (eul->matrix
                    s1-1
                    (the-as euler-angles (+ (+ (* (-> self counter) 32) 0) (the-as int (-> self wheel-front-left-data-array))))
                    )
                  (set! (-> s1-1 trans quad)
                        (-> (the-as
                              (pointer uint128)
                              (+ (+ (* (-> self counter) 32) 16) (the-as int (-> self wheel-front-left-data-array)))
                              )
                            0
                            )
                        )
                  (add-debug-matrix #t (bucket-id bucket785) s1-1 (meters 2))
                  )
                (add-debug-sphere #t (bucket-id bucket793) (-> s2-0 0 trans) (meters 1) *color-red*)
                (set! (-> (the-as
                            (pointer uint128)
                            (+ (+ (* (-> self counter) 32) 16) (the-as int (-> self wheel-front-right-data-array)))
                            )
                          0
                          )
                      (-> s3-0 trans quad)
                      )
                (matrix->eul
                  (the-as euler-angles (+ (+ (* (-> self counter) 32) 0) (the-as int (-> self wheel-front-right-data-array))))
                  (quaternion->matrix (new 'stack-no-clear 'matrix) (-> s3-0 quat))
                  20
                  )
                (set! (-> (the-as
                            (pointer uint128)
                            (+ (+ (* (-> self counter) 32) 16) (the-as int (-> self wheel-rear-left-data-array)))
                            )
                          0
                          )
                      (-> s4-0 trans quad)
                      )
                (matrix->eul
                  (the-as euler-angles (+ (+ (* (-> self counter) 32) 0) (the-as int (-> self wheel-rear-left-data-array))))
                  (quaternion->matrix (new 'stack-no-clear 'matrix) (-> s4-0 quat))
                  20
                  )
                (set! (-> (the-as
                            (pointer uint128)
                            (+ (+ (* (-> self counter) 32) 16) (the-as int (-> self wheel-rear-right-data-array)))
                            )
                          0
                          )
                      (-> s5-0 trans quad)
                      )
                (matrix->eul
                  (the-as euler-angles (+ (+ (* (-> self counter) 32) 0) (the-as int (-> self wheel-rear-right-data-array))))
                  (quaternion->matrix (new 'stack-no-clear 'matrix) (-> s5-0 quat))
                  20
                  )
                )
              (let ((s5-1 (new 'stack-no-clear 'matrix)))
                (eul->matrix
                  s5-1
                  (the-as euler-angles (+ (+ (* (-> self counter) 32) 0) (the-as int (-> self drive-data-array))))
                  )
                (set! (-> s5-1 trans quad)
                      (-> (the-as (pointer uint128) (+ (+ (* (-> self counter) 32) 16) (the-as int (-> self drive-data-array)))) 0)
                      )
                (add-debug-matrix #t (bucket-id bucket785) s5-1 (meters 2))
                )
              (format
                *stdcon*
                "X = ~f~%Y = ~f~%Z = ~f~%"
                (/ (-> (&+ (-> self wheel-front-left-data-array) (* (-> self counter) 32)) 4) METER_LENGTH)
                (/ (-> (&+ (-> self wheel-front-left-data-array) (* (-> self counter) 32)) 5) METER_LENGTH)
                (/ (-> (&+ (-> self wheel-front-left-data-array) (* (-> self counter) 32)) 6) METER_LENGTH)
                )
              (format
                *stdcon*
                "X = ~f~%Y = ~f~%Z = ~f~%"
                (/ (-> (&+ (-> self drive-data-array) (* (-> self counter) 32)) 4) METER_LENGTH)
                (/ (-> (&+ (-> self drive-data-array) (* (-> self counter) 32)) 5) METER_LENGTH)
                (/ (-> (&+ (-> self drive-data-array) (* (-> self counter) 32)) 6) METER_LENGTH)
                )
              (format *stdcon* "Counter: ~D~%" (-> self counter))
              (format *stdcon* "time: ~f" (* 0.0033333334 (the float gp-0)))
              )
            (if (and (cpad-pressed? 0 l3) (-> self release-start-trigger))
                (go-virtual write-file)
                (set! (-> self release-start-trigger) (the-as basic #t))
                )
            (+! (-> self counter) 1)
            )
          )
        )
      )
    )
  :code sleep-code
  )

;; definition for method 18 of type drift-editor
;; WARN: Return type mismatch file-stream vs none.
(defmethod drift-editor-method-18 ((this drift-editor) (arg0 string) (arg1 int))
  (file-stream-open *drift-file-stream* arg0 'write)
  (dotimes (s4-0 (-> this counter))
    (format
      *drift-file-stream*
      "~d ~f ~f ~f"
      s4-0
      (/ (-> (&+ (-> this all-data-array arg1) (* s4-0 32)) 4) METER_LENGTH)
      (/ (-> (&+ (-> this all-data-array arg1) (* s4-0 32)) 5) METER_LENGTH)
      (/ (-> (&+ (-> this all-data-array arg1) (* s4-0 32)) 6) METER_LENGTH)
      )
    (format
      *drift-file-stream*
      " ~f ~f ~f~%"
      (* -0.005493164 (-> (&+ (-> this all-data-array arg1) (* s4-0 32)) 2))
      (* -0.005493164 (-> (&+ (-> this all-data-array arg1) (* s4-0 32)) 1))
      (* -0.005493164 (-> (&+ (-> this all-data-array arg1) (* s4-0 32)) 0))
      )
    )
  (file-stream-close *drift-file-stream*)
  (none)
  )

;; failed to figure out what this is:
(defstate write-file (drift-editor)
  :virtual #t
  :code (behavior ()
    (drift-editor-method-18 self "main-temp.mel" 0)
    (drift-editor-method-18 self "wheel-fl.mel" 1)
    (drift-editor-method-18 self "wheel-fr.mel" 2)
    (drift-editor-method-18 self "wheel-rl.mel" 3)
    (drift-editor-method-18 self "wheel-rr.mel" 4)
    (file-stream-open *drift-file-stream* "wheel-fl.mel" 'write)
    (dotimes (gp-0 (-> self counter))
      (format
        *drift-file-stream*
        "~d ~f ~f ~f"
        gp-0
        (/ (-> (&+ (-> self wheel-front-left-data-array) (* gp-0 32)) 4) METER_LENGTH)
        (/ (-> (&+ (-> self wheel-front-left-data-array) (* gp-0 32)) 5) METER_LENGTH)
        (/ (-> (&+ (-> self wheel-front-left-data-array) (* gp-0 32)) 6) METER_LENGTH)
        )
      (format
        *drift-file-stream*
        " ~f ~f ~f~%"
        (* -0.005493164 (-> (&+ (-> self wheel-front-left-data-array) (* gp-0 32)) 2))
        (* -0.005493164 (-> (&+ (-> self wheel-front-left-data-array) (* gp-0 32)) 1))
        (* -0.005493164 (-> (&+ (-> self wheel-front-left-data-array) (* gp-0 32)) 0))
        )
      )
    (file-stream-close *drift-file-stream*)
    )
  )

;; definition for method 7 of type drift-editor
(defmethod relocate ((this drift-editor) (offset int))
  (call-parent-method this offset)
  )

;; definition for method 10 of type drift-editor
(defmethod deactivate ((this drift-editor))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (set! *drift-editor* #f)
  (call-parent-method this)
  (none)
  )

;; definition for function start-drift
;; WARN: Return type mismatch symbol vs none.
(defun start-drift ()
  (process-spawn drift-editor :name "drift-editor" :stack *kernel-dram-stack* :stack-size #x10000)
  (none)
  )

