;; definition for function test-find-line-info
;; INFO: Used lq/sq
;; ERROR: Function may read a register that is not set: a3
;; ERROR: Function may read a register that is not set: t0
(defun test-find-line-info ((arg0 race-line))
  (local-vars (a3-0 none) (t0-0 none))
  (let ((v1-0 (new 'stack-no-clear 'race-line-query-info)))
    (set! (-> (+ (the-as uint v1-0) 112) query-position quad) (the-as uint128 0))
    (let ((a1-1 (-> v1-0 query-position))
          (a2-1 (-> (+ (the-as uint v1-0) 112) query-position quad))
          )
      (set! (-> a1-1 quad) a2-1)
      (set! (-> v1-0 angle-sum-distance) 163840.0)
      (set! (-> v1-0 look-ahead-distance) 204800.0)
      (set! (-> v1-0 current-slice) 10)
      (set! (-> v1-0 current-line) #f)
      (set! (-> v1-0 skip-gaps?) (the-as basic #t))
      (-> v1-0 query-position)
      (race-line-method-12
        arg0
        (-> v1-0 query-position)
        (the-as vector a2-1)
        (the-as int a3-0)
        (the-as symbol t0-0)
        )
      )
    )
  )

