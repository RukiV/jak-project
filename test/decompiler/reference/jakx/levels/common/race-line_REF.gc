(defun test-find-closest-point ((arg0 race-line))
  (let ((v1-0 (new 'stack-no-clear 'inline-array 'vector 2)))
    (vector-reset! (-> v1-0 1))
    (race-line-method-13 arg0 (-> v1-0 0) (-> v1-0 1) 9 #t)
    )
  )

