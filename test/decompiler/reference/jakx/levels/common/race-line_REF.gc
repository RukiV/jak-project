;;-*-Lisp-*-
(in-package goal)

;; definition for method 9 of type race-line
(defmethod race-line-method-9 ((this race-line) (arg0 int))
  (let ((v1-1 (- (-> this point-count) (-> this extra-points))))
    (while (>= arg0 v1-1)
      (set! arg0 (- arg0 v1-1))
      )
    (while (< arg0 0)
      (set! arg0 (+ arg0 v1-1))
      )
    )
  arg0
  )

;; definition of type race-line-get-points
(deftype race-line-get-points (structure)
  ((points  uint128  4)
   (index   int32)
   )
  )

;; definition for method 3 of type race-line-get-points
(defmethod inspect ((this race-line-get-points))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'race-line-get-points)
  (format #t "~1Tpoints[4] @ #x~X~%" (-> this points))
  (format #t "~1Tindex: ~D~%" (-> this index))
  (label cfg-4)
  this
  )

