    (when (>= (the-as uint (- (current-time) (the-as int (-> this disturbed-time)))) (the-as uint 600))
      (let ((f0-1 (* (vector-vector-distance-squared (-> this root trans) (camera-pos)) (square 0.00006975447))))
        (.lvf vf1 (&-> (-> this rbody ang-velocity) quad))
        (.add.w.vf.x vf2 vf0 vf0)
        (.mul.vf vf1 vf1 vf1)
        (.mul.x.vf.x acc vf2 vf1)
        (.add.mul.y.vf.x acc vf2 vf1 acc)
        (.add.mul.z.vf.x vf1 vf2 vf1 acc)
        (.mov v1-9 vf1)
        (cond
          ((and (< v1-9 f0-1) (begin
                                (.lvf vf1 (&-> (-> this rbody lin-velocity) quad))
                                (.add.w.vf.x vf2 vf0 vf0)
                                (.mul.vf vf1 vf1 vf1)
                                (.mul.x.vf.x acc vf2 vf1)
                                (.add.mul.y.vf.x acc vf2 vf1 acc)
                                (.add.mul.z.vf.x vf1 vf2 vf1 acc)
                                (.mov v1-14 vf1)
                                (< v1-14 (* f0-1 (square 614.4)))
                                )
                )
           (set! (-> this rbody lin-momentum quad) (the-as uint128 0))
           (set! (-> this rbody ang-momentum quad) (the-as uint128 0))
           (construction-object-method-91 this #f)
           (go (method-of-object this idle))
           )
          (else
            (set! (-> this disturbed-time) (the-as uint (current-time)))
            )
          )
        )
      )
    0
    (none)
    )
  )

