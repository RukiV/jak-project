;; definition for method 7 of type hud-background
;; WARN: Return type mismatch in-game-hud vs hud-background.
(defmethod relocate ((this hud-background) (offset int))
  (set! *hud-background-proc* this)
  (if (nonzero? *hud-background-proc*)
      (set! *hud-background-proc* (+ (the-as uint *hud-background-proc*) offset))
      )
  (the-as hud-background ((method-of-type in-game-hud relocate) this offset))
  )

;; definition for method 26 of type hud-background
(defmethod hud-method-26 ((this hud-background))
  (set! (-> this items) (the-as (array hud-item) *hud-background*))
  (set! (-> this manager) (new 'static 'basic-manager))
  (set! *hud-background-proc* this)
  ((method-of-type in-game-hud hud-method-26) this)
  (none)
  )

;; definition for method 10 of type hud-background
(defmethod deactivate ((this hud-background))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (set! *hud-background-proc* (the-as object #f))
  ((method-of-type in-game-hud deactivate) this)
  (none)
  )

;; definition for method 24 of type hud-background
(defmethod hud-method-24 ((this hud-background))
  (when *debug-hud*
    (set! (-> this real-items) (the-as (array hud-item) *hud-background*))
    (hud-method-26 this)
    )
  ((method-of-type in-game-hud hud-method-24) this)
  (none)
  )

;; definition for function spawn-hud-background
(defun spawn-hud-background ()
  (cond
    (*hud-background-proc*
      *hud-background-proc*
      )
    (*net-game-mgr*
      (let ((v0-0 (ppointer->process
                    (process-spawn hud-background :init hud-init-by-other :name "hud-background" :to *net-game-mgr*)
                    )
                  )
            )
        (when (the-as hud-background v0-0)
          (set! (-> (the-as hud-background v0-0) inited-strings-count) 0)
          0
          )
        v0-0
        )
      )
    (else
      #f
      )
    )
  )

