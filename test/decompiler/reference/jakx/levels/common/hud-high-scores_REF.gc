;; definition for function spawn-high-score-hud
(defun spawn-high-score-hud ()
  (when (not (or (!= (-> *net-mgr* game-type) 4)
                 (= *game-mode* 'adventure)
                 (or (and (!= (if *net-world*
                                  (the-as int (-> (the-as game-task-node-info (-> *net-world* task-node-info)) net-play-mode))
                                  18
                                  )
                              3
                              )
                          (is-nonstandard-mode?)
                          )
                     (nonzero? (-> *viewport-array* mode))
                     )
                 )
             )
    (let ((v1-16 (if *net-world*
                     (the-as int (-> (the-as game-task-node-info (-> *net-world* task-node-info)) net-play-mode))
                     18
                     )
                 )
          )
      (cond
        ((or (= v1-16 3) (or (= v1-16 13) (= v1-16 2)))
         (return (spawn-high-scores-list))
         )
        ((= v1-16 1)
         (if (= (-> *net-game-mgr* human-ct) 1)
             (return (spawn-high-scores-list))
             )
         )
        )
      )
    )
  (spawn-hud-cash-stats)
  )

;; definition for function high-scores-on?
(defun high-scores-on? ()
  (and *high-scores-list-proc* (not (cash-stats-on?)) (not (end-game-menu-on?)))
  )

;; definition for symbol *hud-background*, type object
(define *hud-background*
  (the-as object
    (new 'static 'boxed-array :type hud-item
      (new 'static 'hud-item-group
        :scale #x100
        :flags #x1080
        :effect #f
        :items (new 'static 'boxed-array :type hud-item (new 'static 'hud-results-background-item
                                                   :scale #x100
                                                   :effect #f
                                                   :items (new 'static 'boxed-array :type hud-item
                                                     (new 'static 'hud-item-sprite
                                                       :alpha #xff
                                                       :width 8
                                                       :height 8
                                                       :scale #x6000
                                                       :effect #f
                                                       :scale-y #x100
                                                       :color (new 'static 'vector4w :x 33 :y 26 :z 15 :w 64)
                                                       :tex-id #x100300
                                                       )
                                                     (new 'static 'hud-item-sprite
                                                       :alpha #x80
                                                       :width 8
                                                       :height 8
                                                       :scale #x6000
                                                       :flags 32
                                                       :effect #f
                                                       :scale-y #x2780
                                                       :color (new 'static 'vector4w :x 32 :y 32 :z 32 :w 64)
                                                       :tex-id #x100300
                                                       :sprite-flags #x400
                                                       )
                                                     (new 'static 'hud-item-sprite
                                                       :alpha #xff
                                                       :width 8
                                                       :height 8
                                                       :scale #x6000
                                                       :flags 32
                                                       :effect #f
                                                       :scale-y #x100
                                                       :color (new 'static 'vector4w :x 33 :y 26 :z 15 :w 64)
                                                       :tex-id #x100300
                                                       )
                                                     )
                                                   )
                                                 )
        )
      )
    )
  )

