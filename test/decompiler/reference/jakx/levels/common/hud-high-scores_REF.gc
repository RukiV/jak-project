(defmethod hud-item-method-19 ((this hud-high-scores))
  (let ((t9-0 (method-of-type hud-item-group hud-item-method-19)))
    (t9-0 this)
    )
  (when (cpad-pressed? (view-get-active-index) x)
    (logclear! (-> *cpad-list* cpads (view-get-active-index) button0-abs 0) (pad-buttons x))
    (logclear! (-> *cpad-list* cpads (view-get-active-index) button0-rel 0) (pad-buttons x))
    (case (if *net-world*
              (the-as int (-> (the-as game-task-node-info (-> *net-world* task-node-info)) net-play-mode))
              18
              )
      ((3)
       (when (spawn-hud-game-end)
         (let ((v1-27 (make-sound-instance (-> *sound-info* 315) (new 'static 'sound-id) (the-as handle #f))))
           (cond
             (v1-27
               (logior! (-> v1-27 flags) 320)
               (-> v1-27 id)
               )
             (else
               0
               )
             )
           )
         )
       )
      (else
        (when (spawn-hud-cash-stats)
          (let ((v1-32 (make-sound-instance (-> *sound-info* 315) (new 'static 'sound-id) (the-as handle #f))))
            (cond
