;; definition for method 3 of type high-scores-list
(defmethod inspect ((this high-scores-list))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type in-game-hud inspect)))
    (t9-0 this)
    )
  (label cfg-4)
  this
  )

;; definition for method 7 of type high-scores-list
;; WARN: Return type mismatch in-game-hud vs high-scores-list.
(defmethod relocate ((this high-scores-list) (offset int))
  (set! *high-scores-list-proc* this)
  (if (nonzero? *high-scores-list-proc*)
      (set! *high-scores-list-proc* (+ (the-as uint *high-scores-list-proc*) offset))
      )
  (the-as high-scores-list ((method-of-type in-game-hud relocate) this offset))
  )

;; definition for method 26 of type high-scores-list
(defmethod hud-method-26 ((this high-scores-list))
  (set! (-> this items) (the-as (array hud-item) *high-scores-list*))
  (set! (-> this manager) (new 'static 'basic-manager))
  (set! *high-scores-list-proc* this)
  ((method-of-type in-game-hud hud-method-26) this)
  (none)
  )

;; definition for method 10 of type high-scores-list
(defmethod deactivate ((this high-scores-list))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (set! *high-scores-list-proc* (the-as object #f))
  ((method-of-type in-game-hud deactivate) this)
  (none)
  )

;; definition for method 24 of type high-scores-list
(defmethod hud-method-24 ((this high-scores-list))
  (when *debug-hud*
    (set! (-> this real-items) (the-as (array hud-item) *high-scores-list*))
    (hud-method-26 this)
    )
  ((method-of-type in-game-hud hud-method-24) this)
  (none)
  )

;; definition for function spawn-high-scores-list
(defun spawn-high-scores-list ()
  (cond
    (*high-scores-list-proc*
      *high-scores-list-proc*
      )
    (*net-game-mgr*
      (let ((v0-0 (ppointer->process
                    (process-spawn high-scores-list :init hud-init-by-other :name "high-scores-list" :to *net-game-mgr*)
                    )
                  )
            )
        (when (the-as high-scores-list v0-0)
          (set! (-> (the-as high-scores-list v0-0) inited-strings-count) 0)
          0
          )
        v0-0
        )
      )
    (else
      #f
      )
    )
  )

