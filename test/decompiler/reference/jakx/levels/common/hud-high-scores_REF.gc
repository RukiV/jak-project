;; definition for method 19 of type hud-high-score
(defmethod hud-item-method-19 ((this hud-high-score))
  (let ((a0-1 (get-open-task-node-info))
        (v1-1 (the-as object (-> *net-players* 0)))
        )
    (when (the-as net-player v1-1)
      (when a0-1
        (when (nonzero? (-> a0-1 high-scores))
          (let ((s5-0 (the-as hud-item-string (-> this items 1)))
                (a1-8 (if *net-world*
                          (the-as int (-> (the-as game-task-node-info (-> *net-world* task-node-info)) net-play-mode))
                          18
                          )
                      )
                )
            (cond
              ((or (zero? a1-8) (or (= a1-8 3) (= a1-8 2)))
               (let ((s4-0 (-> a0-1 high-scores)))
                 (if (or (and (and (!= (if *net-world*
                                           (the-as int (-> (the-as game-task-node-info (-> *net-world* task-node-info)) net-play-mode))
                                           18
                                           )
                                       3
                                       )
                                   (!= (if *net-world*
                                           (the-as int (-> (the-as game-task-node-info (-> *net-world* task-node-info)) net-play-mode))
                                           18
                                           )
                                       2
                                       )
                                   )
                              (= (-> s4-0 (-> this position)) (the float (-> (the-as net-player v1-1) score)))
                              )
                         (and (or (= (if *net-world*
                                         (the-as int (-> (the-as game-task-node-info (-> *net-world* task-node-info)) net-play-mode))
                                         18
                                         )
                                     3
                                     )
                                  (= (if *net-world*
                                         (the-as int (-> (the-as game-task-node-info (-> *net-world* task-node-info)) net-play-mode))
                                         18
                                         )
                                     2
                                     )
                                  )
                              (let* ((f0-2 (* 100.0 (fabs (-> s4-0 (-> this position)))))
                                     (f0-6 (the float (the int (+ 0.5 f0-2))))
                                     (f1-5 0.33333334)
                                     (v1-3 (abs (-> (the-as (pointer int32) v1-1) 109)))
                                     (f1-6 (* f1-5 (the float v1-3)))
                                     )
                                (= f0-6 (the float (the int (+ 0.5 f1-6))))
                                )
                              )
                         )
                     (hud-item-method-27 (the-as hud-item-string (-> this items 1)) 56)
                     (hud-item-method-27 (the-as hud-item-string (-> this items 1)) 5)
                     )
                 (let ((s3-0 print-time)
                       (a0-37 (clear *temp-string*))
                       (f0-7 3.0)
                       (f1-12 (* 100.0 (fabs (-> s4-0 (-> this position)))))
                       )
                   (s3-0 a0-37 (the-as time-frame (the int (* f0-7 (the float (the int (+ 0.5 f1-12)))))))
                   )
                 )
               (hud-item-method-24 s5-0 *temp-string*)
               )
              (else
                (let ((s4-1 (-> a0-1 high-scores)))
                  (if (= (fabs (-> s4-1 (-> this position))) (the float (-> (the-as net-player v1-1) score)))
                      (hud-item-method-27 (the-as hud-item-string (-> this items 1)) 56)
                      (hud-item-method-27 (the-as hud-item-string (-> this items 1)) 5)
                      )
                  (hud-item-method-26 s5-0 (the int (fabs (-> s4-1 (-> this position)))))
                  )
                )
              )
            )
          )
        )
      )
    )
  (let ((t9-9 (method-of-type hud-item-group hud-item-method-19)))
    (t9-9 this)
    )
  (hud-item-method-12 this)
  (hud-item-method-14 this)
  (hud-item-method-13 this)
  (none)
  )

