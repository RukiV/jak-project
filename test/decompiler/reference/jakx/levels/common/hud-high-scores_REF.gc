    )
  (when (cpad-pressed? (view-get-active-index) triangle)
    (logclear! (-> *cpad-list* cpads (view-get-active-index) button0-abs 0) (pad-buttons triangle))
    (logclear! (-> *cpad-list* cpads (view-get-active-index) button0-rel 0) (pad-buttons triangle))
    (let ((v1-56 (make-sound-instance (-> *sound-info* 315) (new 'static 'sound-id) (the-as handle #f))))
      (cond
        (v1-56
          (logior! (-> v1-56 flags) 320)
          (-> v1-56 id)
          )
        (else
