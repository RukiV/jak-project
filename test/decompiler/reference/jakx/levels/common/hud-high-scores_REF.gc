;; definition for function spawn-hud-results-background
(defun spawn-hud-results-background ()
  (let ((v1-1 (-> *viewport-array* mode)))
    (cond
      ((zero? v1-1)
       (spawn-hud-background)
       )
      ((= v1-1 1)
       (if (zero? (view-get-active-index))
           (spawn-hud-background-top-view-0)
           (spawn-hud-background-top-view-1)
           )
       )
      ((= v1-1 2)
       (if (zero? (view-get-active-index))
           (spawn-hud-background-side-view-0)
           (spawn-hud-background-side-view-1)
           )
       )
      )
    )
  )
