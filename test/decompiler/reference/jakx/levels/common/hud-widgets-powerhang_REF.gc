;; definition for symbol *power-slide-hud-single-proc*, type power-slide-hud-single
(define *power-slide-hud-single-proc* (the-as power-slide-hud-single #f))

;; definition of type power-slide-hud-single
(deftype power-slide-hud-single (in-game-hud)
  ()
  )

;; definition for method 3 of type power-slide-hud-single
(defmethod inspect ((this power-slide-hud-single))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
