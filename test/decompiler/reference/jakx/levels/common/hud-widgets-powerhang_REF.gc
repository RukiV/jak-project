;; definition for method 7 of type power-slide-hud-single
;; WARN: Return type mismatch in-game-hud vs power-slide-hud-single.
(defmethod relocate ((this power-slide-hud-single) (offset int))
  (set! *power-slide-hud-single-proc* this)
  (if (nonzero? *power-slide-hud-single-proc*)
      (set! *power-slide-hud-single-proc* (&+ *power-slide-hud-single-proc* offset))
      )
  (the-as power-slide-hud-single ((method-of-type in-game-hud relocate) this offset))
  )

;; definition for method 26 of type power-slide-hud-single
(defmethod hud-method-26 ((this power-slide-hud-single))
  (set! (-> this items) *power-slide-hud-single*)
  (set! (-> this manager) (new 'static 'basic-manager))
  (set! *power-slide-hud-single-proc* this)
  ((method-of-type in-game-hud hud-method-26) this)
  (none)
  )

;; definition for method 10 of type power-slide-hud-single
(defmethod deactivate ((this power-slide-hud-single))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (set! *power-slide-hud-single-proc* #f)
  ((method-of-type in-game-hud deactivate) this)
  (none)
  )

;; definition for method 24 of type power-slide-hud-single
(defmethod hud-method-24 ((this power-slide-hud-single))
  (when *debug-hud*
    (set! (-> this real-items) *power-slide-hud-single*)
    (hud-method-26 this)
    )
  ((method-of-type in-game-hud hud-method-24) this)
  (none)
  )

;; definition for function spawn-power-slide-hud-single
;; WARN: Return type mismatch process vs object.
(defun spawn-power-slide-hud-single ()
  (cond
    (*power-slide-hud-single-proc*
      *power-slide-hud-single-proc*
      )
    (*net-game-mgr*
      (let ((v0-0 (ppointer->process (process-spawn
                                       power-slide-hud-single
                                       :init hud-init-by-other
                                       :name "power-slide-hud-single"
                                       :to *net-game-mgr*
                                       )
                                     )
                  )
            )
        (when (the-as power-slide-hud-single v0-0)
          (set! (-> (the-as power-slide-hud-single v0-0) inited-strings-count) 0)
          0
          )
        v0-0
        )
      )
    (else
      (the-as process #f)
      )
    )
  )

