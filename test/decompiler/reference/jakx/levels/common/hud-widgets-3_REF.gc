;;-*-Lisp-*-
(in-package goal)

;; definition of type hud-points-combo
(deftype hud-points-combo (hud-item-group)
  ((combo-points       int32)
   (combo-size         int32)
   (since-update-time  int32)
   (since-exit-time    int32)
   (sent-exit-event    basic)
   )
  )

;; definition for method 3 of type hud-points-combo
(defmethod inspect ((this hud-points-combo))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this (-> this type))
  (format #t "~1Talpha: ~D~%" (-> this alpha))
  (format #t "~1Treal-alpha: ~D~%" (-> this real-alpha))
  (format #t "~1Tposition-x: ~D~%" (-> this position-x))
  (format #t "~1Tposition-y: ~D~%" (-> this position-y))
  (format #t "~1Treal-position-x: ~D~%" (-> this real-position-x))
  (format #t "~1Treal-position-y: ~D~%" (-> this real-position-y))
  (format #t "~1Twidth: ~D~%" (-> this width))
  (format #t "~1Theight: ~D~%" (-> this height))
  (format #t "~1Treal-width: ~D~%" (-> this real-width))
  (format #t "~1Treal-height: ~D~%" (-> this real-height))
  (format #t "~1Tzval: ~D~%" (-> this zval))
  (format #t "~1Treal-scale: ~D~%" (-> this real-scale))
  (format #t "~1Tscale: ~D~%" (-> this scale))
  (format #t "~1Tflags: ~D~%" (-> this flags))
  (format #t "~1Teffect: ~A~%" (-> this effect))
  (format #t "~1Tparent: ~A~%" (-> this parent))
  (format #t "~1Titems: ~A~%" (-> this items))
  (format #t "~1Tcombo-points: ~D~%" (-> this combo-points))
  (format #t "~1Tcombo-size: ~D~%" (-> this combo-size))
  (format #t "~1Tsince-update-time: ~D~%" (-> this since-update-time))
  (format #t "~1Tsince-exit-time: ~D~%" (-> this since-exit-time))
  (format #t "~1Tsent-exit-event: ~A~%" (-> this sent-exit-event))
  (label cfg-4)
  this
  )

;; definition for method 9 of type hud-points-combo
(defmethod hud-item-method-9 ((this hud-points-combo))
  (set! (-> this combo-points) 0)
  (set! (-> this since-update-time) (- (- (if *net-mgr*
                                              (-> *net-mgr* game-state time)
                                              0
                                              )
                                          (if *net-world*
                                              (-> *net-world* net-state game-start-time)
                                              0
                                              )
                                          )
                                       (if *net-world*
                                           (-> *net-world* net-state total-pause-time)
                                           0
                                           )
                                       )
        )
  (set! (-> this sent-exit-event) #f)
  (set! (-> this since-exit-time) -1)
  ((method-of-type hud-item-group hud-item-method-9) this)
  (none)
  )

;; definition for method 19 of type hud-points-combo
(defmethod hud-item-method-19 ((this hud-points-combo))
  (hud-item-string-method-26 (-> this items 1) (-> this combo-size))
  (when (and (= -1 (-> this since-exit-time)) (< 600 (- (- (- (if *net-mgr*
                                                                  (-> *net-mgr* game-state time)
                                                                  0
                                                                  )
                                                              (if *net-world*
                                                                  (-> *net-world* net-state game-start-time)
                                                                  0
                                                                  )
                                                              )
                                                           (if *net-world*
                                                               (-> *net-world* net-state total-pause-time)
                                                               0
                                                               )
                                                           )
                                                        (-> this since-update-time)
                                                        )
                                                 )
             )
    (send-event *current-hud* 'kill-hud 0)
    (set! (-> this since-exit-time) (- (- (if *net-mgr*
                                              (-> *net-mgr* game-state time)
                                              0
                                              )
                                          (if *net-world*
                                              (-> *net-world* net-state game-start-time)
                                              0
                                              )
                                          )
                                       (if *net-world*
                                           (-> *net-world* net-state total-pause-time)
                                           0
                                           )
                                       )
          )
    )
  (when (and (!= -1 (-> this since-exit-time))
             (< 120 (- (- (- (if *net-mgr*
                                 (-> *net-mgr* game-state time)
                                 0
                                 )
                             (if *net-world*
                                 (-> *net-world* net-state game-start-time)
                                 0
                                 )
                             )
                          (if *net-world*
                              (-> *net-world* net-state total-pause-time)
                              0
                              )
                          )
                       (-> this since-exit-time)
                       )
                )
             (not (-> this sent-exit-event))
             )
    (set! (-> this sent-exit-event) (the-as basic #t))
    (send-event
      (handle->process (-> *net-game-mgr* stats-hud (view-get-active-index)))
      'update-score
      (view-get-active-index)
      (-> this combo-points)
      )
    (send-event (handle->process (-> *net-game-mgr* stats-hud (view-get-active-index))) 'update-score-sound2)
    )
  ((method-of-type hud-item-group hud-item-method-19) this)
  (none)
  )

;; definition for method 23 of type hud-points-combo
(defmethod hud-item-method-23 ((this hud-points-combo) (arg0 object) (arg1 object) (arg2 object) (arg3 object))
  (case arg2
    (('update-score)
     (let ((v1-2 (-> (the-as event-message-block arg3) param 0))
           (t1-2 (-> *current-hud* view))
           )
       (when (= (if t1-2
                    (-> t1-2 index)
                    -1
                    )
                v1-2
                )
         (set! (-> this since-update-time) (- (- (if *net-mgr*
                                                     (-> *net-mgr* game-state time)
                                                     0
                                                     )
                                                 (if *net-world*
                                                     (-> *net-world* net-state game-start-time)
                                                     0
                                                     )
                                                 )
                                              (if *net-world*
                                                  (-> *net-world* net-state total-pause-time)
                                                  0
                                                  )
                                              )
               )
         (set! (-> this combo-points) (the-as int (-> (the-as event-message-block arg3) param 1)))
         (set! (-> this combo-size) (the-as int (-> (the-as event-message-block arg3) param 2)))
         )
       )
     )
    )
  ((method-of-type hud-item-group hud-item-method-23) this arg0 arg1 arg2 arg3)
  (none)
  )

;; definition for symbol *hud-points-combo-display0*, type object
(define *hud-points-combo-display0*
  (the-as object
    (new 'static 'boxed-array :type hud-item
      (new 'static 'hud-points-combo
        :scale #x100
        :flags #x20480
        :effect #f
        :items (new 'static 'boxed-array :type hud-item
          (new 'static 'hud-item-string
            :alpha #xff
            :width #xfa
            :height 30
            :zval #xfff0
            :scale #x73
            :flags #x80
            :effect (new 'static 'hud-effect-group
              :items (new 'static 'boxed-array :type hud-effect
                (new 'static 'hud-effect-font-effect :message 'enter :font-effect #xb)
                (new 'static 'hud-effect-font-effect :message 'update-score :font-effect #x12)
                (new 'static 'hud-effect-font-effect :message 'exit :font-effect #xf)
                (new 'static 'hud-effect-offscreen :message 'exit :delay #x12c :offscreen-type #x1)
                )
              )
            :text-id #x76d
            :font-effect #x8
            :color #x5
            :font-flags #x4
            :has-outline #t
            )
          (new 'static 'hud-item-string
            :alpha #xff
            :position-y 5
            :width 50
            :height 30
            :zval #xfff0
            :scale #xcc
            :flags #xa0
            :effect (new 'static 'hud-effect-group
              :items (new 'static 'boxed-array :type hud-effect
                (new 'static 'hud-effect-font-effect :message 'enter :font-effect #xb)
                (new 'static 'hud-effect-font-effect :message 'update-score :font-effect #x12)
                (new 'static 'hud-effect-slide :message 'exit :slide-time 150.0 :message-is-enter #f)
                (new 'static 'hud-effect-font-effect :message 'exit)
                (new 'static 'hud-effect-fade :message 'exit :fade-time 300.0 :fade-out-on 'exit)
                (new 'static 'hud-effect-offscreen :message 'exit :delay #x12c :offscreen-type #x1)
                )
              )
            :font-effect #x8
            :color #x1
            :font-flags #x4
            :has-outline #t
            )
          )
        )
      )
    )
  )

;; definition for symbol *hud-points-combo-display0-proc*, type object
(define *hud-points-combo-display0-proc* (the-as object #f))

;; definition of type hud-points-combo-display0
(deftype hud-points-combo-display0 (in-game-hud)
  ()
  )

;; definition for method 3 of type hud-points-combo-display0
(defmethod inspect ((this hud-points-combo-display0))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type in-game-hud inspect)))
    (t9-0 this)
    )
  (label cfg-4)
  this
  )

;; definition for method 7 of type hud-points-combo-display0
;; WARN: Return type mismatch in-game-hud vs hud-points-combo-display0.
(defmethod relocate ((this hud-points-combo-display0) (offset int))
  (set! *hud-points-combo-display0-proc* this)
  (if (nonzero? *hud-points-combo-display0-proc*)
      (set! *hud-points-combo-display0-proc* (+ (the-as uint *hud-points-combo-display0-proc*) offset))
      )
  (the-as hud-points-combo-display0 ((method-of-type in-game-hud relocate) this offset))
  )

;; definition for method 26 of type hud-points-combo-display0
(defmethod hud-method-26 ((this hud-points-combo-display0))
  (set! (-> this items) (the-as (array hud-item) *hud-points-combo-display0*))
  (set! (-> this manager) (new 'static 'basic-manager))
  (set! *hud-points-combo-display0-proc* this)
  ((method-of-type in-game-hud hud-method-26) this)
  (none)
  )

;; definition for method 10 of type hud-points-combo-display0
(defmethod deactivate ((this hud-points-combo-display0))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (set! *hud-points-combo-display0-proc* (the-as object #f))
  ((method-of-type in-game-hud deactivate) this)
  (none)
  )

;; definition for method 24 of type hud-points-combo-display0
(defmethod hud-method-24 ((this hud-points-combo-display0))
  (when *debug-hud*
    (set! (-> this real-items) (the-as (array hud-item) *hud-points-combo-display0*))
    (hud-method-26 this)
    )
  ((method-of-type in-game-hud hud-method-24) this)
  (none)
  )

;; definition for function spawn-hud-points-combo-display0
(defun spawn-hud-points-combo-display0 ()
  (cond
    (*hud-points-combo-display0-proc*
      *hud-points-combo-display0-proc*
      )
    (*net-game-mgr*
      (let ((v0-0 (ppointer->process (process-spawn
                                       hud-points-combo-display0
                                       :init hud-init-by-other
                                       :name "hud-points-combo-display0"
                                       :to *net-game-mgr*
                                       )
                                     )
                  )
            )
        (when (the-as hud-points-combo-display0 v0-0)
          (set! (-> (the-as hud-points-combo-display0 v0-0) inited-strings-count) 0)
          0
          )
        v0-0
        )
      )
    (else
      #f
      )
    )
  )

