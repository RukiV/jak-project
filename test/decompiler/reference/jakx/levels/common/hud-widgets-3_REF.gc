;; definition of type hud-points-icon
(deftype hud-points-icon (hud-item-group)
  ((start        vector  :inline)
   (end          vector  :inline)
   (position     vector  :inline)
   (sent-exit    basic)
   (sent-update  basic)
   (move-time    int32)
   (points       int32)
   (min-scale    float)
   )
  )

;; definition for method 3 of type hud-points-icon
(defmethod inspect ((this hud-points-icon))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this (-> this type))
  (format #t "~1Talpha: ~D~%" (-> this alpha))
  (format #t "~1Treal-alpha: ~D~%" (-> this real-alpha))
  (format #t "~1Tposition-x: ~D~%" (-> this position-x))
  (format #t "~1Tposition-y: ~D~%" (-> this position-y))
  (format #t "~1Treal-position-x: ~D~%" (-> this real-position-x))
  (format #t "~1Treal-position-y: ~D~%" (-> this real-position-y))
  (format #t "~1Twidth: ~D~%" (-> this width))
  (format #t "~1Theight: ~D~%" (-> this height))
  (format #t "~1Treal-width: ~D~%" (-> this real-width))
  (format #t "~1Treal-height: ~D~%" (-> this real-height))
  (format #t "~1Tzval: ~D~%" (-> this zval))
  (format #t "~1Treal-scale: ~D~%" (-> this real-scale))
  (format #t "~1Tscale: ~D~%" (-> this scale))
  (format #t "~1Tflags: ~D~%" (-> this flags))
  (format #t "~1Teffect: ~A~%" (-> this effect))
  (format #t "~1Tparent: ~A~%" (-> this parent))
  (format #t "~1Titems: ~A~%" (-> this items))
  (format #t "~1Tstart: #<vector @ #x~X>~%" (-> this start))
  (format #t "~1Tend: #<vector @ #x~X>~%" (-> this end))
  (format #t "~1Tposition: #<vector @ #x~X>~%" (-> this position))
  (format #t "~1Tsent-exit: ~A~%" (-> this sent-exit))
  (format #t "~1Tsent-update: ~A~%" (-> this sent-update))
  (format #t "~1Tmove-time: ~D~%" (-> this move-time))
  (format #t "~1Tpoints: ~D~%" (-> this points))
  (format #t "~1Tmin-scale: ~f~%" (-> this min-scale))
  (label cfg-4)
  this
  )

;; definition for method 18 of type hud-points-icon
(defmethod hud-item-method-18 ((this hud-points-icon) (arg0 hud-item) (arg1 vector) (arg2 float))
  (set! (-> this position-x) (the int (-> this position x)))
  (set! (-> this position-y) (the int (-> this position y)))
  ((method-of-type hud-item-group hud-item-method-18) this arg0 arg1 arg2)
  (none)
  )

;; definition for method 19 of type hud-points-icon
(defmethod hud-item-method-19 ((this hud-points-icon))
  (when (< (-> this move-time) (- (- (if *net-mgr*
                                         (-> *net-mgr* game-state time)
                                         0
                                         )
                                     (if *net-world*
                                         (-> *net-world* net-state game-start-time)
                                         0
                                         )
                                     )
                                  (if *net-world*
                                      (-> *net-world* net-state total-pause-time)
                                      0
                                      )
                                  )
           )
    (let* ((s5-0 (- (- (- (if *net-mgr*
                              (-> *net-mgr* game-state time)
                              0
                              )
                          (if *net-world*
                              (-> *net-world* net-state game-start-time)
                              0
                              )
                          )
                       (if *net-world*
                           (-> *net-world* net-state total-pause-time)
                           0
                           )
                       )
                    (-> this move-time)
                    )
                 )
           (f30-0 (square (fmin 1.0 (* 0.006666667 (the float s5-0)))))
           )
      (when (and (not (-> this sent-exit)) (< 90 s5-0))
        (send-event *current-hud* 'kill-hud 0)
        (set! (-> this sent-exit) (the-as basic #t))
        )
      (when (and (not (-> this sent-update)) (< 150 s5-0))
        (send-event
          (handle->process (-> *net-game-mgr* stats-hud (view-get-active-index)))
          'update-score
          (view-get-active-index)
          (-> this points)
          )
        (send-event (handle->process (-> *net-game-mgr* stats-hud (view-get-active-index))) 'update-score-sound1)
        (send-event *net-game-mgr* 'update-score (view-get-active-index) (-> this points))
        (set! (-> this sent-update) (the-as basic #t))
        )
      (set! (-> this scale) (the int (* 256.0 (lerp (-> this min-scale) 1.0 f30-0))))
      (vector-lerp! (-> this position) (-> this start) (-> this end) f30-0)
      )
    )
  ((method-of-type hud-item-group hud-item-method-19) this)
  (none)
  )

;; definition for function change-to-screen-space
(defun change-to-screen-space ((arg0 vector) (arg1 float))
  (transform-point-vector! arg0 arg0)
  (let ((v1-1 (-> *viewport-array* mode)))
    (cond
      ((zero? v1-1)
       (+! (-> arg0 x) (- -1792.0 (the float (the int (+ 17.5 (* 17.5 arg1))))))
       (set! (-> arg0 y) (+ (- -1840.0 (the float (the int (+ 12.5 (* 12.5 arg1))))) (-> arg0 y)))
       )
      ((= v1-1 1)
       (cond
         ((zero? (view-get-active-index))
          (+! (-> arg0 x) (- -1792.0 (the float (the int (+ 17.5 (* 17.5 arg1))))))
          (set! (-> arg0 y) (+ (- -1840.0 (the float (the int (+ 12.5 (* 12.5 arg1))))) (-> arg0 y)))
          )
         (else
           (+! (-> arg0 x) (- -1792.0 (the float (the int (+ 17.5 (* 17.5 arg1))))))
           (set! (-> arg0 y) (+ (- -1648.0 (the float (the int (+ 12.5 (* 12.5 arg1))))) (-> arg0 y)))
           )
         )
       )
      ((zero? (view-get-active-index))
       (+! (-> arg0 x) (- -1762.0 (the float (the int (+ 17.5 (* 17.5 arg1))))))
       (set! (-> arg0 y) (+ (- -1840.0 (the float (the int (+ 12.5 (* 12.5 arg1))))) (-> arg0 y)))
       )
      (else
        (+! (-> arg0 x) (- -1416.0 (the float (the int (+ 17.5 (* 17.5 arg1))))))
        (set! (-> arg0 y) (+ (- -1840.0 (the float (the int (+ 12.5 (* 12.5 arg1))))) (-> arg0 y)))
        )
      )
    )
  )

;; definition for method 23 of type hud-points-icon
;; INFO: Used lq/sq
(defmethod hud-item-method-23 ((this hud-points-icon) (arg0 object) (arg1 object) (arg2 object) (arg3 object))
  (case arg2
    (('travel)
     (set! (-> this position quad) (-> (the-as vector (-> (the-as event-message-block arg3) param 0)) quad))
     (let* ((f0-0 (vector-vector-distance (-> (view-get-active-math-camera) inv-camera-rot trans) (-> this position)))
            (f30-0 (square (lerp-scale 0.5 1.0 f0-0 409600.0 20480.0)))
            )
       (set! (-> this min-scale) f30-0)
       (set! (-> this scale) (the int (* 256.0 f30-0)))
       (let ((a0-6 (-> (the-as event-message-block arg3) param 3)))
         (view-push-context (the-as int a0-6))
         )
       (change-to-screen-space (-> this position) f30-0)
       )
     (view-pop-context)
     (set! (-> this start quad) (-> this position quad))
     (set! (-> this end quad) (-> (the-as vector (-> (the-as event-message-block arg3) param 1)) quad))
     (let* ((s4-1 (-> this items 0))
            (s3-0 (method-of-object (the-as hud-item-string s4-1) hud-item-string-method-24))
            )
       (format (clear *temp-string*) "+ ~D" (-> (the-as event-message-block arg3) param 2))
       (s3-0 (the-as hud-item-string s4-1) *temp-string*)
       )
     (set! (-> this points) (the-as int (-> (the-as event-message-block arg3) param 2)))
     (set! (-> this move-time) (+ (- (- 37 (if *net-world*
                                               (-> *net-world* net-state total-pause-time)
                                               0
                                               )
                                        )
                                     (if *net-world*
                                         (-> *net-world* net-state game-start-time)
                                         0
                                         )
                                     )
                                  (if *net-mgr*
                                      (-> *net-mgr* game-state time)
                                      0
                                      )
                                  )
           )
     (set! (-> this sent-exit) #f)
     (set! (-> this sent-update) #f)
     )
    (('travel-in-screen-space)
     (set! (-> this position quad) (-> (the-as vector (-> (the-as event-message-block arg3) param 0)) quad))
     (set! (-> this min-scale) 1.0)
     (set! (-> this scale) 256)
     (set! (-> this start quad) (-> (the-as vector (-> this position)) quad))
     (set! (-> this end quad) (-> (the-as vector (-> (the-as event-message-block arg3) param 1)) quad))
     (let* ((s4-2 (-> this items 0))
            (s3-1 (method-of-object (the-as hud-item-string s4-2) hud-item-string-method-24))
            )
       (format (clear *temp-string*) "+ ~D" (-> (the-as event-message-block arg3) param 2))
       (s3-1 (the-as hud-item-string s4-2) *temp-string*)
       )
     (set! (-> this points) (the-as int (-> (the-as event-message-block arg3) param 2)))
     (set! (-> this move-time) (+ (- (- 37 (if *net-world*
                                               (-> *net-world* net-state total-pause-time)
                                               0
                                               )
                                        )
                                     (if *net-world*
                                         (-> *net-world* net-state game-start-time)
                                         0
                                         )
                                     )
                                  (if *net-mgr*
                                      (-> *net-mgr* game-state time)
                                      0
                                      )
                                  )
           )
     (set! (-> this sent-exit) #f)
     (set! (-> this sent-update) #f)
     )
    (else
      ((method-of-type hud-item-group hud-item-method-23) this arg0 arg1 arg2 arg3)
      )
    )
  (none)
  )

