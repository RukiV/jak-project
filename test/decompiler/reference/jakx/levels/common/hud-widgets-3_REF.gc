;; definition of type text-display-manager
(deftype text-display-manager (basic-manager)
  ()
  )

;; definition for method 3 of type text-display-manager
(defmethod inspect ((this text-display-manager))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this (-> this type))
  (format #t "~1Texit-start-time: ~D~%" (-> this exit-start-time))
  (format #t "~1Texit-time: ~D~%" (-> this exit-time))
  (format #t "~1Tprevious-time: ~D~%" (-> this previous-time))
  (label cfg-4)
  this
  )

;; definition for method 9 of type text-display-manager
;; WARN: Return type mismatch int vs none.
(defmethod hud-manager-method-9 ((this text-display-manager))
  (let ((t9-0 (method-of-type basic-manager hud-manager-method-9)))
    (t9-0 this)
    )
  (set! (-> this exit-start-time) (- (- (if *net-mgr*
                                            (-> *net-mgr* game-state time)
                                            0
                                            )
                                        (if *net-world*
                                            (-> *net-world* net-state game-start-time)
                                            0
                                            )
                                        )
                                     (if *net-world*
                                         (-> *net-world* net-state total-pause-time)
                                         0
                                         )
                                     )
        )
  (set! (-> this exit-time) 600)
  (set! (-> this previous-time) (- (- (if *net-mgr*
                                          (-> *net-mgr* game-state time)
                                          0
                                          )
                                      (if *net-world*
                                          (-> *net-world* net-state game-start-time)
                                          0
                                          )
                                      )
                                   (if *net-world*
                                       (-> *net-world* net-state total-pause-time)
                                       0
                                       )
                                   )
        )
  (none)
  )

