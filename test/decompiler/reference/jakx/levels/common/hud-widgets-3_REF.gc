;; definition for function set-to-upper-right
;; WARN: Return type mismatch vector vs object.
(defun set-to-upper-right ((arg0 vector))
  (let ((v1-1 (-> *viewport-array* mode)))
    (cond
      ((zero? v1-1)
       (set! (-> arg0 x) 440.0)
       (set! (-> arg0 y) 30.0)
       (set! (-> arg0 z) 0.0)
       (set! (-> arg0 w) 1.0)
       )
      ((= v1-1 1)
       (cond
         ((zero? (view-get-active-index))
          (set! (-> arg0 x) 440.0)
          (set! (-> arg0 y) 30.0)
          (set! (-> arg0 z) 0.0)
          (set! (-> arg0 w) 1.0)
          )
         (else
           (set! (-> arg0 x) 440.0)
           (set! (-> arg0 y) 222.0)
           (set! (-> arg0 z) 0.0)
           (set! (-> arg0 w) 1.0)
           )
         )
       )
      ((zero? (view-get-active-index))
       (set! (-> arg0 x) 184.0)
       (set! (-> arg0 y) 30.0)
       (set! (-> arg0 z) 0.0)
       (set! (-> arg0 w) 1.0)
       )
      (else
        (set! (-> arg0 x) 540.0)
        (set! (-> arg0 y) 30.0)
        (set! (-> arg0 z) 0.0)
        (set! (-> arg0 w) 1.0)
        )
      )
    )
  arg0
  )

;; definition for function create-points-icon-from-screen-pos
;; INFO: Used lq/sq
;; WARN: Return type mismatch int vs object.
(defun create-points-icon-from-screen-pos ((arg0 vector2) (arg1 int) (arg2 vector))
  (let ((s4-0 (new 'stack-no-clear 'vector)))
    (if arg2
        (set! (-> s4-0 quad) (-> arg2 quad))
        (set-to-upper-right s4-0)
        )
    (let ((a0-4 (spawn-unused-hud-points-icon-display)))
      (send-event (the-as process-tree a0-4) 'travel-in-screen-space arg0 s4-0 arg1)
      )
    )
  0
  )

;; definition for function create-points-icon
;; INFO: Used lq/sq
(defun create-points-icon ((arg0 process-drawable) (arg1 object) (arg2 vector))
  (let ((s5-0 (new 'stack-no-clear 'vector))
        (s4-0 (new 'stack-no-clear 'vector))
        )
    (when arg0
      (set! (-> s4-0 quad) (-> arg0 root trans quad))
      (+! (-> s4-0 y) 16384.0)
      (if arg2
          (set! (-> s5-0 quad) (-> arg2 quad))
          (set-to-upper-right s5-0)
          )
      (let ((s3-0 (spawn-unused-hud-points-icon-display)))
        (send-event (the-as process-tree s3-0) 'travel s4-0 s5-0 arg1 (view-get-active-index))
        )
      )
    )
  )
