;; definition for function vehicle-antenna-init-by-other
;; INFO: Used lq/sq
;; WARN: Return type mismatch object vs none.
(defbehavior vehicle-antenna-init-by-other vehicle-antenna ((arg0 vehicle-antenna-init-params))
  (stack-size-set! (-> self main-thread) 16)
  (set! (-> self root) (new 'process 'trsqv))
  (set-vector! (-> self root scale) 1.0 1.0 1.0 1.0)
  (set! (-> self level) (-> *level* level-default))
  (set! (-> self attach-local-pos quad) (-> arg0 pos quad))
  (quaternion-axis-angle! (-> self attach-rot) 1.0 0.0 0.0 (-> arg0 tilt))
  (when (-> arg0 vehicle)
    (set! (-> self vehicle) (process->handle (-> arg0 vehicle)))
    (vehicle-antenna-method-53 self)
    (let ((v1-19 (-> *car-level-array* data (+ (-> arg0 level slot) -6)))
          (s5-0 0)
          )
      (set! (-> self use-tail?) #f)
      (case (-> v1-19 current-parts 9)
        ((1)
         (set! s5-0 3)
         (set! (-> self use-tail?) (the-as basic #t))
         )
        ((2)
         (set! s5-0 5)
         )
        ((3)
         (set! s5-0 9)
         )
        ((4)
         (set! s5-0 17)
         )
        ((5)
         (set! s5-0 33)
         )
        ((6)
         (set! s5-0 65)
         (set! (-> self use-tail?) (the-as basic #t))
         )
        )
      (when (nonzero? s5-0)
        (initialize-skeleton
          self
          (the-as skeleton-group (art-group-get-by-name *level* "skel-antenna-all" (the-as (pointer level) #f)))
          (the-as pair 0)
          )
        (when (nonzero? (-> self draw))
          (setup-masks (-> self draw) 0 -1)
          (setup-masks (-> self draw) s5-0 0)
          )
        )
      )
    (when (nonzero? (-> self draw))
      (set! (-> self draw lights) (-> (the-as vehicle (-> arg0 vehicle)) draw lights))
      ((method-of-type joint-mod-set-rot-local init)
       (-> self jmod-antenna 0)
       self
       (the-as uint 3)
       (joint-mod-base-flags attached)
       )
      (init (-> self jmod-antenna 1) self (the-as uint 4) (joint-mod-base-flags attached))
      (init (-> self jmod-antenna 2) self (the-as uint 5) (joint-mod-base-flags attached))
      (if (-> self use-tail?)
          (init (-> self jmod-tail) self (the-as uint 6) (joint-mod-base-flags attached))
          )
      (set! (-> self i-tip-node) 6)
      (mem-copy! (the-as pointer (-> self sim-state)) (the-as pointer *vehicle-antenna-state*) 96)
      (vehicle-antenna-method-52 self)
      (go-virtual idle)
      )
    )
  (none)
  )

;; definition for function vehicle-antenna-spawn
(defun vehicle-antenna-spawn ((arg0 vehicle-antenna-init-params))
  (let ((gp-0 (the-as process #f)))
    (let* ((s4-0 (get-process *default-dead-pool* vehicle-antenna #x4000 1))
           (v1-1 (when s4-0
                   (let ((t9-1 (method-of-type process activate)))
                     (t9-1 s4-0 *rigid-body-queue-manager* "vehicle-antenna" (the-as pointer #x70004000))
                     )
                   (run-now-in-process s4-0 vehicle-antenna-init-by-other arg0)
                   (-> s4-0 ppointer)
                   )
                 )
           )
      (if v1-1
          (set! gp-0 (-> v1-1 0))
          )
      )
    gp-0
    )
  )
