;;-*-Lisp-*-
(in-package goal)

;; definition of type joint-mod-set-rot-local
(deftype joint-mod-set-rot-local (joint-mod-base)
  ((rotation  quaternion  :inline)
   )
  )

;; definition for method 3 of type joint-mod-set-rot-local
(defmethod inspect ((this joint-mod-set-rot-local))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'joint-mod-set-rot-local)
  (format #t "~1Tflags: ~D~%" (-> this flags))
  (format #t "~1Tnode-index: ~D~%" (-> this node-index))
  (format #t "~1Tproc: #x~X~%" (-> this proc))
  (format #t "~1Tcallback: ~A~%" (-> this callback))
  (format #t "~1Trotation: #<quaternion @ #x~X>~%" (-> this rotation))
  (label cfg-4)
  this
  )

;; definition for method 9 of type joint-mod-set-rot-local
(defmethod init ((this joint-mod-set-rot-local) (arg0 process-drawable) (arg1 uint) (arg2 joint-mod-base-flags))
  "Set up this joint-mod to modify the given joint of the given process. Will attach automatically if attached flag is set."
  (set! (-> this callback)
        (lambda ((arg0 cspace) (arg1 transformq))
          (let ((v1-0 (-> arg0 param1)))
            (quaternion-copy! (the-as quaternion (-> arg1 rot)) (the-as quaternion (+ (the-as uint v1-0) 16)))
            )
          (cspace<-parented-transformq-joint! arg0 arg1)
          (none)
          )
        )
  (quaternion-identity! (-> this rotation))
  ((method-of-type joint-mod-base init) this arg0 arg1 arg2)
  (none)
  )

;; definition of type vehicle-antenna-state
(deftype vehicle-antenna-state (structure)
  ((data  uint128  6)
   )
  )

;; definition for method 3 of type vehicle-antenna-state
(defmethod inspect ((this vehicle-antenna-state))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'vehicle-antenna-state)
  (format #t "~1Tdata[6] @ #x~X~%" (-> this data))
  (label cfg-4)
  this
  )

;; definition of type vehicle-antenna
(deftype vehicle-antenna (process-drawable)
  ((vehicle           handle)
   (attach-local-pos  vector                   :inline)
   (attach-rot        quaternion               :inline)
   (jmod-antenna      joint-mod-set-rot-local  4 :inline)
   (jmod-tail         joint-mod-set-rot-local  :inline)
   (sim-state         vehicle-antenna-state    :inline)
   (ant-tip-pos       vector                   :inline :overlay-at (-> sim-state data 0))
   (ant-tip-vel       vector                   :inline :overlay-at (-> sim-state data 1))
   (spring-pos        vector                   :inline :overlay-at (-> sim-state data 2))
   (spring-vel        vector                   :inline :overlay-at (-> sim-state data 3))
   (tail-pos          vector                   :inline :overlay-at (-> sim-state data 4))
   (tail-vel          vector                   :inline :overlay-at (-> sim-state data 5))
   (i-tip-node        int8)
   (use-tail?         basic)
   )
  (:state-methods
    idle
    die
    )
  (:methods
    (vehicle-antenna-method-52 (_type_) none)
    (vehicle-antenna-method-53 (_type_) none)
    (vehicle-antenna-method-54 (_type_ int int) none)
    )
  )

;; definition for method 3 of type vehicle-antenna
(defmethod inspect ((this vehicle-antenna))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type process-drawable inspect)))
    (t9-0 this)
    )
  (format #t "~2Tvehicle: ~D~%" (-> this vehicle))
  (format #t "~2Tattach-local-pos: #<vector @ #x~X>~%" (-> this attach-local-pos))
  (format #t "~2Tattach-rot: #<quaternion @ #x~X>~%" (-> this attach-rot))
  (format #t "~2Tjmod-antenna[4] @ #x~X~%" (-> this jmod-antenna))
  (format #t "~2Tjmod-tail: #<joint-mod-set-rot-local @ #x~X>~%" (-> this jmod-tail))
  (format #t "~2Tsim-state: #<vehicle-antenna-state @ #x~X>~%" (-> this sim-state))
  (format #t "~2Tant-tip-pos: #<vector @ #x~X>~%" (-> this sim-state))
  (format #t "~2Tant-tip-vel: #<vector @ #x~X>~%" (-> this ant-tip-vel))
  (format #t "~2Tspring-pos: #<vector @ #x~X>~%" (-> this spring-pos))
  (format #t "~2Tspring-vel: #<vector @ #x~X>~%" (-> this spring-vel))
  (format #t "~2Ttail-pos: #<vector @ #x~X>~%" (-> this tail-pos))
  (format #t "~2Ttail-vel: #<vector @ #x~X>~%" (-> this tail-vel))
  (format #t "~2Ti-tip-node: ~D~%" (-> this i-tip-node))
  (format #t "~2Tuse-tail?: ~A~%" (-> this use-tail?))
  (label cfg-4)
  this
  )

;; definition for method 54 of type vehicle-antenna
;; WARN: Return type mismatch int vs none.
(defmethod vehicle-antenna-method-54 ((this vehicle-antenna) (arg0 int) (arg1 int))
  (set! (-> this draw status) (logclear (logior (-> this draw status) arg0) arg1))
  0
  (none)
  )

;; definition for symbol *vehicle-antenna-state*, type vehicle-antenna-state
(define *vehicle-antenna-state* (new 'static 'vehicle-antenna-state))

;; failed to figure out what this is:
(defstate idle (vehicle-antenna)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('modify-draw-status)
       (let ((a1-1 (-> block param 0))
             (a2-1 (-> block param 1))
             )
         (vehicle-antenna-method-54 self (the-as int a1-1) (the-as int a2-1))
         )
       )
      (('explode)
       (let ((v1-3 (-> self draw color-mult)))
         (vector-float*! (the-as vector v1-3) (the-as vector v1-3) 0.25)
         )
       )
      (('die)
       (go-virtual die)
       )
      (('set-position)
       (let ((v1-6 (the-as object (-> block param 0)))
             (v0-0 (the-as object (-> self attach-local-pos)))
             )
         (set! (-> (the-as vector v0-0) quad) (-> (the-as (pointer uint128) v1-6) 0))
         v0-0
         )
       )
      (('save-state)
       (format 0 "vehicle-antenna::idle event-handler: save-state~%")
       (mem-copy! (the-as pointer *vehicle-antenna-state*) (the-as pointer (-> self sim-state)) 96)
       )
      )
    )
  :enter (behavior ()
    '()
    )
  :exit (behavior ()
    0
    )
  :trans #f
  :code sleep-code
  :post (behavior ()
    (set! (-> self sim-state data 0) (-> self node-list data (-> self i-tip-node) bone transform trans quad))
    (vehicle-antenna-method-52 self)
    )
  )

;; failed to figure out what this is:
(defstate die (vehicle-antenna)
  :virtual #t
  :code (behavior ()
    '()
    )
  )

