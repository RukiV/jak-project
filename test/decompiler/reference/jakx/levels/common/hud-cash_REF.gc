;; definition for symbol *hud-cash-stats-top-view-0-proc*, type object
(define *hud-cash-stats-top-view-0-proc* (the-as object #f))

;; definition of type hud-cash-stats-top-view-0
(deftype hud-cash-stats-top-view-0 (in-game-hud)
  ()
  )

;; definition for method 3 of type hud-cash-stats-top-view-0
(defmethod inspect ((this hud-cash-stats-top-view-0))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type in-game-hud inspect)))
    (t9-0 this)
    )
  (label cfg-4)
  this
  )

;; definition for method 7 of type hud-cash-stats-top-view-0
;; WARN: Return type mismatch in-game-hud vs hud-cash-stats-top-view-0.
(defmethod relocate ((this hud-cash-stats-top-view-0) (offset int))
  (set! *hud-cash-stats-top-view-0-proc* this)
  (if (nonzero? *hud-cash-stats-top-view-0-proc*)
      (set! *hud-cash-stats-top-view-0-proc* (+ (the-as uint *hud-cash-stats-top-view-0-proc*) offset))
      )
  (the-as hud-cash-stats-top-view-0 ((method-of-type in-game-hud relocate) this offset))
  )

;; definition for method 26 of type hud-cash-stats-top-view-0
(defmethod hud-method-26 ((this hud-cash-stats-top-view-0))
  (set! (-> this items) *hud-cash-stats-top-view-0*)
  (set! (-> this manager) (new 'static 'basic-manager))
  (set! *hud-cash-stats-top-view-0-proc* this)
  ((method-of-type in-game-hud hud-method-26) this)
  (none)
  )

;; definition for method 10 of type hud-cash-stats-top-view-0
(defmethod deactivate ((this hud-cash-stats-top-view-0))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (set! *hud-cash-stats-top-view-0-proc* (the-as object #f))
  ((method-of-type in-game-hud deactivate) this)
  (none)
  )

;; definition for method 24 of type hud-cash-stats-top-view-0
(defmethod hud-method-24 ((this hud-cash-stats-top-view-0))
  (when *debug-hud*
    (set! (-> this real-items) *hud-cash-stats-top-view-0*)
    (hud-method-26 this)
    )
  ((method-of-type in-game-hud hud-method-24) this)
  (none)
  )

;; definition for function spawn-hud-cash-stats-top-view-0
(defun spawn-hud-cash-stats-top-view-0 ()
  (cond
    (*hud-cash-stats-top-view-0-proc*
      *hud-cash-stats-top-view-0-proc*
      )
    (*net-game-mgr*
      (let ((v0-0 (ppointer->process (process-spawn
                                       hud-cash-stats-top-view-0
                                       :init hud-init-by-other
                                       :name "hud-cash-stats-top-view-0"
                                       :to *net-game-mgr*
                                       )
                                     )
                  )
            )
        (when (the-as hud-cash-stats-top-view-0 v0-0)
          (set! (-> (the-as hud-cash-stats-top-view-0 v0-0) inited-strings-count) 0)
          0
          )
        v0-0
        )
      )
    (else
      #f
      )
    )
  )

