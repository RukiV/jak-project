           (-> v1-23 id)
           )
         (else
           0
           )
         )
       )
     (set! (-> this selection) (logand (+ (-> this selection) 1) 1))
     )
    ((cpad-pressed? (view-get-active-index) x)
     (let ((v1-35 (-> this selection)))
       (cond
         ((= v1-35 1)
          (let ((v1-37 (make-sound-instance (-> *sound-info* 315) (new 'static 'sound-id) (the-as handle #f))))
            (cond
              (v1-37
                (logior! (-> v1-37 flags) 320)
                (-> v1-37 id)
                )
              (else
                0
                )
              )
            )
          (send-event *net-game-mgr* 'restart-game)
          )
         ((zero? v1-35)
          (net-game-mgr-method-45 *net-game-mgr* #f)
          (when (-> *game-info* playing-grand-prix?)
            (dotimes (s5-0 (the-as int *active-net-player-count*))
              (let ((s4-0 (-> *active-net-players* s5-0)))
                (when (!= (-> *last-game-mgr-grand-prix* (net-player-method-71 s4-0)) (-> *net-game-mgr* pid))
                  (set! (-> *game-info* this-race-grand-prix-score (net-player-method-71 s4-0))
                        (the-as uint (calc-grand-prix-score (the-as (pointer int8) s4-0)))
                        )
                  (set! (-> *game-info* cumulative-grand-prix-score (net-player-method-71 s4-0))
                        (the-as uint (+ (l.w (+ (* (net-player-method-71 s4-0) 4) (the-as int *game-info*) 1600))
                                        (calc-grand-prix-score (the-as (pointer int8) s4-0))
                                        )
                                )
                        )
                  (set! (-> *last-game-mgr-grand-prix* (net-player-method-71 s4-0)) (-> *net-game-mgr* pid))
                  )
                )
              )
            )
          (when (not (send-event *net-game-mgr* 'suppress-end-of-game))
            (let ((v1-82 (make-sound-instance (-> *sound-info* 315) (new 'static 'sound-id) (the-as handle #f))))
              (cond
                (v1-82
                  (logior! (-> v1-82 flags) 320)
                  (-> v1-82 id)
                  )
                (else
