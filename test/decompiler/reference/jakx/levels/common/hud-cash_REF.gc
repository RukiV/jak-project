    (if (or (= v1-3 13) (or (= v1-3 2) (= v1-3 1)))
        #t
        #f
        )
    )
  )

;; definition for function get-medal-ignore-gamestate
;; WARN: Return type mismatch int vs object.
(defun get-medal-ignore-gamestate ((arg0 net-player))
  (cond
    ((not (medal-uses-score?))
     (let ((v1-0 (calc-player-rank (-> arg0 player-id) #f)))
       (get-medal-reward-ignore-medal (cond
                                        ((zero? v1-0)
                                         3.0
                                         )
                                        ((= v1-0 1)
                                         2.0
                                         )
                                        ((= v1-0 2)
                                         1.0
                                         )
                                        (else
                                          0.0
                                          )
                                        )
                                      )
       )
     )
    (else
      0.0
      (let ((f0-2 (the float (-> arg0 score))))
        (case (if *net-world*
                  (the-as int (-> (the-as game-task-node-info (-> *net-world* task-node-info)) net-play-mode))
                  18
                  )
          ((2)
           (set! f0-2 (/ f0-2 300))
           )
          )
        (get-medal-reward-ignore-medal f0-2)
        )
      )
    )
  )

;; definition for function settings-multiplier
(defun settings-multiplier ()
  (if (= *game-mode* 'adventure)
      (return 1.0)
      )
  (let ((v1-3 (-> (get-open-task-node-info) default-advanced-options))
        (a0-2 (-> *net-world* net-state options))
        )
    (* (if (and (or (zero? (if *net-world*
                               (the-as int (-> (the-as game-task-node-info (-> *net-world* task-node-info)) net-play-mode))
                               18
                               )
                           )
                    (logtest? (-> *net-world* net-state options advanced-options flags) 1)
                    )
                (!= 0.0 (the float (-> v1-3 param1)))
                )
           (fmin 1.0 (/ (the float (-> a0-2 advanced-options param1)) (the float (-> v1-3 param1))))
           1.0
           )
       (if (and (logtest? (-> *net-world* net-state options advanced-options flags) 2)
                (!= 0.0 (the float (-> v1-3 param2)))
                )
           (fmin 1.0 (/ (the float (-> a0-2 advanced-options param2)) (the float (-> v1-3 param2))))
           1.0
           )
       (if (!= 0.0 (the float (-> v1-3 param3)))
           (fmin 1.0 (/ (the float (-> a0-2 advanced-options param3)) (the float (-> v1-3 param3))))
           1.0
           )
       )
    )
  )

;; definition for function cup-multiplier
(defun cup-multiplier ()
  (if (and (-> *game-info* playing-grand-prix?) (= 2 (-> *game-info* grand-prix-index)))
      (return 3.0)
      )
  (let ((gp-0 #f))
    (when (not *had-gold*)
      (case (if *net-world*
                (the-as int (-> (the-as game-task-node-info (-> *net-world* task-node-info)) net-play-mode))
                18
                )
        ((1 13)
         (let ((v1-13 (-> *net-players* 0)))
           (when v1-13
             (if (= (get-medal-reward-ignore-medal (the float (-> v1-13 score))) 3)
                 (set! gp-0 #t)
                 )
             )
           )
         )
        ((2)
         (let ((v1-16 (-> *net-players* 0)))
           (when v1-16
             (if (= (get-medal-reward-ignore-medal (* 0.0033333334 (the float (-> v1-16 score)))) 3)
                 (set! gp-0 #t)
                 )
             )
           )
         )
        (else
          (let ((v1-19 (-> *net-players* 0)))
            (when v1-19
              (if (zero? (calc-player-rank (-> v1-19 player-id) (if (-> *game-info* playing-grand-prix?)
                                                                    #t
                                                                    #f
                                                                    )
                                           )
                         )
                  (set! gp-0 #t)
                  )
              )
            )
          )
        )
      )
    (let ((f0-4 1.0))
      (set! gp-0 (and (= *game-mode* 'adventure) gp-0))
      (when gp-0
        (let ((v1-27 (-> (get-open-task-node-info) flags)))
          (set! f0-4 (cond
                       ((logtest? v1-27 (game-task-node-flag cup1))
                        1.0
                        )
                       ((logtest? v1-27 (game-task-node-flag cup2))
                        1.5
                        )
                       ((logtest? v1-27 (game-task-node-flag cup3))
                        2.0
                        )
                       ((logtest? v1-27 (game-task-node-flag cup4))
                        3.0
                        )
                       (else
                         1.0
                         )
                       )
                )
          )
        )
      f0-4
      )
    )
  )

;; definition for function medal-instead-of-place?
;; WARN: Return type mismatch symbol vs object.
(defun medal-instead-of-place? ()
  (case (if *net-world*
            (the-as int (-> (the-as game-task-node-info (-> *net-world* task-node-info)) net-play-mode))
            18
            )
    ((13 2)
     (return (the-as object #t))
     )
    ((1)
     (if (< (-> *net-game-mgr* human-ct) 2)
         (return (the-as object #t))
         )
     )
    )
  #f
  )

;; definition for method 9 of type hud-cash-stats
(defmethod hud-item-method-9 ((this hud-cash-stats))
  (set! (-> this time) 0)
  (set! (-> this last-time) 0)
  (let ((v1-0 (-> this stat-type)))
    (when (or (zero? v1-0) (= v1-0 1))
      (cond
        ((medal-instead-of-place?)
         (set! (-> (the-as hud-item-string (-> this items 0)) text-id) (the-as uint 3822))
         (set! (-> this stat-type) (the-as uint 0))
         0
         )
        (else
          (set! (-> (the-as hud-item-string (-> this items 0)) text-id) (the-as uint 2018))
          (set! (-> this stat-type) (the-as uint 1))
          )
        )
      )
    )
  ((method-of-type hud-item-group hud-item-method-9) this)
  (none)
  )

;; definition for method 27 of type hud-cash-stats
;; WARN: Return type mismatch int vs none.
(defmethod hud-item-method-27 ((this hud-cash-stats) (arg0 object))
  (let ((s5-1 (max 0 (the-as int arg0))))
    (when (and (< 90 (-> this time)) (< (-> this time) 150) (>= s5-1 150))
      (hud-item-method-23 this #f 0 'throb #f)
      (case (-> this stat-type)
        ((6 7)
         (hud-item-method-23 this #f 0 'sound2 #f)
         )
        (else
          (hud-item-method-23 this #f 0 'sound1 #f)
          )
        )
      )
    (set! (-> this last-time) (-> this time))
    (set! (-> this time) s5-1)
    )
  0
  (none)
  )

