;; definition for function reset-hud-cash-time
;; WARN: Return type mismatch int vs object.
(defun reset-hud-cash-time ()
  (let ((v1-1 (-> *viewport-array* mode)))
    (cond
      ((zero? v1-1)
       (set! (-> (the-as cash-hud (-> *hud-cash-stats-single* 0)) start-time) -1)
       )
      ((= v1-1 1)
       (if (zero? (view-get-active-index))
           (set! (-> (the-as cash-hud (-> *hud-cash-stats-top-view-0* 0)) start-time) -1)
           (set! (-> (the-as cash-hud (-> *hud-cash-stats-top-view-1* 0)) start-time) -1)
           )
       )
      ((zero? (view-get-active-index))
       (set! (-> (the-as cash-hud (-> *hud-cash-stats-side-view-0* 0)) start-time) -1)
       )
      (else
        (set! (-> (the-as cash-hud (-> *hud-cash-stats-side-view-1* 0)) start-time) -1)
        )
      )
    )
  0
  )

;; definition for function spawn-hud-cash-stats
(defun spawn-hud-cash-stats ()
  (let ((v1-1 (-> *viewport-array* mode)))
    (cond
      ((zero? v1-1)
       (spawn-hud-cash-stats-single)
       )
      ((= v1-1 1)
       (if (zero? (view-get-active-index))
           (spawn-hud-cash-stats-top-view-0)
           (spawn-hud-cash-stats-top-view-1)
           )
       )
      ((zero? (view-get-active-index))
       (spawn-hud-cash-stats-side-view-0)
       )
      (else
        (spawn-hud-cash-stats-side-view-1)
        )
      )
    )
  )

;; definition for function cash-stats-on?
(defun cash-stats-on? ()
  (or (and (zero? (view-get-active-index))
           (or *hud-cash-stats-single-proc* *hud-cash-stats-top-view-0-proc* *hud-cash-stats-side-view-0-proc*)
           )
      (and (= 1 (view-get-active-index)) (or *hud-cash-stats-top-view-1-proc* *hud-cash-stats-side-view-1-proc*))
      )
  )
