           )
         )
       )
     (set! (-> this selection) (logand (+ (-> this selection) -1) 1))
     (if (< (-> this selection) 0)
         (set! (-> this selection) 2)
         )
     )
    ((cpad-pressed? (view-get-active-index) down)
     (let ((v1-23 (make-sound-instance (-> *sound-info* 343) (new 'static 'sound-id) (the-as handle #f))))
       (cond
