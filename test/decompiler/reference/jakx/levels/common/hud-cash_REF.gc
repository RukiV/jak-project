;; definition for symbol *hud-cash-stats-single-proc*, type object
(define *hud-cash-stats-single-proc* (the-as object #f))

;; definition of type hud-cash-stats-single
(deftype hud-cash-stats-single (in-game-hud)
  ()
  )

;; definition for method 3 of type hud-cash-stats-single
(defmethod inspect ((this hud-cash-stats-single))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type in-game-hud inspect)))
    (t9-0 this)
    )
  (label cfg-4)
  this
  )

;; definition for method 7 of type hud-cash-stats-single
;; WARN: Return type mismatch in-game-hud vs hud-cash-stats-single.
(defmethod relocate ((this hud-cash-stats-single) (offset int))
  (set! *hud-cash-stats-single-proc* this)
  (if (nonzero? *hud-cash-stats-single-proc*)
      (set! *hud-cash-stats-single-proc* (+ (the-as uint *hud-cash-stats-single-proc*) offset))
      )
  (the-as hud-cash-stats-single ((method-of-type in-game-hud relocate) this offset))
  )

;; definition for method 26 of type hud-cash-stats-single
(defmethod hud-method-26 ((this hud-cash-stats-single))
  (set! (-> this items) *hud-cash-stats-single*)
  (set! (-> this manager) (new 'static 'basic-manager))
  (set! *hud-cash-stats-single-proc* this)
  ((method-of-type in-game-hud hud-method-26) this)
  (none)
  )

;; definition for method 10 of type hud-cash-stats-single
(defmethod deactivate ((this hud-cash-stats-single))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (set! *hud-cash-stats-single-proc* (the-as object #f))
  ((method-of-type in-game-hud deactivate) this)
  (none)
  )

;; definition for method 24 of type hud-cash-stats-single
(defmethod hud-method-24 ((this hud-cash-stats-single))
  (when *debug-hud*
    (set! (-> this real-items) *hud-cash-stats-single*)
    (hud-method-26 this)
    )
  ((method-of-type in-game-hud hud-method-24) this)
  (none)
  )

;; definition for function spawn-hud-cash-stats-single
(defun spawn-hud-cash-stats-single ()
  (cond
    (*hud-cash-stats-single-proc*
      *hud-cash-stats-single-proc*
      )
    (*net-game-mgr*
      (let ((v0-0
              (ppointer->process
                (process-spawn hud-cash-stats-single :init hud-init-by-other :name "hud-cash-stats-single" :to *net-game-mgr*)
                )
              )
            )
        (when (the-as hud-cash-stats-single v0-0)
          (set! (-> (the-as hud-cash-stats-single v0-0) inited-strings-count) 0)
          0
          )
        v0-0
        )
      )
    (else
      #f
      )
    )
  )

