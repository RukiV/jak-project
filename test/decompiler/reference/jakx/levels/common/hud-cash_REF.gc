;; definition for function spawn-hud-game-end
(defun spawn-hud-game-end ()
  (if (-> *game-info* playing-grand-prix?)
      (return (spawn-hud-game-end-grand-prix))
      )
  (when (zero? (view-get-active-index))
    (let ((v1-6 (-> *viewport-array* mode)))
      (cond
        ((zero? v1-6)
         (spawn-hud-game-end-view-0)
         )
        ((= v1-6 1)
         (spawn-hud-game-end-top-view-0)
         )
        (else
          (spawn-hud-game-end-side-view-0)
          )
        )
      )
    )
  )

;; definition for function end-game-menu-on?
;; WARN: Return type mismatch symbol vs object.
(defun end-game-menu-on? ()
  (and (zero? (view-get-active-index)) (not (and (= *hud-game-end-view-0-proc* #f)
                                                 (= *hud-game-end-grand-prix-proc* #f)
                                                 (= *hud-game-end-side-view-0-proc* #f)
                                                 (= *hud-game-end-top-view-0-proc* #f)
                                                 )
                                            )
       )
  )

;; definition of type cash-hud
(deftype cash-hud (hud-item-group)
  ((spawn-time  int32)
   (start-time  int32)
   )
  )

;; definition for method 3 of type cash-hud
(defmethod inspect ((this cash-hud))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this (-> this type))
  (format #t "~1Talpha: ~D~%" (-> this alpha))
  (format #t "~1Treal-alpha: ~D~%" (-> this real-alpha))
  (format #t "~1Tposition-x: ~D~%" (-> this position-x))
  (format #t "~1Tposition-y: ~D~%" (-> this position-y))
  (format #t "~1Treal-position-x: ~D~%" (-> this real-position-x))
  (format #t "~1Treal-position-y: ~D~%" (-> this real-position-y))
  (format #t "~1Twidth: ~D~%" (-> this width))
  (format #t "~1Theight: ~D~%" (-> this height))
  (format #t "~1Treal-width: ~D~%" (-> this real-width))
  (format #t "~1Treal-height: ~D~%" (-> this real-height))
  (format #t "~1Tzval: ~D~%" (-> this zval))
  (format #t "~1Treal-scale: ~D~%" (-> this real-scale))
  (format #t "~1Tscale: ~D~%" (-> this scale))
  (format #t "~1Tflags: ~D~%" (-> this flags))
  (format #t "~1Teffect: ~A~%" (-> this effect))
  (format #t "~1Tparent: ~A~%" (-> this parent))
  (format #t "~1Titems: ~A~%" (-> this items))
  (format #t "~1Tspawn-time: ~D~%" (-> this spawn-time))
  (format #t "~1Tstart-time: ~D~%" (-> this start-time))
  (label cfg-4)
  this
  )

;; definition for method 9 of type cash-hud
(defmethod hud-item-method-9 ((this cash-hud))
  (set! (-> this items 1 position-x) 10)
  (case (-> *viewport-array* mode)
    ((1)
     (set! (-> this items 0 scale) 204)
     (set! (-> this scale) 204)
     )
    ((2)
     (set! (-> this items 0 scale) 179)
     (set! (-> this scale) 179)
     )
    (else
      (set! (-> this items 0 scale) 256)
      (set! (-> this scale) 256)
      (if (!= 1.0 (-> *video-params* relative-x-scale))
          (set! (-> this items 1 position-x) 170)
          )
      )
    )
  (if (= (-> this start-time) -1)
      (set! (-> this start-time) (the-as int (current-time)))
      )
  (if (and (not (and (zero? (-> *viewport-array* mode)) (= (-> *net-mgr* game-type) 4)))
           (and *net-game-mgr*
                (or (and (zero? (view-get-active-index)) (!= (-> *net-game-mgr* pid) *last-cash-game-mgr-for-player-0*))
                    (and (= 1 (view-get-active-index)) (!= (-> *net-game-mgr* pid) *last-cash-game-mgr-for-player-1*))
                    )
                )
           )
      (set! (-> this spawn-time) (the-as int (current-time)))
      (set! (-> this spawn-time) -1)
      )
  ((method-of-type hud-item-group hud-item-method-9) this)
  (none)
  )

;; definition for method 19 of type cash-hud
(defmethod hud-item-method-19 ((this cash-hud))
  (with-pp
    (hud-item-method-14 this)
    (hud-item-method-12 this)
    (hud-item-method-14 this)
    (let* ((v1-9 (if *net-world*
                     (the-as int (-> (the-as game-task-node-info (-> *net-world* task-node-info)) net-play-mode))
                     18
                     )
                 )
           (s5-0 (if (or (zero? v1-9) (or (= v1-9 1) (= v1-9 13) (= v1-9 2) (= v1-9 3)))
                     #f
                     #t
                     )
                 )
           (s4-0 (- (current-time) (the-as time-frame (-> this start-time))))
           (s1-0 (-> (the-as hud-item-group (-> this items 2)) items 0))
           (s2-0 (-> this items 3))
           (s3-0 (-> this items 4))
           )
      (dotimes (s0-0 5)
        (let ((v1-20 (if (and (< 2 s0-0) s5-0)
                         (+ s0-0 -1)
                         s0-0
                         )
                     )
              )
          (hud-item-method-27 (-> (the-as hud-item-group s1-0) items s0-0) (- s4-0 (the-as time-frame (* 75 v1-20))))
          )
        )
      (hud-item-method-27 s2-0 (- s4-0 (the-as time-frame (* 75 (if s5-0
                                                                    4
                                                                    5
                                                                    )
                                                             )
                                               )
                                  )
                          )
      (hud-item-method-27 s3-0 (- s4-0 (the-as time-frame (* 75 (if s5-0
                                                                    5
                                                                    6
                                                                    )
                                                             )
                                               )
                                  )
                          )
      )
    (let ((s5-1 (-> (the-as hud-item-group (-> this items 5)) items 1))
          (s4-1 (-> (the-as hud-item-group (-> this items 5)) items 0))
          (s3-1 (-> this items 6))
          )
      (cond
        ((and ((method-of-object *net-game-mgr* net-game-mgr-method-50))
              (= (if *net-mgr*
                     (-> *net-mgr* game-state local-machine-idx)
                     0
                     )
                 (-> *net-mgr* game-state session-master-idx)
                 )
              (and (zero? (view-get-active-index))
                   (let ((a1-9 (new 'stack-no-clear 'event-message-block)))
                     (set! (-> a1-9 from) (process->ppointer pp))
                     (set! (-> a1-9 num-params) 0)
                     (set! (-> a1-9 message) 'suppress-end-of-game)
                     (and (not (send-event-function *net-game-mgr* a1-9))
                          (or (not (is-clan-challenge)) (net-game-mgr-method-51 *net-game-mgr*))
                          )
                     )
                   )
              )
         (hud-item-method-21 s3-1)
         (cond
           ((!= (-> this spawn-time) -1)
            (hud-item-method-21 s5-1)
            (hud-item-method-21 s4-1)
            )
           (else
             (hud-item-method-22 s5-1)
             (hud-item-method-22 s4-1)
             )
           )
         )
        (else
          (hud-item-method-21 s4-1)
          (hud-item-method-21 s5-1)
          (if (!= (-> this spawn-time) -1)
              (hud-item-method-21 s3-1)
              (hud-item-method-22 s3-1)
              )
          )
        )
      )
    (when (and (not (end-game-menu-on?))
               (or (= -1 (-> this spawn-time)) (< (+ (-> this spawn-time) 1200) (current-time)))
               )
      (cond
        ((cpad-pressed? (view-get-active-index) triangle)
         (let ((v1-82 (make-sound-instance (-> *sound-info* 315) (new 'static 'sound-id) (the-as handle #f))))
           (cond
             (v1-82
               (logior! (-> v1-82 flags) 320)
               (-> v1-82 id)
               )
             (else
               0
               )
             )
           )
         (logclear! (-> *cpad-list* cpads (view-get-active-index) button0-abs 0) (pad-buttons triangle))
         (logclear! (-> *cpad-list* cpads (view-get-active-index) button0-rel 0) (pad-buttons triangle))
         (send-event *current-hud* 'kill-hud-instant)
         )
        ((and ((method-of-object *net-game-mgr* net-game-mgr-method-50))
              (zero? (view-get-active-index))
              (= (if *net-mgr*
                     (-> *net-mgr* game-state local-machine-idx)
                     0
                     )
                 (-> *net-mgr* game-state session-master-idx)
                 )
              (cpad-pressed? (view-get-active-index) x)
              (let ((a1-12 (new 'stack-no-clear 'event-message-block)))
                (set! (-> a1-12 from) (process->ppointer pp))
                (set! (-> a1-12 num-params) 0)
                (set! (-> a1-12 message) 'suppress-end-of-game)
                (and (not (send-event-function *net-game-mgr* a1-12))
                     (or (not (is-clan-challenge)) (net-game-mgr-method-51 *net-game-mgr*))
                     )
                )
              )
         (logclear! (-> *cpad-list* cpads (view-get-active-index) button0-abs 0) (pad-buttons x))
         (logclear! (-> *cpad-list* cpads (view-get-active-index) button0-rel 0) (pad-buttons x))
         (when (spawn-hud-game-end)
           (let ((v1-134 (make-sound-instance (-> *sound-info* 315) (new 'static 'sound-id) (the-as handle #f))))
             (cond
               (v1-134
                 (logior! (-> v1-134 flags) 320)
                 (-> v1-134 id)
                 )
               (else
                 0
                 )
               )
             )
           )
         )
        )
      (set! (-> this spawn-time) -1)
      )
    ((method-of-type hud-item-group hud-item-method-19) this)
    (none)
    )
  )

