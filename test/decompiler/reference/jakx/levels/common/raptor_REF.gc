;; definition for method 75 of type raptor
;; WARN: Return type mismatch int vs none.
(defmethod net-enemy-method-75 ((this raptor))
  (let ((s5-0 (new 'process 'collide-shape-moving this (collide-list-enum usually-hit-by-player))))
    (set! (-> s5-0 dynam) (copy *standard-dynamics* 'process))
    (set! (-> s5-0 reaction) cshape-reaction-default)
    (set! (-> s5-0 no-reaction)
          (the-as (function collide-shape-moving collide-query vector vector object) nothing)
          )
    (set! (-> s5-0 penetrated-by) (penetrate))
    (let ((s4-0 (new 'process 'collide-shape-prim-group s5-0 (the-as uint 1) 0)))
      (set! (-> s5-0 total-prims) (the-as uint 2))
      (set! (-> s4-0 prim-core collide-as) (collide-spec enemy obstacle))
      (set! (-> s4-0 prim-core collide-with)
            (collide-spec backgnd jak crate civilian enemy obstacle vehicle-sphere hit-by-others-list player-list pusher)
            )
      (set! (-> s4-0 prim-core action) (collide-action solid deadly no-standon))
      (set-vector! (-> s4-0 local-sphere) 0.0 16384.0 0.0 61440.0)
      (set! (-> s5-0 root-prim) s4-0)
      )
    (let ((v1-12 (new 'process 'collide-shape-prim-sphere s5-0 (the-as uint 0))))
      (set! (-> v1-12 prim-core collide-as) (collide-spec enemy))
      (set! (-> v1-12 prim-core collide-with)
            (collide-spec backgnd jak crate civilian enemy obstacle vehicle-sphere hit-by-others-list player-list pusher)
            )
      (set! (-> v1-12 prim-core action) (collide-action solid))
      (set-vector! (-> v1-12 local-sphere) 0.0 12288.0 0.0 24576.0)
      )
    (set! (-> s5-0 nav-radius) 8192.0)
    (let ((v1-14 (-> s5-0 root-prim)))
      (set! (-> s5-0 backup-collide-as) (-> v1-14 prim-core collide-as))
      (set! (-> s5-0 backup-collide-with) (-> v1-14 prim-core collide-with))
      )
    (set! (-> s5-0 max-iteration-count) (the-as uint 3))
    (set! (-> s5-0 event-self) 'touched)
    (set! (-> this root) s5-0)
    )
  0
  (none)
  )

;; definition for method 76 of type raptor
;; WARN: Return type mismatch int vs none.
(defmethod net-enemy-method-76 ((this raptor))
  (vector-float*! (-> this root scale) (-> this root scale) 1.4)
  (initialize-skeleton
    this
    (the-as skeleton-group (art-group-get-by-name *level* "skel-raptor" (the-as (pointer level) #f)))
    (the-as pair 0)
    )
  0
  (none)
  )

;; definition for method 77 of type raptor
;; WARN: Return type mismatch int vs none.
(defmethod net-enemy-method-77 ((this raptor))
  (set! (-> this paths) (new 'process 'boxed-array path-control 2))
  (set! (-> this paths 0) (new 'process 'path-control this 'path 0.0 (-> this entity) #f))
  (set! (-> this paths 1) (new 'process 'path-control this 'intro 0.0 (-> this entity) #f))
  (if (zero? (-> this paths 1 curve num-cverts))
      (set! (-> this paths 1) (-> this paths 0))
      )
  0
  (none)
  )

;; definition for method 78 of type raptor
;; WARN: Return type mismatch int vs none.
(defmethod net-enemy-method-78 ((this raptor))
  (set! (-> this info) *raptor-enemy-info*)
  (set! (-> this prox) (new 'process 'proximity-ownership-params))
  (proximity-ownership-params-method-9 (-> this prox))
  (set! (-> this prox ownable-radius) 409600.0)
  (set! (-> this prox consider-ai-players) #t)
  0
  (none)
  )

;; definition for method 70 of type raptor
;; WARN: Return type mismatch int vs none.
;; WARN: Function (method 70 raptor) has a return type of none, but the expression builder found a return statement.
(defmethod net-enemy-method-70 ((this raptor) (arg0 object) (arg1 object) (arg2 object))
  (when (and (-> this next-state) (= (-> this next-state name) 'in-ragdoll))
    (format 0 "we are in ragdoll~%")
    (return #f)
    )
  (case arg2
    (('go-looping)
     (go (method-of-object this following-path))
     )
    (('go-idle)
     (go (method-of-object this idle-wait))
     )
    (('reverse)
     (decode-net-anim-state (-> this net-anim))
     (net-anim-control-method-9
       (-> this net-anim)
       this
       (- (- (if *net-mgr*
                 (-> *net-mgr* game-state time)
                 0
                 )
             (if *net-world*
                 (-> *net-world* net-state game-start-time)
                 0
                 )
             )
          (if *net-world*
              (-> *net-world* net-state total-pause-time)
              0
              )
          )
       #t
       )
     (go (method-of-object this reverse))
     )
    (else
      ((method-of-type net-enemy net-enemy-method-70) this arg0 arg1 arg2)
      )
    )
  0
  (none)
  )

;; definition for method 65 of type raptor
;; INFO: Used lq/sq
(defmethod net-enemy-method-65 ((this raptor) (arg0 attack-info))
  (when (!= (-> (the-as process arg0) connection-list prev0) (-> this last-attack-id))
    (let ((v1-3 (make-sound-instance (-> *sound-info* 570) (new 'static 'sound-id) (the-as handle #f))))
      (if v1-3
          (-> v1-3 id)
          0
          )
      )
    (set! (-> *launch-matrix* trans quad) (-> (&-> (the-as (pointer uint128) arg0) 0) 0))
    (set! (-> *part-tracker-params-default* group) (-> *part-group-id-table* 312))
    (vector-reset! (-> *part-tracker-params-default* local-offset))
    (set! (-> *part-tracker-params-default* duration) (the-as uint 300))
    (set! (-> *part-tracker-params-default* callback) #f)
    (set! (-> *part-tracker-params-default* userdata) (the-as uint #f))
    (set! (-> *part-tracker-params-default* target) this)
    (set! (-> *part-tracker-params-default* mat-joint) (the-as object 0))
    (set! (-> *part-tracker-params-default* local-space-param) 0)
    (set! (-> *part-tracker-params-default* local-space-callback) #f)
    (set! (-> *part-tracker-params-default* subsampler-num) 1.0)
    *part-tracker-params-default*
    (if (logtest? (-> *part-group-id-table* 312 flags) (sp-group-flag sp13))
        (process-spawn
          part-tracker-subsampler
          :init part-tracker-subsampler-init
          *part-tracker-params-default*
          :name "part-tracker-subsampler"
          :to *entity-pool*
          :unk 0
          )
        (process-spawn
          part-tracker
          :init part-tracker-init
          *part-tracker-params-default*
          :name "part-tracker"
          :to *entity-pool*
          :unk 0
          )
        )
    )
  ((method-of-type net-enemy net-enemy-method-65) this arg0)
  (none)
  )

;; definition for method 67 of type raptor
(defmethod net-enemy-method-67 ((this raptor) (arg0 rigid-body-impact))
