(set! (-> *raptor-enemy-info* ragdoll-info) *raptor-ragdoll-info*)

;; definition of type raptor
(deftype raptor (net-enemy)
  ()
  (:state-methods
    following-path
    idle-wait
    reverse
    chase
    )
  )

;; definition for method 3 of type raptor
(defmethod inspect ((this raptor))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type net-enemy inspect)))
    (t9-0 this)
    )
  (label cfg-4)
  this
  )

;; definition for function spt-birth-func-brightness-raptor-blood
;; WARN: Return type mismatch float vs none.
(defun spt-birth-func-brightness-raptor-blood ((arg0 sparticle-system) (arg1 sparticle-cpuinfo) (arg2 sparticle-launchinfo))
  (let ((s5-0 (+ (mod (the-as int (rand-uint31-gen *random-generator*)) 51) 90))
        (s3-0 (+ (mod (the-as int (rand-uint31-gen *random-generator*)) 6) 40))
        (s4-0 (+ (logand 0 (rand-uint31-gen *random-generator*)) 140))
        (v1-7 (+ (mod (the-as int (rand-uint31-gen *random-generator*)) 6) 20))
        )
    (set! (-> arg2 rotate-x) (the float (- s5-0 s3-0)))
    (set! (-> arg2 rotate-y) (the float (- s5-0 (the-as int s4-0))))
    (set! (-> arg2 rotate-z) (the float (- s5-0 v1-7)))
    )
  (none)
  )

