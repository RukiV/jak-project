;; definition for symbol *raptor-enemy-info*, type net-enemy-info
(define *raptor-enemy-info*
  (new 'static 'net-enemy-info
    :inverse-mass 0.2
    :ragdoll-info #f
    :max-health 20.0
    :damage-scale 1.0
    :respawn-delay #x5dc
    :smooth-root-trans 0.15
    :smooth-root-quat 0.15
    :fatal-impact-impulse 4096.0
    :min-fatal-impact-enemy-vel 40960.0
    :time-before-evaporate #x384
    :time-before-respawn #xbb8
    :anim-info (new 'static 'boxed-array :type net-enemy-anim-info
      (new 'static 'net-enemy-anim-info
        :name 'idle
        :anim-idx 4
        :forward-vel (new 'static 'vector :data (new 'static 'array float 4 0.0 0.0 0.0 1.0))
        )
      (new 'static 'net-enemy-anim-info
        :name 'run
        :anim-idx 5
        :forward-vel (new 'static 'vector :data (new 'static 'array float 4 0.0 0.0 307200.0 1.0))
        )
      (new 'static 'net-enemy-anim-info
        :name 'turn180
        :anim-idx 6
        :forward-vel (new 'static 'vector :data (new 'static 'array float 4 0.0 0.0 0.0 1.0))
        )
      )
    :kill-score 1
    :allow-vehicle-penetrate #t
    :ground-probe-lod-dist 40959590.0
    :show-kill-score 1
    )
  )

