    (logand! (-> this flags) -8193)
    (when (not (logtest? (-> this flags) 8))
      )
    (wvehicle-method-223 this)
    )
  0
  (none)
  )

;; definition of type wvehicle-sound-loop-params
(deftype wvehicle-sound-loop-params (structure)
  ((speed   float)
   (weight  float)
   )
  )

;; definition for method 3 of type wvehicle-sound-loop-params
(defmethod inspect ((this wvehicle-sound-loop-params))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'wvehicle-sound-loop-params)
  (format #t "~1Tspeed: ~f~%" (-> this speed))
  (format #t "~1Tweight: ~f~%" (-> this weight))
  (label cfg-4)
  this
  )

;; definition of type wvehicle-sound-work
(deftype wvehicle-sound-work (structure)
  ((roll-basis-params   wvehicle-sound-loop-params  6 :inline)
   (slide-basis-params  wvehicle-sound-loop-params  2 :inline)
   )
  )

;; definition for method 3 of type wvehicle-sound-work
(defmethod inspect ((this wvehicle-sound-work))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'wvehicle-sound-work)
  (format #t "~1Troll-basis-params[6] @ #x~X~%" (-> this roll-basis-params))
  (format #t "~1Tslide-basis-params[2] @ #x~X~%" (-> this slide-basis-params))
  (label cfg-4)
  this
  )

