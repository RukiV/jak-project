;; definition for symbol *hud-player-indicators-view0-proc*, type object
(define *hud-player-indicators-view0-proc* (the-as object #f))

;; definition of type hud-player-indicators-view0
(deftype hud-player-indicators-view0 (in-game-hud)
  ()
  )

;; definition for method 3 of type hud-player-indicators-view0
(defmethod inspect ((this hud-player-indicators-view0))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type in-game-hud inspect)))
    (t9-0 this)
    )
  (label cfg-4)
  this
  )

;; definition for method 7 of type hud-player-indicators-view0
;; WARN: Return type mismatch in-game-hud vs hud-player-indicators-view0.
(defmethod relocate ((this hud-player-indicators-view0) (offset int))
  (set! *hud-player-indicators-view0-proc* this)
  (if (nonzero? *hud-player-indicators-view0-proc*)
      (set! *hud-player-indicators-view0-proc* (+ (the-as uint *hud-player-indicators-view0-proc*) offset))
      )
  (the-as hud-player-indicators-view0 ((method-of-type in-game-hud relocate) this offset))
  )

;; definition for method 26 of type hud-player-indicators-view0
(defmethod hud-method-26 ((this hud-player-indicators-view0))
  (set! (-> this items) (the-as (array hud-item) *hud-player-indicators-view0*))
  (set! (-> this manager) (new 'static 'basic-manager))
  (set! *hud-player-indicators-view0-proc* this)
  ((method-of-type in-game-hud hud-method-26) this)
  (none)
  )

;; definition for method 10 of type hud-player-indicators-view0
(defmethod deactivate ((this hud-player-indicators-view0))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (set! *hud-player-indicators-view0-proc* (the-as object #f))
  ((method-of-type in-game-hud deactivate) this)
  (none)
  )

;; definition for method 24 of type hud-player-indicators-view0
(defmethod hud-method-24 ((this hud-player-indicators-view0))
  (when *debug-hud*
    (set! (-> this real-items) (the-as (array hud-item) *hud-player-indicators-view0*))
    (hud-method-26 this)
    )
  ((method-of-type in-game-hud hud-method-24) this)
  (none)
  )

;; definition for function spawn-hud-player-indicators-view0
(defun spawn-hud-player-indicators-view0 ()
  (cond
    (*hud-player-indicators-view0-proc*
      *hud-player-indicators-view0-proc*
      )
    (*net-game-mgr*
      (let ((v0-0 (ppointer->process (process-spawn
                                       hud-player-indicators-view0
                                       :init hud-init-by-other
                                       :name "hud-player-indicators-view0"
                                       :to *net-game-mgr*
                                       )
                                     )
                  )
            )
        (when (the-as hud-player-indicators-view0 v0-0)
          (set! (-> (the-as hud-player-indicators-view0 v0-0) inited-strings-count) 0)
          0
          )
        v0-0
        )
      )
    (else
      #f
      )
    )
  )

