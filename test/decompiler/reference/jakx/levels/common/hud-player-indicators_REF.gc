;; definition of type hud-indicator
(deftype hud-indicator (hud-item-group)
  ((target                  handle)
   (target-position         vector  :inline)
   (id                      int32)
   (enemy-distance          float)
   (hud-direction-arrow-01  basic)
   (hud-namebar-shape-01    basic)
   (offscreen               basic)
   (only-direction-arrows   basic)
   (fade-at-distance        basic)
   (no-direction-indicator  basic)
   (indicator-alpha         float)
   )
  (:methods
    (hud-indicator-method-28 (_type_) none)
    (hud-indicator-method-29 (_type_ object object) none)
    (hud-indicator-method-30 (_type_ vector vector float float) none)
    )
  )

;; definition for method 3 of type hud-indicator
(defmethod inspect ((this hud-indicator))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this (-> this type))
  (format #t "~1Talpha: ~D~%" (-> this alpha))
  (format #t "~1Treal-alpha: ~D~%" (-> this real-alpha))
  (format #t "~1Tposition-x: ~D~%" (-> this position-x))
  (format #t "~1Tposition-y: ~D~%" (-> this position-y))
  (format #t "~1Treal-position-x: ~D~%" (-> this real-position-x))
  (format #t "~1Treal-position-y: ~D~%" (-> this real-position-y))
  (format #t "~1Twidth: ~D~%" (-> this width))
  (format #t "~1Theight: ~D~%" (-> this height))
  (format #t "~1Treal-width: ~D~%" (-> this real-width))
  (format #t "~1Treal-height: ~D~%" (-> this real-height))
  (format #t "~1Tzval: ~D~%" (-> this zval))
  (format #t "~1Treal-scale: ~D~%" (-> this real-scale))
  (format #t "~1Tscale: ~D~%" (-> this scale))
  (format #t "~1Tflags: ~D~%" (-> this flags))
  (format #t "~1Teffect: ~A~%" (-> this effect))
  (format #t "~1Tparent: ~A~%" (-> this parent))
  (format #t "~1Titems: ~A~%" (-> this items))
  (format #t "~1Ttarget: ~D~%" (-> this target))
  (format #t "~1Ttarget-position: #<vector @ #x~X>~%" (-> this target-position))
  (format #t "~1Tid: ~D~%" (-> this id))
  (format #t "~1Tenemy-distance: ~f~%" (-> this enemy-distance))
  (format #t "~1Thud-direction-arrow-01: ~A~%" (-> this hud-direction-arrow-01))
  (format #t "~1Thud-namebar-shape-01: ~A~%" (-> this hud-namebar-shape-01))
  (format #t "~1Toffscreen: ~A~%" (-> this offscreen))
  (format #t "~1Tonly-direction-arrows: ~A~%" (-> this only-direction-arrows))
  (format #t "~1Tfade-at-distance: ~A~%" (-> this fade-at-distance))
  (format #t "~1Tno-direction-indicator: ~A~%" (-> this no-direction-indicator))
  (format #t "~1Tindicator-alpha: ~f~%" (-> this indicator-alpha))
  (label cfg-4)
  this
  )

;; definition for method 9 of type hud-indicator
(defmethod hud-item-method-9 ((this hud-indicator))
  (if (zero? (-> *viewport-array* mode))
      (set! (-> (the-as (pointer symbol) (-> this items 0)) 13) #t)
      (set! (-> (the-as (pointer symbol) (-> this items 0)) 13) #f)
      )
  (set! (-> this hud-direction-arrow-01) (get-texture hud-direction-arrow-01 level-default-minimap))
  (set! (-> this hud-namebar-shape-01) (get-texture hud-namebar-shape-01 level-default-minimap))
  (set! (-> this id) -1)
  (set! (-> this indicator-alpha) 1.0)
  (set! (-> this target) (the-as handle #f))
  ((method-of-type hud-item-group hud-item-method-9) this)
  (none)
  )

