(in-package goal)

;; definition of type hud-health
(deftype hud-health (hud-item-group)
  ((health  float)
   )
  (:methods
    (hud-health-method-28 (_type_ float net-player) none)
    )
  )

;; definition for method 3 of type hud-health
(defmethod inspect ((this hud-health))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this (-> this type))
