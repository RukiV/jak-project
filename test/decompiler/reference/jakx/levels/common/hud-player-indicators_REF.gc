;; definition for method 19 of type hud-artifact-indicators
(defmethod hud-item-method-19 ((this hud-artifact-indicators))
  (dotimes (s5-0 2)
    (-> (the-as net-game-mgr-artifact *net-game-mgr*) artifact s5-0)
    (let ((s4-0 (-> this items (+ s5-0 5))))
      (let* ((a0-3 (-> (the-as hud-item-group s4-0) items 1))
             (t9-0 (method-of-object (the-as hud-item-string a0-3) hud-item-method-24))
             (a1-0 0)
             )
        (t9-0 (the-as hud-item-string a0-3) a1-0)
        )
      (set! (-> (the-as hud-indicator s4-0) target)
            (the-as handle (-> (the-as net-game-mgr-artifact *net-game-mgr*) artifact s5-0))
            )
      (get-artifact-position (-> (the-as hud-indicator s4-0) target-position) s5-0)
      (let* ((s3-0 s4-0)
             (s2-0 (method-of-object (the-as hud-item-string s3-0) hud-item-method-25))
             (a1-2 (get-artifact-color s5-0))
             )
        5
        (s2-0 (the-as hud-item-string s3-0) a1-2)
        )
      (hud-item-method-24 (-> (the-as hud-item-group s4-0) items 0) "")
      )
    )
  ((method-of-type hud-player-indicators hud-item-method-19) this)
  (none)
  )

;; definition of type hud-assassin-indicators
(deftype hud-assassin-indicators (hud-item-group)
  ()
  )

;; definition for method 3 of type hud-assassin-indicators
(defmethod inspect ((this hud-assassin-indicators))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this (-> this type))
  (format #t "~1Talpha: ~D~%" (-> this alpha))
  (format #t "~1Treal-alpha: ~D~%" (-> this real-alpha))
  (format #t "~1Tposition-x: ~D~%" (-> this position-x))
  (format #t "~1Tposition-y: ~D~%" (-> this position-y))
  (format #t "~1Treal-position-x: ~D~%" (-> this real-position-x))
  (format #t "~1Treal-position-y: ~D~%" (-> this real-position-y))
  (format #t "~1Twidth: ~D~%" (-> this width))
  (format #t "~1Theight: ~D~%" (-> this height))
  (format #t "~1Treal-width: ~D~%" (-> this real-width))
  (format #t "~1Treal-height: ~D~%" (-> this real-height))
  (format #t "~1Tzval: ~D~%" (-> this zval))
  (format #t "~1Treal-scale: ~D~%" (-> this real-scale))
  (format #t "~1Tscale: ~D~%" (-> this scale))
  (format #t "~1Tflags: ~D~%" (-> this flags))
  (format #t "~1Teffect: ~A~%" (-> this effect))
  (format #t "~1Tparent: ~A~%" (-> this parent))
  (format #t "~1Titems: ~A~%" (-> this items))
  (label cfg-4)
  this
  )

;; definition for method 19 of type hud-assassin-indicators
;; INFO: Used lq/sq
(defmethod hud-item-method-19 ((this hud-assassin-indicators))
  (let* ((s5-0 (+ (view-get-active-index) (* (if *net-mgr*
                                                 (-> *net-mgr* game-state local-machine-idx)
                                                 0
                                                 )
                                             2
                                             )
                  )
               )
         (s3-0 (-> *net-players* (-> (the-as net-game-mgr-assassin *net-game-mgr*) mark s5-0)))
         )
    (when s3-0
      (let ((s2-0 (net-player-method-49 s3-0)))
        (when s2-0
          (let ((s4-0 (-> this items 0)))
            (if (logtest? (-> (the-as rigid-body-object s2-0) flags) 8)
                (hud-item-method-24 (-> (the-as hud-item-group s4-0) items 1) 0)
                (hud-item-method-24 (-> (the-as hud-item-group s4-0) items 1) (-> (the-as vehicle s2-0) health))
                )
            (set! (-> (the-as hud-indicator s4-0) target) (process->handle s2-0))
            (set! (-> (the-as hud-indicator s4-0) target-position quad) (-> (get-trans s2-0 0) quad))
            (let* ((a0-10 s4-0)
                   (t9-5 (method-of-object (the-as hud-item-string a0-10) hud-item-method-25))
                   (a1-3 (-> s3-0 color))
                   )
              (-> s3-0 font-color)
              (t9-5 (the-as hud-item-string a0-10) a1-3)
              )
            (hud-item-method-24
              (-> (the-as hud-item-group s4-0) items 0)
              (string<-charp *temp-string* (+ (+ (* 96 (-> s3-0 player-id)) 32) (the-as int *net-player-names*)))
              )
            (set! (-> (the-as hud-indicator s4-0) id) s5-0)
            )
          )
        )
      )
    )
  ((method-of-type hud-item-group hud-item-method-19) this)
  (none)
  )

