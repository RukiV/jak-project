;; definition for method 23 of type hud-indicate-death
(defmethod hud-item-method-23 ((this hud-indicate-death) (arg0 object) (arg1 object) (arg2 object) (arg3 object))
  (case arg2
    (('set-players)
     (let ((a1-1 (-> (the-as event-message-block arg3) param 0)))
       (-> (the-as event-message-block arg3) param 1)
       (hud-item-method-24 (-> (the-as hud-item-group (-> this items 0)) items 0) a1-1)
       )
     (let* ((a0-3 this)
            (t9-1 (method-of-object a0-3 hud-item-method-24))
            (a1-2 (-> (the-as event-message-block arg3) param 2))
            )
       (-> (the-as event-message-block arg3) param 3)
       (t9-1 a0-3 a1-2)
       )
     (hud-item-method-24
       (-> (the-as hud-item-group (-> this items 0)) items 7)
       (-> (the-as event-message-block arg3) param 1)
       )
     )
    (else
      ((method-of-type hud-item-group hud-item-method-23) this arg0 arg1 arg2 arg3)
      )
    )
  (none)
  )

;; definition of type death-indicator-record
(deftype death-indicator-record (structure)
  ((on             basic)
   (handle         handle)
   (spawn-time     int32)
   (previous-time  int32)
   )
  :allow-misaligned
  )

;; definition for method 3 of type death-indicator-record
(defmethod inspect ((this death-indicator-record))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'death-indicator-record)
  (format #t "~1Ton: ~A~%" (-> this on))
  (format #t "~1Thandle: ~D~%" (-> this handle))
  (format #t "~1Tspawn-time: ~D~%" (-> this spawn-time))
  (format #t "~1Tprevious-time: ~D~%" (-> this previous-time))
  (label cfg-4)
  this
  )

;; definition of type hud-manager-death-indicator
(deftype hud-manager-death-indicator (hud-manager)
  ((death-indicators-queue       death-indicator-record  20 :inline)
   (death-indicators-queue-size  int8)
   )
  (:methods
    (hud-manager-death-indicator-method-12 (_type_ in-game-hud death-indicator-record) none)
    (hud-manager-death-indicator-method-13 (_type_) none)
    (hud-manager-death-indicator-method-14 (_type_) none)
    )
  )

;; definition for method 3 of type hud-manager-death-indicator
(defmethod inspect ((this hud-manager-death-indicator))
  (when (not this)
