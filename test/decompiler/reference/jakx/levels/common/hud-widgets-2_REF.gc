  (format #t "~1Tdeath-indicators-queue[20] @ #x~X~%" (-> this death-indicators-queue))
  (format #t "~1Tdeath-indicators-queue-size: ~D~%" (-> this death-indicators-queue-size))
  (label cfg-4)
  this
  )

;; definition for method 9 of type hud-manager-death-indicator
;; WARN: Return type mismatch int vs none.
(defmethod hud-manager-method-9 ((this hud-manager-death-indicator))
  (if (< (-> this death-indicators-queue-size) 20)
      (hud-manager-death-indicator-method-14 this)
      (hud-method-27 *current-hud* *current-hud* 0 'hide-and-die #f)
      )
  0
  (none)
  )

;; definition for method 12 of type hud-manager-death-indicator
(defmethod hud-manager-death-indicator-method-12 ((this hud-manager-death-indicator) (arg0 in-game-hud) (arg1 death-indicator-record))
  (set! (-> arg1 spawn-time) (- (- (if *net-mgr*
                                       (-> *net-mgr* game-state time)
                                       0
                                       )
                                   (if *net-world*
                                       (-> *net-world* net-state game-start-time)
                                       0
                                       )
                                   )
                                (if *net-world*
                                    (-> *net-world* net-state total-pause-time)
                                    0
                                    )
                                )
        )
  (set! (-> arg1 previous-time) (- (- (if *net-mgr*
                                          (-> *net-mgr* game-state time)
                                          0
                                          )
                                      (if *net-world*
                                          (-> *net-world* net-state game-start-time)
                                          0
                                          )
                                      )
                                   (if *net-world*
                                       (-> *net-world* net-state total-pause-time)
                                       0
                                       )
                                   )
        )
  (set! (-> arg1 on) (the-as basic #t))
  (hud-method-27 arg0 arg0 0 'enter #f)
  (none)
  )

;; definition for method 14 of type hud-manager-death-indicator
;; WARN: Return type mismatch int vs none.
(defmethod hud-manager-death-indicator-method-14 ((this hud-manager-death-indicator))
  (let ((a2-0 (-> this death-indicators-queue (-> this death-indicators-queue-size))))
    (set! (-> a2-0 handle) (process->handle *current-hud*))
    (set! (-> a2-0 on) #f)
    (if (zero? (-> this death-indicators-queue-size))
        (hud-manager-death-indicator-method-12 this *current-hud* a2-0)
        )
    )
  (+! (-> this death-indicators-queue-size) 1)
  (none)
  )

;; definition for method 13 of type hud-manager-death-indicator
;; WARN: Return type mismatch symbol vs none.
(defmethod hud-manager-death-indicator-method-13 ((this hud-manager-death-indicator))
  (+! (-> this death-indicators-queue-size) -1)
  (dotimes (s5-0 (-> this death-indicators-queue-size))
    (mem-copy!
      (the-as pointer (-> this death-indicators-queue s5-0))
      (the-as pointer (-> this death-indicators-queue (+ s5-0 1)))
      24
      )
    )
  (none)
  )

;; definition for method 10 of type hud-manager-death-indicator
;; WARN: Return type mismatch int vs none.
;; WARN: Function (method 10 hud-manager-death-indicator) has a return type of none, but the expression builder found a return statement.
(defmethod hud-manager-method-10 ((this hud-manager-death-indicator))
  (while (and (> (-> this death-indicators-queue-size) 0)
              (not (handle->process (-> this death-indicators-queue 0 handle)))
              )
    (hud-manager-death-indicator-method-13 this)
    )
  (let ((s5-0 *current-hud*))
    (dotimes (s3-0 (-> this death-indicators-queue-size))
      (let ((s4-0 (-> this death-indicators-queue s3-0)))
        (when (= s5-0 (handle->process (-> s4-0 handle)))
          (if (and (not (-> s4-0 on)) (zero? s3-0))
              (hud-manager-death-indicator-method-12 this s5-0 s4-0)
              )
          (when (-> s4-0 on)
            (let ((s2-0 (- (- (- (if *net-mgr*
                                     (-> *net-mgr* game-state time)
                                     0
                                     )
                                 (if *net-world*
                                     (-> *net-world* net-state game-start-time)
                                     0
                                     )
                                 )
                              (if *net-world*
                                  (-> *net-world* net-state total-pause-time)
                                  0
                                  )
                              )
                           (-> s4-0 spawn-time)
                           )
                        )
                  )
              (let ((s1-0 (-> s4-0 previous-time)))
                (if (and (>= s2-0 600) (< s1-0 600))
                    (send-event s5-0 'exit)
                    )
                (when (and (>= s2-0 675) (< s1-0 675))
                  (when (< (+ s3-0 1) (-> this death-indicators-queue-size))
                    (let ((a2-1 (-> this death-indicators-queue (+ s3-0 1))))
                      (hud-manager-death-indicator-method-12 this (the-as in-game-hud (handle->process (-> a2-1 handle))) a2-1)
                      )
                    )
                  )
                )
              (if (< 900 s2-0)
                  (send-event s5-0 'hide-and-die)
                  )
              (set! (-> s4-0 previous-time) s2-0)
              )
            )
          (return #f)
          )
        )
      )
    )
  0
  (none)
  )

