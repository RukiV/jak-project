;; definition for method 9 of type hud-indicate-death
(defmethod hud-item-method-9 ((this hud-indicate-death))
  (let ((v1-1 (-> *viewport-array* mode)))
    (cond
      ((zero? v1-1)
       (set! (-> this position-y) -60)
       (set! (-> this scale) 256)
       )
      ((= v1-1 2)
       (set! (-> this position-y) -120)
       (set! (-> this scale) 179)
       )
      (else
        (set! (-> this position-y) 0)
        (set! (-> this scale) 256)
        )
      )
    )
  ((method-of-type hud-item-group hud-item-method-9) this)
  (none)
  )

