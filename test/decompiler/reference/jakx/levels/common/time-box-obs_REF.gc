;; definition for method 57 of type time-freeze-short-draw
;; WARN: Return type mismatch quaternion vs none.
(defmethod time-freeze-short-draw-method-57 ((this time-freeze-short-draw))
  (set! (-> this root trans y)
        (+ 4096.0 (* 8192.0 (sin (quaternion-y-angle (the-as quaternion (-> this root rot))))) (-> this base-y))
        )
  (quaternion-rotate-y!
    (the-as quaternion (-> this root rot))
    (the-as quaternion (-> this root rot))
    (* 16384.0 (seconds-per-frame))
    )
  (none)
  )

