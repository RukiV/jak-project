;; definition for function in-game-menu-startup
;; WARN: Return type mismatch int vs none.
(defun in-game-menu-startup ()
  (when (in-game-menu-allowed?)
    (if *in-game-menu-process*
        (deactivate (-> *in-game-menu-process* 0))
        )
    (set! (-> *in-game-menu-struct* last-selection-index) 0)
    (cond
      ((= (-> *net-mgr* game-type) 4)
       (view-push-context (cond
                            ((logtest? (-> *cpad-list* cpads 0 valid) 128)
                             0
                             )
                            ((cpad-pressed? 0 start)
                             0
                             )
                            ((cpad-pressed? 1 start)
                             1
                             )
                            ((logtest? (-> *cpad-list* cpads 1 valid) 128)
                             1
                             )
                            (else
                              0
                              )
                            )
                          )
       (logclear! (-> *cpad-list* cpads (view-get-active-index) button0-abs 0) (pad-buttons start))
       (logclear! (-> *cpad-list* cpads (view-get-active-index) button0-rel 0) (pad-buttons start))
       (set! *in-game-menu-process* (process->ppointer (the-as process (spawn-hud-in-game-menu))))
       (view-pop-context)
       )
      (else
        (set-master-mode 'game)
        (view-push-context (cond
                             ((logtest? (-> *cpad-list* cpads 0 valid) 128)
                              0
                              )
                             ((cpad-pressed? 0 start)
                              0
                              )
                             ((cpad-pressed? 1 start)
                              1
                              )
                             ((logtest? (-> *cpad-list* cpads 1 valid) 128)
                              1
                              )
                             (else
                               0
                               )
                             )
                           )
        (case (if *net-world*
                  (the-as int (-> (the-as game-task-node-info (-> *net-world* task-node-info)) net-play-mode))
                  18
                  )
          ((3)
           (set! *in-game-menu-process* (process->ppointer (the-as process (spawn-hud-in-game-menu))))
           )
          (else
            (set! *in-game-menu-process* (process->ppointer (the-as process (spawn-hud-in-game-menu-networked))))
            )
          )
        (logclear! (-> *cpad-list* cpads (view-get-active-index) button0-abs 0) (pad-buttons start))
        (logclear! (-> *cpad-list* cpads (view-get-active-index) button0-rel 0) (pad-buttons start))
        (view-pop-context)
        )
      )
    )
  0
  (none)
  )

