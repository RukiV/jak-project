(define *hud-in-game-menu-options-view-0-proc* (the-as hud-in-game-menu-options-view-0 #f))

;; definition of type hud-in-game-menu-options-view-0
(deftype hud-in-game-menu-options-view-0 (in-game-hud)
  ()
  )

;; definition for method 3 of type hud-in-game-menu-options-view-0
(defmethod inspect ((this hud-in-game-menu-options-view-0))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type in-game-hud inspect)))
    (t9-0 this)
    )
  (label cfg-4)
  this
  )

;; definition for method 7 of type hud-in-game-menu-options-view-0
;; WARN: Return type mismatch in-game-hud vs hud-in-game-menu-options-view-0.
(defmethod relocate ((this hud-in-game-menu-options-view-0) (offset int))
  (set! *hud-in-game-menu-options-view-0-proc* this)
  (if (nonzero? *hud-in-game-menu-options-view-0-proc*)
      (set! *hud-in-game-menu-options-view-0-proc* (&+ *hud-in-game-menu-options-view-0-proc* offset))
      )
  (the-as hud-in-game-menu-options-view-0 ((method-of-type in-game-hud relocate) this offset))
  )

;; definition for method 26 of type hud-in-game-menu-options-view-0
(defmethod hud-method-26 ((this hud-in-game-menu-options-view-0))
  (set! (-> this items) *hud-in-game-menu-options-view-0*)
  (set! (-> this manager) (new 'static 'basic-manager))
  (set! *hud-in-game-menu-options-view-0-proc* this)
  ((method-of-type in-game-hud hud-method-26) this)
  (none)
  )

;; definition for method 10 of type hud-in-game-menu-options-view-0
(defmethod deactivate ((this hud-in-game-menu-options-view-0))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (set! *hud-in-game-menu-options-view-0-proc* #f)
  ((method-of-type in-game-hud deactivate) this)
  (none)
  )

;; definition for method 24 of type hud-in-game-menu-options-view-0
(defmethod hud-method-24 ((this hud-in-game-menu-options-view-0))
  (when *debug-hud*
    (set! (-> this real-items) *hud-in-game-menu-options-view-0*)
    (hud-method-26 this)
    )
  ((method-of-type in-game-hud hud-method-24) this)
  (none)
  )

;; definition for function spawn-hud-in-game-menu-options-view-0
;; WARN: Return type mismatch process vs object.
(defun spawn-hud-in-game-menu-options-view-0 ()
  (cond
    (*hud-in-game-menu-options-view-0-proc*
      *hud-in-game-menu-options-view-0-proc*
      )
    (*net-game-mgr*
      (let ((v0-0 (ppointer->process (process-spawn
                                       hud-in-game-menu-options-view-0
                                       :init hud-init-by-other
                                       :name "hud-in-game-menu-options-view-0"
                                       :to *net-game-mgr*
                                       )
                                     )
                  )
            )
        (when (the-as hud-in-game-menu-options-view-0 v0-0)
          (set! (-> (the-as hud-in-game-menu-options-view-0 v0-0) inited-strings-count) 0)
          0
          )
        v0-0
        )
      )
    (else
      (the-as process #f)
      )
    )
  )

