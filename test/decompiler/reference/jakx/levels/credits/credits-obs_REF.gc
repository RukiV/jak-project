;;-*-Lisp-*-
(in-package goal)

;; definition of type credits-char
(deftype credits-char (structure)
  ((levname  basic)
   (skel     basic)
   (anim     uint32)
   (scale    float)
   (dt       uint8)
   (rotoff   float)
   (rotvel   float)
   )
  )

;; definition for method 3 of type credits-char
(defmethod inspect ((this credits-char))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'credits-char)
  (format #t "~1Tlevname: ~A~%" (-> this levname))
  (format #t "~1Tskel: ~A~%" (-> this skel))
  (format #t "~1Tanim: ~D~%" (-> this anim))
  (format #t "~1Tscale: ~f~%" (-> this scale))
  (format #t "~1Tdt: ~D~%" (-> this dt))
  (format #t "~1Trotoff: ~f~%" (-> this rotoff))
  (format #t "~1Trotvel: ~f~%" (-> this rotvel))
  (label cfg-4)
  this
  )

