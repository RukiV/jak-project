;; definition for symbol *credits-chars*, type (array credits-char)
(define *credits-chars* <static-data L157>)

;; definition of type hirez-viewer
(deftype hirez-viewer (process-drawable)
  ((char     credits-char)
   (id       symbol)
   (credits  symbol)
   )
  (:state-methods
    idle
    )
  )

;; definition for method 3 of type hirez-viewer
(defmethod inspect ((this hirez-viewer))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type process-drawable inspect)))
    (t9-0 this)
    )
  (format #t "~2Tchar: #<credits-char @ #x~X>~%" (-> this char))
  (format #t "~2Tid: ~D~%" (-> this id))
  (format #t "~2Tcredits: ~A~%" (-> this credits))
  (label cfg-4)
  this
  )

;; failed to figure out what this is:
(defstate idle (hirez-viewer)
  :virtual #t
  :trans (behavior ()
    (logclear! (-> self draw status) (draw-control-status no-draw-temp uninited))
    )
  :code (behavior ()
    (cond
      ((nonzero? (-> self skel))
       (until #f
         (ja-channel-set! 1)
         (let ((gp-0
                 (+ (-> (the-as
                          art-joint-anim
                          (-> (the-as art-joint-anim (+ (* (-> self char anim) 4) (the-as uint (-> self draw art-group))))
                              blend-shape-anim
                              )
                          )
                        frames
                        num-frames
                        )
                    -1
                    )
                 )
               )
           (ja-no-eval :group! (-> self draw art-group data (-> self char anim))
                       :num! (seek!
                         (the float
                              (+ (-> (the-as
                                       art-joint-anim
                                       (-> (the-as art-joint-anim (+ (* (-> self char anim) 4) (the-as uint (-> self draw art-group))))
                                           blend-shape-anim
                                           )
                                       )
                                     frames
                                     num-frames
                                     )
                                 -1
                                 )
                              )
                         )
                       :frame-num 0.0
                       )
           (until (ja-done? 0)
             (ja-post)
             (let ((f30-0 (ja-frame-num 0)))
               (ja-rate 0)
               (if (< (the float (+ gp-0 -15)) f30-0)
                   (send-event (ppointer->process (-> self parent)) 'anim-ending)
                   )
               )
             (suspend)
             (ja :num! (seek!))
             )
           )
         )
       #f
       )
      (else
        (until #f
          (format *stdcon* "no skel~%")
          (suspend)
          )
        #f
        )
      )
    )
  )

;; definition for function hirez-viewer-init-by-other
;; INFO: Used lq/sq
(defbehavior hirez-viewer-init-by-other hirez-viewer ((arg0 credits-char) (arg1 symbol))
  (set! (-> self credits) arg1)
  (set! (-> self char) arg0)
  (set! (-> self root) (new 'process 'trsqv))
  (set-vector! (-> self root scale) 1.0 1.0 1.0 1.0)
  (quaternion-copy! (the-as quaternion (-> self root rot)) *unity-quaternion*)
  (set! (-> self root trans quad) (the-as uint128 0))
  (set! (-> self level) (level-get *level* 'jakcred))
  (let ((gp-1 (art-group-get-by-name *level* (the-as string (-> arg0 skel)) (&-> self level))))
    (when gp-1
      (when (art-group-get-by-name *level* (the-as string (-> gp-1 data 0)) (&-> self level))
        (initialize-skeleton self (the-as skeleton-group gp-1) (the-as pair 0))
        (logior! (-> self skel status) (joint-control-status blend-shape eye-anim))
        )
      )
    )
  (logclear! (-> self draw status) (draw-control-status no-draw))
  (set! (-> self draw light-index) (the-as uint 10))
  (ja-post)
  (go-virtual idle)
  )

;; definition for function spawn-hirez-viewer
;; WARN: Return type mismatch int vs handle.
(defun spawn-hirez-viewer ((arg0 credits-char) (arg1 symbol) (arg2 process))
  (the-as
    handle
    (ppointer->handle (process-spawn hirez-viewer arg0 arg1 :name "hirez-viewer" :to arg2 :stack-size #x20000))
    )
  )

;; definition for function draw-end-credits
(defun draw-end-credits ((arg0 level) (arg1 float))
  (* 1.4 arg1)
  0
  (let ((s5-0 (new
                'stack
                'font-context
                *font-default-matrix*
                20
                0
                8396850.0
                (font-color font-color-51)
                (font-flags shadow kerning)
                )
              )
        )
    0.0
    0
    (let ((f0-4 (* 0.15 arg1)))
      (if (and (< 2600.0 f0-4) (cpad-pressed? 0 triangle circle x))
          (return #t)
          )
      (let ((v1-12 s5-0))
        (set! (-> v1-12 width) 275.0)
        )
      (set-height! s5-0 416)
      (set-scale! s5-0 0.55)
      (set! (-> s5-0 flags) (font-flags kerning middle large ff12))
      (let ((s4-1 (- 416 (the int f0-4))))
        (dotimes (s3-0 (length *credits-ids*))
          (let ((s2-0 (lookup-text arg0 (-> *credits-ids* s3-0) #f)))
            (set! (-> s5-0 origin y) (the float s4-1))
            (let ((t9-2 print-game-text)
                  (a0-11 s2-0)
                  (a1-4 s5-0)
                  (a2-2 #t)
                  (a3-1 44)
                  (t0-1 787)
                  )
              (let* ((f0-8 (t9-2 a0-11 a1-4 a2-2 a3-1 (the-as bucket-id t0-1)))
                     (f30-0 (+ 3.0 f0-8))
                     )
                (when (and (< s4-1 416) (> (+ s4-1 (the int f30-0)) 0))
                  (let ((t9-3 print-game-text)
                        (a1-5 s5-0)
                        (a2-3 #f)
                        (a3-2 44)
                        (t0-2 787)
                        )
                    (t9-3 s2-0 a1-5 a2-3 a3-2 (the-as bucket-id t0-2))
                    )
                  )
                (if (and (= s3-0 (+ (length *credits-ids*) -1)) (< s4-1 -10))
                    (return #t)
                    )
                (+! s4-1 (the int f30-0))
                )
              )
            )
          )
        )
      )
    )
  #f
  )

;; definition of type end-credits-proc
(deftype end-credits-proc (process)
  ((char-viewer  handle)
   )
  (:state-methods
    running
    die
    )
  )

;; definition for method 3 of type end-credits-proc
(defmethod inspect ((this end-credits-proc))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type process inspect)))
    (t9-0 this)
    )
  (format #t "~2Tchar-viewer: ~D~%" (-> this char-viewer))
  (label cfg-4)
  this
  )

;; definition of type end-credits-character-viewer
(deftype end-credits-character-viewer (process)
  ((hirez-viewer      handle)
   (vehicle           handle)
   (turntable-handle  handle)
   (last-up-time      int32)
   (finish            basic)
   (anim-ending       basic)
   (current-char      credits-char)
   )
  (:state-methods
    running
    die
    )
  )

;; definition for method 3 of type end-credits-character-viewer
(defmethod inspect ((this end-credits-character-viewer))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type process inspect)))
    (t9-0 this)
    )
  (format #t "~2Thirez-viewer: ~D~%" (-> this hirez-viewer))
  (format #t "~2Tvehicle: ~D~%" (-> this vehicle))
  (format #t "~2Tturntable-handle: ~D~%" (-> this turntable-handle))
  (format #t "~2Tlast-up-time: ~D~%" (-> this last-up-time))
  (format #t "~2Tfinish: ~A~%" (-> this finish))
  (format #t "~2Tanim-ending: ~A~%" (-> this anim-ending))
  (format #t "~2Tcurrent-char: #<credits-char @ #x~X>~%" (-> this current-char))
  (label cfg-4)
  this
  )

;; definition for function end-credits-character-viewer-init-by-other
(defbehavior end-credits-character-viewer-init-by-other end-credits-character-viewer ()
  (stack-size-set! (-> self main-thread) 512)
  (set! (-> self mask) (process-mask menu))
  (set! (-> self hirez-viewer) (the-as handle #f))
  (set! (-> self finish) #f)
  (set! (-> self anim-ending) #f)
  (go-virtual running)
  )

;; failed to figure out what this is:
(defstate running (end-credits-proc)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('go-die)
       (go-virtual die)
       )
      )
    )
  :code (behavior ()
    (local-vars (a0-2 object))
    (lobby-level-set! 1 'credits 'special)
    (until a0-2
      (suspend)
      (let ((v1-1 (level-get *level* 'credits)))
        (set! a0-2 (and v1-1 (= (-> v1-1 status) 'active)))
        )
      )
    (set! (-> self char-viewer)
          (process->handle
            (ppointer->process (process-spawn end-credits-character-viewer :name "end-credits-character-viewer" :to self))
            )
          )
    (let ((gp-1 (current-time))
          (s5-0 (level-get *level* 'credits))
          )
      (until #f
        (suspend)
        (if (draw-end-credits s5-0 (the float (- (current-time) gp-1)))
            (goto cfg-19)
            )
        )
      )
    #f
    (label cfg-19)
    (suspend)
    (send-event (handle->process (-> self char-viewer)) 'finish)
    (while (handle->process (-> self char-viewer))
      (suspend)
      )
    (suspend)
    (suspend)
    (go-virtual die)
    )
  )

;; definition for function update-stuff
;; INFO: Used lq/sq
;; WARN: Return type mismatch int vs none.
(defbehavior update-stuff end-credits-character-viewer ()
  (let ((v1-1 (handle->process (-> self hirez-viewer)))
        (gp-0 (handle->process (-> self turntable-handle)))
        )
    (when (and v1-1 gp-0)
      (set! (-> (the-as process-drawable v1-1) root trans quad) (-> (the-as process-drawable gp-0) root trans quad))
      (quaternion-copy!
        (the-as quaternion (-> (the-as process-drawable v1-1) root rot))
        (the-as quaternion (-> (the-as process-drawable gp-0) root rot))
        )
      (let ((f0-1 (the float (- (current-time) (the-as time-frame (-> self last-up-time)))))
            (s5-0 (new 'stack-no-clear 'event-message-block))
            )
        (let* ((f0-3 (* 2.5 f0-1 (-> self current-char rotvel)))
               (f0-5 (+ -20000.0 f0-3 (* 182.04445 (-> self current-char rotoff))))
               )
          (quaternion-axis-angle! (the-as quaternion (&-> s5-0 to-handle)) 0.0 1.0 0.0 f0-5)
          )
        (quaternion-copy!
          (the-as quaternion (-> (the-as process-drawable gp-0) root rot))
          (the-as quaternion (&-> s5-0 to-handle))
          )
        )
      )
    )
  0
  (none)
  )

;; failed to figure out what this is:
(defstate running (end-credits-character-viewer)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (local-vars (v0-0 object))
    (case message
      (('anim-ending)
       (set! v0-0 #t)
       (set! (-> self anim-ending) (the-as basic v0-0))
       v0-0
       )
      (('go-die)
       (go-virtual die)
       )
      (('finish)
       (set! v0-0 #t)
       (set! (-> self finish) (the-as basic v0-0))
       v0-0
       )
      )
    )
  :code L21
  )

;; definition for method 10 of type end-credits-character-viewer
(defmethod deactivate ((this end-credits-character-viewer))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (send-event (handle->process (-> this turntable-handle)) 'no-pad #f)
  (send-event (handle->process (-> this turntable-handle)) 'auto-rotate? #t)
  (kill-by-type-inherited vehicle *active-pool*)
  (call-parent-method this)
  (none)
  )

;; failed to figure out what this is:
(defstate die (end-credits-proc)
  :virtual #t
  :code (behavior ()
    (suspend)
    (lobby-level-set! 1 #f #f)
    )
  )

;; failed to figure out what this is:
(defstate die (end-credits-character-viewer)
  :virtual #t
  :code (behavior ()
    '()
    )
  )

;; definition for function end-credits-proc-init-by-other
(defbehavior end-credits-proc-init-by-other end-credits-proc ()
  (set! (-> self mask) (process-mask menu))
  (set! (-> self char-viewer) (the-as handle #f))
  (go-virtual running)
  )

;; definition for function activate-end-credits-proc
;; WARN: Return type mismatch int vs none.
(defun activate-end-credits-proc ()
  (set! (-> (the-as (pointer handle) *end-credits-proc*) 0)
        (process->handle (ppointer->process (process-spawn end-credits-proc :name "end-credits-proc")))
        )
  0
  (none)
  )
