;; definition for symbol *palm-tree-a-debris-params*, type debris-static-params
(define *palm-tree-a-debris-params*
  (new 'static 'debris-static-params
    :joints (new 'static 'boxed-array :type debris-static-joint-params
      (new 'static 'debris-static-joint-params
        :parent-joint-index 3
        :group "skel-palm-tree-debris-a"
        :offset (new 'static 'vector :data (new 'static 'array float 4 12288.0 102400.0 -12288.0 1.0))
        )
      (new 'static 'debris-static-joint-params
        :parent-joint-index 3
        :group "skel-palm-tree-debris-a"
        :offset (new 'static 'vector :data (new 'static 'array float 4 12288.0 102400.0 -4096.0 1.0))
        )
      (new 'static 'debris-static-joint-params
        :parent-joint-index 3
        :group "skel-palm-tree-debris-a"
        :offset (new 'static 'vector :data (new 'static 'array float 4 16384.0 102400.0 4096.0 1.0))
        )
      )
    :collide-spec (collide-spec backgnd)
    :art-level #f
    :vscale 20480.0
    :volume-time 2.0
    :play-delay 45
    :min-speed 8192.0
    :max-speed 40960.0
    )
  )

;; definition for method 54 of type palm-tree-a
;; ERROR: function was not converted to expressions. Cannot decompile.

;; definition for method 53 of type palm-tree-a
(defmethod palm-tree-method-53 ((this palm-tree-a))
  (let ((s5-0 (new 'process 'collide-shape this (collide-list-enum usually-hit-by-player))))
    (let ((v1-2 (new 'process 'collide-shape-prim-sphere s5-0 (the-as uint 0))))
      (set! (-> v1-2 prim-core collide-as) (collide-spec obstacle camera-blocker))
      (set! (-> v1-2 prim-core collide-with) (collide-spec jak bot player-list))
      (set! (-> v1-2 prim-core action) (collide-action solid))
      (set! (-> v1-2 transform-index) 0)
      (set-vector! (-> v1-2 local-sphere) 0.0 12288.0 0.0 20480.0)
      (set! (-> s5-0 total-prims) (the-as uint 1))
      (set! (-> s5-0 root-prim) v1-2)
      )
    (set! (-> s5-0 nav-radius) (* 0.75 (-> s5-0 root-prim local-sphere w)))
    (let ((v1-5 (-> s5-0 root-prim)))
      (set! (-> s5-0 backup-collide-as) (-> v1-5 prim-core collide-as))
      (set! (-> s5-0 backup-collide-with) (-> v1-5 prim-core collide-with))
      )
    (set! (-> this root) s5-0)
    )
  (initialize-skeleton
    this
    (the-as skeleton-group (art-group-get-by-name *level* "skel-palm-tree-a" (the-as (pointer level) #f)))
    (the-as pair 0)
    )
  ((method-of-type joint-mod-rotate-local init)
   (-> this jmods 0)
   this
   (the-as uint 3)
   (joint-mod-base-flags attached)
   )
  (init (-> this jmods 1) this (the-as uint 4) (joint-mod-base-flags attached))
  (init (-> this jmods 2) this (the-as uint 5) (joint-mod-base-flags attached))
  (init (-> this jmods 3) this (the-as uint 6) (joint-mod-base-flags attached))
  (init (-> this jmods 4) this (the-as uint 7) (joint-mod-base-flags attached))
  ((method-of-type palm-tree palm-tree-method-53) this)
  (none)
  )

