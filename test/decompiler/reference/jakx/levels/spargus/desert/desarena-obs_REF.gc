;; definition of type palm-tree
(deftype palm-tree (process-drawable)
  ((attack-vel         vector                  :inline)
   (spring-pos         vector                  :inline)
   (spring-vel         vector                  :inline)
   (jmods              joint-mod-rotate-local  5 :inline)
   (last-impulse-time  int32)
   )
  (:state-methods
    idle
    vibrate
    )
  (:methods
    (palm-tree-method-52 (_type_) none)
    (palm-tree-method-53 (_type_) none)
    (palm-tree-method-54 (_type_) none)
    (palm-tree-method-55 (_type_) none)
    )
  )

;; definition for method 3 of type palm-tree
(defmethod inspect ((this palm-tree))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type process-drawable inspect)))
    (t9-0 this)
    )
  (format #t "~2Tattack-vel: #<vector @ #x~X>~%" (-> this attack-vel))
  (format #t "~2Tspring-pos: #<vector @ #x~X>~%" (-> this spring-pos))
  (format #t "~2Tspring-vel: #<vector @ #x~X>~%" (-> this spring-vel))
  (format #t "~2Tjmods[5] @ #x~X~%" (-> this jmods))
  (format #t "~2Tlast-impulse-time: ~D~%" (-> this last-impulse-time))
  (label cfg-4)
  this
  )

