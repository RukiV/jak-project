              )

;; failed to figure out what this is:
(defstate idle (palm-tree)
  :virtual #t
  :enter (behavior ()
    '()
    )
  :trans (behavior ()
    (if (or (>= (vector-length (-> self spring-vel)) 1.0) (>= (vector-length (-> self spring-pos)) 1.0))
        (go-virtual vibrate)
        )
    )
  :code sleep-code
  :post ja-post
  )

;; failed to figure out what this is:
(defstate vibrate (palm-tree)
  :virtual #t
  :trans (behavior ()
    (if (and (>= 0.01 (vector-length (-> self spring-vel))) (>= 0.01 (vector-length (-> self spring-pos))))
        (go-virtual idle)
        )
    )
  :code sleep-code
  :post (behavior ()
    (palm-tree-method-52 self)
    )
  )

