;; definition for symbol *progress-save-info*, type mc-slot-info
(define *progress-save-info* (new 'global 'mc-slot-info))

;; definition for function post-memcard
;; WARN: Return type mismatch none vs object.
(defun post-memcard ()
  (mc-get-slot-info 0 *progress-save-info*)
  )

;; definition for symbol *game-name-entered*, type object
(define *game-name-entered* (the-as object (new 'global 'string 16 (the-as string #f))))

;; definition for function draw-language-select
;; ERROR: function was not converted to expressions. Cannot decompile.

;; definition for function check-language
;; WARN: Found some very strange gotos. Check result carefully, this is not well tested.
;; WARN: Return type mismatch int vs object.
;; WARN: new jak 2 until loop case, check carefully
(defun check-language ()
  (label cfg-0)
  (let ((gp-0 (new 'stack-no-clear 'mc-slot-info)))
    (mc-get-slot-info 0 gp-0)
    (when (zero? (-> gp-0 known))
      (set-blackout-frames (seconds 0.05))
      (suspend)
      (goto cfg-0)
      )
    (set! (-> *setting-control* user-default bg-a) 0.0)
    (when (and (= (scf-get-territory) 1) (zero? (scf-get-language)))
      (cond
        ((or (zero? (-> gp-0 handle)) (zero? (-> gp-0 formatted)) (zero? (-> gp-0 inited)) (< (-> gp-0 last-file) 0))
         (set-blackout-frames 0)
         (let ((s5-2 0)
               (gp-1 11)
               )
           (until #f
             (when (cpad-pressed? 0 left)
               (+! s5-2 -1)
               (if (< s5-2 0)
                   (set! s5-2 6)
                   )
               )
             (when (cpad-pressed? 0 right)
               (+! s5-2 1)
               (if (< 6 s5-2)
                   (set! s5-2 0)
                   )
               )
             (if (cpad-pressed? 0 x)
                 (goto cfg-25)
                 )
             (draw-language-select)
             (suspend)
             )
           #f
           (label cfg-25)
           (cond
             ((zero? s5-2)
              (set! gp-1 0)
              )
             ((= s5-2 1)
              (set! gp-1 1)
              )
             ((= s5-2 2)
              (set! gp-1 2)
              )
             ((= s5-2 3)
              (set! gp-1 3)
              )
             ((= s5-2 4)
              (set! gp-1 4)
              )
             ((= s5-2 5)
              (set! gp-1 8)
              )
             ((= s5-2 6)
              (set! gp-1 9)
              )
             )
           (set! (-> *setting-control* user-default language) (the-as language-enum gp-1))
           (set! (-> *setting-control* user-default subtitle-language) (the-as uint gp-1))
           (when (< (the-as uint gp-1) (the-as uint 5))
             (set! (-> *setting-control* user-default audio-language) (the-as uint gp-1))
             gp-1
             )
           )
         )
        (else
          (let ((v1-58 (-> gp-0 file (-> gp-0 last-file) language)))
            (when (and (>= v1-58 0) (< v1-58 (the-as uint 11)))
              (set! (-> *setting-control* user-default language) (the-as language-enum v1-58))
              (set! (-> *setting-control* user-default subtitle-language) v1-58)
              (when (< v1-58 (the-as uint 5))
                (set! (-> *setting-control* user-default audio-language) v1-58)
                (the-as int v1-58)
                )
              )
            )
          )
        )
      )
    )
  )

;; failed to figure out what this is:
(defstate target-title (target)
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('change-mode)
       (case (-> block param 0)
         (('grab)
          (if (not (-> block param 1))
              #t
              (go target-float)
              )
          )
         )
       )
      (else
        (target-generic-event-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (local-vars (a0-0 none))
    (let ((a0-1 (-> *hud-engine* alive-list next0)))
      *hud-engine*
      (let ((s5-0 (-> a0-1 next0)))
        (while (!= a0-1 (-> *hud-engine* alive-list-end))
          (deactivate ((method-of-type connection get-process) (the-as connection a0-1)))
          (set! a0-1 s5-0)
          *hud-engine*
          (set! s5-0 (-> s5-0 next0))
          )
        )
      )
    (when a0-0
      (let ((v1-13 (-> self mask))
            (a0-4 (-> *game-info* mode))
            )
        (set! (-> *game-info* mode) 'movie)
        (logior! (-> self mask) (process-mask no-kill))
        (set! (-> self mask) v1-13)
        (set! (-> *game-info* mode) a0-4)
        )
      (send-event (ppointer->process (-> *setting-control* user-current movie)) 'abort)
      )
    (lobby-start)
    )
  :exit (behavior ()
    '()
    )
  :code sleep-code
  :post post-memcard
  )

;; failed to figure out what this is:
(defstate target-intro (target)
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
