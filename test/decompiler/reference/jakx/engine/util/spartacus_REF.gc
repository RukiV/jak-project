;; definition for function spartacus-birth-func-set-color
;; INFO: Used lq/sq
;; WARN: Return type mismatch int vs none.
(defun spartacus-birth-func-set-color ((arg0 sparticle-system)
                              (arg1 sparticle-cpuinfo)
                              (arg2 sprite-vec-data-3d)
                              (arg3 sparticle-launcher)
                              (arg4 sparticle-launch-state)
                              )
  (with-pp
    (let ((a0-1 (-> arg4 control proc))
          (f30-0 (-> arg2 r-g-b-a w))
          )
      (when a0-1
        (let ((s5-0 (-> a0-1 entity)))
          (set! (-> arg2 r-g-b-a x) (res-lump-float s5-0 'color-r :default (-> arg2 r-g-b-a x)))
          (set! (-> arg2 r-g-b-a y) (res-lump-float s5-0 'color-g :default (-> arg2 r-g-b-a y)))
          (set! (-> arg2 r-g-b-a z) (res-lump-float s5-0 'color-b :default (-> arg2 r-g-b-a z)))
          (when (and *debug-segment* *spartacus-editor* (nonzero? *spartacus-editor*))
            (let ((a1-4 (new 'stack-no-clear 'event-message-block)))
              (set! (-> a1-4 from) (process->ppointer pp))
              (set! (-> a1-4 num-params) 1)
              (set! (-> a1-4 message) 'get-color)
              (set! (-> a1-4 param 0) (the-as uint s5-0))
              (let ((a0-8 (send-event-function (the-as process-tree *spartacus-editor*) a1-4)))
                (when a0-8
                  (set! (-> arg2 r-g-b-a quad) (-> (the-as vector a0-8) quad))
                  (set! (-> arg2 r-g-b-a w) f30-0)
                  )
                )
              )
            )
          )
        )
      )
    0
    (none)
    )
  )

