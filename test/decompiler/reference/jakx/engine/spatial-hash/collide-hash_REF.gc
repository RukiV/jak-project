;; definition for function add-collide-debug-box
;; WARN: Return type mismatch symbol vs none.
(defun add-collide-debug-box ((arg0 vector) (arg1 rgba))
  (rlet ((vf1 :class vf)
         (vf2 :class vf)
         (vf3 :class vf)
         )
    (let ((a3-0 (new 'stack-no-clear 'inline-array 'vector 2)))
      (nop!)
      (.lvf vf1 (&-> arg0 quad))
      (.sub.w.vf vf2 vf1 vf1)
      (nop!)
      (.add.w.vf vf3 vf1 vf1)
      (nop!)
      (nop!)
      (.svf (&-> a3-0 0 quad) vf2)
      (nop!)
      (.svf (&-> a3-0 1 quad) vf3)
      (add-debug-box #t (bucket-id bucket793) (-> a3-0 0) (-> a3-0 1) arg1)
      )
    (none)
    )
  )

;; definition (debug) for function print-collide-cache-tri-count
;; WARN: Return type mismatch object vs none.
(defun-debug print-collide-cache-tri-count ((arg0 collide-cache))
  (let ((gp-0 0)
        (s4-0 0)
        (s5-0 0)
        (s3-0 0)
        )
    (dotimes (v1-0 (-> arg0 num-tris))
      (case (-> (the-as collide-cache-tri (+ (the-as uint (-> arg0 tris)) (* v1-0 64))) pat mode)
        (((pat-mode ground))
         (+! gp-0 1)
         )
        (((pat-mode wall))
         (+! s5-0 1)
         )
        (((pat-mode obstacle))
         (+! s4-0 1)
         )
        (else
          (+! s3-0 1)
          )
        )
      )
    (format
      *stdcon*
      "tris ~d (~4,,1f%) "
      (-> arg0 num-tris)
      (/ (* 100.0 (the float (-> arg0 num-tris))) (the float (-> arg0 max-tris)))
      )
    (format *stdcon* "(ground ~d, wall ~d, obstacle ~d, other ~d)~%" gp-0 s5-0 s4-0 s3-0)
    )
  (none)
  )

;; definition (debug) for function print-exceeded-max-cache-tris
;; WARN: Return type mismatch int vs none.
(defun-debug print-exceeded-max-cache-tris ()
  (with-pp
    (when (not (or *already-printed-exeeded-max-cache-tris* *display-capture-mode*))
      (set! *already-printed-exeeded-max-cache-tris* #t)
      (if pp
          (format *stdcon* "Exceeded collide cache max # of tris (~s)!~%" (-> pp name))
          (format *stdcon* "Exceeded collide cache max # of tris!~%")
          )
      (print-collide-cache-tri-count *collide-cache*)
      )
    0
    (none)
    )
  )

