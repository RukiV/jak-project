;; failed to figure out what this is:
(defstate restart (vehicle)
  :virtual #t
  :event vehicle-event-handler
  :enter (behavior ()
    (set-time! (-> (the-as vehicle self) state-time))
    (vehicle-method-162 (the-as vehicle self))
    (set! (-> (the-as vehicle self) unknown-byte-2124) (the-as uint 1))
    (set! (-> (the-as vehicle self) killed-by) -1)
    (set! (-> (the-as vehicle self) killed-with) 0)
    (set! (-> (the-as (pointer int32) self) 530) (- (- (if *net-mgr*
                                                           (-> *net-mgr* game-state time)
                                                           0
                                                           )
                                                       (if *net-world*
                                                           (-> *net-world* net-state game-start-time)
                                                           0
                                                           )
                                                       )
                                                    (if *net-world*
                                                        (-> *net-world* net-state total-pause-time)
                                                        0
                                                        )
                                                    )
          )
    (vehicle-method-199 (the-as vehicle self))
    (rigid-body-object-method-73 (the-as vehicle self))
    (rigid-body-object-method-75 (the-as vehicle self))
    (vehicle-method-126 (the-as vehicle self))
    (vehicle-method-118 (the-as vehicle self))
    (vehicle-method-144 (the-as vehicle self))
    (if (and (logtest? (-> (the-as vehicle self) flags) 1024)
             (if (= (/ (-> (the-as vehicle self) player-id) 2) (if *net-mgr*
                                                                   (-> *net-mgr* game-state local-machine-idx)
                                                                   0
                                                                   )
                    )
                 #t
                 #f
                 )
             )
        (screen-filter-method-10
          (-> *screen-filter-array* (logand (-> (the-as vehicle self) player-id) 1))
          (new 'static 'vector)
          (new 'static 'vector :data (new 'static 'array float 4 0.0 0.0 0.0 127.0))
          30.0
          (bucket-id bucket786)
          #xfffffe
          #x33001
          (the-as symbol 0)
          )
        )
    )
  :trans (behavior ()
    (if (time-elapsed? (-> self state-time) (seconds 0.1))
        (go-virtual die)
        )
    )
  :code sleep-code
  )

