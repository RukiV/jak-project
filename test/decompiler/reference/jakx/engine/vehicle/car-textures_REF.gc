;;-*-Lisp-*-
(in-package goal)

;; definition of type car-texture-work
(deftype car-texture-work (structure)
  ((adgif-tmpl   dma-gif-packet  :inline)
   (sprite-tmpl  dma-gif-packet  :inline)
   (white        vector4w        :inline)
   (blur         vector4w        :inline)
   )
  )

;; definition for method 3 of type car-texture-work
(defmethod inspect ((this car-texture-work))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'car-texture-work)
  (format #t "~1Tadgif-tmpl: #<dma-gif-packet @ #x~X>~%" (-> this adgif-tmpl))
  (format #t "~1Tsprite-tmpl: #<dma-gif-packet @ #x~X>~%" (-> this sprite-tmpl))
  (format #t "~1Twhite: #<vector4w @ #x~X>~%" (-> this white))
  (format #t "~1Tblur: #<vector4w @ #x~X>~%" (-> this blur))
  (label cfg-4)
  this
  )

;; definition for symbol *car-texture-work*, type car-texture-work
(define *car-texture-work* (new 'static 'car-texture-work
                             :adgif-tmpl (new 'static 'dma-gif-packet
                               :dma-vif (new 'static 'dma-packet
                                 :dma (new 'static 'dma-tag :qwc #x6 :id (dma-tag-id cnt))
                                 :vif1 (new 'static 'vif-tag :imm #x6 :cmd (vif-cmd direct) :msk #x1)
                                 )
                               :gif (new 'static 'array uint64 2 #x1000000000008005 #xe)
                               )
                             :sprite-tmpl (new 'static 'dma-gif-packet
                               :dma-vif (new 'static 'dma-packet
                                 :dma (new 'static 'dma-tag :qwc #x6 :id (dma-tag-id cnt))
                                 :vif1 (new 'static 'vif-tag :imm #x6 :cmd (vif-cmd direct) :msk #x1)
                                 )
                               :gif (new 'static 'array uint64 2 #x502b400000008001 #x52521)
                               )
                             :white (new 'static 'vector4w :x #x80 :y #x80 :z #x80 :w #x80)
                             :blur (new 'static 'vector4w :x #x80 :y #x80 :z #x80 :w #x80)
                             )
        )

