;; definition of type car-name-info
(deftype car-name-info (structure)
  ((name              basic)
   (part-dest-name    basic)
   (part-source-name  basic)
   (look-name         basic)
   (layer-name        basic)
   (damage            int32)
   )
  )

;; definition for method 3 of type car-name-info
(defmethod inspect ((this car-name-info))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'car-name-info)
  (format #t "~1Tname: ~A~%" (-> this name))
  (format #t "~1Tpart-dest-name: ~A~%" (-> this part-dest-name))
  (format #t "~1Tpart-source-name: ~A~%" (-> this part-source-name))
  (format #t "~1Tlook-name: ~A~%" (-> this look-name))
  (format #t "~1Tlayer-name: ~A~%" (-> this layer-name))
  (format #t "~1Tdamage: ~D~%" (-> this damage))
  (label cfg-4)
  this
  )

