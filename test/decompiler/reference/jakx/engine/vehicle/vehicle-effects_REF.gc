;; definition for function calc-fade-vals
;; WARN: Return type mismatch object vs none.
(defun calc-fade-vals ((arg0 float))
  (let* ((f1-1 (/ arg0 METER_LENGTH))
         (f0-3 (- f1-1 (the float (the int f1-1))))
         (f1-3 (* 4096.0 (- f1-1 f0-3)))
         (f1-5 (/ -1.0 (* (- 1.0 f0-3) f1-3)))
         (f0-4 (/ f0-3 (- 1.0 f0-3)))
         )
    (format #t ":fade-a ~,,10f~%:fade-b ~,,20f~%" f1-5 f0-4)
    )
  (none)
  )

;; definition for symbol *vehicle-headlight-glow-template*, type object
(define *vehicle-headlight-glow-template*
