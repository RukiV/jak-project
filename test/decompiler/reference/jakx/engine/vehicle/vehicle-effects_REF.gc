                   :z-offset 819.2
                   :size-y 8192.0
                   :color (new 'static 'rgbaf :data (new 'static 'array float 4 255.0 192.0 128.0 16.0))
                   :fade-a -0.0000122044
                   :fade-b 8.997864
                   :tex-id (new 'static 'texture-id :index #x15 :page #x4)
