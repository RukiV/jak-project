  (format #t "~1Tdraw-tmpl: #<dma-gif-packet @ #x~X>~%" (-> this draw-tmpl))
  (format #t "~1Tcolor0: #<vector4w @ #x~X>~%" (-> this color0))
  (format #t "~1Tcolor1: #<vector4w @ #x~X>~%" (-> this color1))
  (label cfg-4)
  this
  )

