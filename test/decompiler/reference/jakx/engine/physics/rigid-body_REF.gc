;; definition for symbol *debug-move-rigid-body*, type symbol
(define *debug-move-rigid-body* #t)

;; definition of type debug-rigid-body-move
(deftype debug-rigid-body-move (structure)
  ((vel-dot-norm     float)
   (time-step-scale  float)
   (best-u           float)
   (i-step           int8)
   (proc2            basic)
   (rbody2           basic)
   (best-my-prim     basic)
   (bsphere          sphere             :inline)
   (impact-info      rigid-body-impact  :inline)
   (pad-pre-rbody    uint8              16)
   (rbody-data       uint8              304)
   )
  )

;; definition for method 3 of type debug-rigid-body-move
(defmethod inspect ((this debug-rigid-body-move))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'debug-rigid-body-move)
  (format #t "~1Tvel-dot-norm: ~f~%" (-> this vel-dot-norm))
  (format #t "~1Ttime-step-scale: ~f~%" (-> this time-step-scale))
  (format #t "~1Tbest-u: ~f~%" (-> this best-u))
  (format #t "~1Ti-step: ~D~%" (-> this i-step))
  (format #t "~1Tproc2: ~A~%" (-> this proc2))
  (format #t "~1Trbody2: ~A~%" (-> this rbody2))
  (format #t "~1Tbest-my-prim: ~A~%" (-> this best-my-prim))
  (format #t "~1Tbsphere: #<sphere @ #x~X>~%" (-> this bsphere))
  (format #t "~1Timpact-info: #<rigid-body-impact @ #x~X>~%" (-> this impact-info))
  (format #t "~1Trbody: #<rigid-body-control @ #x~X>~%" (-> this rbody-data))
  (label cfg-4)
  this
  )

