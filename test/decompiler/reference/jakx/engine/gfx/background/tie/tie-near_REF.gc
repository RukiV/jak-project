          (set! (-> (the-as (pointer int32) a0-1)) #x15000004)
          (set! (-> (the-as (pointer uint32) a0-1) 1) (the-as uint #x5000000))
          (set! (-> (the-as (pointer uint32) a0-1) 2) (the-as uint #x13000000))
