          (set! (-> (the-as (pointer uint32) a1-10) 2) (the-as uint #x20000000))
          (set! (-> (the-as (pointer uint32) a1-10) 3) (the-as uint 0))
          (set! (-> v1-5 base) (&+ a1-10 16))
          )
        (let* ((v1-6 arg0)
               (a0-1 (-> v1-6 base))
