;;-*-Lisp-*-
(in-package goal)

;; definition of type tie-near-consts
(deftype tie-near-consts (structure)
  ((extra      qword     :inline)
   (gifbufs    qword     :inline)
   (clrbufs    qword     :inline)
   (adgif      qword     :inline)
   (strgif     qword     :inline)
   (fangif     qword     :inline)
   (hvdfoffs   vector    :inline)
   (invhscale  vector    :inline)
   (guard      vector    :inline)
   (atest      uint64    2)
   (atest-tra  gs-adcmd  :inline :overlay-at (-> atest 0))
   (atest-def  gs-adcmd  :inline)
   )
  )

;; definition for method 3 of type tie-near-consts
(defmethod inspect ((this tie-near-consts))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'tie-near-consts)
  (format #t "~1Textra: #<qword @ #x~X>~%" (-> this extra))
  (format #t "~1Tgifbufs: #<qword @ #x~X>~%" (-> this gifbufs))
  (format #t "~1Tclrbufs: #<qword @ #x~X>~%" (-> this clrbufs))
  (format #t "~1Tadgif: #<qword @ #x~X>~%" (-> this adgif))
  (format #t "~1Tstrgif: #<qword @ #x~X>~%" (-> this strgif))
  (format #t "~1Tfangif: #<qword @ #x~X>~%" (-> this fangif))
  (format #t "~1Thvdfoffs: #<vector @ #x~X>~%" (-> this hvdfoffs))
  (format #t "~1Tinvhscale: #<vector @ #x~X>~%" (-> this invhscale))
  (format #t "~1Tguard: #<vector @ #x~X>~%" (-> this guard))
  (format #t "~1Tatest[2] @ #x~X~%" (-> this atest))
  (format #t "~1Tatest-tra: #<gs-adcmd @ #x~X>~%" (-> this atest))
  (format #t "~1Tatest-def: #<gs-adcmd @ #x~X>~%" (-> this atest-def))
  (label cfg-4)
  this
  )

;; definition for symbol tie-near-vu1-block, type vu-function
(define tie-near-vu1-block (new 'static 'vu-function :length #x6fd :qlength #x37f))

;; definition for function tie-near-init-consts
;; INFO: Used lq/sq
;; WARN: Return type mismatch vector vs none.
(defun tie-near-init-consts ((arg0 tie-near-consts) (arg1 object) (arg2 gs-adcmd) (arg3 gs-adcmd))
  (set! (-> arg0 adgif dword 0) (make-u128 0 (the-as uint #x1000000000000005)))
  (set! (-> arg0 adgif dword 1) (the-as uint 14))
  (set! (-> arg0 atest-tra cmds) (gs-reg64 test-1))
  (set! (-> arg0 atest 0) (the-as uint arg2))
  (set! (-> arg0 atest-def cmds) (gs-reg64 test-1))
  (set! (-> arg0 atest-def data) (the-as uint arg3))
  (case *subdivide-scissor-draw-mode*
    (((subdivide-setting textured))
     (set! (-> arg0 strgif dword 0)
           (make-u128 0 (logior (shl #x30004000 32) (shr (shl (logior (shr (shl (the-as int arg1) 63) 57) 60) 53) 6)))
           )
     (set! (-> arg0 fangif dword 0)
           (make-u128 0 (logior (shl #x30004000 32) (shr (shl (logior (shr (shl (the-as int arg1) 63) 57) 61) 53) 6)))
           )
     )
    (((subdivide-setting outline))
     (set! (-> arg0 strgif dword 0)
           (make-u128 0 (logior (shl #x30004000 32) (shr (shl (logior (shr (shl (the-as int arg1) 63) 57) 58) 53) 6)))
           )
     (set! (-> arg0 fangif dword 0)
           (make-u128 0 (logior (shl #x30004000 32) (shr (shl (logior (shr (shl (the-as int arg1) 63) 57) 58) 53) 6)))
           )
     )
    (((subdivide-setting gouraud))
     (set! (-> arg0 strgif dword 0)
           (make-u128 0 (logior (shl #x30004000 32) (shr (shl (logior (shr (shl (the-as int arg1) 63) 57) 44) 53) 6)))
           )
     (set! (-> arg0 fangif dword 0)
           (make-u128 0 (logior (shl #x30004000 32) (shr (shl (logior (shr (shl (the-as int arg1) 63) 57) 45) 53) 6)))
           )
     )
    (((subdivide-setting hack))
     (set! (-> arg0 strgif dword 0) (make-u128 0 (shl #x301d4000 32)))
     (set! (-> arg0 fangif dword 0)
           (make-u128 0 (logior (shl #x30004000 32) (shr (shl (logior (shr (shl (the-as int arg1) 63) 57) 61) 53) 6)))
           )
     )
    )
  (set! (-> arg0 strgif dword 1) (the-as uint 1042))
  (set! (-> arg0 fangif dword 1) (the-as uint 1042))
  (let ((f0-0 8388894.0)
        (f1-0 8389078.0)
        (f2-0 8389262.0)
        )
    (set! (-> arg0 gifbufs vector4w x) (the-as int f2-0))
    (set! (-> arg0 gifbufs vector4w y) (the-as int f1-0))
    (set! (-> arg0 gifbufs vector4w z) (the-as int f2-0))
    (set! (-> arg0 gifbufs vector4w w) (the-as int f1-0))
    (set! (-> arg0 extra vector4w x) (the-as int (+ f0-0 f1-0 f2-0)))
    (set! (-> arg0 extra vector4w y) (the-as int 0.0))
    (set! (-> arg0 extra vector4w z) (the-as int (+ f0-0 f1-0 f2-0)))
    )
  (set! (-> arg0 clrbufs vector4w x) 198)
  (set! (-> arg0 clrbufs vector4w y) 242)
  (set! (-> arg0 clrbufs vector4w z) 198)
  (set! (-> arg0 clrbufs vector4w w) 242)
  (let ((v1-48 (view-get-active-math-camera)))
    (set! (-> arg0 invhscale quad) (-> v1-48 inv-hmge-scale quad))
    (set! (-> arg0 hvdfoffs quad) (-> v1-48 hvdf-off quad))
    (set! (-> arg0 guard quad) (-> v1-48 guard quad))
    )
  (none)
  )

;; definition for function tie-near-init-engine
;; WARN: Return type mismatch pointer vs none.
(defun tie-near-init-engine ((arg0 dma-buffer) (arg1 gs-test) (arg2 int) (arg3 int))
  (let ((v1-0 *display*)
        (a0-6 (+ (* (+ (/ (-> tie-near-vu1-block qlength) 127) 1) 16) 352))
        )
    (+! (-> v1-0 mem-reserve-size) a0-6)
    (when (not (-> v1-0 dma-buffer-overflow))
      (let ((a2-1 (-> v1-0 frames (-> v1-0 on-screen) global-buf)))
        (if (< (-> a2-1 real-buffer-end) (the-as int (&+ (-> a2-1 base) a0-6)))
            (set! (-> v1-0 dma-buffer-overflow) #t)
            )
        )
      (when (not (-> v1-0 dma-buffer-overflow))
        (dma-buffer-add-vu-function arg0 tie-near-vu1-block 1)
        (let ((s2-0 11))
          (let* ((v1-2 arg0)
                 (a0-11 (-> v1-2 base))
                 )
            (set! (-> (the-as (pointer int64) a0-11)) (logior #x10000000 (shr (shl s2-0 48) 48)))
            (set! (-> (the-as (pointer uint32) a0-11) 2) (the-as uint #x5000000))
            (set! (-> (the-as (pointer uint32) a0-11) 3) (the-as uint (logior #x6c0003c6 (shr (shl s2-0 56) 40))))
            (set! (-> v1-2 base) (&+ a0-11 16))
            )
          (tie-near-init-consts
            (the-as tie-near-consts (-> arg0 base))
            arg1
            (the-as gs-adcmd arg2)
            (the-as gs-adcmd arg3)
            )
          (&+! (-> arg0 base) (* s2-0 16))
          )
        (let* ((v1-5 arg0)
               (a0-15 (-> v1-5 base))
               )
          (set! (-> (the-as (pointer int64) a0-15)) #x10000000)
          (set! (-> (the-as (pointer uint32) a0-15) 2) (the-as uint #x15000008))
          (set! (-> (the-as (pointer uint32) a0-15) 3) (the-as uint #x13000000))
          (set! (-> v1-5 base) (&+ a0-15 16))
          )
        (let* ((v1-6 arg0)
               (a0-17 (-> v1-6 base))
               )
          (set! (-> (the-as (pointer int64) a0-17)) #x10000002)
          (set! (-> (the-as (pointer uint32) a0-17) 2) (the-as uint 0))
          (set! (-> (the-as (pointer uint32) a0-17) 3) (the-as uint #x30000000))
          (set! (-> v1-6 base) (&+ a0-17 16))
          )
        (let* ((v1-7 arg0)
               (a0-19 (-> v1-7 base))
               )
          (set! (-> (the-as (pointer int32) a0-19)) #x4b000000)
          (set! (-> (the-as (pointer uint32) a0-19) 1) (the-as uint #x4b000000))
          (set! (-> (the-as (pointer uint32) a0-19) 2) (the-as uint #x4b000000))
          (set! (-> (the-as (pointer uint32) a0-19) 3) (the-as uint #x4b000000))
          (set! (-> (the-as (pointer uint32) a0-19) 4) (the-as uint #x3000000))
          (set! (-> (the-as (pointer uint32) a0-19) 5) (the-as uint #x200002c))
          (set! (-> (the-as (pointer uint32) a0-19) 6) (the-as uint #x5000000))
          (set! (-> (the-as (pointer uint32) a0-19) 7) (the-as uint #x1000404))
          (set! (-> v1-7 base) (&+ a0-19 32))
          )
        (let* ((v1-8 *viewport-array*)
               (v1-9 (-> v1-8 data (-> v1-8 current-viewport-index)))
               )
          (let* ((a0-24 arg0)
                 (a1-31 (-> a0-24 base))
