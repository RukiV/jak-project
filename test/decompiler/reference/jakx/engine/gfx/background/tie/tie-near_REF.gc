            (set! (-> (the-as (pointer uint64) a1-33)) (make-u128 0 (the-as uint #x3000000000008001)))
            (set! (-> (the-as (pointer uint64) a1-33) 1) (the-as uint #xeeeeeeeeeeeeeeee))
            (set! (-> a0-25 base) (&+ a1-33 16))
            )
          (let ((a0-26 (-> arg0 base)))
