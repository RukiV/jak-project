            (set! (-> (the-as (pointer int64) a1-31)) #x10000004)
            (set! (-> (the-as (pointer uint32) a1-31) 2) (the-as uint 0))
            (set! (-> (the-as (pointer uint32) a1-31) 3) (the-as uint #x50000004))
            (set! (-> a0-24 base) (&+ a1-31 16))
            )
          (let* ((a0-25 arg0)
                 (a1-33 (-> a0-25 base))
