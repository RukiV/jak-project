;;-*-Lisp-*-
(in-package goal)

;; definition for method 3 of type gsf-vertex
(defmethod inspect ((this gsf-vertex))
  (format #t "[~8x] gsf-vertex~%" this)
  (format #t "  pos: ~f ~f ~f~%" (-> this pos x) (-> this pos y) (-> this pos z))
  (format #t "  tex: ~x ~x~%" (-> this tex x) (-> this tex y))
  (format #t "  nrm: ~f ~f ~f~%" (-> this nrm x) (-> this nrm y) (-> this nrm z))
  (format #t "  clr: ~x ~x ~x ~x~%" (-> this clr x) (-> this clr y) (-> this clr z) (-> this clr w))
  this
  )

