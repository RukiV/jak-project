;;-*-Lisp-*-
(in-package goal)

;; this file is debug only
(declare-file (debug))

;; definition for function diag-frag-print
;; INFO: Used lq/sq
;; WARN: Return type mismatch symbol vs none.
(defun diag-frag-print ((arg0 merc-ctrl) (arg1 int))
  (let* ((gp-0 (-> arg0 effect arg1))
         (s5-0 (the-as object (-> gp-0 frag-ctrl)))
         (s4-0 (the-as object (-> gp-0 frag-geo)))
         )
    (dotimes (s3-0 (the-as int (-> gp-0 frag-count)))
      (let ((s2-0 (asize-of (the-as merc-fragment-control s5-0))))
        (let ((s1-0 (asize-of (the-as merc-fragment s4-0))))
          (let ((s0-0 (the-as merc-fragment s4-0)))
            (format #t "~%~%FRAGMENT ~d~%" s3-0)
            (format
              #t
              "   srcdest-off ~3d   rgba-off ~3d   lump-off ~3d       fp-off ~3d~%"
              (-> s0-0 header srcdest-off)
              (-> s0-0 header rgba-off)
              (-> s0-0 header lump-off)
              (-> s0-0 header fp-off)
              )
            (format
              #t
              "      mat1-cnt ~3d   mat2-cnt ~3d   mat3-cnt ~3d samecopy-cnt ~3d~%"
              (-> s0-0 header mat1-cnt)
              (-> s0-0 header mat2-cnt)
              (-> s0-0 header mat3-cnt)
              (-> s0-0 header samecopy-cnt)
              )
            (format
              #t
              " crosscopy-cnt ~3d  strip-len ~3d  qw-fp-off ~3d      qw-size ~3d~%"
              (-> s0-0 header crosscopy-cnt)
              (-> s0-0 header strip-len)
              (-> s0-0 header mm-quadword-fp-off)
              (-> s0-0 header mm-quadword-size)
              )
            (format #t "      perc-off ~3d~%" (-> s0-0 header perc-off))
            (format #t " MATRICES: ")
            (when (nonzero? (-> (the-as merc-fragment s4-0) header mat-slot 0))
              (let ((sv-16 0))
                (while (nonzero? (-> (the-as merc-fragment s4-0) header mat-slot sv-16))
                  (format #t " ~d" (-> (the-as merc-fragment s4-0) header mat-slot sv-16))
                  (+! sv-16 1)
                  )
                )
              )
            (format #t " ~%")
            (let ((sv-32 (the-as merc-fragment s4-0))
                  (sv-48 (the-as (pointer uint8) s4-0))
                  (sv-64 (-> s0-0 header rgba-off))
                  (sv-80 (- (-> s0-0 header lump-off) (-> s0-0 header rgba-off)))
                  (sv-96 (/ (- (-> s0-0 header fp-off) (-> s0-0 header lump-off)) (the-as uint 3)))
                  )
              (format #t "HEADER:~%")
              (dotimes (v1-21 (the-as int sv-64))
                (set! sv-48 (&-> (the-as merc-fragment sv-48) header mat1-cnt))
                )
              (format #t "RGBAs:~%")
              (let ((sv-112 0))
                (while (< sv-112 (the-as int sv-80))
                  (when (!= s3-0 2)
                    (set! (-> (the-as merc-fragment sv-48) header srcdest-off) (the-as uint 0))
                    (set! (-> (the-as merc-fragment sv-48) header rgba-off) (the-as uint 0))
                    (set! (-> (the-as merc-fragment sv-48) header lump-off) (the-as uint 128))
                    (set! (-> (the-as merc-fragment sv-48) header fp-off) (the-as uint 128))
                    )
                  (when (= s3-0 2)
                    (set! (-> (the-as merc-fragment sv-48) header srcdest-off) (the-as uint 128))
                    (set! (-> (the-as merc-fragment sv-48) header rgba-off) (the-as uint 128))
                    (set! (-> (the-as merc-fragment sv-48) header lump-off) (the-as uint 0))
                    (set! (-> (the-as merc-fragment sv-48) header fp-off) (the-as uint 128))
                    )
                  (format
                    #t
                    " vtx ~2d:  ~02x ~02x ~02x ~02x~%"
                    sv-112
                    (-> (the-as merc-fragment sv-48) header srcdest-off)
                    (-> (the-as merc-fragment sv-48) header rgba-off)
                    (-> (the-as merc-fragment sv-48) header lump-off)
                    (-> (the-as merc-fragment sv-48) header fp-off)
                    )
                  (set! sv-48 (&-> (the-as merc-fragment sv-48) header mat1-cnt))
                  (+! sv-112 1)
                  )
                )
              (format #t "LUMPs:~%")
              (let ((s0-1 (the-as object (+ (the-as uint sv-32) (* (shr (+ (-> s0-0 header lump-off) 3) 2) 16))))
                    (sv-128 0)
                    )
                (while (< sv-128 (the-as int sv-96))
                  (format
                    #t
                    " vtx ~2d:  ~02x ~02x ~02x ~02x~%"
                    sv-128
                    (-> (the-as merc-fragment s0-1) header srcdest-off)
                    (-> (the-as merc-fragment s0-1) header rgba-off)
                    (-> (the-as merc-fragment s0-1) header lump-off)
                    (-> (the-as merc-fragment s0-1) header fp-off)
                    )
                  (format
                    #t
                    "       :  ~02x ~02x ~02x ~02x~%"
                    (-> (the-as merc-fragment s0-1) header mat1-cnt)
                    (-> (the-as merc-fragment s0-1) header mat2-cnt)
                    (-> (the-as merc-fragment s0-1) header mat3-cnt)
                    (-> (the-as merc-fragment s0-1) header samecopy-cnt)
                    )
                  (format
                    #t
                    "       :  ~02x ~02x ~02x ~02x~%"
                    (-> (the-as merc-fragment s0-1) header crosscopy-cnt)
                    (-> (the-as merc-fragment s0-1) header strip-len)
                    (-> (the-as merc-fragment s0-1) header mm-quadword-fp-off)
                    (-> (the-as merc-fragment s0-1) header mm-quadword-size)
                    )
                  (format
                    #t
                    "dests ~d and ~d~%"
                    (-> (the-as merc-fragment s0-1) header mat1-cnt)
                    (-> (the-as merc-fragment s0-1) header mat2-cnt)
                    )
                  (set! s0-1 (+ (the-as int s0-1) 12))
                  (+! sv-128 1)
                  )
                )
              )
            )
          (let ((s0-2 (the-as object (merc-fragment-fp-data (the-as merc-fragment s4-0)))))
            (format #t "FP AREA:~%")
            (let ((sv-144 0))
              (while (< sv-144 6)
                (format
                  #t
                  "   ~08x ~08x ~08x ~08x~%"
                  (-> (the-as merc-fp-header s0-2) x-add)
                  (-> (the-as merc-fp-header s0-2) y-add)
                  (-> (the-as merc-fp-header s0-2) z-add)
                  (-> (the-as (pointer uint32) s0-2) 3)
                  )
                (set! s0-2 (&+ (the-as merc-fp-header s0-2) 16))
                (+! sv-144 1)
                )
              )
            )
          (let ((a2-12 (logand (-> (the-as (pointer uint32) (merc-fragment-fp-data (the-as merc-fragment s4-0))) 11) 255)))
            (format #t "  THIS FRAGMENT HAS ~x VERTICES~%" a2-12)
            )
          (set! s4-0 (+ (the-as int s4-0) s1-0))
          )
        (set! s5-0 (+ (the-as int s5-0) s2-0))
        )
      )
    )
  (none)
  )

;; definition for function debug-merc-highres-runtime
;; INFO: Used lq/sq
;; WARN: Return type mismatch symbol vs none.
(defun debug-merc-highres-runtime ((arg0 merc-ctrl))
  (let ((s5-0 0))
    (dotimes (s4-0 (the-as int (-> arg0 header effect-count)))
      (let ((s3-0 (-> arg0 effect s4-0)))
        (when (logtest? (-> s3-0 effect-bits) (effect-bits emerc))
          (let ((s2-0 (the-as object (-> s3-0 frag-ctrl)))
                (s1-0 (the-as object (-> s3-0 frag-geo)))
                )
            (dotimes (s0-0 (the-as int (-> s3-0 frag-count)))
              (let ((sv-96 (asize-of (the-as merc-fragment-control s2-0))))
                (let ((sv-112 (asize-of (the-as merc-fragment s1-0))))
                  (when (nonzero? (-> (the-as merc-fragment s1-0) header mat-slot 0))
                    (let ((sv-128 0))
                      (while (nonzero? (-> (the-as merc-fragment s1-0) header mat-slot sv-128))
                        (when (< (the-as uint 111) (-> (the-as merc-fragment s1-0) header mat-slot sv-128))
                          (set! s5-0 1)
                          (format
                            *stdcon*
                            " effect ~d fragment ~d mat-slot ~d above 111 limit~%"
                            s4-0
                            s0-0
                            (-> (the-as merc-fragment s1-0) header mat-slot sv-128)
                            )
                          )
                        (+! sv-128 1)
                        )
                      )
                    )
                  (let ((t0-1 (+ (-> (the-as merc-fragment-control s2-0) unsigned-four-count)
                                 (-> (the-as merc-fragment-control s2-0) lump-four-count)
                                 (-> (the-as merc-fragment-control s2-0) fp-qwc)
                                 )
                              )
                        )
                    (when (< (the-as uint 229) t0-1)
                      (set! s5-0 1)
                      (format *stdcon* " effect ~d fragment ~d input size of ~d quads is greater than 229~%" s4-0 s0-0 t0-1)
                      )
                    )
                  (let ((sv-144 0))
                    (let ((v1-25 (-> (the-as merc-fragment s1-0) header strip-len)))
                      (when (nonzero? v1-25)
                        (set! sv-144 (+ (* (the-as uint 3) v1-25) 1 sv-144))
                        sv-144
                        )
                      )
                    (let* ((sv-160 (merc-fragment-fp-data (the-as merc-fragment s1-0)))
                           (sv-176 (&+ sv-160 16))
                           )
                      (when (!= (-> sv-160 shader-cnt) 1)
                        (set! s5-0 1)
                        (format *stdcon* " effect ~d fragment ~d shader count ~d is not one~%" s4-0 s0-0 (-> sv-160 shader-cnt))
                        )
                      (dotimes (v1-34 (the-as int (-> sv-160 shader-cnt)))
                        (let ((a1-3 (-> (the-as (pointer uint16) sv-176) 14)))
                          (set! sv-144 (+ (* (the-as uint 3) (logand a1-3 255)) 7 sv-144))
                          )
                        sv-144
                        (set! sv-176 (&+ (the-as adgif-shader sv-176) 80))
                        )
                      )
                    (when (< 209 sv-144)
                      (set! s5-0 1)
                      (format *stdcon* " effect ~d fragment ~d output size of ~d quads is greater than 209~%" s4-0 s0-0 sv-144)
                      )
                    (let ((v1-41 (+ (-> (the-as merc-fragment s1-0) header mat1-cnt)
                                    (-> (the-as merc-fragment s1-0) header mat2-cnt)
                                    (-> (the-as merc-fragment s1-0) header mat3-cnt)
                                    )
                                 )
                          (sv-192 (/ (+ sv-144 -7) 3))
                          (sv-208 (new 'stack-no-clear 'array 'uint8 176))
                          )
                      (let ((a0-40
                              (the-as
                                merc-vtx
                                (+ (the-as uint s1-0) (* (shr (+ (-> (the-as merc-fragment-control s2-0) unsigned-four-count) 3) 2) 16))
                                )
                              )
                            )
                        (dotimes (a1-8 sv-192)
                          (set! (-> sv-208 a1-8) (the-as uint 0))
                          )
                        (dotimes (a1-11 (the-as int v1-41))
                          (let ((a2-12 (/ (+ (-> (the-as merc-vtx (+ (* 12 a1-11) (the-as int a0-40))) dst-0) -7) (the-as uint 3)))
                                (a3-10 (/ (+ (-> (the-as merc-vtx (+ (* 12 a1-11) (the-as int a0-40))) dst-1) -7) (the-as uint 3)))
                                )
                            (set! (-> sv-208 a2-12) (the-as uint 1))
                            (set! (-> sv-208 a3-10) (the-as uint 1))
                            )
                          )
                        )
                      (let ((sv-224 0))
                        (while (< sv-224 sv-192)
                          (when (!= (-> sv-208 sv-224) 1)
                            (set! s5-0 1)
                            (format
                              *stdcon*
                              " effect ~d fragment ~d has a hole at address ~d (vertex slot ~d)~%"
                              s4-0
                              s0-0
                              (+ (* 3 sv-224) 7)
                              sv-224
                              )
                            )
                          (+! sv-224 1)
                          )
                        )
                      )
                    )
                  (set! s1-0 (+ (the-as int s1-0) sv-112))
                  )
                (set! s2-0 (+ (the-as int s2-0) sv-96))
                )
              )
            )
          )
        )
      )
    (when (nonzero? s5-0)
      (format *stdcon* " ...on merc object ~s~%" (-> arg0 name))
      (dotimes (s5-1 (the-as int (-> arg0 header effect-count)))
        (set! (-> (the-as (pointer uint32) #x70000000) 1) (the-as uint 0))
        (set! (-> (the-as (pointer uint32) #x70000000) 3) (the-as uint 0))
        (let ((v1-67 (-> arg0 effect s5-1)))
          (format *stdcon* "  Effect ~d: ~d fragments~%" s5-1 (-> v1-67 frag-count))
          )
        )
      )
    )
  (none)
  )

;; definition for function debug-merc-size-runtime
;; INFO: Used lq/sq
;; WARN: Return type mismatch symbol vs none.
(defun debug-merc-size-runtime ((arg0 merc-ctrl))
  (let ((s5-0 0))
