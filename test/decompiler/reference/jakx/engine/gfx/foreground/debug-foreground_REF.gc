                         (sv-96 0)
                         )
                    (while (< sv-96 (the-as int (-> sv-64 shader-cnt)))
                      (let ((v1-23 (-> (the-as (pointer uint16) sv-80) 14)))
                        (format *stdcon* " strip length: ~d tris, new shader~%" (logand v1-23 255))
                        )
                      (set! sv-80 (&+ (the-as adgif-shader sv-80) 80))
                      (+! sv-96 1)
                      )
                    )
                  )
                )
              (set! s1-0 (+ (the-as int s1-0) sv-32))
              )
            (set! s2-0 (+ (the-as int s2-0) sv-16))
            )
