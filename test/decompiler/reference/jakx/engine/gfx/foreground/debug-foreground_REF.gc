      (let* ((s3-0 (-> arg0 effect s4-0))
             (s2-0 (the-as object (-> s3-0 frag-ctrl)))
             (s1-0 (the-as object (-> s3-0 frag-geo)))
             )
        (dotimes (s0-0 (the-as int (-> s3-0 frag-count)))
          (let ((sv-16 (asize-of (the-as merc-fragment-control s2-0))))
            (let ((sv-32 (asize-of (the-as merc-fragment s1-0))))
              (let ((t0-0 (+ (-> (the-as merc-fragment-control s2-0) unsigned-four-count)
                             (-> (the-as merc-fragment-control s2-0) lump-four-count)
                             (-> (the-as merc-fragment-control s2-0) fp-qwc)
                             )
                          )
                    )
                (when (< (the-as uint 231) t0-0)
                  (set! s5-0 1)
                  (format *stdcon* " effect ~d fragment ~d input size of ~d quads is greater than 231~%" s4-0 s0-0 t0-0)
                  )
                )
              (let ((sv-48 0))
                (let ((v1-9 (-> (the-as merc-fragment s1-0) header strip-len)))
                  (when (nonzero? v1-9)
                    (set! sv-48 (+ (* (the-as uint 3) v1-9) 1 sv-48))
                    sv-48
                    )
                  )
                (let* ((v0-3 (merc-fragment-fp-data (the-as merc-fragment s1-0)))
                       (v1-13 (the-as object (&+ v0-3 16)))
                       )
                  (dotimes (a0-11 (the-as int (-> v0-3 shader-cnt)))
                    (let ((a2-1 (-> (the-as (pointer uint16) v1-13) 14)))
                      (set! sv-48 (+ (* (the-as uint 3) (logand a2-1 255)) 7 sv-48))
                      )
                    sv-48
                    (set! v1-13 (&+ (the-as adgif-shader v1-13) 80))
                    )
                  )
                (when (< 211 sv-48)
                  (set! s5-0 1)
                  (format *stdcon* " effect ~d fragment ~d output size of ~d quads is greater than 211~%" s4-0 s0-0 sv-48)
                  (let ((a2-5 (-> (the-as merc-fragment s1-0) header strip-len)))
                    (if (nonzero? a2-5)
                        (format *stdcon* " strip length: ~d tris, continued shader~%" a2-5)
                        )
                    )
                  (let* ((sv-64 (merc-fragment-fp-data (the-as merc-fragment s1-0)))
