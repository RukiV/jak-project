  )

;; definition for function debug-merc-fade-runtime
;; INFO: Used lq/sq
;; WARN: Return type mismatch symbol vs none.
(defun debug-merc-fade-runtime ((arg0 merc-ctrl))
  (dotimes (s5-0 (the-as int (-> arg0 header effect-count)))
    (let* ((s4-0 (-> arg0 effect s5-0))
           (s3-0 (the-as object (-> s4-0 frag-ctrl)))
           (s2-0 (the-as object (-> s4-0 frag-geo)))
           )
      (dotimes (s1-0 (the-as int (-> s4-0 frag-count)))
        (let ((s0-0 ((method-of-type merc-fragment-control asize-of) (the-as merc-fragment-control s3-0))))
          (let ((sv-16 ((method-of-type merc-fragment asize-of) (the-as merc-fragment s2-0))))
            (let* ((sv-32 (merc-fragment-fp-data (the-as merc-fragment s2-0)))
                   (sv-48 (the-as adgif-shader (&+ sv-32 16)))
                   (sv-64 0)
                   )
              (while (< sv-64 (the-as int (-> sv-32 shader-cnt)))
                (when (!= (-> sv-48 reg-4) (gs-reg alpha-1))
                  (let ((t0-0 (+ (logand (shr (-> sv-48 quad 1 byte 0) 2) 7) 1)))
                    (format *stdcon* " TOO MANY MIPS: ~s effect ~d -- ~d levels ~%" (-> arg0 name) s5-0 t0-0)
                    )
                  )
                (&+! sv-48 80)
                (+! sv-64 1)
                )
              )
            (set! s2-0 (+ (the-as int s2-0) sv-16))
            )
          (set! s3-0 (+ (the-as int s3-0) s0-0))
          )
        )
      )
    )
  (none)
  )

