(defun fx-copy-init ((arg0 dma-buffer) (arg1 viewport))
  (dma-buffer-add-gs-set arg0
                         (frame-1 (-> arg1 copy-frame))
                         (zbuf-1 (-> arg1 zbuf-off))
                         (tex0-1 (-> arg1 tex0-24))
                         (test-1 (new 'static 'gs-test :ate #x1 :atst (gs-atest always) :zte #x1 :ztst (gs-ztest always)))
                         (alpha-1 (new 'static 'gs-alpha))
                         (prim (new 'static 'gs-prim :prim (gs-prim-type sprite) :tme #x1 :abe #x1 :fst #x1))
                         (rgbaq (new 'static 'gs-rgbaq :r #x80 :g #x80 :b #x80 :a #x80 :q 1.0))
                         (tex1-1 (new 'static 'gs-tex1))
                         (miptbp1-1 (new 'static 'gs-miptbp))
                         (clamp-1 (-> arg1 clamp))
                         (texflush 0)
                         )
  (let ((v1-3 (-> arg0 base)))
    (let* ((a2-6 arg0)
           (a3-22 (-> a2-6 base))
           )
      (set! (-> (the-as (pointer int64) a3-22)) #x10000000)
      (set! (-> (the-as (pointer uint32) a3-22) 2) (the-as uint 0))
      (set! (-> (the-as (pointer uint32) a3-22) 3) (the-as uint #x50000000))
      (set! (-> a2-6 base) (&+ a3-22 16))
      )
    (let* ((t0-2 (-> arg1 screen-sx))
           (a2-7 (-> arg1 screen-sy))
           (a3-24 (-> arg1 screen-maxy))
           (t0-3 (/ t0-2 32))
           )
      (let* ((t1-0 arg0)
             (t2-0 (-> t1-0 base))
             )
        (set! (-> (the-as (pointer uint64) t2-0)) (logior (the-as uint #x4400000000008000) (shr (shl t0-3 49) 49)))
        (set! (-> (the-as (pointer uint64) t2-0) 1) (the-as uint #x5353))
        (set! (-> t1-0 base) (&+ t2-0 16))
        )
      (let ((t1-1 0))
        (dotimes (t2-2 t0-3)
          (let* ((t3-3 arg0)
                 (t4-2 (-> t3-3 base))
                 )
            (set! (-> (the-as (pointer int64) t4-2)) (shr (shl (* t1-1 16) 48) 48))
            (set! (-> (the-as (pointer uint64) t4-2) 1)
                  (the-as uint (logior #x73000000 (shr (shl (* (+ t1-1 1792) 16) 48) 48)))
                  )
            (set! (-> (the-as (pointer uint64) t4-2) 2)
                  (the-as uint (logior (shr (shl (* a2-7 16) 48) 32) (shr (shl (* (+ t1-1 32) 16) 48) 48)))
                  )
            (set! (-> (the-as (pointer uint64) t4-2) 3)
                  (the-as uint (logior (shr (shl (* (+ t1-1 1824) 16) 48) 48) (shr (shl (* a3-24 16) 48) 32)))
                  )
            (set! (-> t3-3 base) (&+ t4-2 32))
            )
          (+! t1-1 32)
          )
        )
      )
    (let ((a3-28 (/ (the-as int (+ (- -16 (the-as int v1-3)) (the-as int (-> arg0 base)))) 16)))
      (cond
        ((nonzero? a3-28)
         (logior! (-> (the-as (pointer uint64) v1-3)) (shr (shl a3-28 48) 48))
         (logior! (-> (the-as (pointer uint64) v1-3) 1) (shl (shr (shl a3-28 48) 48) 32))
         )
        (else
          (set! (-> arg0 base) v1-3)
          )
        )
      )
    )
  (dma-buffer-add-gs-set arg0
                         (frame-1 (-> arg1 frame))
                         (test-1 (new 'static 'gs-test :ate #x1 :atst (gs-atest equal) :zte #x1 :ztst (gs-ztest always)))
                         (rgbaq (new 'static 'gs-rgbaq :r #xc0 :g #xc0 :b #xc0 :a #x80 :q 1.0))
                         (texflush 0)
                         )
  0
  (none)
  )

;; definition for function warp-shader-init
;; WARN: Return type mismatch int vs none.
(defun warp-shader-init ((arg0 viewport))
  (let ((v1-0 (-> arg0 warp-shader)))
    (set! (-> v1-0 reg-0) (gs-reg tex0-1))
    (set! (-> v1-0 tex0) (the-as gs-tex0 (-> arg0 copy-tex0)))
    (set! (-> v1-0 reg-1) (gs-reg tex1-1))
    (set! (-> v1-0 tex1) (new 'static 'gs-tex1 :mmag #x1))
    (set! (-> v1-0 reg-2) (gs-reg miptbp1-1))
    (set! (-> v1-0 miptbp1) (new 'static 'gs-miptbp))
    (set! (-> v1-0 clamp) (the-as gs-clamp (-> arg0 clamp)))
    (set! (-> v1-0 reg-4) (gs-reg alpha-1))
    (set! (-> v1-0 alpha) (new 'static 'gs-miptbp))
    )
  0
  (none)
  )

;; definition for function fx-copy-buf
;; WARN: Return type mismatch int vs none.
(defun fx-copy-buf ((arg0 dma-buffer) (arg1 viewport))
  (let* ((v1-0 arg0)
         (a3-0 (-> arg1 copy-dma))
         (a0-1 (the-as object (-> v1-0 base)))
         )
    (set! (-> (the-as dma-packet a0-1) dma)
          (new 'static 'dma-tag :id (dma-tag-id call) :addr (the-as int (-> a3-0 data)))
          )
    (set! (-> (the-as dma-packet a0-1) vif0) (new 'static 'vif-tag))
    (set! (-> (the-as dma-packet a0-1) vif1) (new 'static 'vif-tag :cmd (vif-cmd flusha) :msk #x1))
    (set! (-> v1-0 base) (&+ (the-as pointer a0-1) 16))
    )
  (set-dirty-mask!
    (-> *level* level-default)
    5
    (* (* (-> arg1 screen-sy) (-> arg1 screen-sx)) 4)
    (the-as int (shl (shr (shl (-> arg1 copy-frame) 55) 55) 13))
    )
  0
  (none)
  )

