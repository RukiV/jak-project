;;-*-Lisp-*-
(in-package goal)

;; definition of type water-anim
(deftype water-anim (process-drawable)
  ((water-height         meters)
   (wade-height          meters)
   (swim-height          meters)
   (bottom-height        meters)
   (attack-event         symbol)
   (attack-id            uint32)
   (flow                 flow-control)
   (target               uint64)
   (flags                water-flag)
   (look                 int32)
   (play-ambient-sound?  symbol)
   (visible              symbol)
   )
  (:methods
    (water-anim-method-50 () none)
    )
  (:state-methods
    idle
    )
  (:methods
    (water-anim-method-52 (_type_ vector) none)
    (water-anim-method-53 (_type_ vector) float)
    (water-anim-method-54 (_type_) object)
    (water-anim-method-55 (_type_) none)
    (water-anim-method-56 (_type_) symbol)
    (water-anim-method-57 (_type_) symbol)
    (water-anim-method-58 (_type_) none)
    )
  )

;; definition for method 3 of type water-anim
(defmethod inspect ((this water-anim))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type process-drawable inspect)))
    (t9-0 this)
    )
  (format #t "~2Twater-height: (meters ~m)~%" (-> this water-height))
  (format #t "~2Twade-height: (meters ~m)~%" (-> this wade-height))
  (format #t "~2Tswim-height: (meters ~m)~%" (-> this swim-height))
  (format #t "~2Tbottom-height: (meters ~m)~%" (-> this bottom-height))
  (format #t "~2Tattack-event: ~A~%" (-> this attack-event))
  (format #t "~2Tattack-id: ~D~%" (-> this attack-id))
  (format #t "~2Tflow: ~A~%" (-> this flow))
  (format #t "~2Ttarget: ~D~%" (-> this target))
  (format #t "~2Tflags: #x~X~%" (-> this flags))
  (format #t "~2Tlook: ~D~%" (-> this look))
  (format #t "~2Tplay-ambient-sound?: ~A~%" (-> this play-ambient-sound?))
  (format #t "~2Tvisible: ~A~%" (-> this visible))
  (label cfg-4)
  this
  )

;; definition for method 7 of type water-anim
(defmethod relocate ((this water-anim) (offset int))
  (if (nonzero? (-> this flow))
      (&+! (-> this flow) offset)
      )
  (call-parent-method this offset)
  )

;; definition of type water-anim-look
(deftype water-anim-look (structure)
  ((skel-group          string)
   (anim                int32)
   (ambient-sound-spec  sound-spec)
   )
  )

;; definition for method 3 of type water-anim-look
(defmethod inspect ((this water-anim-look))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'water-anim-look)
  (format #t "~1Tskel-group: ~A~%" (-> this skel-group))
  (format #t "~1Tanim: ~D~%" (-> this anim))
  (format #t "~1Tambient-sound-spec: #<sound-spec @ #x~X>~%" (-> this ambient-sound-spec))
  (label cfg-4)
  this
  )

;; definition for symbol *water-anim-look*, type (array water-anim-look)
(define *water-anim-look* (new 'static 'boxed-array :type water-anim-look))

;; definition for function water-anim-event-handler
;; ERROR: function was not converted to expressions. Cannot decompile.

;; failed to figure out what this is:
(defstate idle (water-anim)
  :virtual #t
  :event water-anim-event-handler
  :trans (behavior ()
    (let ((a0-0 (-> self flow)))
      (if (and (nonzero? a0-0) *display-vol-marks*)
          (flow-control-method-9 a0-0)
          )
      )
    (cond
      ((not (-> self visible))
       )
      ((< (-> (math-camera-pos) y) (+ -8192.0 (-> self root trans y)))
       (logior! (-> self draw status) (draw-control-status no-draw))
       )
      (else
        (logclear! (-> self draw status) (draw-control-status no-draw))
        )
      )
    (if (and (-> self visible) (and (-> self play-ambient-sound?) (nonzero? (-> self sound))))
        (update! (-> self sound))
        )
    )
  :code (behavior ()
    (until #f
      (ja-post)
      (logior! (-> self mask) (process-mask sleep-code))
      (suspend)
      )
    #f
    )
  )

;; definition for method 52 of type water-anim
;; INFO: Used lq/sq
;; WARN: Return type mismatch int vs none.
(defmethod water-anim-method-52 ((this water-anim) (arg0 vector))
  (set! (-> this root trans quad) (-> arg0 quad))
  (set! (-> this water-height) (-> this root trans y))
  (if (nonzero? (-> this sound))
      (update-trans! (-> this sound) (-> this root trans))
      )
  (none)
  )

;; definition for method 53 of type water-anim
(defmethod water-anim-method-53 ((this water-anim) (arg0 vector))
  (ripple-find-height this 0 arg0)
  )

;; definition for method 57 of type water-anim
(defmethod water-anim-method-57 ((this water-anim))
  #f
  )

;; definition for method 58 of type water-anim
;; INFO: Used lq/sq
;; WARN: Return type mismatch quaternion vs none.
(defmethod water-anim-method-58 ((this water-anim))
  (set! (-> this play-ambient-sound?) #t)
  (set! (-> this visible) #t)
  (set! (-> this look)
        (res-lump-value (-> this entity) 'look int :default (the-as uint128 -1) :time -1000000000.0)
        )
  (let* ((sv-16 0)
         (v1-4 (res-lump-data (-> this entity) 'trans-offset pointer :tag-ptr (the-as (pointer res-tag) (& sv-16))))
         )
    (when v1-4
      (+! (-> this root trans x) (-> (the-as (pointer float) v1-4)))
      (+! (-> this root trans y) (-> (the-as (pointer float) v1-4) 1))
      (+! (-> this root trans z) (-> (the-as (pointer float) v1-4) 2))
      )
    )
  (let ((f0-6 (res-lump-float (-> this entity) 'rotoffset)))
    (if (!= f0-6 0.0)
        (quaternion-rotate-y! (the-as quaternion (-> this root rot)) (the-as quaternion (-> this root rot)) f0-6)
        )
    )
  (none)
  )

;; definition for method 54 of type water-anim
;; WARN: Return type mismatch none vs object.
(defmethod water-anim-method-54 ((this water-anim))
  (rlet ((vf0 :class vf)
         (vf4 :class vf)
         (vf5 :class vf)
         (vf6 :class vf)
         )
    (init-vf0-vector)
    (let ((s5-0 (-> this look)))
      (if (or (< s5-0 0) (>= s5-0 (-> *water-anim-look* length)))
          (go process-drawable-art-error "skel group")
          )
      (let ((s5-1 (-> *water-anim-look* s5-0)))
        (initialize-skeleton-by-name this (-> s5-1 skel-group))
        (ja-channel-set! 1)
        (let ((s4-0 (-> this skel root-channel 0)))
          (joint-control-channel-group-eval!
            s4-0
            (the-as art-joint-anim (-> this draw art-group data (-> s5-1 anim)))
            num-func-identity
            )
          (set! (-> s4-0 frame-num) 0.0)
          )
        (let ((a2-1 (-> s5-1 ambient-sound-spec)))
          (when a2-1
            (let ((a3-0 (new 'stack-no-clear 'vector)))
              (let ((v1-17 a3-0))
                (let ((a0-8 (-> this root trans))
                      (a1-5 (-> this draw bounds))
                      )
                  (.lvf vf4 (&-> a0-8 quad))
                  (.lvf vf5 (&-> a1-5 quad))
                  )
                (.mov.vf.w vf6 vf0)
                (.add.vf.xyz vf6 vf4 vf5)
                (.svf (&-> v1-17 quad) vf6)
                )
              (set! (-> this sound) (new 'process 'ambient-sound (the-as basic a2-1) a3-0 0.0))
              )
            )
          )
        )
      )
    (ja-post)
    )
  )

;; definition for method 55 of type water-anim
;; WARN: Return type mismatch trsqv vs none.
(defmethod water-anim-method-55 ((this water-anim))
  (set! (-> this root) (new 'process 'trsqv))
  (none)
  )

;; definition for method 56 of type water-anim
;; INFO: Used lq/sq
;; WARN: Return type mismatch flow-control vs symbol.
(defmethod water-anim-method-56 ((this water-anim))
  (local-vars (r0-0 uint128) (a0-11 uint128) (a0-17 uint128))
  (set! (-> this attack-event) (the-as symbol ((method-of-type res-lump get-property-struct)
                                               (-> this entity)
                                               'attack-event
                                               'interp
                                               -1000000000.0
                                               (the-as structure 'drown)
                                               (the-as (pointer res-tag) #f)
                                               *res-static-buf*
                                               )
                                       )
        )
  (process-drawable-from-entity! this (-> this entity))
  (logclear! (-> this mask) (process-mask actor-pause))
  (set! (-> this vol) (new 'process 'vol-control this))
  (logior! (-> this vol flags) (vol-flags display? vol-flags-1))
  (set! (-> this bottom-height) 32768.0)
  (let* ((v1-8 *game-info*)
         (a0-7 (+ (-> v1-8 attack-id) 1))
         )
    (set! (-> v1-8 attack-id) a0-7)
    (set! (-> this attack-id) a0-7)
    )
  (set! (-> this target) (the-as uint #f))
  (let* ((sv-16 0)
         (v1-10 ((method-of-type res-lump get-property-data)
                 (-> this entity)
                 'water-height
                 'exact
                 -1000000000.0
                 (the-as pointer #f)
                 (the-as (pointer res-tag) (& sv-16))
                 *res-static-buf*
                 )
                )
         )
    (when v1-10
      (set! (-> this water-height) (-> (the-as (pointer float) v1-10)))
      (set! (-> this wade-height) (-> (the-as (pointer float) v1-10) 1))
      (set! (-> this swim-height) (-> (the-as (pointer float) v1-10) 2))
      (let ((a0-10 (the-as uint128 sv-16)))
        (.pcpyud a0-11 a0-10 r0-0)
        )
      (if (>= (the-as uint (shr (* (the-as int a0-11) 2) 49)) (the-as uint 4))
          (set! (-> this flags) (the-as water-flag (the int (-> (the-as (pointer float) v1-10) 3))))
          )
      (let ((a0-16 (the-as uint128 sv-16)))
        (.pcpyud a0-17 a0-16 r0-0)
        )
      (if (>= (the-as uint (shr (* (the-as int a0-17) 2) 49)) (the-as uint 5))
          (set! (-> this bottom-height) (-> (the-as (pointer float) v1-10) 4))
          )
      )
    )
  (logior! (-> this flags) (water-flag under-water))
  (the-as symbol (when (logtest? (-> this flags) (water-flag no-grab-sound))
                   (let ((v0-4 (new 'process 'flow-control this (the-as res-lump #f))))
                     (set! (-> this flow) v0-4)
                     v0-4
                     )
                   )
          )
  )

;; definition for function water-anim-init-by-other
(defbehavior water-anim-init-by-other water-anim ((arg0 entity-actor))
  (process-entity-set! self arg0)
  (water-anim-method-57 self)
  (water-anim-method-55 self)
  (water-anim-method-56 self)
  (water-anim-method-58 self)
  (water-anim-method-54 self)
  (go-virtual idle)
  )

;; definition for method 11 of type water-anim
(defmethod init-from-entity! ((this water-anim) (arg0 entity-actor))
  (water-anim-method-57 this)
  (water-anim-method-55 this)
  (water-anim-method-56 this)
  (water-anim-method-58 this)
  (water-anim-method-54 this)
  (go (method-of-object this idle))
  )




