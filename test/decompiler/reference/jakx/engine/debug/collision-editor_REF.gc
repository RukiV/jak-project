                                         )
                                        (else
                                          s4-0
                                          )
                                        )
                )
        )
      (let ((s4-1 0))
        (if (cpad-pressed? 0 x)
            (+! s4-1 1)
            )
        (if (cpad-pressed? 0 triangle)
            (+! s4-1 -1)
