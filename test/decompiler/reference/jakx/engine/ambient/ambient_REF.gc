          (the-as (function gui-connection symbol) #f)
          (the-as process #f)
          )
        )
    (if (nonzero? (-> self message-id))
        (gui-control-method-16
          *gui-control*
          4
          (the-as uint (-> self message-id))
          0
          0
          (the-as string #f)
          (the-as (function gui-connection symbol) #f)
          (the-as process #f)
          )
        )
    (setting-control-method-16 *setting-control* self 'music-volume)
    (setting-control-method-16 *setting-control* self 'sfx-volume)
    (setting-control-method-16 *setting-control* self 'dialog-volume)
    (setting-control-method-16 *setting-control* self 'hint)
    (setting-control-method-16 *setting-control* self 'speech-control)
    (setting-control-method-16 *setting-control* self 'camera-name)
    (setting-control-method-23 *setting-control*)
    )
  :code (behavior ()
    (local-vars (v1-40 symbol))
    (let ((gp-0 #t))
      (while (or (and (nonzero? (-> self voice-id))
                      (let ((v1-31 (gui-control-method-17 *gui-control* (the-as uint (-> self voice-id)))))
                        (or (= v1-31 2) (= v1-31 3))
                        )
                      (begin
                        (dotimes (s5-2 4)
                          (when (and (string-charp= (-> self message name) (-> *sound-iop-info* stream-name s5-2 name))
                                     (= (-> self voice-id) (-> *sound-iop-info* stream-id s5-2))
                                     (logtest? (-> *sound-iop-info* stream-status s5-2) (stream-status ss6))
                                     )
                            (set! v1-40 #f)
                            (goto cfg-39)
                            )
                          )
                        (set! v1-40 #t)
                        (label cfg-39)
                        (and v1-40 (< (- (-> *display* real-clock frame-counter) (-> self state-time)) (seconds 120)))
                        )
                      )
                 (and (nonzero? (-> self message-id))
                      (= (gui-control-method-17 *gui-control* (the-as uint (-> self message-id))) 3)
                      (or (< (- (-> *display* real-clock frame-counter) (-> self state-time))
                             (the-as time-frame (-> self message text-duration))
                             )
                          (and (logtest? (-> self message flags) (talker-flags only-play-in-region))
                               (-> self region)
                               (point-in-region-debug! (-> self region) (target-pos 0))
                               )
                          )
                      )
                 (< (- (-> *display* real-clock frame-counter) (-> self state-time)) (seconds 0.05))
                 )
        (when (and (nonzero? (-> self voice-id))
                   (not gp-0)
                   (zero? (gui-control-method-17 *gui-control* (the-as uint (-> self voice-id))))
                   )
          (setting-control-method-16 *setting-control* self 'music-volume)
          (setting-control-method-16 *setting-control* self 'sfx-volume)
          (setting-control-method-16 *setting-control* self 'dialog-volume)
          (set! gp-0 #t)
          )
        (when (and (nonzero? (-> self message-id))
                   (= (gui-control-method-17 *gui-control* (the-as uint (-> self message-id))) 3)
                   (not (paused?))
                   )
          (if (logtest? (-> self message flags) (talker-flags fade-in))
              (seek! (-> self interp) 1.0 (* 0.5 (seconds-per-frame)))
              (seek! (-> self interp) 1.0 (* 4.0 (seconds-per-frame)))
              )
          (draw-text self)
          )
        (suspend)
        )
      )
    (when (and (nonzero? (-> self message-id)) (logtest? (-> self message flags) (talker-flags fade-in slide-in)))
      (while (!= (-> self interp) 0.0)
        (if (logtest? (-> self message flags) (talker-flags fade-in))
            (seek! (-> self interp) 0.0 (* 0.5 (seconds-per-frame)))
            (seek! (-> self interp) 0.0 (* 4.0 (seconds-per-frame)))
            )
        (if (and (= (gui-control-method-17 *gui-control* (the-as uint (-> self message-id))) 3) (not (paused?)))
            (draw-text self)
            )
        (suspend)
        )
      )
    (when (and (logtest? (-> self message flags) (talker-flags auto-save-once-on-exit)) (not (-> self save?)))
      (let ((gp-1 (-> *display* real-clock frame-counter)))
        (until (>= (- (-> *display* real-clock frame-counter) gp-1) (seconds 1))
          (suspend)
          )
        )
      (set! (-> self save?) #t)
      (auto-save-user)
      )
    (go-virtual exit)
    )
  )

