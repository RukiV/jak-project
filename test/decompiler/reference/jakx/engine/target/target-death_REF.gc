;;-*-Lisp-*-
(in-package goal)

;; definition for symbol *auto-continue*, type symbol
(define *auto-continue* #f)

;; definition for function next-continue
;; WARN: Return type mismatch object vs continue-point.
(defun next-continue ((arg0 continue-point))
  (let* ((v1-0 #f)
         (a1-0 (the-as object *level-load-list*))
         (a2-0 (-> (the-as pair a1-0) car))
         )
    (while (not (null? a1-0))
      (let* ((a2-2 (the-as object (-> (the-as level-load-info (-> (the-as symbol a2-0) value)) continues)))
             (a3-0 (-> (the-as pair a2-2) car))
             )
        (while (not (null? a2-2))
          (if (and v1-0 (logtest? (continue-flags test) (-> (the-as continue-point a3-0) flags)))
              (return (the-as continue-point a3-0))
              )
          (if (= a3-0 arg0)
              (set! v1-0 #t)
              )
          (set! a2-2 (-> (the-as pair a2-2) cdr))
          (set! a3-0 (-> (the-as pair a2-2) car))
          )
        )
      (set! a1-0 (-> (the-as pair a1-0) cdr))
      (set! a2-0 (-> (the-as pair a1-0) car))
      )
    )
  (the-as continue-point #f)
  )

;; definition for function arrive-at-continue
;; WARN: Return type mismatch int vs none.
(defbehavior arrive-at-continue target ((arg0 continue-point))
  (cond
    ((logtest? (-> arg0 flags) (continue-flags title))
     enter-state
     #t
     (go target-title)
     )
    ((logtest? (-> arg0 flags) (continue-flags title-movie))
     enter-state
     (go target-title-start)
     )
    ((logtest? (-> arg0 flags) (continue-flags intro))
     (go target-intro)
     )
    ((logtest? (-> arg0 flags) (continue-flags hero-mode))
     (go target-introb)
     )
    ((logtest? (continue-flags credits) (-> arg0 flags))
     )
    ((and (logtest? (continue-flags race) (-> arg0 flags)) (!= (-> arg0 vehicle-type) 19))
     (set! (-> self mode-cache) 'pilot)
     (set! (-> self mode-param1) (the-as uint #f))
     (set! (-> self mode-param2) (-> self game current-vehicle))
     (set! (-> self mode-param3) (the-as uint (-> arg0 velocity)))
     )
    (else
      (suspend-for (seconds 0.05)
        )
      )
    )
  0
  (none)
  )

;; definition for function target-continue-init-art
;; WARN: Return type mismatch int vs none.
(defbehavior target-continue-init-art target ()
  0
  (none)
  )

;; failed to figure out what this is:
(defstate target-continue (target)
  :event L65
  :enter (behavior ((arg0 continue-point))
    '()
    )
  :exit (behavior ()
    (local-vars (a3-0 none) (t0-0 none))
    (set! (-> *level* curr-camera-pos 0 quad) (-> (camera-pos) quad))
    (set! (-> *level* prev-camera-pos 0 quad) (-> *level* curr-camera-pos 0 quad))
    (set! (-> *level* curr-target-pos 0 quad) (-> self root trans quad))
    (set! (-> *level* prev-target-pos 0 quad) (-> *level* curr-target-pos 0 quad))
    (set! (-> *setting-control* user-default border-mode) (-> *level* play?))
    (set! (-> *setting-control* user-default unknown-usd-15) (the-as basic #t))
    (setting-control-method-17 *setting-control* 'title-control 'render a3-0 t0-0)
    (let ((v1-15 (-> self root root-prim)))
      (set! (-> v1-15 prim-core collide-as) (-> self root backup-collide-as))
      (set! (-> v1-15 prim-core collide-with) (-> self root backup-collide-with))
      )
    (setting-control-method-16 *setting-control* self 'allow-pause)
    (setting-control-method-16 *setting-control* self 'allow-progress)
    (setting-control-method-16 *setting-control* self 'allow-timeout)
    (setting-control-method-16 *setting-control* self 'bg-a)
    (setting-control-method-16 *setting-control* self 'music-volume)
    (setting-control-method-16 *setting-control* self 'sfx-volume)
    (setting-control-method-16 *setting-control* self 'dialog-volume)
    (setting-control-method-16 *setting-control* self 'ambient-volume)
    (setting-control-method-16 *setting-control* self 'music)
    (setting-control-method-16 *setting-control* self 'region-mode)
    (setting-control-method-16 *setting-control* self 'border-mode)
    (setting-control-method-16 *setting-control* self 'allow-continue)
    (setting-control-method-16 *setting-control* self 'level-trans-time)
    (setting-control-method-16 *setting-control* self 'speech-control)
    (setting-control-method-23 *setting-control*)
    (logclear! (-> self focus-status) (focus-status teleporting))
    (set! (-> self mode-cache) #f)
    (set! (-> self teleport-time) (the-as uint (current-time)))
    (set! (-> self game kiosk-timeout) (the-as uint (-> *display* game-clock frame-counter)))
    0
    )
  :trans (behavior ()
    '()
    )
  :code L1
  :post target-no-move-post
  )
