;;-*-Lisp-*-
(in-package goal)

;; definition for function target-pilot-post
;; INFO: Used lq/sq
;; WARN: Return type mismatch int vs none.
(defbehavior target-pilot-post target ()
  (let* ((v1-0 (-> self vehicle))
         (vehicle-proc
           (the-as
             process-drawable
             (and (nonzero? (l32-false-check v1-0)) (let ((a0-2 (-> v1-0 process 0)))
                                                      (the-as process-drawable (if (= (-> v1-0 pid) (-> a0-2 pid))
                                                                                   (the-as process-drawable a0-2)
                                                                                   )
                                                              )
                                                      )
                  )
             )
           )
         )
    (when (the-as process vehicle-proc)
      (set! (-> self root trans quad) (-> vehicle-proc root trans quad))
      (set! (-> self root transv quad) (-> vehicle-proc root transv quad))
      (quaternion-copy! (the-as quaternion (-> self root rot)) (the-as quaternion (-> vehicle-proc root rot)))
      )
    )
  0
  (none)
  )




