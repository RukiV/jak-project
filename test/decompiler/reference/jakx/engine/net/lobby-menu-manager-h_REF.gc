;; definition for method 3 of type lobby-menu-manager
(defmethod inspect ((this lobby-menu-manager))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type process inspect)))
    (t9-0 this)
    )
  (format #t "~2Tgame-type: ~D~%" (-> this game-type))
  (format #t "~2Tmenu-handles[8] @ #x~X~%" (-> this menu-handles))
  (format #t "~2Tin-focus-index: ~D~%" (-> this in-focus-index))
  (format #t "~2Tmenu-handle-1: ~D~%" (-> this menu-handle-1))
  (format #t "~2Tmenu-handle-2: ~D~%" (-> this menu-handle-2))
  (format #t "~2Tmenu-handle-popup: ~D~%" (-> this menu-handle-popup))
  (format #t "~2Tmenu-handle-background: ~D~%" (-> this menu-handle-background))
  (format #t "~2Tmenu-handle-logo-main: ~D~%" (-> this menu-handle-logo-main))
  (format #t "~2Tmenu-handle-logo-subtitle: ~D~%" (-> this menu-handle-logo-subtitle))
  (format #t "~2Tlocal-players: ~D~%" (-> this local-players))
  (format #t "~2Trefresh-time: ~D~%" (-> this refresh-time))
  (format #t "~2Tgame-connection-type: ~D~%" (-> this game-connection-type))
  (format #t "~2Tvehicle-handle: ~D~%" (-> this vehicle-handle))
  (format #t "~2Tvehicle-selected: ~D~%" (-> this vehicle-selected))
  (format #t "~2Tvehicle-flags: ~D~%" (-> this vehicle-flags))
  (format #t "~2Tvehicle-paint-mode: ~D~%" (-> this vehicle-paint-mode))
  (format #t "~2Ttuning-type-selected: ~D~%" (-> this tuning-type-selected))
  (format #t "~2Tall-ready?: ~A~%" (-> this all-ready?))
  (format #t "~2Tmap-proc: ~D~%" (-> this map-proc))
  (format #t "~2Tvenue-map: ~D~%" (-> this venue-map))
  (format #t "~2Tcurrent-local-player: ~D~%" (-> this current-local-player))
  (format #t "~2Tspawn-another?: ~A~%" (-> this spawn-another?))
  (format #t "~2Tstate-time: ~D~%" (-> this state-time))
  (format #t "~2Thas-driver?[2] @ #x~X~%" (-> this has-driver?))
  (format #t "~2Tcar-part-type-selected: ~D~%" (-> this car-part-type-selected))
  (format #t "~2Tcam-string: ~A~%" (-> this cam-string))
  (format #t "~2Tdriver-was-taken?: ~A~%" (-> this driver-was-taken?))
  (format #t "~2Tinterpolate-camera?: ~A~%" (-> this interpolate-camera?))
  (format #t "~2Tlast-selected-human-count: ~D~%" (-> this last-selected-human-count))
  (format #t "~2Tlast-selected-cpu-count: ~D~%" (-> this last-selected-cpu-count))
  (format #t "~2Tgame-visible?: ~A~%" (-> this game-visible?))
  (format #t "~2Tpsp-mode-run?: ~A~%" (-> this psp-mode-run?))
  (format #t "~2Tgarage-lights: ~f~%" (-> this garage-lights))
  (format #t "~2Tgarage-lights-target: ~f~%" (-> this garage-lights-target))
  (format #t "~2Tmemcard-status: ~D~%" (-> this memcard-status))
  (format #t "~2Ttime-limit?: ~A~%" (-> this time-limit?))
  (format #t "~2Tprofile-save-mode: ~A~%" (-> this profile-save-mode))
  (format #t "~2Tmachine-id-to-kick: ~D~%" (-> this machine-id-to-kick))
  (format #t "~2Tcookie-id-to-kick: ~D~%" (-> this cookie-id-to-kick))
  (format #t "~2Toverride-fov: ~A~%" (-> this override-fov))
  (format #t "~2Tprofile-new-save: ~A~%" (-> this profile-new-save))
  (format #t "~2Tvoice-id: ~D~%" (-> this voice-id))
  (format #t "~2Tsplit-selection-prev-state: ~A~%" (-> this split-selection-prev-state))
  (format #t "~2Tvehicle-part-fade: ~D~%" (-> this vehicle-part-fade))
  (format #t "~2Tvehicle-loaded-time: ~D~%" (-> this vehicle-loaded-time))
  (label cfg-4)
  this
  )

;; definition for symbol *lobby-reset-mode*, type symbol
(define *lobby-reset-mode* #f)

;; definition for symbol *net-mgr-finish-mode*, type object
(define *net-mgr-finish-mode* (the-as object #f))

;; definition for symbol *lobby-menu-manager*, type basic
(define *lobby-menu-manager* (the-as basic #f))

;; definition for function get-selected-local-player-count
(defun get-selected-local-player-count ()
  (if (and *lobby-menu-manager* (= (-> (the-as lobby-menu-manager *lobby-menu-manager*) local-players) 2))
      2
      1
      )
  )

;; definition for function kiosk-code?
(defun kiosk-code? ()
  (if (and (cpad-hold? 0 left) (cpad-hold? 0 l1) (cpad-hold? 0 l2) (cpad-hold? 0 r1) (cpad-hold? 0 r2))
      #f
      (kiosk?)
      )
  )

;; definition for function min-max-wrap-around
(defun min-max-wrap-around ((arg0 int) (arg1 int) (arg2 int))
  (let ((v1-2 (+ (- 1 arg1) arg2)))
    (while (< arg0 arg1)
      (+! arg0 v1-2)
      )
    (while (< arg2 arg0)
      (set! arg0 (- arg0 v1-2))
      )
    )
  arg0
  )

