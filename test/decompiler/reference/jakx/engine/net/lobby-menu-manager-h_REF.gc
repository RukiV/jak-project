(in-package goal)

;; definition (debug) for function lobby-vehicle-flag->string
;; WARN: Return type mismatch object vs string.
(defun-debug lobby-vehicle-flag->string ((arg0 int32))
  (if (= (logand (the-as int arg0) 2) 2)
      (format #t "destroy ")
      )
  (if (= (logand (the-as int arg0) 1) 1)
      (format #t "reload ")
      )
  (if (= (logand (the-as int arg0) 8) 8)
      (format #t "load-when-offscreen ")
      )
  (if (= (logand (the-as int arg0) 16) 16)
      (format #t "no-turntable ")
      )
  (if (= (logand (the-as int arg0) 32) 32)
      (format #t "no-vehicle-selection ")
      )
  (if (= (logand (the-as int arg0) 64) 64)
      (format #t "fade-part ")
      )
  (the-as string (if (= (logand (the-as int arg0) 4) 4)
                     (format #t "spawn-when-ready ")
                     )
          )
  )

