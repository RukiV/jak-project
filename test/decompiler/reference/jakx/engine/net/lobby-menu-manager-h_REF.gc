;; definition for function kbd-auto-activate
(defun kbd-auto-activate ()
  (if (get-keyboard-control)
      (return #f)
      )
  (let ((v1-2 (keybd-read-ascii)))
    (when (and (< 31 (the-as int v1-2)) (< (the-as int v1-2) 128))
      (set! *keybd-ungetc* (the-as int v1-2))
      (return #t)
      )
    )
  #f
  )

;; definition for symbol *return-to-secrets*, type object
(define *return-to-secrets* (the-as object #f))

;; definition for symbol *this-create-menu-state-name*, type symbol
(define *this-create-menu-state-name* #f)

;; definition for symbol *prev-create-menu-state-name*, type object
(define *prev-create-menu-state-name* (the-as object #f))

;; definition for symbol *lobby-fast-connect*, type object
(define *lobby-fast-connect* (the-as object #f))

;; definition for symbol *lobby-body-parts-return-state-name*, type object
(define *lobby-body-parts-return-state-name* (the-as object #f))

;; definition for symbol *eligible-for-body-part-award*, type symbol
(define *eligible-for-body-part-award* #f)

;; definition for symbol *pending-op*, type object
(define *pending-op* (the-as object #f))

;; definition for symbol *pending-op-serial*, type int
(define *pending-op-serial* 0)

;; definition for symbol *pending-op-arg-ct*, type int
(define *pending-op-arg-ct* 0)

;; definition for symbol *pending-op-args*, type (pointer int32)
(define *pending-op-args* (new 'static 'array int32 8 0 0 0 0 0 0 0 0))

;; definition for function teams-valid-to-start-game?
(defun teams-valid-to-start-game? ()
  (let ((s5-0 0)
        (gp-0 0)
        )
    (cond
      ((logtest? (-> *net-world* net-state options advanced-options flags) 32)
       (dotimes (s4-0 24)
         (when (net-world-method-64 *net-world* s4-0)
           (format #t "valid player: ~D~%" s4-0)
           (if (zero? (-> *net-world* net-state players s4-0 team-id))
               (+! s5-0 1)
               (+! gp-0 1)
               )
           )
         )
       )
      (else
        (return #t)
        )
      )
    (if (or (zero? s5-0) (zero? gp-0))
        (return #f)
        (return #t)
        )
    )
  (the-as symbol 0)
  )
