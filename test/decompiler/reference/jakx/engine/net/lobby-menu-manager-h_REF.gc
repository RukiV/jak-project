;; definition for symbol camera-seek-time, type float
(define camera-seek-time 0.5)

;; definition for symbol real-camera-seek-time, type float
(define real-camera-seek-time (/ 1.0 camera-seek-time))

;; definition for function set-lobby-camera-seek-time!
(defun set-lobby-camera-seek-time! ((arg0 float))
  (if (= arg0 0.0)
      (set! camera-seek-time 0.0001)
      (set! camera-seek-time arg0)
      )
  (set! real-camera-seek-time (/ 1.0 camera-seek-time))
  )

;; definition for symbol *class-mode*, type int
(define *class-mode* 1)

;; definition for function restore-selection-index
;; WARN: Return type mismatch symbol vs object.
(defun restore-selection-index ()
  (let ((a0-1 (lobby-menu-manager-method-185 *lobby-menu-manager* 'manager)))
    (when a0-1
      (dotimes (v1-1 3)
        (let ((a1-4 (mod (+ (- -1 v1-1) *selection-cache-index*) 3)))
          (if (< a1-4 0)
              (+! a1-4 3)
              )
          (when (= (-> *selection-cache-array* a1-4 state) (-> (the-as lobby-menu-manager *lobby-menu-manager*) state name))
            (selection-menu-manager-method-65 a0-1 (-> *selection-cache-array* a1-4 selection-type))
            (return (the-as object #t))
            )
          )
        )
      #f
      )
    )
  )

;; definition for symbol *lobby-timetrial-lock-mode*, type object
(define *lobby-timetrial-lock-mode* (the-as object #f))

;; definition for symbol *vehicle-class-data*, type object
(define *vehicle-class-data*
  (the-as object (new 'static 'boxed-array :type menu-option-info
                   (new 'static 'menu-option-info :display-name-id #xd4f :sym 'rookie)
                   (new 'static 'menu-option-info :display-name-id #xd50 :sym 'pro :extra 1)
                   (new 'static 'menu-option-info :display-name-id #xd51 :sym 'custom :extra 2)
                   )
                 )
  )

