;; definition of type col-rend-filter
(deftype col-rend-filter (structure)
  ((show-pat       uint32)
   (show-pat-mask  uint32)
   )
  )

;; definition for method 3 of type col-rend-filter
(defmethod inspect ((this col-rend-filter))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'col-rend-filter)
  (format #t "~1Tshow-pat: ~D~%" (-> this show-pat))
  (format #t "~1Tshow-pat-mask: ~D~%" (-> this show-pat-mask))
  (label cfg-4)
  this
  )

