  (cond
    ((= (if *net-mgr*
            (-> *net-mgr* game-state local-machine-idx)
            0
            )
        (-> *net-mgr* game-state session-master-idx)
        )
     (set! (-> *lobby-generic-error-text-ids* 0) 1606)
     (set! (-> *lobby-generic-error-bottom-text-ids* 0) 1712)
     (set! (-> *lobby-generic-error-bottom-text-ids2* 0) 1926)
     (set! (-> *lobby-generic-error-bottom-text-ids3* 0) 4273)
     (set! (-> *lobby-generic-error-bottom-text-ids4* 0) 1712)
     (set! (-> *lobby-generic-error-bottom-text-ids5* 0) 1712)
