(defun adventure-map-fade-in ((arg0 object))
  (local-vars (gp-0 level))
  (with-pp
    (let ((v1-1 (level-get *level* 'menumap)))
      (cond
        ((and v1-1 (= (-> v1-1 display?) 'display))
         (copy-string<-string (-> (the-as lobby-menu-manager pp) cam-string) "camera-59")
         )
        (else
          (screen-filter-method-10
            *screen-filter*
            (new 'static 'vector)
            (new 'static 'vector :data (new 'static 'array float 4 0.0 0.0 0.0 128.0))
            (* 2.0 (seconds-per-frame))
            (bucket-id bucket793)
            #x3fffff
            #x33001
            (the-as symbol 0)
            )
          (until (= (-> *screen-filter* color w) 128.0)
            (suspend)
            )
          (suspend)
          (kill-by-type fmv-player *active-pool*)
          (suspend)
          (suspend)
          (dma-release 'fmv-player)
          (lobby-level-set! 0 'menu2 'special)
          (lobby-level-set! 1 'menumap 'display)
          (until gp-0
            (set! gp-0 (level-get *level* 'menumap))
            (suspend)
            )
          (until (= (-> gp-0 display?) 'display)
            (suspend)
            )
          (copy-string<-string (-> (the-as lobby-menu-manager pp) cam-string) "camera-59")
          (set-lobby-camera-seek-time! 0.001)
          (suspend)
          (set-lobby-camera-seek-time! 0.5)
          (screen-filter-method-10
            *screen-filter*
            (new 'static 'vector :data (new 'static 'array float 4 0.0 0.0 0.0 128.0))
            (new 'static 'vector)
            (* 2.0 (seconds-per-frame))
            (bucket-id bucket793)
            #x3fffff
            #x33001
            (the-as symbol 0)
            )
          (while (-> *screen-filter* draw?)
            (suspend)
            )
          (the-as string #f)
          )
        )
      )
    )
  )

