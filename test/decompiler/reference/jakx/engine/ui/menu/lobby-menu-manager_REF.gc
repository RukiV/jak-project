                (suspend)
                (suspend)
                (goto cfg-17)
                )
              )
            (suspend)
            0
            )
          #f
          (label cfg-17)
          (lobby-level-set! 0 'menu2 'display)
          (if (not arg0)
              (lobby-level-set! 1 #f #f)
              )
          (until gp-1
            (set! gp-1 (level-get *level* 'menu2))
            (suspend)
            )
          (until (= (-> gp-1 display?) 'display)
            (suspend)
            )
          (if (= (-> pp state name) 'game-type-menu)
              (copy-string<-string (-> (the-as lobby-menu-manager pp) cam-string) "camera-6")
              (copy-string<-string (-> (the-as lobby-menu-manager pp) cam-string) "camera-68")
              )
          (if (!= (-> pp prev-state name) 'adventure-vehicle-select)
              (set-lobby-camera-seek-time! 0.001)
              )
          (suspend)
          (set-lobby-camera-seek-time! 0.5)
          (screen-filter-method-10
            *screen-filter*
            (new 'static 'vector :data (new 'static 'array float 4 0.0 0.0 0.0 128.0))
            (new 'static 'vector)
            (* 2.0 (seconds-per-frame))
            (bucket-id bucket793)
            #x3fffff
            #x33001
            (the-as symbol 0)
            )
          (while (-> *screen-filter* draw?)
            (suspend)
            )
          (the-as float #f)
          )
        )
      )
    )
  )

