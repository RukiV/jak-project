invalid vector subscript

;; definition for function lobby-default-post
;; WARN: Return type mismatch int vs symbol.
(defbehavior lobby-default-post lobby-menu-manager ()
  (pulse-new-font-color)
  (update-camera)
  (seek! (-> self garage-lights) (-> self garage-lights-target) 0.06)
  (set-garage-switched! (-> self garage-lights))
  (when (and *lobby-menu-manager* (= self *lobby-menu-manager*))
    (when (nonzero? (-> self voice-id))
      (case (gui-control-method-17 *gui-control* (-> self voice-id))
        ((2 1 3)
         )
        (else
          (set! (-> self voice-id) (the-as uint 0))
          (setting-control-method-16 *setting-control* self 'music-volume)
          )
        )
      )
    )
  (lobby-menu-manager-method-179 self)
  (the-as symbol 0)
  )

