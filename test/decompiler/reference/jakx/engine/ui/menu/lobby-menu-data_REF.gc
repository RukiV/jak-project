;;-*-Lisp-*-
(in-package goal)

;; definition for symbol *background-menu-info*, type base-menu-info
(define *background-menu-info* (new 'static 'base-menu-info
                                 :menu-type 'base-menu
                                 :children (new 'static 'boxed-array :type structure (new 'static 'structure))
                                 :name-symbol #f
                                 :3d-menu-type #f
                                 :trans-info #f
                                 :joint-index -1
                                 :joint-index-2 -1
                                 :box-index -1
                                 :joints #f
                                 :width -1
                                 :height -1
                                 :scale-y 1.0
                                 :scale-x 1.0
                                 )
        )

;; definition for symbol *logo-menu-info*, type base-menu-info
(define *logo-menu-info*
  (new 'static 'base-menu-info
    :menu-type 'jakx-logo-menu
    :children #f
    :name-symbol #f
    :3d-menu-type "skel-jakxlogo"
    :trans-info (new 'static 'animation-info
      :enter-anim 3
      :exit-anim -1
      :running-anim -1
      :anim-speed 2.5
      :enter-delay #x96
      :3d-offset (new 'static 'vector :data (new 'static 'array float 4 4096.0 4096.0 59392.0 1.0))
      )
    :joint-index -1
    :joint-index-2 -1
    :box-index -1
    :joints (new 'static 'boxed-array :type int8 0)
    :width -1
    :height -1
    :scale-y 1.0
    :scale-x 1.0
    )
  )

