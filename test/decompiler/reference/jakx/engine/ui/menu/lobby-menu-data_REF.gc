;; definition for function get-net-driver-idx-by-type
(defun get-net-driver-idx-by-type ((arg0 int))
  (dotimes (v1-0 (-> *net-drivers* length))
    (if (= (-> *net-drivers* v1-0 dt) arg0)
        (return v1-0)
        )
    )
  (the-as int #f)
  )

;; definition for function get-net-driver-by-type
(defun get-net-driver-by-type ((arg0 int))
  (let ((v1-0 (get-net-driver-idx-by-type arg0)))
    (if v1-0
        (-> *net-drivers* v1-0)
        (the-as net-driver #f)
        )
    )
  )

;; definition for function get-driver-flavor-text
(defun get-driver-flavor-text ((arg0 int32))
  (let ((v1-0 arg0))
    (cond
      ((zero? v1-0)
       3294
       )
      ((= v1-0 11)
       3295
       )
      ((= v1-0 1)
       3297
       )
      ((= v1-0 2)
       3298
       )
      ((= v1-0 3)
