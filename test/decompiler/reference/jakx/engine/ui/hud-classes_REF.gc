;; definition for function hud-map-init-by-other
(defbehavior hud-map-init-by-other hud-map ((arg0 float) (arg1 float))
  (set! (-> self x) arg0)
  (set! (-> self y) arg1)
  (hud-init-by-other)
  )

;; definition for method 24 of type hud-map
;; WARN: Return type mismatch int vs none.
(defmethod hud-method-24 ((this hud-map))
  (minimap-method-15 *minimap*)
  (set-hud-piece-position!
    (-> this sprites 1)
    (the int (+ 482.0 (-> this x)))
    (the int (+ -150.0 (the float (-> *viewport-array* default screen-sy)) (-> this y)))
    )
  (set-as-offset-from! (-> this sprites 0) (-> this sprites 1 pos) 11 -11)
  (set! (-> this sprites 0 color w) (the int (+ 70.0 (* 70.0 (sin 0.0)))))
  (set! (-> *minimap* color y) (the int (- 96.0 (* 32.0 (sin 0.0)))))
  (set! (-> *minimap* color z) (the int (- 96.0 (* 32.0 (sin 0.0)))))
  (set! (-> this sprites 0 scale-x) 1.0)
  (set! (-> this sprites 0 scale-y) 1.0)
  (let ((s5-0 (-> *setting-control* user-current race-minimap)))
    (cond
      ((>= s5-0 0)
       (set! (-> this sprites 1 scale-x) 0.0)
       (set! (-> this sprites 1 scale-y) 0.0)
       )
      (else
        (set! (-> this sprites 1 scale-x) 0.85)
        (set! (-> this sprites 1 scale-y) 0.85)
        )
      )
    (let ((t9-6 (method-of-type hud hud-method-24)))
      (t9-6 this)
      )
    (cond
      ((zero? s5-0)
       )
      (else
        (let ((s5-1 (-> *race-map-info-array* s5-0)))
          (minimap-method-13 *minimap* (lookup-texture-by-id-fast (the-as texture-id (-> s5-1 tex-id))) (-> s5-1 scale))
          (minimap-method-14 *minimap* (-> s5-1 corner) (-> s5-1 tex-offset))
          (with-dma-buffer-add-bucket ((s3-1 (-> *display* frames (-> *display* on-screen) global-buf))
                                       (bucket-id bucket787)
                                       )
            (set-as-offset-from! (-> this sprites 2) (-> this sprites 1 pos) -350 -260)
            (set! (-> *minimap* color x) 94)
            (set! (-> *minimap* color y) 94)
            (set! (-> *minimap* color z) 94)
            (minimap-method-10 *minimap* s3-1 (-> this sprites 2) (-> s5-1 mode))
            )
          )
        )
      )
    )
  0
  (none)
  )

;; definition for method 26 of type hud-map
;; WARN: Return type mismatch int vs none.
(defmethod hud-method-26 ((this hud-map))
  (set! (-> this gui-id)
        (the-as sound-id (gui-control-method-9 *gui-control* this 82 8 (-> this name) 81920.0 0))
        )
  (set! (-> this sprites 0 tex) (lookup-texture-by-id-fast (new 'static 'texture-id)))
  (set! (-> this sprites 0 scale-x) 0.0)
  (set! (-> this sprites 0 scale-y) 0.0)
  (set! (-> this sprites 0 flags) (hud-sprite-flags hsf2))
  (set! (-> this sprites 0 pos z) #xffff00)
  (set! (-> this sprites 1 tex) (lookup-texture-by-id-fast (new 'static 'texture-id)))
  (set! (-> this sprites 1 scale-x) 0.85)
  (set! (-> this sprites 1 scale-y) 0.85)
  (set! (-> this sprites 1 flags) (hud-sprite-flags))
  (set! (-> this sprites 1 pos z) #xffff00)
  0
  (none)
  )

;; definition for function hack-set-level-bbox
;; WARN: Return type mismatch int vs none.
(defun hack-set-level-bbox ((arg0 float) (arg1 float) (arg2 float) (arg3 float) (arg4 float) (arg5 float))
  (set! (-> *level-bounding-box* bmin x) (+ -2048000.0 arg0))
  (set! (-> *level-bounding-box* bmin y) (+ -1024000.0 arg1))
  (set! (-> *level-bounding-box* bmin z) (+ -2048000.0 arg2))
  (set! (-> *level-bounding-box* bsz x) (+ 2048000.0 arg3))
  (set! (-> *level-bounding-box* bsz y) (+ 1024000.0 arg4))
  (set! (-> *level-bounding-box* bsz z) (+ 2048000.0 arg5))
  (vector-! (-> *level-bounding-box* bsz) (-> *level-bounding-box* bsz) (-> *level-bounding-box* bmin))
  0
  (none)
  )

;; definition for function init-level-bbox-from-map
;; WARN: Return type mismatch int vs none.
(defun init-level-bbox-from-map ((arg0 float))
  (let ((s5-0 (-> *task-level* (-> *game-info* play-list (-> (get-open-task-node-info) task) task-level))))
    (format 0 "bbox level ~A~%" s5-0)
    (cond
      ((= s5-0 'spatour)
       (hack-set-level-bbox -29282590.0 42862.6 -14423998.0 3357520.5 542508.94 11910710.0)
       )
      ((= s5-0 'icetour)
       (hack-set-level-bbox -6990465.0 2933503.8 -29079192.0 15302185.0 4964745.0 6582388.0)
       )
      ((= s5-0 'havtour)
       (hack-set-level-bbox -6073125.0 -1136669.5 -18300814.0 14121971.0 826878.94 11341165.0)
       )
      ((= s5-0 'kratour)
       (hack-set-level-bbox -8657027.0 7808.265 -31850280.0 9505397.0 658033.7 -900221.25)
       )
      (else
        (let* ((a0-9 (-> *setting-control* user-current race-minimap))
               (s4-0 (-> *race-map-info-array* a0-9))
               (s5-1 (lookup-texture-by-id-fast (the-as texture-id (-> s4-0 tex-id))))
               )
          (when s5-1
            (mem-clear! (the-as pointer *level-bounding-box*) 32)
            (set! (-> *level-bounding-box* bmin x) (-> s4-0 corner x))
            (set! (-> *level-bounding-box* bmin z) (-> s4-0 corner y))
            (set! (-> *level-bounding-box* bsz x) (* (-> s4-0 scale) (the float (-> s5-1 w))))
            (set! (-> *level-bounding-box* bsz z) (* (-> s4-0 scale) (the float (-> s5-1 h))))
            (set! (-> *level-bounding-box* bmin y) (+ -2048000.0 arg0))
            (set! (-> *level-bounding-box* bsz y) 4096000.0)
            )
          )
        )
      )
    )
  0
  (none)
  )




