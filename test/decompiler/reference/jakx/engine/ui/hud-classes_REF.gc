;;-*-Lisp-*-
(in-package goal)

;; definition of type race-map-info
(deftype race-map-info (structure)
  ((corner      vector2)
   (tex-offset  vector2)
   (tex-id      uint32)
   (scale       float)
   (mode        int32)
   (pad         uint8  12)
   )
  )

;; definition for method 3 of type race-map-info
(defmethod inspect ((this race-map-info))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'race-map-info)
  (format #t "~1Tcorner: #<vector2 @ #x~X>~%" (-> this corner))
  (format #t "~1Ttex-offset: #<vector2 @ #x~X>~%" (-> this tex-offset))
  (format #t "~1Ttex-id: ~D~%" (-> this tex-id))
  (format #t "~1Tscale: ~f~%" (-> this scale))
  (format #t "~1Tmode: ~D~%" (-> this mode))
  (label cfg-4)
  this
  )

