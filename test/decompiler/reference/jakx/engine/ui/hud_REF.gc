;; definition for method 9 of type hud-corners
;; WARN: Return type mismatch int vs none.
(defmethod hud-corners-method-9 ((this hud-corners) (arg0 vector4w) (arg1 float) (arg2 hud-sprite-flags) (arg3 float) (arg4 float))
  (cond
    ((= arg1 0.0)
     (let ((v1-2 (the int (* 16.0 (-> *video-params* relative-x-scale) arg3)))
           (a0-2 (the int (* 16.0 arg4)))
           (a2-1 (-> this data))
           (a1-1 (&-> this data 6))
           )
       (cond
         ((logtest? arg2 (hud-sprite-flags hsf2))
          (set! (-> a2-1 0) (- (* (+ (-> arg0 x) 1792) 16) v1-2))
          (set! (-> a2-1 1) (* (+ (-> arg0 y) 1840) 16))
          )
         ((logtest? arg2 (hud-sprite-flags hsf3))
          (set! (-> a2-1 0) (- (* (+ (-> arg0 x) 1792) 16) (/ v1-2 2)))
          (set! (-> a2-1 1) (- (* (+ (-> arg0 y) 1840) 16) (/ a0-2 2)))
          )
         (else
           (set! (-> a2-1 0) (* (+ (-> arg0 x) 1792) 16))
           (set! (-> a2-1 1) (* (+ (-> arg0 y) 1840) 16))
           )
         )
       (set! (-> a1-1 0) (+ (-> a2-1 0) v1-2))
       (set! (-> a1-1 1) (+ (-> a2-1 1) a0-2))
       )
     )
    (else
      (let* ((f30-0 (sin arg1))
             (f0-8 (cos arg1))
             (a0-5 (the int (* 16.0 (-> *video-params* relative-x-scale) arg3 f0-8)))
             (v1-9 (the int (* -16.0 arg3 f30-0)))
             (a1-4 (the int (* 16.0 (-> *video-params* relative-x-scale) arg4 f30-0)))
             (a2-3 (the int (* 16.0 arg4 f0-8)))
             )
        (-> this data)
        (&-> this data 2)
        (&-> this data 4)
        (&-> this data 6)
        (cond
          ((logtest? arg2 (hud-sprite-flags hsf2))
           (set! (-> this data 2) (* (+ (-> arg0 x) 1792) 16))
           (set! (-> this data 3) (* (+ (-> arg0 y) 1840) 16))
           (set! (-> this data 0) (- (-> this data 2) a0-5))
           (set! (-> this data 1) (- (-> this data 3) v1-9))
           (set! (-> this data 4) (+ (- (-> this data 2) a0-5) a1-4))
           (set! (-> this data 5) (+ (- (-> this data 3) v1-9) a2-3))
           (set! (-> this data 6) (+ (-> this data 2) a1-4))
           (set! (-> this data 7) (+ (-> this data 3) a2-3))
           )
          ((logtest? arg2 (hud-sprite-flags hsf3))
           (set! (-> this data 0) (- (* (+ (-> arg0 x) 1792) 16) (/ (+ a0-5 a1-4) 2)))
           (set! (-> this data 1) (- (* (+ (-> arg0 y) 1840) 16) (/ (+ v1-9 a2-3) 2)))
           (set! (-> this data 2) (+ (-> this data 0) a0-5))
           (set! (-> this data 3) (+ (-> this data 1) v1-9))
           (set! (-> this data 4) (+ (-> this data 0) a1-4))
           (set! (-> this data 5) (+ (-> this data 1) a2-3))
           (set! (-> this data 6) (+ (-> this data 0) a0-5 a1-4))
           (set! (-> this data 7) (+ (-> this data 1) v1-9 a2-3))
           )
          (else
            (set! (-> this data 0) (* (+ (-> arg0 x) 1792) 16))
            (set! (-> this data 1) (* (+ (-> arg0 y) 1840) 16))
            (set! (-> this data 2) (+ (-> this data 0) a0-5))
            (set! (-> this data 3) (+ (-> this data 1) v1-9))
            (set! (-> this data 4) (+ (-> this data 0) a1-4))
            (set! (-> this data 5) (+ (-> this data 1) a2-3))
            (set! (-> this data 6) (+ (-> this data 0) a0-5 a1-4))
            (set! (-> this data 7) (+ (-> this data 1) v1-9 a2-3))
            )
          )
        )
      )
