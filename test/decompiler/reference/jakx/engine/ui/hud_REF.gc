;; definition for method 9 of type hud-sprite
;; INFO: Used lq/sq
;; WARN: Return type mismatch int vs none.
(defmethod hud-sprite-method-9 ((this hud-sprite) (arg0 dma-buffer) (arg1 level))
  (local-vars (v1-28 uint128))
  (let ((sv-48 *hud-sprite-work*)
        (sv-52 (-> this tex))
        (sv-56 (new 'stack 'hud-corners))
        (sv-60 (-> this flags))
        (sv-64 (if (nonzero? (-> this pos z))
                   (-> this pos z)
                   #xffffff
                   )
               )
        )
    (cond
      ((logtest? sv-60 (hud-sprite-flags hsf6))
       (dma-buffer-add-gs-set arg0 (test-1 (new 'static 'gs-test
                                             :ate #x1
                                             :atst (gs-atest greater-equal)
                                             :aref #x10
                                             :afail #x1
                                             :zte #x1
                                             :ztst (gs-ztest greater-equal)
                                             )
                                           )
                              )
       )
      ((logtest? sv-60 (hud-sprite-flags hsf10))
       (dma-buffer-add-gs-set arg0
                              (test-1 (new 'static 'gs-test :ate #x1 :afail #x3 :zte #x1 :ztst (gs-ztest greater-equal)))
                              )
       )
      (else
        (dma-buffer-add-gs-set arg0 (test-1 (new 'static 'gs-test :zte #x1 :ztst (gs-ztest greater-equal))))
        )
      )
    (cond
      (sv-52
        (hud-corners-method-9
          sv-56
          (-> this pos)
          (-> this angle)
          sv-60
          (* (the float (-> sv-52 w)) (-> this scale-x))
          (* (the float (-> sv-52 h)) (-> this scale-y))
          )
        (when arg1
          (let ((v1-27 (-> arg1 texture-mask 8 mask quad))
                (a0-22 (-> sv-52 masks data 0 mask quad))
                )
            (.por v1-28 v1-27 a0-22)
            )
          (set! (-> arg1 texture-mask 8 mask quad) v1-28)
          )
        (let ((s4-1 (-> arg0 base)))
          (set! (-> (the-as (pointer uint128) s4-1) 0) (-> sv-48 adgif-tmpl dma-vif quad))
          (set! (-> (the-as (pointer uint128) s4-1) 1) (-> sv-48 adgif-tmpl quad 1))
          (adgif-shader<-texture-simple! (the-as adgif-shader (&+ s4-1 32)) sv-52)
          (cond
            ((logtest? sv-60 (hud-sprite-flags hsf4))
             (set! (-> (the-as (pointer uint64) (&+ s4-1 32)) 8) (the-as uint 72))
             )
            ((logtest? sv-60 (hud-sprite-flags hsf5))
             (set! (-> (the-as (pointer uint64) (&+ s4-1 32)) 8) (the-as uint 66))
             )
            (else
              (set! (-> (the-as (pointer uint64) (&+ s4-1 32)) 8) (the-as uint 68))
              )
            )
          )
        (&+! (-> arg0 base) 112)
        (cond
          ((= (-> this angle) 0.0)
           (let ((v1-42 (-> arg0 base)))
             (set! (-> (the-as (pointer uint128) v1-42) 0) (-> sv-48 sprite-tmpl dma-vif quad))
             (set! (-> (the-as (pointer uint128) v1-42) 1) (-> sv-48 sprite-tmpl quad 1))
             (set! (-> (the-as (pointer uint128) v1-42) 2) (-> this color quad))
             (let ((f0-8 (if (logtest? sv-60 (hud-sprite-flags hsf0))
                             1.0
                             0.0
